<span class="o">--</span><span class="n">plaintext</span> <span class="o">&lt;</span><span class="n">value</span><span class="o">&gt;</span>
<span class="p">[</span><span class="o">--</span><span class="n">encryption</span><span class="o">-</span><span class="n">context</span> <span class="o">&lt;</span><span class="n">value</span><span class="o">&gt;</span><span class="p">]</span>
