            <span class="s2">&quot;Endpoint&quot;</span><span class="p">:</span> <span class="s2">&quot;ec2.ap-northeast-2.amazonaws.com&quot;</span><span class="p">,</span>
            <span class="s2">&quot;RegionName&quot;</span><span class="p">:</span> <span class="s2">&quot;ap-northeast-2&quot;</span><span class="p">,</span>
