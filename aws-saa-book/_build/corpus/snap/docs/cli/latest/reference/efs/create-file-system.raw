<span class="p">[</span><span class="o">--</span><span class="n">availability</span><span class="o">-</span><span class="n">zone</span><span class="o">-</span><span class="n">name</span> <span class="o">&lt;</span><span class="n">value</span><span class="o">&gt;</span><span class="p">]</span>
