<span class="p">[</span><span class="o">--</span><span class="n">egress</span><span class="o">-</span><span class="n">only</span><span class="o">-</span><span class="n">internet</span><span class="o">-</span><span class="n">gateway</span><span class="o">-</span><span class="nb">id</span> <span class="o">&lt;</span><span class="n">value</span><span class="o">&gt;</span><span class="p">]</span>
<span class="p">[</span><span class="o">--</span><span class="n">instance</span><span class="o">-</span><span class="nb">id</span> <span class="o">&lt;</span><span class="n">value</span><span class="o">&gt;</span><span class="p">]</span>
