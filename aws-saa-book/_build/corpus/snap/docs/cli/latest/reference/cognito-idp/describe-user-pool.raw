            <span class="s2">&quot;EmailSendingAccount&quot;</span><span class="p">:</span> <span class="s2">&quot;DEVELOPER&quot;</span>
        <span class="p">},</span>
        <span class="s2">&quot;SmsConfiguration&quot;</span><span class="p">:</span> <span class="p">{</span>
            <span class="s2">&quot;SnsCallerArn&quot;</span><span class="p">:</span> <span class="s2">&quot;arn:aws:iam::123456789012:role/service-role/userpool-SMS-Role&quot;</span><span class="p">,</span>
            <span class="s2">&quot;ExternalId&quot;</span><span class="p">:</span> <span class="s2">&quot;a1b2c3d4-5678-90ab-cdef-EXAMPLE11111&quot;</span><span class="p">,</span>
