        <span class="s2">&quot;EstimatedNumberOfUsers&quot;</span><span class="p">:</span> <span class="mi">166</span><span class="p">,</span>
        <span class="s2">&quot;EmailConfiguration&quot;</span><span class="p">:</span> <span class="p">{</span>
