                <span class="s2">&quot;EmailMessage&quot;</span><span class="p">:</span> <span class="s2">&quot;Your username is </span><span class="si">{username}</span><span class="s2"> and temporary password is {####}. &quot;</span><span class="p">,</span>
                <span class="s2">&quot;EmailSubject&quot;</span><span class="p">:</span> <span class="s2">&quot;Your temporary password&quot;</span>
            <span class="p">}</span>
        <span class="p">},</span>
        <span class="s2">&quot;UserPoolAddOns&quot;</span><span class="p">:</span> <span class="p">{</span>
