        <span class="s2">&quot;TableId&quot;</span><span class="p">:</span> <span class="s2">&quot;a1b2c3d4-5678-90ab-cdef-EXAMPLE11111&quot;</span><span class="p">,</span>
        <span class="s2">&quot;BillingModeSummary&quot;</span><span class="p">:</span> <span class="p">{</span>
            <span class="s2">&quot;BillingMode&quot;</span><span class="p">:</span> <span class="s2">&quot;PAY_PER_REQUEST&quot;</span>
        <span class="p">}</span>
    <span class="p">}</span>
