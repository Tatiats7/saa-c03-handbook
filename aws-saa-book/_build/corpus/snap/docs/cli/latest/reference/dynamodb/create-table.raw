        <span class="s2">&quot;CreationDateTime&quot;</span><span class="p">:</span> <span class="s2">&quot;2020-05-27T11:44:10.807000-07:00&quot;</span><span class="p">,</span>
        <span class="s2">&quot;ProvisionedThroughput&quot;</span><span class="p">:</span> <span class="p">{</span>
