<span class="p">[</span><span class="o">--</span><span class="n">delimiter</span> <span class="o">&lt;</span><span class="n">value</span><span class="o">&gt;</span><span class="p">]</span>
<span class="p">[</span><span class="o">--</span><span class="n">encoding</span><span class="o">-</span><span class="nb">type</span> <span class="o">&lt;</span><span class="n">value</span><span class="o">&gt;</span><span class="p">]</span>
