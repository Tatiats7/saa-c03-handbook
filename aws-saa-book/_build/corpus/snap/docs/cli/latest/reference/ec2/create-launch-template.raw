    <span class="s2">&quot;BandwidthWeighting&quot;</span><span class="p">:</span> <span class="s2">&quot;default&quot;</span><span class="o">|</span><span class="s2">&quot;vpc-1&quot;</span><span class="o">|</span><span class="s2">&quot;ebs-1&quot;</span>
  <span class="p">},</span>
