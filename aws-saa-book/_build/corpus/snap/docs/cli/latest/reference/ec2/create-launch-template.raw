  <span class="s2">&quot;MaintenanceOptions&quot;</span><span class="p">:</span> <span class="p">{</span>
    <span class="s2">&quot;AutoRecovery&quot;</span><span class="p">:</span> <span class="s2">&quot;default&quot;</span><span class="o">|</span><span class="s2">&quot;disabled&quot;</span>
  <span class="p">},</span>
  <span class="s2">&quot;DisableApiStop&quot;</span><span class="p">:</span> <span class="n">true</span><span class="o">|</span><span class="n">false</span><span class="p">,</span>
  <span class="s2">&quot;Operator&quot;</span><span class="p">:</span> <span class="p">{</span>
