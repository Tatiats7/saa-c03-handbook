<span class="p">[</span><span class="o">--</span><span class="n">target</span><span class="o">-</span><span class="n">arn</span> <span class="o">&lt;</span><span class="n">value</span><span class="o">&gt;</span><span class="p">]</span>
<span class="p">[</span><span class="o">--</span><span class="n">phone</span><span class="o">-</span><span class="n">number</span> <span class="o">&lt;</span><span class="n">value</span><span class="o">&gt;</span><span class="p">]</span>
