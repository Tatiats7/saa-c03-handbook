<span class="p">[</span><span class="o">--</span><span class="nb">filter</span><span class="o">-</span><span class="n">expression</span> <span class="o">&lt;</span><span class="n">value</span><span class="o">&gt;</span><span class="p">]</span>
<span class="p">[</span><span class="o">--</span><span class="n">key</span><span class="o">-</span><span class="n">condition</span><span class="o">-</span><span class="n">expression</span> <span class="o">&lt;</span><span class="n">value</span><span class="o">&gt;</span><span class="p">]</span>
<span class="p">[</span><span class="o">--</span><span class="n">expression</span><span class="o">-</span><span class="n">attribute</span><span class="o">-</span><span class="n">names</span> <span class="o">&lt;</span><span class="n">value</span><span class="o">&gt;</span><span class="p">]</span>
<span class="p">[</span><span class="o">--</span><span class="n">expression</span><span class="o">-</span><span class="n">attribute</span><span class="o">-</span><span class="n">values</span> <span class="o">&lt;</span><span class="n">value</span><span class="o">&gt;</span><span class="p">]</span>
