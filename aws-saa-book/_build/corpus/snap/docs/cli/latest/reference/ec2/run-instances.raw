      <span class="s2">&quot;Encrypted&quot;</span><span class="p">:</span> <span class="n">true</span><span class="o">|</span><span class="n">false</span><span class="p">,</span>
      <span class="s2">&quot;VolumeInitializationRate&quot;</span><span class="p">:</span> <span class="n">integer</span><span class="p">,</span>
