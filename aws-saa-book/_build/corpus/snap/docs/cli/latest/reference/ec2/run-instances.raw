<li><code class="docutils literal notranslate"><span class="pre">m8idb.metal-96xl</span></code></li>
<li><code class="docutils literal notranslate"><span class="pre">g7.2xlarge</span></code></li>
<li><code class="docutils literal notranslate"><span class="pre">g7.4xlarge</span></code></li>
