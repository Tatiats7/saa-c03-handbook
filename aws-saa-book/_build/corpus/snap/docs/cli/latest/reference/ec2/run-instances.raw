<li><code class="docutils literal notranslate"><span class="pre">g7.48xlarge</span></code></li>
<li><code class="docutils literal notranslate"><span class="pre">c9g.medium</span></code></li>
<li><code class="docutils literal notranslate"><span class="pre">c9g.large</span></code></li>
<li><code class="docutils literal notranslate"><span class="pre">c9g.xlarge</span></code></li>
<li><code class="docutils literal notranslate"><span class="pre">c9g.2xlarge</span></code></li>
<li><code class="docutils literal notranslate"><span class="pre">c9g.4xlarge</span></code></li>
