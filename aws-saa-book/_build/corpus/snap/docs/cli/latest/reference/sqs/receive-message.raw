<span class="p">[</span><span class="o">--</span><span class="n">wait</span><span class="o">-</span><span class="n">time</span><span class="o">-</span><span class="n">seconds</span> <span class="o">&lt;</span><span class="n">value</span><span class="o">&gt;</span><span class="p">]</span>
