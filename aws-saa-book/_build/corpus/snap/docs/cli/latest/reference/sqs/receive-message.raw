<span class="o">--</span><span class="n">queue</span><span class="o">-</span><span class="n">url</span> <span class="o">&lt;</span><span class="n">value</span><span class="o">&gt;</span>
<span class="p">[</span><span class="o">--</span><span class="n">attribute</span><span class="o">-</span><span class="n">names</span> <span class="o">&lt;</span><span class="n">value</span><span class="o">&gt;</span><span class="p">]</span>
<span class="p">[</span><span class="o">--</span><span class="n">message</span><span class="o">-</span><span class="n">system</span><span class="o">-</span><span class="n">attribute</span><span class="o">-</span><span class="n">names</span> <span class="o">&lt;</span><span class="n">value</span><span class="o">&gt;</span><span class="p">]</span>
<span class="p">[</span><span class="o">--</span><span class="n">message</span><span class="o">-</span><span class="n">attribute</span><span class="o">-</span><span class="n">names</span> <span class="o">&lt;</span><span class="n">value</span><span class="o">&gt;</span><span class="p">]</span>
