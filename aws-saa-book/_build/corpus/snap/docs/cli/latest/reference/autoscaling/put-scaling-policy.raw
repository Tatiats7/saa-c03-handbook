<span class="p">[</span><span class="o">--</span><span class="n">target</span><span class="o">-</span><span class="n">tracking</span><span class="o">-</span><span class="n">configuration</span> <span class="o">&lt;</span><span class="n">value</span><span class="o">&gt;</span><span class="p">]</span>
