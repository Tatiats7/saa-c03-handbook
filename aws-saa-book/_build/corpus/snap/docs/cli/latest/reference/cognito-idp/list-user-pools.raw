                <span class="s2">&quot;PreSignUp&quot;</span><span class="p">:</span> <span class="s2">&quot;arn:aws:lambda:us-east-1:123456789012:function:MyFunction&quot;</span><span class="p">,</span>
                <span class="s2">&quot;PreTokenGeneration&quot;</span><span class="p">:</span> <span class="s2">&quot;arn:aws:lambda:us-east-1:123456789012:function:MyFunction&quot;</span><span class="p">,</span>
                <span class="s2">&quot;PreTokenGenerationConfig&quot;</span><span class="p">:</span> <span class="p">{</span>
                    <span class="s2">&quot;LambdaArn&quot;</span><span class="p">:</span> <span class="s2">&quot;arn:aws:lambda:us-east-1:123456789012:function:MyFunction&quot;</span><span class="p">,</span>
                    <span class="s2">&quot;LambdaVersion&quot;</span><span class="p">:</span> <span class="s2">&quot;V1_0&quot;</span>
                <span class="p">}</span>
            <span class="p">},</span>
