            <span class="s2">&quot;LambdaConfig&quot;</span><span class="p">:</span> <span class="p">{</span>
            <span class="p">},</span>
            <span class="s2">&quot;LastModifiedDate&quot;</span><span class="p">:</span> <span class="mf">1686064178.873</span><span class="p">,</span>
            <span class="s2">&quot;Name&quot;</span><span class="p">:</span> <span class="s2">&quot;user pool 2&quot;</span>
        <span class="p">},</span>
