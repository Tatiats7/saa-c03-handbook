            <span class="s2">&quot;CreationDate&quot;</span><span class="p">:</span> <span class="mf">1627681712.237</span><span class="p">,</span>
            <span class="s2">&quot;Id&quot;</span><span class="p">:</span> <span class="s2">&quot;us-west-2_EXAMPLE3&quot;</span><span class="p">,</span>
            <span class="s2">&quot;LambdaConfig&quot;</span><span class="p">:</span> <span class="p">{</span>
                <span class="s2">&quot;UserMigration&quot;</span><span class="p">:</span> <span class="s2">&quot;arn:aws:lambda:us-east-1:123456789012:function:MyFunction&quot;</span>
