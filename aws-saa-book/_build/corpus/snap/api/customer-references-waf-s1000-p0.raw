":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"}]},{"item":{"id":"customer-references#weshine","locale":"en_US","directoryId":"customer-references","name":"weshine","dateCreated":"2021-11-23T01:53:52+0000","dateUpdated":"2023-07-14T23:32:52+0000","additionalFields":{"descriptionSummary":"WeShine Tech built an identity verification feature on AWS that can scale to authenticate 350,000 concurrent online test takers. WeShine Tech’s flagship UniApps product is focused on university examination process automation. UniApps uses Amazon Rekognition for identity verification, Amazon ECS for autoscaling containers, and AWS WAF to protect user data.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/AWS%20India_WeShine%20Tech%402x_logo%20200x35.64b0fcfc03a473b0ae0be7c827fec21b24ee45d8.png","displayLocation":"India","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2021-11-22","headlineUrl":"https://aws.amazon.com/solutions/case-studies/weshine/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"WeShine Tech","contentType":"Customer Story","headline":"WeShine Tech Equips Universities to Proctor Exams Remotely with Machine Learning on AWS"}},"tags":[{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"Engli