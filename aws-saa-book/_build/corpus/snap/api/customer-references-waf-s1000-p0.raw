:"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#industry#govt-state-local","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"State and Local Government","description":"State and Local Government","dateCreated":"2021-12-15T23:38:31+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"}]},{"item":{"id":"customer-references#rotoplas","locale":"en_US","directoryId":"customer-references","name":"rotoplas","dateCreated":"2023-06-01T23:06:13+0000","dateUpdated":"2023-06-08T04:07:40+0000","additionalFields":{"descriptionSummary":"Grupo Rotoplas es una empresa mexicana con presencia en 15 países y con 27 líneas de productos, 17 plantas, más de 3,300 colaboradores y 12 mil distribuidores. Posee 29 mil puntos de venta y 50 mil puntos de servicios. La empresa contaba con un data center propio para su operación desde Estados Unidos hasta Argentina, y ante la edad de sus 300 servidores y la demanda por más capacidad, buscaron un proveedor que les ayudara a tener mayor escalabilidad, seguridad y disponibilidad. AWS fue su aliado en la migración de su negocio a la nube, la cual, además, se realizó en tiempo récord.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/rotoplas_Logo%401x.a2e976a6fa99d3e584ef36179ba7da5b9b65af45.png","displayLocation":"México","customerNameLower":"rotoplas","footerInfoText":"Fecha de publicación","industry":"Fabricación","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/rotoplas/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Rotoplas","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"Rotoplas reduce en un 50% los tiempos de downtime de sistemas con migración de su negocio a la nube en tiempo récord"}},"tags":[{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#cloudtrail","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudTrail","description":"AWS CloudTrail","dateCreated":"2020-03-02T07:02:05+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#product#codeguru","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CodeGuru","description":"Amazo