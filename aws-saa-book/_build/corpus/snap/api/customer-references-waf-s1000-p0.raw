anslate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Translate","description":"Amazon Translate","dateCreated":"2020-03-02T07:05:56+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#product#private-5g","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Private 5G","description":"AWS Private 5G","dateCreated":"2021-12-16T04:57:42+0000","dateUpdated":"2022-02-03T03:32:55+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#supercell-edge-services-case-stud","locale":"en_US","directoryId":"customer-references","name":"supercell-edge-services-case-stud","dateCreated":"2022-06-27T20:44:07+0000","dateUpdated":"2022-06-27T20:56:02+0000","additionalFields":{"descriptionSummary":"Supercell uses Amazon CloudFront, AWS Local Zones, and AWS security services to deliver dynamic, low-latency game content to a globally distributed community of 250 million monthly users.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/supercell-logo%401x.0fe8c7be0985b4cd285ffd90fad5f9e4feffa71c.png","displayLocation":"Finland","customerNameLower":"supercell","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2022-06-24","headlineUrl":"https://aws.amazon.com/solutions/case-studies/supercell-edge-services-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Supercell","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Supercell Delivers Dynamic, Low-Latency Games to Millions of Players Using AWS Edge Services"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOB