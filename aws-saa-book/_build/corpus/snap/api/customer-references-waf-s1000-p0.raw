":{"id":"customer-references#evitamins-case-study","locale":"en_US","directoryId":"customer-references","name":"evitamins-case-study","dateCreated":"2019-07-22T19:43:55+0000","dateUpdated":"2023-07-14T23:32:49+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS WAF, eVitamins automated its website security, reducing IT overhead, application-layer attacks, and incident-response time each by 90 percent. A health and beauty ecommerce retailer, eVitamins carries more than 25,000 products and ships to 85 countries worldwide.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/US/600x400_eVitamins_Logo.ae865a579afe5c5be03cdd796da2ae9069ae63f0.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eUsing AWS WAF, eVitamins automated its website security, reducing IT overhead, application-layer attacks, and incident-response time each by 90 percent. A health and beauty ecommerce retailer, eVitamins carries more than 25,000 products and ships to 85 countries worldwide. The company uses services that are part of the AWS WAF Security Automations solution, including Amazon CloudFront for content delivery, Amazon CloudWatch for tracking metrics and triggering alerts, and AWS Lambda for API automations.\u003c/p\u003e\r\n","industry":"Retail","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/evitamins/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"eVitamins","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"eVitamins Case Study"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:4