teUpdated":"2023-06-08T04:07:32+0000","additionalFields":{"descriptionSummary":"Banco de Bogotá es la institución financiera con más historia en Colombia. Desde 2017, el Banco trabaja en su transformación digital; de hecho, fue pionero en lanzar la primera cuenta 100% digital de extremo a extremo en la región. Ahora, las soluciones de reconocimiento facial de AWS implementadas por el Banco han permitido un aumento de 10% en la tasa de conversión de nuevos clientes, además de disminuir los casos de suplantación.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/banco-de-bogota-logo%402x.0a8e6f0f448d7637a71c52ae254b1bf31c4a17f8.png","displayLocation":"Colombia","footerInfoText":"Fecha de publicación","industry":"Servicios financieros","sortDate":"2021-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/bancodebogota-rekognition/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"Historia del cliente","customer-name":"Banco de Bogota","headline":"Banco de Bogotá utiliza soluciones de reconocimiento facial de AWS para aumentar la conversión de nuevos clientes"}},"tags":[{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#product#ecr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Registry (ECR)","description":"Amazon Elastic Container Registry (ECR)","dateCreated":"2020-03-02T07:02:55+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Manage