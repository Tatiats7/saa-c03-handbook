ntentType":"Customer Story","headline":"EPAM Builds Client Confidence Using AWS Training and Certification Initiative"}},"tags":[{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#customer-enablement#training-cert","locale":"en_US","tagNamespaceId":"GLOBAL#customer-enablement","name":"Training \u0026 Certification","description":"Training \u0026 Certification","dateCreated":"2020-09-04T04:06:29+0000","dateUpdated":"2022-02-03T03:31:13+0000"},{"id":"customer-references#category#training-certification","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Training \u0026 Certification","description":"Training \u0026 Certification","dateCreated":"2019-07-22T18:32:26+0000","dateUpdated":"2022-02-26T01:35:03+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#waf","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS WAF","description":"AWS WAF","dateCreated":"2020-03-02T07:06:04+0000","dateUpdated":"2022-02-03T03:33:07+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#tecban","locale":"en_US","directoryId":"customer-references","name":"tecban","dateCreated":"2023-06-01T23:07:14+0000","dateUpdated":"2023-06-08T04:07:44+0000","additionalFields":{"descriptionSummary":"A TecBan é líder mundial em rede independente de autoatendimento. Há mais de 39 anos a companhia desenvolve diversas soluções tecnológicas e inovadoras que integram o físico e o digital e impulsionam o ecossistema econômico do Brasil. Visionária, a empresa está em constante movimento e, na última década, investiu mais de R$ 4 bilhões em produtos e soluções avançadas que ajudam a garantir a inclusão financeira de todas as classes sociais e perfis de público, em todas as regiões do Brasil. Um dos frutos deste investimento é a plataforma de Open Banking as a Service, lançada no início deste ano nativa na nuvem AWS, o que possibilita que possa crescer junto com a demanda.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/tecban-logo%402x.af5cbb717674af5720d18d34136e7ce028c575b8.png","displayLocation":"Brasil","footerInfoText":"Data de publicação","industry":"Manufatura","sortDate":"2021-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/tecban/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"História do cliente","customer-name":"Tecban Indústria e Comércio Ltda.","headline":"Solução de Open Banking da TecBan utiliza nuvem AWS"}},"tags":[{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"IoT","description":"IoT","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#iot","locale":"en_US","tagNamespaceId":"customer-references#category","name":"IoT","description":"IoT","dateCreated":"2019-07-22T18:32:05+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#content-type#customer-story",