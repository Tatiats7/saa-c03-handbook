2022-02-03T03:31:23+0000"}]},{"item":{"id":"customer-references#tnex-case-study","locale":"en_US","directoryId":"customer-references","name":"tnex-case-study","dateCreated":"2021-09-11T00:49:07+0000","dateUpdated":"2021-12-22T23:23:33+0000","additionalFields":{"descriptionSummary":"TNEX was able to launch its digital-native mobile bank on AWS in just nine months with the help of TechX, an AWS Partner. TNEX is Vietnam’s first fully digital bank, offering a retail app for consumers and a separate app for small to medium businesses. The company uses Amazon ECS to run containers in a microservices framework, Amazon GuardDuty for intelligent threat protection, and AWS WAF to help secure its application layers.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/TNEX_logo%401x.4e942ad2223badbcb0fc33c6d352d0e31c80be9c.png","displayLocation":"Vietnam","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2021-09-10","headlineUrl":"https://aws.amazon.com/solutions/case-studies/tnex-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"TNEX Launches Vietnam’s First Digital Bank in Nine Months on AWS","customer-name":"TNEX"}},"tags":[{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#pr