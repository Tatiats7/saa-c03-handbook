","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#waf","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS WAF","description":"AWS WAF","dateCreated":"2020-03-02T07:06:04+0000","dateUpdated":"2022-02-03T03:33:07+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"}]},{"item":{"id":"customer-references#caso-de-exito-giss","locale":"en_US","directoryId":"customer-references","name":"caso-de-exito-giss","dateCreated":"2023-06-01T23:04:39+0000","dateUpdated":"2023-07-14T23:32:38+0000","additionalFields":{"descriptionSummary":"La Gerencia Informática de la Seguridad Social (GISS) decidió apostar por la nube de AWS para facilitar al Instituto Nacional de la Seguridad Social (INSS) el tramitar y gestionar las solicitudes del Ingreso Mínimo Vital (IMV), una ayuda del gobierno a los ciudadanos con menos recursos. Las razones por las que eligieron AWS fueron la agilidad que le permitía a la hora de poner en marcha este proyecto, así como contar con todas las garantías de seguridad, dado que los datos que se tratan son de carácter personal y crítico. Accenture y Trend Micro colaboraron en el proyecto.","imageSrcUrl":"https://prod-us-west-2.aem-author.marketing.aws.a2z.com/content/dam/Customer%20References%20Directory%20Logos/giss-logo-70.png/jcr%3acontent/renditions/cq5dam.web.1280.1280.png?ch_ck\u003d1667399716000","displayLocation":"España","customerNameLower":"giss - gerencia informática de la seguridad social","footerInfoText":"Fecha de publicación","industry":"State and Local Government","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/caso-de-exito-giss/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"GISS - Gerencia Informática de la Seguridad Social","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"Con el uso de AWS, la Seguridad Social Española fue capaz de procesar y gestionar rápidamente el Ingreso Mínimo Vital"}},"tags":[{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#category#app-integration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Application Integration","description":"Application Integration","dateCreated":"2019-07-22T18:30:54+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","n