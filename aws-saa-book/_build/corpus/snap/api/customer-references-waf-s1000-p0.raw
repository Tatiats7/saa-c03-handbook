+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#guardduty","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon GuardDuty","description":"Amazon GuardDuty","dateCreated":"2020-03-02T07:03:46+0000","dateUpdated":"2022-02-03T03:32:40+0000"}]},{"item":{"id":"customer-references#moovit-case-study","locale":"en_US","directoryId":"customer-references","name":"moovit-case-study","dateCreated":"2024-06-07T20:17:38+0000","dateUpdated":"2025-03-06T23:23:19+0000","additionalFields":{"descriptionSummary":"Mobility-as-a-service provider Moovit develops the Moovit journey planner app for the web and mobile phones. The app is used by more than a billion people to navigate public transit networks around the world.\nRunning this kind of service requires a highly secure and resilient infrastructure. However, the increase in the frequency and severity of distributed denial of service (DDoS) events and bots had become a challenge for the company’s existing infrastructure. So, the company turned to Amazon Web Services (AWS) and migrated from its previous web application firewall (WAF).","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/logos/200x100_logos/200x100_Moovit_Logo.f86150a2afa379df560b4cde6825d6e425fe1c22.png","displayLocation":"Israel","customerNameLower":"moovit","footerInfoText":"Published Date","industry":"Software \u0026 Internet","headlineUrl":"https://aws.amazon.com/solutions/case-studies/moovit-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","customer-name":"Moovit","headline":"Strengthening Protection Against Bots and DDoS Events While Reducing Costs Using AWS WAF with Moovit","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#product#shield","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Shield","description":"AWS Shield","dateCreated":"2020-03-02T07:05:24+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name"