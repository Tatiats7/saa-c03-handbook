cription":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#industry#cpg","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Consumer Packaged Goods (CPG)","description":"Consumer Packaged Goods (CPG)","dateCreated":"2020-06-25T04:03:18+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"customer-references#innovator#natura","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"NATURA","description":"NATURA","dateCreated":"2022-09-15T00:48:37+0000","dateUpdated":"2022-09-15T00:48:37+0000"}]},{"item":{"id":"customer-references#tajonaso","locale":"en_US","directoryId":"customer-references","name":"tajonaso","dateCreated":"2023-06-01T23:05:37+0000","dateUpdated":"2023-07-14T23:32:39+0000","additionalFields":{"descriptionSummary":"Super Centro El Tajonaso es una importante cadena de supermercados, con más de 400 empleados en tres sucursales ubicadas en distintos puntos de Panamá Oeste y, más recientemente, en una red de restaurantes. En este video, Jorge Velásquez, administrador de sistemas del Tajonaso, nos cuenta que la compañía tuvo el reto de la implementación de un nuevo sistema financiero contable. El desafío era el costo inicial de infraestructura, por lo que AWS, con la flexibilidad que ofrece en temas de infraestructura fue clave para dar este paso.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/eltajonaso_logo%401x.bdb4e46559c19f79117e5ae46e0d08ceaa670fd2.png","displayLocation":"Panamá","customerNameLower":"el tajonaso","footerInfoText":"Fecha de publicación","industry":"Venta al por menor","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/tajonaso/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"El Tajonaso","enableShare":"1","publishedDate":"2020","contentType":"Historia del cliente","headline":"Caso de Éxito AWS: El Tajonaso"}},"tags":[{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#industry#retail","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Retail","description":"Retail","dateCreated":"2020-01-16T17:42:39+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#use-case#datacenter-migration","locale":"en_US","tagNamespa