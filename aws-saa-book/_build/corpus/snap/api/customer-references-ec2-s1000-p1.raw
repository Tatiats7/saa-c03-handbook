cription":"Elastic Load Balancing (ELB)","dateCreated":"2020-03-02T07:03:09+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#justice-public-safety","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Justice \u0026 Public Safety","description":"Justice \u0026 Public Safety","dateCreated":"2020-01-16T17:42:29+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"}]},{"item":{"id":"customer-references#pinterest-case-study-it","locale":"en_US","directoryId":"customer-references","name":"pinterest-case-study-it","dateCreated":"2024-11-12T00:55:09+0000","dateUpdated":"2024-11-12T01:13:39+0000","additionalFields":{"descriptionSummary":"Pinterest è un motore di scoperta visiva che ospita miliardi di immagini che oltre 450 milioni di utenti possono esplorare, salvare e condividere come \"Pin\" su bacheche di ispirazione digitali personalizzate. Nato nel cloud Amazon Web Services (AWS), Pinterest è in grado di dimensionare l\u0027elaborazione, l\u0027archiviazione e l\u0027analisi dei suoi dati in rapida crescita, il tutto riducendo la gestione dell\u0027infrastruttura e concentrandosi sull\u0027innovazione. Utilizzando le soluzioni di elaborazione di AWS, Pinterest ha migrato la sua pipeline iOS di integrazione continua e distribuzione continua (CI/CD) dall\u0027ambiente on-premise per ridurre gli errori di compilazione di oltre l\u002780%. Inoltre, utilizza il machine learning (ML) per potenziare il suo strumento di ricerca visiva Pinterest Lens, in grado di riconoscere oltre 2,5 miliardi di oggetti e abbinarli ai prodotti. Attualmente, la piattaforma di dati exabyte di Pinterest funziona interamente su AWS, dimensionando la ricerca e l\u0027analisi dei log a oltre 1,7 TB e riducendo i costi operativi del 30%.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Pinterest_Customer-Reference_Logo.2b8b17653ab4b4b98c4b9534e8832cf12692e2c9.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the Pinterest case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of companies.\u003c/p\u003e\r\n","industry":"Telecommunications","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/innovators/pinterest/","customer-name":"Pinterest","enableShare":"1","publishedDate":"2014","contentType":"Storia del cliente","headline":"Pinterest su AWS"}},"tags":[{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-0