_US","directoryId":"customer-references","name":"figmd-ehnac-case-study","dateCreated":"2019-07-22T19:43:21+0000","dateUpdated":"2023-07-14T23:32:30+0000","additionalFields":{"featured":"0","descriptionSummary":"FIGmd demonstrates compliance with healthcare industry regulations, gives healthcare organizations confidence their data is protected, and differentiates its business by using AWS and earning EHNAC cloud accreditation. The company offers clinical-data registries and other solutions to a range of healthcare organizations throughout the United States.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/FIGmd_Customer-Reference_Logo.207f58c4b5eb5cbfde8f1896f23310781e3500de.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the FIGmd/ENHAC customer case study, powered by the AWS Cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Healthcare","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/figmd-EHNAC/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"FIGmd/EHNAC","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"FIGmd/EHNAC Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId