es#category#infrastructure","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Infrastructure","description":"Infrastructure","dateCreated":"2019-07-22T18:32:04+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#fusefx-case-study","locale":"en_US","directoryId":"customer-references","name":"fusefx-case-study","dateCreated":"2019-07-19T14:57:34+0000","dateUpdated":"2023-07-14T23:32:49+0000","additionalFields":{"featured":"0","descriptionSummary":"FuseFX achieves unlimited CGI render-farm scale by seamlessly adding cloud render nodes with AWS Thinkbox Deadline. FuseFX uses its proprietary content-creation pipeline to build visual effects for episodic television, feature films, commercials, and virtual-reality productions.","imageSrcUrl":"https://d1.awsstatic.com/EnterpriseDigitalMarketing/EDM_EC2/GEN_fusefx_150x100_May-2018.4ac313c94126712bc4581242a7e3dbbc884f870e.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eFuseFX achieves unlimited CGI render-farm scale by seamlessly adding cloud render nodes with AWS Thinkbox Deadline. FuseFX uses its proprietary content-creation pipeline to build visual effects for episodic television, feature films, commercials, and virtual-reality productions. The company is using Thinkbox Deadline to manage and administer CGI render nodes built using Amazon Machine Image templates and Amazon EC2 Spot Instances.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/fusefx/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"FuseFX","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"FuseFX Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#high-performance-computing","locale":"en_US","tagNamespaceId":"customer-references#category","name":"High Performance Computing","description":"High Performance Computing","dateCreated":"2019-07-22T18:32:00+0000","dateUpdated":"2022-02-26T01:35:03+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#use-case#high-perform-compute","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"High Performance Compute","description":"High Performance Compute","dateCreated":"2020-06-05T06:37:26+0000","dateUpdated":"2022-02-03T03:35:41+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#royal-dutch-shell-case-study","locale":"en_US","directoryId":"customer-references","name":"royal-dutch-shell-case-study","dateCreated":"2019-07-19T14:57:23+0000","dateUpdated":"2023-07-12T01:40:46+0000","additionalFields":{"featured":"0","descriptionSummary":"Relying on AWS as its infrastructure provider of choice for its Splunk Enterprise cybersecurity solution, Royal Dutch Shell matured a large data lake for historical analysis. Headquartered in the Netherlands, Royal Dutch Shell is a British-Dutch multinational oil and gas company with operations in more than 70 countries and an interest in 22 refineries around the globe.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/shell_Customer-Reference_Logo.ba09dfe42f0b57c1cee69c3f6ba9660de40f4f3f.png","displayLocation":"Netherlands","footerInfoText":"Published Date","description":"\u003cp\u003eRelying on AWS as its infrastructure provider of choice for its Splunk Enterprise cybersecurity solution, Royal Dutch Shell matured a large data lake for historical analysis. Headquartered in the Netherlands, Royal Dutch Shell is a British-Dutch multinational oil and gas company with operations in more than 70 countries and an interest in 22 refineries around the globe. The company uses Amazon EC2 and Amazon EBS for its Splunk environment on AWS, which helps it find more than twice as many events that could have resulted in security incidents and breaches.\u003c/p\u003e\r\n","industry":"Energy","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/royal-dutch-shell/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Royal Dutch Shell","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Royal Dutch Shell Case Study"}},"tags":[{"id":"GLOBAL#location#netherlands","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Netherlands","description":"Netherlands","dateCreated":"2020-02-03T05:29:50+0000","dateUpdated":"2022-02-03T03:31:41+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#high-performance-computing","locale":"en_US","tagNamespaceId":"customer-references#category","name":"High Performance Computing","description":"High Performance Computing","dateCreated":"2019-07-22T18:32:00+0000","dateUpdated":"2022-02-26T01:35:03+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#lo