03:31:15+0000"}]},{"item":{"id":"customer-references#omada-health-case-study","locale":"en_US","directoryId":"customer-references","name":"omada-health-case-study","dateCreated":"2019-07-22T19:43:01+0000","dateUpdated":"2023-07-14T23:32:29+0000","additionalFields":{"featured":"0","descriptionSummary":"Omada Health built a digital version of a proven diabetes-prevention program on AWS, enabling it to scale cost-effectively and achieve clinically significant results. Omada Health helps people change their habits, improve their health, and reduce their risk of chronic disease through intensive behavioral-change programs that are clinically supported and evidence-based.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/OmadaHealth_Customer-Reference_Logo.60676e43a1fdd61ab48138bb1d43b31253378fc7.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eOmada Health built a digital version of a proven diabetes-prevention program on AWS, enabling it to scale cost-effectively and achieve clinically significant results. Omada Health helps people change their habits, improve their health, and reduce their risk of chronic disease through intensive behavioral-change programs that are clinically supported and evidence-based. The company runs its services on AWS\u0014including Amazon EC2, Amazon RDS, and Amazon S3\u0014and improves outcomes with advanced data science using Amazon Redshift and AWS Elastic Beanstalk.\u003c/p\u003e\r\n","industry":"Life Sciences","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/omada-health/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Omada Health","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Omada Health Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","da