pdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#moderna","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Moderna Therapeutics","description":"Moderna Therapeutics","dateCreated":"2022-04-25T19:06:29+0000","dateUpdated":"2022-09-15T00:48:36+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#lockheed-martin-case-study-from-es-directory","locale":"en_US","directoryId":"customer-references","name":"lockheed-martin-case-study-from-es-directory","dateCreated":"2024-02-03T03:47:14+0000","dateUpdated":"2024-02-06T01:35:38+0000","additionalFields":{"descriptionSummary":"Lockheed Martin quickly migrated its SAP Suite on HANA to the AWS Cloud, gaining business agility and cost savings and ensuring compliance with key industry data-protection regulations. The organization is a developer of aerospace and defense systems for the U.S. military and global U.S. allies.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/LockheedMartin_Customer-Reference_Logo.5cfeaff438e15cab398cc58ce839be0b11be8f26.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the Lockheed Martin customer case study, powered by the AWS Cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Manufacturing","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/Lockheed-martin/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Lockheed Martin","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Lockheed Martin Case Study"}},"tags":[{"id":"customer-references#category#web-hosting","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Web Hosting","description":"Web Hosting","dateCreated":"2019-07-22T18:32:28+0000","dateUpdated":"2022-03-30T20:30:49+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"customer-references#category#government-public-sector","locale":"en_US","tagNamespaceId":"customer-references#category","name":"government-public-sector","description":"Government \u0026 Public Sector","dateCreated":"2019-07-22T18:31:57+0000","dateUpdated":"2020-11-25T01:38:26+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-reference