Updated":"2022-02-03T03:36:03+0000"},{"id":"GLOBAL#product#service-catalog","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Service Catalog","description":"AWS Service Catalog","dateCreated":"2020-03-02T07:05:20+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#industry#life-sciences","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Life Sciences","description":"Life Sciences","dateCreated":"2020-01-16T17:42:31+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Internet of Things (IoT)","description":"Internet of Things (IoT)","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2023-08-22T20:28:39+0000"},{"id":"customer-references#industry#pu-og-energy","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"pu-og-energy","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/power-and-utilities/case-studies/ and/or aws.amazon.com/energy/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from multiple tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:35:16+0000","dateUpdated":"2023-04-26T20:35:16+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#industry#electronics","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Electronics","description":"Electronics","dateCreated":"2020-06-25T04:07:00+0000","dateUpdated":"2022-02-03T03:32:02+0000"},{"id":"GLOBAL#industry#semiconductors","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Semiconductors","description":"Semiconductors","dateCreated":"2020-08-31T04:01:50+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"customer-references#category#hcls","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Healthcare \u0026 Life Sciences","description":"Healthcare \u0026 Life Sciences","dateCreated":"2019-07-22T18:31:58+0000","dateUpdated":"2022-05-14T20:13:37+0000"}]},{"item":{"id":"customer-references#aws-case-study-aldebaran-robotics","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-aldebaran-robotics","dateCreated":"2019-07-22T19:54:50+0000","dateUpdated":"2021-12-22T19:02:14+0000","additionalFields":{"featured":"0","descriptionSummary":"Aldebaran, a french robotics company, aims to create a family of companion robots that positively influence our daily lives at home and in school environments. By using AWS, the company has gained agility and flexibility and can now make changes to its website infrastructure on the fly while freeing staff to focus on robotics rather than infrastructure.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/AldebaranRobotics_Customer-Reference_Logo.ad279816690ba3d17a0e035d53465ba02979564d.png","displayLocation":"France","footerInfoText":"Published Date","description":"\u003cp\u003eAldebaran, a french robotics company, aims to create a family of companion robots that positively influence our daily lives at home and in school environments. The company uses AWS for storage and to host its website and application store for its robots. By using AWS, the company has gained agility and flexibility and can now make changes to its website infrastructure on the fly while freeing staff to focus on robotics rather than infrastructure. Video can also be found at: https://www.youtube.com/watch?v\u003dBPKgY8nTIoc\u003c/p\u003e\r\n","industry":"Manufacturing","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/aldebaran-robotics/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Aldebaran Robotics","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Aldebaran Robotics"}},"tags":[{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"c