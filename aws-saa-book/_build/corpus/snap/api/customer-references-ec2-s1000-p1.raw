ences#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#use-case#high-perform-compute","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"High Performance Compute","description":"High Performance Compute","dateCreated":"2020-06-05T06:37:26+0000","dateUpdated":"2022-02-03T03:35:41+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#aws-case-study-ticketmaster","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-ticketmaster","dateCreated":"2019-07-22T19:56:05+0000","dateUpdated":"2021-12-22T19:45:49+0000","additionalFields":{"featured":"0","descriptionSummary":"Ticketmaster, North America\u0027s top online venue for ticket sales and distribution, uses AWS pay-as-you-go pricing to reduce fixed costs by more than 80 percent annually.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/ticketmaster-logo.4363dc50fdc11bbf9b3cce7b231bd94b703b4ba1.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eTicketmaster is North America\u0019s top online venue for ticket sales and distribution and one of the continent\u0019s highest ranked e-commerce websites. In 2010, Ticketmaster merged with Live Nation Entertainment, and together with Live Nation\u0019s website, Ticketmaster hosts more than 26 million unique visitors every month. Recently, Ticketmaster partnered with MarketShare to develop a dynamic ticket pricing application called Pricemaster. MarketShare is an analytics company that empowers businesses to credibly measure and dramatically improve the return on their Marketing investments. MarketShare has a track record of ground-breaking innovations in marketing analytics working with over half of the Fortune 50.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ticketmaster/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ticketmaster","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Ticketmaster"}},"tags":[{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:43+0000","dateUpdated":"2022-02-03T03:36:00+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#ses","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Email Service (SES)","de