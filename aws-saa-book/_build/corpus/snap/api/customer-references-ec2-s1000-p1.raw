,"dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"}]},{"item":{"id":"customer-references#aws-case-study-bart-associates-inc","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-bart-associates-inc","dateCreated":"2019-07-22T19:49:46+0000","dateUpdated":"2022-01-21T02:41:25+0000","additionalFields":{"featured":"0","descriptionSummary":"Bart \u0026 Associates\u0027 400 consultants provide enterprise software solutions to a broad range of U.S. government and commercial clients. As the company grew, it partnered with AWS consulting partner Monocle to replace its legacy applications with SAP enterprise software in the AWS Cloud (hosted on SAP HANA) and is now running SAP CRM, SAP ERP, SAP Business Objects, and other SAP modules on AWS. Since the migration, Bart \u0026 Associates has rapidly accelerated project timelines while obtaining a cost-effective platform for its SAP environment.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/barts-and-associates-logo.42c687bf6848599e5be40484f6d6789870408dc1.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eBart \u0026amp; Associates\u0026#39; 400 consultants provide expert enterprise software solutions to a broad range of U.S. government and commercial clients. As the company grew, it partnered with AWS consulting partner Monocle to replace its legacy applications with SAP enterprise software in the AWS cloud (hosted on SAP HANA) and is now running SAP CRM, SAP ERP, SAP Business Objects, and other SAP modules on AWS. Since the migration, Bart \u0026amp; Associates has rapidly accelerated project timelines while obtaining a cost-effective platform for its SAP environment.\u003c/p\u003e\r\n","industry":"Professional Services","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/bart-and-associates/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Bart \u0026 Associates, Inc.","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Bart \u0026 Associates, Inc."}},"tags":[{"id":"GLOBAL#product#glacier","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon S3 Glacier","description":"Amazon S3 Glacier","dateCreated":"2020-03-02T07:03:38+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"customer-references#category#business-applications-sap","locale":"en_US","tagNamespaceId":"customer-references#c