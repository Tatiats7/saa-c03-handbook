 Load Balancing (ELB)","description":"Elastic Load Balancing (ELB)","dateCreated":"2020-03-02T07:03:09+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-peak-games","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-peak-games","dateCreated":"2019-07-22T19:54:07+0000","dateUpdated":"2023-07-14T23:32:47+0000","additionalFields":{"featured":"0","descriptionSummary":"Based in Turkey, gaming company Peak Games has 30 million monthly active players across Turkey, Middle East, and North Africa. By using AWS, the company has lowered provisioning time from 4-6 hours to 10 minutes, and reduced operational costs.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/PeakGames_Customer-Reference_Logo.ea8c0c4012e1af65c10672562825bc03a8812b21.png","displayLocation":"Turkey","footerInfoText":"Published Date","description":"\u003cp\u003ePeak Games is the leading and rapidly growing online and mobile gaming company focused on creating and publishing games that fit the unique interests and cultures of Turkey, Middle East, and North Africa regions. Today, Peak Games unites 30 million monthly unique players with free, culturally relevant, community-driven games. The company?s Plus Studio, which has nearly 300,000 concurrent users, builds digital renditions of traditional and popular board, card, and table-top games; its War of Mercenaries reaches millions of mid-core gamers across different platforms. By using AWS, Peak Games reduced provisioning time from 4-6 hours to 10 minutes, lowered their operational costs by 15%. In addition, Peak games reduced time to market by 75% and experienced near 100% availability for simultaneous gaming by millions of users.\u003c/p\u003e\r\n","industry":"Gaming","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/peak-games/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Peak Games","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Peak Games"}},"tags":[{"id":"customer-references#category#database-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name"