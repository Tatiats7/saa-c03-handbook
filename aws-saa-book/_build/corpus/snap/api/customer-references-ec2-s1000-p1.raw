0"}]},{"item":{"id":"customer-references#aws-case-study-devicescape","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-devicescape","dateCreated":"2019-07-22T19:55:39+0000","dateUpdated":"2021-12-22T19:42:20+0000","additionalFields":{"featured":"0","descriptionSummary":"Devicescape enables telecom operators to manage the movement of their smartphone users between cellular and Wi-Fi networks, ensuring the best connection at all times. Devicescape used AWS to rebuild its service and seamlessly connect people to its network of more than 20 million public Wi-Fi access points worldwide.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Devicescape_Customer-Reference_Logo.16049148c338530831b9c06128b7812b887a11ed.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eDevicescape enables telecom operators to manage the movement of their smartphone users between cellular and Wi-Fi networks, ensuring the best connection at all times. To expand its business, Devicescape used AWS to rebuild its service, seamlessly connecting people to its network of more than 20 million public Wi-Fi access points worldwide.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/devicescape/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Devicescape","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Devicescape"}},"tags":[{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-