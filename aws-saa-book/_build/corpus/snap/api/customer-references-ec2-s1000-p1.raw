eCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#efs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic File System (EFS)","description":"Amazon Elastic File System (EFS)","dateCreated":"2020-03-02T07:02:57+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#product#backup","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Backup","description":"AWS Backup","dateCreated":"2020-03-02T07:01:40+0000","dateUpdated":"2022-02-03T03:32:19+0000"}]},{"item":{"id":"customer-references#aws-case-study-s-p-capital-iq","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-s-p-capital-iq","dateCreated":"2019-07-22T19:56:30+0000","dateUpdated":"2021-12-22T20:27:13+0000","additionalFields":{"featured":"0","descriptionSummary":"The world\u0027s leading provider of independent credit ratings,  S\u0026P Global Ratings has helped people across the globe make better financial decisions for more than 150 years. It provides transparency and education by analyzing investment data from sources such as annual reports, news articles, and management interviews, using the findings to generate credit ratings for credit issuers, intermediaries, and investors in 28 countries.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/S%26P_Logo_@1x.864d7604b6ea62a21bb5e735e5f928303d0e25d9.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eThe S\u0026amp;P Capital IQ platform combines deep global company information and market research with powerful tools for fundamental analysis, idea generation, and workflow management. Based on web and Excel, it provides easy access to both real-time and historical information on companies, markets, transactions, and people worldwide. The data science team saves time and money by using the cloud to build intelligent analytics for the platform, taking advantage of Amazon Web Services (AWS), including Amazon Elastic MapReduce and Amazon S3\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/s-and-p-global-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"S\u0026P","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"S\u0026P Global Ratings Uses AWS to Speed Application Migration, Drive Innovation"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#vmware","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"VMware Cloud on AWS","description":"VMware Cloud on AWS","dateCreated":"2020-03-02T07:05:59+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dat