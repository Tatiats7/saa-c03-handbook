mary":"TicketLeap, an online ticketing platform used by thousands of event organizers across the US and Canada, runs entirely on AWS. TicketLeap uses Amazon EC2, Amazon RDS, Amazon CloudFront, Amazon S3, Elastic Load Balancing, Auto Scaling, and cloud monitoring services as the foundation for its platform.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/TicketLeapLogo.a21625a4e9373842d8c2c919e00615d6e47ffa6e.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eTicketLeap, an online ticketing platform used by thousands of event organizers across the US and Canada, runs entirely on AWS. TicketLeap uses Amazon EC2, Amazon RDS, Amazon CloudFront, Amazon S3, Amazon Elastic Load Balancing, Auto Scaling, and cloud monitoring services as the foundation for its platform.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ticketleap/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"TicketLeap","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: TicketLeap"}},"tags":[{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description