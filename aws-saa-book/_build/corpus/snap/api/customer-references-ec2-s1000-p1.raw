"directoryId":"customer-references","name":"aws-case-study-tellapart","dateCreated":"2019-07-22T20:00:18+0000","dateUpdated":"2021-12-22T19:45:44+0000","additionalFields":{"featured":"0","descriptionSummary":"TellApart provides marketing tools that help online retailers identify their best customers and prospects and send individualized marketing messages to those customers. The company\u0027s world-class engineering team has built a real-time ad bidding engine that leverages a suite of AWS products.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/TellApart_Customer-Reference_Logo.213dfa727cc46e8ce60a30319cd26a1f83767188.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eTellApart provides marketing tools that help online retailers identify their best customers and prospects and send individualized marketing messages to those customers. The company\u0026#39;s world-class engineering team has built a real-time ad bidding engine that leverages a suite of Amazon Web Services (AWS) products.\u003c/p\u003e\r\n","industry":"Retail","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/tellapart/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"TellApart","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: TellApart"}},"tags":[{"id":"GLOBAL#product#glacier","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon S3 Glacier","description":"Amazon S3 Glacier","dateCreated":"2020-03-02T07:03:38+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English",