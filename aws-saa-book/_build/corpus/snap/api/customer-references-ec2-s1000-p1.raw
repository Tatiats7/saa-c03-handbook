otland","description":"Scotland","dateCreated":"2020-04-09T03:37:51+0000","dateUpdated":"2022-02-03T03:31:52+0000"},{"id":"GLOBAL#product#global-accelerator","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Global Accelerator","description":"AWS Global Accelerator","dateCreated":"2020-03-02T07:03:39+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#confa","locale":"en_US","directoryId":"customer-references","name":"confa","dateCreated":"2023-06-01T23:09:13+0000","dateUpdated":"2023-07-14T23:32:26+0000","additionalFields":{"descriptionSummary":"La Caja de Compensación Familiar de Caldas (CONFA) migró su Oracle JD Edwards Enterprise Resource Planning (ERP) a Amazon Web Services (AWS), lo que le permitió a CONFA servir de manera confiable a su base de 400,000 usuarios en el departamento de Caldas.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/confa_Logo%401x.b23a53d2c1b283c103a1ceea6d299c120ad142f8.png","displayLocation":"Colombia","footerInfoText":"Fecha de publicación","industry":"Servicios públicos generales","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/confa/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","customer-name":"Caja de Compensación Familiar de Caldas - CONFA","contentType":"Historia del cliente","headline":"CONFA atiende de manera confiable a 400,000 usuarios después de migrar a AWS"}},"tags":[{"id":"customer-references#category#business-applications-ec2-windows-server","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: EC2 Windows Server","description":"Business Applications: EC2 Windows Server","dateCreated":"2019-07-22T18:31:09+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#colombia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Colombia","description":"Colombia","dateCreated":"2020-07-02T22:31:04+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#efs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic File System (EFS)","description":"Amazon Elastic File System (EFS)","dateCreated":"2020-03-02T07:02:57+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"customer-references#category#app-integration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Application Integration","description":"Application Integration","dateCreated":"2019-07-22T18:30:54+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#c