-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#rackspacelatam","locale":"en_US","directoryId":"customer-references","name":"rackspacelatam","dateCreated":"2023-06-01T23:04:00+0000","dateUpdated":"2023-06-08T04:07:43+0000","additionalFields":{"descriptionSummary":"Rackspace es una de las empresas de servicios tecnológicos más grandes del mundo. Con presencia en más de 21 países y más de 6.500 empleados, Rackspace toma las mejores tecnologías que existen en el mercado y las convierte en servicios para los clientes. Hace unos años, la compañía entendió que era más eficiente asociarse con AWS que invertir en su propia nube para llevar servicios al mercado. En este video, Dafne Fernandez de Castro, Directora de Alianzas de Rackspace en Latinoamérica, explica como la experiencia de AWS se sumó al expertise de administración de esta infraestructura que tiene Rackspace. A partir de la alianza, la empresa ha crecido su base de clientes más del 250% año al año, creció en diferentes industrias y diferentes tamaños de mercado.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/industry-images-customer-references/rackspace_LOGO_v1.21a4ede110b205f921f77aea29e11ebc4497f607.png","displayLocation":"México","customerNameLower":"rackspace","footerInfoText":"Fecha de publicación","industry":"Servicios profesionales","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/rackspacelatam/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Rackspace","enableShare":"1","publishedDate":"2020","contentType":"Historia del cliente","headline":"Caso de Éxito AWS: Rackspace"}},"tags":[{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#central-america","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central America","description":"Central America","dateCreated":"2021-02-19T05:32:25+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#industry#prof-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Professional Services","description":"Professional Services","dateCreated":"2020-06-25T04:07:49+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12T02:01:29+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#use-case#datacenter-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2020-08-18T05:17:48+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#mexico","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Mexico","description":"Mexico","dateCreated":"2020-04-09T00:25:53+0000","dateUpdated":"2022-02-03T03:31:31+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"}]},{"item":{"id":"customer-references#kiusys","locale":"en_US","directoryId":"customer-references","name":"kiusys","dateCreated":"2023-06-01T23:07:58+0000","dateUpdated":"2023-07-14T23:32:40+0000","additionalFields":{"descriptionSummary":"Kiu System Solutions nace en 2003 brindando soluciones tecnológicas para líneas aéreas, entre ellas sistemas de reservas y emisión, soluciones de e-commerce, de control de carga para aviones y puntaje para pasajeros frecuentes. Actualmente, la compañía cuenta con 52 clientes a nivel global, transportando 25 millones de pasajeros, y su sistema está presente en 18 mil agencias de viaje. Con AWS, Kiu logró reducir los tiempos de respuesta de sus servicios, creando una infraestructura de red intolerante a fallas, basada en una arquitectura de microservicios. Procesar 250 mil mensajes de tarifación interlineal le tomaba a Kiusys entre 17 y 22 horas. Gracias a las soluciones en la nube de AWS, la empresa redujo ese tiempo a entre 6 y 7 minutos.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/kiusys_logo%401x.235d4d3e7a8fba9df13ffad9ae6b1df681f2b310.png","displayLocation":"Uruguay","footerInfoText":"Fecha de publicación","industry":"Software e Internet","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/kiusys/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","customer-name":"Kiu System Solutions","contentType":"Historia del cliente","headline":"Kiu System Solutions reduce drásticamente sus tiempos de respuesta con la agilidad de la nube AWS"}},"tags":[{"id":"GLOBAL#location#ur