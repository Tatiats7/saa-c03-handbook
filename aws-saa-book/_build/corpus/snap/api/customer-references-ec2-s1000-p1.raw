ps://d1.awsstatic.com/logos/customers/tixcraft-logo.23c209b738ea2425927f9d1b5f60da269fa6831a.PNG","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003eFounded in 2013, tixCraft provides ticketing services for concerts and other events in Taiwan. The company has migrated its databases, websites, e-commerce, and associated systems for analysis and reporting to AWS. This has enabled tixCraft to scale its IT resources more than 130-fold in 30 minutes, support more than 2,500 orders per second, and achieve 99.999 percent availability.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/tixcraft/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"tixCraft","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: tixCraft"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12T02:01:29+0000"},{"id":"GLOBAL#location#taiwan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Taiwan","description":"Taiwan","dateCreated":"2020-02-03T05:29:38+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dat