"tagNamespaceId":"GLOBAL#customer-segment","name":"Non-profit","description":"Non-profit","dateCreated":"2021-06-04T06:35:44+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#philips-healthcare-case-study","locale":"en_US","directoryId":"customer-references","name":"philips-healthcare-case-study","dateCreated":"2019-07-22T19:58:50+0000","dateUpdated":"2023-07-19T03:05:01+0000","additionalFields":{"featured":"0","descriptionSummary":"Philips\u0027 Healthcare Informatics Solutions and Services division manages and analyzes data for health care providers around the world. The company hosts its digital healthcare platform, Philips HealthSuite, on AWS to manage and analyze 15 PB of patient data and scale as the platform grows at the rate of one petabyte per month.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Philips-logo%401x.72da838390667ff0c4365725bd44e03a02030290.png","displayLocation":"Netherlands","footerInfoText":"Published Date","description":"\u003cp\u003ePhilips hosts its digital healthcare platform, Philips HealthSuite, on AWS to manage and analyze 15 PB of patient data and scale as the platform grows at the rate of one petabyte per month. By using AWS, Philips can build secure and compliant environments to reinvent healthcare for billions of people around the globe.\u003c/p\u003e\r\n","industry":"Healthcare","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/philips-healthcare-informatics-solutions/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Philips Healthcare","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"Philips Healthcare Case Study"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","