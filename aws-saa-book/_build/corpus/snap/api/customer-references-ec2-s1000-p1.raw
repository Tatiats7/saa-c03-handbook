eId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"}]},{"item":{"id":"customer-references#aws-case-study-gibraltar-area-school-district-wisconsin","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-gibraltar-area-school-district-wisconsin","dateCreated":"2019-07-22T19:55:52+0000","dateUpdated":"2022-01-21T02:42:28+0000","additionalFields":{"featured":"0","descriptionSummary":"Gibraltar Area Schools in Fish Creek, Wisconsin, was balancing the expense of aging servers with the realities of a limited state budget. The district decided to forgo local infrastructure in favor of a scalable AWS environment—saving themselves an estimated 25 percent in hardware costs over the next five years.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/gibraltar-area-schools-logo.e1ae030873865085897fa408285d9b00faa5034c.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eGibraltar Area Schools in Fish Creek, Wisconsin, was balancing the expense of aging servers with the realities of a limited state budget. The district decided to forgo local infrastructure in favor of a scalable Amazon Web Services (AWS) environment\u0014saving themselves an estimated 25 percent in hardware costs over the next 5 years. The district is using the savings to buy laptops for students and build out a wireless network on campus.\u003c/p\u003e\r\n","industry":"Education","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/gibraltar-area-schools/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Gibraltar Area School District, Wisconsin","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Gibraltar Area School District, Wisconsin"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#general-public-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"General Public Services","description":"General Public Services","dateCreated":"2020-01-16T17:42:24+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000