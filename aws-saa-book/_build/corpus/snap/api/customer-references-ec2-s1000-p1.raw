2T01:35:18+0000","additionalFields":{"featured":"0","descriptionSummary":"The Michigan Health Information Network Shared Services (MiHIN) uses AWS to process more than 12 million patient health information messages weekly, keep pace with 20 percent growth in demand for new services, and build and test new features in days rather than months. MiHIN enables the exchange of health information throughout the state of Michigan.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/600x400_MiHIN-Logo.d6beb3744a398d586a409f4aa230bfd661dc1d75.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the Michigan Health Information Network customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Healthcare","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/mihin/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"MiHIN","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"MiHIN Case Study"}},"tags":[{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#high-performance-computing","locale":"en_US","tagNamespaceId":"customer-references#category","name":"High Performance Computing","description":"High Performance Computing","dateCreated":"2019-07-22T18:32:00+0000","dateUpdated":"2022-02-26T01:35:03+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute",