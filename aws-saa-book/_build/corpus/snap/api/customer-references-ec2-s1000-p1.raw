:"GLOBAL#workload#microsoft","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"Microsoft","description":"Microsoft","dateCreated":"2021-01-06T00:09:49+0000","dateUpdated":"2022-02-03T03:36:04+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#industry#energy","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Energy","description":"Energy","dateCreated":"2020-07-15T21:58:51+0000","dateUpdated":"2022-02-03T03:32:02+0000"},{"id":"GLOBAL#industry#power-utilities","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Power \u0026 Utilities","description":"Power \u0026 Utilities","dateCreated":"2020-01-16T17:42:37+0000","dateUpdated":"2022-02-03T03:32:08+0000"}]},{"item":{"id":"customer-references#aws-case-study-scholastic","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-scholastic","dateCreated":"2019-07-22T19:51:15+0000","dateUpdated":"2022-12-19T23:23:28+0000","additionalFields":{"featured":"0","descriptionSummary":"Scholastic cut 40 percent off its IT costs and can deliver new services in minutes instead of weeks using AWS. The New York-based company is the world\u0027s largest publisher of children\u0027s books.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Scholastic_Customer-Reference_Logo.600e77a46481651d91b63e1396d2ad3005a1e36a.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eScholastic cut 40 percent from its IT costs and can deliver new services in minutes instead of weeks using AWS. The New York?based company is the world?s largest publisher of children?s books. It turned to AWS services such as Amazon EC2, Amazon Redshift, and Amazon EMR for greater agility and cost efficiency in running its web hosting and e-commerce operations.\u003c/p\u003e\r\n","industry":"Education","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/scholastic/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Scholastic","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Scholastic"}},"tags":[{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#web-hosting","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Web Hosting","description":"Web Hosting","dateCreated":"2019-07-22T18:32:28+0000","dateUpdated":"2022-03-30T20:30:49+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#customer-segment#public-sector-edu","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Education","description":"Education","dateCreated":"2019-07-22T18:39:45+0000","dateUpdated":"2022-03-21T23:5