 developed a \"land registration as a service\" as part of its New Land Registry project.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Landgate_Customer-Reference_Logo.b328fdf999835a001bfe357ba9b112dc92f94b23.png","displayLocation":"Australia","footerInfoText":"Published Date","description":"\u003cp\u003eUsing AWS, Landgate processes land-registration documents in seconds versus weeks, and expects to save AU$51 million over the next five years.\u003c/p\u003e\r\n","industry":"Government","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/landgate/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Landgate","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Landgate Case Study"}},"tags":[{"id":"GLOBAL#location#australia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia","description":"Australia","dateCreated":"2020-02-03T05:29:12+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-t