rs/infospace-log.de4e46446d882b2e7d24f164b7556f0049c25bf0.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eInfoSpace, a leading provider of search monetization solutions, wanted to expand its infrastructure to be closer to customers and its global network of more than 100 partners. Using AWS, InfoSpace migrated its full data center within 6 months and can now easily manage its Microsoft stack on AWS.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/infospace/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"InfoSpace","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: InfoSpace"}},"tags":[{"id":"customer-references#category#business-applications-microsoft-net","locale":"en_US","tagNamespaceId":"customer-references#category","name":"business-applications-microsoft-net","description":"Business Applications: Microsoft .NET","dateCreated":"2019-07-22T18:31:16+0000","dateUpdated":"2020-11-25T01:38:29+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"customer-references#category#business-applications-microsoft","locale":"en_US",