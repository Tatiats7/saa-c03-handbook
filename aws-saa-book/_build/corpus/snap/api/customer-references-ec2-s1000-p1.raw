0","dateUpdated":"2023-07-14T23:32:40+0000","additionalFields":{"featured":"0","descriptionSummary":"Pixels is a digital advertising services company that delivers targeted ads to consumers on the web and mobile. The firm runs its ad server and analytics platforms on AWS. This has enabled Pixels to cut its time to market, excluding hardware procurement, from three months to one month.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/pixels-logo.dd387c5cced3bd9cbe2629fea2ae49d1694303e4.png","displayLocation":"China","footerInfoText":"Published Date","description":"\u003cp\u003ePixels is a digital-advertising services company that delivers targeted ads to consumers on the web and mobile. The firm runs its ad server and analytics platforms in the AWS cloud. This has enabled Pixels to cut its time to market, excluding hardware procurement, from three months to one month.\u003c/p\u003e\r\n","industry":"Digital Marketing","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/pixels/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Pixels","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Pixels"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category",