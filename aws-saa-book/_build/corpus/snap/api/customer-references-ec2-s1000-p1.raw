t. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#cec-case-study","locale":"en_US","directoryId":"customer-references","name":"cec-case-study","dateCreated":"2020-06-25T19:47:49+0000","dateUpdated":"2023-07-14T23:32:46+0000","additionalFields":{"featured":"0","descriptionSummary":"CEC uses AWS to improve its business decision making, gain more detail on performance across the organization, and produce SAP ERP reports 83 percent faster.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/cec-logo.b001ea513c4333431012601e0fe98122c016acf6.png","displayLocation":"Italy","footerInfoText":"Published Date","industry":"Construction \u0026 Real Estate","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/cec/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Continental Engineering Corporation (CEC)","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"CEC Builds a Bright Future with SAP on AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-