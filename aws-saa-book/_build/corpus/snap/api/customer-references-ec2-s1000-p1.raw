","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#aws-case-study-bqool","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-bqool","dateCreated":"2019-07-22T19:53:00+0000","dateUpdated":"2023-07-14T23:32:39+0000","additionalFields":{"featured":"0","descriptionSummary":"BQool provides software that helps Amazon sellers manage reviews and feedback as well as compete with rivals. The company runs its seller software suite on AWS, which has enabled BQool to achieve 99.999 percent infrastructure availability while reducing the time required to launch new services by a month.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Bqool_Customer-Reference_Logo.0b6d539212ed1f8fe7ba9a806b7518d00f9760d6.png","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003eBQool provides software that helps Amazon sellers manage reviews and feedback as well as compete with rivals. The company is running its seller software suite?Repricing Central, Feedback Central, and Review Central?in AWS. This enabled BQool to achieve 99.999 percent infrastructure availability while reducing the time required to launch new services by a month.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/bqool/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"BQool","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: BQool"}},"tags":[{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"customer-references#catego