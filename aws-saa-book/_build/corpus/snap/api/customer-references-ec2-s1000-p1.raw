s una institución privada de educación superior centrada en la educación empresarial ubicada en México. Usando Amazon Elastic Compute Cloud (Amazon EC2), Amazon Simple Storage Service (Amazon S3) y rds (Amazon RDS), EBC aumentó la disponibilidad de sus bases de datos y ahora puede acceder a los datos más rápido que antes.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/Latam%20Cases%20Assets/EBC_LOGOv1.7f98ea1d0aaf39a3b922dd3cdbb365ea27d3768f.png","displayLocation":"México","footerInfoText":"Fecha de publicación","industry":"Educación","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/ebc/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","customer-name":"Escuela Bancaria y Comercial (EBC)","contentType":"Historia del cliente","headline":"EBC apoya su crecimiento con AWS"}},"tags":[{"id":"GLOBAL#location#central-america","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central America","description":"Central America","dateCreated":"2021-02-19T05:32:25+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#directory-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Directory Service","description":"AWS Directory Service","dateCreated":"2020-03-02T07:02:45+0000","dateUpdated":"2022-02-03T03:32:30+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#directconnect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Direct Connect","description":"AWS Direct Connect