sa a buscar soluciones AWS que pudieran generar agilidad e innovación. En este momento, la empresa está trabajando en la migración de su ERP SAP con la nube. Y en el lado de la innovación, Swiss Medical está desarrollando un asistente virtual para los pacientes, sus clínicas, utilizando las plataformas AWS Cloud9 y lambda.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/swissmedical_logo%401x.f6879820ad65d7db91d98b9a3c1883753d5c0d03.png","displayLocation":"Argentina","customerNameLower":"swiss medical group","footerInfoText":"Fecha de publicación","industry":"Atención sanitaria","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/swissmedical/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Swiss Medical Group","enableShare":"1","publishedDate":"2020","contentType":"Historia del cliente","headline":"Swiss Medical utiliza tecnologías AWS para obtener más agilidad e innovar sus operaciones"}},"tags":[{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#workload#sap","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"SAP","description":"SAP","dateCre