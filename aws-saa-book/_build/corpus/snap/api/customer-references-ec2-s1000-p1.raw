ences#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#workload#microsoft","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"Microsoft","description":"Microsoft","dateCreated":"2021-01-06T00:09:49+0000","dateUpdated":"2022-02-03T03:36:04+0000"},{"id":"GLOBAL#location#nordics","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Nordics","description":"Nordics","dateCreated":"2020-02-03T05:30:04+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-import-io","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-import-io","dateCreated":"2019-07-22T19:53:33+0000","dateUpdated":"2023-07-14T23:32:46+0000","additionalFields":{"featured":"0","descriptionSummary":"London-based startup import.io provides an online tool that can be used for scraping data from any website, enabling users to turn website information into structured data and APIs. The company turned to AWS to run its web-data analytics service. Using AWS, the 25-person company can focus on developing products instead of maintaining IT infrastructure, enabling it to deliver feature improvements while scaling to handle billions of transactions annually.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Import.io_Customer-Reference_Logo.e4fb0893c597450a4d032e39bcc5928259873287.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","description":"\u003cp\u003eLondon-based startup import.io provides an online tool that can be used for scraping data from any website, enabling users to turn website information into structured data and APIs. The company turned to AWS to run its web-data analytics service. By using AWS, the 25-person company can focus on developing the product instead of buying and maintaining IT infrastructure, enabling it to deliver continuous feature improvements while easily scaling to handle billions of transactions annually.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/import-io/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Import.io","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Import.io"}},"tags":[{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:43+0000","dateUpdated":"2022-02-03T03:36:00+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","t