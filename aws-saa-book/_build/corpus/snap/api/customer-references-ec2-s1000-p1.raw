,"description":"Travel","dateCreated":"2020-01-16T17:42:42+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#innovator#expedia","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Expedia","description":"Expedia","dateCreated":"2022-09-15T00:48:28+0000","dateUpdated":"2022-09-15T00:48:28+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#aws-case-study-lifeplat","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-lifeplat","dateCreated":"2019-07-22T19:57:56+0000","dateUpdated":"2023-07-14T23:32:40+0000","additionalFields":{"featured":"0","descriptionSummary":"LIFEPLAT is a social network that connects people through common interests. The company uses AWS to deliver high-speed images to website users while providing reliable and unlimited file storage.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/lifeplat-logo.cf9b835075905793564fd0bdf843486c3b1b02cb.png","displayLocation":"China","footerInfoText":"Published Date","description":"\u003cp\u003eLIFEPLAT is a social-network website that connects people through common interests. The company uses Amazon S3 and Amazon CloudFront to deliver high-speed images to website users while providing reliable and unlimited file storage. It also uses Amazon EC2, Elastic Load Balancing, and Amazon RDS.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/lifeplat/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"LIFEPLAT","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: LIFEPLAT"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dat