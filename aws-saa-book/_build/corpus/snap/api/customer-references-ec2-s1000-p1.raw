th this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#xilinx-case-study","locale":"en_US","directoryId":"customer-references","name":"xilinx-case-study","dateCreated":"2019-07-19T15:20:18+0000","dateUpdated":"2023-09-21T00:18:56+0000","additionalFields":{"featured":"0","descriptionSummary":"Xilinx uses AWS to improve software-test turnaround time, help developers be more productive, and scale to meet compute demands. Xilinx is a provider of All Programmable FPGAs, SoCs, MPSoCs, and 3D ICs and software solutions to customers across the globe.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/Xilinx_logo.96421115baa71273ece90b19ad1d0a4ce6f0f6c6.jpeg","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the Xilinx customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Electronics \u0026 Semiconductors","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/xilinx/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Xilinx","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Xilinx Case Study"}},"tags":[{"id":"customer-references#category#dev-and-test","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dev \u0026 Test","description":"Dev \u0026 Test","dateCreated":"2019-07-22T18:31:47+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"customer-references#category#high-performance-computing","locale":"en_US","tagNamespaceId":"customer-references#category","name":"High Performance Computing","description":"High Performance Computing","dateCreated":"2019-07-22T18:32:00+0000","dateUpdated":"2022-02-26T01:35:03+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English",