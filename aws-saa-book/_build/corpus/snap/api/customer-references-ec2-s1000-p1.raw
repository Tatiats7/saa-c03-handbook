to analyze on demand.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/ferrara-candy-logo.e9c3e38eba70ed70d1a49638c3e3f76e8c28bb39.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eFerrara Candy Company, founded in 1908, is the third largest confectionery company in the United States. The company is running its reporting and analytics environment (using SAP BusinessObjects on HANA) in an AWS production environment. By using AWS, insight delivery times have been reduced from weeks to minutes, and the company has access to full data sets and the ability to analyze on demand.\u003c/p\u003e\r\n","industry":"Consumer Packaged Goods (CPG)","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ferrara-candy/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ferrara Candy","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Ferrara Candy"}},"tags":[{"id":"GLOBAL#industry#cpg","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Consumer Packaged Goods (CPG)","description":"Consumer Packaged Goods (CPG)","dateCreated":"2020-06-25T04:03:18+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagN