rences#category#infrastructure","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Infrastructure","description":"Infrastructure","dateCreated":"2019-07-22T18:32:04+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#bbc-case-study","locale":"en_US","directoryId":"customer-references","name":"bbc-case-study","dateCreated":"2019-07-19T14:58:07+0000","dateUpdated":"2021-12-22T19:11:44+0000","additionalFields":{"featured":"0","descriptionSummary":"By using Amazon EFS to share files, the BBC was able to build an agile and cost-effective solution, migrating its on-premises Red Button interactive TV service to the AWS Cloud.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/BBC_Customer-Reference_Logo.248ad4651e2d06d992c1832e92e3cbec9c0c752c.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","description":"\u003cp\u003eBy using Amazon EFS to share files, the BBC was able to build an agile and cost-effective solution, migrating its on-premises Red Button interactive TV service to the AWS Cloud. Using services including Amazon EC2, Amazon EFS, Amazon SNS, Amazon SQS, and Amazon Kinesis, the company was able to move their entire application on time and within budget.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/bbc/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"BBC","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"BBC Case Study"}},"tags":[{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpda