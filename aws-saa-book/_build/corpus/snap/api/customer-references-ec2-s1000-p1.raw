ustomer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#protectwise-case-study","locale":"en_US","directoryId":"customer-references","name":"protectwise-case-study","dateCreated":"2019-07-19T17:08:04+0000","dateUpdated":"2023-07-14T23:32:37+0000","additionalFields":{"featured":"0","descriptionSummary":"ProtectWise uses AWS as the basis for an innovative security-analytics solution, enabling customers to store petabytes of networking data and analyze it in seconds. ProtectWise delivers automated threat detection, pervasive visibility, and unlimited forensic exploration, all from the cloud and on demand.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Protectwise_Customer-Reference_Logo.45c94a4cfe550f5dcc732326fd1e600dd2e02baa.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eProtectWise uses AWS as the basis for an innovative security-analytics solution, enabling customers to store petabytes of networking data and analyze it in seconds. ProtectWise delivers automated threat detection, pervasive visibility, and unlimited forensic exploration, all from the cloud and on demand. The company uses Amazon EBS to buffer incoming data before storing it in Amazon S3, and uses Amazon EC2 to power data processing and analytics.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/protectwise/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ProtectWise","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"ProtectWise Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","da