id":"customer-references#invision-case-study","locale":"en_US","directoryId":"customer-references","name":"invision-case-study","dateCreated":"2019-07-22T19:47:45+0000","dateUpdated":"2023-07-14T23:32:49+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, InVision can offer its workforce-management solution at one tenth of the cost, helping it address a previously untapped 85 percent of the market. InVision is an international provider of workforce-management software and online training for customer contact centers.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/InVision_Customer-Reference_Logo.eb8acc6391c0e27eb2d4768cb59badef5199447e.png","displayLocation":"Germany","footerInfoText":"Published Date","description":"\u003cp\u003eUsing AWS, InVision is able to offer its workforce management solution at one tenth of the cost, helping it address a previously untapped 85 percent of the market. InVision is a leading international provider of workforce management software and online training for customer contact centers. It uses AWS to deliver its web-based, workforce management software as a service, injixo, as well as its e-learning courses and learning management system.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/invision/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"InVision","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"InVision Case Study"}},"tags":[{"id":"GLOBAL#location#germany","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Germany","description":"Germany","dateCreated":"2020-02-03T05:29:55+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id"