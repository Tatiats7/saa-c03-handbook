2-02-03T03:33:06+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#workload#sap","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"SAP","description":"SAP","dateCreated":"2021-01-06T00:09:56+0000","dateUpdated":"2022-02-03T03:36:05+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#hudl-case-study","locale":"en_US","directoryId":"customer-references","name":"hudl-case-study","dateCreated":"2019-07-22T20:00:28+0000","dateUpdated":"2023-07-14T23:32:49+0000","additionalFields":{"descriptionSummary":"Hudl ingests and encodes more than 39 hours of video every minute, boosts video upload speeds by 20 percent, and improves data analysis using AWS. Hudl is a software company that provides a video and analytics platform for coaches and athletes to quickly review game footage to improve team play.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Hudl_Customer-Reference_Logo.79eafd15591be015c0bd847dba63dddbc4743142.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"Hudl uses AWS to deliver two billion videos, including ingesting and encoding more than 35 hours of high-definition video into the platform per minute during sports seasons, to 4.5 million coaches and athletes across 130,000 teams worldwide. Hudl provides a video and smart-analytics platform to coaches and athletes to review game footage so they can improve team play. The company, which was built entirely on AWS, uses more than 20 AWS services, including Amazon Redshift and Amazon Machine Learning to run predictive analytics on sports plays.","industry":"Software \u0026 Internet","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/hudl/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Hudl","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"Hudl Case Study"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2