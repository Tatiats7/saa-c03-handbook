ory#web-hosting","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Web Hosting","description":"Web Hosting","dateCreated":"2019-07-22T18:32:28+0000","dateUpdated":"2022-03-30T20:30:49+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#elb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Elastic Load Balancing (ELB)","description":"Elastic Load Balancing (ELB)","dateCreated":"2020-03-02T07:03:09+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#customer-segment#non-profit","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Non-profit","description":"Non-profit","dateCreated":"2021-06-04T06:35:44+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#viasat-case-study","locale":"en_US","directoryId":"customer-references","name":"viasat-case-study","dateCreated":"2019-07-19T14:58:50+0000","dateUpdated":"2021-12-22T19:26:08+0000","additionalFields":{"featured":"0","descriptionSummary":"Viasat built a business-critical data-ingestion platform using AWS, adopting Amazon EBS st1 volumes for optimal I/O performance and simplified storage management. Viasat is a satellite-communications provider that connects residential customers, flight passengers and crews, and military operations across the globe to the internet through trusted communications ground services, infrastructure, and personnel.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Viasat_Customer-Reference_Logo.0da7da2f8169abba1715ca7435e28c25288ef2fa.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eViasat built a business-critical data-ingestion platform using AWS, adopting Amazon EBS st1 volumes for optimal I/O performance and simplified storage management.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/viasat/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ViaSat","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"ViaSat Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#industry#telecommunications","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Telecommunications","description":"Telecommunications","dateCreated":"2020-01-16T17:42:41+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#avazu-case-study","locale":"en_US","directoryId":"customer-references","name":"avazu-case-study","dateCreated":"2019-07-19T15:19:36+0000","dateUpdated":"2023-07-14T23:32:48+0000","additionalFields":{"featured":"0","descriptionSummary":"Avazu used AWS to dramatically improve system stability and scalability to meet the advertising platform\u0026#39;s processing needs of more than 20 billion impressions per day and more than 1 million queries per second (QPS). Avazu, a subsidiary of the DotC United Group, is a technology-driven company that engages in performance marketing through programmatic advertising technologies.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Avazu_Customer-Reference_Logo.e163e69742e630f599e49404264e5f5c7d96d6f8.png","displayLocation":"China","footerInfoText":"Published Date","description":"\u003cp\u003eRead the Avazu customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/avazu/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Avazu","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Avazu Case Study"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Auto Scaling","description":"AWS Auto Scaling","dateCreated":"2020-03-02T07:01:39+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#industry#digital-marketing","locale":"en_US","tagNamespaceId":"GLOB