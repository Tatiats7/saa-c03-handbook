News Group?s main affiliated newspaper, United Daily News, is available in North America, Europe, and South East Asia, and has a daily circulation of more than 1.5 million. The publication?s website makes news available to readers 24/7.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/united-daily-news/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"United Daily News","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: United Daily News"}},"tags":[{"id":"GLOBAL#use-case#archiving","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Archiving","description":"Archiving","dateCreated":"2020-06-05T06:36:56+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#taiwan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Taiwan","description":"Taiwan","dateCreated":"2020-02-03T05:29:38+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagN