03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#time-inc-secures-customer-data-on-aws-case-study","locale":"en_US","directoryId":"customer-references","name":"time-inc-secures-customer-data-on-aws-case-study","dateCreated":"2019-07-22T19:45:55+0000","dateUpdated":"2021-12-22T20:18:36+0000","additionalFields":{"descriptionSummary":"Time Inc.—a company built over 93 years into a global enterprise with dozens of brands, such as People, Sports Illustrated, Fortune, Entertainment Weekly and, of course, Time magazine—decided to close its legacy data centers and move to AWS. Using AWS, Time Inc. can leverage security features and functionality that mirror the benefits of cloud computing, including rich tools, best-in-class industry standards and protocols, and lower costs.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/TimeInc_Customer-Reference_Logo.dbfd51ec88af7224c18fcc80a3c56ff36c6a82f3.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"With AWS, Time Inc. can leverage security features and functionality that mirror the benefits of cloud computing, including rich tools, best-in-class industry standards and protocols and lower costs. When Time Inc.?s new chief technology officer joined the renowned media organization in early 2014, he promised big changes. The company?built over 93 years into a global enterprise with dozens of brands, such as People, Sports Illustrated, Fortune, Entertainment Weekly and, of course, Time magazine?would close its legacy data centers and move to AWS. The decision sparked major internal changes and challenges, including new ways to implement security.","industry":"Electronics","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/time-inc-secures-customer-data/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Time Inc.","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"Time Inc. Secures Customer Data on AWS Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+0000"},{"