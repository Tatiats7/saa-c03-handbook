gment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-medscheme","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-medscheme","dateCreated":"2019-07-22T19:54:05+0000","dateUpdated":"2023-07-14T23:32:28+0000","additionalFields":{"featured":"0","descriptionSummary":"Medscheme has established a revolutionary healthcare delivery model using an electronic health record system based on AWS. The company offers award-winning health risk management solutions to healthcare providers and patients. Medscheme\u0027s platform allows providers to share and access information regarding a patient\u0027s entire healthcare journey to deliver better, more coordinated care.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/medscheme-logo.2d31f3c5e813897e5628587a673b74b551e513e2.png","displayLocation":"Sub-Saharan Africa","footerInfoText":"Published Date","description":"\u003cp\u003eMedscheme has established a revolutionary healthcare delivery model using an electronic health record system based on Amazon Web Services. The company offers award-winning health risk management solutions to healthcare providers and patients. Medscheme?s platform allows providers to share and access information regarding a patient?s entire healthcare journey to deliver better, more coordinated care.\u003c/p\u003e\r\n","industry":"Healthcare","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/medscheme/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Medscheme","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Medscheme"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"20