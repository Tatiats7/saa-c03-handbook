3:33:02+0000"},{"id":"customer-references#innovator#mercado-libre","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Mercado Libre","description":"Mercado Libre","dateCreated":"2022-09-15T00:48:36+0000","dateUpdated":"2022-09-15T00:48:36+0000"}]},{"item":{"id":"customer-references#wildmoka-francetv","locale":"en_US","directoryId":"customer-references","name":"wildmoka-francetv","dateCreated":"2024-08-16T12:46:04+0000","dateUpdated":"2024-08-16T12:48:59+0000","additionalFields":{"descriptionSummary":"France.tv sport est le portail sportif de France Télévisions et diffuse des magazines sportifs et compétitions sportives. Wildmoka propose des solutions cloud pour l’édition et la diffusion de vidéo live et ‘on-demand’. Sa plateforme permet de créer une grande variété de contenu comme des directs (live), des clips des meilleurs moments, des résumés de match ou bien des replays à destination des supports numériques tels que l’application France.tv (OTT D2C) et les réseaux sociaux.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Wildmoka-francetv%20logo.5203989b7047889fd553b681dcb32bf7930165a6.png","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Wildmoka-francetv%20logo.5203989b7047889fd553b681dcb32bf7930165a6.png","displayLocation":"Canada","customerNameLower":"wildmoka (parenterprise backlight)","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/wildmoka-francetv/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"WildMoka (parenterprise Backlight)","publishedDate":"2020","enableShare":"1","headline":"Etude de cas AWS : Wildmoka et France TV","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated