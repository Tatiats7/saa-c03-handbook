32:25+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#aws-case-study-medstar-health","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-medstar-health","dateCreated":"2019-07-22T19:50:15+0000","dateUpdated":"2023-07-12T01:35:27+0000","additionalFields":{"featured":"0","descriptionSummary":"MedStar Health, the largest not-for-profit healthcare system in Maryland and the Washington, D.C., region, wanted to offer patients an easy way to search for doctors, medical services, and locations, and to make appointments. By creating a centralized patient engagement portal on AWS, MedStar has increased website availability and page download speeds, while lowering monthly operating costs for the portal by more than 40 percent.","imageSrcUrl":"https://d1.awsstatic.com/logos/600x400_logos/600x400_MedstarHealth_Logo.98b4b1c1a2e2cfbaabe0efd87a81e4d7f41440c8.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eMedStar Health, the largest not-for-profit healthcare system in Maryland and the Washington, D.C., region, wanted to offer patients an easy way to search for doctors, medical services, and locations, and to make appointments. To deliver a patient-first experience, the healthcare system decided to combine its disparate websites into a single, searchable portal using AWS. By creating a centralized patient engagement portal on AWS, MedStar has dramatically increased website availability and page download speeds, while lowering monthly operating costs for the portal by more than 40 percent.\u003c/p\u003e\r\n","industry":"Healthcare","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/medstar-health/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"MedStar Health","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: MedStar Health"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0