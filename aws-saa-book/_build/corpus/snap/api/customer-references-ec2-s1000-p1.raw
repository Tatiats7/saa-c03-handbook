 Date","description":"\u003cp\u003eRead the Comcast case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of companies.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/comcast/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Comcast","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"Comcast Case Study"}},"tags":[{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#mgmt-console","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Management Console","description":"AWS Management Console","dateCreated":"2020-03-02T07:04:33+0000","dateUpdated":"2022-02-03T03:32:50+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"