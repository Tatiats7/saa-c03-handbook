,{"item":{"id":"customer-references#geodata-optimizes-log-processing-costs-by-using-amazon-ec2-a1-instances","locale":"en_US","directoryId":"customer-references","name":"geodata-optimizes-log-processing-costs-by-using-amazon-ec2-a1-instances","dateCreated":"2019-11-13T18:49:13+0000","dateUpdated":"2021-12-23T00:24:30+0000","additionalFields":{"featured":"0","descriptionSummary":"Geodata, a GIS software and professional services company in Norway, regularly evaluates new Amazon EC2 instance types. Amazon EC2 A1 instances are best suited for scale-out and Arm-based processor workloads. Geodata uses A1 instances for more stable, cost-effective processing of its log-server workloads.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/geodata_Logo_@1x.08e7aa3a8042dac4a8d16568629e77cb9d863194.png","displayLocation":"Norway","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/geodata-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Geodata","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Geodata Optimizes Log-Processing Costs by Using Amazon EC2 A1 Instances"}},"tags":[{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#use-case#websites-apps