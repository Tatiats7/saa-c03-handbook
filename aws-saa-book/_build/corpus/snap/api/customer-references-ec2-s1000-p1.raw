":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#aws-case-study-overseas-vote-foundation","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-overseas-vote-foundation","dateCreated":"2019-07-22T19:56:48+0000","dateUpdated":"2022-01-21T02:42:41+0000","additionalFields":{"featured":"0","descriptionSummary":"The Overseas Vote Foundation (OVF) is dedicated to helping U.S. citizens overseas vote. OVF turned to AWS to improve performance, handle a 20 percent increase in peak user demand, and reduce costs.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/overseas-vote-foundation-logo.6769ac492913e4b7a151e9b8ad9e03190a088ba1.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eWhen the Overseas Vote Foundation (OVF) decided to expand its services to voters living in the US, the company launched the US Vote Foundation, which offers services including voter registration and absentee ballot requests. OVF turned to Amazon Web Services (AWS) to improve performance, handle a 20% percent increase in peak user demand, and reduce costs.\u003c/p\u003e\r\n","industry":"Government","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ovf/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Overseas Vote Foundation","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Overseas Vote Foundation"}},"tags":[{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use