 Migration","description":"Datacenter Migration","dateCreated":"2020-08-18T05:17:48+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#mobile","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Mobile","description":"Mobile","dateCreated":"2019-07-22T18:32:14+0000","dateUpdated":"2022-03-24T02:42:27+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#application-services","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Application Services","description":"Application Services","dateCreated":"2019-07-22T18:30:56+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"}]},{"item":{"id":"customer-references#pdevidence","locale":"en_US","directoryId":"customer-references","name":"pdevidence","dateCreated":"2019-07-19T15:19:14+0000","dateUpdated":"2022-01-21T02:39:53+0000","additionalFields":{"featured":"0","descriptionSummary":"PDEvidence uses AWS to create a Laboratory Information Systems solution that securely automates crime lab data management, helping the Pennsylvania State Police Computer Crime Unit get criminals off the street faster and save money for taxpayers. PDEvidence is an AWS Technology partner that offers digital laboratory management solutions for law enforcement.","imageSrcUrl":"https://d1.awsstatic.com/WWPS/images/PDEvidence_Logo_600x400.fa3bb1ccc7edc0d4a5fd7f445355abf48d09aa02.jpg","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eThe Need for More Efficient Crime Lab Processes When police departments are trying to solve crimes, they rely on experts at crime laboratories to track, analyze, and report on the evidence. Whether it?s collecting and analyzing DNA, weapons, or data stored on electronic devices, crime labs play a critical role in bringing criminals to justice. However, many crime labs struggle to efficiently track and report on evidence because they use manual, time-consuming, paper-based processes. Labs also often lack efficient methods of sharing data across local agencies. The Pennsylvania State Police Computer Crime Unit dealt with both problems. The unit, which employs regional workers in all corners of the state, manages evidence submissions from municipal police departments, state police barracks, as well as federal partners at the Federal Bureau of Investigation (FBI) and the U.S. Department of Homeland Security. However, the organization used spreadsheets to track submissions, and each region took a different approach to reporting. ?Different regions had different levels of in-house forms they have come up with over the years. Their reporting structure wasn\u0026#39;t completely standardized, and the review process was challenging,? says Ryan Parthemore, founding partner of PDEvidence, a Technology Partner in the AWS Partner Network (APN). PDEvidence provides digital laboratory and evidence management solutions for law enforcement. Without a better solution for the secure sharing of data across police agencies and with federal agencies, the state agency was unable to do its job in the most effective way. Automating Laboratory Data Management on AWS PDEvidence was founded to address the data challenges facing organizations like the Pennsylvania State Police Computer Crime Unit. The organization?s Laboratory Information Systems (LIMS) solution helps law enforcement organizations digitize lab evidence to reduce manual, error-prone processes and enable easier data sharing. From day one, PDEvidence solutions have been based on the Amazon Web Services (AWS) Cloud. ?AWS was the only logical solution for us because of the features that we ultimately deployed. AWS provided us with everything that we needed in terms of easy scalability and reliability,? Parthemore says. PDEvidence chose to offer its solutions via the AWS GovCloud (US), which is approved for sensitive Criminal Justice Information Services (CJIS) workloads that are critical to public safety. The AWS GovCloud (US) Region helps law enforcement agencies follow CJIS Security Policy by providing secure processing tools and storage that meet the FBI?s requirements for accessing this mission-critical information. The AWS GovCloud (US) Region is isolated from other AWS regions and was designed to allow government agencies to move sensitive workloads into the cloud by addressing their specific regulatory and compliance requirements. ?That?s what allows PDEvidence to address the compliance needs of our customers,? states Parthemore. The PDEvidence LIMS uses Amazon Elastic Compute Cloud (Amazon EC2) to ensure scalability. ?We deal with police departments and crime laboratories that might have five people, and we deal with those with far more. The ability for us to scale up or down to meet these needs is critical,? says Parthemore. PDEvidence uses Amazon Simple Storage Service (Amazon S3) for encrypted storage of photos and other digital evidence. The organization is also exploring Amazon Rekognition for image and video analysis. ?Using Amazon Rekognition, we can run crime scene photos through an API, and the service returns a list of tags,? says Parthemore. ?This provides access to indexed, searchable image data, so customers can more quickly locate a specific item in a crime scene photo, for example.? Enabling Real-Time Digital Analysis of Crime Scene Evidence By using the PDEvidence LIMS, crime labs and police departments have automated, centralized evidence-management and reporting capabilities. The Pennsylvania State Police Computer Crime Unit, for example, uses PDEvidence to manage thousands of digital evidence items for forensic analysis. No matter where they are working, the unit?s regional crime lab investigators can quickly enter evidence into the system from a PC, phone, or tablet. Investigators can package and apply a barcode to the evidence, which is then automatically available to workers in one of the unit?s regional offices. ?Crime lab analysts can use our system on a tablet or PC wherever they are, because it?s based on the AWS Cloud,? Parthemore says. ?They no longer have to sit down at a desk and try to fill out worksheets. As they?re measuring or analyzing evidence, they?re recording their results in real time into the system, and reports are automatically generated. The Pennsylvania State Police Computer Crime Unit can now easily view the status of investigations right away.? Helping Solve Crimes More Quickly PDEvidence?s automated evidence management makes forensic analysts at the Pennsylvania State Police Computer Crime Unit more productive, because they no longer rely on data stored on on-premises systems at individual agencies. As a result, analysts can take on more cases and potentially help solve more crimes. ?If we can shorten lab analysis turnaround times by enabling analysts to do their work faster and gather data in real time instead of relying on paper forms, that could help shorten the amount of time criminals are on the streets,? says Parthemore. ?Police departments might be able to get a perpetrator of child exploitation off the streets in three or six months instead of a year or longer, as an example.? Using the PDEvidence solution, the Pennsylvania State Police Computer Crime Unit has, for the first time, transferred the cost of its work from the taxpayer to the convicted criminal. If a defendant is found guilty by the court, or pleads guilty, an invoice based on the specific work performed in the case can be automatically generated from the PDEvidence LIMS. It can then be attached to that defendant\u0026#39;s fines and costs by court order. In fact, in just over four months? time, the PA State Police has saved taxpayers nearly $90K. PDEvidence LIMS also helps states save money on software licensing. Instead of purchasing LIMS software licenses for each examiner?s workstation, agencies can eliminate licensing costs because the PDEvidence LIMS can be accessed from any web browser and data can be easily shared.? PDEvidence anticipates using Amazon Rekognition to give its customers additional technology tools. ?If an investigator needs to review hundreds of crime scene photos, and they?re searching for a red car or a gun or a suspect?s jacket, all that information will be easily indexed and searchable because of the image and video-recognition capabilities of Amazon Rekognition,? states Parthemore. ?We see this technology as another way we can help our customers solve crimes.? Learn More To learn more, visit aws.amazon.com/websites/.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/pdevidence/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"PDEvidence","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"PDEvidence"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#industry#general-public-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"General Public Services","description":"General Public Services","dateCreated":"2020-01-16T17:42:24+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#government-public-sector","locale":"en_US","tagNamespaceId":"customer-references#category","name":"government-public-sector","description":"Government \u0026 Public Sector","dateCreated":"2019-07-22T18:31:57+0000","dateUpdated":"2020-11-25T01:38:26+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#soundexchange-case-study","locale":"en_US","directoryId":"customer-references","name":"soundexchange-case-study","dateCreated":"2019-07-19T15:12:05+0000","dateUpdated":"2022-01-21T02:39:44+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, SoundExchange was able to transform its technology to be efficient, reliable, flexible, and fast. SoundExchange develops business solutions to benefit the entire music industry, and collects and distributes digital performance royalties on behalf of more than 155,000 recording artists and master rights owners.","imageSrcUrl":"https://d1.awsstatic.com/WWPS/images/SoundExchangeLogo.f0d68609fe7bbde5db158e0ef1c24aceccaef9ac.jpg","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eUsing AWS, SoundExchange was able to transform its technology to be efficient, reliable, flexible, and fast. SoundExchange develops business solutions to benefit the entire music industry, and collects and distributes digital performance royalties on behalf of more than 155,000 recording artists and master rights owners. In 2012, SoundExchange began using Amazon Elastic Compute Cloud (Amazon EC2) and Amazon Simple Storage Service (Amazon S3) to host its corporate website. Since then, the company has added capabilities including Elastic Load Balancing and Auto Scaling. From its website to its core business processes to its royalty-administration platform, SoundExchange uses AWS to save money and improve performance.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/soundexchange/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"SoundExchange","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"SoundExchange Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","des