GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#aws-case-study-aeg","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-aeg","dateCreated":"2019-07-22T20:00:24+0000","dateUpdated":"2021-12-22T19:41:18+0000","additionalFields":{"featured":"0","descriptionSummary":"Worldwide entertainment facility provider AEG needed an intranet site for users both inside and outside the corporate network. AEG created a secure Amazon VPC and a SharePoint intranet site that provides 99 percent availability to AEG\u0027s new VPC for 10,000 worldwide users.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/aeg-logo.4e3ffe3429dad682de9d239761ab8033de95066f.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eWorldwide entertainment facility provider AEG needed an intranet site for users both inside and outside the corporate network. Huddle Group, an Argentina-based systems integrator and member of the AWS Partner Network (APN), partnered with AEG to create a secure Amazon Virtual Private Cloud (Amazon VPC) and a SharePoint intranet site. The site provides 99% availability to AEG\u0019s new VPC for 10,000 worldwide users.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/aeg/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"AEG","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: AEG"}},"tags":[{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#mgmt-console","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Management Console","description":"AWS Management Console","dateCreated":"2020-03-02T07:04:33+0000","dateUpdated":"2022-02-03T03:32:50+0000"},{"id":"customer-references#category#business-applications-microsoft","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: Microsoft","description":"Business Applications: Microsoft","dateCreated":"2019-07-22T18:31:11+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","de