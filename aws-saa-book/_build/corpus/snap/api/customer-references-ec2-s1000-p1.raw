ry#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#ssa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Sub-Saharan Africa","description":"Sub-Saharan Africa","dateCreated":"2020-03-10T05:18:06+0000","dateUpdated":"2022-02-03T03:31:58+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-paygate","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-paygate","dateCreated":"2019-07-22T19:50:00+0000","dateUpdated":"2023-07-14T23:32:40+0000","additionalFields":{"featured":"0","descriptionSummary":"PayGate is one of the leading payment-processing companies in southern Africa, and a pioneer in online payment services in the region. PayGate used Amazon Web Services to set up a secure payment-processing gateway based within the European Union for one of its longstanding customers. In doing so, it saved about one million South African Rand (US$75,000) and gained a flexible platform to conduct proofs of concept for future cloud projects.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/paygate-logo.a43da1fb749932227e8ab567bd7988c7791dac66.png","displayLocation":"Sub-Saharan Africa","footerInfoText":"Published Date","description":"\u003cp\u003ePayGate is one of the leading payment processing companies in southern Africa, and a pioneer in online payment services in the region. PayGate used Amazon Web Services to set up a secure payment processing gateway based within the European Union for one of its longstanding customers. In doing so, it saved around one million South African Rand (US$75,000) and gained a flexible platform to conduct proofs of concept for future cloud projects.\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/paygate/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"PayGate","enableShare":"1","publishedDate":"2015","contentType":"Custo