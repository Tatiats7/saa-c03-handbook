n_US","directoryId":"customer-references","name":"copaairlines","dateCreated":"2020-05-04T20:11:08+0000","dateUpdated":"2023-07-12T01:35:41+0000","additionalFields":{"descriptionSummary":"Copa Airlines es una aerolínea panameña fundada en 1947. Actualmente con una flota de 100 aeronaves, una operación de 350 vuelos al día, la compañía trabaja con un movimiento de 16 millones de viajes al año. Copa Airlines necesitaba escalar su infraestructura on premises a Amazon Web Services, buscando obtener baja latencia y escalabilidad en cuanto al manejo de la infraestructura, tornándose una empresa mucho más digital en sus sistemas de reservas e interacciones con clientes. Vea el testimonio de Hugo Aquino, director de Servicios de Infraestructura y Operaciones de Tecnología en Copa Airlines, y conozca más.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/copaairlines_Logo%401x.d8d24e26f32bb8494f7ddff23fc3a6e35b56784c.png","displayLocation":"Panamá","footerInfoText":"Fecha de publicación","industry":"Viajes","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/copaairlines/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","customer-name":"Copa Airlines","contentType":"Historia del cliente","headline":"Copa Airlines agiliza sus operaciones con tecnologías AWS"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dat