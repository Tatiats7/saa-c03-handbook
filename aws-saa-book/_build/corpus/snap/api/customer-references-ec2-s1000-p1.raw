,"description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#middle-east","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East","description":"Middle East","dateCreated":"2020-04-09T03:53:16+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-galata-chemicals","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-galata-chemicals","dateCreated":"2019-07-22T19:54:47+0000","dateUpdated":"2023-07-14T23:32:45+0000","additionalFields":{"featured":"0","descriptionSummary":"Galata Chemicals, an additives producer based in Connecticut, wanted to lower IT costs while maintaining a disaster recovery solution for their SAP ERP system. Galata worked with Protera Technologies to move Galata\u0027s disaster recovery solution to AWS, saving time and reducing operational costs by approximately 70 percent when compared to an on-premises solution.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/GalataChemicals_Customer-Reference_Logo.c6b487665fd864c3a8d50c733ad77b00d991505d.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eGalata Chemicals, an additives producer based in Connecticut, wanted to lower IT costs while maintaining a disaster recovery solution for their SAP ERP system. Galata worked with Protera Technologies to move Galata\u0019s disaster recovery solution to AWS, saving time and reducing operational costs by approximately 70% when compared to an on-premises solution.\u003c/p\u003e\r\n","industry":"Retail","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/galata-chemicals/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Galata Chemicals","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Galata Chemicals"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagN