ted":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#graylink-case-study","locale":"en_US","directoryId":"customer-references","name":"graylink-case-study","dateCreated":"2019-07-19T15:10:37+0000","dateUpdated":"2023-07-14T23:32:36+0000","additionalFields":{"featured":"0","descriptionSummary":"Traditionally a Microsoft customer, graylink chose the AWS Cloud ahead of Microsoft Azure when it decided to improve the flexibility and performance of its software-as-a-service (SaaS) recruitment solutions. graylink helps businesses from across Africa in sectors like retail, financial services, and mining automate and streamline their recruitment processes.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/EMEA/eemm/ssa/graylink.9becd97bdfbef01f11016d4142eeee1ab8b6503d.png","displayLocation":"Sub-Saharan Africa","footerInfoText":"Published Date","description":"\u003cp\u003eTraditionally a Microsoft customer, graylink chose the AWS Cloud ahead of Microsoft Azure when it decided to improve the flexibility and performance of its software-as-a-service (SaaS) recruitment solutions. graylink helps businesses from across Africa in sectors like retail, financial services, and mining automate and streamline their recruitment processes. The company delivers its SaaS solutions via the AWS Cloud using a combination of Amazon EC2 instances and Amazon S3.\u003c/p\u003e\r\n","industry":"Professional Services","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/graylink/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"graylink","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"graylink Case Study"}},"tags":[{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#saas","locale":"en_US","tagNamespaceId":"customer-references#category","name":"SaaS","description":"SaaS","dateCreated":"2019-07-22T18:32:20+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#location#middle-east-africa","locale":"en_US","tagNamespa