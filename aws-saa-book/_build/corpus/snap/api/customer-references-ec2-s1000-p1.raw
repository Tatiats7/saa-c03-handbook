00"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#location#central-america","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central America","description":"Central America","dateCreated":"2021-02-19T05:32:25+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#use-case#datacenter-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2020-08-18T05:17:48+0000","dateUpdated":"2022-02-03T03:35:39+0000"}]},{"item":{"id":"customer-references#inbestcloud","locale":"en_US","directoryId":"customer-references","name":"inbestcloud","dateCreated":"2023-06-01T23:03:29+0000","dateUpdated":"2023-06-08T04:07:44+0000","additionalFields":{"descriptionSummary":"iNBest.Cloud, un socio de APN con experiencia gubernamental, trabaja con organizaciones del sector público, particularmente agencias gubernamentales, para optimizar los costos y la migración de varias cargas de trabajo en Amazon Web Services (AWS). Con sede en Guadalajara, México, iNBest.Cloud apoya a los clientes en su viaje a la nube, con experiencia en servicios administrados en la nube, inteligencia artificial y blockchain. Recientemente, iNBest.Cloud desarrolló una técnica avanzada en AWS para ayudar a los clientes gubernamentales a construir las arquitecturas adecuadas, con alta disponibilidad y esquemas de replicación rápida en AWS.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/case-studies/Latam%20Cases%20Assets/InBest_Logo_v1.ae18f32a1288e89b6065b888a36af81b2003319d.png","displayLocation":"México","customerNameLower":"inbestcloud","footerInfoText":"Fecha de publicación","industry":"Telecomunicaciones","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/inbestcloud/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Inbestcloud","enableShare":"1","publishedDate":"2020","contentType":"Historia del cliente","headline":"iNBest.Cloud ayuda a los clientes a optimizar para la nube de AWS"}},"tags":[{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#location#mexico","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Mexico","description":"Mexico","dateCreated":"2020-04-09T00:25:53+0000","dateUpdated":"2022-02-03T03:31:31+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","n