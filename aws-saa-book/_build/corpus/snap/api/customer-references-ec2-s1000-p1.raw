ences#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-fabric-genomic","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-fabric-genomic","dateCreated":"2019-07-19T14:58:05+0000","dateUpdated":"2023-07-14T23:32:30+0000","additionalFields":{"featured":"0","descriptionSummary":"Fabric Genomics uses AWS to process whole genomes in minutes, help physicians diagnose diseases faster, and scale to support large genomic datasets. The company offers a computational genomics software platform that clinical labs use to rapidly and accurately process and analyze genomic data.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/FabricGenomics_Customer-Reference_Logo.5b0416e5d2357f2e13dedfb234cdb1cfbda1f1b7.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eFabric Genomics uses AWS to process whole genomes in minutes, help physicians diagnose diseases faster, and scale to support large genomic datasets. The company offers a computational genomics software platform that clinical labs use to rapidly and accurately process and analyze genomic data. Fabric Genomics runs its genetic variant discovery and interpretation workloads on AWS.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/fabricgenomics/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Fabric Genomic","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"AWS Case Study: Fabric Genomic"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T0