ps://d1.awsstatic.com/case-studies/US/redviolet_Logo_600x400.a55053b2af57f627e997e7927067ab94d49efad8.jpg","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eSoftware and services company red violet significantly reduces compute costs for large parallel-processing clusters using Amazon EC2 Spot Instances. The company is an innovator in the data fusion space, using cloud computing, proprietary algorithms, and big data to resolve complex data problems. The company uses Amazon EC2 for data processing, relies on Amazon EC2 Spot Instances to keep costs manageable, and counts on Amazon EBS storage to ensure data can persist when Spot Instances are reclaimed.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/red-violet/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"red violet","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"red violet Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Optimization","description":"\u003cp\u003eCost Optimization\u003c/p\u003e\n","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2023-07-13T00:08:24+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOB