"additionalFields":{"featured":"0","descriptionSummary":"By going all in on AWS, 3M Health Information Systems (HIS) provisions compute resources in minutes instead of weeks, develops and deploys software in one week instead of six, and innovates faster. 3M HIS enables customers to efficiently document, code, classify, store, and measure healthcare delivery with integrated software and services, enabling complete, compliant, and accurate payments.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/3MHIS_Customer-Reference_Logo.f0763f3ba25f2df644d3b539a8328c3631dd99ff.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003e3M Health Information Systems (HIS) provisions compute resources in minutes instead of weeks, develops and deploys software in one week instead of six, and innovates faster using AWS.\u003c/p\u003e\r\n","industry":"Healthcare","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/3M-health-information-systems/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"3M Health Information Systems (HIS)","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"3M Health Information Systems (HIS) Case Study"}},"tags":[{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"i