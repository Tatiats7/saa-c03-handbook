d":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-seat-pagine-gialle","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-seat-pagine-gialle","dateCreated":"2019-07-22T19:50:39+0000","dateUpdated":"2023-07-14T23:32:43+0000","additionalFields":{"featured":"0","descriptionSummary":"SEAT Pagine Gialle, the Italian Yellow Pages company, helps its customers achieve visibility through print, voice, and web. Using AWS, SEAT PG can scale to handle its customers\u0027 needs and has cut deployment time for new applications from three to four weeks to just a few days.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/SEATPagineGialle_Customer-Reference_Logo.34ada2cb8af15288bf00a1ea1628c9aa8c8162ee.png","displayLocation":"Italy","footerInfoText":"Published Date","description":"\u003cp\u003eSEAT Pagine Gialle provides website hosting and marketing services to small and medium businesses in Italy. The company uses AWS to host its customers? websites, to build and deploy web applications, and to conduct business intelligence and data mining activities. By using AWS, SEAT PG can scale to handle its customers? needs and has cut deployment time for new applications from three to four weeks to just a few days.\u003c/p\u003e\r\n","industry":"Electronics","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/seat-pagine-gialle/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"SEAT Pagine Gialle","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: SEAT Pagine Gialle"}},"tags":[{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:43+0000","dateUpdated":"2022-02-03T03:36:00+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#italy","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Italy","description":"Italy","dateCreated":"2020-02-03T05:30:02+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#industry#electronics","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Electronics","description":"Electronics","dateCreated":"2020-06-25T04:07:00+0000","dateUpdated":"2022-02-03T03:32:02+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story"