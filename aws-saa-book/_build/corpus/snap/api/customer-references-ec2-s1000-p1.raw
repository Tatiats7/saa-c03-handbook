on":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"customer-references#category#mobile","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Mobile","description":"Mobile","dateCreated":"2019-07-22T18:32:14+0000","dateUpdated":"2022-03-24T02:42:27+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"}]},{"item":{"id":"customer-references#beeswax","locale":"en_US","directoryId":"customer-references","name":"beeswax","dateCreated":"2020-05-20T18:29:25+0000","dateUpdated":"2023-07-14T23:32:49+0000","additionalFields":{"descriptionSummary":"Beeswax is a fully managed real-time bidding (RTB) platform, built on an Amazon Web Services (AWS) infrastructure, that gives advertisers control and transparency over buying advertising programmatically. The company’s Bidder-as-a-Service platform fields millions of queries per second and consumes 125 GB of data per minute. In this session from re:Invent 2017, Ram Kumar Rengaswamy, co-founder and CTO of Beeswax, explains how the company runs its RTB platform on AWS and shares best practices for performance and cost-efficiency at low-latency and high throughput.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/beeswax-logo@1x.43dd62357e5649cb2de3d5aa075bc478cbb7d927.png","displayLocation":"North America","footerInfoText":"Published Date","industry":"Digital Marketing","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/beeswax-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2017","customer-name":"Beeswax","contentType":"Customer Story","headline":"Beeswax Uses AWS to Cost-Effectively Process Millions of Bid Requests per Second"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Optimization","description":"\u003cp\u003eCost Optimization\u003c/p\u003e\n","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2023-07-13T00:08:24+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Auto Scaling","description":"AWS Auto Scaling","dateCreated":"2020-03-02T07:01:39+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#digital-marketing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Digital Marketing","description":"Digital Marketing","dateCreated":"2020-01-16T17:42:16+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#business-category#cloud-cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-06-05T07:06:41+0000","dateUpdated":"2022-02-03T03:31:02+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#heed-case-study","locale":"en_US","directoryId":"customer-references","name":"heed-case-study","dateCreated":"2019-07-22T19:44:18+0000","dateUpdated":"2023-07-14T23:32:36+0000","additionalFields":{"featured":"0","descriptionSummary":"\u003cp\u003eUsing AWS, AGT International and HEED deliver real-time analytics of live sports and entertainment events to fans via an immersive mobile experience. AGT International is a global Internet-of-Things (IoT) analytics company, and HEED is a joint venture by AGT and entertainment company WME-IMG. AGT/HEED uses services including Amazon S3, Amazon EC2, Amazon OpenSearch Service, and Amazon Kinesis to power the delivery of OTT content.\u003c/p\u003e\n","imageSrcUrl":"https://d1.awsstatic.com/case-studies/US/agt_logo.77657b215c8e4903bff48a42405263eb0690708c.png","displayLocation":"Israel","footerInfoText":"Published Date","description":"\u003cp\u003eUsing AWS, AGT International and HEED deliver real-time analytics of live sports and entertainment events to fans via an immersive mobile experience. AGT International is a global internet-of-things (IoT) analytics company and HEED is a joint venture by AGT and entertainment company WME-IMG. AGT/HEED uses services including Amazon S3, Amazon EC2, Amazon OpenSearch Service, and Amazon Kinesis to power the delivery of OTT content. Mati Kochavi, founder of AGT International and HEED, spoke at re:Invent 2017.\u003c/p\u003e\n","industry":"Media \u0026 Entertainment","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/heed/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"HEED","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"HEED Case Study"}},"tags":[{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#category#iot","locale":"en_US","tagNamespaceId":"customer-references#category","name":"IoT","description":"IoT","dateCreated":"2019-07-22T18:32:05+0000","dateUpdated":"2022