arketing","description":"Digital Marketing","dateCreated":"2020-01-16T17:42:16+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#ukir","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"UK/IR","description":"UK/IR","dateCreated":"2020-02-19T23:06:44+0000","dateUpdated":"2022-02-03T03:31:51+0000"}]},{"item":{"id":"customer-references#device-atlas-sustainability","locale":"en_US","directoryId":"customer-references","name":"device-atlas-sustainability","dateCreated":"2024-06-12T18:23:51+0000","dateUpdated":"2024-09-18T00:53:32+0000","additionalFields":{"descriptionSummary":"From startups to massive names like Netflix and Nike, DeviceAtlas customers use its device intelligence platform to get up-to-the-minute data on how people access content on their devices. And they rely on the power, scale, and flexibility of Amazon Web Services (AWS) to run DeviceAtlas efficiently. Ronan Cremin, chief technology officer, says that its customers’ requirements are vast, but the device intelligence leader knows that running on AWS gives them the performance they need.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/DeviceAtlas-logo%401x.d016aed0d91b52c09f1acfd9f27c3ec618cf531d.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/DeviceAtlas-logo%401x.d016aed0d91b52c09f1acfd9f27c3ec618cf531d.png","displayLocation":"Europe","customerNameLower":"deviceatlas","footerInfoText":"Published Date","industry":"Software \u0026 Internet","headlineUrl":"https://aws.amazon.com/solutions/case-studies/device-atlas-sustainability/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"DeviceAtlas","enableShare":"1","publishedDate":"2023","headline":"DeviceAtlas Customers Use AWS to Support Fast Scalability across Thousands of Servers","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#category#gen-ai","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gen AI","description":"\u003cp\u003eGenerative Artificial Intelligence\u003c/p\u003e\n","dateCreated":"2023-07-10T17:07:31+0000","dateUpdated":"2023-07-10T17:07:31+0000"}]},{"item":{"id":"customer-references#doublecloud-graviton-case-study","locale":"en_US","directoryId":"customer-references","name":"doublecloud-graviton-case-study","dateCreated":"2024-05-24T14:07:23+0000","dateUpdated":"2024-05-24T14:09:49+0000","additionalFields":{"descriptionSummary":"DoubleCloud’s priorities were to optimize the performance and cost efficiency of its Managed Service for ClickHouse and Managed Service for Apache Kafka to deliver the best price performance for its customers. The company had been an Amazon Web Services (AWS) customer using Amazon Elastic Compute Cloud (Amazon EC2), which offers secure and resizable compute capacity for virtually any workload. Due to the price-performance benefits, DoubleCloud decided that instances based on AWS Graviton processors—a family of processors designed by AWS to deliver the best price performance for cloud workloads running in Amazon EC2—would be an optimal solution to achieve its goal.","imageSrcUrl":"https://d1.awsstatic.com/DClogo_black.64940bfa2bd589b0092c3e6073052752e680de06.png","displayLocation":"Germany","customerNameLower":"doublecloud","footerInfoText":"Published Date","industry":"Software \u0026 Internet","headlineUrl":"https://aws.amazon.com/solutions/case-studies/doublecloud-graviton-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","customer-name":"DoubleCloud","headline":"Improving Price Performance by 15%–20% Using AWS Graviton with DoubleCloud","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#dach","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"DACH","description":"DACH","dateCreated":"2020-02-03T05:29:52+0000","dateUpdated":"2022-02-03T03:31:47+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#location#germany","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Germany","description":"Germany","dateCreated":"2020-02-03T05:29:55+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"}]},{"item":{"id":"customer-references#rws-generative-ai","locale":"en_US","directoryId":"customer-references","name":"rws-generative-ai","dateCreated":"2024-06-12T18:24:03+0000","dateUpdated":"2024-06-13T17:19:50+0000","additionalFields":{"descriptionSummary":"RWS has become a world leader in its field by providing next-generation translation, localization, and content services. Artificial intelligence (AI) is central to everything it does, and it uses Amazon Web Services (AWS) to speed up end-to-end development and accelerate time to value from generative AI. Proactive expertise and support, along with innovative technology, are why machine translation general manager Mihai Vlad considers AWS “a unique partner.”","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/RWS_logo%401x.ce6ffea4819f8ff07a18b2ac613eed9e25ca75cc.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/RWS_logo%401x.ce6ffea4819f8ff07a18b2ac613eed9e25ca75cc.png","displayLocation":"Europe","customerNameLower":"rws","footerInfoText":"Published Date","industry":"Software \u0026 Internet","headlineUrl":"https://aws.amazon.com/solutions/case-studies/rws-generative-ai/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"RWS","enableShare":"1","publishedDate":"2023","headline":"RWS Accelerates Generative AI Value Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#locat