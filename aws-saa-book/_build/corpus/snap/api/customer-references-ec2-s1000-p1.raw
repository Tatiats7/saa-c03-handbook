teCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#qtac-case-study","locale":"en_US","directoryId":"customer-references","name":"qtac-case-study","dateCreated":"2019-07-19T15:19:35+0000","dateUpdated":"2023-07-14T23:32:42+0000","additionalFields":{"featured":"0","descriptionSummary":"Queensland Tertiary Admissions Centre (QTAC) operates a centralized application service for Queensland, Australia. QTAC uses AWS to offer more reliable services with nearly 100 percent uptime, even with traffic spiking to 80,000 hits per minute.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/QTAC_Customer-Reference_Logo.731680f5162f1ee15ce86e41d1d0af9191036a45.png","displayLocation":"Australia","footerInfoText":"Published Date","description":"\u003cp\u003eRead the QTAC customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousand