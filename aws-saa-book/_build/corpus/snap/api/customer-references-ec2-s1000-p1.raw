d":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#mediamath","locale":"en_US","directoryId":"customer-references","name":"mediamath","dateCreated":"2020-05-04T20:12:45+0000","dateUpdated":"2021-12-23T02:14:55+0000","additionalFields":{"featured":"0","descriptionSummary":"MediaMath is an advertising technology company that helps advertisers and agencies efficiently run media campaigns. The company analyzes 120 billion advertising opportunities per day, with throughput over 2 million bid requests per second. MediaMath processes 3 TB of data per day on the Amazon Web Services (AWS) Cloud, collecting log-level data on real-time bidding wins, web events such as page visits, product purchases, and other offline data.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/mediamath-logo@1x.e281ce1ef2c9f7d3537bfd347b04fdbcd0d363df.png","displayLocation":"North America","footerInfoText":"Published Date","industry":"Digital Marketing","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/mediamath-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"MediaMath","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"MediaMath Maximizes Data Access and Minimizes Latency on AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Comput