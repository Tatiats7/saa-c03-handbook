oft","description":"Microsoft","dateCreated":"2021-01-06T00:09:49+0000","dateUpdated":"2022-02-03T03:36:04+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#aws-case-study-university-of-california-berkeley-amp-lab-s-carat-project","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-university-of-california-berkeley-amp-lab-s-carat-project","dateCreated":"2019-07-22T19:54:17+0000","dateUpdated":"2023-07-12T01:35:27+0000","additionalFields":{"featured":"0","descriptionSummary":"The Algorithms, Machine, and People (AMP) Lab at the University of California Berkeley is a multi-disciplinary research effort designed to build scalable machine learning and data analysis technology. With the help of AWS, the AMP Lab team is able to scale up experiments and try new software on realistic configurations across thousands of computers.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/amp-lap-berkeley_logo.72e23f9a40f2d6031e3cc22829ec51c47d94128c.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eThe AMP Lab at the University of California Berkeley is a multi-disciplinary research effort designed to build scalable machine learning and data analysis technology. With the help of Amazon Web Services (AWS), the AMP Lab team is able to scale up experiments and try new software on realistic configurations across thousands of computers. The AWS Cloud provides the AMP Lab access to low-cost infrastructure and on-demand computing resources, which support big data projects that include Carat, an application created to help measure energy productivity and improve battery life on cell phones.\u003c/p\u003e\r\n","industry":"Education","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/university-of-california-berkeley-amp-lab-genomics-research/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"University of California Berkeley AMP Lab","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"University of California Berkeley AMP Lab\u0027s Genomics Research Project Case Study"}},"tags":[{"id":"customer-references#customer-segment#public-sector-nonprofit","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Nonprofit","description":"Nonprofit","dateCreated":"2019-07-22T18:39:49+0000","dateUpdated":"2022-05-09T21:31:14+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#customer-segment#non-profit","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Non-profit","description":"Non-profit","dateCreated":"2021-06-04T06:35:44+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#aws-case-study-dnanexus","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-dnanexus","dateCreated":"2019-07-22T19:57:15+0000","dateUpdated":"2023-07-12T01:35:33+0000","additionalFields":{"featured":"0","descriptionSummary":"DNAnexus delivers a platform as a service for genomic researchers at more than 100 enterprises across the globe. Using AWS, DNAnexus scales to tens of millions of core hours of analysis and stores petabytes of data in a HIPAA-compliant environment.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/DNAnexus_Customer-Reference_Logo.a405b46a3a9e7ed72d18c15dd94912986d4ce150.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eDNAnexus provides a unified system of data management and sequence analysis for DNA sequencing centers and researchers. DNAnexus relies on Amazon Simple Storage Service (Amazon S3) to meet the company\u0026#39;s extensive storage demand, which will grow from terabytes into petabytes of data. DNAnexus also uses Amazon Elastic Compute Cloud (Amazon EC2) Spot Instances to conduct all of its DNA analysis, while Amazon EC2 On-Demand Instances handle the company\u0026#39;s interactive services, such as its client front end portal and visualization tools.\u003c/p\u003e\r\n","industry":"Life Sciences","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/dnanexus/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"DNAnexus","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: DNAnexus"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#glacier","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon S3 Glacier","description":"Amazon S3 Glacier","dateCreated":"2020-03-02T07:03:38+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#industry#life-sciences","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Life Sciences","descripti