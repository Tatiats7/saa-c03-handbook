0-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"}]},{"item":{"id":"customer-references#coinbase-step-functions-case-study","locale":"en_US","directoryId":"customer-references","name":"coinbase-step-functions-case-study","dateCreated":"2020-05-12T19:11:54+0000","dateUpdated":"2023-07-14T23:32:42+0000","additionalFields":{"descriptionSummary":"Coinbase built a reusable framework for automated deployment pipelines that enables rapidly building new deployers that can securely release code to AWS without slowing engineers. Coinbase is a digital currency wallet and platform with 30 million worldwide customers and trades totaling $220 billion. Coinbases new deployers use a framework based on AWS Lambda, for execution in response to events, and AWS Step Functions, for coordinating multiple AWS services into serverless workflows.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/coinbase-logo@1x.6959f7fa02a044b82aefc490393935eaff66d835.jpg","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/coinbase-step-functions/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","customer-name":"Coinbase","contentType":"Customer Story","headline":"Coinbase Uses AWS Step Functions to Securely Deploy to AWS in Seconds"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","descri