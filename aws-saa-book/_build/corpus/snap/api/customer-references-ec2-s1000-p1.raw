ed":"0","descriptionSummary":"The League of Women Voters (LWV), a US-based nonpartisan political organization that provides voter education and advocacy, needed a hosting solution for its website that could scale up to meet heavy demand during federal elections. LWV uses AWS to provide continual availability, scaling from 3 server instances to 60 on Election Day.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/LeagueOfWomenVoters_Customer-Reference_Logo.57569763fd8882e72eb150d442782cc547804990.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eThe League of Women Voters (LWV), a US-based nonpartisan political organization that provides voter education and advocacy, needed a hosting solution for its website that could scale up to meet heavy demand during federal elections. LWV uses Amazon Web Services to provide continual availability, scaling from 3 server instances to 60 on Election Day.\u003c/p\u003e\r\n","industry":"Nonprofit","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/league-of-women-voters/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"The League of Women Voters","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: The League of Women Voters"}},"tags":[{"id":"customer-references#customer-segment#public-sector-nonprofit","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Nonprofit","description":"Nonprofit","dateCreated":"2019-07-22T18:39:49+0000","dateUpdated":"2022-05-09T21:31:14+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Managemen