fbfd5e01.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","description":"\u003cp\u003eUMH studied the possibility of running SAP S/4HANA Finance on a cloud-based infrastructure. The company looked at offerings from Amazon Web Services (AWS), the Google Cloud Platform (GCP), and China-based Tencent Cloud. Says Ngai, \u001cWe quickly determined that GCP didn\u0019t have locations in China, so we decided not to use it. AWS, however, did have Chinese locations and it had worked with SAP to certify the AWS Cloud for SAP S/4HANA.\u001d\u003c/p\u003e\r\n","industry":"Healthcare","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/umh/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Union Medical Healthcare (UMH)","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Union Medical Healthcare (UMH) Case Study"}},"tags":[{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12T02:01:29+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Busi