 and infrastructure costs.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/SetonHallUniversity_Customer-Reference_Logo.d0ede6ca97287e287616214066383be28a009c46.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eThe Teaching, Learning, and Technology (TLT) Center at Seton Hall University uses Amazon Web Services (AWS) to support faculty with a variety of technology-based teaching and research projects. The TLT Center relies on AWS to facilitate video streaming of events and quickly spin up pilot projects. Using AWS saves TLT $30,000 per year on staff and infrastructure costs.\u003c/p\u003e\r\n","industry":"Education","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/seton-hall/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Seton Hall","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Seton Hall"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Cus