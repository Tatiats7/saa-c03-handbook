,{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"}]},{"item":{"id":"customer-references#jampp-case-study","locale":"en_US","directoryId":"customer-references","name":"jampp-case-study","dateCreated":"2019-07-22T19:44:20+0000","dateUpdated":"2024-05-24T14:09:49+0000","additionalFields":{"featured":"0","descriptionSummary":"n the competitive world of programmatic mobile marketing, companies need to propel the reach of their apps and accelerate their mobile businesses. To streamline this process, Jampp, an Affle company, has developed a smart bidding solution that uses machine learning algorithms to match advertisers with relevant placements. This real-time bidding process happens in milliseconds and relies on fast, accurate compute infrastructure.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/jampp%20logo.339f58d525d5acae97ad73edde3117ed2f9fb00e.png","displayLocation":"United Kingdom","customerNameLower":"jampp","footerInfoText":"Published Date","description":"\u003cp\u003eRead the Jampp customer case study, powered by the AWS Cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Digital Marketing","headlineUrl":"https://aws.amazon.com/solutions/case-studies/jampp-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Jampp","enableShare":"1","contentType":"Customer Story","headline":"Maximizing Efficiency for Bidding System Using AWS Graviton–Based Instances with Jampp"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name"