L#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"customer-references#category#hcls","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Healthcare \u0026 Life Sciences","description":"Healthcare \u0026 Life Sciences","dateCreated":"2019-07-22T18:31:58+0000","dateUpdated":"2022-05-14T20:13:37+0000"}]},{"item":{"id":"customer-references#aws-case-study-us-food-and-drug-administration-fda","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-us-food-and-drug-administration-fda","dateCreated":"2019-07-22T19:56:56+0000","dateUpdated":"2024-05-07T16:34:54+0000","additionalFields":{"featured":"0","descriptionSummary":"The FDA receives 100,000 handwritten reports of adverse drug affects each year. Using AWS and working with APN Partner Captricity, the organization can turn manual reports into machine-readable information with 99.7 percent accuracy, reducing costs from $29 per page to $0.25 per page.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/fda-logo.403c458f566e934be9f46eebf5149deefbe0b5ea.jpg","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eThe US Food and Drug Administration (FDA) protects and promotes public health. The agency, which receives 100,000 handwritten reports of adverse drug affects each year, needed a way to make the data entry process more efficient and reduce costs. By using AWS, the FDA and AWS Partner Captricity quickly turn manual reports into machine-readable information with 99.7% accuracy, reducing costs from $29 per page to $0.25 per page.\u003c/p\u003e\r\n","industry":"Government","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/us-food-and-drug-administration/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"US Food and Drug Administration (FDA)","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: US Food and Drug Administration (FDA)"}},"tags":[{"id":"GL