,"directoryId":"customer-references","name":"aws-case-study-ziff-davis","dateCreated":"2019-07-22T19:54:45+0000","dateUpdated":"2023-07-14T23:32:45+0000","additionalFields":{"featured":"0","descriptionSummary":"After acquiring several web properties rapidly, Ziff Davis, a leading digital media company, had to find a way to implement the company\u0027s proprietary technology on the properties and manage them efficiently. By moving to AWS, Ziff Davis is able to create an efficient R\u0026D environment, programmatically create a cohesive environment across its portfolio, and reduce costs by nearly 30 percent.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/ZiffDavis_Customer-Reference_Logo.c461e7de2c821d0f394fc839e05c6b0f160451fc.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eAfter acquiring several web properties rapidly, Ziff Davis, a leading digital media company, had to find a way to implement the company?s proprietary technology on the properties and manage them efficiently. By moving to AWS, Ziff Davis is able to create an efficient R\u0026amp;D environment, programmatically create a cohesive environment across its portfolio, and reduce costs by nearly 30%.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ziff-davis/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ziff Davis","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Ziff Davis"}},"tags":[{"id":"customer-references#category#dev-and-test","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dev \u0026 Test","description":"Dev \u0026 Test","dateCreated":"2019-07-22T18:31:47+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":