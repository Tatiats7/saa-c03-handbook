-07-22T19:47:30+0000","dateUpdated":"2023-07-14T23:32:47+0000","additionalFields":{"featured":"0","descriptionSummary":"Realtor.com uses AWS to support 50 million monthly website visitors, process tens of millions of ad impressions per day, and enable a DevOps development model. The organization runs a popular online real estate listing website that provides millions of for-sale listings and other information for buyers, sellers, and renters.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Realtor.com_Customer-Reference_Logo.99b47cfa9935b2be2353673c0617866ff8225790.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the Realtor.com case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/realtor-com/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Realtor.com","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"Realtor.com Case Study"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-0