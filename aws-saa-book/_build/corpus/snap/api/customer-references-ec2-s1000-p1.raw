/case-studies/busuu/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Busuu","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"Busuu Case Study"}},"tags":[{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#product#elastic-transcoder","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Transcoder","description":"Amazon Elastic Transcoder","dateCreated":"2020-03-02T07:03:07+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCr