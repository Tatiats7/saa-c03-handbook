384.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eSeven Bridges Genomics uses Amazon Web Services (AWS) to provide researchers with IGOR, a cloud platform that helps them analyze DNA sequencing data. Using AWS has helped enable Seven Bridges to provide their customers with complex genetics analysis at a large scale and at low cost\u0014typically saving researchers 40% compared to in-house solutions.\u003c/p\u003e\r\n","industry":"Healthcare","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/seven-bridges-genomics/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Seven Bridges Genomics","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"Seven Bridges Genomics Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#glacier","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon S3 Glacier","description":"Amazon S3 Glacier","dateCreated":"2020-03-02T07:03:38+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespac