:"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-eataly","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-eataly","dateCreated":"2019-07-22T19:49:51+0000","dateUpdated":"2023-07-14T23:32:32+0000","additionalFields":{"featured":"0","descriptionSummary":"Eataly is a provider of Italian food, beverages, restaurants, and other products and services. By using AWS, Eataly has been able to expand globally while scaling to support hundreds of thousands of users and millions of page views every month.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/eataly-logo.bfb832d1100150c56685f394b7de0af2cd6462fd.png","displayLocation":"Italy","footerInfoText":"Published Date","description":"\u003cp\u003eEataly is a provider of Italian food, beverages, restaurants, and other products and services. It uses AWS for a wide range of business functions, including running its website and e-commerce platform, providing data storage, communicating with a mobile app, and for business analytics. By using AWS, Eataly has been able to expand globally while scaling to support hundreds of thousands of users and millions of page views every month.\u003c/p\u003e\r\n","industry":"Retail","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/eataly/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Eataly","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"