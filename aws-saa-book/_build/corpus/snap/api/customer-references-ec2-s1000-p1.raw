},{"item":{"id":"customer-references#expedia20200306wocmfuaw","locale":"en_US","directoryId":"customer-references","name":"expedia20200306wocmfuaw","dateCreated":"2022-05-23T21:41:25+0000","dateUpdated":"2023-07-19T03:05:02+0000","additionalFields":{"descriptionSummary":"Sandeep from Expedia will explain how they built scalable \u0026 flexible system to ingest high data Volume both real time \u0026 batch leveraging AWS platform \u0026 services. You will learn how Amazon Glue and Amazon EC2 helped ingesting \u0026 transforming heterogenous data, use bookmark capabilities of Glue \u0026 push data to Centralized S3 Data Lake. You will also learn how Amazon Dynamo and Amazon ECS helped ingesting real time data \u0026 loading into RDS Aurora along with monitoring \u0026 alerting using Cloud watch . You will also learn how Expedia systems and Salesforce platform integrate using the power of the AWS platform with seamless experience to users.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Expedia_Customer-Reference_Logo.27045ad031c48bd983a26a5befaf0f39e63ff619.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Travel","sortDate":"2020-03-06","headlineUrl":"https://youtu.be/f5EJBUfGZtw?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Expedia, Inc.","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Expedia: Salesforce Integration with AWS"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#serverless","local