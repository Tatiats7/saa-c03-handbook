id":"customer-references#aws-case-study-futbol-club-barcelona","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-futbol-club-barcelona","dateCreated":"2019-07-22T19:55:00+0000","dateUpdated":"2021-12-22T18:48:51+0000","additionalFields":{"featured":"0","descriptionSummary":"Futbol Club Barcelona (FCBarcelona) is a highly popular soccer team based in Barcelona, Spain. In order to maintain the FCBarcelona website—which boasts over 6,000 pages and over 12,000 digitized photos, and is available in six languages—FCBarcelona\u0027s partner, Gnuine, uses a number of Amazon Web Services products to host Ubiquo Sports, a specialized SaaS CMS: Amazon Route 53, Amazon CloudFront, Amazon S3, Amazon EC2, Elastic Load Balancing, Amazon CloudWatch, Amazon SNS, Amazon RDS, and AWS CloudFormation.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/FCBARCELONA_Customer-Reference_Logo.cbaf57e2a559c99f1c7d8adb74a9e948d6be012a.png","displayLocation":"Spain","footerInfoText":"Published Date","description":"\u003cp\u003eFutbol Club Barcelona (FCBarcelona) is a highly popular soccer team based in Barcelona, Spain. In order to maintain the FCBarcelona website\u0014which boasts over 6,000 pages and over 12,000 digitized photos, and is available in six languages\u0014FCBarcelona\u0019s partner, Gnuine, uses a number of Amazon Web Services (AWS) products to host Ubiquo Sports, a specialized SaaS CMS: Amazon Route 53, Amazon CloudFront, Amazon Simple Storage Service (Amazon S3), Amazon Elastic Compute Cloud (Amazon EC2), Amazon Elastic Load Balancing (Amazon ELB), Amazon CloudWatch, Amazon Simple Notification Service (Amazon SNS), Amazon Relational Database Service (Amazon RDS), and Amazon CloudFormation.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/futbol-club-barcelona/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Futbol Club Barcelona","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Futbol Club Barcelona"}},"tags":[{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u00