,{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#aws-case-study-news-uk","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-news-uk","dateCreated":"2019-07-22T19:52:17+0000","dateUpdated":"2021-12-22T19:09:13+0000","additionalFields":{"featured":"0","descriptionSummary":"News UK is one of Britain\u0027s largest news organizations, publishing 2.4 million newspapers every day. The company migrated some of its enterprise applications, including SAP Business Objects, SAP GRC, and Oracle Enterprise Manager, from traditional data centers to AWS and has shortened its time to market for new development projects from six months to one day and reduced its data center footprint from six to two facilities.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/NewsUK_Customer-Reference_Logo.7cedd4e3817e5643cf89f5d142ad5295bf83b709.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","description":"\u003cp\u003eNews UK is one of Britain?s largest news organizations, publishing 2.4 million newspapers every day. The company migrated some of its enterprise applications including SAP Business Objects, SAP GRC, and Oracle Enterprise Manager from traditional datacenters to AWS. By using AWS, the publisher has shortened its time to market for new development projects from 6 months to 1 day and reduced its datacenter footprint from six to two facilities.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/news-uk/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"News UK","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: News UK"}},"tags":[{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:43+0000","dateUpdated":"2022-02-03T03:36:00+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdat