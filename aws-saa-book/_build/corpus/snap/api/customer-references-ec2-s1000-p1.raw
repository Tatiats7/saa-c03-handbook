teCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"customer-references#category#app-integration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Application Integration","description":"Application Integration","dateCreated":"2019-07-22T18:30:54+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#industry#cpg","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Consumer Packaged Goods (CPG)","description":"Consumer Packaged Goods (CPG)","dateCreated":"2020-06-25T04:03:18+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#category#mobile","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Mobile","description":"Mobile","dateCreated":"2019-07-22T18:32:14+0000","dateUpdated":"2022-03-24T02:42:27+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"}]},{"item":{"id":"customer-references#pasonsfhkpiew846","locale":"en_US","directoryId":"customer-references","name":"pasonsfhkpiew846","dateCreated":"2022-05-23T21:42:59+0000","dateUpdated":"2022-05-23T21:53:08+0000","additionalFields":{"descriptionSummary":"Learn how Pason built a petabyte scalable customer-facing drilling datamart using AWS services. Ed Quan from Pason describes how Amazon EMR, along with Presto, can be used to provide a secure and seamless SQL interface to data that is stored in Amazon RDS and Hive. Hive is used to periodically ETL billions of sensor data points from microservices into S3 and EMRFS. You will also learn how multiple EMR clusters were used to provide high availability and distribute workloads across this solution.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/pason-systems-corp-logo%401x.b704d7d350369b695666907d247573b4918af5c7.png","displayLocation":"Canada","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2020-01-22","headlineUrl":"https://youtu.be/tVjrkpjWG5o?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Pason Systems: Petabyte Scale Drilling Datamart on AWS (LIVE)","customer-name":"Pason Systems Corp"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","descripti