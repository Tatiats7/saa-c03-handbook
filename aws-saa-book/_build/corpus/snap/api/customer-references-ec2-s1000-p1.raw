7+0000","dateUpdated":"2022-02-03T03:35:26+0000"}]},{"item":{"id":"customer-references#third-rock-ventures-case-study","locale":"en_US","directoryId":"customer-references","name":"third-rock-ventures-case-study","dateCreated":"2020-05-12T19:48:46+0000","dateUpdated":"2023-07-12T01:35:21+0000","additionalFields":{"featured":"0","descriptionSummary":"Third Rock Ventures is a venture firm that builds and launches biotech companies that accelerate scientific discoveries and transform patient lives. Dozens of Third Rock portfolio companies make use of AWS services to support their infrastructure, data science, bioinformatics, and machine-learning initiatives.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/thirdrock@1x.ad94bfaebdde1a0344d344fe3ff99d89ea380281.jpg","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/third-rock-ventures/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Third Rock Ventures","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Third Rock Ventures Accelerates Biotechnology sStartups Using AWS Infrastructure and Machine Learning"}},"tags":[{"id":"GLOBAL#product#comprehend","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Comprehend","description":"Amazon Comprehend","dateCreated":"2020-03-02T07:02:18+0000","dateUpdated":"2022-02-03T03:32:25+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"