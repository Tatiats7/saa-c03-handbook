-iq-logo.3692f8e04cf6e18a7017403eb79395d28eb2e0e8.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003ePlaceIQ, a location-based intelligence company in New York City, provides location intelligence for mobile advertising. The company uses Amazon ElastiCache and AWS to improve its web service response time by 83%.\u003c/p\u003e\r\n","industry":"Consumer Packaged Goods (CPG)","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/placeiq/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"PlaceIQ","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: PlaceIQ"}},"tags":[{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#industry#cpg","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Consumer Packaged Goods (CPG)","description":"Consumer Packaged Goods (CPG)","dateCreated":"2020-06-25T04:03:18+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:43+0000","dateUpdated":"2022-02-03T03:36:00+0000"},{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification