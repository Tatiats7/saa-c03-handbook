#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#industry#aerospace","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Aerospace","description":"Aerospace","dateCreated":"2020-06-25T04:02:36+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"customer-references#category#network","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2019-07-22T18:32:15+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"}]},{"item":{"id":"customer-references#zoona-case-study","locale":"en_US","directoryId":"customer-references","name":"zoona-case-study","dateCreated":"2019-07-22T19:44:05+0000","dateUpdated":"2023-07-14T23:32:38+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, Zoona cut IT costs in half while increasing the size of its infrastructure and the number of IT services it supports. The company, which helps people in sub-Saharan Africa gain access to financial services for the first time, has more than 1.6 million customers using Zoona to make electronic money transfers.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Zoona_Customer-Reference_Logo.ed2c1a163afcb4d4f5c1e39f23a47d05fe29494c.png","displayLocation":"Sub-Saharan Africa","footerInfoText":"Published Date","description":"\u003cp\u003eUsing AWS, Zoona cut IT costs in half while increasing the size of its infrastructure and the number of IT services it supports. The company, which helps people in sub-Saharan Africa gain access to financial services for the first time, has more than 1.6 million customers using Zoona to make electronic money transfers. Zoona built a microservices architecture on AWS with Amazon EC2 instances supporting all applications, Amazon RDS supporting MySQL and PostgreSQL databases, and Amazon DynamoDB running Datomic, a distributed database.\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/zoona/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Zoona","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Zoona Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#middle-east-africa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East \u0026 Africa","description":"Middle East \u0026 Africa","dateCreated":"2020-02-03T05:30:19+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"GLOBAL#location#africa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Africa","description":"Africa","dateCreated":"2020-04-09T03:54:59+0000","dateUpdated":"2022-02-03T03:31:56+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#location#ssa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Sub-Saharan Africa","description":"Sub-Saharan Africa","dateCreated":"2020-03-10T05:18:06+0000","dateUpdated":"2022-02-03T03:31:58+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#be-software-case-study","locale":"en_US","directoryId":"customer-references","name":"be-software-case-study","dateCreated":"2019-07-22T19:42:52+0000","dateUpdated":"2021-12-22T19:40:56+0000","additionalFields":{"featured":"0","descriptionSummary":"Be Software cut costs 50 percent and more easily enters new geographic markets as a result of moving to AWS. Be Software provides simple, user-friendly SaaS applications for medical-case management and employment services.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/US/600x400_BeSoftware_Logo.8261d24d3970bee4ce73393b888adc9f26a1f0b8.png","displayLocation":"Australia","footerInfoText":"Published Date","description":"\u003cp\u003eBe Software cut costs 50 percent and more easily enters new geographic markets as a result of moving to AWS. Be Software provides simple, user-friendly SaaS applications for medical-case management and employment services. The company uses Amazon EC2 instances to host and run its customer-facing SaaS applications and takes advantage of Amazon EFS to optimize its processing and volume-storage needs.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/besoftware/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Be Software","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Be Software Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-ca