ocale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"}]},{"item":{"id":"customer-references#waypoint","locale":"en_US","directoryId":"customer-references","name":"waypoint","dateCreated":"2023-06-01T23:03:55+0000","dateUpdated":"2023-06-08T04:07:43+0000","additionalFields":{"descriptionSummary":"Waypoint es una empresa chilena dedicada al desarrollo de logística, despacho, control y monitoreo de transporte de servicio y alimentos, mediante tecnología telemétrica y localización GPS. Las operaciones de Waypoint exigen un control absoluto de tracking de origen a destino, cumpliendo cada una de las demandas del servicio que ofrecen a sus clientes. En el año 2015, una crisis de blackout por espacio de 16 horas, produjo la necesidad de buscar un proveedor de tecnología que les permitiera blindar los procesos. Así aparece AWS para Waypoint. Para conocer más detalle sobre la historia, vea a Gonzalo Vásquez, Gerente de Investigación y Desarrollo de la compañía, quien explica por qué AWS les ha permitido mantener el control de una manera no sólo inmediata sino transparente, beneficiando a sus clientes finales. Conozca su experiencia sobre la tecnología y servicio de AWS y el impacto en el mejoramiento del negocio de Waypoint.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/case-studies/Latam%20Cases%20Assets/Waypoint_LOGO1.a773dad7304ac53374e6cae8b348902c08b232ff.png","disp