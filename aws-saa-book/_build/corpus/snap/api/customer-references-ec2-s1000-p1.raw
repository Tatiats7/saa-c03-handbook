019-07-22T19:56:37+0000","dateUpdated":"2023-07-14T23:32:39+0000","additionalFields":{"featured":"0","descriptionSummary":"Encoding.com provides software-as-a-service video encoding for customers around the world. Encoding.com runs 100 percent of its media processing on Amazon EC2, with video storage and instance backups on Amazon S3, AWS Import/Export service for customers with massive video-encoding jobs, and Amazon CloudFront for cloud video distribution.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Encoding_Customer-Reference_Logo.98c265f10de6abaa32936c8217e744a9e9b0b033.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eEncoding.com provides Software-as-a-Service (SaaS) video encoding for customers around the world. Encoding.com runs 100% of its media processing on Amazon EC2, with video storage and instance backups on Amazon S3, AWS Import/Export service for customers with massive video-encoding jobs, and Amazon CloudFront for \u0026quot;cloud video\u0026quot; distribution.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/encoding/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Encoding","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Encoding"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","descripti