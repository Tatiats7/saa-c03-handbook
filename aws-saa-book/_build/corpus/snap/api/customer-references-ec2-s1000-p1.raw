artner Storm Reply, Vodafone created a compliant, secure solution on AWS that can scale to handle thousands of daily transactions while reducing capital expenditures by 30 percent.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/VodafoneItaly_Customer-Reference_Logo.c0d1be102898f136225385c08cb7cda97f88d089.png","displayLocation":"Italy","footerInfoText":"Published Date","description":"\u003cp\u003eVodafone Italy wanted a secure solution that would make it easy for its customers to buy credit for mobile phone SIM cards. Working with AWS Partner Storm Reply, Vodafone created a compliant, secure solution on AWS that can scale to handle thousands of daily transactions while reducing capital expenditures by 30%.\u003c/p\u003e\r\n","industry":"Telecommunications","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/vodafone-italy/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Vodafone Italy","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Vodafone Italy"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#italy","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Italy","description":"Italy","dateCreated":"2020-02-03T05:30:02+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLO