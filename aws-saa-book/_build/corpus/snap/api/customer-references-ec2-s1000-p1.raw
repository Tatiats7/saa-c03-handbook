,{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-realeyes","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-realeyes","dateCreated":"2019-07-22T19:50:17+0000","dateUpdated":"2023-07-14T23:32:41+0000","additionalFields":{"featured":"0","descriptionSummary":"Business-intelligence firm Realeyes delivers emotion analytics to customers through its video-analysis platform. Realeyes runs its video storage, processing, and analytics platform on AWS. Using AWS, the startup has reduced development time for its data-collection service from months to weeks.","imageSrcUrl":"https://d1.awsstatic.com/logos/600x400_logos/600x400_realeyes_logo.99df23f66ff4b4f02a70a5058042142c8021bb6c.jpg","displayLocation":"Estonia","footerInfoText":"Published Date","description":"\u003cp\u003eUsing state-of-the-art human behavior recognition analysis, Realeyes is a platform that measures peoples? emotions as they view video content through their computers? webcams. The firm works with brands, media companies, and market research agencies to deliver business intelligence through emotion analytics. It recruits volunteer participants from around the world to take part in individual studies to test responses to video content. The results of these studies help organizations focus their marketing messages and make content placement decisions that maximize impact. Founded in 2007, with headquarters in London and offices in the U.S. and Hungary, the startup counts among its clients many Fortune 500 companies and some of the biggest brands in the world, including Coca-Cola, Samsung, and Walt Disney.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/realeyes/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Realeyes","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Realeyes"}},"tags":[{"id":"GLOBAL#product#cloudformation",