US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"customer-references#category#hcls","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Healthcare \u0026 Life Sciences","description":"Healthcare \u0026 Life Sciences","dateCreated":"2019-07-22T18:31:58+0000","dateUpdated":"2022-05-14T20:13:37+0000"}]},{"item":{"id":"customer-references#intuit-mint-case-study-it","locale":"en_US","directoryId":"customer-references","name":"intuit-mint-case-study-it","dateCreated":"2024-11-12T00:54:03+0000","dateUpdated":"2024-11-12T01:13:41+0000","additionalFields":{"descriptionSummary":"Intuit Mint è un servizio gratuito di gestione finanziaria personale utilizzato da oltre sei milioni di utenti negli Stati Uniti e in Canada. Il servizio acquisisce le informazioni finanziarie di un cliente, come ad esempio quelle relative a conti bancari, carte di credito e bollette, presentandole poi in un\u0027unica piattaforma. Mint aggiorna e categorizza le informazioni in tempo reale e in modo automatico, permettendo così ai clienti di visualizzare lo stato delle proprie finanze, seguire le spese e tenere sotto controllo i propri investimenti. Mint, inoltre, fornisce promemoria e servizi di pagamento, rendendo gli utenti non solo in grado di poter visionare la propria situazione finanziaria, ma anche di prendere provvedimenti o agire in merito.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/intuit-logo%401x.abf7c40ea61ce4d0953ca761007c94e44fb36e58.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eIntuit Mint uses AWS to automatically scale to support a 200 percent increase in website traffic, reduce operating costs by 25 percent, and boost website availability and developers\u0019 speed and efficiency.\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/intuit-mint/","customer-name":"Intuit Mint","enableShare":"1","publishedDate":"2017","contentType":"Storia del cliente","headline":"Case study su Intuit Mint"}},"tags":[{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2