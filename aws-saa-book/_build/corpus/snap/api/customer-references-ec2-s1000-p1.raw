uct#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#workload#microsoft","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"Microsoft","description":"Microsoft","dateCreated":"2021-01-06T00:09:49+0000","dateUpdated":"2022-02-03T03:36:04+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-coretech-system","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-coretech-system","dateCreated":"2019-07-22T19:55:22+0000","dateUpdated":"2023-07-14T23:32:46+0000","additionalFields":{"featured":"0","descriptionSummary":"CoreTech System (Moldex3D) provides computer-aided engineering (CAE) simulation software for the plastic injection molding industry. Using AWS to host its SaaS solution, CoreTech System has been able to scale to accommodate job requests automatically, pass cost savings to traditional customers, and expand its customer base.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/coretech-logo.f079fb1c12d0fc64cb707114dc4a4c0c226deac8.png","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003eCoreTech System (Moldex3D) provides computer-aided engineering (CAE) simulation software for the plastic injection molding industry. The company wanted to expand and saw the cloud as an ideal environment for high-computing processing. Using AWS to host its SaaS solution, CoreTech System has been able to scale to accommodate job requests automatically, pass cost savings to traditional customers, and expand its customer base.\u003c/p\u003e\r\n","industry":"Manufacturing","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/coretech-system/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"CoreTech System","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: CoreTech System"}},"tags":[{"id":"customer-references#category#business-applications-ec2-windows-server","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: EC2 Windows Server","description":"Business Applications: EC2 Windows Server","dateCreated":"2019-07-22T18:31:09+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#business-applications-microsoft","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: Microsoft","description":"Business Applications: Microsoft","dateCreated":"2019-07-22T18:31:11+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#taiwan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Taiwan","description":"Taiwan","dateCreated":"2020-02-03T05:29:38+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated"