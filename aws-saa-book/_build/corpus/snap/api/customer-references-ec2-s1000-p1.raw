dated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#use-case#general-database-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"General Database Migration","description":"General Database Migration","dateCreated":"2020-06-05T06:37:24+0000","dateUpdated":"2022-02-03T03:35:41+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#fucn-ec2","locale":"en_US","directoryId":"customer-references","name":"fucn-ec2","dateCreated":"2023-06-01T23:08:27+0000","dateUpdated":"2023-07-14T23:32:25+0000","additionalFields":{"descriptionSummary":"La Fundación Universitaria Católica del Norte es pionera y líder en educación virtual en Colombia. Hace alrededor de dos años, la institución inició una estrategia de automatización y transformación digital liderada por el sacerdote Rector Diego Luis Rendón Urrea y el CTO Ingeniero Yovany Álvarez Correa. De esa manera, se apropió de la gestión tecnológica e impulsó la innovación en sus procesos. Resultó que la transformación le ha permitido no sólo avanzar en temas de innovación y enseñanza, sino que también estar preparada para enfrentar la pandemia de manera mucho más simple.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/catolicadelnorte_logo%401x.be6045b9828d3518f5b979f24de65939ddb78eb5.png","displayLocation":"Colombia","footerInfoText":"Fecha de publicación","industry":"Servicios sociales","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/fucn-ec2/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","customer-name":"Fundacion Universitaria Catolica del Norte","contentType":"Historia del cliente","headline":"Católica del Norte: AWS como base para la transformación digital"}},"tags":[{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#ec2-auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Auto Scaling","description":"Amazon EC2 Auto Scaling","dateCreated":"2020-03-02T07:02:53+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#ebs","loca