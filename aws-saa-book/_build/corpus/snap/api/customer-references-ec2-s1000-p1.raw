0-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#kik-interactive-case-study","locale":"en_US","directoryId":"customer-references","name":"kik-interactive-case-study","dateCreated":"2019-07-22T19:48:03+0000","dateUpdated":"2023-07-14T23:32:44+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, Kik can deliver highly available messaging services that are also fast and responsive. Kik\u0027s leading messaging application is used by more than 275 million people. The company built a sophisticated data-analytics architecture using Amazon Redshift, gaining new insight into subscriber needs and preferences at a fraction of the cost and twice the performance of competing data warehousing solutions.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/KikInteractive_Customer-Reference_Logo.c9ea6679605c94e0f331fb3dc8b07a4f3f9d3a0f.png","displayLocation":"Canada","footerInfoText":"Published Date","description":"\u003cp\u003eUsing AWS, Kik is able to deliver highly available messaging services that are also fast and responsive. Kik\u0019s leading messaging application is used by more than 275 million young people. To deliver the best services for customers, Kik supplements its in-house server infrastructure with resources hosted on the Amazon Web Services cloud. In addition, the company has built a sophisticated data analytics architecture on Amazon Redshift, gaining new insight into subscriber needs and preferences at a fraction of the cost and twice the performance of competing data warehousing solutions.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/kik-interactive/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Kik Interactive","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"Kik Interactive Case Study"}},"tags":[{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","t