"name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"}]},{"item":{"id":"customer-references#aws-case-study-international-civil-aviation-organization-icao","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-international-civil-aviation-organization-icao","dateCreated":"2019-07-22T19:50:20+0000","dateUpdated":"2022-01-21T02:41:32+0000","additionalFields":{"featured":"0","descriptionSummary":"The International Civil Aviation Organization (ICAO) is a United Nations agency that develops and monitors international standards and practices for civil aviation regulations. ICAO uses to AWS to conduct predictive analysis of future aviation needs, to develop and test new solutions based on those findings, and to deliver airport data to users.","imageSrcUrl":"https://d1.awsstatic.com/video-thumbs/icao-thumb.7829d4251ffafbd97bcf091d1d591f7ab0038ae9.PNG","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eThe International Civil Aviation Organization (ICAO) is a U.N. agency that develops and monitors international standards and practices for civil aviation regulations. ICAO uses AWS to conduct predictive analysis of future aviation needs, to develop and test new solutions based on those findings, and to deliver airport data to users. By using AWS, the ICAO gained greater stability, reliability, and higher performance than with its previous IT infrastructure, allowing organization staff to focus on developing its services.\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/international-civil-aviation-organization-icao/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"International Civil Aviation Organization (ICAO)","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: International Civil Aviation Organization (ICAO)"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#dev-and-test","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dev \u0026 Test","description":"Dev \u0026 Test","dateCreated":"2019-07-22T18:31:47+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#industry#general-public-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"General Public Services","description":"General Public Services","dateCreated":"2020-01-16T17:42:24+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-city-of-mckinney","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-city-of-mckinney","dateCreated":"2019-07-22T19:50:49+0000","dateUpdated":"2022-01-21T02:41:34+0000","additionalFields":{"featured":"0","descriptionSummary":"The City of McKinney, Texas has about 155,000 residents and is located 15 miles north of Dallas. The city\u0027s IT department is going all-in on AWS and uses the platform to run a wide range of services and applications, such as its land-management and records-management systems.","imageSrcUrl":"https://d1.awsstatic.com/video-thumbs/Customers/city-of-mckinney-thumb.85cb11bb74577ddb75d6d97af8f33cf014ea57b7.PNG","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eThe City of McKinney, Texas has about 155,000 residents and is located 15 miles north of Dallas. The city?s IT department is going all-in on AWS and uses the platform to run a wide range of services and applications, such as its land-management and records-management systems. By using AWS, the city?s IT department can focus on delivering new and better services for its citizens and city employees instead of spending resources on buying and maintaining IT infrastructure.\u003c/p\u003e\r\n","industry":"Government","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/city-of-mckinney/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"City of McKinney","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: City of McKinney"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"}