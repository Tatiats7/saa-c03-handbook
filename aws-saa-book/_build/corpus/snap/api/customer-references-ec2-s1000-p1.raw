if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#aws-case-study-animoto","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-animoto","dateCreated":"2019-07-22T20:00:04+0000","dateUpdated":"2023-07-14T23:32:41+0000","additionalFields":{"featured":"0","descriptionSummary":"New York-based Animoto launched its web application in 2007, allowing people to create and share videos via the web or mobile device. Using AWS, Animoto scales seamlessly to handle spikes in demand.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Animoto_Customer-Reference_Logo.56aa6e88466d65171c92b45f02eba629aa3b7940.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eNew York-based Animoto launched its web application in 2007, allowing people to create and share videos via the web or mobile device. Using AWS, Animoto scales seamlessly to handle spikes in demand.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/animoto/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Animoto","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Animoto"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+