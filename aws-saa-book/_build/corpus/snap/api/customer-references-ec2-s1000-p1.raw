ateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#lyft-case-study","locale":"en_US","directoryId":"customer-references","name":"lyft-case-study","dateCreated":"2019-07-22T19:48:18+0000","dateUpdated":"2023-07-14T23:32:43+0000","additionalFields":{"featured":"0","descriptionSummary":"Lyft is the fastest growing rideshare company in the United States and is available in more than 200 cities, facilitating 14 million rides per month. Lyft uses AWS to move faster as a company and manage its exponential growth, leveraging AWS products to support more than 100 microservices that enhance every element of its customers\u0027 experience.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Lyft_Customer-Reference_Logo.02133b83791dda50f8f474d6de87b08d4e945dea.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the Lyft customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of companies.\u003c/p\u003e\r\n","industry":"Transport \u0026 Logistics","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/lyft/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Lyft","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"Lyft Case Study"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T0