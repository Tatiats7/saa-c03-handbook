ame":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#aws-case-study-national-trust","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-national-trust","dateCreated":"2019-07-22T19:49:53+0000","dateUpdated":"2022-01-21T02:41:27+0000","additionalFields":{"featured":"0","descriptionSummary":"The National Trust protects and preserves historic houses, landscapes, and gardens in the United Kingdom. It runs its single supporter view (SSV) data warehouse on AWS, which has allowed it to keep total cost of ownership to one-third of the cost of a traditional data warehouse.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/nationa-trust-bank-logo.2bf6088880cc918af8a47708e29d16744ae46099.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","description":"\u003cp\u003eThe largest membership organization in the UK, the National Trust protects and preserves historic houses, landscapes, and gardens. It runs its single supporter view (SSV) data warehouse on AWS technologies, enabling a 360-degree view of all its supporters? relationships and interactions. By using AWS for the SSV, the National Trust has kept total cost of ownership to a third of the cost of a traditional data warehouse, while gaining significant insight into visiting habits to maximize marketing efforts and drive the organization forward.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/national-trust/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"National Trust","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: National Trust"}},"tags":[{"id":"customer-references#customer-segment#public-sector-nonprofit","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Nonprofit","description":"Nonprofit","dateCreated":"2019-07-22T18:39:49+0000","dateUpdated":"2022-05-09T21:31:14+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#uk","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United Kingdom","descri