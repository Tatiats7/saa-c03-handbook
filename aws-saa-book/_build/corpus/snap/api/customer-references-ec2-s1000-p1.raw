dustry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-mythings","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-mythings","dateCreated":"2019-07-22T19:56:53+0000","dateUpdated":"2023-07-14T23:32:42+0000","additionalFields":{"featured":"0","descriptionSummary":"Ad tech company myThings empowers advertisers by providing them with visibility into the performance patterns of their audiences. By using AWS, the company has been able to expand to two new markets and experience 99.999 percent availability.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/MyThings_Customer-Reference_Logo.5baa00a7f8e9cd95b4005b6d1f1fca0e8dbd8481.png","displayLocation":"Israel","footerInfoText":"Published Date","description":"\u003cp\u003eAd tech company myThings empowers advertisers by providing them with visibility into the performance patterns of their audiences. The company uses AWS to provide a highly available, scalable big-data processing system to handle the 5 billion ad impressions it personalizes each month. By using AWS, the company has been able to expand to two new markets and experience 99.999% availability.\u003c/p\u003e\r\n","industry":"Digital Marketing","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/mythings/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"MyThings","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: MyThings"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#middle-east-africa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East \u0026 Africa","description":"Middle East \u0026 Africa","dateCreated":"2020-02-03T05:30:19+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#use-case#web