,"dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-interflora","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-interflora","dateCreated":"2019-07-22T19:50:29+0000","dateUpdated":"2023-07-14T23:32:42+0000","additionalFields":{"featured":"0","descriptionSummary":"Interflora Spain is a business unit of Fleurop-Interflor, the Swiss-based company that operates a floral delivery network doing business in 150 countries. Interflora Spain uses AWS to run its customer-facing e-commerce platform and backend systems, including its Microsoft Dynamics ERP system and big data, business intelligence, and data backup projects. Using AWS, the company can handle seasonal spikes in orders, can quickly and easily update its e-commerce platform, and has made internal business processes more efficient.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/interlfora-logo.3230d23d0d2a58cf947d1f4fd8c16d6e0ccc3d1b.png","displayLocation":"Spain","footerInfoText":"Published Date","description":"\u003cp\u003eInterflora Spain is a business unit of Fleurop-Interflor, the Swiss-based company that operates a floral delivery network doing business in 150 countries. Interflora Spain uses AWS to run its customer-facing e-commerce platform and backend systems, including its Microsoft Dynamics ERP system and big data, business intelligence, and data backup projects. By using AWS, the company can handle seasonal spikes in orders, can quickly and easily update its e-commerce platform, and has made internal business processes more efficient.\u003c/p\u003e\r\n","industry":"Retail","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/interflora/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Interflora","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Interflora"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12T02:01:29+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNam