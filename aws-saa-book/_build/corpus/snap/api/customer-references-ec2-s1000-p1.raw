,"dateCreated":"2019-07-22T19:59:18+0000","dateUpdated":"2023-07-14T23:32:47+0000","additionalFields":{"featured":"0","descriptionSummary":"The Dolphin Browser by MoboTap, Inc. has been downloaded more than 13 million times onto Android, iPhone and iPad mobile devices. The majority of the browser\u0027s services and backend operations are powered by more than eighty instances running Amazon EC2, Amazon S3, Amazon EBS, Amazon EMR, Amazon RDS, and Amazon CloudFront.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/DolphinBrowser_Customer-Reference_Logo.ff95c89cb1e730e050c2a3f296961d5ea5ff69a3.png","displayLocation":"China","footerInfoText":"Published Date","description":"\u003cp\u003eThe Dolphin Browser by MoboTap, Inc. has been downloaded over 13 million times onto Android, iPhone and iPad mobile devices. The majority of the browser\u0019s services and backend operations are powered by more than eighty instances running Amazon EC2, Amazon S3, Amazon EBS, Amazon EMR, Amazon RDS, and Amazon CloudFront.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/dolphin-browser/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"MoboTap Inc.","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Dolphin Browser by MoboTap Inc."}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","descri