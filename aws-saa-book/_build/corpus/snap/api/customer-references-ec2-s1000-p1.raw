Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#toracom","locale":"en_US","directoryId":"customer-references","name":"toracom","dateCreated":"2023-06-01T23:03:47+0000","dateUpdated":"2023-06-08T04:07:43+0000","additionalFields":{"descriptionSummary":"TORAcom se dedica al desarrollo de plataformas digitales en internet. Hace seis años, la compañía empezó usando a los servidores de Amazon Elastic compute Cloud (ec2) como host para las aplicaciones que desarrollaban para sus clientes. Después de algunos años, con el crecimiento del negocio, Toracom conoció la arquitectura sin servidores. Desde 2018, la compañía se inclinó por la parte de serverless applications y desde entonces lo que hace con los clientes es automáticamente autoescalable, muy seguro y flexible.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/case-studies/Latam%20Cases%20Assets/ToraCom_LOGO_NEW_2.72924770cbb088419869d538ca764665566cf58c.png","displayLocation":"México","customerNameLower":"toracom","footerInfoText":"Fecha de publicación","industry":"Software e Internet","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/toracom/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Toracom","enableShare":"1","publishedDate":"2020","contentType":"Historia del cliente","headline":"Toracom aumenta facturación un 200% con servicios de IoT e AI con AWS"}},"tags":[{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreat