BAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#workload#sap","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"SAP","description":"SAP","dateCreated":"2021-01-06T00:09:56+0000","dateUpdated":"2022-02-03T03:36:05+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#braze","locale":"en_US","directoryId":"customer-references","name":"braze","dateCreated":"2020-05-04T20:13:09+0000","dateUpdated":"2021-12-22T22:40:00+0000","additionalFields":{"featured":"0","descriptionSummary":"Braze is a digital customer engagement platform that helps brands deliver customer experiences across email, SMS, push notifications, and other channels. The company uses Amazon Web Services (AWS) to collect, process, and analyze more than half a trillion pieces of consumer behavior data per month to build audience profiles and improve personalized messaging. Braze operates a job-queuing service that processes billions of jobs and sends more than 2 billion messages per day using Amazon CloudWatch, AWS Lambda, and Amazon Elastic Compute Cloud (Amazon EC2) Auto Scaling Groups to cost-effectively handle spikes in data and messaging traffic.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/braze-logo@1x.fc95536196dba62e7b1303f393f705c92c3ed2b4.png","displayLocation":"North America","footerInfoText":"Published Date","industry":"Digital Marketing","sortDate":"2020-01-01","headlineU