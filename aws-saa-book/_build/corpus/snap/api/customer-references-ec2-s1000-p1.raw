o.96050da7d579b1fd147eb1b2daaf7d99b64c0dd1.png","displayLocation":"Finland","footerInfoText":"Published Date","description":"\u003cp\u003eCheckout Finland has set a benchmark for cloud excellence within its banking group by reducing payment times, making compliance easier, and improving uptime during peak sales periods. The company is part of Finland?s largest bank?OP?and provides a range of merchant services for online retailers. It uses services including AWS Lambda and AWS Fargate to run its infrastructure as code so developers can concentrate on building features that matter to customers instead of managing servers.\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/checkout/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Checkout","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Checkout Case Study"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle Ea