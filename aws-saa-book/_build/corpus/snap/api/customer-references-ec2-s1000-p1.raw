T18:34:10+0000","dateUpdated":"2021-03-01T19:27:00+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"Travel \u0026 Hospitality","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2021-02-17T20:17:17+0000"},{"id":"customer-references#location#americas","locale":"en_US","tagNamespaceId":"customer-references#location","name":"americas","description":"Americas","dateCreated":"2019-07-22T18:38:15+0000","dateUpdated":"2020-04-07T22:19:28+0000"}]},{"item":{"id":"customer-references#cerner-case-study","locale":"en_US","directoryId":"customer-references","name":"cerner-case-study","dateCreated":"2019-07-19T15:11:34+0000","dateUpdated":"2023-07-12T01:35:28+0000","additionalFields":{"featured":"0","descriptionSummary":"Cerner uses AWS and big data to gain actionable, real-time insights, simplifying healthcare delivery while reducing costs for payers, providers, and patients. Cerner, one of the leading suppliers of health information technology (HIT) solutions, chose AWS for its global reach and breadth of services, including machine learning and artificial intelligence.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Cerner_Customer-Reference_Logo.016d0a06bc96e694ac6495f37910819f3181a24c.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRyan Hamilton, SVP of Population Health at Cerner, describes how Cerner uses AWS and big data to gain actionable, real-time insights, simplifying healthcare delivery while reducing costs for payers, providers, and patients. Cerner, one of the leading suppliers of health information technology (HIT) solutions, chose AWS for its global reach and breadth of services, including machine learning and artificial intelligence.\u003c/p\u003e\r\n","industry":"Healthcare","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/c