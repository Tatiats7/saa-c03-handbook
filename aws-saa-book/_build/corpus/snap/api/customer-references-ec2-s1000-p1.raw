ty to drive incremental sales of its products.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/NewsInternational_Customer-Reference_Logo.271508bc30ab10cfd36e68a939993f8032c6c88f.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","description":"\u003cp\u003eNews International uses AWS to power its digital services and platforms across the web, mobile devices and tablets. With AWS, the company has built a high-speed transactional platform that has improved both customer experience and the ability to drive incremental sales of its products.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/news-international/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"News International","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: News International"}},"tags":[{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:43+0000","dateUpdated":"2022-02-03T03:36:00+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-refer