this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#aws-case-study-cmune","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-cmune","dateCreated":"2019-07-22T19:55:47+0000","dateUpdated":"2023-07-14T23:32:39+0000","additionalFields":{"featured":"0","descriptionSummary":"Cmune is pioneering the field of 3D social games. Hosting its platform backend on AWS gives Cmunel a flexible and scalable infrastructure critical to the game producer\u0027s success.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/cmune_Customer-Reference_Logo.5e1b0845b66bb5f270907104cdacad04b0b7553b.png","displayLocation":"China","footerInfoText":"Published Date","description":"\u003cp\u003eCmune uses Amazon EC2 and Amazon CloudFront to host the browser-based MMOFPS UberStrike, the largest 3D game on Facebook and MySpace.\u003c/p\u003e\r\n","industry":"Gaming","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/cmune/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Cmune","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Cmune"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#category#web-hosting","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Web Hosting","description":"Web Hosting","dateCreated":"2019-07-22T18:32:28+0000","dateUpdated":"2022-03-30T20:30:49+0000"},{"id":"GLOBAL#location#china","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"China","description":"China","dateCreated":"2020-02-03T05:29:17+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-wetransfer","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-wetransfer","dateCreated":"2019-07-22T19:55:09+0000","dateUpdated":"2023-07-14T23:32:41+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, WeTransfer  seamlessly handles more than 40 million active users, who transfer about 1 billion files each month, generating traffic peaks of 15 GB of data per second. Based in the Netherlands and the United States, the company provides a file- transfer service that makes it easy for users to send files of up to 20 GB in size.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Wetransfer_Customer-Reference_Logo.1de11d5f27ad6284e01c1876954f1a8fa803bd01.png","displayLocation":"Netherlands","footerInfoText":"Published Date","description":"\u003cp\u003eUsing AWS, WeTransfer seamlessly supports more than 40 million active users, who transfer about 1 billion files each month, generating traffic peaks of 15 GB of data per second. Based in the Netherlands and the United States, the company provides a file- transfer service that makes it easy for users to send files of up to 20 GB in size. WeTransfer uses AWS Enterprise Support to maintain high availability and deliver a consistently excellent customer experience.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/wetransfer/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"WeTransfer","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: WeTransfer"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#netherlands","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Netherlands","description":"Netherlands","dateCreated":"2020-02-03T05:29:50+0000","dateUpdated":"2022-02-03T03:31:41+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Custo