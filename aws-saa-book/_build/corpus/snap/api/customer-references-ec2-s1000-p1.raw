ed":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"}]},{"item":{"id":"customer-references#aws-case-study-unalis","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-unalis","dateCreated":"2019-07-22T19:54:02+0000","dateUpdated":"2023-07-14T23:32:41+0000","additionalFields":{"featured":"0","descriptionSummary":"Unalis provides mobile gaming content and applications and uses social media to deliver technical information, videos, illustrations, and e-commerce services to traditional Chinese-speaking markets in Asia. Running on AWS enabled Unalis to save $370,000 in server costs in the first year, reduce the number of employees needed to run its infrastructure by half, and cut three months off the time required to bring a new game to production.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/unalis-logo.c2e8dd7ce415a5f24a4f4cc91a5c8993f56565b0.png","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003eUnalis provides mobile gaming content and applications and uses social media to deliver technical information, videos, illustrations, and e-commerce services to traditional Chinese-speaking markets in Asia. The business is running its mobile games, mobile analytics platform, and social media services on AWS. This enabled Unalis to save about $370,000 in server costs in the first year, reduce the number of employees needed to run its infrastructure by half from about 20 to 10, and cut three months from the time required to bring a new game to production.\u003c/p\u003e\r\n","industry":"Gaming","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/unalis/?did\u003dcr_card\u0026trk\u003dcr_card","cu