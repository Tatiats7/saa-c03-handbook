,"tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#service-catalog","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Service Catalog","description":"AWS Service Catalog","dateCreated":"2020-03-02T07:05:20+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#the-globe-and-mail-case-study","locale":"en_US","directoryId":"customer-references","name":"the-globe-and-mail-case-study","dateCreated":"2019-07-22T19:47:47+0000","dateUpdated":"2021-12-22T18:47:57+0000","additionalFields":{"featured":"0","descriptionSummary":"The Globe and Mail is using AWS to deliver dynamic, personalized content to its readers and has boosted reader engagement by 25 percent. Established more than 170 years ago, Canada\u0027s number-one weekday and weekend newspaper has more than 4.7 million weekly digital readers. The company wanted to offer its online readers a personalized recommendation system, and had help from ClearScale, a Premier Consulting Partner, to build that system on AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/GlobeAndMail_Customer-Reference_Logo.4bdb836f4fb099401bfa0223b31fab99a4b355c7.png","displayLocation":"Canada","footerInfoText":"Published Date","description":"\u003cp\u003eThe Globe and Mail is using Amazon Web Services (AWS) to deliver dynamic, personalized content to its readers and has boosted reader engagement by 25 percent. Established more than 170 years ago, Canada\u0019s number-one weekday and weekend newspaper has more than 4.7 million weekly digital readers. The company wanted to offer its online readers a personalized recommendation system, and had help from ClearScale, a Premier Consulting Partner, to build that system on AWS. The newspaper processes, stores, and analyzes recommendation data using big-data tools including Amazon Kinesis, Amazon DynamoDB, and Amazon Elastic MapReduce.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/the-globe-and-mail-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"The Globe and Mail","