16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"}]},{"item":{"id":"customer-references#custora-case-study","locale":"en_US","directoryId":"customer-references","name":"custora-case-study","dateCreated":"2019-07-19T15:19:12+0000","dateUpdated":"2021-12-22T18:45:11+0000","additionalFields":{"featured":"0","descriptionSummary":"Custora reduced its operational burden, eliminated downtime, and increased the speed of onboarding new customers by shifting client data to Amazon EFS. Custora is an advanced customer-segmentation platform built for retail, enabling marketing and CRM teams to easily create targeted customer lists to improve ROI for email, display ads, Facebook, and direct-mail campaigns.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/600x400_Custora_Logo.9ce599348c7793b282108d3e1d619062c63acbac.jpg","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eCustora reduced its operational burden, eliminated downtime, and increased the speed of onboarding new customers by shifting client data to Amazon EFS.\u003c/p\u003e\r\n","industry":"Digital Marketing","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/custora/?did\u003dcr_card\u0026trk\u003dcr_card-cr_card","customer-name":"custora","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Custora Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"customer-references#category#batch-processing","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Batch Processing","description":"Batch Processing","dateCreated":"2019-07-22T18:31:02+0000","dateUpdated":"2022-02-26T01:35:02+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#digital-marketing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Digital Marketing","description":"Digital Marketing","dateCreated":"2020-01-16T17:42:16+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"}]},{"item":{"id":"customer-references#aws-case-study-cyberlink","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-cyberlink","dateCreated":"2019-07-19T15:19:41+0000","dateUpdated":"2021-12-22T19:42:12+0000","additionalFields":{"featured":"0","descriptionSummary":"CyberLink cuts development time for U Webinar in half by using AWS and cuts IT administration by 28 percent. CyberLink is a leading provider of multimedia software and a pioneer in video and audio technologies.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/CyberLink_Customer-Reference_Logo.a048ec5e47e002534c609e53ac7b7c752eaf77b4.png","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003eRead the CyberLink customer case study. CyberLink cuts development time for U Webinar in half by using the AWS Cloud and cuts IT administration by 28 percent. CyberLink is a leading provider of multimedia software and a pioneer in video and audio technologies. The company runs U Webinar from the AWS Cloud, using Amazon EC2 instances for web and streaming services, Amazon RDS as a fully managed database, and AWS Lambda for U Webinar\u0019s Smart Index feature.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/cyberlink/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"CyberLink","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"AWS Case Study - CyberLink"}},"tags":[{"id":"GLOBAL#location#taiwan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Taiwan","description":"Taiwan","dateCreated":"2020-02-03T05:29:38+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#language#english",