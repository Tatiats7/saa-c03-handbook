},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-general-electric-s-digital-transformation-it","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-general-electric-s-digital-transformation-it","dateCreated":"2024-11-12T00:53:54+0000","dateUpdated":"2024-11-12T01:13:41+0000","additionalFields":{"descriptionSummary":"General Electric (GE) opera in 180 paesi ed è un azienda leader nella produzione ad impiego industriale da oltre un secolo. Grazie a una combinazione di software, analisi e ingegneria di prim\u0027ordine, GE aiuta le aziende di tutto il mondo a lavorare in modo più efficiente, affidabile e sicuro. L’impresa utilizza oltre 2000 applicazioni cloud e 55 servizi AWS per aumentare la portata, l’efficienza e le prestazioni nei settori dell\u0027aviazione, dell\u0027energia elettrica, della sanità e dell\u0027energia rinnovabile.","featureImageURL":"https://d1.awsstatic.com/aws-key-pages/homepage-key-pages/customer-stories-logo/GE.69d638be1bb211236c8d87590e8ee0be001b543c.jpg","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/GEPower_Customer-Reference_Logo.7100af15f7461bdc2ea9edec4f9b61e536c54f48.png","displayLocation":"A