":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"}]},{"item":{"id":"customer-references#woot-case-study","locale":"en_US","directoryId":"customer-references","name":"woot-case-study","dateCreated":"2019-07-19T14:56:57+0000","dateUpdated":"2021-12-22T19:26:41+0000","additionalFields":{"featured":"0","descriptionSummary":"Woot cut its data warehouse operating costs by 90 percent, shifted to a model of shared responsibility for data between developer and data teams, and reduced operations overhead by migrating to a serverless data warehouse on AWS. Woot, the original daily deals website, offers other short-term sales across seven product categories.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Woot_Customer-Reference_Logo.655d006e422fbd8c2b724c432feb195254f31f1a.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eWoot cut its data warehouse operating costs by 90 percent, shifted to a model of shared responsibility for data between developer and data teams, and reduced operations overhead by migrating to a serverless data warehouse on AWS. Woot, the original daily deals website, offers other short-term sales across seven product categories. The company is using Amazon Kinesis Data Firehose and Amazon S3 for data ingestion and storage, and it relies on Amazon Athena and Amazon QuickSight for user-friendly querying and data visualization.\u003c/p\u003e\r\n","industry":"Retail","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/woot/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Woot","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Woot Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#retail","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Retail","description":"Retail","dateCreated":"2020-01-16T17:42:39+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#quicksight","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon QuickSight","description":"Amazon QuickSight","dateCreated":"2020-03-02T07:04:56+0000","dateUpdated":"2022-02-03T03:32:55+0000"},{"id":"GLOBAL#product#kinesis-data-firehose","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis Firehose","description":"Amazon Kinesis Firehose","dateCreated":"2020-05-08T03:42:48+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000","dateUpdated":"2022-02-03T03:32:39+0000"}]},{"item":{"id":"customer-references#caleidos","locale":"en_US","directoryId":"customer-references","name":"caleidos","dateCreated":"2023-06-01T23:09:35+0000","dateUpdated":"2023-07-14T23:32:26+0000","additionalFields":{"descriptionSummary":"Gracias a AWS, Caleidos puede ofrecer soluciones innovadoras de alta tecnología a sus clientes, escalables y de bajo costo. Caleidos es una agencia que busca transformar organizaciones a través del diseño y desarrollo de tecnología. Son clientes y partners de AWS. Utilizando AWS han logrado reducir en 80% sus costos de infraestructura.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/caleidos_logo%401x.51e2021962a0ec52d57d4e2456e48fce9367141f.png","displayLocation":"Perú","footerInfoText":"Fecha de publicación","industry":"Bienes envasados de consumo (CPG)","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/caleidos/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","customer-name":"Caleidos Media","contentType":"Historia del cliente","headline":"Caso práctico de Caleidos"}},"tags":[{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#quicksight","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon QuickSight","description":"Amazon QuickSight","dateCreated":"2020-03-02T07:04:56+0000","dateUpdated":"2022-02-03T03:32:55+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"