eated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#product#quicksight","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon QuickSight","description":"Amazon QuickSight","dateCreated":"2020-03-02T07:04:56+0000","dateUpdated":"2022-02-03T03:32:55+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#vodfactory-video","locale":"en_US","directoryId":"customer-references","name":"vodfactory-video","dateCreated":"2023-07-18T00:06:06+0000","dateUpdated":"2023-08-11T22:26:57+0000","additionalFields":{"videoSrcUrl":"https://youtu.be/VPAEJXb8FGk","descriptionSummary":"\u003cp\u003eFond\u0026eacute; \u0026agrave; Paris en 2013, VOD Factory est le sp\u0026eacute;cialiste de la vid\u0026eacute;o \u0026agrave; la demande en France. S\u0026rsquo;appuyant sur AWS pour d\u0026eacute;velopper sa solution \u0026quot;Otto\u0026quot;, VOD Factory permet aux propri\u0026eacute;taires de contenu de cr\u0026eacute;er leur propre plateforme de streaming. \u0026Eacute;galement \u0026eacute;diteur de services SVOD (Queerscreen, Shadowz, Spicee), VOD Factory est ainsi en mesure de faire b\u0026eacute;n\u0026eacute;ficier \u0026agrave; ses clients de sa propre exp\u0026eacute;rience m\u0026eacute;tier. Amen\u0026eacute; \u0026agrave; accueillir un nombre important et variable de connexions, VOD Factory tire parti de l\u0026rsquo;\u0026eacute;lasticit\u0026eacute; du Cloud AWS pour adapter son infrastructure \u0026agrave; la demande et garantir \u0026agrave; ses utilisateurs performance et disponibilit\u0026eacute; dans le monde entier. Dans cette vid\u0026eacute;o, Julien Vin-Ramarony, Pr\u0026eacute;sident de VOD Factory, nous explique pourquoi ses \u0026eacute;quipes ont fait appel \u0026agrave; AWS et nous \u0026eacute;claire sur les d\u0026eacute;fis que son entreprise souhaite relever \u0026agrave; l\u0026#39;avenir.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/VOD%20Factory%20-%20logo.302dad665c7b364e85940ceab56b226a4f5fc51e.png","displayLocation":"Europe, Moyen-Orient et Afrique","footerInfoText":"Date de publication","industry":"Logiciels et Internet","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/vodfactory-video/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"VOD Factory","enableShare":"1","publishedDate":"2021","contentType":"Témoignages clients","headline":"VOD Factory : l\u0027histoire d\u0027une solution clé en main pour créer sa propre plateforme de streaming"}},"tags":[{"id":"GLOBAL#product#elastic-inference","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Inference","description":"Amazon Elastic Inference","dateCreated":"2020-03-02T07:03:04+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#product#savings-plans","locale":"en_US","tagNamespaceId":"GLOBAL#product","