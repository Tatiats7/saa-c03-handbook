L#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#quicksight","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon QuickSight","description":"Amazon QuickSight","dateCreated":"2020-03-02T07:04:56+0000","dateUpdated":"2022-02-03T03:32:55+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#freelance-com-video","locale":"en_US","directoryId":"customer-references","name":"freelance-com-video","dateCreated":"2023-07-17T23:59:21+0000","dateUpdated":"2023-07-18T00:18:07+0000","additionalFields":{"videoSrcUrl":"https://www.youtube.com/watch?v\u003dJndKDYL8iXQ","descriptionSummary":"\u003cp\u003eCr\u0026eacute;\u0026eacute; en 1996, Freelance.com est l\u0026#39;acteur europ\u0026eacute;en leader du Freelancing et de l\u0026#39;interm\u0026eacute;diation entreprise/talents externes. Freelance.com aide \u0026agrave; initier, animer, simplifier et s\u0026eacute;curiser la relation entre les entreprises et leurs talents externes. Observant une forte croissance, des besoins d\u0026#39;agilit\u0026eacute;, de r\u0026eacute;duction du temps de maintenance de son infrastructure et une volont\u0026eacute; de se tourner vers des architectures en microservices, Freelance.com a fait le choix d\u0026rsquo;AWS. D\u0026#39;autre part, les acquisitions externes de Freelance.com ont introduit la n\u0026eacute;cessit\u0026eacute; d\u0026#39;une solution pour consolider les diff\u0026eacute;rentes sources de donn\u0026eacute;es de l\u0026#39;entreprise et d\u0026#39;avoir une vue en temps r\u0026eacute;el des op\u0026eacute;rations. Dans cette vid\u0026eacute;o, Jean-Michel Mas, CTO de Freelance.com, nous raconte comment la collaboration entre les \u0026eacute;quipes de Freelance.com, d\u0026#39;AWS et de son partenaire Gekko Part of Accenture a permis la construction d\u0026rsquo;un Data Lake, qui consolide les donn\u0026eacute;es de l\u0026#39;entreprise, avec une visualisation des donn\u0026eacute;es op\u0026eacute;rationnelles sur Amazon QuickSight. \u0026Agrave; l\u0026#39;avenir, Freelance.com souhaite capitaliser sur son Data Lake et d\u0026eacute;velopper de nouvelles fonctionnalit\u0026eacute;s se basant sur l\u0026#39;intelligence artificielle, afin de servir au mieux ses clients.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Freelancecom%20logo.a38163dac8d2342f1e2f17db3be55d66b277019d.png","displayLocation":"Europe, Moyen-Orient et Afrique","footerInfoText":"Date de publication","industry":"Services professionnels","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/freelance-com-video/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Freelance.com","enableShare":"1","publishedDate":"2022","contentType":"Témoignages clients","headline":"Freelance.com, la donnée au service du pilotage de l’activité"}},"tags":[{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#use-case#data-lakes","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Data Lakes","description":"Data Lakes","dateCreated":"2020-06-05T06:37:09+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#industry#prof-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Professional Services","description":"Professional Services","dateCreated":"2020-06-25T04:07:49+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Mid-Market Territory (MMT)","description":"Mid-Market Territory (MMT)","dateCreated":"2021-06-04T06:35:43+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#product#quicksight","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon QuickSight","description":"Amazon QuickSight","dateCreated":"2020-03-02T07:04:56+0000","dateUpdated":"2022-02-03T03:32:55+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#category#data-lakes-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Data Lakes \u0026 Analytics","description":"Data Lakes \u0026 Analytics","dateCreated":"2019-07-22T18:31:39+0000","dateUpdated":"2022-02-07T13:55:55+0000"},{"id":"GLOBAL#language#french","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"French","description":"French","dateCreated":"2020-03-03T06:40:44+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"}]},{"item":{"id":"customer-references#jps-variation1","locale":"en_US","directoryId":"customer-references","name":"jps-variation1","dateCreated":"2023-06-01T23:06:39+0000","dateUpdated":"2023-06-08T04:07:40+0000","additionalFields":{"videoSrcUrl":"https://www.youtube.com/watch?v\u003dAFNW_LsOKw0","descriptionSummary":"Jamaica Public Service (JPS) es el único distribuidor de electricidad en Jamaica. Hace aproximadamente tres años, la empresa tenía el desafío de poner una gran cantidad de información disponible para todos sus clientes. Con el apoyo de AWS, la compañía comenzó su camino hacia la transformación digital, moviendo su servicio al cliente de una manera rápida y eficiente, así como mejorando su rentabilidad a través de la nube AWS. Garry Barrow, director de operaciones en JPS, y Phillip Hamilton, especialista en TI para Infraestructura de la compañía, explican cómo lograron la capacidad de brindar soluciones en cuestión de minutos en lugar de semanas y ahorrar en almacenamiento al menos un 40%.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/JPS-logo%401x.3478528beeb40acda015c33b78052ade26565ed5.png","customerNameLower":"jps","footerInfoText":"Fecha de publicación","industry":"Energía","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/jps/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"JPS","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"AWS ayuda a transformar JPS de una organización tradicional a una digital"}},"tags":[{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application