:"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"GLOBAL#location#sri-lanka","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Sri Lanka","description":"Sri Lanka","dateCreated":"2020-07-02T22:31:54+0000","dateUpdated":"2022-02-03T03:31:39+0000"}]},{"item":{"id":"customer-references#jps","locale":"en_US","directoryId":"customer-references","name":"jps","dateCreated":"2023-06-01T23:06:05+0000","dateUpdated":"2023-06-08T04:07:40+0000","additionalFields":{"descriptionSummary":"Jamaica Public Service (JPS) es el único distribuidor de electricidad en Jamaica. Hace aproximadamente tres años, la empresa tenía el desafío de poner una gran cantidad de información disponible para todos sus clientes. Con el apoyo de AWS, la compañía comenzó su camino hacia la transformación digital, moviendo su servicio al cliente de una manera rápida y eficiente, así como mejorando su rentabilidad a través de la nube AWS. Garry Barrow, director de operaciones en JPS, y Phillip Hamilton, especialista en TI para Infraestructura de la compañía, explican cómo lograron la capacidad de brindar soluciones en cuestión de minutos en lugar de semanas y ahorrar en almacenamiento al menos un 40%.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/JPS-logo%401x.3478528beeb40acda015c33b78052ade26565ed5.png","customerNameLower":"jps","footerInfoText":"Fecha de publicación","indust