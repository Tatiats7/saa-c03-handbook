ps://d1.awsstatic.com/amazon-logo-1x.a64c3eedfb84347ecf50e210637c0cf810922e10.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eAmazon GameOn used off-the-shelf AWS tools and technologies to build a microservices architecture that scales effortlessly and delivers P90 response times of about 47 milliseconds. Amazon GameOn enables external game developers to offer leaderboards, multiplayer play, and tournaments with real-world prizes, fulfilled by Amazon. Amazon GameOn is using Amazon DynamoDB to store data, Amazon ElastiCache and Amazon DynamoDB Accelerator for caching, and AWS Lambda to orchestrate background jobs, data collection, fraud detection, and billing processes.\u003c/p\u003e\r\n","industry":"Gaming","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/amazon-gameon/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Amazon GameOn","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Amazon GameOn Case Study"}},"tags":[{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43: