-pi-securities","locale":"en_US","directoryId":"customer-references","name":"quicksight-pi-securities","dateCreated":"2025-01-28T23:22:08+0000","dateUpdated":"2025-01-28T23:24:47+0000","additionalFields":{"descriptionSummary":"\u003cp\u003e\u003ca href\u003d\"https://www.pi.financial/en\" rel\u003d\"noopener\" target\u003d\"_blank\"\u003ePi Securities\u003c/a\u003e, leading brokerage company based in Thailand, developed Pi Financial, an application that allows investors to securely trade and manage their assets with ease, all while keeping track of their portfolio growth and achieving their financial goals, after migrating to AWS.\u003c/p\u003e\n","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/pi%20logo.32c746991f39760ac5b2d7ffa7bedc5621ebe9c6.jpg","displayLocation":"Thailand","customerNameLower":"pi securities","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2024-08-29","headlineUrl":"https://aws.amazon.com/solutions/case-studies/quicksight-pi-securities/","publishedDate":"2024","customer-name":"Pi Securities","contentType":"Customer Story","headline":"Pi Securities Uses Amazon QuickSight to Develop Advanced BI and CRM Tool "}},"tags":[{"id":"customer-references#category#gen-ai","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gen AI","description":"\u003cp\u003eGenerative Artificial Intelligence\u003c/p\u003e\n","dateCreated":"2023-07-10T17:07:31+0000","dateUpdated":"2023-07-10T17:07:31+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#thailand","loc