S","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"}]},{"item":{"id":"customer-references#fineos-case-study","locale":"en_US","directoryId":"customer-references","name":"fineos-case-study","dateCreated":"2024-06-12T18:23:56+0000","dateUpdated":"2024-06-13T19:58:38+0000","additionalFields":{"descriptionSummary":"FINEOS provides software solutions to the employee benefits and life, accident, and health industry. Data protection is vital to the company and its global insurance customers. Using Amazon Web Services (AWS), as Jonathan Boylan, chief technology officer says, FINEOS can confidently handle sensitive data in North America, Europe, and Asia-Pacific, adhering to local compliance regulations. With the scale and security of the cloud, the business is pushing boundaries and delivering new solutions to insurers.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/fineos-logo%401x.b40fd945fdbe361408e92451c4c6345340caefbc.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/fineos-logo%401x.b40fd945fdbe361408e92451c4c6345340caefbc.png","displayLocation":"Europe","customerNameLower":"fineos","footerInfoText":"Published Date","industry":"Financial Services","headlineUrl":"https://aws.amazon.com/solutions/case-studies/fineos-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Fineos","enableShare":"1","publishedDate":"2023","headline":"FINEOS Complies with Data Protection Regulations Worldwide Using AWS","contentType":"Customer Story"}},"tags":[{"id":"customer-references#category#compute","l