2021-09-27T07:50:35+0000","dateUpdated":"2022-02-03T03:32:55+0000"},{"id":"GLOBAL#product#data-exchange","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Data Exchange","description":"AWS Data Exchange","dateCreated":"2020-12-08T19:55:37+0000","dateUpdated":"2022-02-03T03:32:28+0000"},{"id":"GLOBAL#business-category#cust-engagement","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2020-06-05T07:06:46+0000","dateUpdated":"2022-02-03T03:31:03+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#product#codebuild","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodeBuild","description":"AWS CodeBuild","dateCreated":"2020-03-02T07:02:08+0000","dateUpdated":"2022-02-03T03:32:24+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#kesha20201202msfdopaadsf","locale":"en_US","directoryId":"customer-references","name":"kesha20201202msfdopaadsf","dateCreated":"2022-05-23T21:42:07+0000","dateUpdated":"2022-05-23T21:52:48+0000","additionalFields":{"descriptionSummary":"On the next This is My Architecture, Kesha will explain how she was able to use serverless technologies, AWS Amplify, and AWS AppSync to rapidly design and develop Salary Overflow.  You will learn how S3 and CloudFront are used to serve the web application, how AWS Cognito and Lambda are used for user authentication, how AppSync and Aurora persist data, and how Pinpoint is used for analytics. This architecture not only automatically scales to handle user demand, but is flexible enough to allow rapid iteration and experimentation.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/salary-overflow-logo%401x.41a60e02687d93581c1eaf5e22bc93831dd0cb93.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2020-12-02","headlineUrl":"https://youtu.be/Xi6tDqctLsY?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Salary Overflow: Bringing Transparency to Tech Salaries","customer-name":"Salary Overflow"}},"tags":[{"id":"GLOBAL#product#appsync","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS AppSync","description":"AWS AppSync","dateCreated":"2020-03-02T07:01:32+0000","dateUpdated":"2022-02-03T03:32:17+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","da