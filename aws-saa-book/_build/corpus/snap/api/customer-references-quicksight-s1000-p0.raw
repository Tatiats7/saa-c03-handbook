03T03:32:55+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"}]},{"item":{"id":"customer-references#rappi-fin-ops-en-from-es-directory","locale":"en_US","directoryId":"customer-references","name":"rappi-fin-ops-en-from-es-directory","dateCreated":"2024-02-03T03:47:52+0000","dateUpdated":"2024-02-06T01:35:37+0000","additionalFields":{"descriptionSummary":"Rappi is a Colombian company dedicated to delivery services that operates in nine countries. By implementing FinOps and AWS services, they could boast a 90% optimization of their investment in infrastructure. The company, which currently processes 25 million orders per month, gained the flexibility to run more than 10,000 Amazon EC2 Spot Instances at peak times.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/rappi-logo%401x.e3f6d852f68b6a673150b380f45ac07e0a763a10.png","displayLocation":"Colombia","customerNameLower":"rappi","footerInfoText":"Published Date","industry":"Hospitality","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/rappi-fin-ops/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Rappi","enableShare":"1","publishedDate":"2023","contentType":"Customer Story","headline":"Rappi has optimized its benefit-cost ratio by 90% in the AWS cloud thanks to FinOps"}},"tags":[{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Mobile","description":"Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2023-08-22T20:28:38+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-01-16T17:43:13+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2023-07-15T01:16:11+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#product#ec2-spot-instances","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Spot Instances","description":"Amazon EC2 Spot Instances","dateCreated":"2022-04-26T06:27:16+0000","dateUpdated":"2022-04-26T06:27:16+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#cost-explorer","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Cost Explorer","description":"AWS Cost Explorer","dateCreated":"2020-03-02T07:02:27+0000","dateUpdated":"2022-02-03T03:32:27+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#business-category#cloud-cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-06-05T07:06:41+0000","dateUpdated":"2022-02-03T03:31:02+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#product#quicksight","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon QuickSight","description":"Amazon QuickSight","dateCreated":"2020-03-02T07:04:56+0000","dateUpdated":"2022-02-03T03:32:55+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#location#colombia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Colombia","description":"Colombia","dateCreated":"2020-07-02T22:31:04+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"customer-references#category#mobile","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Mobile","description":"Mobile","dateCreated":"2019-07-22T18:32:14+0000","dateUpdated":"2022-03-24T02:42:27+0000"}]},{"item":{"id":"customer-references#agibank-autoscaling","locale":"en_US","directoryId":"customer-references","name":"agibank-autoscaling","dateCreated":"2023-06-01T23:04:36+0000","dateUpdated":"2023-06-08T04:07:48+0000","additionalFields":{"descriptionSummary":"Determinada a oferecer sempre a melhor experiência para o cliente, a instituição tem ampliado o uso da nuvem para tornar as jornadas cada vez mais digitais e sem atrito, independente do canal que o cliente acesse. Este crescimento trouxe a necessidade de reavaliar a infraestrutura e os serviços utilizados, buscando adequá-los aos novos cenários, processo que vem sendo colocado em prática com o suporte do time da AWS.\n\nDesde 2017 o Agibank segue em pleno processo de crescimento e transformação – de financeira especializada em crédito para um banco de relacionamento completo – baseado fortemente em digitalização, inovação e implementando recursos cada vez mais ágeis. Portanto, a companhia definiu que a única forma de fazer entregas rápidas e acompanhar a demanda seria utilizando cloud computing e microsserviços, para garantir a escala necessária no tempo preciso.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/agi_logo%402x.9155292d65ae17ddf0851e625ebfeee92de47bec.png","displayLocation":"Brasil","customerNameLower":"agibank","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/agibank-autoscaling/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Agibank","enableShare":"1","publishedDate":"2023","contentType":"História do cliente","headline":"Agibank reduz custos de nuvem em 32% com suporte da AWS"}},"tags":[{"id":"GLOBAL#product#cloudfront","locale":"en_US","