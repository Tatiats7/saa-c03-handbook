eUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#transitgateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Transit Gateway","description":"AWS Transit Gateway","dateCreated":"2020-03-02T07:05:54+0000","dateUpdated":"2022-02-03T03:33:05+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#lake-formation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lake Formation","description":"AWS Lake Formation","dateCreated":"2020-03-02T07:04:18+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#database-migration-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Database Migration Service (DMS)","description":"AWS Database Migration Service (DMS)","dateCreated":"2020-03-02T07:02:30+0000","dateUpdated":"2022-02-03T03:32:27+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#gobierno-ciudad-buenos-aires","locale":"en_US","directoryId":"customer-references","name":"gobierno-ciudad-buenos-aires","dateCreated":"2023-06-01T23:04:41+0000","dateUpdated":"2023-07-14T23:32:38+0000","additionalFields":{"descriptionSummary":"El Gobierno de la Ciudad de Buenos Aires es uno de los más importantes de Argentina. Uno de sus principales intereses es poner a los ciudadanos en el centro de las diversas decisiones políticas. Para ello resulta importante tener consolidada la información que el GCABA genera y recolecta para llevar adelante la operación que está en cabeza de las diferentes dependencias con el fin de posibilitar un re-diseño más efectivo de las políticas públicas en base a datos. Dichos datos están siendo consolidados en PIBA (Plataforma Inteligente de Buenos Aires), desarrollada en la nube de AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/buenosairesciudad%401x.7b6f1445a271ceb344bc9983d823cb601cec37b2.png","displayLocation":"Argentina","customerNameLower":"ar - buenos aires government (gcba) / same","footerInfoText":"Fecha de publicación","industry":"State and Local Government","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/gobierno-ciudad-buenos-aires/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"AR - Buenos Aires Government (GCBA) / SAME","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"AWS ayuda a reducir la burocracia y acelerar la transformación digital en Buenos Aires"}},"tags":[{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#industry#govt-state-local","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"State and Local Government","description":"State and Local Government","dateCreated":"2021-12-15T23:38:31+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL