22-02-03T03:32:31+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notification Service (SNS)","dateCreated":"2020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"}]},{"item":{"id":"customer-references#grupo-a-case-study-from-es-directory","locale":"en_US","directoryId":"customer-references","name":"grupo-a-case-study-from-es-directory","dateCreated":"2024-02-03T03:46:59+0000","dateUpdated":"2024-02-06T01:35:38+0000","additionalFields":{"descriptionSummary":"Grupo A es un conglomerado empresarial de cerca de 20 empresas, compuesto de cuatro divisiones – industrial, minería, construcción y comercial. Su trayectoria digital con AWS se inicia en 2015 utilizando Amazon Elastic Compute Cloud para hospedar sus páginas web y algunos aplicativos de marketing digital. Luego, avanzan para la construcción de un datalake.\nCon el apoyo de Insbuilt, el grupo implementó soluciones analíticas para mejorar la arquitectura de datos relacionada con la extracción, transformación, carga de la información y el fácil acceso a la información por parte de los usuarios. Amparo Pineda, gerente de ERP y Analítica, y Andrés Ramos, gerente de proyectos de nuevas tecnologías, cuentan que Grupo A ha logrado mejor gestión de procesos y la consecuente disminución del backorder en un 42% desde que empezó a utilizar soluciones tales como Amazon AppFlow, Amazon Athena y Amazon Lambda, Amazon QuickSigh, entre otras, todo orquestado por un datalake.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/Grupo-a-Logogrupo%20a%20logo%402x.c753c43348b22191e05597007054d45e2b2f4f5b.png","displayLocation":"Latinoamérica","customerNameLower":"grupo a","footerInfoText":"Fecha de publicación","industry":"Agricultura","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/grupo-a-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Grupo A","enableShare":"1","publishedDate":"2023","contentType":"Historia del cliente","headline":"Grupo A disminuye el backorder en un 42% con mejor gestión aportada por AWS"}},"tags":[{"id":"GLOBAL#industry#agriculture","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Agriculture","description":"Agriculture","dateCreated":"2020-06-25T04:02:53+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#quicksight","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon QuickSight","description":"Amazon QuickSight","dateCreated":"2020-03-02T07:04:56+0000","dateUpdated":"2022-02-03T03:32:55+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#use-case#data-lakes","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Data Lakes","description":"Data Lakes","dateCreated":"2020-06-05T06:37:09+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#appflow","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon AppFlow","description":"Amazon AppFlow","dateCreated":"2020-06-25T04:09:13+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"customer-refe