BAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"}]},{"item":{"id":"customer-references#docebo-reinvent2024","locale":"en_US","directoryId":"customer-references","name":"docebo-reinvent2024","dateCreated":"2025-05-07T22:16:17+0000","dateUpdated":"2025-05-07T22:30:07+0000","additionalFields":{"descriptionSummary":"Discover how Docebo, a leading learning platform provider, brought key insights to their customers with Amazon QuickSight. Docebo embedded QuickSight into their learning platform to create Insights, a powerful analytics tool that\u0027s helping customers monitor the impact of learning programs within their organizations. This integration has opened up new opportunities for Docebo to serve their customers, helping them track, measure, and optimize their learning programs.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/docebo-logo%401x.5013584decaf0adae97de85936d4bd299246de1d.png","displayLocation":"Italy","customerNameLower":"docebo","footerInfoText":"Published Date","industry":"Software \u0026 Internet","headlineUrl":"https://www.youtube.com/watch?v\u003djbDiT7Gy7Iw\u0026did\u003dcr_card\u0026trk\u003dcr_card",