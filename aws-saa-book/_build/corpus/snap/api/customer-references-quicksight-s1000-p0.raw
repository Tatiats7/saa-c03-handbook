AL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"}]},{"item":{"id":"customer-references#prismea-ippontechnologies","locale":"en_US","directoryId":"customer-references","name":"prismea-ippontechnologies","dateCreated":"2023-07-18T00:05:01+0000","dateUpdated":"2023-07-18T00:18:10+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eIppon Technologies aide Prismea dans l\u0026rsquo;utilisation d\u0026rsquo;AWS pour lancer en neuf mois une banque en ligne, proposer des services innovants, renforcer la s\u0026eacute;curit\u0026eacute; et optimiser les co\u0026ucirc;ts. Prismea \u0026mdash; une startup bancaire install\u0026eacute;e en France \u0026mdash; a collabor\u0026eacute; avec Ippon Technologies pour mettre au point de nouvelles fonctionnalit\u0026eacute;s pour les utilisateurs finaux. Pour ce faire, elle a eu recours \u0026agrave; des services parmi lesquels Amazon Aurora, AWS Lambda et Amazon Cognito, afin de prendre en charge sa solution de core-banking Treezor.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/FR%20Marketing/Case%20studies/Prismea.1b6881654d7a97214a1c8017da268d20b595b1eb.png","displayLocation":"Europe, Moyen-Orient et Afrique","footerInfoText":"Date de publication","industry":"Services financiers","enableShare":"1","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/prismea-ippontechnologies/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"Témoignages clients","customer-name":"Prismea x Ippon Technologies","headline":"Prismea collabore avec Ippon Technologies et lance en neuf mois sa banque en ligne en toute sécurité"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+