ferences#category#business-applications-ec2-windows-server","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: EC2 Windows Server","description":"Business Applications: EC2 Windows Server","dateCreated":"2019-07-22T18:31:09+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#brooks-school-of-english","locale":"en_US","directoryId":"customer-references","name":"brooks-school-of-english","dateCreated":"2023-06-01T23:11:43+0000","dateUpdated":"2023-07-14T23:32:26+0000","additionalFields":{"descriptionSummary":"A pocos días de comenzar un nuevo ciclo lectivo, la pandemia de covid-19 modificaba todo el escenario previsto y Brook’s School of English enfrentaba la posibilidad cierta de tener que cerrar sus puertas y dejar sin clases a sus alumnos. Sin embargo, en el instituto exploraron otras posibilidades y decidieron adoptar un campus virtual para poder seguir cumpliendo su misión. Así descubrieron la propuesta de Aulasneo, con la que pudieron sortear el año sin obstáculos, ampliar la matrícula, ganar en flexibilidad e identificar nuevos mercados y oportunidades.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/brooks-school-of-english%401x.a6b17f