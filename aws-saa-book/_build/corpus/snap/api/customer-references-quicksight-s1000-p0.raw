ucation","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"}]},{"item":{"id":"customer-references#vizio20200420sfienwd","locale":"en_US","directoryId":"customer-references","name":"vizio20200420sfienwd","dateCreated":"2022-05-23T21:43:48+0000","dateUpdated":"2022-05-23T21:53:29+0000","additionalFields":{"descriptionSummary":"In this episode of This Is My Architecture, learn how Vizio ingests billions of messages from millions of smart TVs into its analytics solution on AWS. You\u0027ll see how they leverage Kinesis, Redshift, S3, and QuickSight to ingest messages, store them, and turn them into actionable data.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/vizio-logo%401x.01f43870ead80010b0500a0cc6af39ce9a8f31cb.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2020-04-20","headlineUrl":"https://youtu.be/BlCXEMp_lqY?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Vizio: Smart TV Analytics at Scale","customer-name":"Vizio"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Reds