escription":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#kafka-managed-streaming","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Managed Streaming for Apache Kafka (MSK)","description":"Amazon Managed Streaming for Apache Kafka (MSK)","dateCreated":"2020-03-02T07:04:11+0000","dateUpdated":"2022-02-03T03:32:44+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#product#quicksight","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon QuickSight","description":"Amazon QuickSight","dateCreated":"2020-03-02T07:04:56+0000","dateUpdated":"2022-02-03T03:32:55+0000"}]},{"item":{"id":"customer-references#trustly-using-amazon-quicksight-case-study","locale":"en_US","directoryId":"customer-references","name":"trustly-using-amazon-quicksight-case-study","dateCreated":"2024-05-03T14:28:34+0000","dateUpdated":"2024-05-03T14:48:12+0000","additionalFields":{"descriptionSummary":"As Trustly started growing rapidly, the fintech company wanted to modernize its data analytics capabilities and become more data driven. When its previous analytics solution could no longer handle the company’s increasing volume of data, Trustly looked to Amazon Web Services (AWS) for an alternative. Using Amazon QuickSight, which powers data-driven organizations with unified business intelligence at hyperscale, Trustly increased productivity and scalability, reduced costs by an estimated 50 percent, and empowered users to independently generate insights.