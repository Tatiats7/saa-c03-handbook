{"items":[{"item":{"id":"customer-references#rehrig-pacific-reinvent2024","locale":"en_US","directoryId":"customer-references","name":"rehrig-pacific-reinvent2024","dateCreated":"2025-05-02T15:50:24+0000","dateUpdated":"2025-05-02T16:09:28+0000","additionalFields":{"descriptionSummary":"Rehrig Pacific, a fourth-generation family-owned manufacturer, enabled their analysts to be 5-10x more productive with the scenarios capability of Amazon Q in QuickSight. As a leading manufacturer of reusable transport packaging, Rehrig Pacific faced the challenge of making sense of complex data from IoT and computer vision systems.","imageSrcUrl":"https://d1.awsstatic.com/quicksight/rehrig.a22d55b93f059f0e489779914c3c316e9f47ca4c.png","displayLocation":"United States","customerNameLower":"rehrig pacific","footerInfoText":"Published Date","industry":"Manufacturing","sortDate":"2025-03-21","headlineUrl":"https://www.youtube.com/watch?v\u003dvenV4nAngvo\u0026did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Rehrig Pacific","publishedDate":"2025","enableShare":"1","headline":"Rehrig Pacific accelerates advanced analysis with Amazon Q in QuickSight","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"customer-references#category#iot","locale":"en_US","tagNamespaceId":"customer-references#category","name":"IoT","description":"IoT","dateCreated":"2019-07-22T18:32:05+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#use-case#data-lakes","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Data Lakes","description":"Data Lakes","dateCreated":"2020-0