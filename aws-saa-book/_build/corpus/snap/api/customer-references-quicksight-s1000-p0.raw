9 medals, including 78 golds. Today, it remains committed to pushing the boundaries of athletic performance.","featureImageURL":"https://d1.awsstatic.com/customer-references-case-studies-logos/swimming-australia-innovator-hub.8b03f8996284913478f89e8755bc9502544cd30d.jpg","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/swimming-australia-logo%401x.116d6fce066e744ffc6ba885a1b612087a86679b.png","customerNameLower":"swimming australia","footerInfoText":"Published Date","description":"\u003cp\u003eBuilding specialized training tools using AWS-powered insights\u003c/p\u003e\n","industry":"Media \u0026 Entertainment","sortDate":"2024-10-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/generative-ai-swimming-australia?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Swimming Australia","publishedDate":"2024","enableShare":"1","contentType":"Customer Story","headline":"Swimming Australia Uses Data and Machine Learning on AWS to enhance Athlete Performance"}},"tags":[{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-re