020-03-03T00:18:27+0000","dateUpdated":"2022-02-03T03:33:08+0000"},{"id":"GLOBAL#product#migration-hub","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Migration Hub","description":"AWS Migration Hub","dateCreated":"2020-03-02T07:04:36+0000","dateUpdated":"2022-02-03T03:32:51+0000"},{"id":"GLOBAL#product#mgmt-console","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Management Console","description":"AWS Management Console","dateCreated":"2020-03-02T07:04:33+0000","dateUpdated":"2022-02-03T03:32:50+0000"},{"id":"GLOBAL#product#personalize","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Personalize","description":"Amazon Personalize","dateCreated":"2020-03-02T07:04:50+0000","dateUpdated":"2022-02-03T03:32:54+0000"},{"id":"GLOBAL#product#ivs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Interactive Video Service","description":"Amazon Interactive Video Service","dateCreated":"2020-11-20T00:43:24+0000","dateUpdated":"2022-02-03T03:32:44+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#coca-cola-andina","locale":"en_US","directoryId":"customer-references","name":"coca-cola-andina","dateCreated":"2023-06-01T23:11:34+0000","dateUpdated":"2023-08-11T00:24:46+0000","additionalFields":{"descriptionSummary":"Coca-Cola Andina tiene la visión de promover el crecimiento rentable de su negocio, apoyando a sus clientes y garantizando las mejores experiencias a los más de 54 millones de consumidores en Chile, Argentina, Brasil y Paraguay. Para eso, desarrolla procesos de clase mundial con el fin de aumentar su productividad y la calidad del servicio. Una de las iniciativas para alcanzar ese desafío fue el desarrollo de un data lake basado en la tecnología cloud de AWS. Al adoptar almacenamiento, bases de datos, cómputo y capacidades analíticas basadas en tecnología AWS, la compañía logró aumentar la productividad del equipo de análisis en un 80%, permitiendo al propio negocio y a sus clientes tomar decisiones basadas en datos confiables, favoreciendo el crecimiento conjunto de todo el ecosistema, manteniendo su ventaja competitiva y aumentando los ingresos de la compañía.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/andina-logo%402x.2927ae74072635d1603498fab032d055c3a3e5eb.png","displayLocation":"Colombia","footerInfoText":"Fecha de publicación","industry":"Fabricación","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/coca-cola-andina/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Coca-Cola Andina","enableShare":"1","publishedDate":"2021","contentType":"Historia del cliente","headline":"Coca-Cola Andina incrementa productividad de análisis en un 80%, garantizando decisiones inteligentes y manteniendo ventaja competitiva a través de servicios AWS"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","desc