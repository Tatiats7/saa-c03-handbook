erences#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#leadinfo-case-study","locale":"en_US","directoryId":"customer-references","name":"leadinfo-case-study","dateCreated":"2022-06-27T20:43:55+0000","dateUpdated":"2022-06-27T20:55:55+0000","additionalFields":{"descriptionSummary":"Leadinfo is a Netherlands-based scale-up that helps B2B customers—from sports organizations, to digital marketing agencies, to heavy industry businesses in steel and packaging—target sales prospects by analyzing information about website visitors. It saw its business grow quickly after the COVID-19 pandemic put a stop to many face-to-face sales calls. By migrating its customer data from multiple databases on AWS to Amazon Aurora, Leadinfo reduced its monthly IT costs by 30 percent while improving developer efficiency by 50 percent. This has helped it to quickly roll out new features for customers and build a foundation for continued business growth.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/leadinfo-logo%401x.77ef5808c84cefac08c926994e9399247dfce8fe.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"leadinfo","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-06-24","headlineUrl":"https://aws.amazon.com/solutions/case-studies/leadinfo-case-study-2022/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Leadinfo","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Leadinfo Saves 30% on IT Costs, Improves Developer Efficiency by 50% Using AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#product#quicksight","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon QuickSight","description":"Amazon QuickSight","dateCreated":"2020-03-02T07:04:56+0000","dateUpdated":"2022-02-03T03:32:55+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#benelux","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Benelux","description":"Benelux","dateCreated":"2020-02-03T05:29:47+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#mtg-case-study","locale":"en_US","directoryId":"customer-references","name":"mtg-case-study","dateCreated":"2022-06-27T20:43:40+0000","dateUpdated":"2023-07-14T23:32:27+0000","additionalFields":{"descriptionSummary":"Portugal’s MTG Research and Development Lab developed a hybrid solution using AWS that\nsupports healthcare providers conducting pioneering medical research. The solution helps hospitals\nand clinics process and analyze large amounts of data required for studies, while ensuring\ncompliance with data protection laws for sensitive patient information. Using AWS Snowball Edge\ndevices, MTG cut the time required to complete studies in half and lowered the total IT costs for\nhospitals conducting research.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/mtg-logo%401x.ed774fce5264ea98615c002f7863dadc00dd6e53.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"mtg","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2022-06-24","headlineUrl":"https://aws.amazon.com/solutions/case-studies/mtg-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"MTG","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"MTG Cuts Medical Research Times in Half, Secures Patient Data Using AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-referenc