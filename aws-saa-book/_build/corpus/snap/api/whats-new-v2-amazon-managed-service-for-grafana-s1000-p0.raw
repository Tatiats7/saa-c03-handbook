{"items":[{"item":{"id":"whats-new-v2#34648a40-8c6f-4b0a-b703-0c0d09b9f012-1","locale":"en_US","directoryId":"whats-new-v2","name":"34648a40-8c6f-4b0a-b703-0c0d09b9f012-1","dateCreated":"2026-09-30T21:45:16+0000","dateUpdated":"2026-09-30T22:02:05+0000","additionalFields":{"nofollow":"0","noindex":"0","postBody":"\u003cp\u003eAmazon Managed Grafana now supports creating new workspaces with Grafana version 13.2. This release brings features from open-source Grafana versions 13.0 to 13.2, including Git Sync for dashboards, dynamic dashboards, and PromQL query support in the Amazon CloudWatch data source plugin.\u003c/p\u003e\n\u003cp\u003eWith Git Sync, you can treat dashboards as code by linking a workspace to a Git repository, enabling version control for tracking, reviewing, and reverting dashboard modifications. Dynamic dashboards provide a more adaptable approach to layout and paneling, constructing responsive views driven by conditions that respond to data and variables. The Amazon CloudWatch data source plugin now supports PromQL queries, allowing you to use Prometheus Query Language to query metrics that CloudWatch ingests via its OpenTelemetry (OTLP) endpoint, complementing the existing Metric Search and Metrics Insights query types.\u003c/p\u003e\n\u003cp\u003eGrafana 13.2 is available in all AWS regions where Amazon Managed Grafana is generally available.\u003c/p\u003e\n\u003cp\u003eTo learn more about creating Amazon Managed Grafana workspaces with version 13.2, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/version-differences.html#version-diff-v13\"\u003euser documentation\u003c/a\u003e. For more information about Amazon Managed Grafana features and pricing, visit the \u003ca href\u003d\"https://aws.amazon.com/grafana/\"\u003eproduct page\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/grafana/pricing/\"\u003epricing page\u003c/a\u003e.\u003c/p\u003e\n","nosnippet":"0","headlineUrl":"/about-aws/whats-new/2026/09/amazon-managed-grafana-now-supports-creating-grafana-13-2-workspaces","postDateTime":"2026-09-30T19:30:00Z","headline":"Amazon Managed Grafana now supports creating Grafana 13.2 workspaces"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#general-products#amazon-cloudwatch","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-cloudwatch","description":"general:products/amazon-cloudwatch","dateCreated":"2023-11-09T13:50:47+0000","dateUpdated":"2023-11-09T13:50:47+0000"},{"id":"whats-new-v2#year#2026","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2026","description":"description placeholder","dateCreated":"2025-12-05T19:55:40+0000","dateUpdated":"2025-12-05T19:55:40+0000"},{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"}]},{"item":{"id":"whats-new-v2#launch-r8budbt2xrgpma9yukw696","locale":"en_US","directoryId":"whats-new-v2","name":"launch-r8budbt2xrgpma9yukw696","dateCreated":"2026-07-16T19:31:34+0000","dateUpdated":"2026-08-20T18:05:48+0000","additionalFields":{"nofollow":"0","noindex":"0","nosnippet":"0","postBody":"\u003cp\u003eAmazon Managed Grafana is now a\u0026nbsp;\u003ca href\u003d\"https://aws.amazon.com/compliance/fedramp/\"\u003eFedRAMP\u003c/a\u003e High authorized service in the AWS GovCloud (US-East) and AWS GovCloud (US-West) regions. Federal agencies, public sector organizations, and other enterprises with FedRAMP High compliance requirements can now use Amazon Managed Grafana to visualize, query, and alert on operational metrics across their AWS and hybrid environments while meeting their strict security and compliance requirements.\u003c/p\u003e\n\u003cp\u003eAmazon Managed Grafana is a fully managed service based on open-source Grafana that makes it easier for you to visualize and analyze your operational data at scale. The Federal Risk and Authorization Management Program (FedRAMP) is a US government-wide program that delivers a standard approach to the security assessment, authorization, and continuous monitoring for cloud products and services.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eFor more details about Amazon Managed Grafana in AWS GovCloud (US), visit the \u003ca href\u003d\"https://docs.aws.amazon.com/govcloud-us/latest/UserGuide/grafana.html\"\u003eAmazon Managed Grafana GovCloud documentation\u003c/a\u003e or contact your AWS account team for more information. To learn more, visit the Amazon Managed Grafana \u003ca href\u003d\"https://aws.amazon.com/grafana/\"\u003eproduct page.\u003c/a\u003e\u003c/p\u003e\n","headlineUrl":"/about-aws/whats-new/2026/07/amazon-managed-grafana-fedramp-high/","postDateTime":"2026-07-16T19:31:00Z","headline":"Amazon Managed Grafana achieves FedRAMP High authorization in AWS GovCloud (US)"}},"tags":[{"id":"whats-new-v2#year#2026","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2026","description":"description placeholder","dateCreated":"2025-12-05T19:55:40+0000","dateUpdated":"2025-12-05T19:55:40+0000"},{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#general-products#aws-govcloud-us","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-govcloud-us","description":"general:products/aws-govcloud-us","dateCreated":"2023-11-07T18:41:18+0000","dateUpdated":"2023-11-07T18:41:18+0000"}]},{"item":{"id":"whats-new-v2#launch-xtqqokceeaefgyam4zpfqj","locale":"en_US","directoryId":"whats-new-v2","name":"launch-xtqqokceeaefgyam4zpfqj","dateCreated":"2026-05-19T05:16:34+0000","dateUpdated":"2026-05-19T21:11:17+0000","additionalFields":{"nofollow":"0","noindex":"0","postBody":"\u003cp\u003eAmazon Managed Grafana now supports dual-stack connectivity, enabling workspaces to communicate over both Internet Protocol version 4 (IPv4) and Internet Protocol version 6 (IPv6). Dual-stack mode is available for\u0026nbsp;workspaces\u0026nbsp;running Grafana version 10.4 or later.\u003c/p\u003e\n\u003cp\u003eWith dual-stack support, customers can simplify their network stack by\u0026nbsp;eliminating\u0026nbsp;the need to manage overlapping address spaces in their VPCs. Customers migrating to IPv6 can connect to their Grafana workspaces over IPv6 while maintaining IPv4 compatibility, and those not yet on IPv6 can continue using IPv4-only connections. This is especially beneficial as the continued growth of the internet exhausts\u0026nbsp;available\u0026nbsp;IPv4 addresses.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eSupport for\u0026nbsp;dual-stack connectivity\u0026nbsp;on Amazon Managed Grafana is available in all\u0026nbsp;\u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\"\u003eregions\u003c/a\u003e\u0026nbsp;where the service is\u0026nbsp;generally available.\u0026nbsp;To get started, update your workspace configuration via the Amazon Managed Grafana console, API, or CLI. For more information, see\u0026nbsp;the\u0026nbsp;\u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/AMG-configure-workspace.html\"\u003eAmazon Managed Grafana User Guide\u003c/a\u003e.\u0026nbsp;To learn more about best practices for configuring IPv6 in your environment, visit the whitepaper on\u0026nbsp;\u003ca href\u003d\"https://docs.aws.amazon.com/whitepapers/latest/ipv6-on-aws/internet-protocol-version-6.html\"\u003eIPv6 in AWS\u003c/a\u003e.\u003c/p\u003e\n","nosnippet":"0","headlineUrl":"/about-aws/whats-new/2026/05/amazon-managed-grafana-ipv6/","postDateTime":"2026-05-19T15:00:00Z","headline":"Amazon Managed Grafana now supports dual-stack connectivity (IPv6 and IPv4)"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#year#2026","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2026","description":"description placeholder","dateCreated":"2025-12-05T19:55:40+0000","dateUpdated":"2025-12-05T19:55:40+0000"},{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"}]},{"item":{"id":"whats-new-v2#launch-nt8j2n5rtedmmt9h2bkm44","locale":"en_US","directoryId":"whats-new-v2","name":"launch-nt8j2n5rtedmmt9h2bkm44","dateCreated":"2026-05-15T16:08:08+0000","dateUpdated":"2026-06-26T13:06:35+0000","additionalFields":{"nofollow":"0","noindex":"0","postBody":"\u003cp\u003eAmazon Managed Grafana\u0026nbsp;now supports\u0026nbsp;in-place\u0026nbsp;upgrade\u0026nbsp;from Grafana version 10.4 to 12.4.\u0026nbsp;You can upgrade with just a few clicks\u0026nbsp;from\u0026nbsp;the AWS Console or via AWS SDK or AWS CLI.\u003c/p\u003e\n\u003cp\u003eUpgrading to version 12.4 brings native Grafana Scenes-powered dashboards for faster rendering and\u0026nbsp;queryless\u0026nbsp;Drilldown apps for point-and-click exploration\u0026nbsp;of Prometheus metrics, Loki logs, Tempo traces, and\u0026nbsp;Pyroscope\u0026nbsp;profiles.\u0026nbsp;Amazon CloudWatch plugin enhancements simplify log analysis with PPL/SQL query support, broaden visibility through cross-account Metrics Insights, and surface issues proactively with log anomaly detection.\u0026nbsp;The rebuilt table visualization delivers smoother performance with CSS cell styling and interactive Actions buttons, while trendline transformations and navigation bookmarks streamline data exploration.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eIn-place upgrade to\u0026nbsp;Grafana\u0026nbsp;12.4\u0026nbsp;is supported in all\u0026nbsp;\u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\"\u003eAWS regions\u003c/a\u003e\u0026nbsp;where Amazon Managed Grafana is\u0026nbsp;generally available.\u0026nbsp;\u0026nbsp;For a complete list of new features, refer to \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/version-differences.html#version-diff-v12\"\u003eDifferences between Grafana versions\u003c/a\u003e in the Amazon Managed Grafana User Guide. For upgrade instructions, see \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/AMG-workspace-version-update.html\"\u003eUpdate your workspace version\u003c/a\u003e.\u0026nbsp;\u0026nbsp;To learn more about Amazon Managed\u0026nbsp;Grafana features and its pricing, visit the \u003ca href\u003d\"https://aws.amazon.com/grafana/\"\u003eproduct page\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/grafana/pricing/\"\u003epricing page\u003c/a\u003e.\u003c/p\u003e\n","nosnippet":"0","headlineUrl":"/about-aws/whats-new/2026/05/amazon-managed-grafana-v12-update/","postDateTime":"2026-05-15T16:06:00Z","headline":"Amazon Managed Grafana now supports in-place upgrade to Grafana version 12.4 "}},"tags":[{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"},{"id":"whats-new-v2#year#2026","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2026","description":"description placeholder","dateCreated":"2025-12-05T19:55:40+0000","dateUpdated":"2025-12-05T19:55:40+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#general-products#aws-govcloud-us","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-govcloud-us","description":"general:products/aws-govcloud-us","dateCreated":"2023-11-07T18:41:18+0000","dateUpdated":"2023-11-07T18:41:18+0000"}]},{"item":{"id":"whats-new-v2#launch-n7dmv64xz5bjsdbrcoxybm","locale":"en_US","directoryId":"whats-new-v2","name":"launch-n7dmv64xz5bjsdbrcoxybm","dateCreated":"2026-04-16T20:59:18+0000","dateUpdated":"2026-06-26T13:03:11+0000","additionalFields":{"nofollow":"0","noindex":"0","postBody":"\u003cp\u003eAmazon Managed Grafana\u0026nbsp;now supports creating new workspaces with\u0026nbsp;Grafana version 12.4.\u0026nbsp;\u0026nbsp;This release includes features that were launched as a part of open source Grafana versions 11.0\u0026nbsp;to 12.4,\u0026nbsp;including Drilldown apps,\u0026nbsp;scenes powered dashboards, variables in transformations,\u0026nbsp;visualization enhancements, and\u0026nbsp;new features with\u0026nbsp;the\u0026nbsp;Amazon CloudWatch plugin.\u003c/p\u003e\n\u003cp\u003eQueryless\u0026nbsp;Drilldown apps enable customers to perform point-and-click exploration of Prometheus metrics, Loki logs, Tempo traces, and\u0026nbsp;Pyroscope\u0026nbsp;profiles. The Scenes-powered rendering engine boosts dashboard\u0026nbsp;performance. Amazon CloudWatch Logs adds support for PPL and SQL queries, cross-account Metrics\u0026nbsp;Insights, and log anomaly detection.\u0026nbsp;The rebuilt table visualization improves performance with CSS cell styling and interactive Actions buttons, while trendline transformations and navigation bookmarks enhance data exploration.\u0026nbsp;Grafana 12.4 is supported in all\u0026nbsp;\u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\"\u003eAWS regions\u003c/a\u003e\u0026nbsp;where Amazon Managed Grafana is\u0026nbsp;generally available.\u003c/p\u003e\n\u003cp\u003eYou can create a new Amazon Managed Grafana workspace from the AWS Console, SDK, or CLI.\u0026nbsp;To explore the complete list of new features, please refer to the\u0026nbsp;\u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/version-differences.html#version-diff-v12\"\u003euser documentation\u003c/a\u003e. Follow the instructions \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/AMG-create-workspace.html\"\u003ehere\u003c/a\u003e to create workspaces with version 12.4.\u0026nbsp;To\u0026nbsp;learn more about Amazon Managed\u0026nbsp;Grafana\u0026nbsp;features and its pricing, visit the \u003ca href\u003d\"https://aws.amazon.com/grafana/\"\u003eproduct page\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/grafana/pricing/\"\u003epricing page\u003c/a\u003e.\u003c/p\u003e\n","nosnippet":"0","headlineUrl":"/about-aws/whats-new/2026/04/amazon-managed-grafana-v12-create/","postDateTime":"2026-04-17T15:00:00Z","headline":"Amazon Managed Grafana now supports creating Grafana 12.4 workspaces"}},"tags":[{"id":"whats-new-v2#year#2026","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2026","description":"description placeholder","dateCreated":"2025-12-05T19:55:40+0000","dateUpdated":"2025-12-05T19:55:40+0000"},{"id":"whats-new-v2#general-products#aws-govcloud-us","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-govcloud-us","description":"general:products/aws-govcloud-us","dateCreated":"2023-11-07T18:41:18+0000","dateUpdated":"2023-11-07T18:41:18+0000"},{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"}]},{"item":{"id":"whats-new-v2#launch-vhgd7cpuf9tnpzdrwnj2s6","locale":"en_US","directoryId":"whats-new-v2","name":"launch-vhgd7cpuf9tnpzdrwnj2s6","dateCreated":"2025-12-08T17:14:23+0000","dateUpdated":"2026-02-18T21:48:04+0000","additionalFields":{"nofollow":"0","noindex":"0","postBody":"\u003cp\u003eAmazon Managed Grafana now supports customer-managed keys (CMK) through AWS Key Management Service (KMS), enabling you to encrypt data stored in\u0026nbsp;in your Amazon Managed Grafana workspaces with your own encryption keys. Amazon Managed Grafana is a fully managed service based on open-source Grafana that makes it easier for you to visualize and analyze your operational data at scale.\u003c/p\u003e\n\u003cp\u003eAmazon Managed Grafana provides encryption at rest using AWS owned keys by default. With this launch, you now have an option to use a customer-managed key when creating an Amazon Managed Grafana workspace. This allows you to add a self-managed security layer, helping you meet your organization’s compliance and regulatory requirements.\u003c/p\u003e\n\u003cp\u003eThis feature is now available in all regions where Amazon Managed Grafana is generally available, except in AWS GovCloud (US) Regions.\u0026nbsp;To get started with Amazon Managed Grafana, refer\u0026nbsp;\u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/what-is-Amazon-Managed-Service-Grafana.html\" target\u003d\"_blank\"\u003eAmazon Managed Grafana user guide\u003c/a\u003e. To learn more about Amazon Managed Grafana, visit the\u0026nbsp;\u003ca href\u003d\"https://aws.amazon.com/grafana/\" target\u003d\"_blank\"\u003eproduct page\u003c/a\u003e\u0026nbsp;and\u0026nbsp;\u003ca href\u003d\"https://aws.amazon.com/grafana/pricing/\" target\u003d\"_blank\"\u003epricing page\u003c/a\u003e.\u003c/p\u003e\n","nosnippet":"0","headlineUrl":"/about-aws/whats-new/2026/02/amazon-managed-grafana-customer-managed-keys","postDateTime":"2026-02-18T15:00:00Z","headline":"Amazon Managed Grafana now supports AWS KMS customer managed keys"}},"tags":[{"id":"whats-new-v2#year#2025","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2025","description":"\u003cp\u003e2025\u003c/p\u003e\n","dateCreated":"2024-12-30T16:07:22+0000","dateUpdated":"2024-12-30T16:07:22+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"}]},{"item":{"id":"whats-new-v2#launch-nzdg8eztqwpzcmnf86kt1m","locale":"en_US","directoryId":"whats-new-v2","name":"launch-nzdg8eztqwpzcmnf86kt1m","dateCreated":"2025-11-13T20:46:31+0000","dateUpdated":"2026-01-26T22:34:21+0000","additionalFields":{"nofollow":"0","noindex":"0","postBody":"\u003cp\u003eAmazon Managed Grafana is now available in both AWS GovCloud (US-West) and AWS GovCloud (US-East) Regions, enabling government customers and regulated industries to securely visualize and analyze their operational data while meeting stringent compliance requirements. Amazon Managed Grafana is a fully managed service based on open-source Grafana that makes it easier for you to visualize and analyze your operational data at scale.\u003cbr\u003e\n\u003cbr\u003e\nAll Amazon Managed Grafana features are supported in AWS GovCloud (US) Regions except for Enterprise plugins. To get started with Amazon Managed Grafana, visit the \u003ca href\u003d\"https://console.aws.amazon.com/grafana/home/\" target\u003d\"_blank\"\u003eAWS Console\u003c/a\u003e and \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/what-is-Amazon-Managed-Service-Grafana.html\" target\u003d\"_blank\"\u003eAmazon Managed Grafana user guide\u003c/a\u003e. To learn more about Amazon Managed Grafana, visit the \u003ca href\u003d\"https://aws.amazon.com/grafana/\" target\u003d\"_blank\"\u003eproduct page\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/grafana/pricing/\" target\u003d\"_blank\"\u003epricing page\u003c/a\u003e.\u003c/p\u003e\n","nosnippet":"0","headlineUrl":"/about-aws/whats-new/2026/01/amazon-managed-grafana-aws-govcloud-us-regions","postDateTime":"2026-01-26T15:00:00Z","headline":"Amazon Managed Grafana now available in the AWS GovCloud (US) Regions"}},"tags":[{"id":"whats-new-v2#general-products#aws-govcloud-us","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-govcloud-us","description":"general:products/aws-govcloud-us","dateCreated":"2023-11-07T18:41:18+0000","dateUpdated":"2023-11-07T18:41:18+0000"},{"id":"whats-new-v2#year#2025","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2025","description":"\u003cp\u003e2025\u003c/p\u003e\n","dateCreated":"2024-12-30T16:07:22+0000","dateUpdated":"2024-12-30T16:07:22+0000"},{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"}]},{"item":{"id":"whats-new-v2#v1509351831","locale":"en_US","directoryId":"whats-new-v2","name":"launch-8nbkjyUHJvyx1S8Cn72f9W","dateCreated":"2024-09-20T17:21:55+0000","dateUpdated":"2024-09-24T21:45:37+0000","additionalFields":{"nofollow":"0","noindex":"0","postBody":"\u003cp\u003eYou can now use silences to suppress alert notifications for Grafana alerts in \u003ca href\u003d\"https://aws.amazon.com/grafana/\" target\u003d\"_blank\"\u003eAmazon Managed Grafana\u003c/a\u003e. Grafana alerts enable you to proactively monitor your data and receive notifications about critical issues in real time. Silences allow you to temporarily disable notifications from specific alerts, for a specified duration.\u003cbr /\u003e\n\u003cbr /\u003e\nSilences reduce alert fatigue during scheduled maintenances, operational events or when dealing with known issues, without disabling the underlying alert rules. You can silence your Grafana alert notifications based on alert labels or by directly silencing notifications for a specific Grafana alert rule.\u003cbr /\u003e\n\u003cbr /\u003e\nThis feature is supported on all Amazon Managed Grafana workspaces running Grafana version 10.4, across all AWS regions where Amazon Managed Grafana is \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/what-is-Amazon-Managed-Service-Grafana.html#AMG-supported-Regions\" target\u003d\"_blank\"\u003egenerally available\u003c/a\u003e.\u003cbr /\u003e\n\u003cbr /\u003e\nCheck out the \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/v10-alerting-silences.html\" target\u003d\"_blank\"\u003eAmazon Managed Grafana user guide\u003c/a\u003e for detailed documentation.\u003cbr /\u003e\n\u0026nbsp;\u003c/p\u003e\n","nosnippet":"0","headlineUrl":"/about-aws/whats-new/2024/09/amazon-managed-grafana-silences-alerts/","postDateTime":"2024-09-24T10:00:00-07:00","headline":"Amazon Managed Grafana now supports silences for Grafana alerts"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#year#2024","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2024","description":"year#2024","dateCreated":"2024-01-02T21:28:59+0000","dateUpdated":"2024-09-17T18:03:36+0000"},{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2024-05-amazon-managed-grafana-supports-version-10-4","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2024/05/amazon-managed-grafana-supports-version-10-4/","dateCreated":"2024-05-15T19:41:04+0000","dateUpdated":"2024-07-25T15:01:14+0000","additionalFields":{"postBody":"\u003cp\u003eCustomers can now run \u003ca href\u003d\"https://aws.amazon.com/grafana/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana\u003c/a\u003e workspaces with Grafana version 10.4. This release includes features that were launched as a part of open source Grafana versions 9.5 to 10.4, including Correlations, Subfolders, and new visualization panels such as Data Grid, XY chart and Trend panel. This release also introduces new configuration APIs to manage service accounts and tokens for Amazon Managed Grafana workspaces. Service Accounts, replace API keys as the primary way to authenticate applications with Grafana APIs using Service Account Tokens. These new APIs eliminate the need to manually create Service accounts, enabling customers to fully automate their provisioning workflows.\u003c/p\u003e\r\n\u003cp\u003eWith correlations, customers can define relationships between different data sources, rendered as interactive links in Explore visualizations that trigger queries on the related data source; carrying forward data like namespace, host, or label values, enabling root cause analysis with a diverse set of data sources. Subfolders enable nested hierarchy of folders with nested layers of permissions, allowing customers to organize their dashboards to reflect their organization’s hierarchy. To explore the complete list of new features, please refer to our user documentation.\u003c/p\u003e\r\n\u003cp\u003eGrafana version 10.4 is supported in all AWS regions where Amazon Managed Grafana is generally available. \u003c/p\u003e\r\n\u003cp\u003eYou can create a new Amazon Managed Grafana workspace or upgrade your existing 9.4 workspace to 10.4 from the \u003ca href\u003d\"https://console.aws.amazon.com/grafana/home/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Console\u003c/a\u003e, SDK, or CLI. Check out the \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/version-differences.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana user guide\u003c/a\u003e and \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/APIReference/Welcome.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana API Reference\u003c/a\u003e for detailed documentation.\u003c/p\u003e\r\n","modifiedDate":"2024-05-15T19:40:50Z","headlineUrl":"/about-aws/whats-new/2024/05/amazon-managed-grafana-supports-version-10-4/","postDateTime":"2024-05-15T12:00:00Z","contentType":"Launch Announcement","headline":"Amazon Managed Grafana now supports Grafana version 10.4","postSummary":"\u003cp\u003eCustomers can now run \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/grafana.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana\u003c/a\u003e workspaces with Grafana version 10.4. This release includes features that were launched as a part of open source Grafana versions 9.5 to 10.4, including Correlations, Subfolders, and new visualization panels such as Data Grid, XY chart and Trend panel. This release also introduces new configuration APIs to manage service accounts and tokens for Amazon Managed Grafana workspaces. Service Accounts, replace API keys as the primary way to authenticate applications with Grafana APIs using Service Account Tokens. These new APIs eliminate the need to manually create Service accounts, enabling customers to fully automate their provisioning workflows.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2024","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2024","description":"year#2024","dateCreated":"2024-01-02T21:28:59+0000","dateUpdated":"2024-01-02T21:28:59+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2024-03-amazon-managed-grafana-enterprise-plugins-upgrade","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2024/03/amazon-managed-grafana-enterprise-plugins-upgrade/","dateCreated":"2024-03-07T22:54:11+0000","dateUpdated":"2024-07-25T15:05:02+0000","additionalFields":{"postBody":"\u003cp\u003eAmazon Managed Grafana launches Enterprise plugins upgrade, enabling you to access \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/upgrade-to-Grafana-Enterprise.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eGrafana Enterprise data source plugins\u003c/a\u003e such as ServiceNow, Splunk, and New Relic as well as support and training from Grafana Labs. Enterprise plugins are pre-built plugins that enable you to analyze, query, and alert on third-party enterprise systems in your Amazon Managed Grafana workspace without transferring data from your original data store.\u003c/p\u003e\r\n\u003cp\u003ePreviously, customers could access Enterprise plugins by subscribing their Amazon Managed Grafana workspaces to Grafana Enterprise from AWS Marketplace. With this launch, you can upgrade your workspaces and manage your Enterprise licenses directly from the Amazon Managed Grafana console. There are no upfront fees or minimum commitments, you pay only for what you use, based on an active user per upgraded workspace, and billed at the end of the month for your usage.\u003c/p\u003e\r\n\u003cp\u003eThe Enterprise plugins upgrade is supported across all AWS regions where Amazon Managed Grafana is \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/what-is-Amazon-Managed-Service-Grafana.html#AMG-supported-Regions\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003egenerally available\u003c/a\u003e. You can upgrade from the \u003ca href\u003d\"https://console.aws.amazon.com/grafana/home/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Console\u003c/a\u003e, SDK, or CLI. Check out the \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/what-is-Amazon-Managed-Service-Grafana.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana user guide\u003c/a\u003e for detailed documentation. To learn more about Amazon Managed Grafana and the upgrade option, visit the \u003ca href\u003d\"https://aws.amazon.com/grafana/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eproduct page\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/grafana/pricing/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003epricing page\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2024-03-07T22:53:56Z","headlineUrl":"/about-aws/whats-new/2024/03/amazon-managed-grafana-enterprise-plugins-upgrade/","postDateTime":"2024-03-07T13:00:00Z","contentType":"Launch Announcement","headline":"Amazon Managed Grafana launches Enterprise plugins upgrade","postSummary":"\u003cp\u003eAmazon Managed Grafana launches Enterprise plugins upgrade, enabling you to access \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/upgrade-to-Grafana-Enterprise.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eGrafana Enterprise data source plugins\u003c/a\u003e such as ServiceNow, Splunk, and New Relic as well as support and training from Grafana Labs. Enterprise plugins are pre-built plugins that enable you to analyze, query, and alert on third-party enterprise systems in your Amazon Managed Grafana workspace without transferring data from your original data store.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"},{"id":"whats-new-v2#year#2024","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2024","description":"year#2024","dateCreated":"2024-01-02T21:28:59+0000","dateUpdated":"2024-01-02T21:28:59+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2023-11-amazon-managed-grafana-community-plugins","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2023/11/amazon-managed-grafana-community-plugins/","dateCreated":"2023-11-15T21:05:45+0000","dateUpdated":"2024-07-25T15:03:44+0000","additionalFields":{"postBody":"\u003cp\u003eAmazon Managed Grafana now features a new self-service plugin management experience for Grafana community plugins. With this release, Amazon Managed Grafana administrators can discover and install Grafana community plugins directly from their workspace. Plugins enable you to extend your Grafana experience, unifying data from a wider variety of data sources with visualizations tailored to analyze your unique datasets.\u003c/p\u003e\r\n\u003cp\u003eWith this release, Amazon Managed Grafana workspace administrators can discover and install plugins from over 300 pre-built Grafana community plugins, to visualize data from their disparate data sources in a single view. You can now glean insights across Amazon services such as Amazon Managed Service for Prometheus, Amazon CloudWatch, right next to third party applications such as Apache Cassandra, PagerDuty or databases such as Redis, Vertica, with visualization panels best suited to represent your data.\u003c/p\u003e\r\n\u003cp\u003eThe new self-service plugin management experience is supported on all Amazon Managed Grafana workspaces with Grafana version 9.4, across all AWS regions where Amazon Managed Grafana is \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/what-is-Amazon-Managed-Service-Grafana.html#AMG-supported-Regions\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003egenerally available\u003c/a\u003e.\u003c/p\u003e\r\n\u003cp\u003eYou can enable self-service plugin management for your Amazon Managed Grafana workspace from the \u003ca href\u003d\"https://console.aws.amazon.com/grafana/home/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Console\u003c/a\u003e, SDK, or CLI. Check out the \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/grafana-plugins.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana user guide\u003c/a\u003e for detailed documentation. To learn more about Amazon Managed Grafana, visit the \u003ca href\u003d\"https://aws.amazon.com/grafana/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eproduct page\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/grafana/pricing/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003epricing page\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2023-11-15T21:05:33Z","headlineUrl":"/about-aws/whats-new/2023/11/amazon-managed-grafana-community-plugins/","postDateTime":"2023-11-15T13:00:00Z","contentType":"Launch Announcement","headline":"Extend your Amazon Managed Grafana experience with Grafana community plugins","postSummary":"\u003cp\u003eAmazon Managed Grafana now features a new self-service plugin management experience for Grafana community plugins. With this release, Amazon Managed Grafana administrators can discover and install Grafana community plugins directly from their workspace. Plugins enable you to extend your Grafana experience, unifying data from a wider variety of data sources with visualizations tailored to analyze your unique datasets.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#general-products#amazon-amp","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-amp","description":"general:products/amazon-amp","dateCreated":"2023-11-09T14:02:07+0000","dateUpdated":"2023-11-09T14:02:07+0000"},{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2023","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2023","description":"year#2023","dateCreated":"2023-11-07T18:00:12+0000","dateUpdated":"2023-11-07T18:00:12+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2023-07-amazon-managed-grafana-in-place-update-version-9-4","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2023/07/amazon-managed-grafana-in-place-update-version-9-4/","dateCreated":"2023-11-09T15:02:03+0000","dateUpdated":"2024-07-25T14:56:04+0000","additionalFields":{"postBody":"\u003cp\u003eAmazon Managed Grafana is a fully managed service for Grafana, a popular open-source analytics platform that enables you to query, visualize, and alert on your metrics, logs, and traces. With this feature, you can now upgrade your existing workspaces from version 8.4 to 9.4.  \u003c/p\u003e\r\n\u003cp\u003eVersion 9.4 includes several new features to further enhance your experience in Amazon Managed Grafana, such as: plugin enhancements to support Amazon CloudWatch \u003ca href\u003d\"https://docs.aws.amazon.com/AmazonCloudWatch/latest/monitoring/CloudWatch-Unified-Cross-Account.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003ecross-account querying\u003c/a\u003e, Amazon OpenSearch Serverless, querying multiple asset properties from AWS IoT Sitewise, query result reuse and async queries for Athena; Prometheus and Loki query builders that make it even easier to create and modify queries for your data sources; and service accounts that provide a secure and efficient way to automate tasks within your Grafana instance. To explore the complete list of new features, please refer to the \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/using-grafana-v9.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003euser documentation here\u003c/a\u003e.\u003c/p\u003e\r\n\u003cp\u003eIn-place update for version 9.4 is generally available across all AWS regions where \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/what-is-Amazon-Managed-Service-Grafana.html#AMG-supported-Regions\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana is supported\u003c/a\u003e. To get started with Amazon Managed Grafana, visit the \u003ca href\u003d\"https://console.aws.amazon.com/grafana/home/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Console\u003c/a\u003e and \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/what-is-Amazon-Managed-Service-Grafana.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana user guide\u003c/a\u003e. To learn more about Amazon Managed Grafana, visit the \u003ca href\u003d\"https://aws.amazon.com/grafana/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eproduct page\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/grafana/pricing/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003epricing page\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2023-07-19T21:39:43Z","headlineUrl":"/about-aws/whats-new/2023/07/amazon-managed-grafana-in-place-update-version-9-4/","postDateTime":"2023-07-19T12:00:00Z","contentType":"Launch Announcement","headline":"Amazon Managed Grafana now supports in-place update for version 9.4","postSummary":"\u003cp\u003eAmazon Managed Grafana is a fully managed service for Grafana, a popular open-source analytics platform that enables you to query, visualize, and alert on your metrics, logs, and traces. With this feature, you can now upgrade your existing workspaces from version 8.4 to 9.4.  \u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#year#2023","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2023","description":"year#2023","dateCreated":"2023-11-07T18:00:12+0000","dateUpdated":"2023-11-07T18:00:12+0000"},{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2023-06-amazon-managed-grafana-opensearch-trace-analytics","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2023/06/amazon-managed-grafana-opensearch-trace-analytics/","dateCreated":"2023-11-09T14:51:19+0000","dateUpdated":"2024-07-25T14:49:18+0000","additionalFields":{"postBody":"\u003cp\u003eAmazon Managed Grafana now supports \u003ca href\u003d\"https://opensearch.org/docs/1.2/observability-plugin/trace/index/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eTrace Analytics\u003c/a\u003e with the OpenSearch Grafana data source plugin, in addition to the existing support for Log Analytics. Amazon Managed Grafana is a fully managed service for Grafana, a popular open-source analytics platform that enables you to query, visualize, and alert on your metrics, logs, and traces. \u003ca href\u003d\"https://opensearch.org/docs/latest/about/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eOpenSearch\u003c/a\u003e is an open-source search and analytics engine for use cases such as log analytics, observability, real-time application monitoring, and clickstream analysis that is also offered as a fully managed \u003ca href\u003d\"https://aws.amazon.com/opensearch-service/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon OpenSearch Service\u003c/a\u003e.\u0026nbsp;\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eWith this release, you can analyze your logs and trace data stored in OpenSearch, alongside metrics from your other data sources, in a single view in Amazon Managed Grafana, thus simplifying the correlation and analysis of these data points. The newly added trace views show the timeline of traces and allow you to drill down into spans, helping you to isolate the source of performance problems and diagnose their root cause directly from your Amazon Managed Grafana workspace.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eOpenSearch Trace Analytics is supported on all Amazon Managed Grafana workspaces with Grafana version 9.4 or higher across all\u0026nbsp;AWS regions where Amazon Managed Grafana is \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/what-is-Amazon-Managed-Service-Grafana.html#AMG-supported-Regions\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003egenerally available\u003c/a\u003e. For more information about this feature, please see the \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/datasources-opensearch-traces.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003edocumentation\u003c/a\u003e. To learn more about Amazon Managed Grafana, visit the \u003ca href\u003d\"https://aws.amazon.com/grafana/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eproduct page\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/grafana/pricing/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003epricing page\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2023-06-22T19:04:58Z","headlineUrl":"/about-aws/whats-new/2023/06/amazon-managed-grafana-opensearch-trace-analytics/","postDateTime":"2023-06-22T12:00:00Z","contentType":"Launch Announcement","headline":"Amazon Managed Grafana now supports OpenSearch Trace Analytics","postSummary":"\u003cp\u003eAmazon Managed Grafana now supports \u003ca href\u003d\"https://opensearch.org/docs/1.2/observability-plugin/trace/index/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eTrace Analytics\u003c/a\u003e with the OpenSearch Grafana data source plugin, in addition to the existing support for Log Analytics. Amazon Managed Grafana is a fully managed service for Grafana, a popular open-source analytics platform that enables you to query, visualize, and alert on your metrics, logs, and traces. \u003ca href\u003d\"https://opensearch.org/docs/latest/about/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eOpenSearch\u003c/a\u003e is an open-source search and analytics engine for use cases such as log analytics, observability, real-time application monitoring, and clickstream analysis that is also offered as a fully managed \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/opensearch-service.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon OpenSearch Service\u003c/a\u003e.\u0026nbsp;\u003cbr\u003e\r\n\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#general-products#amazon-opensearch-service","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-opensearch-service","description":"general:products/amazon-opensearch-service","dateCreated":"2023-11-09T14:26:10+0000","dateUpdated":"2023-11-09T14:26:10+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#year#2023","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2023","description":"year#2023","dateCreated":"2023-11-07T18:00:12+0000","dateUpdated":"2023-11-07T18:00:12+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2023-06-amazon-managed-grafana-soc-compliant","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2023/06/amazon-managed-grafana-soc-compliant/","dateCreated":"2023-11-09T14:46:11+0000","dateUpdated":"2024-07-25T14:33:24+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/grafana/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana\u003c/a\u003e is a fully managed service for Grafana, a popular open-source analytics platform that enables you to query, visualize, and alert on your metrics, logs, and traces.\u003c/p\u003e\r\n\u003cp\u003eToday, we are excited to announce that Amazon Managed Grafana is now System and Organization Controls (SOC) compliant. You can now use Amazon Managed Grafana to visualize data that is subject to SOC compliance. \u003ca href\u003d\"https://aws.amazon.com/compliance/soc-faqs/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS SOC reports\u003c/a\u003e are independent third-party examination reports that demonstrate how AWS achieves key compliance controls and objectives. The purpose of these reports is to help you and your auditors understand the AWS controls established to support operations and compliance.\u003c/p\u003e\r\n\u003cp\u003eAWS SOC 1 and SOC 2 Security, Availability, and Confidentiality, and Privacy Reports are also now available. You can download the AWS SOC reports in \u003ca href\u003d\"https://aws.amazon.com/artifact/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Artifact\u003c/a\u003e. To learn more, visit the \u003ca href\u003d\"https://aws.amazon.com/compliance/services-in-scope/SOC/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS services compliance page\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/compliance/resources/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS compliance resources\u003c/a\u003e. The SOC 3 Report has been updated and is publicly available \u003ca href\u003d\"https://d1.awsstatic.com/whitepapers/compliance/AWS_SOC3.pdf\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003ehere\u003c/a\u003e, as well as through the \u003ca href\u003d\"https://aws.amazon.com/compliance/soc-faqs/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Compliance website\u003c/a\u003e.\u003c/p\u003e\r\n\u003cp\u003eTo get started with Amazon Managed Grafana, visit the \u003ca href\u003d\"https://console.aws.amazon.com/grafana/home/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Console\u003c/a\u003e and the \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/what-is-Amazon-Managed-Service-Grafana.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003euser guide\u003c/a\u003e. Amazon Managed Grafana is SOC compliant in all AWS regions where it is \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/what-is-Amazon-Managed-Service-Grafana.html#AMG-supported-Regions\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003egenerally available\u003c/a\u003e.  To learn more about Amazon Managed Grafana, visit the \u003ca href\u003d\"https://aws.amazon.com/grafana/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eproduct page\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/grafana/pricing/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003epricing page\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2023-06-01T17:02:59Z","headlineUrl":"/about-aws/whats-new/2023/06/amazon-managed-grafana-soc-compliant/","postDateTime":"2023-06-01T12:00:00Z","contentType":"Launch Announcement","headline":"Amazon Managed Grafana is now System and Organization Controls (SOC) compliant","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/grafana.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana\u003c/a\u003e is a fully managed service for Grafana, a popular open-source analytics platform that enables you to query, visualize, and alert on your metrics, logs, and traces.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2023","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2023","description":"year#2023","dateCreated":"2023-11-07T18:00:12+0000","dateUpdated":"2023-11-07T18:00:12+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2023-04-amazon-managed-grafana-workspace-configuration-version-9-4-option","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2023/04/amazon-managed-grafana-workspace-configuration-version-9-4-option/","dateCreated":"2023-11-09T14:59:27+0000","dateUpdated":"2024-07-25T14:45:20+0000","additionalFields":{"postBody":"\u003cp\u003eAmazon Managed Grafana is a fully managed service for Grafana, a popular open-source analytics platform that enables you to query, visualize, and alert on your metrics, logs, and traces. Since inception, Amazon Managed Grafana maintained a single version offering across all workspaces globally. With this release, you can select an Amazon Managed Grafana supported version to create a new workspace. Version 9.4 includes several new features to further enhance your experience in Amazon Managed Grafana including, but not limited to: plugin enhancements to support CloudWatch cross-account querying, OpenSearch serverless, querying multiple asset properties from AWS IoT Sitewise, query result reuse and async queries for Athena; Prometheus and Loki query builders make it even easier to create and modify queries for your data sources; Service accounts that provide a secure and efficient way to automate tasks within your Grafana instance.\u003c/p\u003e\r\n\u003cp\u003eTo explore the complete list of new features, please refer to the \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/using-grafana-v9.html\" target\u003d\"_blank\"\u003euser documentation here\u003c/a\u003e. Follow the instructions \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/AMG-configure-workspace.html\" target\u003d\"_blank\"\u003ehere\u003c/a\u003e to configuring workspaces with version 9.4. To migrate an existing workspace, check out \u003ca href\u003d\"https://github.com/aws-observability/amazon-managed-grafana-migrator\" target\u003d\"_blank\"\u003eamazon-managed-grafana-migrator\u003c/a\u003e.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eThis release is generally available in the following regions: US East (N. Virginia), US East (Ohio), US West (Oregon), Europe (Ireland), Europe (Frankfurt), Europe (London), Asia Pacific (Singapore), Asia Pacific (Tokyo), and Asia Pacific (Sydney). To get started with Amazon Managed Grafana, visit the \u003ca href\u003d\"https://console.aws.amazon.com/grafana/home/\" target\u003d\"_blank\"\u003eAWS Console\u003c/a\u003e and \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/what-is-Amazon-Managed-Service-Grafana.html\" target\u003d\"_blank\"\u003eAmazon Managed Grafana user guide\u003c/a\u003e. To learn more about Amazon Managed Grafana features and its pricing, visit the \u003ca href\u003d\"https://aws.amazon.com/grafana/\" target\u003d\"_blank\"\u003eproduct page\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/grafana/pricing/\" target\u003d\"_blank\"\u003epricing page\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2023-04-28T18:23:38Z","headlineUrl":"/about-aws/whats-new/2023/04/amazon-managed-grafana-workspace-configuration-version-9-4-option/","postDateTime":"2023-04-28T12:00:00Z","contentType":"Launch Announcement","headline":"Amazon Managed Grafana now supports workspace configuration with version 9.4 option","postSummary":"\u003cp\u003eAmazon Managed Grafana is a fully managed service for Grafana, a popular open-source analytics platform that enables you to query, visualize, and alert on your metrics, logs, and traces. Since inception, Amazon Managed Grafana maintained a single version offering across all workspaces globally. With this release, you can select an Amazon Managed Grafana supported version to create a new workspace. Version 9.4 includes several new features to further enhance your experience in Amazon Managed Grafana including, but not limited to: plugin enhancements to support CloudWatch cross-account querying, OpenSearch serverless, querying multiple asset properties from AWS IoT Sitewise, query result reuse and async queries for Athena; Prometheus and Loki query builders make it even easier to create and modify queries for your data sources; Service accounts that provide a secure and efficient way to automate tasks within your Grafana instance.\u003c/p\u003e\r\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#year#2023","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2023","description":"year#2023","dateCreated":"2023-11-07T18:00:12+0000","dateUpdated":"2023-11-07T18:00:12+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2023-02-amazon-managed-grafana-network-access-control","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2023/02/amazon-managed-grafana-network-access-control/","dateCreated":"2023-11-09T14:55:12+0000","dateUpdated":"2024-07-25T14:51:07+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/grafana/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana\u003c/a\u003e now supports inbound network access control that helps you to restrict user access to your Grafana workspaces. Amazon Managed Grafana is a fully managed service for Grafana, a popular open-source analytics platform that enables you to query, visualize, and alert on your metrics, logs, and traces.  With this launch, you have granular security controls over the rollout of Grafana workspaces by defining \u003ca href\u003d\"https://docs.aws.amazon.com/vpc/latest/userguide/managed-prefix-lists.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003ecustomer-managed prefix lists\u003c/a\u003e and \u003ca href\u003d\"https://docs.aws.amazon.com/whitepapers/latest/aws-privatelink/what-are-vpc-endpoints.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eVPC endpoints\u003c/a\u003e to help you restrict the inbound network traffic that can reach your Grafana workspaces.\u0026nbsp;\u003c/p\u003e\r\n\u003cp\u003eAmazon Managed Grafana supports two modes for user and host access of your Grafana workspace: open access and restricted access. Open access is the default access setting for Grafana workspaces when there are no VPC endpoints or managed prefix list restrictions to reach your Grafana workspace URL; however, users must still authenticate with the configured identity provider(s) in order to log in to the workspace. Restricted access mode enables you to specify the inbound network traffic that is allowed to reach your workspace. To restrict access, you can configure prefix lists to specify IP address ranges from which users and hosts can reach your Grafana workspace. You can also \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/VPC-endpoints.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003ecreate an interface VPC endpoints\u003c/a\u003e to allow AWS resources such as Amazon EC2 instances to access the Amazon Managed Grafana API to manage resources, or you can use a VPC endpoint as part of limiting network access to your Amazon Managed Grafana workspaces.\u003c/p\u003e\r\n\u003cp\u003eThis release is generally available in the following regions: US East (N. Virginia), US East (Ohio), US West (Oregon), Europe (Ireland), Europe (Frankfurt), Europe (London), Asia Pacific (Singapore), Asia Pacific (Tokyo), Asia Pacific (Sydney), Asia Pacific (Seoul). Along with this release, we also launched the \u003ca href\u003d\"https://aws.amazon.com/about-aws/whats-new/2022/11/amazon-managed-grafana-connection-data-sources-hosted-virtual-private-cloud/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eoutbound VPC data source connections\u003c/a\u003e to the Asia Pacific (Singapore) and Europe (London) regions. To get started with creating a workspace, visit the \u003ca href\u003d\"https://console.aws.amazon.com/grafana/home/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Console\u003c/a\u003e, use SDK, CLI or CloudFormation. To learn more, check out the \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/what-is-Amazon-Managed-Service-Grafana.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana user guide\u003c/a\u003e, the Amazon Managed Grafana \u003ca href\u003d\"https://aws.amazon.com/grafana/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eproduct page\u003c/a\u003e, and \u003ca href\u003d\"https://aws.amazon.com/grafana/pricing/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003epricing page\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2023-02-16T20:35:26Z","headlineUrl":"/about-aws/whats-new/2023/02/amazon-managed-grafana-network-access-control/","postDateTime":"2023-02-16T08:00:00Z","contentType":"Launch Announcement","headline":"Amazon Managed Grafana now supports network access control ","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/grafana.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana\u003c/a\u003e now supports inbound network access control that helps you to restrict user access to your Grafana workspaces. Amazon Managed Grafana is a fully managed service for Grafana, a popular open-source analytics platform that enables you to query, visualize, and alert on your metrics, logs, and traces.  With this launch, you have granular security controls over the rollout of Grafana workspaces by defining \u003ca href\u003d\"https://docs.aws.amazon.com/vpc/latest/userguide/managed-prefix-lists.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003ecustomer-managed prefix lists\u003c/a\u003e and \u003ca href\u003d\"https://docs.aws.amazon.com/whitepapers/latest/aws-privatelink/what-are-vpc-endpoints.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eVPC endpoints\u003c/a\u003e to help you restrict the inbound network traffic that can reach your Grafana workspaces.\u0026nbsp;\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#year#2023","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2023","description":"year#2023","dateCreated":"2023-11-07T18:00:12+0000","dateUpdated":"2023-11-07T18:00:12+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-12-amazon-managed-grafana-support-aws-cloudformation","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/12/amazon-managed-grafana-support-aws-cloudformation/","dateCreated":"2023-11-09T14:56:19+0000","dateUpdated":"2024-07-25T14:46:12+0000","additionalFields":{"postBody":"\u003cp\u003eAmazon Managed Grafana now supports AWS CloudFormation. You can use AWS CloudFormation templates to create, update, and delete your Amazon Managed Grafana workspaces, as well as manage or update workspace SAML authentication settings. \u003c/p\u003e\r\n\u003cp\u003eAmazon Managed Grafana is a fully managed service for Grafana, a popular open-source analytics platform that enables you to query, visualize, and alert on your metrics, logs, and traces. AWS CloudFormation is a service that enables you to model, provision, and manage AWS and third-party resources by treating infrastructure as code. Using CloudFormation, you can now use templates to provision new Grafana workspaces, edit workspace settings such as workspace name or description, and manage the lifecycle of your Grafana workspaces programmatically. You can also create CloudFormation templates to configure workspace authentication options such as setting up SAML Identity Providers, specifying user roles, or defining attributes to identify user authentication. To learn more about manage Amazon Managed Grafana workspaces and configuring workspace SAML authentication with CloudFormation, see the \u003ca href\u003d\"https://docs.aws.amazon.com/AWSCloudFormation/latest/UserGuide/AWS_Grafana.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana resource type reference\u003c/a\u003e in the CloudFormation user guide. To create Amazon Managed Grafana workspaces using AWS CloudFormation, follow the \u003ca href\u003d\"https://docs.aws.amazon.com/AWSCloudFormation/latest/UserGuide/aws-resource-grafana-workspace.html#aws-resource-grafana-workspace--examples\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003ereference templates\u003c/a\u003e.\u003c/p\u003e\r\n\u003cp\u003eAmazon Managed Grafana is generally available in the following regions: US East (N. Virginia), US East (Ohio), US West (Oregon), Europe (Ireland), Europe (Frankfurt), Europe (London), Asia Pacific (Singapore), Asia Pacific (Tokyo), Asia Pacific (Sydney), Asia Pacific (Seoul). To get started with Amazon Managed Grafana, visit the \u003ca href\u003d\"https://console.aws.amazon.com/grafana/home/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Console\u003c/a\u003e and \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/what-is-Amazon-Managed-Service-Grafana.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana user guide\u003c/a\u003e. To learn more about Amazon Managed Grafana features and its pricing, visit the \u003ca href\u003d\"https://aws.amazon.com/grafana/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eproduct page\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/grafana/pricing/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003epricing page\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2022-12-09T18:45:00Z","headlineUrl":"/about-aws/whats-new/2022/12/amazon-managed-grafana-support-aws-cloudformation/","postDateTime":"2022-12-09T13:00:00Z","contentType":"Launch Announcement","headline":"Amazon Managed Grafana adds support for AWS CloudFormation","postSummary":"\u003cp\u003eAmazon Managed Grafana now supports AWS CloudFormation. You can use AWS CloudFormation templates to create, update, and delete your Amazon Managed Grafana workspaces, as well as manage or update workspace SAML authentication settings. \u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-cloudformation","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-cloudformation","description":"general:products/aws-cloudformation","dateCreated":"2023-11-09T13:50:49+0000","dateUpdated":"2023-11-09T13:50:49+0000"},{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-11-amazon-managed-grafana-connection-data-sources-hosted-virtual-private-cloud","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/11/amazon-managed-grafana-connection-data-sources-hosted-virtual-private-cloud/","dateCreated":"2023-11-09T14:56:42+0000","dateUpdated":"2024-07-25T14:22:01+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/grafana/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana\u003c/a\u003e now supports direct connectivity to data sources hosted in your \u003ca href\u003d\"https://aws.amazon.com/vpc/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Virtual Private Cloud (VPC)\u003c/a\u003e. Amazon\u0026nbsp;Managed Grafana is a fully managed service for open-source Grafana that simplifies connecting to open-source, third-party ISV, and AWS services for visualizing and analyzing your data sources at scale. Amazon VPC is a virtual network dedicated to your AWS account where you have complete control over the virtual networking environment, including creating public-facing and private-facing subnets for your applications to connect.\u0026nbsp;\u003c/p\u003e\r\n\u003cp\u003ePreviously, Amazon Managed Grafana connected to VPC hosted data sources via public networks. Now, Amazon Managed Grafana can also connect to data sources that are inside a VPC without using public IPs or requiring traffic to traverse the Internet. Data sources such as OpenSearch, Amazon RDS databases, self-managed Prometheus, and other data sources often do not have a publicly facing endpoint. By connecting your Amazon Managed Grafana workspaces to your VPC, you will now be able to query, visualize, and alert on the data sources within your VPC. You can also connect Grafana workspaces to multiple VPCs using \u003ca href\u003d\"https://docs.aws.amazon.com/vpc/latest/peering/what-is-vpc-peering.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eVPC Peering\u003c/a\u003e or \u003ca href\u003d\"https://aws.amazon.com/transit-gateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Transit Gateway\u003c/a\u003e. In this way, you can have both your privately-hosted and public-facing data sources connect to the same Amazon Managed Grafana workspace to visualize your data all in one place.\u003c/p\u003e\r\n\u003cp\u003eThis feature is available within the following AWS Regions: US East (Ohio), US East (N Virginia), US West (Oregon), Europe (Ireland), Europe (Frankfurt), Asia Pacific (Sydney) and Asia Pacific (Tokyo). To configure VPC for Managed Grafana workspaces, you can use the \u003ca href\u003d\"https://console.aws.amazon.com/grafana/home/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Console\u003c/a\u003e, SDK, or CLI. Check out the \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/AMG-configure-vpc.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana user guide\u003c/a\u003e for detailed documentation. To learn more, visit the Amazon Managed Grafana \u003ca href\u003d\"https://aws.amazon.com/grafana/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eproduct page\u003c/a\u003e, \u003ca href\u003d\"https://aws.amazon.com/grafana/pricing/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003epricing page\u003c/a\u003e, and \u003ca href\u003d\"https://aws-observability.github.io/aws-o11y-recipes/amg/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Observability Recipes\u003c/a\u003e page for getting started templates.\u003c/p\u003e\r\n","modifiedDate":"2022-11-23T21:43:05Z","headlineUrl":"/about-aws/whats-new/2022/11/amazon-managed-grafana-connection-data-sources-hosted-virtual-private-cloud/","postDateTime":"2022-11-23T13:00:00Z","contentType":"Launch Announcement","headline":"Amazon Managed Grafana now supports connection to data sources hosted in Amazon Virtual Private Cloud","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/grafana.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana\u003c/a\u003e now supports direct connectivity to data sources hosted in your \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/vpc.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Virtual Private Cloud (VPC)\u003c/a\u003e. Amazon\u0026nbsp;Managed Grafana is a fully managed service for open-source Grafana that simplifies connecting to open-source, third-party ISV, and AWS services for visualizing and analyzing your data sources at scale. Amazon VPC is a virtual network dedicated to your AWS account where you have complete control over the virtual networking environment, including creating public-facing and private-facing subnets for your applications to connect.\u0026nbsp;\u003c/p\u003e\r\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#amazon-vpc","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-vpc","description":"general:products/amazon-vpc","dateCreated":"2023-11-09T13:51:18+0000","dateUpdated":"2023-11-09T13:51:18+0000"},{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"},{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-11-amazon-managed-grafana-visualizing-prometheus-alertmanager-rules-configuration-apis","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/11/amazon-managed-grafana-visualizing-prometheus-alertmanager-rules-configuration-apis/","dateCreated":"2023-11-09T14:41:50+0000","dateUpdated":"2024-07-25T14:33:59+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/grafana/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana\u003c/a\u003e now supports visualizing Prometheus Alertmanager rules, new configuration APIs and additional visualization plugins. AWS customers using \u003ca href\u003d\"https://aws.amazon.com/prometheus/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Service for Prometheus\u003c/a\u003e, or running self-managed Prometheus environments can visualize and analyze their Alertmanager rules, alert states, silences and contact points directly in an Amazon Managed Grafana workspace. Customers can opt-in to viewing their Prometheus Alertmanager rules by turning on Grafana alerting from the Amazon Managed Grafana console or programmatically using the new configuration APIs, designed to manage workspace settings. Current workspace configuration details can be retrieved using the DescribeWorkspaceConfiguration API and settings can be updated via the UpdateWorkspaceConfiguration API. The CreateWorkspace API, used to programmatically create, delete and manage Grafana workspaces, has been updated to allow customers to enable Grafana alerting during workspace creation. Amazon Managed Grafana also adds support for Sankey, Plotly and Scatter visualization plugins, providing customers more visualization options for their dashboards.\u003c/p\u003e\r\n\u003cp\u003eAmazon Managed Grafana is a fully managed service that takes care of the provisioning, setup, scaling, and maintenance of Grafana servers. Grafana alerting is available in every region where Amazon Managed Grafana is generally available. To get started with Grafana alerting for visualizing Prometheus Alertmanager rules, visit the \u003ca href\u003d\"https://console.aws.amazon.com/grafana/home/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana Console\u003c/a\u003e or check out the \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/alerts-overview.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana user guide\u003c/a\u003e, \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/APIReference/index.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAPI Reference\u003c/a\u003e, or \u003ca href\u003d\"https://docs.aws.amazon.com/cli/latest/reference/grafana/index.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eCLI reference\u003c/a\u003e for detailed documentation.\u003c/p\u003e\r\n","modifiedDate":"2022-11-23T22:03:41Z","headlineUrl":"/about-aws/whats-new/2022/11/amazon-managed-grafana-visualizing-prometheus-alertmanager-rules-configuration-apis/","postDateTime":"2022-11-23T13:00:00Z","contentType":"Launch Announcement","headline":"Amazon Managed Grafana now supports visualizing Prometheus Alertmanager rules and new configuration APIs","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/grafana.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana\u003c/a\u003e now supports visualizing Prometheus Alertmanager rules, new configuration APIs and additional visualization plugins. AWS customers using \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/prometheus.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Service for Prometheus\u003c/a\u003e, or running self-managed Prometheus environments can visualize and analyze their Alertmanager rules, alert states, silences and contact points directly in an Amazon Managed Grafana workspace. Customers can opt-in to viewing their Prometheus Alertmanager rules by turning on Grafana alerting from the Amazon Managed Grafana console or programmatically using the new configuration APIs, designed to manage workspace settings. Current workspace configuration details can be retrieved using the DescribeWorkspaceConfiguration API and settings can be updated via the UpdateWorkspaceConfiguration API. The CreateWorkspace API, used to programmatically create, delete and manage Grafana workspaces, has been updated to allow customers to enable Grafana alerting during workspace creation. Amazon Managed Grafana also adds support for Sankey, Plotly and Scatter visualization plugins, providing customers more visualization options for their dashboards.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"},{"id":"whats-new-v2#general-products#amazon-amp","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-amp","description":"general:products/amazon-amp","dateCreated":"2023-11-09T14:02:07+0000","dateUpdated":"2023-11-09T14:02:07+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-05-amazon-managed-grafana-api-tokens-support-version-8-4","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/05/amazon-managed-grafana-api-tokens-support-version-8-4/","dateCreated":"2023-11-09T14:48:40+0000","dateUpdated":"2024-07-25T14:57:14+0000","additionalFields":{"postBody":"\u003cp\u003eAmazon Managed Grafana now supports a new API for creating Grafana API tokens, as well as support for new plugins, Grafana version 8.4, and workspace tags.  With CreateWorkspaceApiKey, customers can create Grafana API tokens without having to log into the Grafana workspace console, enabling users to programmatically create, delete, and manage Grafana resources such as dashboards, alerts, and data sources.  Amazon Managed Grafana adds support for Github, Moogsoft, Pixie, and Windrose plugins, enabling customers to connect, query, and visualize data from additional data sources.  Existing and new Amazon Managed Grafana workspaces now support Grafana version 8.4, with no action required from users.  Customers can now tag Amazon Managed Grafana workspaces to help simplify organization and cost management of workspaces.  Tags are labels in the form of key-value pairs that may be attached to Amazon Managed Grafana workspaces to search, filter, or allocate costs. \u003c/p\u003e\r\n\u003cp\u003eAmazon Managed Grafana is a fully managed service that takes care of the provisioning, setup, scaling, and maintenance of Grafana servers and is generally available in the following regions:\u0026nbsp;US East (Ohio), US East (N. Virginia), US West (Oregon), Europe (Ireland), Europe (Frankfurt), Europe (London), Asia Pacific (Singapore), Asia Pacific (Tokyo), Asia Pacific (Sydney), Asia Pacific (Seoul).  To get started with creating a workspace, visit the \u003ca href\u003d\"https://console.aws.amazon.com/grafana/home/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Console\u003c/a\u003e\u0026nbsp;or check out the \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/what-is-Amazon-Managed-Service-Grafana.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana user guide\u003c/a\u003e\u0026nbsp;for detailed documentation. To learn more, visit the Amazon Managed Grafana \u003ca href\u003d\"https://aws.amazon.com/grafana/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eproduct page\u003c/a\u003e, \u003ca href\u003d\"https://aws.amazon.com/grafana/pricing/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003epricing page\u003c/a\u003e, and \u003ca href\u003d\"https://aws-observability.github.io/aws-o11y-recipes/amg/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Observability Recipes\u003c/a\u003e\u0026nbsp;page for getting started templates.\u003c/p\u003e\r\n","modifiedDate":"2022-05-24T21:54:44Z","headlineUrl":"/about-aws/whats-new/2022/05/amazon-managed-grafana-api-tokens-support-version-8-4/","postDateTime":"2022-05-24T07:00:00Z","contentType":"Launch Announcement","headline":"Amazon Managed Grafana introduces new API for creating Grafana API tokens and support for version 8.4","postSummary":"\u003cp\u003eAmazon Managed Grafana now supports a new API for creating Grafana API tokens, as well as support for new plugins, Grafana version 8.4, and workspace tags.  With CreateWorkspaceApiKey, customers can create Grafana API tokens without having to log into the Grafana workspace console, enabling users to programmatically create, delete, and manage Grafana resources such as dashboards, alerts, and data sources.  Amazon Managed Grafana adds support for Github, Moogsoft, Pixie, and Windrose plugins, enabling customers to connect, query, and visualize data from additional data sources.  Existing and new Amazon Managed Grafana workspaces now support Grafana version 8.4, with no action required from users.  Customers can now tag Amazon Managed Grafana workspaces to help simplify organization and cost management of workspaces.  Tags are labels in the form of key-value pairs that may be attached to Amazon Managed Grafana workspaces to search, filter, or allocate costs. \u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"},{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"},{"id":"whats-new-v2#marketing-marchitecture#analytics","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"analytics","description":"marketing:marchitecture/analytics","dateCreated":"2023-11-07T22:36:01+0000","dateUpdated":"2023-11-07T22:36:01+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2021-11-amazon-grafana-athena-redshift-data-sources-geomap","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2021/11/amazon-grafana-athena-redshift-data-sources-geomap/","dateCreated":"2023-11-09T14:44:47+0000","dateUpdated":"2024-07-25T14:17:42+0000","additionalFields":{"postBody":"\u003cp\u003eAmazon Managed Grafana announces new data source plugins for Amazon Athena and Amazon Redshift, enabling customers to query, visualize, and alert on their Athena and Redshift data from Amazon Managed Grafana workspaces.  Amazon Managed Grafana now also supports CloudFlare, Zabbix, and Splunk Infrastructure Monitoring data sources as well as the Geomap panel visualization and open source Grafana version 8.2.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eWith the new Amazon Athena data source, customers can now connect to, query, and analyze their Amazon Simple Storage Service (Amazon S3) data using standard SQL directly from Amazon Managed Grafana workspaces.  Customers can also leverage the default dashboard that comes with the Amazon Athena plugin to query their AWS Cost and Usage Reports and visualize their AWS spend.  Using the new Amazon Redshift data source, customers can now create dashboards and alerts in their Amazon Managed Grafana workspaces to analyze their structured and semi-structured data across data warehouses, operational databases, and data lakes.  The Amazon Redshift plugin also comes with a default dashboard out-of-the-box that makes it easy for customers to get started with monitoring the health and performance of their Redshift clusters.\u0026nbsp;\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eCustomers can now also use the Geomap panel visualization to visualize their geospatial data in a map view.  Customers can configure multiple overlay styles to visually represent important location-based characteristics of their data, such as the heatmap overlay to cluster data points for visualizing hotspot locations with high data densities.  The Zabbix and CloudFlare data sources are now available on Amazon Managed Grafana, enabling customers to visualize Zabbix metrics and connect to their CloudFlare account to monitor their DNS traffic by geography, latency, response code, query type, and hostname.  With the Splunk Infrastructure Monitoring data source, available with a \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/upgrade-to-Grafana-Enterprise.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eGrafana Enterprise License\u003c/a\u003e, customers can now also visualize Splunk Infrastructure Monitoring data directly from their Managed Grafana workspaces.  Existing and new Amazon Managed Grafana workspaces are now automatically upgraded to Grafana version 8.2, with no action required from customers.  \u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eAmazon Managed Grafana is a fully managed service that takes care of the provisioning, setup, scaling, and maintenance of Grafana servers and is generally available in the following regions: US East (N. Virginia), US East (Ohio), US West (Oregon), Europe (Ireland), Europe (Frankfurt), Europe (London), Asia Pacific (Singapore), Asia Pacific (Tokyo), Asia Pacific (Sydney), Asia Pacific (Seoul). To get started with creating a workspace, visit the \u003ca href\u003d\"https://console.aws.amazon.com/grafana/home/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Console\u003c/a\u003e or check out the \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/what-is-Amazon-Managed-Service-Grafana.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana user guide\u003c/a\u003e for detailed documentation. To learn more, visit the Amazon Managed Grafana \u003ca href\u003d\"https://aws.amazon.com/grafana/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eproduct page\u003c/a\u003e,\u0026nbsp;\u003ca href\u003d\"https://aws.amazon.com/grafana/pricing/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003epricing page\u003c/a\u003e, and \u003ca href\u003d\"https://aws-observability.github.io/aws-o11y-recipes/amg/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Observability Recipes\u003c/a\u003e page for getting started templates.\u0026nbsp;\u003c/p\u003e\r\n","modifiedDate":"2021-11-24T22:52:46Z","headlineUrl":"/about-aws/whats-new/2021/11/amazon-grafana-athena-redshift-data-sources-geomap/","postDateTime":"2021-11-24T08:00:00Z","contentType":"Launch Announcement","headline":"Amazon Managed Grafana adds support for Amazon Athena and Amazon Redshift data sources and Geomap visualization","postSummary":"\u003cp\u003eAmazon Managed Grafana announces new data source plugins for Amazon Athena and Amazon Redshift, enabling customers to query, visualize, and alert on their Athena and Redshift data from Amazon Managed Grafana workspaces.  Amazon Managed Grafana now also supports CloudFlare, Zabbix, and Splunk Infrastructure Monitoring data sources as well as the Geomap panel visualization and open source Grafana version 8.2.\u003cbr\u003e\r\n\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#year#2021","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2021","description":"year#2021","dateCreated":"2023-11-09T14:24:35+0000","dateUpdated":"2023-11-09T14:24:35+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#amazon-athena","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-athena","description":"general:products/amazon-athena","dateCreated":"2023-11-09T13:51:35+0000","dateUpdated":"2023-11-09T13:51:35+0000"},{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#marketing-marchitecture#analytics","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"analytics","description":"marketing:marchitecture/analytics","dateCreated":"2023-11-07T22:36:01+0000","dateUpdated":"2023-11-07T22:36:01+0000"},{"id":"whats-new-v2#general-products#amazon-redshift","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-redshift","description":"general:products/amazon-redshift","dateCreated":"2023-11-07T22:36:01+0000","dateUpdated":"2023-11-07T22:36:01+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2021-08-amazon-managed-grafana-saml-2-0-grafana-v-8-0","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2021/08/amazon-managed-grafana-saml-2-0-grafana-v-8-0/","dateCreated":"2023-11-09T14:41:30+0000","dateUpdated":"2024-07-25T14:07:34+0000","additionalFields":{"postBody":"\u003cp\u003eAmazon Managed Grafana is now generally available.  Amazon Managed Grafana is a fully managed, secure data visualization service that enables customers to query, correlate, and visualize operational metrics, logs, and traces for their applications across multiple data sources. Developed in collaboration with Grafana Labs, Amazon Managed Grafana manages the provisioning, setup, scaling, and maintenance of Grafana servers, eliminating the need for customers to do this themselves.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eAs part of this launch, we are introducing additional capabilities such as native support for Security Assertion Markup Language (SAML) 2.0 to enable single sign-on for Amazon Managed Grafana workspaces.  Using SAML, you can integrate directly with your identity provider (IdP) and enable users to log into Amazon Managed Grafana workspaces with their existing usernames and passwords.  To simplify setting up SAML for your workspaces, Amazon Managed Grafana also integrates with the dedicated SAML applications built by CyberArk, Okta, OneLogin, Ping Identity, and Azure Active Directory, which you can discover and configure directly from your IdP’s application galleries.\u0026nbsp;\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eAmazon Managed Grafana also supports Grafana API Keys and the \u003ca href\u003d\"https://registry.terraform.io/providers/grafana/grafana/latest/docs\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eTerraform Grafana provider,\u003c/a\u003e enabling you to automate the creation of dashboards, data sources, and other Grafana resources.  You can track and audit changes made to your Amazon Managed Grafana workspaces with an expanded set of CloudTrail logs, such as when dashboards are deleted, data source permissions are changed, and more.  Amazon Managed Grafana now supports open source Grafana version 8.0, which includes new features such as library panels that you can build once and re-use on multiple dashboards, a prometheus metrics browser to quickly find and query metrics, new state timeline and status history visualizations, and much more.  Additionally, Amazon Managed Grafana supports nine new data source plugins, such as the JSON and Redis data source plugins, as well as new Grafana Enterprise data source plugins including Salesforce, SAP HANA, Atlassian Jira, and more.  To access enterprise data sources, you can upgrade to \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/upgrade-to-Grafana-Enterprise.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eGrafana Enterprise\u003c/a\u003e from the Amazon Managed Grafana console, which will enable access to new and previously supported plugins including AppDynamics, DataDog, Dynatrace, MongoDB, New Relic, Snowflake, VMware Tanzu Observability by Wavefront, and more.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eAmazon Managed Grafana is generally available in the following regions: US East (N. Virginia), US East (Ohio), US West (Oregon), Europe (Ireland), Europe (Frankfurt), Europe (London), Asia Pacific (Singapore), Asia Pacific (Tokyo), Asia Pacific (Sydney), Asia Pacific (Seoul).  To get started, check out the \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/what-is-Amazon-Managed-Service-Grafana.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon Managed Grafana user guide\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/blogs/aws/amazon-managed-grafana-is-now-generally-available-with-many-new-features\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS News Blog\u003c/a\u003e.  To learn more, visit the Amazon Managed Grafana \u003ca href\u003d\"https://aws.amazon.com/grafana/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eproduct page\u003c/a\u003e\u0026nbsp;and \u003ca href\u003d\"https://aws.amazon.com/grafana/pricing/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003epricing page\u003c/a\u003e for more information. \u003c/p\u003e\r\n","modifiedDate":"2021-09-01T01:19:53Z","headlineUrl":"/about-aws/whats-new/2021/08/amazon-managed-grafana-saml-2-0-grafana-v-8-0/","postDateTime":"2021-08-31T07:00:00Z","contentType":"Launch Announcement","headline":"AWS announces General Availability of Amazon Managed Grafana with SAML 2.0 and Grafana v8.0 features","postSummary":"\u003cp\u003eAmazon Managed Grafana is now generally available.  Amazon Managed Grafana is a fully managed, secure data visualization service that enables customers to query, correlate, and visualize operational metrics, logs, and traces for their applications across multiple data sources. Developed in collaboration with Grafana Labs, Amazon Managed Grafana manages the provisioning, setup, scaling, and maintenance of Grafana servers, eliminating the need for customers to do this themselves.\u003cbr\u003e\r\n\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"},{"id":"whats-new-v2#year#2021","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2021","description":"year#2021","dateCreated":"2023-11-09T14:24:35+0000","dateUpdated":"2023-11-09T14:24:35+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2021-04-amazon-managed-service-for-grafana-now-supports-grafana-enterprise-upgrade-grafana-version-7-5-open-distro-for-elasticsearch-integration-and-aws-billing-reports","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2021/04/amazon-managed-service-for-grafana-now-supports-grafana-enterprise-upgrade-grafana-version-7-5-open-distro-for-elasticsearch-integration-and-aws-billing-reports/","dateCreated":"2023-11-09T14:44:30+0000","dateUpdated":"2024-07-25T14:11:00+0000","additionalFields":{"postBody":"\u003cp\u003eAmazon Managed Service for Grafana (AMG) is a fully managed service that manages the provisioning, setup, scaling, and maintenance of Grafana servers, eliminating the need for customers to do this themselves. Customers can now upgrade their AMG workspaces to Grafana Enterprise with a 30-day free trial via an AWS Marketplace subscription, enabling access to \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/upgrade-to-Grafana-Enterprise.html\" target\u003d\"_blank\"\u003eEnterprise data source plugins\u003c/a\u003e such as ServiceNow, Splunk, and New Relic as well as support, training, and consultation directly from Grafana Labs. AMG now also supports open source Grafana version 7.5, which includes new features such as support for larger Prometheus queries via POST method, Amazon CloudWatch plugin enhancements, AWS X-Ray service map visualization, and many more. The new Open Distro for Elasticsearch data source plugin provides improved log data exploration and visualization for Elasticsearch data stored on Amazon Elasticsearch Service or clusters running Open Distro for Elasticsearch (an Apache 2.0-licensed distribution of Elasticsearch). Additionally, customers will now see their AMG usage and billing information in their AWS Billing and Cost Management console.\u0026nbsp;\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003ePreviously, AMG was free for evaluation before April 15th, 2021. Beginning April 16th, 2021, customers using AMG will receive a 90-day free trial for five free users per account, with additional usage charges displayed in their AWS billing reports. Customers that upgrade to Grafana Enterprise will receive a 30-day Enterprise free trial, after which they can opt-in to purchase a paid subscription with usage bills displayed in the AWS Marketplace section of their AWS bill. Grafana Enterprise enables customers to connect to a wide variety of Enterprise third party independent software vendors (ISVs) such as AppDynamics, DataDog, Dynatrace, MongoDB, New Relic, Oracle Database, ServiceNow, Snowflake, Splunk, and Wavefront. AMG now supports the new Open Distro for Elasticsearch data source plugin with Piped Processing Language (\u003ca href\u003d\"https://aws.amazon.com/blogs/big-data/using-pipes-to-explore-discover-and-find-data-in-amazon-es-with-piped-processing-language/\" target\u003d\"_blank\"\u003ePPL\u003c/a\u003e) support, enabling powerful new query and visualization capabilities for Amazon Elasticsearch Service and Open Distro for Elasticsearch. PPL enables customers to explore and find data without needing to compose lengthy Elasticsearch Domain Specific Language (DSL) statements or write queries using JSON objects. With PPL, customers can write queries as a set of commands delimited by pipes, enabling users to combine two or more commands as a chain, search for keywords and feed results from one command to the next. With support for a comprehensive set of \u003ca href\u003d\"https://opendistro.github.io/for-elasticsearch-docs/docs/ppl/commands/\" target\u003d\"_blank\"\u003ecommands\u003c/a\u003e such as search, dedup, sort, and more, customers can now visualize their metric and log search results in AMG with automatic formatting and highlighting. With the support of Grafana 7.5, customers will be able to access the new feature enhancements automatically in their AMG workspaces without having to perform an upgrade or create new workspaces.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eAMG is now available in preview to all AWS customers, without the need to request access.  AMG is available in the US East (N. Virginia) and Europe (Ireland) regions. To get started, visit the AWS Console \u003ca href\u003d\"https://console.aws.amazon.com/grafana/\" target\u003d\"_blank\"\u003ehere\u003c/a\u003e.  For more information, please visit the user guide \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/what-is-Amazon-Managed-Service-Grafana.html\" target\u003d\"_blank\"\u003ehere\u003c/a\u003e.  To find out more about AMG pricing, please visit the pricing page \u003ca href\u003d\"https://aws.amazon.com/grafana/pricing/\" target\u003d\"_blank\"\u003ehere\u003c/a\u003e. \u003c/p\u003e\r\n","modifiedDate":"2021-04-16T21:37:50Z","headlineUrl":"/about-aws/whats-new/2021/04/amazon-managed-service-for-grafana-now-supports-grafana-enterprise-upgrade-grafana-version-7-5-open-distro-for-elasticsearch-integration-and-aws-billing-reports/","postDateTime":"2021-04-16T18:36:00Z","contentType":"Launch Announcement","headline":"Amazon Managed Service for Grafana now supports Grafana Enterprise upgrade, Grafana version 7.5, Open Distro for Elasticsearch integration, and AWS Billing reports","postSummary":"\u003cp\u003eAmazon Managed Service for Grafana (AMG) is a fully managed service that manages the provisioning, setup, scaling, and maintenance of Grafana servers, eliminating the need for customers to do this themselves. Customers can now upgrade their AMG workspaces to Grafana Enterprise with a 30-day free trial via an AWS Marketplace subscription, enabling access to \u003ca href\u003d\"https://docs.aws.amazon.com/grafana/latest/userguide/upgrade-to-Grafana-Enterprise.html\" target\u003d\"_blank\"\u003eEnterprise data source plugins\u003c/a\u003e such as ServiceNow, Splunk, and New Relic as well as support, training, and consultation directly from Grafana Labs. AMG now also supports open source Grafana version 7.5, which includes new features such as support for larger Prometheus queries via POST method, Amazon CloudWatch plugin enhancements, AWS X-Ray service map visualization, and many more. The new Open Distro for Elasticsearch data source plugin provides improved log data exploration and visualization for Elasticsearch data stored on Amazon Elasticsearch Service or clusters running Open Distro for Elasticsearch (an Apache 2.0-licensed distribution of Elasticsearch). Additionally, customers will now see their AMG usage and billing information in their AWS Billing and Cost Management console.\u0026nbsp;\u003cbr\u003e\r\n\u003c/p\u003e\r\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#general-products#amazon-managed-service-for-grafana","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-managed-service-for-grafana","description":"general:products/amazon-managed-service-for-grafana","dateCreated":"2023-11-09T14:41:27+0000","dateUpdated":"2023-11-09T14:41:27+0000"},{"id":"whats-new-v2#year#2021","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2021","description":"year#2021","dateCreated":"2023-11-09T14:24:35+0000","dateUpdated":"2023-11-09T14:24:35+0000"}]}],"metadata":{"count":23,"totalHits":23},"fieldTypes":{"regionalAvailability":"LongText","nofollow":"Boolean","date":"Date","language":"Text","title":"Text","postDateTime":"DateTime","body":"Text","postSummary":"LongText","ctaLabel":"Text","mediaThumbnail":"Text","nosnippet":"Boolean","price":"Text","ctaLink":"URL","headline":"Text","contentType":"Text","bodyBack":"LongText","secondaryCTALabel":"Text","primaryCTALink":"URL","noindex":"Boolean","level":"Text","heading":"Text","mediaType":"Text","mediaAlt":"Text","headlineUrl":"Text","mediaSrc":"URL","durationMinutes":"Number","badge":"JSON","videoImageUrl":"URL","postBody":"LongText","secondaryCTALink":"URL","Video":"URL","modifiedDate":"DateTime","namePerson":"Text","location":"Text","time":"Text","publishedDate":"DateTime","durationReadtime":"Number","primaryCTALabel":"Text"}}