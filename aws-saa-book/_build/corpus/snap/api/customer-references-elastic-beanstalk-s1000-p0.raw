2022-02-03T03:32:51+0000"},{"id":"customer-references#category#database-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Database Migration","description":"Database Migration","dateCreated":"2019-07-22T18:31:40+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#product#chime","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Chime","description":"Amazon Chime","dateCreated":"2020-03-02T07:01:49+0000","dateUpdated":"2022-02-03T03:32:20+0000"},{"id":"GLOBAL#product#pytorch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"PyTorch on AWS","description":"PyTorch on AWS","dateCreated":"2021-09-27T07:50:35+0000","dateUpdated":"2022-02-03T03:32:55+0000"},{"id":"GLOBAL#product#data-exchange","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Data Exchange","description":"AWS Data Exchange","dateCreated":"2020-12-08T19:55:37+0000","dateUpdated":"2022-02-03T03:32:28+0000"},{"id":"GLOBAL#business-category#cust-engagement","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2020-06-05T07:06:46+0000","dateUpdated":"2022-02-03T03:31:03+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#product#codebuild","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodeBuild","description":"AWS CodeBuild","dateCreated":"2020-03-02T07:02:08+0000","dateUpdated":"2022-02-03T03:32:24+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#grupo-primo-video-from-es-directory","locale":"en_US","directoryId":"customer-references","name":"grupo-primo-video-from-es-directory","dateCreated":"2024-02-03T03:47:02+0000","dateUpdated":"2024-02-06T01:35:38+0000","additionalFields":{"descriptionSummary":"O Grupo Primo é um grupo de mídia, educação, investimentos e tecnologia. Focado em levar educação em finanças e marketing para os brasileiros, fala com mais de 20 milhões de pessoas todos os meses. O Grupo confiou nas soluções AWS para crescer em seu mercado de atuação, ampliando o seu portfólio de cursos, eventos e ações de marketing sem precisar se preocupar com infraestrutura. O ambiente cloud montado sobre os serviços AWS, com o apoio do parceiro de negócios UDS, permitiu ao grupo, por exemplo, suportar mais de 150 mil pessoas ao vivo na live de lançamento de sua plataforma Finclass. Nesse vídeo, especialistas do Grupo Primo contam como utilizam as soluções em cloud da AWS para se dedicar ao core de sua operação, focando inclusive na internacionalização do negócio.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/grupo-primo-logo%402x.ecb02f9a30f336e6c4d943be3621fd2da778b5dd.png","displayLocation":"Brasil","customerNameLower":"grupo primo","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/grupo-primo-video/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Grupo Primo","enableShare":"1","publishedDate":"2021","contentType":"História do cliente","headline":"Grupo Primo confia na AWS para seguir expandindo suas operações"}},"tags":[{"id":"GLOBAL#product#snow-family","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Snow Family","description":"AWS Snow Family","dateCreated":"2020-03-02T07:05:31+0000","dateUpdated":"2022-02-03T03:33:01+0000"},{"id":"customer-references#category#web-hosting","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Web Hosting","description":"Web Hosting","dateCreated":"2019-07-22T18:32:28+0000","dateUpdated":"2022-03-30T20:30:49+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#snowball","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Snowball","description":"AWS Snowball","dateCreated":"2020-03-02T07:05:27+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2