tion":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#askey-case-study","locale":"en_US","directoryId":"customer-references","name":"askey-case-study","dateCreated":"2019-07-19T15:10:57+0000","dateUpdated":"2021-12-22T19:11:00+0000","additionalFields":{"featured":"0","descriptionSummary":"By using AWS, Askey Computer Corporation is ensuring that the growing number of travelers using Taipei Main Station, a railway station and major transportation hub in Taiwan, can move around easily and safely. Askey builds cutting-edge IT solutions that can support smart projects in major cities worldwide.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Askey_Customer-Reference_Logo.a7aff7dd9bfdae8c835025c393796def494ce599.png","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003eBy using AWS, Askey Computer Corporation is ensuring that the growing number of travelers using Taipei Main Station, a railway station and major transportation hub in Taiwan, can move around easily and safely. Askey builds cutting-edge IT solutions that can support smart projects in major cities worldwide. The company runs the IT infrastructure supporting its Taipei Main Station smart project on the AWS Cloud, with Amazon EC2 instances for web applications and services. Askey uses Amazon Kinesis to collate data from thousands of smartphone apps, AWS Lambda to process that data, and Amazon DynamoDB to store it.\u003c/p\u003e\r\n","industry":"Transport \u0026 Logistics","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/askey/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Askey","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Askey Case Study"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#location#taiwan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Taiwan","description":"Taiwan","dateCreated":"2020-02-03T05:29:38+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tag