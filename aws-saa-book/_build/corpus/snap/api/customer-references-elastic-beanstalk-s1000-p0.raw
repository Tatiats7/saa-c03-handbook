nologia será possível, entre outros aspectos, expandir as soluções de análises e interpretações de diversos dados.","featureImageURL":"https://d1.awsstatic.com/sap_page/Broadest%20set%20of%20services.1967b42fd82e7fc0610d93ac71ff757c9e4508aa.jpeg","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/varsomics_logo%402x.e154b444e46fc6f8e204c22eb4b06815c6d10f58.png","displayLocation":"Brasil","customerNameLower":"varsomics","footerInfoText":"Data de publicação","industry":"Saúde","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/varsomics/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Varsomics","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"Einstein implanta nuvem AWS para dar suporte ao crescimento de exames de sequenciamento genético"}},"tags":[{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03