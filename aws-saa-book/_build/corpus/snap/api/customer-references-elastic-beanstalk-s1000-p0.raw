GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#product#elastic-beanstalk","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elastic Beanstalk","description":"AWS Elastic Beanstalk","dateCreated":"2020-03-02T07:03:00+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#aws-case-study-city-of-mckinney","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-city-of-mckinney","dateCreated":"2019-07-22T19:50:49+0000","dateUpdated":"2022-01-21T02:41:34+0000","additionalFields":{"featured":"0","descriptionSummary":"The City of McKinney, Texas has about 155,000 residents and is located 15 miles north of Dallas. The city\u0027s IT department is going all-in on AWS and uses the platform to run a wide range of services and applications, such as its land-management and records-management systems.","imageSrcUrl":"https://d1.awsstatic.com/video-thumbs/Customers/city-of-mckinney-thumb.85cb11bb74577ddb75d6d97af8f33cf014ea57b7.PNG","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eThe City of McKinney, Texas has about 155,000 residents and is located 15 miles north of Dallas. The city?s IT department is going all-in on AWS and uses the platform to run a wide range of services and applications, such as its land-management and records-management systems. By using AWS, the city?s IT department can focus on delivering new and better services for its citizens and city employees instead of spending resources on buying and maintaining IT infrastructure.\u003c/p\u003e\r\n","industry":"Government","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/city-of-mckinney/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"City of McKinney","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: City of McKinney"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_