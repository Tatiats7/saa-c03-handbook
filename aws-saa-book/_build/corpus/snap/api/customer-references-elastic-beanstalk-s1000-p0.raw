ct","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#aws-case-study-vidroll","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-vidroll","dateCreated":"2019-07-22T19:49:55+0000","dateUpdated":"2021-12-22T19:46:14+0000","additionalFields":{"featured":"0","descriptionSummary":"VidRoll is a video technology and monetization platform for content publishers. VidRoll uses AWS Lambda to power the business logic for real-time ad bidding.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/vidroll-logo.e7c3dd7297ebd3f9bf0e346d64dda8ffde60dde5.jpg","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eVidRoll is a video technology and monetization platform for content publishers. VidRoll uses AWS Lambda to power the business logic for real-time ad bidding. Using Lambda, VidRoll developers can focus on product innovations, and the company can grow revenue ten times over without needing to hire additional technical resources.\u003c/p\u003e\r\n","industry":"Digital Marketing","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/vidroll/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"VidRoll","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: VidRoll"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#langua