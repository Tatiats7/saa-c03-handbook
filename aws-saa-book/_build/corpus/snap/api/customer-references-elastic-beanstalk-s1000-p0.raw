on Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-speed3d","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-speed3d","dateCreated":"2019-07-22T19:49:58+0000","dateUpdated":"2021-12-22T19:29:11+0000","additionalFields":{"featured":"0","descriptionSummary":"Speed 3D is a startup whose flagship mobile application, Insta3D, allows customers to turn portrait photos into detailed 3D avatars with customizable clothing and accessories. By moving to AWS, Speed 3D has halved its image-processing time while gaining the scalability required to engage with more than one million mobile users.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/Speed3D-logo.5a386501fd1835a54e22ef6da6e8399c8021b59b.jpg","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003eSpeed 3D?s mission is to help consumers harness the power of 3D modeling using simple applications that leverage mobile and cloud technologies. The company was founded in Taipei in 2014 and its first venture is a mobile application called Insta3D that allows users to convert self-portraits into detailed 3D avatars. Insta3D includes hundreds of pre-modeled clothing and accessory items that customers can then purchase within the app and add to their avatars. Thanks to a partnership with Japanese 3D printing company iJet and consumer 3D printing marketplace Shapeways, Speed 3D users can also have their virtual avatars printed into physical statues. Speed 3D currently employs 10 people at its Taiwan office and supports more than 1 million mobile users worldwide.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/speed-3d/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Speed3D","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Speed3D"}},"tags":[{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"customer-references#category#dev-and-test","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dev \u0026 Test","description":"Dev \u0026 Test","dateCreated":"2019-07-22T18:31:47+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"GLOBAL#location#taiwan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Taiwan","description":"Taiwan","dateCreated":"2020-02-03T05:29:38+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#comput