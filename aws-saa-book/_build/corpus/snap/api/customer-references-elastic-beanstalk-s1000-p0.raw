references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#pismo-video","locale":"en_US","directoryId":"customer-references","name":"pismo-video","dateCreated":"2023-06-01T23:07:49+0000","dateUpdated":"2023-06-08T04:07:43+0000","additionalFields":{"descriptionSummary":"A Pismo é uma startup de tecnologia que oferece uma plataforma completa de processamento de pagamentos e core bancário. A empresa, fundada em 2016, desenvolveu sua plataforma na nuvem AWS, criando uma solução que atendesse às necessidades dos clientes e que estivesse pronta para desenvolvimentos futuros. Foi com essa plataforma que a companhia consolidou sua atuação no Brasil, Chile, Peru, Colômbia e Argentina, chegando a mais de 25 milhões de contas processadas, um número que vem crescendo rapidamente. Agora, a Pismo inicia uma nova fase. Junto com a AWS, e com o time de AWS Professional Services, ela desenvolveu um projeto de distribuição multirregião que permite a implementação da plataforma e sua operação em qualquer país em que a AWS tenha presença. O projeto é a base da estratégia de expansão global da Pismo, que começou com a abertura de novos escritórios na Inglaterra e nos Estados Unidos.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/pismo-logo%402x.733a947094f1496f5b5db6037f45ec270d9cea88.png","displayLocation":"Brasil","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2021-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/pismo-video/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"História do cliente","customer-name":"Pismo Software and Consulting","headline":"Pismo aposta em expansão global com elasticidade da nuvem AWS"}},"tags":[{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNames