y","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#industry#cpg","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Consumer Packaged Goods (CPG)","description":"Consumer Packaged Goods (CPG)","dateCreated":"2020-06-25T04:03:18+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"}]},{"item":{"id":"customer-references#jumbo-cencosud","locale":"en_US","directoryId":"customer-references","name":"jumbo-cencosud","dateCreated":"2023-06-01T23:08:01+0000","dateUpdated":"2023-06-08T04:07:38+0000","additionalFields":{"descriptionSummary":"Cencosud, uno de los conglomerados de retail más grandes y prestigiosos de América Latina, diseñó una estrategia de e-commerce basada en una mejor utilización de los datos de sus clientes en beneficio el negocio. Así que, en diciembre de 2020, la institución empezó la implementación de Amazon Personalize en la tienda online de Supermercados Jumbo, logrando crecimiento de un 136% de CTR en los primeros meses. El retorno fue tan positivo que el grupo decidió implementar la solución en sus otras unidades de negocio.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/jumbo_cencosud_logo%401x.c768fc84c8a1ff5e3c9092b44b8