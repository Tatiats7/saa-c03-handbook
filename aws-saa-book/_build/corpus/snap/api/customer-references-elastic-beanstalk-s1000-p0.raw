anagement","dateCreated":"2020-06-05T07:06:41+0000","dateUpdated":"2022-02-03T03:31:02+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Mobile","description":"Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2023-08-22T20:28:38+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#elastic-beanstalk","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elastic Beanstalk","description":"AWS Elastic Beanstalk","dateCreated":"2020-03-02T07:03:00+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"customer-references#category#web-hosting","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Web Hosting","description":"Web Hosting","dateCreated":"2019-07-22T18:32:28+0000","dateUpdated":"2022-03-30T20:30:49+0000"},{"id":"customer-references#category#media-services","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Media Services","description":"Media Services","dateCreated":"2019-07-22T18:32:09+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#industry#semiconductors","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Semiconductors","description":"Semiconductors","dateCreated":"2020-08-31T04:01:50+0000","dateUpdated":"2022-02-03T03:32:07+0000"}]},{"item":{"id":"customer-references#aws-case-study-zillow-it","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-zillow-it","dateCreated":"2024-11-12T00:55:07+0000","dateUpdated":"2024-11-12T01:13:39+0000","additionalFields":{"descriptionSummary":"Ogni giorno, decine di milioni di compratori, venditori e locatari, oltre ad agenti immobiliari e amministratori, utilizzano il sito Web di Zillow per cercare appartamenti e abitazioni in vendita, scegliere il mutuo più conveniente e trovare informazioni su 110 milioni di case in tutti gli Stati Uniti.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/zillow-logo.a25e3499b7c4e729f1d0e36cd6005545b97ba985.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eZillow is the leading housing rental and real estate marketplace, used by tens of millions of home buyers, sellers, and renters. Zillow migrated its image-processing and delivery system to AWS to solve performance issues and gain scalability. As a result, the company improved user experience on its image-heavy websites, halved its content delivery network costs, and can now process more than 3 million images per day and serve up to 150,000 images per second.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/zillow/","customer-name":"Zillow","enableShare":"1","publishedDate":"2015","contentType":"Storia del cliente","headline":"Caso di studio Zillow"}},"tags":[{"id":"GLOBAL#language#italian","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Italian","description":"Italian","dateCreated":"2020-03-03T06:40:49+0000","dateUpdated":"2022-02-03T03:31:25+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated