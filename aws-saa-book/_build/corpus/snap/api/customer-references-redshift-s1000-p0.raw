ategory","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#location#canada","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Canada","description":"Canada","dateCreated":"2020-02-03T05:29:05+0000","dateUpdated":"2022-02-03T03:31:34+0000"}]},{"item":{"id":"customer-references#elevenia-case-study","locale":"en_US","directoryId":"customer-references","name":"elevenia-case-study","dateCreated":"2019-07-19T14:56:53+0000","dateUpdated":"2023-05-31T23:04:23+0000","additionalFields":{"featured":"0","descriptionSummary":"By building its business intelligence platform on the AWS Cloud, Elevenia has gained the agility required to run real-time analytics and saved nearly $20,000 in monthly fees. Elevenia is a leading customer-to-customer e-commerce site based in Indonesia.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Elevenia_Customer-Reference_Logo.931fd79a05a7aac1d9e63fb27cbdcf997d97df86.png","displayLocation":"Indonesia","footerInfoText":"Published Date","description":"\u003cp\u003eBy building its business intelligence (BI) platform on the AWS Cloud, Elevenia has gained the agility required to run real-time analytics and saved nearly $20,000 in monthly fees. Elevenia is a leading customer-to-customer (C2C) e-commerce site based in Indonesia. The company is using Amazon Elastic Container Service and AWS Fargate to automate deployment of containerized applications and Amazon Rekognition to improve image quality on its website.\u003c/p\u003e\r\n","industry":"Retail","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/elevenia/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Elevenia","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Elevenia Case Study"}},"tags":[{"id":"customer-references#category#containers","loca