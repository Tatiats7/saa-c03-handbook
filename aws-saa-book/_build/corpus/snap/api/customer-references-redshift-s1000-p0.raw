ocale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Elastic Load Balancing (ELB)","description":"Elastic Load Balancing (ELB)","dateCreated":"2020-03-02T07:03:09+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Internet of Things (IoT)","description":"Internet of Things (IoT)","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2023-08-22T20:28:39+0000"},{"id":"customer-references#category#iot","locale":"en_US","tagNamespaceId":"customer-references#category","name":"IoT","description":"IoT","dateCreated":"2019-07-22T18:32:05+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#industry#electronics","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Electronics","description":"Electronics","dateCreated":"2020-06-25T04:07:00+0000","dateUpdated":"2022-02-03T03:32:02+0000"},{"id":"GLOBAL#industry#semiconductors","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Semiconductors","description":"Semiconductors","dateCreated":"2020-08-31T04:01:50+0000","dateUpdated":"2022-02-03T03:32:07+0000"}]},{"item":{"id":"customer-references#aws-case-study-university-of-maryland-university-college","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-university-of-maryland-university-college","dateCreated":"2019-07-22T19:51:44+0000","dateUpdated":"2022-01-21T02:41:49+0000","additionalFields":{"featured":"0","descriptionSummary":"University of Maryland University College (UMUC) is an open-access university serving working adult students pursuing higher education through on-site and online courses. When its legacy applications were due for renewal, UMUC turned to AWS to build its new analytics platform and several administrative workloads. By using Amazon Redshift, UMUC improved its ETL performance by twentyfold, allowing it to build more accurate predictive models.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/UniversityofMarylandUniversityCollege_Customer-Reference_Logo.69b324e56ad79b9af9cc0d2a72ba767fbd0ad1d4.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eUniversity of Maryland University College (UMUC) is an open-access university serving working adult students pursuing higher education through on-site and online courses. When its legacy applications were due for renewal, UMUC turned to AWS to build its new analytics platform and several administrative workloads. By using Amazon Redshift, UMUC has improved its extract, transform, and load (ETL) performance by twentyfold allowing it to build more accurate predictive models.\u003c/p\u003e\r\n","industry":"Education","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/university-of-maryland-university-college/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"University of Maryland University College","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: University of Maryland University College"}},"tags":[{"id":"GLOBAL#use-case#archiving","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Archiving","description":"Archiving","dateCreated":"2020-06-05T06:36:56+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#use-case#data-lakes","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Data Lakes","description":"Data Lakes","dateCreated":"2020-06-05T06:37:09+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateC