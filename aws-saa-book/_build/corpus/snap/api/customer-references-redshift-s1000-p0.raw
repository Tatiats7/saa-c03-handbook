cs","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#category#data-lakes-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Data Lakes \u0026 Analytics","description":"Data Lakes \u0026 Analytics","dateCreated":"2019-07-22T18:31:39+0000","dateUpdated":"2022-02-07T13:55:55+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#aws-case-study-the-weather-company","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-the-weather-company","dateCreated":"2019-07-22T19:59:58+0000","dateUpdated":"2022-01-03T18:08:58+0000","additionalFields":{"featured":"0","descriptionSummary":"\u003cp\u003eThe Weather Company provides some of the world\u0026#39;s most accurate weather forecasts to hundreds of millions of users. Using AWS, the company redesigned its weather data platform and forecasting systems and can now deliver 15 billion forecasts per day for nearly 3 billion locations around the globe.\u003c/p\u003e\r\n","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/the-weather-company-logo.6ef2c9ec906eba057620df6db396ae5f553960fe.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eThe Weather Company provides some of the world\u0026#39;s most accurate weather forecasts to hundreds of millions of users. The company used AWS to redesign the IT infrastructure that supports its weather data platform and forecasting systems. As a result, its forecasting platform can support 10 to 15 billion API calls per day at a rate of 100,000 to 150,000 per second, depending on the weather.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/the-weather-company/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"The Weather Company","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: The Weather Company"}},"tags":[{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"202