","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#canada","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Canada","description":"Canada","dateCreated":"2020-02-03T05:29:05+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#swire-coca-cola-case-study","locale":"en_US","directoryId":"customer-references","name":"swire-coca-cola-case-study","dateCreated":"2020-05-12T19:17:47+0000","dateUpdated":"2023-07-19T03:04:58+0000","additionalFields":{"featured":"0","descriptionSummary":"After deciding on its strategy to pursue a cloud computing–based digital transformation, Swire Coca-Cola made another bold decision to close its three on-premises production and disaster recovery data centers and migrate all of its business systems, including SAP and its CRM, to AWS. Swire Coca-Cola, a division of Swire, has the exclusive right to manufacture, market, and distribute products of the Coca-Cola Company in 11 Chinese provinces, the Shanghai Municipality, Hong Kong, Taiwan, and also an extensive area of the western US—representing a total customer base of 728 million people.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/coca-cola-logo%401x.4c9be67ec52d063bf4c44c482d50900e4bad7129.png","displayLocation":"China","footerInfoText":"Published Date","industry":"Consumer G