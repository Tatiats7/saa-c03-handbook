-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#coca-cola-andina-case-study","locale":"en_US","directoryId":"customer-references","name":"coca-cola-andina-case-study","dateCreated":"2021-07-26T21:41:11+0000","dateUpdated":"2024-03-02T02:48:49+0000","additionalFields":{"descriptionSummary":"Coca Cola Andina is a Chilean capital company with more than 17,500 employees, dedicated to the production and marketing of beverages. It has the franchise to produce and market The Coca-Cola Company\u0027s products in regions of Argentina, Brazil, Chile, and the entire territory of Paraguay. It is one of the most important bottlers in Latin America, and is one of the seven largest Coca-Cola bottlers in the world. With more than 50 million inhabitants within its franchise, in 2020 it delivered more than 4,300 million liters of soft drinks, juices, waters and other beverages. True to its innovative nature, Andina continues to expand its product portfolio, marketing in recent years the Monster, Ades and Guallarauco brands, among others. For more information, visit www.koandina.com.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/coca-cola-logo%401x.4c9be67ec52d063bf4c44c482d50900e4bad7129.png","dis