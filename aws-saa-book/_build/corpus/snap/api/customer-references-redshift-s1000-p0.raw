nly English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#mod-io-case-study","locale":"en_US","directoryId":"customer-references","name":"mod-io-case-study","dateCreated":"2022-12-05T23:59:16+0000","dateUpdated":"2022-12-06T01:27:20+0000","additionalFields":{"descriptionSummary":"mod.io is an open middleware platform enabling gamers to modify (mod) existing games with user generated content. To support rapid growth and reduce its manual infrastructure burden, mod.io migrated to AWS.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/modio_logo%401x.17d45e505c6a16d420b006bc2e2e882e012533e8.png","displayLocation":"Australia","customerNameLower":"mod.io","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2022-12-05","headlineUrl":"https://aws.amazon.com/solutions/case-studies/mod-io-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"mod.io","publishedDate":"2022","enableShare":"1","headline":"mod.io Provides Low Latency Gamer Experience Globally on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#elastic-beanstalk","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elastic Beanstalk","description":"AWS Elastic Beanstalk","dateCreated":"2020-03-02T07:03:00+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceI