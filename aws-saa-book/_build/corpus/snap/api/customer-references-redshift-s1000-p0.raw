00","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"}]},{"item":{"id":"customer-references#pga-tour-ecs-case-study","locale":"en_US","directoryId":"customer-references","name":"pga-tour-ecs-case-study","dateCreated":"2024-07-26T11:33:45+0000","dateUpdated":"2024-10-11T23:13:23+0000","additionalFields":{"descriptionSummary":"The PGA TOUR introduced Win, Cut Probability, a novel ML-powered analytics model that provides real-time insights into the likelihood of outcomes during tournaments. Powered by AWS, advanced data analytics, cloud infrastructure, and serverless services, the Win, Cut Probability model measures a player’s chances of advancing in and winning a tournament. Using Amazon Elastic Container Service (ECS) with AWS Fargate to run thousands of simulations and process nearly four billion records, the PGA TOUR can take advantage AWS’s elasticity, run their model quickly and scale as needed, while offloading the operational overhead of infrastructure management to AWS.","featureImageURL":"https://d1.awsstatic.com/awsih_card_img-pga_tour.b894c1d7fcbb7545618c04bc5614f5b27b1c9295.jpg","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/pga-tour_logo%401x.7cd90a3105fd3bb8452fda2f46959d7255c02368.png","displayLocation":"Americas","customerNameLower":"pga tour","footerInfoText":"Published Date","description":"\u003cp\u003eProviding real-time insights to its audience and creating an immersive viewing experience.\u003c/p\u003e\n","industry":"Media \u0026 Entertainment","sortDate":"2024-07-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/pga-tour-ecs-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"PGA Tour","publishedDate":"2024","enableShare":"1","headline":"PGA 