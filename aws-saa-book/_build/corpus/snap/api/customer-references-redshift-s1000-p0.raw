ocation","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#industry#life-sciences","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Life Sciences","description":"Life Sciences","dateCreated":"2020-01-16T17:42:31+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#location#ukir","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"UK/IR","description":"UK/IR","dateCreated":"2020-02-19T23:06:44+0000","dateUpdated":"2022-02-03T03:31:51+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"customer-references#innovator#siemens","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Siemens","description":"Siemens","dateCreated":"2022-04-25T19:06:51+0000","dateUpdated":"2022-07-16T00:04:48+0000"}]},{"item":{"id":"customer-references#aws-case-study-robinhood","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-robinhood","dateCreated":"2019-07-22T19:45:30+0000","dateUpdated":"2021-12-22T19:48:34+0000","additionalFields":{"descriptionSummary":"Robinhood’s lean staff, including just two DevOps people, used AWS to create a massively scalable securities trading app with strong built-in security and compliance features that supported hundreds of thousands of users at launch. Robinhood is a startup offering no-fee securities trading.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Robinhood_Customer-Reference_Logo.de190cac21a03a567711f02cd5f69f5c8b1a4aa0.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"Robinhood?s lean staff, including just two DevOps people, used AWS to create a massively scalable securities trading app with strong built-in security and compliance features that supported hundreds of thousands of users at launch. Robinhood is a startup offering no-fee securities trading. The company uses AWS to operate its online business, deliver and update its mobile trading app, securely store customer information and trading data, and perform business analytics.","industry":"Financial Services","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/robinhood/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Robinhood","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"AWS Case Study: Robinhood"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","date