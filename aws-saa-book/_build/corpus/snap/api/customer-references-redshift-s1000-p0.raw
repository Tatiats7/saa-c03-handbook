.com/solutions/case-studies/careem-dynamodb-case-study?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Careem","publishedDate":"2023","enableShare":"1","headline":"Careem Scales to 50M+ Customers Using AWS Database Services","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#uae","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United Arab Emirates","description":"United Arab Emirates","dateCreated":"2020-02-03T05:30:23+0000","dateUpdated":"2022-02-03T03:31:56+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#middle-east","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East","description":"Middle East","dateCreated":"2020-04-09T03:53:16+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"customer-references#category#databases","