0"}]},{"item":{"id":"customer-references#globe-telecom-cadenz","locale":"en_US","directoryId":"customer-references","name":"globe-telecom-cadenz","dateCreated":"2021-04-24T00:03:38+0000","dateUpdated":"2024-03-02T02:48:48+0000","additionalFields":{"descriptionSummary":"Globe Telecom wanted an in-depth understanding of its customers to provide them with a more personalized experience, and built a customer intelligence platform. Using Amazon Kinesis and Amazon SageMaker, Globe can now collect and process real-time customer data at scale, as well as onboard, infer, and compute over 40 user attributes monthly to provide a 360-view of its customers.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(@1x---@2x)/Globe_Telecom_logo@1x.5eb956c7d3468fd4cfe87e2f7a3926f66be18fb9.png","displayLocation":"Philippines","footerInfoText":"Published Date","industry":"Telecommunications","sortDate":"2021-04-23","headlineUrl":"https://aws.amazon.com/solutions/case-studies/globe-telecom-cadenz/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Globe Telecom","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Globe Telecom Develops A 360-Degree Customer View Using AWS"}},"tags":[{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#apac","locale":"en_US",