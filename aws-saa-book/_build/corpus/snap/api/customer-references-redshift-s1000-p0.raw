. The company, a growing Canadian regional airline based in Ontario, runs its customer-facing website and other critical business applications on the AWS Cloud.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/PorterAirlines_Customer-Reference_Logo.7aa89701ec883b7f384201f2d40670cf1549da4c.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003ePorter Airlines relies on AWS to ensure high availability and reliability for millions of monthly website visitors, to scale to support a fourfold spike in site traffic, and to improve its data analytics and disaster-recovery capabilities.\u003c/p\u003e\r\n","industry":"Travel \u0026 Hospitality","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/porter-airlines/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Porter Airlines","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Porter Airlines Case Study"}},"tags":[{"id":"customer-references#category#dev-and-test","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dev \u0026 Test","description":"Dev \u0026 Test","dateCreated":"2019-07-22T18:31:47+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"cus