5:33+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"customer-references#big-rocks#aws-for-data","locale":"en_US","tagNamespaceId":"customer-references#big-rocks","name":"AWS for Data","description":"\u003cp\u003eAWS for Data is a marketing \u0026ldquo;Big Rock\u0026rdquo; initiative that tells the story around how AWS can provide the most comprehensive set of data capabilities spanning databases, analytics, business intelligence, and machine learning for an end-to-end data strategy.\u003c/p\u003e\n","dateCreated":"2024-02-14T22:32:15+0000","dateUpdated":"2024-02-14T22:32:15+0000"}]},{"item":{"id":"customer-references#engie-2022-aws-reinvent-video-it","locale":"en_US","directoryId":"customer-references","name":"engie-2022-aws-reinvent-video-it","dateCreated":"2024-09-18T20:03:09+0000","dateUpdated":"2024-09-18T20:08:10+0000","additionalFields":{"descriptionSummary":"Sviluppata utilizzando tecnologie AWS come Amazon S3, Amazon Redshift, AWS Glue e Amazon SageMaker, ENGIE aiuta le città, come Barcellona, a ridurre il consumo energetico fino al 15%. Inoltre, la capacità di aumentare la scalabilità dell\u0027infrastruttura aziendale durante gli orari di picco e ridurla durante le ore meno attive, consente a ENGIE di risparmiare il 60% dei costi di runtime del cloud.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Engie_Logo@1x.0c113ddc2f31b59cf84d5b3d7dfdfef6570f1331.png","displayLocation":"Stati Uniti","customerNameLower":"engie","footerInfoText":"Data di pubblicazione","industry":"Energia","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/engie-2022-aws-reinvent-video/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ENGIE","enableShare":"1","publishedDate":"2022","contentType":"Storia del cliente","headline":"ENGIE crea piattaforme digitali per accelerare la transizione energetica a zero emissioni di carbonio, alimentate da AWS"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000"