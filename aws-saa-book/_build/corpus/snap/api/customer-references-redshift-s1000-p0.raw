2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#rekognition","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Rekognition","description":"Amazon Rekognition","dateCreated":"2020-03-02T07:05:04+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"}]},{"item":{"id":"customer-references#bmw-data-protection","locale":"en_US","directoryId":"customer-references","name":"bmw-data-protection","dateCreated":"2024-09-18T20:04:25+0000","dateUpdated":"2024-09-18T20:08:08+0000","additionalFields":{"descriptionSummary":"Die BMW Group und AWS (Amazon Web Services) gaben heute eine strategische Zusammenarbeit bekannt, bei der die Unternehmen gemeinsam innovative Cloud-Technologien entwickeln werden, um das Datenpotenzial künftiger Fahrzeuggenerationen optimal zu nutzen. Die beiden Unternehmen arbeiten auch zusammen, um kommerzielle Standard-Cloud-Lösungen für die sichere Verwaltung von Fahrzeugdaten zu entwickeln. Die Zusammenarbeit ist eine Fortsetzung der 2015 begonnenen Zusammenarbeit der beiden Unternehmen im Bereich vernetzter Fahrzeuge. Wie bei allen bisherigen Kooperationen behält die BMW Group die volle und ausschließliche Kontrolle über die Daten und hält sich an die in den jeweiligen Märkten geltenden Datenschutzbestimmungen.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/BMWGroup_logo_200x70_1X.3445718b3f949f158f9e3cac77d3ee79d4767a7f.jpg","displayLocation":"Deutschland","customerNameLower":"bmw group","industry":"Automobilbranche","sortDate":"2023-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/bmw-data-protection?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2023","contentType":"Kundengeschichte","customer-name":"BMW Group","headline":"Die BMW Group arbeitet mit AWS zusammen, um neue Cloud-Technologien für die schnelle und zuverlässige Verfügbarkeit von digitalen Innovationen bereitzustellen."}},"tags":[{"id":"GLOBAL#location#dach","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"DACH","description":"DACH","dateCreated":"2020-02-03T05:29:52+0000","dateUpdated":"2022-02-03T03:31:47+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"customer-references#category#backup-restore","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Backup \u0026 Restore","description":"Backup \u0026 Restore","dateCreated":"2019-07-22T18:31:01+0000","dateUpdated":"2022-04-09T03:06:56+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 C