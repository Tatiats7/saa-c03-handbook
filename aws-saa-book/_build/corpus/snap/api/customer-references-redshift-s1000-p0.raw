ed to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#ravenpack-case-study","locale":"en_US","directoryId":"customer-references","name":"ravenpack-case-study","dateCreated":"2024-08-16T21:59:40+0000","dateUpdated":"2024-08-16T22:08:05+0000","additionalFields":{"descriptionSummary":"RavenPack improves the efficiency of big data querying for financial services clients, helping them make better decisions. The company provides news and text analytics services to organizations such as hedge funds and banks. It uses interactive serverless query service Amazon Athena to run customers’ analytics requests.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/EMEA/IBERIA/RavenPack.2806a5013b559792241a449ee99244420aa71fd1.png","displayLocation":"Spain","customerNameLower":"ravenpack","footerInfoText":"Published Date","industry":"Digital Marketing","sortDate":"2020-03-06","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ravenpack-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"RavenPack","publishedDate":"2020","enableShare":"1","headline":"RavenPack Shifts Analytics Service up a Gear with Amazon Athena","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#industry#digital-marketing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Digital Marketing","description":"Digital Marketing","dateCreated":"2020-01-16T17:42:16+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#produc