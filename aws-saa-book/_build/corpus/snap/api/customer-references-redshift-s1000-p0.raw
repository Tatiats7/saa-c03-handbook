{"item":{"id":"customer-references#aws-is-how-ge-renewable-energy-increases-wind-energy-production","locale":"en_US","directoryId":"customer-references","name":"aws-is-how-ge-renewable-energy-increases-wind-energy-production","dateCreated":"2021-07-02T00:57:57+0000","dateUpdated":"2023-07-19T03:05:05+0000","additionalFields":{"descriptionSummary":"Using AWS services, GE Renewable Energy has created a data lake where it collects and analyzes machine data captured at GE wind turbines around the world. GE relies on Amazon Simple Storage Service (Amazon S3) to store and protect its ever-expanding collection of wind turbine data and Amazon Redshift to help GE gain new insights from the data it collects.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/GEPower_Customer-Reference_Logo.7100af15f7461bdc2ea9edec4f9b61e536c54f48.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Power \u0026 Utilities","sortDate":"2021-07-01","headlineUrl":"https://aws.amazon.com/blogs/industries/aws-is-how-ge-renewable-energy-increases-wind-energy-production/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"GE Appliances","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"AWS is How: GE Renewable Energy Increases Wind Energy Production"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#power-utilities","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Power \u0026 Utilities","description":"Power \u002