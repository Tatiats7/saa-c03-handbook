},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#despegar2","locale":"en_US","directoryId":"customer-references","name":"despegar2","dateCreated":"2023-06-01T23:08:47+0000","dateUpdated":"2023-07-12T01:35:41+0000","additionalFields":{"descriptionSummary":"Hace dos años Despegar tenía su arquitectura consolidada y orientada a microservicios, cada uno de ellos con su propia base de datos. Como resultado, la compañía llegó a tener más de 120 Cassandras instaladas, más de 80 MySQL, 70 MongoDBs y más de 40 elasticsearch (Amazon ES). Con esa estructura, los analistas no podían analizar los datos de un solo lugar y racional. Así que Despegar eligió las soluciones de AWS como base para montar su estructura de data lake. Hoy la compañía logra transferir un montón de datos todas las noches de sus máquinas a las máquinas de AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/despegar_logo%401x.f06fcbe7cb92dd6b0c694618b96b151199270f96.png","displayLocation":"Argentina","footerInfoText":"Fecha de publicación","industry":"Viajes","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/despegar2/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","customer-name":"Despegar","contentType":"Historia del cliente","headline":"Despegar cuenta con AWS para construir su data lake"}},"tags":[{"id":"GLOBAL#customer-enablement#business-support","locale":"en_US","tagNamespaceId":"GLOBAL#customer-enablement","name":"AWS Business Support","description":"AWS Business Support","dateCreated":"2020-09-04T04:06:24+0000","dateUpdated":"2022-02-03T03:31:13+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#customer-enablement#support","locale":"en_US","tagNamespaceId":"GLOBAL#customer-enablement","name":"AWS Support","description":"AWS Support","dateCreated":"2020-09-04T04:06:22+0000","dateUpdated":"2022-02-03T03:31:12+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000",