:"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#elb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Elastic Load Balancing (ELB)","description":"Elastic Load Balancing (ELB)","dateCreated":"2020-03-02T07:03:09+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#category#infrastructure","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Infrastructure","description":"Infrastructure","dateCreated":"2019-07-22T18:32:04+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-next-media","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-next-media","dateCreated":"2019-07-22T19:53:56+0000","dateUpdated":"2023-07-14T23:32:47+0000","additionalFields":{"featured":"0","descriptionSummary":"Next Media is a media, entertainment, and gaming services business with annual revenues of HK$3 billion. The company runs its Hong Kong news and entertainment websites and mobile applications on AWS. Using AWS enables Next Media to launch new applications in half the time without increasing operating costs while eliminating the need to purchase up to 50 new servers.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/next-media-logo.1fa0c209a07c67dff121b23140f481eebe342aa2.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","description":"\u003cp\u003eNext Media is a media, entertainment, and gaming services business with annual revenues of HK$3 billion. The company is running its Hong Kong news and entertainment websites and mobile applications in AWS. Moving to AWS has enabled Next Media to launch new applications in half the time at existing operating cost levels while eliminating the need to purchase up to 50 new servers.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/next-media/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Next Media","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Ca