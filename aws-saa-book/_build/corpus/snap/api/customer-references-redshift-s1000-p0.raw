,"dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#product#codebuild","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodeBuild","description":"AWS CodeBuild","dateCreated":"2020-03-02T07:02:08+0000","dateUpdated":"2022-02-03T03:32:24+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#mercado-libre-es","locale":"en_US","directoryId":"customer-references","name":"mercado-libre-es","dateCreated":"2023-06-01T23:10:44+0000","dateUpdated":"2023-08-11T00:24:46+0000","additionalFields":{"descriptionSummary":"Con una población de más de 650 millones de personas, Latinoamérica está siendo testigo de uno de los mayores crecimientos de la adopción de Internet del mundo. Desde su creación en 1999, Mercado Libre ha aprovechado este crecimiento para convertirse en la empresa más grande de comercio electrónico y pagos de Latinoamérica. Mercado Libre opera en 18 países con más de 76 millones de usuarios activos en el trimestre que terminó en Junio 2021. El Marketplace de Mercado Libre cuenta con más de 5.000 vendedores afuera de Latinoamérica que por lo general operan en Inglés.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/r2018/r/seer/customers/600x400_Mercado-Libre_Horizontal_Logo.591869641e3359d8ad7c938d4413445babdacda7.png","displayLocation":"Argentina","footerInfoText":"Fecha de publicación","industry":"Venta al por menor","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/mercado-libre-es/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Mercado Libre (Mercado Livre)","enableShare":"1","publishedDate":"2021","contentType":"Historia del cliente","headline":"Mercado Libre logra traducciones precisas y automáticas a escala utilizandotranslate"}},"tags":[{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespac