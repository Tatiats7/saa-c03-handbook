n":"Energy","dateCreated":"2020-07-15T21:58:51+0000","dateUpdated":"2022-02-03T03:32:02+0000"},{"id":"GLOBAL#industry#oil-gas","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Oil \u0026 Gas","description":"Oil \u0026 Gas","dateCreated":"2020-01-16T17:42:36+0000","dateUpdated":"2022-02-03T03:32:07+0000"}]},{"item":{"id":"customer-references#mcredit-case-study","locale":"en_US","directoryId":"customer-references","name":"mcredit-case-study","dateCreated":"2021-09-11T00:48:09+0000","dateUpdated":"2022-12-19T23:24:29+0000","additionalFields":{"descriptionSummary":"Mcredit migrated from an on-premises infrastructure to AWS to gain agility and boost automation as part of a renewed digital strategy, lowering its time to market from four months to three weeks. The FinTech firm is a joint venture between Vietnam-based Military Bank and Japan-based Shinsei Bank. The company is using Amazon EKS to orchestrate its fully containerized infrastructure, Amazon Redshift as a data warehouse, and Amazon Direct Connect for secure networking.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Mcredit_logo%401x.d13bb24e8cc3f8572c54bbed0b92a679966e2fb5.png","displayLocation":"Vietnam","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2021-09-10","headlineUrl":"https://aws.amazon.com/solutions/case-studies/mcredit-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Mcredit","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Mcredit Offers an Omnichannel Banking Experience with Data-Driven Transformation on AWS"}},"tags":[{"id":"customer-references#category#finserv","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Financial Services","description":"Financial Services","dateCreated":"2019-07-22T18:31:53+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tag