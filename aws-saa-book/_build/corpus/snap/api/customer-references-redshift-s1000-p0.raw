eUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#reference-arch-diagram","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Reference Architecture Diagram","description":"Reference Architecture Diagram","dateCreated":"2020-04-29T05:19:31+0000","dateUpdated":"2022-02-03T03:31:09+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#indexima-2022","locale":"en_US","directoryId":"customer-references","name":"indexima-2022","dateCreated":"2024-08-14T20:33:45+0000","dateUpdated":"2024-08-14T20:40:29+0000","additionalFields":{"descriptionSummary":"Arrivée en 2016, sur le marché très concurrentiel du traitement de la donnée, la jeune startup française a réussi à séduire les plus grands groupes comme Mappy, Natixis, Crédit Agricole Assurance, la MGEN ou encore la Caisse des dépôts. Une prouesse réalisée grâce à la promesse d’accélérer le traitement des requêtes au sein des tableaux de bord d’un facteur fois 1000 et diviser par deux ou trois le coût de création d’un projet de dataviz et le coût d’infrastructure de la donnée.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/partner-network/partner_marketing_web_team/300x50_Indexima.4e489ecb7ee6c233d68247b13fdbbd7ad89f2af5.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"indexima","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-04-03","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/indexima/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Indexima","publishedDate":"2022","enableShare":"1","headline":"Indexima divise par deux le coût des infrastructures cloud et dataviz dans le cloud AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#language#french","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"French","description":"French","dateCreated":"2020-03-03T06:40:44+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#tech-category#containers","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Containers","description":"Containers","dateCreated":"2020-02-13T00:27:17+0000","dateUpdated":"2022-02-03T03:35:26+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"}]},{"item":{"id":"customer-references#toyota03292022sldkfgsghsef","locale":"en_US","directoryId":"customer-references","name":"toyota03292022sldkfgsghsef","dateCreated":"2022-05-23T21:43:28+0000","dateUpdated":"2023-07-20T21:56:25+0000","additionalFields":{"descriptionSummary":"Toyota manufactures and distributes cars worldwide that are meticulously logged in vehicle data warehouses and data marts to provide insights on service checks and sales reports. Toyota migrated and modernized its on-premises vehicle data warehouse and data marts by leveraging a Lake House architecture on AWS. Data is securely migrated from the source systems on-premises to AWS using AWS Direct Connect and ingested in data integration tools running on Amazon EC2 such as Kafka, Talend, and Databricks. Data is pushed into different layers for transformation with Amazon S3, AWS Glue, and Amazon RDS. To obtain read-optimized data, data is ingested into Amazon Redshift. Amazon Redshift Spectrum and Amazon Athena are leveraged by Toyota\u0027s Data Scientists, Analysts, and Business user teams to produce self-service reports. With this Lake House architecture, Toyota has improved their time to market and eliminated the duplication of data.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/toyota-logo%401x.c83b34d7e548358fef55603b0869cee53cc6a4b0.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2022-03-29","headlineUrl":"https://youtu.be/Kp51k6LY-2c?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Toyota Motor North America","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Toyota Motor NA: Lake House Architecture for Data and Analytics"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#te