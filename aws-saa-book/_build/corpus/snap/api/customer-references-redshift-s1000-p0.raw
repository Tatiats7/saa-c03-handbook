lds":{"descriptionSummary":"Together Credit Union aims to set itself apart by creating exceptional experiences for its members, which is a crucial differentiator against large banks and agile fintech startups. However, it relied on time-consuming processes for data collection and analysis, which prevented its branch managers from making fast, informed decisions.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Together-Credit-Union-Logo_imagefull.dfa3a1e9f92f7f9b7fa58cd30d5610ab86ed7811.png","displayLocation":"United States","customerNameLower":"together credit union","footerInfoText":"Published Date","industry":"Financial Services","headlineUrl":"https://aws.amazon.com/solutions/case-studies/together-credit-union-centralized-data-lake-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","customer-name":"Together Credit Union","headline":"Transforming the Member Experience Using Amazon Redshift with Together Credit Union","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#detective","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Detective","description":"Amazon Detective","dateCreated":"2020-12-08T20:20:30+0000","dateUpdated":"2022-02-03T03:32:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#