"dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#category#data-lakes-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Data Lakes \u0026 Analytics","description":"Data Lakes \u0026 Analytics","dateCreated":"2019-07-22T18:31:39+0000","dateUpdated":"2022-02-07T13:55:55+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#aws-case-study-scopely","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-scopely","dateCreated":"2019-07-22T19:57:08+0000","dateUpdated":"2023-07-14T23:32:42+0000","additionalFields":{"featured":"0","descriptionSummary":"Scopely, based in Los Angeles, California, powers mobile, social gaming applications with sophisticated background analytics. To meet its performance objectives, the company turned to AWS and created architecture able to scale reliably from zero to millions of concurrent users.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Scopely_Customer-Reference_Logo.6deeacc0c068e4a619736fe9e6e88368d24766dc.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eScopely is an 80-person start-up, based in Los Angeles, CA, that develops mobile, social gaming applications. The company needed a technical architecture that could scale reliably from zero to millions of concurrent users. By running on AWS, the company can scale its gaming platform to handle traffic that can spike from hundreds to millions of users a day in hours, with little or no operational resources.\u003c/p\u003e\r\n","industry":"Gaming","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/scopely/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Scopely","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Scopely"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-peak-games","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-peak-games","dateCreated":"2019-07-22T19:54:07+0000","dateUpdated":"2023-07-14T23:32:47+0000","additionalFields":{"featured":"0","descriptionSummary":"Based in Turkey, gaming company Peak Games has 30 million monthly active players across Turkey, Middle East, and North Africa. By using AWS, the company has lowered provisioning time from 4-6 hours to 10 minutes, and reduced operational costs.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/PeakGames_Customer-Reference_Logo.ea8c0c4012e1af65c10672562825bc03a8812b21.png","displayLocation":"Turkey","footerInfoText":"Published Date","description":"\u003cp\u003ePeak Games is the leading and rapidly growing online and mobile gaming company focused on creating and publishing games that fit the unique interests and cultures of Turkey, Middle East, and North Africa regions. Today, Peak Games unites 30 million monthly unique players with free, culturally relevant, community-driven games. The company?s Plus Studio, which has nearly 300,000 concurrent users, builds digital renditions of traditional and popular board, card, and table-top games; its War of Mercenaries reaches millions of mid-core gamers across different platforms. By using AWS, Peak Games reduced provisioning time from 4-6 hours to 10 minutes, lowered their operational costs by 15%. In addition, Peak games reduced time to market by 75% and experienced near 100% availability for simultaneous gaming by millions of users.\u003c/p\u003e\r\n","industry":"Gaming","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/peak-games/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Peak Games","enableShare":"1","publishedDate":"2014","con