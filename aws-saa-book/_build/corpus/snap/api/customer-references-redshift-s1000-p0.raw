loper-tools","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Developer Tools","description":"\u003cp\u003eHost code, build, test, and deploy your applications quickly and effectively with AWS developer tools. Leverage core tools like software development kits (SDKs), code editors, and continuous integration and delivery (CI/CD) services for DevOps software development. Use machine learning (ML) -guided best practices and abstractions to improve agility, security, velocity, and code quality.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:14:12+0000","dateUpdated":"2023-07-14T01:14:12+0000"}]},{"item":{"id":"customer-references#ralali-case-study","locale":"en_US","directoryId":"customer-references","name":"ralali-case-study","dateCreated":"2020-05-21T17:51:46+0000","dateUpdated":"2022-12-19T23:23:57+0000","additionalFields":{"descriptionSummary":"Since using AWS, Ralali.com has been able to grow its BIG Agent business from 400 agents to over 100 thousand agents in a year, with only a small fraction of infrastructure cost, innovate and start new projects less than 3 days, scale quickly to provide highly available services for their end users.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Ralali_Customer-Reference_Logo.c857de5ec7afd355d1233a5a3623e0d59197baf7.png","displayLocation":"Indonesia","footerInfoText":"Published Date","industry":"Retail","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ralali/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ralali.com","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"How Ralali.Com Scales and Grows Exponentially With AWS"}},"tags":[{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000