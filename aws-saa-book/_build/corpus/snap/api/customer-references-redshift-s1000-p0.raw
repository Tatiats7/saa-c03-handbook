07T13:55:54+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#location#ssa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Sub-Saharan Africa","description":"Sub-Saharan Africa","dateCreated":"2020-03-10T05:18:06+0000","dateUpdated":"2022-02-03T03:31:58+0000"}]},{"item":{"id":"customer-references#interbank-peru","locale":"en_US","directoryId":"customer-references","name":"interbank-peru","dateCreated":"2023-06-01T23:11:06+0000","dateUpdated":"2023-06-08T04:07:34+0000","additionalFields":{"descriptionSummary":"Interbank, una de las instituciones financieras más importantes de Perú, necesitaba una plataforma analítica tecnológica flexible que le permita llevar experiencias personalizadas a sus clientes para acompañar a los peruanos a alcanzar sus sueños. En el 2018, el banco eligió a AWS para apoyar su estrategia de implementación de soluciones analíticas. Maru Leguizamon, Chief Data Officer y gerente central de segmentos y marketing analítico de Interbank, explica cómo la institución utiliza soluciones de Amazon Web Services, al equipo de AWS Professional Services y el soporte del partner Morris y Opazo. cuenta que con las soluciones implementadas Interbank logró un incremento del 35% en los desembolsos de lo que venía obteniendo, y la reducción de un 50% en los tiempos de ejecución de modelos. En este vídeo, la CDO detalla esos y otros beneficios, y nos cuenta los planes futuros de Interbank con AWS.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/interbank-logo%402x.bfef157b2e508291e85f1768731c2c25a1756689.png","displayLocation":"Perú","footerInfoText":"Fecha de publicación","industry":"Servicios financieros","sortDate":"2021-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/interbank-peru/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"Historia del cliente","customer-name":"Interbank","headline":"Cómo soluciones analíticas permiten llevar experiencias personalizadas a los clientes de Interbank"}},"tags":[{"id":"customer-references#category#database-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Database Migration","description":"Database Migration","dateCreated":"2019-07-22T18:31:40+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-categor