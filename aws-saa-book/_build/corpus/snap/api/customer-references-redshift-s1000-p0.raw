 die BVG-Mobilitäts-App Jelbi auf den Markt gebracht, um Fahrgästen eine zentrale Anlaufstelle für Mobilität zu bieten.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/berliner-verkehrsbetriebe-bvg-logo%401x.f500ccca67b76a64f138737b494d27d300fc97c1.png","displayLocation":"Deutschland","customerNameLower":"berliner verkehrsbetriebe","industry":"Reise","sortDate":"2023-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/berliner-verkehrsbetriebe-aws-is-how?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2023","contentType":"Kundengeschichte","customer-name":"Berliner Verkehrsbetriebe","headline":"Die Berliner Verkehrsbetriebe (BVG) richten auf AWS einen maßgeschneiderten Mobilitätsshop ein"}},"tags":[{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#emea","