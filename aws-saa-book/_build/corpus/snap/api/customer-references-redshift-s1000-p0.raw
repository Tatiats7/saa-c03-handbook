m":{"id":"customer-references#securionpay-case-study","locale":"en_US","directoryId":"customer-references","name":"securionpay-case-study","dateCreated":"2022-10-31T22:33:50+0000","dateUpdated":"2022-10-31T22:41:41+0000","additionalFields":{"descriptionSummary":"SecurionPay facilitates complex payments for global merchants regardless of whether the businesses are low or high-risk. A reliable, secure, and scalable platform ensures the flawless processing of millions of transactions. Being backed up by AWS, SecurionPay has scaled to meet 300 percent business growth, improved customers\u0027 sales by 19 percent, and used data analytics to support smarter business decisions.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/securionpay-logo%401x.294f66380dd6b9e3fee23b98fb8f6dfb1d38bad4.png","displayLocation":"Central \u0026 Eastern Europe","customerNameLower":"securionpay","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-10-31","headlineUrl":"https://aws.amazon.com/solutions/case-studies/SecurionPay-Case-Study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"SecurionPay","publishedDate":"2022","enableShare":"1","headline":"SecurionPay Manages Complex Online Payments, Scales to 300% Growth Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#quicksight","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon QuickSight","description":"Amazon QuickSight","dateCreated":"2020-03-02T07:04:56+0000","dateUpdated":"2022-02-03T03:32:55+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","da