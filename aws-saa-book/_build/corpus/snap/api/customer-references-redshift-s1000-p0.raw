le":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#fraud-detector","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Fraud Detector","description":"Amazon Fraud Detector","dateCreated":"2020-12-08T20:11:57+0000","dateUpdated":"2022-02-03T03:32:37+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#88i","locale":"en_US","directoryId":"customer-references","name":"88i","dateCreated":"2023-06-01T23:10:19+0000","dateUpdated":"2023-06-08T04:07:39+0000","additionalFields":{"descriptionSummary":"A 88i é a primeira seguradora digital focada em ecossistemas massivos digitais. Fundada há menos de dois anos, a empresa modernizou e digitalizou todo o processo de seguros, da cotação ao momento da liquidação ou pagamento ao cliente, para trazer ao mercado soluções capazes de simplificar os processos e levar seguros também para a população desbancarizada. Neste vídeo, os idealizadores da 88i explicam como o uso dos serviços Amazon Web Services viabilizou o negócio da startup e, mais do que isso, lhe permitiu focar o budget especificamente na parte criativa, de desenvolvimento e de disponibilização de novos recursos para os clientes. Além disso, contam que conseguiram, com o suporte da BRLink e da Darede, ambas empresas parceiras AWS, colocar em prática a sua premissa de ser o mais serverless possível para levar os melhores serviços, mais rapidamente, para os clientes.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/88i-logo%402x.3c0dd63967da6cab75bf90f05d8a44bd63a795fb.png","displayLocation":"Brasil","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2021-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/88i/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"História do cliente","customer-name":"88i","headline":"88i aposta na tecnologia AWS para brigar com grandes seguradoras"}},"tags":[{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"customer-references#c