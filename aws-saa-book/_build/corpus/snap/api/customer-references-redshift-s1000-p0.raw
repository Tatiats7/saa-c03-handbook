erences","name":"lambdatest-case-study","dateCreated":"2023-05-19T23:53:39+0000","dateUpdated":"2024-02-20T22:25:53+0000","additionalFields":{"descriptionSummary":"LambdaTest is a cloud-based continuous quality testing platform that helps over 2 million developers and testers across 130+ countries ship code faster. To give customers quicker, better insights into software test results, the company worked with AWS Data Lab to build a new analytical dashboard solution on Amazon Redshift.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/LambdaTest_logo%401x.c451ac7b085b149870e1fb886a3eb3586c7195cb.png","displayLocation":"India","customerNameLower":"lambdatest","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/lambdatest-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Lambdatest","publishedDate":"2023","enableShare":"1","headline":"LambdaTest Reduces Response Time by 33% Using Amazon RedShift","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"}]},{"item":{"id":"customer-references#too-good-to-go-case-study","locale":"en_US","directoryId":"customer-references","name":"too-good-to-go-case-study","dateCreated":"2024-02-17T00:42:31+0000","dateUpdated":"2024-08-13T14:59:19+0000","additionalFields":{"descriptionSummary":"Every year, around $1 trillion worth of edible food gets thrown away, while 828 million people are affected by hunger every day. And by some reports, wasted food represents up to 10 percent of all human-caused greenhouse gas emissions. Too Good To Go seeks to inspire and empower everyone to fight food waste together through a service with which users can save unsold food at their favorite restaurants and stores.","featured":"0","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/too-good-to-go-logo%401x.c3c4e672e354198bc93e7898fe585619d3525831.png","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/too-good-to-go-logo%401x.c3c4e672e354198bc93e7898fe585619d3525831.png","displayLocation":"Denmark","customerNameLower":"too good to go","footerInfoText":"Published Date","industry":"Hospitality","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/too-good-to-go-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Too Good To Go","publishedDate":"2023","enableShare":"1","headline":"Saving 250 Million Meals from Waste Using AWS Managed Services with Too Good To Go","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#location#nordics","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Nordics","description":"Nordics","dateCreated":"2020-02-03T05:30:04+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#location#denmark","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Denmark","description":"Denmark","dateCreated":"2020-02-03T05:30:06+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-0