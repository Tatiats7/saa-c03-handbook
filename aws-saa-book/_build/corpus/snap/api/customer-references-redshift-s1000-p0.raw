vices including Amazon EC2, Elastic Load Balancing, Amazon EBS, and Amazon ElastiCache to support its global POS system, including 200,000 registers and 300,000 POS devices.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/McDonalds_Customer-Reference_Logo.8197f6c1344756e2051566dbaa8a463bbc552030.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the McDonalds customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Travel \u0026 Hospitality","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/mcdonalds/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"McDonalds","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"McDonalds Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+