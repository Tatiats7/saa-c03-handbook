0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-mediatek","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-mediatek","dateCreated":"2019-07-22T19:53:12+0000","dateUpdated":"2023-09-21T00:18:58+0000","additionalFields":{"featured":"0","descriptionSummary":"MediaTek designs and develops silicon wafers for wireless communications and digital multimedia solutions. The Taiwan-based company uses AWS to deploy its services internationally and give its IoT developers access to the company network so they can view dashboards, manage devices, and upgrade firmware remotely. By using AWS, MediaTek has reduced its time to development by 50 percent and expanded globally.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/mediatek-logo.b62a9e875dd0a978371ee3a1ec21d7b85b323962.png","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003eMediaTek designs and develops silicon wafers for wireless communications and digital multimedia solutions. The Taiwan-based company uses AWS to deploy its services internationally, giving its IoT developers access to the company network, so they can access dashboards, manage devices, and upgrade firmware remotely. By using AWS, MediaTek has reduced its time to development by 50 percent and expanded globally.\u003c/p\u003e\r\n","industry":"Electronics \u0026 Semiconductors","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/mediatek/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"MediaTek","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: MediaTek"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#taiwan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Taiwan","description":"Taiwan","dateCreated":"2020-02-03T05:29:38+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#location#apac","loca