nces#bitkub","locale":"en_US","directoryId":"customer-references","name":"bitkub","dateCreated":"2022-03-19T00:20:15+0000","dateUpdated":"2023-07-14T23:32:43+0000","additionalFields":{"descriptionSummary":"Bitkub, a Cryptocurrency and Digital Asset Exchange, is one of Thailand\u0027s first unicorn start-ups. It provides multi-cryptocurrency wallets, user-friendly technical analysis tools, and alternative cash-out options for businesses willing to improve their payment processing systems. To support its exponential business expansion and traffic increase, it decided to rely on AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/bitkub-logo%401x.897802078de7049cf65838c83f31b8cd9122060d.png","displayLocation":"Thailand","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-03-18","headlineUrl":"https://aws.amazon.com/solutions/case-studies/bitkub/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","customer-name":"Bitkub","contentType":"Customer Story","headline":"Thai crypto exchange Bitkub scales with containers on AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#asean","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"ASEAN","description":"ASEAN","dateCreated":"2020-08-20T03:53:05+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"customer-refere