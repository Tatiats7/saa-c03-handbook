eCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#innovator#yum-brands","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Yum Brands","description":"\u003cp\u003eInnovator introduced in 2023.\u003c/p\u003e\n","dateCreated":"2023-08-10T19:06:51+0000","dateUpdated":"2023-08-10T19:06:51+0000"}]},{"item":{"id":"customer-references#wpo","locale":"en_US","directoryId":"customer-references","name":"wpo","dateCreated":"2023-07-18T00:05:28+0000","dateUpdated":"2023-09-07T23:50:16+0000","additionalFields":{"videoSrcUrl":"https://youtu.be/EFjMbttLlxw","descriptionSummary":"\u003cp\u003eWPO est une plateforme ind\u0026eacute;pendante de gestion d\u0026#39;actifs sp\u0026eacute;cialis\u0026eacute;e dans la production d\u0026#39;\u0026eacute;nergie \u0026eacute;olienne et solaire. Le groupe supervise un parc de deux mille \u0026eacute;oliennes et douze millions de panneaux solaires situ\u0026eacute;s sur six cents sites r\u0026eacute;partis dans douze pays europ\u0026eacute;ens. Tous les ans, ses \u0026eacute;quipes contribuent \u0026agrave; une production d\u0026rsquo;\u0026eacute;lectricit\u0026eacute; de source renouvelable \u0026eacute;quivalente \u0026agrave; la consommation de la ville de Paris. WPO propose des solutions techniques, commerciales et financi\u0026egrave;res \u0026agrave; ses clients propri\u0026eacute;taires des centrales de production parmi lesquels des grands \u0026eacute;nerg\u0026eacute;ticiens, des fonds d\u0026rsquo;investissement, des producteurs ind\u0026eacute;pendants d\u0026rsquo;\u0026eacute;lectricit\u0026eacute; ou encore des collectifs citoyens.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/%c3%89tude%20de%20cas%20AWS%20%20WPO%20-%20Logo.278f79c1615cccfed23297a75510c7d54ffda67c.png","displayLocation":"Europe, Moyen-Orient et Afrique","footerInfoText":"Date de publication","industry":"Énergie et services publics","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/wpo/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"WPO","enableShare":"1","publishedDate":"2021","contentType":"Témoignages clients","headline":"Les données au cœur des énergies renouvelables"}},"tags":[{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#industry#power-utilities","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Power \u0026 Utilities","description":"Power \u0026 Utilities","dateCreated":"2020-01-16T17:42:37+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#language#french","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"French","description":"French","dateCreated":"2020-03-03T06:40:44+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amaz