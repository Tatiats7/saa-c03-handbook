name":"Financial Services","description":"Financial Services","dateCreated":"2022-08-24T22:33:34+0000","dateUpdated":"2022-08-24T22:33:34+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#innovator#capital-one","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Capital One","description":"Capital One","dateCreated":"2022-04-25T19:05:47+0000","dateUpdated":"2022-07-16T00:04:47+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"}]},{"item":{"id":"customer-references#coca-cola-andina","locale":"en_US","directoryId":"customer-references","name":"coca-cola-andina","dateCreated":"2023-06-01T23:11:34+0000","dateUpdated":"2023-08-11T00:24:46+0000","additionalFields":{"descriptionSummary":"Coca-Cola Andina tiene la visión de promover el crecimiento rentable de su negocio, apoyando a sus clientes y garantizando las mejores experiencias a los más de 54 millones de consumidores en Chile, Argentina, Brasil y Paraguay. Para eso, desarrolla procesos de clase mundial con el fin de aumentar su productividad y la calidad del servicio. Una de las iniciativas para alcanzar ese desafío fue el desarrollo de un data lake basado en la tecnología cloud de AWS. Al adoptar almacenamiento, bases de datos, cómputo y capacidades analíticas basadas en tecnología AWS, la compañía logró aumentar la productividad del equipo de análisis en un 80%, permitiendo al propio negocio y a sus clientes tomar decisiones basadas en datos confiables, favoreciendo el crecimiento conjunto de todo el ecosistema, manteniendo su ventaja competitiva y aumentando los ingresos de la compañía.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/andina-logo%402x.2927ae74072635d1603498fab032d055c3a3e5eb.png","displayLocation":"Colombia","footerInfoText":"Fecha de publicación","industry":"Fabricación","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/coca-cola-andina/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Coca-Cola Andina","enableShare":"1","publishedDate":"2021","contentType":"Historia del cliente","headline":"Coca-Cola Andina incrementa productividad de análisis en un 80%, garantizando decisiones inteligentes y manteniendo ventaja competitiva a través de servicios AWS"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000"