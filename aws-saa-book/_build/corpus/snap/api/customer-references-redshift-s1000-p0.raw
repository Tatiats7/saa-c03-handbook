{"items":[{"item":{"id":"customer-references#charter-communications-reinvent2024","locale":"en_US","directoryId":"customer-references","name":"charter-communications-reinvent2024","dateCreated":"2025-05-02T15:50:55+0000","dateUpdated":"2025-05-02T16:09:28+0000","additionalFields":{"descriptionSummary":"Charter Communications is streamlining operations and reducing costs with AWS. By migrating to Amazon Redshift, they improved SLA deliverables by 18% and reduced operating costs by 35%, enhancing disaster recovery and business continuity. With Amazon SageMaker Unified Studio, Charter expects to gain a single source of truth, accelerate speed to market, and improve developer productivity—empowering them to deliver more value to customers while staying ahead of innovation.","imageSrcUrl":"https://d1.awsstatic.com/Charter.7cd671383e55d3241c21006c54fc8f34cbd2504a.jpg","displayLocation":"United States","customerNameLower":"charter communications","footerInfoText":"Published Date","industry":"Telecommunications","sortDate":"2025-04-13","headlineUrl":"https://www.youtube.com/watch?v\u003d36yNzOOn4QU\u0026did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Charter Communications","publishedDate":"2025","enableShare":"1","headline":"Driving Innovation and Efficiency with Amazon Redshift and Amazon SageMaker","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#devops","locale":"en_US","tagNamespaceId":"customer-references#category","