"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#workspaces","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon WorkSpaces","description":"Amazon WorkSpaces","dateCreated":"2020-03-02T07:06:12+0000","dateUpdated":"2022-02-03T03:33:08+0000"}]},{"item":{"id":"customer-references#code-org-security-case-study","locale":"en_US","directoryId":"customer-references","name":"code-org-security-case-study","dateCreated":"2019-07-19T14:55:32+0000","dateUpdated":"2022-01-21T02:44:49+0000","additionalFields":{"featured":"0","descriptionSummary":"Code.org relies on AWS to scale tenfold to deliver educational content to 100 million students worldwide, save $1.3 million annually, secure student data, and help students build cloud technology skills. The nonprofit organization provides a learning platform and the annual Hour of Code event to educate and train students in computer-science skills.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/CODE_Customer-Reference_Logo.e997e1f0e2121ffa510e0d20891bba8d8099306f.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eThe Hour of Code is a high-profile annual campaign that relies on AWS to help manage infrastructure and security needs. Code.org uses the campaign to promote access to computer science education in schools and increase participation by female and underrepresented minority students. Code.org relies on AWS Support and AWS Infrastructure Event Management to ensure seamless delivery of the Hour of Code activities to millions of students and teachers worldwide.\u003c/p\u003e\r\n","industry":"Government","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/code-org/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Code.org","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Code.org"}},"tags":[{"id":"customer-references#customer-segment#public-sector-nonprofit","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Nonprofit","description":"Nonprofit","dateCreated":"2019-07-22T18:39:49+0000","dateUpdated":"2022-05-09T21:31:14+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#cloudtrail","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudTrail","description":"AWS CloudTrail","dateCreated":"2020-03-02T07:02:05+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#use-case#web