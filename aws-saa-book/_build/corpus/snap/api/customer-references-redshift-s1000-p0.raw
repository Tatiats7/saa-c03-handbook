for the 80 percent of the world\u0027s population that is excluded or underserved by traditional financial services. JUMO was born in the AWS Cloud and uses AWS to power mobile money for people and businesses in Africa.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/JUMO_Customer-Reference_Logo.781ac044f8bcefc17b9cf6524069c05d1f5bb71d.png","displayLocation":"Sub-Saharan Africa","footerInfoText":"Published Date","description":"\u003cp\u003eJUMO is a rapidly scaling technology company providing information services, financial infrastructure and products designed to reach the 80% of the world\u0019s population who are excluded or underserved by traditional financial services.\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/jumo/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"JUMO","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"JUMO Case Study"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#location#middle-east-africa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East \u0026 Africa","description":"Middle East \u0026 Africa","dateCreated":"2020-02-03T05:30:19+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"