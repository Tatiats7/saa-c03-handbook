DPR).","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/best-western-hotels-logo%401x.2a16e087f07ac938d427eb0a9500c171980016c0.png","displayLocation":"Americas","customerNameLower":"best western","footerInfoText":"Published Date","industry":"Hospitality","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/best-western-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Best Western","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Best Western Uses DataMasque on AWS to Stop Data Breaches and Automate Key Processes"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#