ces#fxgt-case-study","locale":"en_US","directoryId":"customer-references","name":"fxgt-case-study","dateCreated":"2024-05-03T14:28:39+0000","dateUpdated":"2024-05-03T14:48:12+0000","additionalFields":{"descriptionSummary":"When people are trading on financial markets through an app or a website, they want to know that they can trust the service to be fast, reliable, and secure. Online broker FXGT.com knew its customers deserved a high level of service in these areas, so it migrated to Amazon Web Services (AWS) to increase its scalability, availability, and performance. To handle its data analytics, the company adopted Amazon Redshift, which uses SQL to analyze structured and semistructured data across data warehouses, databases, and data lakes.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Logo%20FXGT%401x.692f24e45d593bc8448ab126143020896dc12ff1.png","displayLocation":"Cyprus","customerNameLower":"fxgt.com","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2024-04-15","headlineUrl":"https://aws.amazon.com/solutions/case-studies/fxgt-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"FXGT.com","publishedDate":"2024","enableShare":"1","headline":"Improving Performance, Scalability, and Customer Trust by Migrating to AWS with FXGT.com","contentType":"Customer Story"}},"tags":[{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCr