 re:Invent","description":"AWS re:Invent","dateCreated":"2021-06-04T06:36:32+0000","dateUpdated":"2022-02-03T03:33:29+0000"},{"id":"customer-references#big-rocks#aws-for-data","locale":"en_US","tagNamespaceId":"customer-references#big-rocks","name":"AWS for Data","description":"\u003cp\u003eAWS for Data is a marketing \u0026ldquo;Big Rock\u0026rdquo; initiative that tells the story around how AWS can provide the most comprehensive set of data capabilities spanning databases, analytics, business intelligence, and machine learning for an end-to-end data strategy.\u003c/p\u003e\n","dateCreated":"2024-02-14T22:32:15+0000","dateUpdated":"2024-02-14T22:32:15+0000"}]},{"item":{"id":"customer-references#heyjobs-case-study","locale":"en_US","directoryId":"customer-references","name":"heyjobs-case-study","dateCreated":"2022-07-02T00:19:38+0000","dateUpdated":"2024-02-26T23:55:51+0000","additionalFields":{"descriptionSummary":"German recruitment technology company HeyJobs has developed a talent platform using Amazon Web Services (AWS) that simplifies and automates the job search and application process for millions of professionals. The platform uses machine learning (ML) and artificial intelligence (AI) to locate and match the right job to the most qualified candidate. Using AWS, HeyJobs has simplified its IT and reduced costs by 30 percent, while increasing its responsiveness to customer needs and supporting rapid growth and innovation.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/heyjobs-logo%401x.2de12445ecad456fcb854c542040f00ce8d30828.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"heyjobs","footerInfoText":"Published Date","industry":"Professional Services","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/heyjobs/","customer-name":"HeyJobs","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"HeyJobs Matches Millions of Candidates with Potential New Jobs, Cuts Costs by 30% Using AWS"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics