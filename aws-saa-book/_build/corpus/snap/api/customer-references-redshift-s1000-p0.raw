","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"IoT","description":"IoT","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#category#iot","locale":"en_US","tagNamespaceId":"customer-references#category","name":"IoT","description":"IoT","dateCreated":"2019-07-22T18:32:05+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#propellerhealth","locale":"en_US","directoryId":"customer-references","name":"propellerhealth","dateCreated":"2020-05-04T20:11:29+0000","dateUpdated":"2023-07-12T01:35:31+0000","additionalFields":{"descriptionSummary":"Propeller Health is a leading digital health company dedicated to the management of chronic respiratory disease. Propeller Health develops a digital health platform, Propeller, that improves outcomes for people with asthma and chronic obstructive pulmonary disease (COPD) and allows providers to monitor their patients remotely, stratify patients based on risk, and make data-driven decisions on treatment.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/propeller-health-200x70.a3848f7cc13b292d48c6499f01105344274c1aee.png","displayLocation":"North America","footerInfoText":"Published Date","industry":"Life Sciences","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/propeller-health-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","customer-name":"Propeller Health","contentType":"Customer Story","headline":"Propeller Health Leverages AWS to Help Patients Manage Respiratory Disease"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","descri