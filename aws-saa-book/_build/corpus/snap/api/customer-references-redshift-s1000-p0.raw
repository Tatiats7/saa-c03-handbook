stomer-references","name":"choco-up-case-study","dateCreated":"2022-05-21T02:21:55+0000","dateUpdated":"2022-09-09T00:34:16+0000","additionalFields":{"descriptionSummary":"Choco Up built its big data and analytics platform on AWS to enable funding decisions for clients within 1 hour. Choco Up is a revenue-based financing platform that provides fast access to capital for fast-growing companies and startups, with a focus on ecommerce merchants. The company is using Amazon Redshift for scenario analysis at scale, Amazon SageMaker for predictive modelling, and AWS Lambda to run infrastructure as code.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Choco_up_logo%401x.92f498036f1ba2b4241d6f7b6d2c1da541d6965f.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-05-20","headlineUrl":"https://aws.amazon.com/solutions/case-studies/choco-up-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Choco Up","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Choco Up Makes Credit Decisions for Clients in 1 Hour with Revenue-Based Financing Platform on AWS"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","descriptio