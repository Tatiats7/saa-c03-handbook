:06:26+0000","dateUpdated":"2022-02-03T03:31:13+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#customer-enablement#business-support","locale":"en_US","tagNamespaceId":"GLOBAL#customer-enablement","name":"AWS Business Support","description":"AWS Business Support","dateCreated":"2020-09-04T04:06:24+0000","dateUpdated":"2022-02-03T03:31:13+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#apervita-case-study","locale":"en_US","directoryId":"customer-references","name":"apervita-case-study","dateCreated":"2020-05-12T19:18:45+0000","dateUpdated":"2023-07-12T01:35:26+0000","additionalFields":{"descriptionSummary":"Using AWS, Apervita built an application development platform specifically for the healthcare industry, to make it easier to build apps that exchange clinical, operational, and financial data and perform analytics. Apervita\u0027s platform as a service (PaaS) allows users to easily build and share applications across networks of providers, payers, and healthcare enterprises.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/apervita@1x.51fdae9ce3c46a4857e06b29a26e8ec0361ea76e.jpg","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/apervita/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","customer-name":"Apervita","contentType":"Customer Story","headline":"Apervita’s Application Platform Simplifies Development, Sharing of Healthcare Apps Using AWS"}},"tags":[{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:43+0000","dateUpdated":"2022-02-03T03:36:00+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#redshift