AL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"}]},{"item":{"id":"customer-references#agibank-autoscaling","locale":"en_US","directoryId":"customer-references","name":"agibank-autoscaling","dateCreated":"2023-06-01T23:04:36+0000","dateUpdated":"2023-06-08T04:07:48+0000","additionalFields":{"descriptionSummary":"Determinada a oferecer sempre a melhor experiência para o cliente, a instituição tem ampliado o uso da nuvem para tornar as jornadas cada vez mais digitais e sem atrito, independente do canal que o cliente acesse. Este crescimento trouxe a necessidade de reavaliar a infraestrutura e os serviços utilizados, buscando adequá-los aos novos cenários, processo que vem sendo colocado em prática com o suporte do time da AWS.\n\nDesde 2017 o Agibank segue em pleno processo de crescimento e transformação – de financeira especializada em crédito para um banco de relacionamento completo – baseado fortemente em digitalização, inovação e implementando recursos cada vez mais ágeis. Portanto, a companhia definiu que a única forma de fazer entregas rápidas e acompanhar a demanda seria utilizando cloud computing e microsserviços, para garantir a escala necessária no tempo preciso.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/agi_logo%402x.9155292d65ae17ddf0851e625ebfeee92de47bec.png","displayLocation":"Brasil","customerNameLower":"agibank","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/agibank-autoscaling/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Agibank","enableShare":"1","publishedDate":"2023","contentType":"História do cliente","headline":"Agibank reduz custos de nuvem em 32% com suporte da AWS"}},"tags":[{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#