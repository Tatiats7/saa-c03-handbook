sh content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#koho-case-study","locale":"en_US","directoryId":"customer-references","name":"koho-case-study","dateCreated":"2022-03-19T00:20:54+0000","dateUpdated":"2022-12-19T23:24:58+0000","additionalFields":{"descriptionSummary":"Canadian fintech company KOHO migrated its data warehouse to AWS to achieve near-real-time data analytics, reduce costs, and improve security. KOHO also developed its Instant Pay solution in 3 months using AWS.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/koho-logo%401x.eb353a2b9dac4c815fa9814008365cffe0e46fd1.png","displayLocation":"Canada","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-03-18","headlineUrl":"https://aws.amazon.com/solutions/case-studies/koho-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"KOHO Financial","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"KOHO Uses AWS to Bring Canadians Lower Personal Finance Costs and Access to Same-Day Pay"}},"tags":[{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#cus