","tagNamespaceId":"GLOBAL#language","name":"German","description":"German","dateCreated":"2020-03-03T06:40:46+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2023-07-15T01:16:11+0000"},{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:43+0000","dateUpdated":"2022-02-03T03:36:00+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#germany","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Germany","description":"Germany","dateCreated":"2020-02-03T05:29:55+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#location#dach","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"DACH","description":"DACH","dateCreated":"2020-02-03T05:29:52+0000","dateUpdated":"2022-02-03T03:31:47+0000"}]},{"item":{"id":"customer-references#bmw-data-protection","locale":"en_US","directoryId":"customer-references","name":"bmw-data-protection","dateCreated":"2024-09-18T20:04:25+0000","dateUpdated":"2024-09-18T20:08:08+0000","additionalFields":{"descriptionSummary":"Die BMW Group und AWS (Amazon Web Services) gaben heute eine strategische Zusammenarbeit bekannt, bei der die Unternehmen gemeinsam innovative Cloud-Technologien entwickeln werden, um das Datenpotenzial künftiger Fahrzeuggenerationen optimal zu nutzen. Die beiden Unternehmen arbeiten auch zusammen, um kommerzielle Standard-Cloud-Lösungen für die sichere Verwaltung von Fahrzeugdaten zu entwickeln. Die Zusammenarbeit ist eine Fortsetzung der 2015 begonnenen Zusammenarbeit der beiden Unternehmen im Bereich vernetzter Fahrzeuge. Wie bei allen bisherigen Kooperationen behält die BMW Group die volle und ausschließliche Kontrolle über die Daten und hält sich an die in den jeweiligen Märkten geltenden Datenschutzbestimmungen.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/BMWGroup_logo_200x70_1X.3445718b3f949f158f9e3cac77d3ee79d4767a7f.jpg","displayLocation":"Deutschland","customerNameLower":"bmw group","industry":"Automobilbranche","sortDate":"2023-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/bmw-data-protection?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2023","contentType":"Kundengeschichte","customer-name":"BMW Group","headline":"Die BMW Group arbeitet mit AWS zusammen, um neue Cloud-Technologien für die schnelle und zuverlässige Verfügbarkeit von digitalen Innovationen bereitzustellen."}},"tags":[{"id":"GLOBAL#location#dach",