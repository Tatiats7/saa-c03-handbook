01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#telecomargentina","locale":"en_US","directoryId":"customer-references","name":"telecomargentina","dateCreated":"2023-06-01T23:05:33+0000","dateUpdated":"2023-06-08T04:07:41+0000","additionalFields":{"descriptionSummary":"Telecom Argentina es una empresa líder de soluciones de conectividad y entretenimiento con más de 23.000 colaboradores. Ofrece a más de 29 millones de clientes individuales, empresas e instituciones de todo el país servicio seguro, flexible y dinámico, en todos sus dispositivos, con conexiones fijas y móviles de alta velocidad, y una plataforma de contenidos en vivo y a demanda que integra series, películas, gaming, música y programas de TV. En la actualidad está transitando un camino de profunda transformación digital de sus operaciones y de su cultura, en la que la cloudificación resulta uno de los principales habilitadores tecnológicos.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/telecom_logo%401x.9e357acae61471fdcc122f4a221253c1ca8ba99d.png","displayLocation":"Argentina","customerNameLower":"telecom argentina","footerInfoText":"Fecha de publicación","industry":"Telecomunicaciones","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/telecomargentina/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Telecom Argentina","enableShare":"1","publishedDate":"2020","contentType":"Historia del cliente","headline":"Telecom Argentina inicia su estrategia de cloud hibrida con AWS"}},"tags":[{"id":"GLOBAL#product#elastic-beanstalk","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elastic Beanstalk","d