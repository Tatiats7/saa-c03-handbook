ectoryId":"customer-references","name":"investama","dateCreated":"2021-11-23T01:54:34+0000","dateUpdated":"2021-12-22T23:19:24+0000","additionalFields":{"descriptionSummary":"PT ABM Investama Tbk (ABM Investama) used IBM Rapid Move to migrate to SAP S/4HANA on AWS, which has enabled faster reporting and backups in addition to new analytics dashboards. ABM Investama, part of the PT Tiara Marga Trakindo Group, is an integrated energy company in the mining sector. The company is using Amazon EC2 to run SAP S/4HANA, Amazon S3 as a data lake, and Amazon DMS to populate its enterprise data platform.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/ABM-Investama%402x.39d5c60e1c8d21d30f2e4142e730efe7471209bd.png","displayLocation":"Indonesia","footerInfoText":"Published Date","industry":"Mining \u0026 Natural Resources","sortDate":"2021-11-22","headlineUrl":"https://aws.amazon.com/solutions/case-studies/investama/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"PT ABM Investama Tbk Provides Agile Response to Volatile Markets with SAP S/4HANA on AWS","customer-name":"PT ABM Investama Tbk"}},"tags":[{"id":"GLOBAL#location#asean","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"ASEAN","description":"ASEAN","dateCreated":"2020-08-20T03:53:05+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#industry#mining-natural-resource","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Mining \u0026 Natural Resources","description":"Mining \u0026 Natural Resources","dateCreated":"2020-06-25T04:07:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Co