chäftseinblicken um 30 Prozent. Zalando ist ein europäischer Online-Modehändler mit Sitz in Berlin, Deutschland. Das Unternehmen kombiniert SAP mit AWS Glue, Amazon Redshift, Amazon Athena und einem Amazon-S3-Data-Lake für transaktions- und analytische Datenberichte, die die Geschäftsleistung tracken.","imageSrcUrl":"https://d1.awsstatic.com/International/de_DE/casestudies/Zalando-SE_logo.b192cfa83b9e1ee8530586d468f231ccc81cd277.png","displayLocation":"Deutschland","customerNameLower":"zalando","industry":"Einzelhandel","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/zalando-sap/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"Kundengeschichte","customer-name":"Zalando","headline":"Online-Modeplattform Zalando verfolgt mithilfe von AWS Geschäftsleistung in nahezu Echtzeit"}},"tags":[{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#language#german","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"German","description":"German","dateCreated":"2020-03-03T06:40:46+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"custome