d":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#hcls","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Healthcare \u0026 Life Sciences","description":"Healthcare \u0026 Life Sciences","dateCreated":"2019-07-22T18:31:58+0000","dateUpdated":"2022-05-14T20:13:37+0000"}]},{"item":{"id":"customer-references#mastercard-ai-ml-testimonial","locale":"en_US","directoryId":"customer-references","name":"mastercard-ai-ml-testimonial","dateCreated":"2023-09-19T03:20:15+0000","dateUpdated":"2024-02-20T22:26:26+0000","additionalFields":{"descriptionSummary":"In this video, Manu Thapar, chief technology officer (CTO), Cyber \u0026 Intelligence at Mastercard, describes how Mastercard uses Amazon Web Services (AWS) artificial intelligence (AI) and machine learning (ML) services to improve fraud detection capabilities globally. The solution has enabled Mastercard to detect three times the amount of fraudulent transactions and reduce false positives tenfold, leading to billions of dollars in merchant savings and providing a better experience for customers around the world.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/mastercard-logo%401x.4a7e00978a4f5f979855fdd48a66a619cc2b84a4.png","displayLocation":"Americas","customerNameLower":"mastercard","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2023-08-29","headlineUrl":"https://aws.amazon.com/solutions/case-studies/mastercard-ai-ml-testimonial/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Mastercard","publishedDate":"2023","enableShare":"1","headline":"Mastercard Detects and Prevents Fraud Using AI/ML on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#ai-ml","locale":"en_