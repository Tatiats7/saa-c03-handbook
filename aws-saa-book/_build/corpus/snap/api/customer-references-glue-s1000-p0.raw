ceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#business-category#cloud-cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-06-05T07:06:41+0000","dateUpdated":"2022-02-03T03:31:02+0000"},{"id":"GLOBAL#product#guardduty","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon GuardDuty","description":"Amazon GuardDuty","dateCreated":"2020-03-02T07:03:46+0000","dateUpdated":"2022-02-03T03:32:40+0000"},{"id":"GLOBAL#product#textract","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Textract","description":"Amazon Textract","dateCreated":"2020-03-02T07:05:47+0000","dateUpdated":"2022-02-03T03:33:04+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"}]},{"item":{"id":"customer-references#vale-plus","locale":"en_US","directoryId":"customer-references","name":"vale-plus","dateCreated":"2023-06-01T23:03:52+0000","dateUpdated":"2023-06-08T04:07:43+0000","additionalFields":{"descriptionSummary":"Vale+, una empresa dedicada a fidelizar audiencias para sus clientes y sus marcas a través de plataformas de lealtad, implementó los servicios de data analytics de Amazon Web Services para entregar aún mejores servicios a sus clientes. En este video, Felipe Botero, CEO de Vale+, y Camilo Rodríguez, CTO de la compañía, explican cómo las soluciones de AWS le permitieron a Vale+ incursionar en este modelo de data y analíticas de forma económica, eficiente y escalable para diferenciarse en el mercado. Servicios como lambda y sagemaker fueron implementados con el apoyo del partner Insbuilt, dando a Vale+ la capacidad de gestionar grandes audiencias, segmentar y entender el comportamiento de todos sus afiliados, además de automatizar los procesos de comunicación con cada uno de ellos.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/valeplus-logo%402x.809b3a75a232a187be981cda3d72f2d1178ce98b.png","displayLocation":"Colombia","customerNameLower":"vale+","footerInfoText":"Fecha de publicación","industry":"Fabricación","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/vale-plus/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Vale+","enableShare":"1","publishedDate":"2021","contentType":"Historia del cliente","headline":"Vale+ utiliza AWS para comprender audiencias y entregar mejores servicios a sus clientes"}},"tags":[{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","descri