dateCreated":"2024-02-14T22:32:15+0000","dateUpdated":"2024-02-14T22:32:15+0000"}]},{"item":{"id":"customer-references#bmw-severless-reinvent-2020","locale":"en_US","directoryId":"customer-references","name":"bmw-severless-reinvent-2020","dateCreated":"2022-11-08T04:15:11+0000","dateUpdated":"2024-03-02T02:48:49+0000","additionalFields":{"descriptionSummary":"Data drives BMW’s personalized customer experiences, connected mobility solutions, and analytical insights. This session walks through the journey of building BMW Group’s Cloud Data Hub. BMW Group’s technical lead, Simon Kern, dives deep into how the company is leveraging AWS serverless capabilities for delivering ETL functions on big data in a modularized, accessible, and repeatable fashion and provides insight into the next steps of the journey. The services used in BMW Group’s AWS architecture are discussed, including AWS Glue, Amazon Athena, Amazon SageMaker, and more.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/BMWGroup_logo_200x70_1X.3445718b3f949f158f9e3cac77d3ee79d4767a7f.jpg","displayLocation":"Germany","customerNameLower":"bmw","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/bmw-severless-reinvent-2020/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"BMW","publishedDate":"2020","enableShare":"1","headline":"How BMW Group uses AWS serverless analytics for a data-driven ecosystem","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"