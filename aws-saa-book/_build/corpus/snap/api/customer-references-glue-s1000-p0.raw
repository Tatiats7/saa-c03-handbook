dateCreated":"2021-11-17T07:15:55+0000","dateUpdated":"2022-02-03T03:32:57+0000"},{"id":"GLOBAL#product#cloud9","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Cloud9","description":"AWS Cloud9","dateCreated":"2020-03-02T07:01:52+0000","dateUpdated":"2022-02-03T03:32:21+0000"},{"id":"GLOBAL#product#cloudtrail","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudTrail","description":"AWS CloudTrail","dateCreated":"2020-03-02T07:02:05+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#product#elasticache-redis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache for Redis","description":"Amazon ElastiCache for Redis","dateCreated":"2020-03-03T00:16:59+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#trueblue05182022sljsdgosi","locale":"en_US","directoryId":"customer-references","name":"trueblue05182022sljsdgosi","dateCreated":"2023-02-08T01:16:38+0000","dateUpdated":"2023-02-08T01:38:42+0000","additionalFields":{"descriptionSummary":"When TrueBlue wanted to accurately match blue collar jobs to North American workers, they decided they wanted to build a serverless data processing solution that not only scaled but easy to manage. In this episode Director of Data Science Engineering Carlos Lara dives into how they use the AWS Database Migration Service to extract data, and Amazon EventBridge and Amazon SQS to do time sequenced processing of it. We also explore how they use AWS Step Functions to orchestrate a workflow of Glue jobs to perform continuous upserts into table snapshots for data scientists to consume.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/TrueBlue_Logo%401x.7cf92df9eb26865c375af32d14f6cf9003d26ae6.png","displayLocation":"United States","customerNameLower":"trueblue, inc.","footerInfoText":"Published Date","industry":"Professional Services","sortDate":"2022-05-18","headlineUrl":"https://youtu.be/iKYvG5aiIn8?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Trueblue, Inc.","publishedDate":"2022","enableShare":"1","headline":"TrueBlue: Scaling Job Matching with a Serverless Delta Lake","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GL