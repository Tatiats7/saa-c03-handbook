:"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#healthfirst20200629sdlkdfhj","locale":"en_US","directoryId":"customer-references","name":"healthfirst20200629sdlkdfhj","dateCreated":"2022-05-23T21:41:50+0000","dateUpdated":"2023-07-14T23:32:28+0000","additionalFields":{"descriptionSummary":"Wrangling data from increasingly more sources can become unwieldy. In this episode of \u0027This is my Architecture\u0027, we revisit Healthfirst\u0027s Secure Analytics Platform (https://youtu.be/ZqFWOQyQaNQ) to see how they have extended their solution with AWS CloudFormation, Amazon SQS, AWS Step Functions and AWS Lambda to improve coordination of data pipelines. We also learn how they leverage Amazon SageMaker to introduce Machine Learning to their data, to better identify risks factors in determinance of health outcomes.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/healthfirst-logo%401x.327da8037f4b8a0110149a4ce0bdd5ae95bc1479.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2020-06-29","headlineUrl":"https://youtu.be/XpFNznmRoQ0?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","customer-name":"Healthfirst","contentType":"Customer Story","headline":"Healthfirst: Wrangli