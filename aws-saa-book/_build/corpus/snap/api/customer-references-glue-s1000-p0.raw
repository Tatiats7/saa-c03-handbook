ent and coaching purposes, or accurate real-time data for betting purposes.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/hudstats-logo%401x.0ca8c2034e311dd6c239dfd0e957b5653e51156f.png","displayLocation":"Netherlands","customerNameLower":"hudstat","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2024-04-08","headlineUrl":"https://aws.amazon.com/blogs/gametech/hudstats-switches-from-openai-to-amazon-bedrock-to-advance-esports-storytelling-using-generative-ai/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Hudstat","publishedDate":"2024","enableShare":"1","headline":"HUDstats switches from OpenAI to Amazon Bedrock to advance esports storytelling using generative AI","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","n