ry","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"}]},{"item":{"id":"customer-references#mahindra20200515etygvm","locale":"en_US","directoryId":"customer-references","name":"mahindra20200515etygvm","dateCreated":"2022-05-23T21:42:16+0000","dateUpdated":"2023-07-12T01:40:45+0000","additionalFields":{"descriptionSummary":"Mahindra Electric foresees a large scale adoption of electric vehicles in India by 2030. In this episode, learn how Santhosh and his team created NEMO, a cloud-based mobility platform that enables a new generation of shared, connected \u0026 electric services. Dive deep into how the team leverages Amazon Kinesis for real time data streaming, Amazon Athena and Amazon Glue to build advanced actionable intelligence around vehicle, charging and fleet performance. Santhosh also walks us through how to leverage a data lake on Amazon S3 and AWS Serverless architecture to build a new set of business models around shared mobility, while enabling fleet operators to seamlessly manage a fleet of electric vehicles.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/mahindra-logo%401x.e0abfa9936606e73ac6f0b48bdc84ddc0194b4ba.png","displayLocation":"Asia Pacific","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2020-05-15","headlineUrl":"https://youtu.be/wbh51O3QrE4?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","customer-name":"Mahindra and Mahindra Limited","contentType":"Customer Story","headline":"Mahindra Electric: Building a Connected Electric Vehicle Platform on AWS"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"GLOBAL#tech-cat