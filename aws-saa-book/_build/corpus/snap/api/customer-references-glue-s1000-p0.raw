filter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#21st-century-fox-case-study","locale":"en_US","directoryId":"customer-references","name":"21st-century-fox-case-study","dateCreated":"2019-07-19T15:19:27+0000","dateUpdated":"2023-07-19T03:04:53+0000","additionalFields":{"featured":"0","descriptionSummary":"21st Century Fox (21CF) uses AWS to enable large-scale business transformation. Using more than 100 AWS services, 21CF is driving innovation across its supply chain, data platforms, and consumer product experiences.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/fox-logo%401x.c53ed2aa45c6ef9479d33bb6963b1070455b252c.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003e21st Century Fox (21CF) CTO Paul Cheesbrough discusses how the global media company is using cloud services to enable large-scale business transformation. Using over 100 AWS services, 21CF is driving innovation across its supply chain, data platforms, and consumer product experiences.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/21stCenturyFox/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"21st Century Fox","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"21st Century Fox Case Study"}},"tags":[{"id":"customer-references#innovator#fox","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Fox","description":"Fox","dateCreated":"2022-09-15T00:48:29+0000","date