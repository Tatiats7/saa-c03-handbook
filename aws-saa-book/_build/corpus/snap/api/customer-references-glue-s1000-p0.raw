ould be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#state-auto","locale":"en_US","directoryId":"customer-references","name":"state-auto","dateCreated":"2022-01-15T01:07:15+0000","dateUpdated":"2022-01-18T18:43:38+0000","additionalFields":{"descriptionSummary":"Regional property and casualty insurer State Auto improved operational efficiency and reduced costs using ML and automation on AWS and can now process 83 percent more claims.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/state-auto-logo%401x.49d47bc96d2af9f2028729fd46fa3e49f68fa3ec.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-01-14","headlineUrl":"https://aws.amazon.com/solutions/case-studies/state-auto/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"State Auto Improves Processes across the Life Cycle Using AWS Machine Learning, Computer Vision, and Serverless Architecture","customer-name":"State Automobile Mutual Insurance Company (State Auto)"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#textract","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Textract","description":"Amazon Textract","dateCreated":"2020-03-02T07:05:47+0000","dateUpdated":"2022-02-03T03:33:04+0000"},{"id":"GLOBAL#