_US","directoryId":"customer-references","name":"intuit-ml-summit-case-study","dateCreated":"2022-08-22T23:23:54+0000","dateUpdated":"2024-03-02T02:48:48+0000","additionalFields":{"descriptionSummary":"Intuit is a business and financial software company that develops and sells financial, accounting, and tax preparation software and related services for small businesses, accountants, and individuals. Learn how Intuit accelerated its artificial intelligence (AI) and machine learning (ML) progress to create game-changing customer experiences. By using AWS to modernize its data and ML infrastructure, the company freed up its data scientists and tripled its speed to delivery, helping to direct more resources to customers.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/intuit-logo%401x.abf7c40ea61ce4d0953ca761007c94e44fb36e58.png","displayLocation":"United States","customerNameLower":"intuit","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-08-22","headlineUrl":"https://aws.amazon.com/solutions/case-studies/intuit-ml-summit-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Intuit","publishedDate":"2022","enableShare":"1","headline":"Intuit Modernizes AI and ML on AWS to Derive Customer Benefits","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#kinesis-data-firehose","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis Firehose","description":"Amazon Kinesis Firehose","dateCreated":"2020-05-08T03:42:48+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon