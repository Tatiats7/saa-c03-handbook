:"Data Lakes \u0026 Analytics","dateCreated":"2019-07-22T18:31:39+0000","dateUpdated":"2022-02-07T13:55:55+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#industry#travel","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Travel","description":"Travel","dateCreated":"2020-01-16T17:42:42+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#workload#sap","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"SAP","description":"SAP","dateCreated":"2021-01-06T00:09:56+0000","dateUpdated":"2022-02-03T03:36:05+0000"},{"id":"GLOBAL#industry#transport-logistics","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Transport \u0026 Logistics","description":"Transport \u0026 Logistics","dateCreated":"2020-06-25T04:08:39+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#unimedbh-from-es-directory","locale":"en_US","directoryId":"customer-references","name":"unimedbh-from-es-directory","dateCreated":"2024-02-03T03:48:17+0000","dateUpdated":"2024-02-06T01:35:36+0000","additionalFields":{"descriptionSummary":"Dando mais agilidade a seus processos com tecnologia AWS, a Unimed-BH consegue aumentar os índices de satisfação de pacientes e médicos, que veem suas solicitações aprovadas rapidamente e de forma transparente.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/Latam%20Cases%20Assets/Unimed_BH_LOGO1.f2aa4f715aaf597e713ba3ef1bc9d24f76ca7ab7.jpg","displayLocation":"Brasil","footerInfoText":"Data de publicação","industry":"Saúde","sortDate":"2019-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/unimedbh/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2019","contentType":"História do cliente","customer-name":"UNIMED BH","headline":"Estudo de caso AWS: Unimed Belo Horizonte"}},"tags":[{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#ec2-auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Auto Scaling","description":"Amazon EC2 Auto Scaling","dateCreated":"2020-03-02T07:02:53+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portu