tegory","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"}]},{"item":{"id":"customer-references#boehringer-ingelheim-case-study-de","locale":"en_US","directoryId":"customer-references","name":"boehringer-ingelheim-case-study-de","dateCreated":"2024-09-18T20:04:06+0000","dateUpdated":"2024-09-18T20:08:09+0000","additionalFields":{"descriptionSummary":"In der Pharmaindustrie können riesige Datenmengen – aus klinischen Studien, Biobanken, elektronischen Patientenakten, der Lieferkette und der Produktion – dazu beitragen, die Ursachen von Krankheiten aufzudecken, Heilmittel zu finden und die Entwicklung und Bereitstellung neuer Arzneimittel für Patienten zu beschleunigen. Die Erkenntnisse sind aber leider oft in Datensilos verschüttet. Das globale Pharmaunternehmen Boehringer Ingelheim arbeitet daran, das Potenzial von Daten entlang seiner gesamten Wertschöpfungskette zu erschließen, indem es die Infrastruktur und die Prozesse zur effektiven Datennutzung schafft.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/boehringer-ingelheim-logo%401x.4f9311d81b5578f1eee5a5cceb9e8e6c53c6d11d.png","displayLocation":"Deutschland","customerNameLower":"boehringer ingelheim","industry":"Biowissenschaften","sortDate":"2023-03-20","enableShare":"1","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/boehringer-ingelheim-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2023","contentType":"Kundengeschichte","customer-name":"Boehringer Ingelheim","headline":"Boehringer Ingelheim schafft datenbasierte Strukturen mit AWS, um die Einführung neuer Medikamente zu beschleunigen"}},"tags":[{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#industry#life-sciences","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Life Sciences","description":"Life Sciences","dateCreated":"2020-01-16T17:42:31+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-referen