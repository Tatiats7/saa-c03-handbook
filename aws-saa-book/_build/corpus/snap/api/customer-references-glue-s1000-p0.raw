ied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#ge-renewable-energy","locale":"en_US","directoryId":"customer-references","name":"ge-renewable-energy","dateCreated":"2022-01-08T04:32:42+0000","dateUpdated":"2024-03-02T02:48:48+0000","additionalFields":{"featured":"0","featureImageURL":"https://d1.awsstatic.com/aws-key-pages/homepage-key-pages/customer-stories-logo/GE.69d638be1bb211236c8d87590e8ee0be001b543c.jpg","descriptionSummary":"GE Renewable Energy modernized its Digital Services platform on AWS, achieving 99.9 percent availability and gaining the ability to scale without provisioning infrastructure.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/GEPower_Customer-Reference_Logo.7100af15f7461bdc2ea9edec4f9b61e536c54f48.png","displayLocation":"France","customerNameLower":"ge renewable energy (gere)","footerInfoText":"Published Date","description":"\u003cp\u003eAchieving 99.9% data availability to deliver carbon-free electricity\u003c/p\u003e\n","industry":"Power \u0026 Utilities","sortDate":"2022-01-07","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ge-renewable-energy/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"GE Renewable Energy (GERE)","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Achieving 99.9% data availability to deliver carbon-free electricity"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location",