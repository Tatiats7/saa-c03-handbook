 von Amazon Elastic Compute Cloud (Amazon EC2), AWS Lambda, AWS Config und AWS KMS. Heute ist AWS ist der wichtigste Cloud-Anbieter für TUI. Das Unternehmen entschied sich aufgrund der Größenvorteile, der ausgereiften Produkte und des Supports für AWS. Die Migration zur Cloud half TUI dabei, Updates schneller für die Benutzer bereitzustellen und zugleich die Zeit für die Einführung neuer Funktionen auf der Plattform zu verkürzen, global zu skalieren und den-Teams dabei zu helfen, zu experimentieren und Innovationen zu beschleunigen.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/TUI_Customer-Reference_Logo%401x.ca041124ff6784cabbc736869e74ba723fbc6964.png","displayLocation":"Deutschland","customerNameLower":"tui","industry":"Reise","sortDate":"2023-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/tui-aws-is-how?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2023","contentType":"Kundengeschichte","customer-name":"TUI","headline":"TUI Group migriert mithilfe von AWS zu einer skalierbaren Cloud-Plattform"}},"tags":[{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#category#backup-restore","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Backup \u0026 Restore","description":"Backup \u0026 Restore","dateCreated":"2019-07-22T18:31:01+0000","dateUpdated":"2022-04-09T03:06:56+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name"