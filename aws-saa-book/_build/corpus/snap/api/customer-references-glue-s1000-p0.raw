ità dell\u0027infrastruttura aziendale durante gli orari di picco e ridurla durante le ore meno attive, consente a ENGIE di risparmiare il 60% dei costi di runtime del cloud.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Engie_Logo@1x.0c113ddc2f31b59cf84d5b3d7dfdfef6570f1331.png","displayLocation":"Stati Uniti","customerNameLower":"engie","footerInfoText":"Data di pubblicazione","industry":"Energia","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/engie-2022-aws-reinvent-video/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ENGIE","enableShare":"1","publishedDate":"2022","contentType":"Storia del cliente","headline":"ENGIE crea piattaforme digitali per accelerare la transizione energetica a zero emissioni di carbonio, alimentate da AWS"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#location#united-states","locale