azon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#general-electric","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"General Electric","description":"General Electric","dateCreated":"2022-09-15T00:48:30+0000","dateUpdated":"2022-09-15T00:48:30+0000"},{"id":"GLOBAL#industry#oil-gas","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Oil \u0026 Gas","description":"Oil \u0026 Gas","dateCreated":"2020-01-16T17:42:36+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"customer-references#big-rocks#aws-for-data","locale":"en_US","tagNamespaceId":"customer-references#big-rocks","name":"AWS for Data","description":"\u003cp\u003eAWS for Data is a marketing \u0026ldquo;Big Rock\u0026rdquo; initiative that tells the story around how AWS can provide the most comprehensive set of data capabilities spanning databases, analytics, business intelligence, and machine learning for an end-to-end data strategy.\u003c/p\u003e\n","dateCreated":"2024-02-14T22:32:15+0000","dateUpdated":"2024-02-14T22:32:15+0000"}]},{"item":{"id":"customer-references#gobierno-ciudad-buenos-aires","locale":"en_US","directoryId":"customer-references","name":"gobierno-ciudad-buenos-aires","dateCreated":"2023-06-01T23:04:41+0000","dateUpdated":"2023-07-14T23:32:38+0000","additionalFields":{"descriptionSummary":"El Gobierno de la Ciudad de Buenos Aires es uno de los más importantes de Argentina. Uno de sus principales intereses es poner a los ciudadanos en el centro de las diversas decisiones políticas. Para ello resulta importante tener consolidada la información que el GCABA genera y recolecta para llevar adelante la operación que está en cabeza de las diferentes dependencias con el fin de posibilitar un re-diseño más efectivo de las políticas públicas en base a datos. Dichos datos están siendo consolidados en PIBA (Plataforma Inteligente de Buenos Aires), desarrollada en la nube de AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/buenosairesciudad%401x.7b6f1445a271ceb344bc9983d823cb601cec37b2.png","displayLocation":"Argentina","customerNameLower":"ar - buenos aires government (gcba) / same","footerInfoText":"Fecha de publicación","industry":"State and Local Government","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/gobierno-ciudad-buenos-aires/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"AR - Buenos Aires Government (GCBA) / SAME","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"AWS ayuda a reducir la burocracia y acelerar la transformación digital en Buenos Aires"}},"tags":[{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","des