u0026 Logistics","description":"Transport \u0026 Logistics","dateCreated":"2020-06-25T04:08:39+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#reference-arch-diagram","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Reference Architecture Diagram","description":"Reference Architecture Diagram","dateCreated":"2020-04-29T05:19:31+0000","dateUpdated":"2022-02-03T03:31:09+0000"}]},{"item":{"id":"customer-references#riotgames06152000lksfelkj","locale":"en_US","directoryId":"customer-references","name":"riotgames06152000lksfelkj","dateCreated":"2023-02-08T01:17:22+0000","dateUpdated":"2023-02-08T01:38:41+0000","additionalFields":{"descriptionSummary":"Riot Games ingests about 20 TB of data every day on AWS.  This data powers a wide range of products including match-making, personalization, analytics, security, anti-cheat and player behavior.  Until recently, this data was only queryable hours after it was produced (in some cases up to 6).  With AWS MSK, the team was able to bring that time down to 5 minutes and unlock use cases that require stream processing.  MSK also allowed us to lower our TCO and deprecate an aging, Map-Reduce based pipeline. In this session, we will talk about the before state, migration path, current state and future state of our data ingestion pipeline.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/riot-games-logo%401x.74c6d8e881d506fd9de192b255958c06d4db50de.png","displayLocation":"United States","customerNameLower":"riot games, inc.","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2022-06-15","headlineUrl":"https://youtu.be/iwZLadQ3XpY?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Riot Games, Inc.","publishedDate":"2022","enableShare":"1","headline":"Riot Games: A New Data Ingest Pipeline for League of Legends using MSK","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#gaming","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gaming","description":"Gaming","dateCreated":"2019-07-22T18:31:55+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#reference-arch-diagram","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Reference Architecture Diagram","description":"Reference Architecture Diagram","dateCreated":"2020-04-29T05:19:31+0000","dateUpdated":"2022-02-03T03:31:09+0000"}]},{"item":{"id":"customer-references#jump","locale":"en_US","directoryId":"customer-references","name":"jump","dateCreated":"2023-07-17T23:44:59+0000","dateUpdated":"2023-08-11T22:26:57+0000","additionalFields":{"videoSrcUrl":"https://www.youtube.com/watch?v\u003d6Uq9Qvtzitw","descriptionSummary":"\u003cp\u003eJump facilite le quotidien des personnes souhaitant devenir freelances en leur proposant de les embaucher en CDI - tout en restant leur propre patron sans avoir \u0026agrave; g\u0026eacute;rer le volet administratif. Sebastian CACERES, CTO chez Jump, partage l\u0026rsquo;ambition de multiplier par 5 le nombre de salari\u0026eacute;s freelances d\u0026rsquo;ici fin 2022. Sa probl\u0026eacute;matique principale : rester proche des clients en proposant une disponibilit\u0026eacute; en continue et une structure pour ses utilisateurs. Le Cloud AWS a su fournir les fonctionnalit\u0026eacute;s permettant \u0026agrave; Jump de r\u0026eacute;pondre \u0026agrave; ses besoins de haute disponibilit\u0026eacute;, flexibilit\u0026eacute;, scalabilit\u0026eacute; et de s\u0026eacute;curit\u0026eacute; pour un investissement moindre en amont. Le passage au cloud a eu pour effet d\u0026rsquo;offrir plus d\u0026rsquo;agilit\u0026eacute; \u0026agrave; Jump en leur permettant de faire du test and learn gr\u0026acirc;ce aux diff\u0026eacute;rentes fonctionnalit\u0026eacute;s et services propos\u0026eacute;s. Jump souhaite aller plus loin et s\u0026rsquo;int\u0026eacute;resse aujourd\u0026rsquo;hui \u0026agrave; l\u0026rsquo;architecture bas\u0026eacute;e sur des \u0026eacute;v\u0026eacute;nements, la scalabilit\u0026eacute; et les services \u0026agrave; l\u0026rsquo;\u0026eacute;chelle mondiale.\u003c/p\u003e\r\n","featured":"0","featureImageURL":"https://i.ytimg.com/vi/6Uq9Qvtzitw/maxresdefault.jpg","imageSrcUrl":"https://d1.awsstatic.com/%c3%89tude%20de%20cas%20AWS%20%20Jump.ba964f2b5a82506027f093a6dd39620de314eb70.jpg","displayLocation":"France","customerNameLower":"jump","footerInfoText":"Date de publication","industry":"Services professionnels","sortDate":"2022-06-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/jump/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Jump","enableShare":"1","publishedDate":"2022","contentType":"Témoignages clients","headline":"Jump : Une solution innovante pour les freelances en recherche d’une proximité client toujours plus forte"}},"tags":[{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#product#lightsail","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Lightsail","description":"Amazon Lightsail","dateCreated":"2020-03-02T07:04:25+0000","dateUpdated":"2022-02-03T03:32:47+0000"},{"id":"GLOBAL#product#gamelift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon GameLift","description":"Amazon GameLift","date