ated":"2020-06-25T04:07:49+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#conekta","locale":"en_US","directoryId":"customer-references","name":"conekta","dateCreated":"2023-06-01T23:09:16+0000","dateUpdated":"2023-06-08T04:07:36+0000","additionalFields":{"descriptionSummary":"Conekta ayuda los comercios a aceptar pagos de sus clientes a través de medios como efectivo y también tarjetas. La empresa tenía la problemática de buscar soluciones escalables, elásticas y que le permitiera tener alta disponibilidad. Con AWS la empresa logró consolidarse como una compañía totalmente digital, con alta disponibilidad, con sistema 24x7, 365 días al año. Eso le permitió tener una mayor penetración en el mercado mexicano.","imageSrcUrl":"https://d1.awsstatic.com/Conekta.e6964b893a5b3450c09bf034486a786493d8de86.png","displayLocation":"México","footerInfoText":"Fecha de publicación","industry":"Servicios financieros","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/conekta/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"Historia del cliente","customer-name":"Conekta","headline":"Conekta se consolida totalmente digital con soluciones AWS"}},"tags":[{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"