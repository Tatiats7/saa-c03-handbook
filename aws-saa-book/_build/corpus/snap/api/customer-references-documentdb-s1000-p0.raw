itionalFields":{"descriptionSummary":"Usando Amazon Web Services (AWS), Knotion escala sin problemas para distribuir contenido de manera confiable a 50,000 estudiantes en 150 escuelas. Knotion, una EdTech con sede en México, proporciona sistemas de aprendizaje para escuelas con contenido transdisciplinario para estudiantes. Su misión es lograr un impacto positivo en el mundo al proporcionar a los estudiantes contenido alineado con los Objetivos Sostenibles de las Naciones Unidas hacia 2030. Knotion ejecuta su infraestructura en AWS utilizando rds (Amazon RDS), Amazon Simple Storage Service (Amazon S3), y AWS Elastic Beanstalk.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/Latam%20Cases%20Assets/knotion_logo.5235932caef09958740b24f7343e51d5c200b2cf.png","displayLocation":"México","footerInfoText":"Fecha de publicación","industry":"Software e Internet","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/knotion/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"Historia del cliente","customer-name":"Knotion","headline":"Knotion escala para llegar a 50,000 estudiantes usando AWS"}},"tags":[{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notification Service (SNS)","dateCreated":"2020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#elas