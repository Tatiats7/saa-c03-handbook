locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodeBuild","description":"AWS CodeBuild","dateCreated":"2020-03-02T07:02:08+0000","dateUpdated":"2022-02-03T03:32:24+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#punchh1","locale":"en_US","directoryId":"customer-references","name":"punchh1","dateCreated":"2020-12-02T23:21:53+0000","dateUpdated":"2021-12-22T19:51:13+0000","additionalFields":{"descriptionSummary":"Punchh, Inc is a leading digital marketing company that offers software-as-a-service solutions to brick-and-mortar retailers and restaurants. Using the Punchh Platform, the company supports its customers in maximizing their customer lifetime value and achieving organic growth by driving loyalty engagement programs. To keep pace with the growth in the number of customers on its platform, Punchh migrated its database to Amazon DocumentDB as its core database service. With Amazon DocumentDB, the platform now handles twice the workload than before, with a 20 percent cost reduction. Today, multiple brands can run concurrent campaigns on the Punchh platform with no downtime or compromises to the customer experience.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Punchh_logo%401x.c42c7ea44b37440872fb7f36ecd43054a808c0e1.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2020-12-02","headlineUrl":"https://aws.amazon.com/solutions/case-studies/punchh1/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Punchh Uses Amazon DocumentDB (with MongoDB compatibility) to Handle a Two-Fold Increase in Database Workload","customer-name":"Punchh"}},"tags":[{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#content-type#customer-stor