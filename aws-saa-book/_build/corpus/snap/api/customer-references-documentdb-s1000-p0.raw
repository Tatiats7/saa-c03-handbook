:"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#ec2-spot-instances","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Spot Instances","description":"Amazon EC2 Spot Instances","dateCreated":"2022-04-26T06:27:16+0000","dateUpdated":"2022-04-26T06:27:16+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#reference-arch-diagram","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Reference Architecture Diagram","description":"Reference Architecture Diagram","dateCreated":"2020-04-29T05:19:31+0000","dateUpdated":"2022-02-03T03:31:09+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#iktos","locale":"en_US","directoryId":"customer-references","name":"iktos","dateCreated":"2023-06-01T23:25:26+0000","dateUpdated":"2023-08-11T22:26:58+0000","additionalFields":{"videoSrcUrl":"https://www.youtube.com/watch?v\u003diAhygDzeblE","descriptionSummary":"\u003cp\u003eSoci\u0026eacute;t\u0026eacute; d\u0026rsquo;intelligence artificielle sp\u0026eacute;cialis\u0026eacute;e dans la chimie, Iktos concentre l\u0026rsquo;ensemble de son activit\u0026eacute; \u0026agrave; aider les acteurs de l\u0026rsquo;industrie pharmaceutique \u0026agrave; acc\u0026eacute;l\u0026eacute;rer le processus de d\u0026eacute;veloppement de nouveaux m\u0026eacute;dicaments. Nicolas DO HUU, Co-founder \u0026amp; Chief Technology Officer chez Iktos, nous exprime les besoins et les probl\u0026eacute;matiques d\u0026rsquo;Iktos et comment AWS a su accompagner l\u0026rsquo;entreprise en pleine croissance \u0026agrave; d\u0026eacute;ployer rapidement ses solutions dans le cloud tout en b\u0026eacute;n\u0026eacute;ficiant de la puissance de calcul pour la recherche interne. Iktos a d\u0026eacute;cid\u0026eacute; de migrer vers le cloud pour faciliter la gestion du datacenter notamment la s\u0026eacute;curit\u0026eacute; et afin de gagner en scalabilit\u0026eacute;. Les bases de donn\u0026eacute;es, le message passing et l\u0026rsquo;acc\u0026egrave;s \u0026agrave; des GPU performants, font partie des services propos\u0026eacute;s par le cloud AWS n\u0026eacute;cessaires \u0026agrave; l\u0026rsquo;infrastructure d\u0026rsquo;Iktos. Cela a permis \u0026agrave; leurs d\u0026eacute;ploiements de passer de 3 semaines \u0026agrave; 1 jour et demi. Apr\u0026egrave;s le d\u0026eacute;veloppement de l\u0026rsquo;infrastructure de production sur AWS, la prochaine \u0026eacute;tape est de migrer l\u0026rsquo;infrastructure de R\u0026amp;D.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/iktos_Logo.7ab9062eb0c95b94734028ba88b8a47b5310f699.PNG","displayLocation":"France","customerNameLower":"iktos","footerInfoText":"Date de publication","industry":"Santé","sortDate":"2022-07-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/iktos/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Iktos","enableShare":"1","publishedDate":"2022","contentType":"Témoignages clients","headline":"Iktos : Le déploiement rapide et à grande échelle de solutions clients d’une entreprise d’IA en pleine croissance"}},"tags":[{"id":"GLOBAL#customer-enablement#developer-support","locale":"en_US","tagNamespaceId":"GLOBAL#customer-enablement","name":"AWS Developer Support","description":"AWS Developer Support","dateCreated":"2020-09-04T04:06:26+0000","dateUpdated":"2022-02-03T03:31:13+0000"},{"id":"GLOBAL#product#augmented-ai","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Augmented AI","description":"Amazon Augmented AI","dateCreated":"2020-12-08T20:05:22+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#product#forecast","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Forecast","description":"Amazon Forecast","dateCreated":"2020-03-02T07:03:29+0000","dateUpdated":"2022-02-03T03:32:37+0000"},{"id":"GLOBAL#product#lookout-for-equipment","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Lookout for Equipment","description":"Amazon Lookout for Equipment","dateCreated":"2021-11-17T07:15:30+0000","dateUpdate