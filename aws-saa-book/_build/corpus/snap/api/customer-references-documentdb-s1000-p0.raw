-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Plume","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Plume Meets Demands of Explosive Growth with Migration to Amazon DocumentDB"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#database-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Database Migration","description":"Database Migration","dateCreated":"2019-07-22T18:31:40+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#use-case#general-database-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"General Database Migration","description":"General Database Migration","dateCreated":"2020-06-05T06:37:24+0000","dateUpdated":"2022-02-03T03:35:41+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#documentdb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DocumentDB","description":"Amazon DocumentDB","dateCreated":"2020-03-02T07:02:46+0000","dateUpdated":"2022-02-03T03:32:30+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","descr