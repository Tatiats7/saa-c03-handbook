owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#chelsea-case-study","locale":"en_US","directoryId":"customer-references","name":"chelsea-case-study","dateCreated":"2020-11-27T20:53:49+0000","dateUpdated":"2023-07-12T01:40:54+0000","additionalFields":{"featured":"0","descriptionSummary":"Chelsea delivered on its direct-to-consumer app ambitions using AWS serverless infrastructure and machine-learning services.","imageSrcUrl":"https://d1.awsstatic.com/emea-customer-references/emea-directory-customer-logos/Chelsea-Digital-Ventures_Customer-References_Logo%401x.cc75d26bdeb305c759b237046be2f6200a226b43.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","industry":"Hospitality","sortDate":"2020-11-27","headlineUrl":"https://aws.amazon.com/solutions/case-studies/chelsea-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Chelsea Digital Ventures","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Chelsea Builds Success off the Field with AWS"}},"tags":[{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description"