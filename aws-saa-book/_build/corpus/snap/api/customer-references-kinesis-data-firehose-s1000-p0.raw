dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"}]},{"item":{"id":"customer-references#woot-case-study","locale":"en_US","directoryId":"customer-references","name":"woot-case-study","dateCreated":"2019-07-19T14:56:57+0000","dateUpdated":"2021-12-22T19:26:41+0000","additionalFields":{"featured":"0","descriptionSummary":"Woot cut its data warehouse operating costs by 90 percent, shifted to a model of shared responsibility for data between developer and data teams, and reduced operations overhead by migrating to a serverless data warehouse on AWS. Woot, the original daily deals website, offers other short-term sales across seven product categories.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Woot_Customer-Reference_Logo.655d006e422fbd8c2b724c432feb195254f31f1a.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eWoot cut its data warehouse operating costs by 90 percent, shifted to a model of shared responsibility for data between developer and data teams, and reduced operations overhead by migrating to a serverless data warehouse on AWS. Woot, the original daily deals website, offers other short-term sales across seven product categories. The company is using Amazon Kinesis Data Firehose and Amazon S3 for data ingestion and storage, and it relies on Amazon Athena and Amazon QuickSight for user-friendly querying and data visualization.\u003c/p\u003e\r\n","industry":"Retail","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/woot/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Woot","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Woot Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#retail","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Retail","description":"Retail","dateCreated":"2020-01-16T17:42:39+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#quicksight","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon QuickSight","description":"Amazon QuickSight","dateCreated":"2020-03-02T07:04:56+0000","dateUpdated":"2022-02-03T03:32:55+0000"},{"id":"GLOBAL#product#kinesis-data-firehose","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis Firehose","description":"Amazon Kinesis F