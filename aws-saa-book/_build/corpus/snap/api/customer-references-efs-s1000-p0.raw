2019-07-22T19:42:52+0000","dateUpdated":"2021-12-22T19:40:56+0000","additionalFields":{"featured":"0","descriptionSummary":"Be Software cut costs 50 percent and more easily enters new geographic markets as a result of moving to AWS. Be Software provides simple, user-friendly SaaS applications for medical-case management and employment services.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/US/600x400_BeSoftware_Logo.8261d24d3970bee4ce73393b888adc9f26a1f0b8.png","displayLocation":"Australia","footerInfoText":"Published Date","description":"\u003cp\u003eBe Software cut costs 50 percent and more easily enters new geographic markets as a result of moving to AWS. Be Software provides simple, user-friendly SaaS applications for medical-case management and employment services. The company uses Amazon EC2 instances to host and run its customer-facing SaaS applications and takes advantage of Amazon EFS to optimize its processing and volume-storage needs.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/besoftware/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Be Software","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Be Software Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12