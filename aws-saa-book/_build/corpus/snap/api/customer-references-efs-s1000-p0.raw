tion Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#product#storage-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Storage Gateway","description":"AWS Storage Gateway","dateCreated":"2020-03-02T07:05:41+0000","dateUpdated":"2022-02-03T03:33:03+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#rs2-smart-processing","locale":"en_US","directoryId":"customer-references","name":"rs2-smart-processing","dateCreated":"2024-02-27T00:36:13+0000","dateUpdated":"2024-02-27T00:48:17+0000","additionalFields":{"descriptionSummary":"Payment technology company RS2 moved its BankWORKS payment processing platform to Amazon Web Services (AWS) to support growth. BankWORKS helps over 250 banks and financial services businesses to execute 80 million transactions an hour. Created by RS2, BankWORKS struggled to maintain growth because of lengthy customer onboarding times. Using AWS, BankWORKS has reduced customer onboarding to 1 month from as much as 1 year and can quickly scale compute resources to accommodate increased demand for its platform. The IT team has also reduced maintenance tasks so it can focus on improving its core products.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/RS2_Logo%401x.7283fa9814ab533e390b401bff6fba11d72ab0fc.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"rs2","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/rs2-smart-processing/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"RS2","publishedDate":"2022","enableShare":"1","headline":"RS2 Speeds Up Customer Onboarding for BankWORKS Payment Platform Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":