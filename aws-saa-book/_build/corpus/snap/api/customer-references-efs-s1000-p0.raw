d":"customer-references#ntt-docomo-innovator","locale":"en_US","directoryId":"customer-references","name":"ntt-docomo-innovator","dateCreated":"2024-06-28T07:22:53+0000","dateUpdated":"2025-02-07T00:06:13+0000","additionalFields":{"descriptionSummary":"A leading mobile telecommunications operator and the largest wireless carrier in Japan, NTT DOCOMO provides services to more than 80 million subscribers. NTT DOCOMO builds on Amazon Web Services (AWS) so that it can deliver more value to customers through innovative, feature-rich services. From serverless technology and data solutions to high-performance compute, the company is increasing the speed and quality of analysis, driving efficiency and cost-effectiveness, and continually improving customer experiences.","featureImageURL":"https://d1.awsstatic.com/NTT-DOCOMO-innovator-tile_300x200.2234f7fc738dffc318106e32c709bbffd8648637.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/logos/200x100_logos/200x100_NTT-DOCOMO_Logo.ac7f6c8181316f06771a87e584a04402b558f8f3.png","displayLocation":"Japan","customerNameLower":"ntt docomo","footerInfoText":"Published Date","description":"\u003cp\u003eDriving efficiency, cost-effectiveness, and improving customer experiences in telecommunications\u003c/p\u003e\n","industry":"Telecommunications","sortDate":"2024-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/innovators/ntt-docomo/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"NTT Docomo","publishedDate":"2024","enableShare":"1","headline":"NTT DOCOMO, Inc. on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#efs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic File System (EFS)","description":"Amazon Elastic File System (EFS)","dateCreated":"2020-03-02T07:02:57+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#japan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Japan","description":"Japan","dateCreated":"2020-02-03T05:29:23+0000","dateUpdated":"2022-02-03T03:31:39+0000"},{"id":"GLOBAL#industry#telecommunications","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Telecommunications","description":"Telecommunications","dateCreated":"2020-01-16T17:42:41+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"customer-references#innovator#apj-innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"APJ Innovator Page or APJ Video Roadshow Page","description":"\u003cp\u003eItems with this tag are featured in the pre-filtered Directory on https://aws.amazon.com/solutions/case-studies/innovators/innovators-apj/. At time of creation, the APJ Customer References lead (@felees) intends to display both APJ Innovator pages and APJ video roadshow pages in this Directory. Thus, items with this tag cannot assumed to be Innovators, as they may have just been part of the video roadshow. Check items for \u003cstrong\u003ecustomer-references#innovator#innovator-hub\u003c/strong\u003e or \u003cstrong\u003ecustomer-references#category#innovator\u003c/strong\u003e to confirm their Innovator status.\u003c/p\u003e\n","dateCreated":"2025-02-06T21:12:38+0000","dateUpdated":"2025-02-06T21:13:04+0000"}]},{"item":{"id":"customer-references#seqera-case-study","locale":"en_US","directoryId":"customer-references","name":"seqera-case-study","dateCreated":"2023-12-23T03:07:21+0000","dateUpdated":"2024-05-07T16:34:55+0000","additionalFields":{"descriptionSummary":"Biotech software company and AWS Partner Seqera achieved six-time revenue growth in 24 months using AWS. The company, which delivers data orchestration solutions that accelerate scientific research, needed to deliver high performance computing at scale. Using AWS Batch and Amazon EC2, Seqera built Seqera Platform, a product that processes petabyte-size workloads cost efficiently. The company has doubled its corporate customer base, increased monthly downloads by 190 percent, and simplified operations for researchers. Using Amazon FSx, it also delivered compatibility with Lustre. Now, Seqera is building a complete data management solution on AWS.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/seqera-logo%401x.0375551833a2912b5be85a5fec460fbebe4618d7.png","displayLocation":"Spain","customerNameLower":"seqera labs","footerInfoText":"Published Date","industry":"Life Sciences","sortDate":"2023-12-07","headlineUrl":"https://aws.amazon.com/solutions/case-studies/seqera-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Seqera Labs","publishedDate":"2023","enableShare":"1","headline":"Reducing Costs by Up to 87% Using AWS Batch with Seqera","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#product#fsx","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon FSx","description":"Amazon FSx","dateCreated":"2021-12-16T04:57:36+0000","dateUpdated":"2022-02-03T03:32:38+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#batch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Batch","description":"AWS Batch","dateCreated":"2020-03-02T07:01:42+0000","dateUpdated":"2022-02-03T03:32:19+0000"},{"id":"GLOBAL#tech-category#containers","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Containers","description":"Containers","dateCreated":"2020-02-13T00:27:17+0000","dateUpdated":"2022-02-03T03:35:26+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#containers","locale":"en_US",