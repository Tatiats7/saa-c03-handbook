-03T03:35:33+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#efs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic File System (EFS)","description":"Amazon Elastic File System (EFS)","dateCreated":"2020-03-02T07:02:57+0000","dateUpdated":"2022-02-03T03:32:32+0000"}]},{"item":{"id":"customer-references#jotabasso","locale":"en_US","directoryId":"customer-references","name":"jotabasso","dateCreated":"2023-06-01T23:04:29+0000","dateUpdated":"2023-06-08T04:07:49+0000","additionalFields":{"descriptionSummary":"A Jotabasso é uma empresa brasileira de sementes e agricultura com sede no Cerrado, que é uma ecorregião de savana tropical que se estende por grande parte do Brasil central e se tornou popular para atividades agrícolas no final dos anos 1990 e início dos anos 2000. A empresa também trabalha com diversos setores de diferentes operações agrícolas.\n\nA Jotabasso se originou no Rio Grande do Sul antes de se mudar para a região do Cerrado na década de 1970. Foi uma das primeiras empresas de sementes daquela região e hoje tem mais de 900 funcionários, com cinco unidades de produção nas áreas centrais do Brasil.\n\nHoje, a empresa é especializada no plantio de soja e outros grãos, como trigo, milho e sorgo, que são usados principalmente como ração animal. A Jotabasso também se aventurou na criação de gado de corte. A organização opera grandes laboratórios de análise de sementes e instalações de armazenamento e criou um sistema integrado de lavoura-pecuária e confinamento para ajudar os agricultores a aumentar a produtividade e a sustentabilidade.\n\nPara manter e expandir todas as suas atividades com maior eficiência, a Jotabasso decidiu procurar um provedor de nuvem que pudesse hospedar seus dados e ajudar a empresa a criar soluções tecnológicas inovadoras para suas operações e usuários.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/jotabasso-logo%402x.e706d28cc6c94d999729b54b3f38986197427921.png","displayLocation":"Brasil","customerNameLower":"jotabasso","footerInfoText":"Data de publicação","industry":"Varejo","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/jotabasso/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Jotabasso","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"Modernizando a agricultura em grande escala com a nuvem AWS"}},"tags":[{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#vpc","locale":"en_US","