spaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#uwi-open-campus","locale":"en_US","directoryId":"customer-references","name":"uwi-open-campus","dateCreated":"2024-08-13T14:54:43+0000","dateUpdated":"2024-08-13T14:59:19+0000","additionalFields":{"descriptionSummary":"The University of the West Indies, Open Campus (UWIOC) needed to leverage technology to achieve higher levels of operational efficiency while reducing costs. By replacing its aging on-premises hardware with Amazon Web Services (AWS) cloud infrastructure, UWIOC realized multiple benefits. Migrating to AWS reduced the amount of time technical staff spent on maintaining hardware and software. As a result, the team could focus on building a new technology platform that would meet the future needs of the campus, accelerate the university’s digital transformation plan, and reduce total cost of ownership (TCO) by 50 percent.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/university-west-indies-logo%401x.b5dccf848fbd4c1725b260351db1754ada3282cc.png","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/university-west-indies-logo%401x.b5dccf848fbd4c1725b260351db1754ada3282cc.png","displayLocation":"Trinidad and Tobago","customerNameLower":"tt - university of the west indies","footerInfoText":"Published Date","industry":"Education","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/uwi-open-campus/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"TT - University of the West Indies","publishedDate":"2021","enableShare":"1","headline":"The University of West Indies, Open Campus accelerates digital transformation and reduces costs by migrating aging hardware to AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T1