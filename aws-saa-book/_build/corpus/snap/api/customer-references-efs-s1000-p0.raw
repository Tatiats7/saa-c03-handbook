_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#customer-segment#strategic","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Strategic","description":"Strategic","dateCreated":"2019-07-22T18:39:52+0000","dateUpdated":"2022-04-02T00:32:18+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#innovator#airbnb","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Airbnb","description":"Airbnb","dateCreated":"2022-09-15T00:48:21+0000","dateUpdated":"2022-09-15T00:48:21+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#efs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic File System (EFS)","description":"Amazon Elastic File System (EFS)","dateCreated":"2020-03-02T07:02:57+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#cncity-2019","locale":"en_US","directoryId":"customer-references","name":"cncity-2019","dateCreated":"2022-03-15T23:58:45+0000","dateUpdated":"2023-07-12T01:40:43+0000","additionalFields":{"descriptionSummary":"After reviewing both domestic and global cloud service providers, CNCITY Energy chose AWS for its stable infrastructure and scalability.","imageSrcUrl":"https://d1.awsstatic.com/International/ko_KR/Customer%20Reference/GEN_customer-case-logo-cncity_840x342_Dec-2019.6440a1464cb99280fd0ef8f91b8f49fb1d1717f0.png","displayLocation":"Korea","footerInfoText":"Published Date","industry":"Power \u0026 Utilities","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/cncity/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","customer-name":"CNCITY Energy","contentType":"Customer Story","headline":"CNCITY Energy is first to adopt AWS Cloud in the industry"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-catego