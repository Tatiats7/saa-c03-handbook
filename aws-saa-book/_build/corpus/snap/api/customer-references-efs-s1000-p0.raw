":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Resilience Hub","description":"AWS Resilience Hub","dateCreated":"2021-11-17T07:15:55+0000","dateUpdated":"2022-02-03T03:32:57+0000"},{"id":"GLOBAL#product#cloud9","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Cloud9","description":"AWS Cloud9","dateCreated":"2020-03-02T07:01:52+0000","dateUpdated":"2022-02-03T03:32:21+0000"},{"id":"GLOBAL#product#cloudtrail","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudTrail","description":"AWS CloudTrail","dateCreated":"2020-03-02T07:02:05+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#product#elasticache-redis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache for Redis","description":"Amazon ElastiCache for Redis","dateCreated":"2020-03-03T00:16:59+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#gsr05102022lknsefgnlkef","locale":"en_US","directoryId":"customer-references","name":"gsr05102022lknsefgnlkef","dateCreated":"2023-02-08T01:16:46+0000","dateUpdated":"2023-07-14T23:32:37+0000","additionalFields":{"descriptionSummary":"GSR provides liquidity by connecting to dozens of crypto exchanges around the world. One of the main requirements is fast and secure connectivity to these locations. GSR leverages multiple regions in the AWS Global Infrastructure for physical proximity to exchanges. For the connectivity, GSR uses AWS PrivateLink or AWS Private Connect. GSR also replicates the data across AWS regions using various technologies, including Aurora Global Databases.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/gsr-logo%401x.6a641e2628cd35423810cceeda38e9a8c31f002b.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"gsr zug gmbh","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-05-10","headlineUrl":"https://youtu.be/U1P8vZTEB-k?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"GSR Zug GmbH","publishedDate":"2022","enableShare":"1","headline":"GSR: A Crypto Market Maker and Ecosystem Partner","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#batch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Batch","description":"AWS Batch","dateCreated":"2020-03-02T07:01:42+0000","dateUpdated":"2022-02-03T03:32:19+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLO