":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#solutions-use-case#uc-smb","locale":"en_US","tagNamespaceId":"GLOBAL#solutions-use-case","name":"Small \u0026 Medium Business","description":"Small \u0026 Medium Business","dateCreated":"2022-08-23T05:49:46+0000","dateUpdated":"2022-08-23T05:49:46+0000"}]},{"item":{"id":"customer-references#varsomics","locale":"en_US","directoryId":"customer-references","name":"varsomics","dateCreated":"2023-06-01T23:06:24+0000","dateUpdated":"2023-07-12T01:35:23+0000","additionalFields":{"descriptionSummary":"Para dar suporte à crescente demanda por exames de sequenciamento genético, a agora Varsomics® - antes Varstation®-, plataforma de bioinformática do Einstein voltada para as áreas de diagnóstico e pesquisa, passou a utilizar a infraestrutura de nuvem da AWS. Com a implementação da tecnologia será possível, entre outros aspectos, expandir as soluções de análises e interpretações de diversos dados.","featureImageURL":"https://d1.awsstatic.com/sap_page/Broadest%20set%20of%20services.1967b42fd82e7fc0610d93ac71ff757c9e4508aa.jpeg","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/varsomics_logo%402x.e154b444e46fc6f8e204c22eb4b06815c6d10f58.png","displayLocation":"Brasil","customerNameLower":"varsomics","footerInfoText":"Data de publicação","industry":"Saúde","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/varsomics/?did\u003dcr_card\u0026t