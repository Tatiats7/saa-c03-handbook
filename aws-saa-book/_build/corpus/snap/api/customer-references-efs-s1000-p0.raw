},{"item":{"id":"customer-references#creative-market-case-study","locale":"en_US","directoryId":"customer-references","name":"creative-market-case-study","dateCreated":"2019-07-22T19:44:12+0000","dateUpdated":"2021-12-22T19:04:58+0000","additionalFields":{"featured":"0","descriptionSummary":"Creative Market moved mission-critical files onto the AWS Cloud, simplifying operations and maintenance and moving closer to its strategic goal of increasing file-size limits for user uploads. Creative Market is a platform on which independent creatives sell digital assets like graphics, templates, and fonts in their online shops.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/CreativeMarket_Customer-Reference_Logo.c2d2ced020e627a4dfb74f7e42eedee951f8710a.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eCreative Market moved mission-critical files onto the AWS Cloud, simplifying operations and maintenance and moving closer to its strategic goal of increasing file-size limits for user uploads.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/creative-market/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Creative Market","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Creative Market Case Study"}},"tags":[{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#use-case#archiving","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Archiving","description":"Archiving","dateCreated":"2020-06-05T06:36:56+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category"