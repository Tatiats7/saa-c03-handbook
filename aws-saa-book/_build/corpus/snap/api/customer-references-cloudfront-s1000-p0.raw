name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notification Service (SNS)","dateCreated":"2020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"customer-references#innovator#mercado-libre","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Mercado Libre","description":"Mercado Libre","dateCreated":"2022-09-15T00:48:36+0000","dateUpdated":"2022-09-15T00:48:36+0000"}]},{"item":{"id":"customer-references#grupo-primo-video-from-es-directory","locale":"en_US","directoryId":"customer-references","name":"grupo-primo-video-from-es-directory","dateCreated":"2024-02-03T03:47:02+0000","dateUpdated":"2024-02-06T01:35:38+0000","additionalFields":{"descriptionSummary":"O Grupo Primo é um grupo de mídia, educação, investimentos e tecnologia. Focado em levar educação em finanças e marketing para os brasileiros, fala com mais de 20 milhões de pessoas todos os meses. O Grupo confiou nas soluções AWS para crescer em seu mercado de atuação, ampliando o seu portfólio de cursos, eventos e ações de marketing sem precisar se preocupar com infraestrutura. O ambiente cloud montado sobre os serviços AWS, com o apoio do parceiro de negócios UDS, permitiu ao grupo, por exemplo, suportar mais de 150 mil pessoas ao vivo na live de lançamento de sua plataforma Finclass. Nesse vídeo, especialistas do Grupo Primo contam como utilizam as soluções em cloud da AWS para se dedicar ao core de sua operação, focando inclusive na internacionalização do negócio.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/grupo-primo-logo%402x.ecb02f9a30f336e6c4d943be3621fd2da778b5dd.png","displayLocation":"Brasil","customerNameLower":"grupo primo","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/grupo-primo-video/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Grupo Primo","enableShare":"1","publishedDate":"2021","contentType":"História do cliente","headline":"Grupo Primo confia na AWS para seguir expandindo suas operações"}},"tags":[{"id":"GLOBAL#product#snow-family","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Snow Family","description":"AWS Snow Family","dateCreated":"2020-03-02T07:05:31+0000","dateUpdated":"2022-02-03T03:33:01+0000"},{"id":"customer-references#category#web-hosting","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Web Hosting","description":"Web Hosting","dateCreated":"2019-07-22T18:32:28+0000","dateUpdated":"2022-03-30T20:30:49+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#snowball","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Snowball","description":"AWS Snowball","dateCreated":"2020-03-02T07:05:27+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0