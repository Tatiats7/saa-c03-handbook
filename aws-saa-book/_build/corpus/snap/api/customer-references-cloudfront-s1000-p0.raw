d":"2022-02-03T03:31:49+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#aerobotics-case-study","locale":"en_US","directoryId":"customer-references","name":"aerobotics-case-study","dateCreated":"2020-11-09T18:03:24+0000","dateUpdated":"2021-12-23T00:55:33+0000","additionalFields":{"featured":"0","descriptionSummary":"Aerobotics was founded in Cape Town, South Africa, in 2014 to help tree-crop farmers solve their pest and disease problems. The company uses machine learning to analyze imagery from drone and satellite photography, allowing farmers to understand the condition of individual trees. Monitoring every tree for pests and diseases on a 50-hectare farm would previously take a farmer an entire day. Aerobotics has reduced this to 20 minutes with drone technology. In this video, Aerobotics Chief Executive Officer James Paterson explains why the firm chose Amazon Web Services (AWS). Built on the AWS Cloud, its product can process large amounts of data and still work reliably for thousands of farmers in remote rural areas. The company runs an auto-scaling microservices architecture with Amazon Elastic Kubernetes Service (Amazon EKS) and serves data to customers using Amazon CloudFront. Its continuous integration and deployment pipelines allow software developers and data scientists to work independently in containerized environments.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Aerobotics_Customer-References_Logo@1x.160065e8a508988e70b8eac2576a2ea3967757b5.png","displayLocation":"South Africa","footerInfoText":"Published Date","industry":"Agriculture","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/aerobotics-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Aerobotics","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Aerobotics Tackles Tree Pests with Machine Learning"}},"tags":[{"id":"GLOBAL#location#middle-east-africa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East \u0026 Africa","description":"Middle East \u0026 Africa","dateCreated":"2020-02-03T05:30:19+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNames