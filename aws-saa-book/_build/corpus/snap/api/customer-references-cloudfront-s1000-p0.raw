cy by offloading all its caching. It now saves around $20,000 a month on ISP costs, has improved the customer experience, and reduced its website loading time by around 75 percent.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Europebet%401x.fc9be678d2881ab122ce3d7c114d4e7e6ab4478e.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"neollet","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/europebet-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Neollet","publishedDate":"2021","enableShare":"1","headline":"Europebet Stays Secure and Competitive Using AWS, Reduces Website Loading Time by 75%","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#shield","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Shield","description":"AWS Shield","dateCreated":"2020-03-02T07:05:24+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"