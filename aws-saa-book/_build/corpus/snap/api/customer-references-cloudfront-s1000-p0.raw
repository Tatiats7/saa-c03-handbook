":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#industry#automotive","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Automotive","description":"Automotive","dateCreated":"2020-01-16T17:42:11+0000","dateUpdated":"2022-02-03T03:32:00+0000"}]},{"item":{"id":"customer-references#aws-case-study-lot-polish-airlines","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-lot-polish-airlines","dateCreated":"2019-07-22T19:52:10+0000","dateUpdated":"2023-07-12T01:40:50+0000","additionalFields":{"featured":"0","descriptionSummary":"LOT Airlines is an award-winning carrier that connects Poland with nearly 60 destinations in Europe. LOT chose AWS to test, deploy, and maintain a mobile web application that allows customers to book and manage flights from their mobile devices.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/LOTPolishAirlines_Customer-Reference_Logo.4084fab7d40e980a1c395f7d998abf938a0f7d0d.png","displayLocation":"Poland","footerInfoText":"Published Date","description":"\u003cp\u003e: LOT Airlines is an award-winning carrier that connects Poland with nearly 60 destinations in Europe. LOT chose AWS to test, deploy, and run a mobile web application that allows customers to book and manage flights from their mobile devices. LOT now offers travelers a reliable, user-friendly mobile flight management tool and the company was able to lower IT maintenance costs.\u003c/p\u003e\r\n","industry":"Transport \u0026 Logistics","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/lot-polish-airlines/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"LOT Polish Airlines","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: LOT Polish Airlines"}},"tags":[{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#cee","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central \u0026 Eastern Europe","description":"Central \u0026 Eastern Europe","dateCreated":"2020-03-10T05:12:39+0000","dateUpdated":"2022-02-03T03:31:41+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#elasticache","locale":"en_US","tagName