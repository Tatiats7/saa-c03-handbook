","tagNamespaceId":"customer-references#industry","name":"government","description":"Government","dateCreated":"2019-07-17T22:21:31+0000","dateUpdated":"2021-02-22T20:33:28+0000"},{"id":"customer-references#product#elb","locale":"en_US","tagNamespaceId":"customer-references#product","name":"elb","description":"ELB","dateCreated":"2019-07-22T18:34:48+0000","dateUpdated":"2021-02-27T00:44:18+0000"},{"id":"customer-references#product#rds","locale":"en_US","tagNamespaceId":"customer-references#product","name":"rds","description":"RDS","dateCreated":"2019-07-22T18:36:41+0000","dateUpdated":"2021-02-27T00:44:14+0000"},{"id":"customer-references#product#cloudfront","locale":"en_US","tagNamespaceId":"customer-references#product","name":"cloudfront","description":"CloudFront","dateCreated":"2019-07-22T18:33:08+0000","dateUpdated":"2021-02-27T00:44:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-delaware-north","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-delaware-north","dateCreated":"2019-07-22T19:53:50+0000","dateUpdated":"2023-07-12T01:40:49+0000","additionalFields":{"featured":"0","descriptionSummary":"Delaware North is a major presence in the food service and hospitality industry, serving more than 500 million customers at 200 venues around the world each year. The company decided to move most of its corporate data center operations to AWS, helping it reduce its server footprint by 91 percent, achieve a projected TCO reduction of at least $3.5 million over five years, improve security compliance and disaster recovery, and vastly streamline the delivery of new services and solutions internally and to its business customers.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Delaware-North_Customer-Reference_Logo.f32d481d086c783519704f440cb28fdd18765ad4.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eDelaware North is a major presence in the food service and hospitality industry, serving more than 500 million customers at 200 venues around the world each year. The company decided to move most of its corporate data center operations to AWS. The migration helped Delaware North reduce its server footprint by 91 percent, achieve a projected TCO reduction of at least $3.5 million over five years, improve security compliance and disaster recovery, and vastly streamline the delivery of new services and solutions internally and to its business customers.\u003c/p\u003e\r\n","industry":"Travel \u0026 Hospitality","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/delaware-north/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Delaware North","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Delaware North"}},"tags":[{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"customer-references#category#business-applications-microsoft","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: Microsoft","d