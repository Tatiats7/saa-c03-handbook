ated":"2022-02-03T03:33:08+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-01-16T17:43:13+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#guardduty","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon GuardDuty","description":"Amazon GuardDuty","dateCreated":"2020-03-02T07:03:46+0000","dateUpdated":"2022-02-03T03:32:40+0000"},{"id":"GLOBAL#tech-category#media-services","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Media Services","description":"Media Services","dateCreated":"2020-07-17T03:06:10+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#elemental-medialive","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental MediaLive","description":"AWS Elemental MediaLive","dateCreated":"2020-03-02T07:03:15+0000","dateUpdated":"2022-02-03T03:32:35+0000"},{"id":"GLOBAL#product#elemental-mediatailor","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental MediaTailor","description":"AWS Elemental MediaTailor","dateCreated":"2020-03-02T07:03:20+0000","dateUpdated":"2022-02-03T03:32:36+0000"}]},{"item":{"id":"customer-references#unam-variation1","locale":"en_US","directoryId":"customer-references","name":"unam-variation1","dateCreated":"2023-06-01T23:06:33+0000","dateUpdated":"2023-06-08T04:07:40+0000","additionalFields":{"descriptionSummary":"La Universidad Nacional Autónoma de México (UNAM), es la más grande e importante universidad pública de México e Iberoamérica. En abril de 2021 firmó un convenio de colaboración con la Secretaría de Educación Pública (SEP) en México, para llevar a cabo los diversos procesos de selección de las maestras y los maestros de Educación Básica y Educación Media Superior. Para ello, la UNAM tuvo como objetivo proveer diferentes servicios de proctoring basados en los servicios de AWS, los cuales incluyeron tanto el diseño, el desarrollo, la aplicación y análisis de resultados, así como la seguridad de los instrumentos de valoración.","featureImageURL":"https://d1.awsstatic.com/gcrp_lockheedmartin_04222022.d2d7ef2dab02b6950c01b92e4a2395cee01caeb8.jpeg","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/unam_logo%402x.831b9453728c0563af48c4e09de1d2c88fa0416e.png","displayLocation":"México","customerNameLower":"unam","footerInfoText":"Fecha de publicación","industry":"Educación","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/unam/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"UNAM","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"Con AWS, UNAM marca hito en materia de valoración a gran escala de maestras y maestros en México"}},"tags":[{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+000