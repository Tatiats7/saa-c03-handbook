 Web Services (AWS). The company now has a flexible and highly available infrastructure with increased insight to support great gaming experiences and continued growth.","featureImageURL":"https://d1.awsstatic.com/customer-references-case-studies-logos/spribe-logo%401x.11a247914a9eb749e5287e8f7bf6846c01878d60.png","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/spribe-logo%401x.11a247914a9eb749e5287e8f7bf6846c01878d60.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"spribe","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2024-08-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/spribe-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Spribe","publishedDate":"2024","enableShare":"1","headline":"Handling 4x More Bets per Minute for SPRIBE’s Aviator Game Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated