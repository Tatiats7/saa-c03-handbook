","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#universidad-privada-del-norte","locale":"en_US","directoryId":"customer-references","name":"universidad-privada-del-norte","dateCreated":"2023-06-01T23:05:10+0000","dateUpdated":"2023-07-14T23:32:38+0000","additionalFields":{"descriptionSummary":"La Universidad Privada del Norte (UPN) tiene ocho sedes entre Lima, Trujillo y Cajamarca, en Perú. Antes de la pandemia ya estaban preparados para una educación virtual, ya que son una universidad de vanguardia que busca llevar educación de calidad a los más de 100 mil estudiantes con los que hoy cuentan. Amazon Web Services les ha permitido mejorar su servicio de cara a los estudiantes, ganaron facilidad de operación, tiempos de respuesta rápida, reutilización de componentes, así como una fácil y rápida integración entre los diferentes sistemas que utilizan.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/upn_logo%401x.fb039fc1cb488ee3b8d3005fd04bfb24f47bb392.png","displayLocation":"Perú","customerNameLower":"universidad privada del norte","footerInfoText":"Fecha de publicación","industry":"Educación","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/universidad-privada-del-norte/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Universidad Privada del Norte","enableShare":"1","publishedDate":"2021","contentType":"Historia del cliente","headline":"Transformación digital de UPN, meta cumplida con AWS"}},"tags":[{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+000