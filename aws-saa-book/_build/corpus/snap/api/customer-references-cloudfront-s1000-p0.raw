0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#unox-it","locale":"en_US","directoryId":"customer-references","name":"unox-it","dateCreated":"2024-09-18T20:02:45+0000","dateUpdated":"2024-09-18T20:08:11+0000","additionalFields":{"descriptionSummary":"UNOX ha rivoluzionato il proprio servizio clienti su Amazon Web Services (AWS) utilizzando Amazon Connect, un contact center cloud omnicanale semplice da utilizzare. Dopo quel successo, UNOX ha deciso di puntare tutto su AWS, migrando il sistema Enterprise Resource Planning (ERP) SAP On-Premise, l\u0027infrastruttura HANA (high-performance analytics appliance), il sito web aziendale e il configuratore di prodotti nel cloud. Ha anche iniziato a utilizzare i servizi serverless di AWS per creare nuovi progetti all\u0027avanguardia per la cottura dei cibi orientata ai dati e i forni smart. Puntando tutto su AWS, UNOX ha registrato un aumento complessivo dei risparmi sui costi, l\u0027ottimizzazione dei tempi e la soddisfazione del cliente.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/unox_Logo%401x.d22b2c3ef3d7b0850664cb466de2a80f9da162b5.png","displayLocation":"Italia","customerNameLower":"unox","footerInfoText":"Data di pubblicazione","industry":"Settore manifatturiero","sortDate":"2021-03-05","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/unox/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"UNOX","enableShare":"1","publishedDate":"2021","contentType":"Storia del cliente","headline":"UNOX soddisfa il 95% delle richieste dei clienti a livello di servizio e promuove l\u0027innovazione puntando tutto su AWS"}},"tags":[{"id":"GLOBAL#location#italy","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Italy","description":"Italy","dateCreated":"2020-02-03T05:30:02+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#connect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Connect","description":"Amazon Connect","dateCreated":"2020-03-02T07:02:22+0000","dateUpdated":"2022-02-03T03:32:26+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#language#italian","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Italian","description":"Italian","dateCreated":"2020-03-03T06:40:49+0000","dateUpdated":"2022-02-03T03:31:25+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03