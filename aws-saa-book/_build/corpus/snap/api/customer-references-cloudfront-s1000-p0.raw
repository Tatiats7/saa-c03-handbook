to deliver website content to users with high availability and low latency.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Zyxel_Customer-Reference_Logo.9068dd663a5ce7d21113eec9a3944498bc2e73d8.png","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003eZyXEL is a world class networking company providing innovative and reliable Internet solutions to businesses worldwide. Searching for a cost-effective CDN solution, the company turned to AWS and uses Amazon CloudFront to deliver website content to users with high availability and low latency. By moving to AWS, ZyXEL has reduced its CDN costs by 99%.\u003c/p\u003e\r\n","industry":"Electronics","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/zyxel/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ZyXel","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"ZyXel Case Study"}},"tags":[{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#taiwan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Taiwan","description":"Taiwan","dateCreated":"2020-02-03T05:29:38+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"C