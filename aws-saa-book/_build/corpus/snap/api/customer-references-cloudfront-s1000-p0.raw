20-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"}]},{"item":{"id":"customer-references#aws-case-study-z2","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-z2","dateCreated":"2019-07-22T19:57:12+0000","dateUpdated":"2021-12-22T19:46:50+0000","additionalFields":{"featured":"0","descriptionSummary":"Z2 produces multiplayer mobile games that offer players an immersive environment with community and social features. By running on AWS, the company can scale quickly to manage worldwide traffic with low latency and gather insights from millions of game sessions to support customers and develop new features.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/Z2-logo.1665a8749cc63ef339c19c0f856f3241066486ad.jpg","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eZ2 produces multiplayer mobile games that offer players an immersive environment with community and social features. The company needed speed and performance to support players worldwide as they interact with each other in real time. By running on AWS, the company can scale quickly to manage worldwide traffic with low latency and gather insights from millions of game sessions to support customers and develop new features.\u003c/p\u003e\r\n","industry":"Gaming","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/z2/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Z2","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Z2"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagName