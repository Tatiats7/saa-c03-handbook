ateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#aws-case-study-daily-voice","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-daily-voice","dateCreated":"2019-07-22T19:53:38+0000","dateUpdated":"2023-07-14T23:32:47+0000","additionalFields":{"featured":"0","descriptionSummary":"Daily Voice provides online news coverage specific to communities throughout Connecticut and New York. The company runs its website infrastructure on AWS. By using AWS, Daily Voice scaled its website to support a 40 percent increase in web traffic and send about 200,000 emails per day to its users.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/daily_voice-logo.43b7dba88dc3b8d7545a62d870ea7edb502d18e2.jpg","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eDaily Voice delivers online news to local communities in Connecticut and New York. The company engaged APN Partner, Apparatus to manage its website infrastructure on AWS, including its web servers, content delivery, and email services. By using AWS, Daily Voice has scaled to support increases in web traffic of up to 40% and send around 200,000 emails per day to its users.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/daily-voice/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Daily Voice","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Daily Voice"}},"tags":[{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":