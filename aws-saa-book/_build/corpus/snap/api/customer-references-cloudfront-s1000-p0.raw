"}]},{"item":{"id":"customer-references#sonyliv","locale":"en_US","directoryId":"customer-references","name":"sonyliv","dateCreated":"2022-03-19T00:19:09+0000","dateUpdated":"2023-08-11T00:24:45+0000","additionalFields":{"descriptionSummary":"SonyLIV Technology relaunched its streaming platform on AWS to improve users’ viewing experience. SonyLIV is an over-the-top platform offering original and acquired content alongside live sporting events and interactive game shows.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/sony-liv-logo%401x.fa703dbee285a32a9e19ae305802087a88329c39.png","displayLocation":"India","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2022-03-18","headlineUrl":"https://aws.amazon.com/solutions/case-studies/sonyliv/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"SonyLIV Technology","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"SonyLIV Grows Subscriber Base Tenfold and Enhances Streaming Platform Supported by AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#elemental-mediaconvert","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental MediaConvert","description":"AWS Elemental MediaConvert","dateCreated":"2020-03-02T07:03:13+0000","dateUpdated":"2022-02-03T03:32:35+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreat