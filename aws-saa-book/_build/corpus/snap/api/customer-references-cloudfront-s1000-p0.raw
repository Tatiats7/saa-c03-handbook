ateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"}]},{"item":{"id":"customer-references#sympla","locale":"en_US","directoryId":"customer-references","name":"sympla","dateCreated":"2023-06-01T23:07:17+0000","dateUpdated":"2023-06-08T04:07:44+0000","additionalFields":{"descriptionSummary":"A Sympla nasceu em 2012 para oferecer serviços de gerenciamento de eventos e venda de ingressos. Nos seis primeiros anos de operação, a companhia teve mais de 220 mil eventos publicados e cerca de 18 milhões de ingressos vendidos. Em 2020, o início da pandemia encerrou a realização de eventos, obrigando a companhia a se reinventar com a oferta de  serviços como eventos online, chats ao vivo e conteúdos sob demanda. A guinada só foi possível graças à flexibilidade e controle de custos oferecidos pela AWS.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/sympla-logo%402x.10a01178e31ae01d870967451a671989c14f5ad9.png","displayLocation":"Brasil","footerInfoText":"Data de publicação","industry":"Software e Internet","sortDate":"2021-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/sympla/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"História do cliente","customer-name":"Sympla","headline":"Flexibilidade da AWS ajuda Sympla a criar novos serviços"}},"tags":[{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#ec2-auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Auto Scaling","description":"Amazon EC2 Auto Scaling","dateCreated":"2020-03-02T07:02:53+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simpl