00","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#hongkong","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Hong Kong","description":"Hong Kong","dateCreated":"2020-02-03T05:29:18+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#queroeducacao","locale":"en_US","directoryId":"customer-references","name":"queroeducacao","dateCreated":"2023-06-01T23:07:43+0000","dateUpdated":"2023-06-08T04:07:44+0000","additionalFields":{"descriptionSummary":"Com o sucesso do programa Quero Bolsa, a instituição decidiu utilizar diretamente a infraestrutura da AWS para outros serviços, garantindo a flexibilidade, a segurança e a escalabilidade necessárias ao negócio.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/Latam%20Cases%20Assets/Logo-Quero-Institucional-Colorido-Tela-RGB%20(1).e219131c74cdf0b8cb433d65cfba05fdb50318f2.png","displayLocation":"Brasil","footerInfoText":"Data de publicação","industry":"Educação","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/queroeducacao/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"História do cliente","customer-name":"Quero Educação","headline":"Com suporte da AWS, Quero Educação conecta estudantes a mais de 6 mil instituições de ensino"}},"tags":[{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"