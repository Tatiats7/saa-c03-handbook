oudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#animaeducacao20200608stdyfugi","locale":"en_US","directoryId":"customer-references","name":"animaeducacao20200608stdyfugi","dateCreated":"2022-05-23T21:40:35+0000","dateUpdated":"2022-05-23T21:52:12+0000","additionalFields":{"descriptionSummary":"Join us to learn how João\u0027s team at Ânima Educação is building a digital platform for students in Brazil. Legacy learning management systems (LMK) are usually based on premises. Frequently students had to stand in long lines to physically register for classes or manage their assignments. Learn how João\u0027s team is migrating from a monolithic, on premises architecture, to a microservices-based architecture on AWS, by leveraging Amazon KMS, optimizing content loading with Amazon Route 53, and integrating Amazon Aurora and Amazon S3 for analytics.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/anima-educacao-logo%401x.360eb39a7909925c6e14b5d21ef24811e0a9eec2.png","displayLocation":"North America","footerInfoText":"Published Date","industry":"Education","sortDate":"2020-06-08","headlineUrl":"https://youtu.be/9yziTe6lBwk?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Ânima Educação: Digitizing Student Experience for Colleges in Brazil","customer-name":"Ânima Educação"}},"tags":[{"id":"GLOBAL#product#key-mgmt-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Key Management Service (KMS)","description":"AWS Key Management Service (KMS)","dateCreated":"2020-03-02T07:04:13+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#tech-category#containers","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Containers","description":"Containers","dateCreat