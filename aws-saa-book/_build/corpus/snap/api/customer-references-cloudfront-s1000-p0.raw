nt#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#category#gaming","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gaming","description":"Gaming","dateCreated":"2019-07-22T18:31:55+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#luisaviaroma-case-study","locale":"en_US","directoryId":"customer-references","name":"luisaviaroma-case-study","dateCreated":"2024-09-18T20:03:23+0000","dateUpdated":"2024-09-18T20:08:10+0000","additionalFields":{"descriptionSummary":"LuisaViaRoma, e-commerce di alta moda che opera in oltre 200 Paesi nel mondo, ha sfruttato la scalabilità del cloud AWS per crescere fino a diventare un vero e proprio gioiello del retail made-in-Italy, prossimo alla quotazione in Borsa. L’azienda ha pianificato una migrazione totale, e oggi i servizi AWS l’aiutano a gestire in sicurezza i diversi picchi delle stagionalità e dei saldi, e a garantire un\u0027eccellente customer experience a milioni di clienti.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/luisaviaroma-logo%401x.547a574253b4590e212214876389f64e9021e1cd.png","displayLocation":"Italia","customerNameLower":"luisaviaroma","footerInfoText":"Data di pubblicazione","industry":"Vendita al dettaglio","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/luisaviaroma-case-study?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"LuisaViaRoma","enableShare":"1","publishedDate":"2023","contentType":"Storia del cliente","headline":"LuisaViaRoma: da boutique ad azienda quotata in Borsa con i servizi AWS"}},"tags":[{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#location#italy","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Italy","description":"Italy","dateCreated":"2020-02-03T05:30:02+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#industry#retail","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Re