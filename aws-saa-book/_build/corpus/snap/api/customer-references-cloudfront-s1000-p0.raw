 Appliances \u0026 Software","dateCreated":"2020-03-02T07:03:10+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"customer-references#homepage-industry#media-entertainment","locale":"en_US","tagNamespaceId":"customer-references#homepage-industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2022-08-24T22:33:50+0000","dateUpdated":"2022-08-24T22:33:50+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"}]},{"item":{"id":"customer-references#postis-case-study","locale":"en_US","directoryId":"customer-references","name":"postis-case-study","dateCreated":"2022-10-03T18:33:42+0000","dateUpdated":"2024-07-11T23:51:24+0000","additionalFields":{"descriptionSummary":"Postis provides a real-time digital platform for logistics automation, optimization, and tracking, helping retailers and delivery companies master the last mile of the journey to their customers, ensuring a good experience from ordering all the way through to receiving goods. The fast-growing Romanian startup uses machine learning to help sellers find the most suitable and cost-effective delivery solution for every type of product, customer journey, or destination. It used AWS to create a scalable system with the power to run heavy machine learning workloads and support its global growth. Postis now serves more than 200 customers in 25 countries using AWS, including big names such as Ikea, Carrefour, Auchan, and Intersport.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/postis-logo%401x.de50b832c0954089af020f08be1489df74385125.png","displayLocation":"Romania","customerNameLower":"postis","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/postis-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Postis","publishedDate":"2022","enableShare":"1","headline":"Postis Simplifies International Deliveries Using ML and AWS SageMaker","contentType":"Customer Story"}},"tags":[{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#cee","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central \u0026 Eastern Europe","description":"Central \u0026 Eastern Europe","dateCreated":"2020-03-10T05:12:39+0000","dateUpdated":"2022-02-03T03:31:41+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","d