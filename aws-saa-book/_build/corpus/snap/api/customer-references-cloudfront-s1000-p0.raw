ription":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#jug-ru-group-pivots-to-online-using-aws-after-pandemic-business-shock","locale":"en_US","directoryId":"customer-references","name":"jug-ru-group-pivots-to-online-using-aws-after-pandemic-business-shock","dateCreated":"2022-10-11T20:30:23+0000","dateUpdated":"2023-07-14T23:32:34+0000","additionalFields":{"descriptionSummary":"JUG Ru Group, an organizer of tech conferences and developer meetups, had to pivot quickly from in-person events to online when the COVID-19 pandemic hit. The JUG Ru Group IT team initially turned to AWS for help with the delivery of HD video. Soon afterward, the team also began using AWS for video production support for 4K quality and secure distribution. By using AWS, JUG Ru Group was also able to secure and defend the digital rights required for its business model—an important emerging issue for all creative companies in Russia that distribute material online.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/jugru-logo%401x.c0842acbd2f813329eb949dfa333770734b0aa72.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"jug.ru","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/JUG-Ru-Group-Pivots-to-Online-using-AWS-after-Pandemic-Business-Shock/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Jug.ru","publishedDate":"2021","enableShare":"1","headline":"JUG Ru Group Responds to Business Shock with Pivot to Online using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#media-services","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Media Services","description":"Media Services","dateCreated":"2020-07-17T03:06:10+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#location#cis","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Commonwealth of Independent States","description":"Commonwealth of Independent States","dateCreated":"2020-04-09T03:33:53+0000","dateUpdated":"2022-02-03T03:31:45+0000"},{"id":"GLOBAL#location#russia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Russia","description":"Russia","dateCreated":"2020-02-03T05:30:14+0000","dateUpdated":"2022-02-03T03:31:46+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#elemental-medialive","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental MediaLive","description":"AWS Elemental MediaLive","dateCreated":"2020-03-02T07:03:15+0000","dateUpdated":"2022-02-03T03:32:35+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content