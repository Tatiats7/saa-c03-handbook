 hardware.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/browan-logo.25b592a5c202f122c94847a561238bea09530129.png","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003eBrowan Communications, based in Taiwan, sells wireless broadband products and services to clients worldwide. The company uses AWS to host its communications app, FreePP, an application that enables voice-over-IP and instant messaging services for its users. By running on AWS, Browan has reduced time to market by eight weeks and can spin up new servers in minutes instead of waiting weeks for hardware.\u003c/p\u003e\r\n","industry":"Telecommunications","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/browan-communications/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Browan Communications","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Browan Communications"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#taiwan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Taiwan","description":"Taiwan","dateCreated":"2020-02-03T05:29:38+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story",