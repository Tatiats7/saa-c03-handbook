dy","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#anz","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia \u0026 New Zealand","description":"Australia \u0026 New Zealand","dateCreated":"2020-04-09T00:26:11+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#aig","locale":"en_US","directoryId":"customer-references","name":"aig","dateCreated":"2023-06-01T23:12:12+0000","dateUpdated":"2023-07-14T23:32:27+0000","additionalFields":{"descriptionSummary":"Ante el escenario y las demandas creadas por la pandemia del COVID-19, la Autoridad Nacional para la Innovación Gubernamental (AIG) enfrentó un importante desafío tecnológico para garantizar la disponibilidad de las aplicaciones y del sitio destinado al soporte del Plan Panamá Solidario. Para asegurar acceso a más de 1,3 millones de familias al sistema de consulta al bono y al crédito disponible, la entidad contó con la ayuda de AWS, que le proporcionó su infraestructura en nube como parte de una acción social de ayuda a los afectados por la pandemia. En pocas horas puso en producción todos los recursos tecnológicos necesarios para asistir al plan de emergencia.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/aig-logo%402x.2032bce3ccbe83116fbee5e9f379f318c3bb3b61.png","displayLocation":"Panamá","footerInfoText":"Fecha de publicación","industry":"Servicios públicos generales","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/aig/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"Autoridad Nacional para la Innovación Gubernamental (AIG)","contentType":"Historia del cliente","headline":"AWS ayuda a gobierno de Panamá a mantener plan de emergencia durante la pandemia"}},"tags":[{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#web-hosting","locale":"en_US","tagNamespaceId":"customer-references