269bacde8096a176d55fda31c890970029a72.jpg","displayLocation":"France","footerInfoText":"Published Date","description":"\u003cp\u003eAlcatel Lucent, a French global telecommunication solutions provider, created OpenTouch Video Store, an online service for enterprises dedicated to the creation and sharing of video content. The company uses AWS to transcode, store and deliver the video content available on its platform to customers located around the world. By using AWS, the company can now roll out new instances in under 5 minutes and ensure high availability and reliability for its service. Watch full video: https://www.youtube.com/watch?v\u003dIkREYHYGCpA\u003c/p\u003e\r\n","industry":"Telecommunications","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/alcatel-lucent/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Alcatel-Lucent","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Alcatel-Lucent"}},"tags":[{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":