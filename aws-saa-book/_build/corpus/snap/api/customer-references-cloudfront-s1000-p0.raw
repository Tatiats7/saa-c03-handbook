tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-yplan","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-yplan","dateCreated":"2019-07-22T19:56:27+0000","dateUpdated":"2023-07-14T23:32:41+0000","additionalFields":{"featured":"0","descriptionSummary":"YPlan is a mobile-only app that allows people to browse a curated list of the best events in their city and book tickets in just two taps. By using AWS right from the start, YPlan quickly grew its user base to 500,000 and experiences availability close to 100 percent.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/yplan_logo.4277406cd68ccfa122fc1deed0f82152812b83c8.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","description":"\u003cp\u003eYPlan is a mobile-only app that allows people to browse a curated list of the best events in their city and book tickets in just two taps. By using AWS right from the start, YPlan quickly grew its user base to 500,000 and experiences availability close to 100%.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/yplan/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"YPlan","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: YPlan"}},"tags":[{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated"