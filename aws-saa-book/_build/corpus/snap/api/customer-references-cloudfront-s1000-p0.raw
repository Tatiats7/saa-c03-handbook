KIKO ha scelto Amazon Web Services (AWS) per le interessanti opzioni di prezzo e l\u0027ampia varietà di servizi integrati, non disponibili presso la concorrenza. AWS inoltre disponeva di vari data center fisici posizionati nelle regioni in cui KIKO opera ed era perciò in grado di ridurre i problemi di latenza riscontrati con il fornitore precedente.","imageSrcUrl":"https://d1.awsstatic.com/kiko%20logo_standard_K(1).3e57c32037bae42ca74543890384cc80f7f17144.png","displayLocation":"Italia","customerNameLower":"kiko milano","footerInfoText":"Data di pubblicazione","industry":"Servizi professionali","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/kiko-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"KIKO Milano","enableShare":"1","publishedDate":"2021","contentType":"Storia del cliente","headline":"KIKO punta tutto su AWS per trasformare l\u0027azienda"}},"tags":[{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#language#italian","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Italian","description":"Italian","dateCreated":"2020-03-03T06:40:49+0000","dateUpdated":"2022-02-03T03:31:25+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-cate