6eacute; assur\u0026eacute;es par AWS. e-TF1 utilise Amazon EKS pour dimensionner rapidement ses applications \u0026agrave; base de microservices ex\u0026eacute;cut\u0026eacute;es en mode Container as a Service (CaaS) et garantir ainsi un acc\u0026egrave;s 24/7 au contenu de MYTF1.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/eTF1%20-%20logo.f0bae88a79cdf334c4acecbd61739fa98446e452.png","displayLocation":"Europe, Moyen-Orient et Afrique","footerInfoText":"Date de publication","industry":"Multimédia et divertissement","enableShare":"1","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/tf1-cloudreach/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"Témoignages clients","customer-name":"TF1 x Cloudreach","headline":"e-TF1 permet de suivre les plus grands événements en ligne grâce à AWS"}},"tags":[{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T