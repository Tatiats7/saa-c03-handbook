 Qube Cinema is a global provider of end-to-end digital cinema technology and solutions. The company is using Amazon S3, Amazon S3 Glacier, and Amazon S3 Glacier Deep Archive to store and archive films indefinitely along with Amazon CloudFront for secure data transfers.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(@1x---@2x)/Qubewire_logo@1x.4b28bce900e9a8f341f527d6c70053d4dc957079.png","displayLocation":"India","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2021-06-17","headlineUrl":"https://aws.amazon.com/solutions/case-studies/qube-cinema/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"Qube Cinema","contentType":"Customer Story","headline":"Qube Cinema Takes Movies from Stage to Screen Faster on AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#product#sso","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Single Sign-On (SSO)","description":"AWS Single Sign-On (SSO)","dateCreated":"2020-03-02T07:05:37+0000","dateUpdated":"2023-06-01T00:45:24+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#product#glacier","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon S3 Glacier","description":"Amazon S3 Glacier","dateCreated":"2020-03-02T07:03:38+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#tech-categor