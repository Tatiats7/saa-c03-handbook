BAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#molotov-ynpact","locale":"en_US","directoryId":"customer-references","name":"molotov-ynpact","dateCreated":"2023-07-17T23:59:24+0000","dateUpdated":"2023-07-18T00:18:09+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eMolotov, service de distribution de cha\u0026icirc;nes de t\u0026eacute;l\u0026eacute;vision par Internet, s\u0026rsquo;est retrouv\u0026eacute; lors des confinements confront\u0026eacute; \u0026agrave; des hausses de trafic importantes qui ont pouss\u0026eacute; son architecture \u0026agrave; ses limites. La migration des multiples services qui sous-tendent Molotov sur le Cloud AWS, effectu\u0026eacute;e avec l\u0026rsquo;aide d\u0026rsquo;Ynpact, AWS Select Consulting Partner, a d\u0026eacute;-risqu\u0026eacute; la plateforme, tout en permettant \u0026agrave; Molotov de d\u0026eacute;velopper sa culture DevOps.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Molotov%20-%20logo.aeef0e78848491b90a55e9fafc3afde51582b3e5.png","displayLocation":"Europe, Moyen-Orient et Afrique","footerInfoText":"Date de publication","industry":"Multimédia et divertissement","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/molotov-ynpact/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Molotov","enableShare":"1","publishedDate":"2022","contentType":"Témoignages clients","headline":"Comment Molotov vous fait adorer la télévision grâce à Ynpact et AWS"}},"tags":[{"id":"GLOBAL#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Mid-Market Territory (MMT)","description":"Mid-Market Territory (MMT)","dateCreated":"2021-06-04T06:35:43+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#tech-category#devtools","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Developer T