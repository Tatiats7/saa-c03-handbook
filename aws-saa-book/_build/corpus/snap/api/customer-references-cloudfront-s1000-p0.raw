00:59:44+0000","dateUpdated":"2021-12-22T22:39:52+0000","additionalFields":{"featured":"0","descriptionSummary":"Studos uses the AWS Cloud to deliver a platform that analyzes the skills and abilities of students in basic education. The company\u0027s goal is to enable Brazilian students to better prepare for college entrance exams. Studos uses Amazon S3, Amazon CloudFront, Amazon Aurora, and the support and guidance of the AWS EdStart program to scale its platform to approximately 10,000 daily users and more than 150,000 users per week.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/studos-logo%401x.1b50358f40561d047496ab80a687e1c765e22387.png","displayLocation":"Brazil","footerInfoText":"Published Date","industry":"Education","sortDate":"2020-12-30","headlineUrl":"https://aws.amazon.com/solutions/case-studies/studos/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Studos","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Studos Helps Students in Brazil Prepare for University Entrance Exams with Assistance from AWS EdStart"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-0