#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-seat-pagine-gialle","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-seat-pagine-gialle","dateCreated":"2019-07-22T19:50:39+0000","dateUpdated":"2023-07-14T23:32:43+0000","additionalFields":{"featured":"0","descriptionSummary":"SEAT Pagine Gialle, the Italian Yellow Pages company, helps its customers achieve visibility through print, voice, and web. Using AWS, SEAT PG can scale to handle its customers\u0027 needs and has cut deployment time for new applications from three to four weeks to just a few days.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/SEATPagineGialle_Customer-Reference_Logo.34ada2cb8af15288bf00a1ea1628c9aa8c8162ee.png","displayLocation":"Italy","footerInfoText":"Published Date","description":"\u003cp\u003eSEAT Pagine Gialle provides website hosting and marketing services to small and medium businesses in Italy. The company uses AWS to host its customers? websites, to build and deploy web applications, and to conduct business intelligence and data mining activities. By using AWS, SEAT PG can scale to handle its customers? needs and has cut deployment time for new applications from three to four weeks to just a few days.\u003c/p\u003e\