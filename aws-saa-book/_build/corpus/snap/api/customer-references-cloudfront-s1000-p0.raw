ools","dateCreated":"2020-01-16T17:43:16+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#industry#automotive","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Automotive","description":"Automotive","dateCreated":"2020-01-16T17:42:11+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#product#database-migration-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Database Migration Service (DMS)","description":"AWS Database Migration Service (DMS)","dateCreated":"2020-03-02T07:02:30+0000","dateUpdated":"2022-02-03T03:32:27+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#stoodi","locale":"en_US","directoryId":"customer-references","name":"stoodi","dateCreated":"2023-06-01T23:05:03+0000","dateUpdated":"2024-04-30T13:24:05+0000","additionalFields":{"descriptionSummary":"Criada em 2013, o Stoodi é uma startup de educação, parte do grupo Cogna, que tem o objetivo de ajudar estudantes do ensino médio a ingressarem no ensino superior. Desde sua fundação, os recursos de preparação para o Enem e vestibulares da startup foram utilizados por mais de 8 milhões de alunos. A operação do Stoodi já nasceu na nuvem AWS, mas o crescimento acelerado alavancado pelo período de pandemia exigiu da startup uma operação mais eficiente da nuvem, garantindo estabilidade, disponibilidade e segurança. O Stoodi passou a contar com a área de Professional Services da AWS, obtendo ganhos como redução anual total de 25% dos custos totais de AWS que foram parcialmente investidos para melhorar a estabilidade e postura de segurança dos seus produtos.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/stoodi%402x.464772c8a1590a9693032496b334c3b0d9a31402.png","displayLocation":"Brasil","customerNameLower":"stoodi","footerInfoText":"Data de publicação","industry":"Educação","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/stoodi/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Stoodi","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"Uso de Serviços Profissionais AWS reduz em 25% gastos totais com nuvem do Stoodi"}},"tags":[{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:3