02-27T00:44:53+0000","dateUpdated":"2022-01-21T02:44:23+0000","additionalFields":{"descriptionSummary":"Overwhelmed hospitals need fast, accurate medical imaging to quickly diagnose and treat patients affected by the COVID-19 pandemic. Many facilities have few radiologists on staff, and heavy workloads contribute to burnout.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/radboudumc_Logo%401x.c9a000d9c52e7b905aae702343660026481fa106.png","displayLocation":"Netherlands","footerInfoText":"Published Date","industry":"Education","sortDate":"2021-02-26","headlineUrl":"https://aws.amazon.com/solutions/case-studies/radboud-university-medical-center/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Radboud University Builds Machine Learning Solutions for Medical Imaging on AWS","customer-name":"Radbound University Medical Center"}},"tags":[{"id":"GLOBAL#location#netherlands","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Netherlands","description":"Netherlands","dateCreated":"2020-02-03T05:29:50+0000","dateUpdated":"2022-02-03T03:31:41+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Afr