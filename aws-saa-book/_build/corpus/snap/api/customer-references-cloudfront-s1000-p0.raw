19-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#dishtv-case-study","locale":"en_US","directoryId":"customer-references","name":"dishtv-case-study","dateCreated":"2020-01-30T05:19:14+0000","dateUpdated":"2021-12-22T19:19:12+0000","additionalFields":{"descriptionSummary":"By building its end-to-end OTT solution on AWS, DishTV was able to launch it in seven months compared to the industry average of 12 to 14 months. DishTV is an Indian satellite TV provider with 25 million active subscribers. The company uses AWS Elemental to process video content, Amazon ECS for container orchestration, and Amazon Rekognition to flag inappropriate content on user-driven channels.","imageSrcUrl":"https://d1.awsstatic.com/events/aws-hosted-events/2019/APAC/case-studies/dishtv-case-studies.70d18f7753622ea89fe84e37239b2f3274901a80.png","displayLocation":"India","footerInfoText":"Published Date","description":"By building its end-to-end OTT solution on AWS, DishTV was able to launch it in seven months compared to the industry average of 12 to 14 months. DishTV is an Indian satellite TV provider with 25 million active subscribers. The company uses AWS Elemental to process video content, Amazon ECS for container orchestration, and Amazon Rekognition to flag inappropriate content on user-driven channels.","industry":"Media \u0026 Entertainment","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/dishtv/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Dishtv","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Dishtv Case Study"}},"tags":[{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","na