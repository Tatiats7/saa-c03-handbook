/p\u003e\r\n","industry":"Education","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/cross-knowledge/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"CrossKnowledge","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: CrossKnowledge"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#