uct managers ou développeurs, ce service leur fait gagner un temps précieux et contribue également à accélérer le temps de chargement des images sur leurs sites web et applications mobile de l’ordre de 80 % en moyenne sur des images non optimisées.","imageSrcUrl":"https://d1.awsstatic.com/FR%20Marketing/2017/Case%20studies/Cloudimage.c060634276a6860c944dc5e08f8d23f9dd7c390d.PNG","displayLocation":"France","customerNameLower":"scaleflex","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2019-09-07","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/cloudimage/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Scaleflex","publishedDate":"2019","enableShare":"1","headline":"Cloudimage et le traitement massif d’images dans le cloud","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#p