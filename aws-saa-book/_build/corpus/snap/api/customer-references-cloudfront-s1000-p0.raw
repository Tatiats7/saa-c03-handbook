mespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-remind","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-remind","dateCreated":"2019-07-22T19:51:02+0000","dateUpdated":"2022-01-21T02:41:36+0000","additionalFields":{"featured":"0","descriptionSummary":"Remind is a web and mobile application that enables U.S. school teachers to send text messages to students and stay in touch with parents. Remind built its platform as a service on Amazon ECS and runs its entire messaging application infrastructure on AWS. Using Amazon ECS has significantly improved application performance and freed Remind\u0027s engineers to focus on developing and deploying applications.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Remind_Customer-Reference_Logo.2e892e8e7b72f90bec14687629405f7cca77d3b1.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRemind is a communication tool that helps teachers connect instantly with students and parents by sending quick, simple messages to any device. Remind leverages the breadth and scalability of the AWS cloud to deliver more than 200 million messages a month between parents, teachers, and students while supporting 400,000 new users per day during back-to-school season. The company has built an open-source developer platform called Empire that leverages Amazon EC2 Container Service (Amazon ECS) to support 30 applications, 36 Amazon ECS container instances, and 244 containers in production.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/remind/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Remind","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Remind"}},"tags":[{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#tech-category#containers","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Containers","description":"Containers","dateCreated":"2020-02-13T00:27:17+0000","dateUpdated":"2022-02-03T03:35:26+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US