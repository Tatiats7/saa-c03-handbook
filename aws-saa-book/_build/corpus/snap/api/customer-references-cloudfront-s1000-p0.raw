gNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#category#infrastructure","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Infrastructure","description":"Infrastructure","dateCreated":"2019-07-22T18:32:04+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#location#nordics","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Nordics","description":"Nordics","dateCreated":"2020-02-03T05:30:04+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-cenique","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-cenique","dateCreated":"2019-07-22T19:53:45+0000","dateUpdated":"2023-07-14T23:32:45+0000","additionalFields":{"featured":"0","descriptionSummary":"Cenique\u0027s shopper-insight and digital-signage solutions provide retailers across the globe with an easy way to analyze in-store customer behavior and optimize marketing strategies accordingly. The company migrated its analytics platform to AWS after experiencing frequent downtime with on-premises servers. By moving to AWS, Cenique has reduced its operating costs by 60 percent and scaled to support a tenfold increase in customers.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Cenique_Customer-Reference_Logo.67fcecfa7d2528f44bf54af670a5bbfdbb52751d.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","description":"\u003cp\u003eCenique?s shopper-insight and digital-signage solutions provide retailers across the globe an easy way to analyze in-store customer behavior and optimize marketing strategies accordingly. The company migrated its analytics platform to AWS after experiencing frequent downtime with on-premises servers. By moving to AWS, Cenique has reduced its operating costs by 60 percent and scaled to support a tenfold increase in customers.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/cenique/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Cenique","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Cenique"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","descriptio