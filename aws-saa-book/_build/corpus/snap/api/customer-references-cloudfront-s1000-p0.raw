28eaeeab124a03ca.png","displayLocation":"Americas","customerNameLower":"western governors university","footerInfoText":"Published Date","industry":"Education","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/wgu-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Western Governors University","publishedDate":"2022","enableShare":"1","headline":"WGU Prepares Students for Industry Success by Working with AWS Education Programs to Bolster Cloud Computing Degree","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#customer-enablement#training-cert","locale":"en_US","tagNamespaceId":"GLOBAL#customer-enablement","name":"Training \u0026 Certification","description":"Training \u0026 Certification","dateCreated":"2020-09-04T04:06:29+0000","dateUpdated":"2022-02-03T03:31:13+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#cu