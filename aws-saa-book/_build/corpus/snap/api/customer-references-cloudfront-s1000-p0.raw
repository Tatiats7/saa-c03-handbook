000"}]},{"item":{"id":"customer-references#marketplacer-case-study","locale":"en_US","directoryId":"customer-references","name":"marketplacer-case-study","dateCreated":"2021-10-01T01:55:32+0000","dateUpdated":"2023-07-14T23:32:50+0000","additionalFields":{"descriptionSummary":"Marketplacer enables websites to launch social commerce marketplaces in just a few weeks while increasing the efficiency of its DevOps and data scientists with AWS. Marketplacer offers a marketplace platform that allows companies to launch their own online marketplaces. It uses Amazon ECS to orchestrate the application container and AWS Fargate to automate scaling.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Marketplacer_logo%401x.822d1ea1bc37e22c509bc07116fb3e557b5155ac.png","displayLocation":"Australia","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/marketplacer-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"Marketplacer","contentType":"Customer Story","headline":"Marketplacer Drives Social Commerce with Online Marketplaces on AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer