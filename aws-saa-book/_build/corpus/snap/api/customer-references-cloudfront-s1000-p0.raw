"id":"customer-references#ascenderhcm","locale":"en_US","directoryId":"customer-references","name":"ascenderhcm","dateCreated":"2020-12-02T23:22:08+0000","dateUpdated":"2023-07-14T23:32:50+0000","additionalFields":{"featured":"0","descriptionSummary":"Since migrating to the AWS Cloud, Ascender HCM has seen a fourfold increase in compute and storage capabilities while reducing TCO by double digits. Ascender HCM provides payroll software to over 1.3 million customers and their employees worldwide. The company uses Amazon CloudFront for content delivery, AWS Web Application Firewall for protecting customer-facing applications, and Amazon GuardDuty for threat monitoring.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Ascender_logo%401x.e8d5497d97d2fda10f18e21b34703d108220f70e.png","displayLocation":"Australia","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2020-12-02","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ascenderhcm/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ascender HCM","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Ascender Empowers People-First Organizations with AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Optimization","description":"\u003cp\u003eCost Optimization\u003c/p\u003e\n","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2023-07-13T00:08:24+0000"},{"id":"GLOBAL#location#australia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia","description":"Australia","dateCreated":"2020-02-03T05:29:12+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#security-identity-com