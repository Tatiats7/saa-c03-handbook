ed":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#use-case#general-database-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"General Database Migration","description":"General Database Migration","dateCreated":"2020-06-05T06:37:24+0000","dateUpdated":"2022-02-03T03:35:41+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"}]},{"item":{"id":"customer-references#sao-leopoldo-mandic-case-study","locale":"en_US","directoryId":"customer-references","name":"sao-leopoldo-mandic-case-study","dateCreated":"2024-08-16T12:46:12+0000","dateUpdated":"2024-08-16T12:49:00+0000","additionalFields":{"descriptionSummary":"Com cerca de 30 anos de atuação, a Faculdade São Leopoldo Mandic está entre as dez melhores instituições de ensino de saúde do País. Seus cursos de graduação e pós-graduação na área de Odontologia são oferecidos em dez unidades distribuídas pelo País e uma em Portugal, e os de Medicina em mais três unidades de graduação nas cidades de Araras (SP), Limeira (SP) e Arcoverde (PE). A instituição conta ainda com laboratórios de simulação realística, recursos modernos para diagnóstico e treinamento e Hub de Inovação, além de projetos como o Barco da Saúde, que leva atendimento médico e odontológico às comunidades carentes.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/sao-leopoldo-mandic-logo%401x.ffdabc8c6