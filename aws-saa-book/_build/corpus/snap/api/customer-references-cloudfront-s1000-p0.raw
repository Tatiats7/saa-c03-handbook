ry#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#vmware","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"VMware Cloud on AWS","description":"VMware Cloud on AWS","dateCreated":"2020-03-02T07:05:59+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#chile","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Chile","description":"Chile","dateCreated":"2020-07-02T22:30:55+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"}]},{"item":{"id":"customer-references#dailyrounds-case-study","locale":"en_US","directoryId":"customer-references","name":"dailyrounds-case-study","dateCreated":"2023-01-18T00:47:45+0000","dateUpdated":"2023-07-14T23:32:28+0000","additionalFields":{"descriptionSummary":"DailyRounds is an India-based healthcare company that provides an online community for medical professionals and access a drug information database known as the India Drug Index. The company grew from around 500,000 to over 2 million users between 2018 to 2022. As it moves into its next phase, DailyRounds is exploring expanding into new markets, while enhancing its user experience. This started with a modernization of its infrastructure on AWS to improve its workflows and agility, allowing it to innovate at greater speed.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Dailyrounds_logo%401x.70ac877f0500159816905cfba88888b80ae0f8a3.png","displayLocation":"India","customerNameLower":"dailyrounds","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/dailyrounds-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"DailyRounds","publishedDate":"2022","enableShare":"1","headline":"DailyRounds Enhances the Learning Experience for 2 Million Medical Professionals With AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"