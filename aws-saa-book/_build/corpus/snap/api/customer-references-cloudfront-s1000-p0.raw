y migrating to AWS to utilize the content delivery service Amazon CloudFront and increase its existing usage of Amazon S3.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/PBS_Customer-Reference_Logo.6781b52d5bc6c09e4d5398c58c3aa1dbc48464a3.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003ePBS, a private, non-profit corporation, provides content through television, the Web and mobile applications. PBS Interactive, the department responsible for PBS\u0019 Internet and mobile presence, improved its video streaming performance by migrating to Amazon Web Services (AWS) to utilize the content delivery service Amazon CloudFront and increase its existing usage of Amazon Simple Storage Service (Amazon S3).\u003c/p\u003e\r\n","industry":"Telecommunications","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/pbs/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"PBS","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: PBS"}},"tags":[{"id":"GLOBAL#industry#telecommunications","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Telecommunications","description":"Telecommunications","dateCreated":"2020-01-16T17:42:41+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreate