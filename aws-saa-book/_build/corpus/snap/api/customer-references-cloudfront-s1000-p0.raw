eSrcUrl":"https://d1.awsstatic.com/case-studies/jp/u-next_logo.ab810853aed78032ef90704364b06e1c8d39cd8e.png","displayLocation":"Japan","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2022-01-28","headlineUrl":"https://aws.amazon.com/solutions/case-studies/u-next_2022/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"U-NEXT Co., Ltd. Attracts More Viewers Running Multi-angle Livestreaming on AWS","customer-name":"U-NEXT Co., Ltd."}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#elemental-mediaconnect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental MediaConnect","description":"AWS Elemental MediaConnect","dateCreated":"2020-03-02T07:03:12+0000","dateUpdated":"2022-02-03T03:32:35+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T0