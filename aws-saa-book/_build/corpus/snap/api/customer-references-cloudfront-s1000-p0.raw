type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-wetransfer","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-wetransfer","dateCreated":"2019-07-22T19:55:09+0000","dateUpdated":"2023-07-14T23:32:41+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, WeTransfer  seamlessly handles more than 40 million active users, who transfer about 1 billion files each month, generating traffic peaks of 15 GB of data per second. Based in the Netherlands and the United States, the company provides a file- transfer service that makes it easy for users to send files of up to 20 GB in size.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Wetransfer_Customer-Reference_Logo.1de11d5f27ad6284e01c1876954f1a8fa803bd01.png","displayLocation":"Netherlands","footerInfoText":"Published Date","description":"\u003cp\u003eUsing AWS, WeTransfer seamlessly supports more than 40 million active users, who transfer about 1 billion files each month, generating traffic peaks of 15 GB of data per second. Based in the Netherlands and the United States, the company provides a file- transfer service that makes it easy for users to send files of up to 20 GB in size. WeTransfer uses AWS Enterprise Support to maintain high availability and deliver a consistently excellent customer experience.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/wetransfer/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"WeTransfer","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: WeTransfer"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id