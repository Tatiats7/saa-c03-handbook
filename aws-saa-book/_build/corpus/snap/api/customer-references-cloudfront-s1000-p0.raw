ent and improving scalability. On the cloud, the agency would also gain access to a wide range of AWS services for everything from managing user traffic to strengthening security.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/dosm-logo%401x.73724077506bd78f6fe3e5aaed1f3f09b7754726.png","displayLocation":"Malaysia","footerInfoText":"Published Date","industry":"General Public Services","sortDate":"2022-03-23","headlineUrl":"https://aws.amazon.com/solutions/case-studies/dosm-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"DOSM Helps Nine Million Users Access Malaysia Census Data on AWS","customer-name":"Department of Statistics Malaysia"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#asean","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"ASEAN","description":"ASEAN","dateCreated":"2020-08-20T03:53:05+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"GLOBAL#location#malaysia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Malaysia","description":"Malaysia","dateCreated":"2020-02-03T05:29:27+0000","dateUpdated":"2022-02-03T03:31:36+0000"},{"id":"customer-references#customer-segment#public-sector-govt","locale":"en_US","tag