iption":"AWS Elastic Beanstalk","dateCreated":"2020-03-02T07:03:00+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Auto Scaling","description":"AWS Auto Scaling","dateCreated":"2020-03-02T07:01:39+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"customer-references#category#developer-tools","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Developer Tools","description":"\u003cp\u003eHost code, build, test, and deploy your applications quickly and effectively with AWS developer tools. Leverage core tools like software development kits (SDKs), code editors, and continuous integration and delivery (CI/CD) services for DevOps software development. Use machine learning (ML) -guided best practices and abstractions to improve agility, security, velocity, and code quality.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:14:12+0000","dateUpdated":"2023-07-14T01:14:12+0000"}]},{"item":{"id":"customer-references#korean-broadcasting-system-case-study","locale":"en_US","directoryId":"customer-references","name":"korean-broadcasting-system-case-study","dateCreated":"2019-07-19T14:56:37+0000","dateUpdated":"2022-12-22T17:42:25+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, Korean Broadcasting System (KBS) scales to meet surges in demand for media content, completes jobs with just a few clicks, and saves 50 percent on event services. KBS is a public broadcasting station that broadcasts many types of programs in Korea and other parts of the world.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/KBS_Customer-Reference_Logo.7e85766e364eecf951767d92685fbdf0dfda499a.png","displayLocation":"Korea","footerInfoText":"Published Date","description":"\u003cp\u003eKBS is a public broadcasting station that broadcasts many types of programs in Korea and other parts of the world. KBS is the first broadcasting station that successfully migrated all of its customer service to AWS Cloud, and it has closed the previous data center. AWS has migrated the ones that were previously done by the equipment by using AWS Elemental MediaLive and AWS Elemental MediaConvert.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/kbs/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Korean Broadcasting System","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Korean Broadcasting System Case Study"}},"tags":[{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-0