"imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Trimble_Customer-Reference_Logo.96b79e6e26ebfa4417b3239f43496aedb1ca959d.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eWhen Trimble, a leading advanced positioning technology and mobile solutions provider, purchased a 3D modeling product, the company estimated that it would take 36 months to reformat 2.5 million 3D images using its on-premises compute resources. By using AWS, Trimble was able to reformat all of the images in only one month. The company continues to save $20,000 per month on storage costs using AWS and now has the compute capacity to deliver the 3D software and images to customers worldwide.\u003c/p\u003e\r\n","industry":"Electronics \u0026 Semiconductors","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/trimble/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Trimble","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Trimble"}},"tags":[{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-0