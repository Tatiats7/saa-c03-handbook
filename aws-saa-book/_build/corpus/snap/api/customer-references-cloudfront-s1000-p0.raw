,"tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#methodology#devops","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"DevOps","description":"DevOps","dateCreated":"2020-06-05T07:06:27+0000","dateUpdated":"2022-02-03T03:32:10+0000"}]},{"item":{"id":"customer-references#aws-case-study-webmotors","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-webmotors","dateCreated":"2019-07-22T19:51:52+0000","dateUpdated":"2021-12-22T19:48:50+0000","additionalFields":{"featured":"0","descriptionSummary":"WebMotors, based in Sao Paulo, Brazil, hosts a website on which users can post and browse through classified ads to buy and sell vehicles. The company migrated its website to AWS, improving its performance by 45 percent, saving $100,000, and enabling it to scale up to meet the needs of more than 20 million unique visitors per month.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/WebMotors_Customer-Reference_Logo.a6f48c6bf7e8665eb3c0121bdd504a9d501f8703.png","displayLocation":"Latin America","footerInfoText":"Published Date","description":"\u003cp\u003eBrazilian company WebMotors hosts a website where users can post and browse through classified ads to buy and sell vehicles. After migrating its website to AWS, WebMotors can now scale to meet the needs of more than 20 million unique visitors per month while improving website performance and reducing costs by $100,000.\u003c/p\u003e\r\n","industry":"Automotive","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/webmotors/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Webmotors","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Webmotors"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:43+0000","dateUpdated":"2022-02-03T03:36:00+0000"},{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type",