-03T03:32:46+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"}]},{"item":{"id":"customer-references#spryker-innovator","locale":"en_US","directoryId":"customer-references","name":"spryker-innovator-de","dateCreated":"2024-06-28T07:22:51+0000","dateUpdated":"2024-09-20T20:36:23+0000","additionalFields":{"descriptionSummary":"In weniger als einem Jahrzehnt hat sich Spryker vom Tech-Startup zu einem 600 Mitarbeiter starken Unternehmen mit Niederlassungen auf der ganzen Welt entwickelt. Als führendes Unternehmen im Bereich Enterprise-Commerce-Software nutzt das Unternehmen AWS, um seinen über 150 Geschäftskunden zusammensetzbare Lösungen anzubieten, die ihnen helfen, Kundeninteraktionen zu maximieren und den Umsatz zu steigern. Dank der Flexibilität, in der Cloud zu skalieren und innovativ zu sein, kann sich Spryker darauf konzentrieren, neue Services zu entwickeln und mehr Unternehmenskunden an Bord zu holen. Es gibt Kunden die Gewissheit, dass sie die Datenschutzvorschriften – von Europa über die USA bis China – einhalten und die AWS-Services und -Ressourcen zum Datenschutz nutzen.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/spryker-logo%401x.ae275e9934d670eada191dc8784d3f07fe402a64.png","displayLocation":"Deutschland","customerNameLower":"spryker","footerInfoText":"0","industry":"Software und Internet","sortDate":"2024-01-01","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/innovators/spryker/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Spryker","publishedDate":"2024","enableShare":"1","headline":"Spryker in AWS","contentType":"Kundengeschichte"}},"tags":[{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#germany","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Germany","description":"Germany","dateCreated":"2020-02-03T05:29:55+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"