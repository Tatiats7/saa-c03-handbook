4+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"}]},{"item":{"id":"customer-references#usiminas-enkel-2024","locale":"en_US","directoryId":"customer-references","name":"usiminas-enkel-2024","dateCreated":"2025-01-22T01:19:23+0000","dateUpdated":"2025-03-06T17:56:10+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eA Usiminas, com apoio da Enkel, parceira AWS, enfrentou desafios em precifica\u0026ccedil;\u0026atilde;o de frete e otimiza\u0026ccedil;\u0026atilde;o de rotas. Ao desenvolver uma plataforma de automa\u0026ccedil;\u0026atilde;o personalizada com base nos servi\u0026ccedil;os da AWS, a sider\u0026uacute;rgica brasileira otimizou processos log\u0026iacute;sticos, levando a uma redu\u0026ccedil;\u0026atilde;o de 14% nos custos, com ganhos significativos de efici\u0026ecirc;ncia. O projeto n\u0026atilde;o apenas reduziu as dist\u0026acirc;ncias de entrega em 448.000 quil\u0026ocirc;metros, mas tamb\u0026eacute;m resultou em uma redu\u0026ccedil;\u0026atilde;o not\u0026aacute;vel nas emiss\u0026otilde;es de CO2, evitando a libera\u0026ccedil;\u0026atilde;o de 1.577 toneladas m\u0026eacute;tricas. Este projeto aumenta a competitividade da Usiminas e refor\u0026ccedil;a seu compromisso com a sustentabilidade ambiental.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Usiminas%20Logo%20200x70px.f50354f914efa99d2bf77fe282e174dc7f796548.png","footerInfoText":"2024","industry":"Manufacturing","sortDate":"2024-11-12","enableShare":"1","headlineUrl":"https://aws.amazon.com/pt/partners/success/usiminas-enkel/","publishedDate":"2024","contentType":"Case Study","headline":"Usiminas, com Apoio da Enkel, Reduz R$ 9 Milhões em Custos de Transporte com Serviços da AWS"}},"tags":[{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-0