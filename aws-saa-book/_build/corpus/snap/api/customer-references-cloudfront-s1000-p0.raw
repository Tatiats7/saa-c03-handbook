,{"item":{"id":"customer-references#optoma-case-study","locale":"en_US","directoryId":"customer-references","name":"optoma-case-study","dateCreated":"2022-07-29T23:20:02+0000","dateUpdated":"2022-07-29T23:21:38+0000","additionalFields":{"featured":"0","descriptionSummary":"\u003cp\u003eBy leveraging the AWS Cloud, Optoma can launch new products 56 percent faster while ensuring service stability and real-time interaction around the globe. Optoma is a leader in the display technology market, serving corporate, education, and individual customers in 159 countries. The company uses Amazon S3 for reliable data storage, Amazon RDS for MariaDB to manage its databases, and Amazon CloudFront as a low-latency content delivery network.\u003c/p\u003e\r\n","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/optoma-logo%401x.bf3164545140727e58167bdca724b0997c3f4b36.png","displayLocation":"Taiwan","customerNameLower":"optoma","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2022-07-29","headlineUrl":"https://aws.amazon.com/solutions/case-studies/optoma-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Optoma","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Optoma Facilitates Virtual Collaboration with Hybrid Learning Platform on AWS"}},"tags":[{"id":"GLOBAL#location#taiwan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Taiwan","description":"Taiwan","dateCreated":"2020-02-03T05:29:38+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#elasticache-redis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache for Redis","description":"Amazon ElastiCache for Redis","dateCreated":"2020-03-03T00:16:59+0000",