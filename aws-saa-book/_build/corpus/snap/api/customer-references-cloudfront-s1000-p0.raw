ce","description":"AWS Application Migration Service","dateCreated":"2022-08-15T20:58:56+0000","dateUpdated":"2022-09-24T05:36:20+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#cloudsearch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudSearch","description":"Amazon CloudSearch","dateCreated":"2020-03-02T07:02:03+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#ses","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Email Service (SES)","description":"Amazon Simple Email Service (SES)","dateCreated":"2020-03-02T07:05:22+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#certificate-mgr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Certificate Manager","description":"AWS Certificate Manager","dateCreated":"2020-03-02T07:01:45+0000","dateUpdated":"2022-02-03T03:32:20+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"}]},{"item":{"id":"customer-references#thuga-syneco-case-study","locale":"en_US","directoryId":"customer-references","name":"thuga-syneco-case-study","dateCreated":"2024-08-13T14:55:16+0000","dateUpdated":"2024-08-13T14:59:18+0000","additionalFields":{"descriptionSummary":"Syneco Trading GmbH, a subsidiary of the Thüga Group and eins energie in sachsen GmbH \u0026 Co. KG, provides municipal utilities with digital services for every stage of the energy sales and procurement process. Syneco has evolved from an energy-trading house to a software-as-a-service (“SaaS”) provider. Syneco’s customer portal, Synection, is based on a cloud-native application that runs on AWS infrastructure, which further improves Syneco\u0027s ability to innovate. Thanks to the new services offered under Syneco’s customer portal, municipal utilities can offer their customers better energy prices, procure energy efficiently, and manage risks transparently.","featureImageURL":"https://d1.awsstatic.com/emea-customer-references/emea-directory-customer-logos/Syneco-Customer-References-Logo%401x.2a61589bce2f388510c194c80f774e7693f119db.png","imageSrcUrl":"https://d1.awsstatic.com/emea-customer-references/emea-directory-customer-logos/Syneco-Customer-References-Logo%401x.2a61589bce2f388510c194c80f774e7693f119db.png","displayLocation":"Germany","customerNameLower":"thüga ag","footerInfoText":"Published Date","industry":"General Public Services","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/thuga-syneco-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Thüga AG","publishedDate":"2023","enableShare":"1","headline":"Syneco Provides Energy Sales and Procurement Services Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#dach","locale":"en_US","tag