Updated":"2022-10-31T22:41:41+0000","additionalFields":{"descriptionSummary":"Isha Foundation is a non-profit organization offering in-person and online courses and events to a growing number of users globally. To support this growth and securely deliver content with low latency, Isha Foundation migrated its customer relationship management (CRM), content management system (CMS), and website application to AWS.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Isha_foundation_logo%401x.0ae13a1aea1076cc36e57e458904db9d416c4862.png","displayLocation":"India","customerNameLower":"isha foundation","footerInfoText":"Published Date","industry":"Social Services","sortDate":"2022-10-31","headlineUrl":"https://aws.amazon.com/solutions/case-studies/isha-foundation-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ISHA Foundation","publishedDate":"2022","enableShare":"1","headline":"Isha Foundation Delivers on its Mission for Millions by Transforming Content Delivery on AWS","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#public-sector-nonprofit","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Nonprofit","description":"Nonprofit","dateCreated":"2019-07-22T18:39:49+0000","dateUpdated":"2022-05-09T21:31:14+0000"},{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:43+0000","dateUpdated":"2022-02-03T03:36:00+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#industry#social-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Social Services","description":"Social Services","dateCreated":