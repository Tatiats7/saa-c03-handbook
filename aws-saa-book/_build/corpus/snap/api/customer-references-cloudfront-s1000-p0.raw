le":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#tech-category#media-services","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Media Services","description":"Media Services","dateCreated":"2020-07-17T03:06:10+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#streamamg-case-study","locale":"en_US","directoryId":"customer-references","name":"streamamg-case-study","dateCreated":"2022-12-13T02:08:19+0000","dateUpdated":"2022-12-13T02:15:27+0000","additionalFields":{"descriptionSummary":"StreamAMG enables organisations across sports, media and betting to deliver video content at scale and offer exceptional streaming experiences. In 2020, with COVID-19 disruption growing and matches played behind closed doors, the company began planning for a very different season – one where more users than ever would rely on its over-the-top (OTT) platforms to support their club, and clubs would increasingly rely on streamed matches as a revenue source. By moving AWS, the company delivered 2.9 million streams, watched by hundreds of thousands of fans, and an overall data uplift of 500 percent – all without a hitch and with no updates to the architecture needed.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/streamamg-logo%401x.e6fd697e61e9ae6b7f10148e0d608b914ab084d3.png","displayLocation":"United Kingdom","customerNameLower":"streamamg ltd","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2022-12-02","headlineUrl":"https://aws.amazon.com/solutions/case-studies/StreamAMG-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"StreamAMG Ltd","publishedDate":"2022","enableShare":"1","headline":"StreamAMG Scores Record Viewership and Uninterrupted Delivery","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#location#uk","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United Kingdom","description":"United Kingdom","dateCreated":"2020-02-03T05:30:18+0000","dateUpdated":"2022-02-03T03:31:52+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","