00","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#product#ec2-spot-instances","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Spot Instances","description":"Amazon EC2 Spot Instances","dateCreated":"2022-04-26T06:27:16+0000","dateUpdated":"2022-04-26T06:27:16+0000"}]},{"item":{"id":"customer-references#universidad-andres-bello","locale":"en_US","directoryId":"customer-references","name":"universidad-andres-bello","dateCreated":"2023-06-01T23:04:52+0000","dateUpdated":"2023-06-08T04:07:42+0000","additionalFields":{"descriptionSummary":"La Universidad Andrés Bello es una universidad privada chilena creada en 1988. Desde 2020, pertenece a la Fundación Educación y Cultura. Es una de las cuatro universidades chilenas que figuran en el Academic Ranking of World Universities, adjudicándose el lugar 4. El desafío que enfrentan y en el cual están trabajando es la transformación digital de la institución, que posibilite la automatización de varios de sus procesos y poner a disposición de sus cerca de 60 mil estudiantes, las herramientas tecnológicas que les ayuden a llevar a buen puerto (y con gran velocidad) sus investigaciones y la obtención de nuevas habilidades para su vida profesional futura. Es decir, a mejorar la experiencia de los estudiantes y potenciar la investigación al interior de la universidad.","featureImageURL":"https://d1.awsstatic.com/industry-images-customer-references/higher-ed-students.7b60dabacba659c986a7ec8dc61c3032e77b3362.jpg","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/universidad-andres-bello-logo%402x.22b778414817944a247ee4662f655f5f1aa111be.png","displayLocation":"Chile","customerNameLower":"univ. andres bello","footerInfoText":"Fecha de publicación","industry":"Educación","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/universidad-andres-bello/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Univ. Andres Bello","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"Estudiantes e investigadores mejor preparados para el futuro a través de AWS"}},"tags":[{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"N