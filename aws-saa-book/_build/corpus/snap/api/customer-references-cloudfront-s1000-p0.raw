 \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-aldebaran-robotics","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-aldebaran-robotics","dateCreated":"2019-07-22T19:54:50+0000","dateUpdated":"2021-12-22T19:02:14+0000","additionalFields":{"featured":"0","descriptionSummary":"Aldebaran, a french robotics company, aims to create a family of companion robots that positively influence our daily lives at home and in school environments. By using AWS, the company has gained agility and flexibility and can now make changes to its website infrastructure on the fly while freeing staff to focus on robotics rather than infrastructure.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/AldebaranRobotics_Customer-Reference_Logo.ad279816690ba3d17a0e035d53465ba02979564d.png","displayLocation":"France","footerInfoText":"Published Date","description":"\u003cp\u003eAldebaran, a french robotics company, aims to create a family of companion robots that positively influence our daily lives at home and in school environments. The company uses AWS for storage and to host its website and application store for its robots. By using AWS, the company has gained agility and flexibility and can now make changes to its website infrastructure on the fly while freeing staff to focus on robotics rather than infrastructure. Video can also be found at: https://www.youtube.com/watch?v\u003dBPKgY8nTIoc\u003c/p\u003e\r\n","industry":"Manufacturing","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/aldebaran-robotics/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Aldebaran Robotics","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Aldebaran Robotics"}},"tags":[{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+