 serverless technologies, AWS Amplify, and AWS AppSync to rapidly design and develop Salary Overflow.  You will learn how S3 and CloudFront are used to serve the web application, how AWS Cognito and Lambda are used for user authentication, how AppSync and Aurora persist data, and how Pinpoint is used for analytics. This architecture not only automatically scales to handle user demand, but is flexible enough to allow rapid iteration and experimentation.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/salary-overflow-logo%401x.41a60e02687d93581c1eaf5e22bc93831dd0cb93.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2020-12-02","headlineUrl":"https://youtu.be/Xi6tDqctLsY?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Salary Overflow: Bringing Transparency to Tech Salaries","customer-name":"Salary Overflow"}},"tags":[{"id":"GLOBAL#product#appsync","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS AppSync","description":"AWS AppSync","dateCreated":"2020-03-02T07:01:32+0000","dateUpdated":"2022-02-03T03:32:17+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Star