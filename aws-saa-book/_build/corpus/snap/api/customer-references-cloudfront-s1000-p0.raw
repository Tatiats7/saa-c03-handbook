 lounges, airport terminal hotels, and airport hospitality services in more than 180 locations. The group uses AWS CloudTrail for log retention, Amazon CloudFront for low-latency content delivery, and Amazon API Gateway to build its software-as-a-service solution.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/PPG_logo@1x.40eb19bbe6e1d152392a94c78e5943ba1eef5919.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","industry":"Travel \u0026 Hospitality","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/plaza-premium/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Plaza Premium Group","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Plaza Premium Digitalizes the Travel Journey on AWS"}},"tags":[{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17