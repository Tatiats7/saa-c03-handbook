L#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"}]},{"item":{"id":"customer-references#deriv-case-study","locale":"en_US","directoryId":"customer-references","name":"deriv-case-study","dateCreated":"2024-05-03T14:28:37+0000","dateUpdated":"2025-03-06T23:23:19+0000","additionalFields":{"descriptionSummary":"Deriv, one of the world’s largest online brokers, faced challenges accessing vast amounts of data spread across various platforms. It turned to AWS for help and adopted Amazon Q Business, a generative artificial intelligence (AI) tool, to retrieve and process data from multiple sources. By setting up connections to Slack, Google Docs, Google Drive, Web Crawler, and GitHub, Amazon Q Business quickly became integral across departments, including customer support, marketing, content creation, and recruiting. By leveraging Amazon Q Business, Deriv reduced the time spent onboarding new hires by 45 percent, minimized recruiting task times by 50 percent, and dramatically streamlined campaign management for marketing teams.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Logo%20Deriv%401x.a6b1d2486e9fbe8d1f6dea093ea48cb3b0cbdf00.png","displayLocation":"Malaysia","customerNameLower":"deriv","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2024-04-15","headlineUrl":"https://aws.amazon.com/solutions/case-studies/deriv-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Deriv","publishedDate":"2024","enableShare":"1","headline":"Deriv Boosts Productivity and Reduces Onboarding Time by 45% with Amazon Q Business","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#malaysia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Malaysia","description":"Malaysia","dateCreated":"2020-02-03T05:29:27+0000","dateUpdated":"2022-02-03T03:31:36+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateC