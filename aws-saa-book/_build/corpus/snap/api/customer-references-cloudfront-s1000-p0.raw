m used Amazon Web Services (AWS) to build SHOPFLIX.gr—a new online marketplace in Greece—in 9 months. The company used Amazon Aurora and Amazon CloudFront to create a high-performance, scalable marketplace that grew to over 1 million active monthly customers in just 18 months. AWS Partner Performance Technologies helped SHOPFLIX.gr cost-optimize its infrastructure on AWS and save 25 percent on infrastructure costs.","imageSrcUrl":"https://prod-us-west-2.aem-author.marketing.aws.a2z.com/assetdetails.html/content/dam/partner-network/partner_marketing_web_team/600x400-logos/shopflix.gr_600x400px.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"shopflix.gr","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2024-01-18","headlineUrl":"https://aws.amazon.com/partners/success/shopflix-performance-technologies/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"SHOPFLIX.gr","publishedDate":"2024","enableShare":"1","headline":"Online Marketplace SHOPFLIX.gr Gains More Than 1 Million Customers in 18 Months Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2023-07-15T01:16:11+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic K