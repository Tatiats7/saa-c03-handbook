Created":"2020-03-02T07:03:39+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#product#codepipeline","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodePipeline","description":"AWS CodePipeline","dateCreated":"2020-03-02T07:02:13+0000","dateUpdated":"2022-02-03T03:32:25+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#aircall","locale":"en_US","directoryId":"customer-references","name":"aircall","dateCreated":"2023-06-01T23:06:02+0000","dateUpdated":"2023-08-11T22:26:58+0000","additionalFields":{"videoSrcUrl":"https://www.youtube.com/watch?v\u003dLs_sAtUTCJM","descriptionSummary":"\u003cp\u003eFond\u0026eacute;e en 2014, Aircall est une soci\u0026eacute;t\u0026eacute; qui fournit une solution de t\u0026eacute;l\u0026eacute;phonie d\u0026rsquo;entreprise int\u0026eacute;gr\u0026eacute;e aux outils quotidiens tels que Salesforce ou Hubspot. Elle comprend l\u0026rsquo;achat de num\u0026eacute;ros de t\u0026eacute;l\u0026eacute;phone \u0026agrave; l\u0026rsquo;international et la possibilit\u0026eacute; de passer et recevoir des appels tr\u0026egrave;s simplement via une application compl\u0026egrave;te et interactive. Pierre-Baptiste BECHU, Co-founder \u0026amp; VP, t\u0026eacute;moigne de leur plus grand d\u0026eacute;fi et leur plus grande force : la fiabilit\u0026eacute; des services. L\u0026rsquo;entreprise s\u0026rsquo;est naturellement tourn\u0026eacute;e vers AWS d\u0026egrave;s 2014 pour 2 raisons : la pr\u0026eacute;sence \u0026agrave; l\u0026rsquo;international et la fiabilit\u0026eacute; des services. La logique de partenariat technologique avec AWS a permis de r\u0026eacute;soudre la probl\u0026eacute;matique de la croissance exponentielle d\u0026rsquo;Aircall tout en r\u0026eacute;pondant aux meilleurs standards de qualit\u0026eacute; et de s\u0026eacute;curit\u0026eacute; des donn\u0026eacute;es clients. Le Cloud AWS a contribu\u0026eacute; \u0026agrave; scaler le business d\u0026rsquo;Aircall, dont le trafic est multipli\u0026eacute; par deux tous les 18 mois, ainsi qu\u0026rsquo;\u0026agrave; int\u0026eacute;grer des fonctionnalit\u0026eacute;s d\u0026rsquo;IA et de machine learning.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/aircall_Logo.cfb4a1612930e52d9fbcc80aec3831e71454c2e0.jpg","displayLocation":"France","customerNameLower":"aircall","footerInfoText":"Date de publication","industry":"Télécommunications","sortDate":"2022-07-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/aircall/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Aircall","enableShare":"1","publishedDate":"2022","contentType":"Témoignages clients","headline":"Aircall : Une solution de téléphonie intransigeante sur la fiabilité de ses services, visant une empreinte mondiale"}},"tags":[{"id":"GLOBAL#product#marketplace","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Marketplace","description":"AWS Marketplace","dateCreated":"2020-12-02T20:02:51+0000","dateUpdated":"2022-02-03T03:32:50+0000"},{"id":"GLOBAL#product#iot-fleetwise","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS IoT FleetWise","description":"AWS IoT FleetWise","dateCreated":"2021-12-16T04:57:37+0000","dateUpdated":"2022-02-03T03:32:43+0000"},{"id":"GLOBAL#product#amplify","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Amplify","description":"AWS Amplify","dateCreated":"2020-03-02T07:01:21+0000","dateUpdated":"2022-02-03T03:32:15+0000"},{"id":"GLOBAL#product#transfer-family","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Transfer Family","description":"AWS Transfer Family","dateCreated":"2020-08-20T04:00:34+0000","dateUpdated":"2022-02-03T03:33:04+0000"},{"id":"GLOBAL#product#xray","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS X-Ray","description":"AWS X-Ray","dateCreated":"2020-03-03T00:18:27+0000","dateUpdated":"2022-02-03T03:33:08+0000"},{"id":"GLOBAL#product#all","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"All","description":"All","dateCreated":"2020-03-02T07:01:18+0000","dateUpdated":"2022-02-03T03:32:15+0000"},{"id":"GLOBAL#product#drs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elastic Disaster Recovery (DRS)","description":"AWS Elastic Disaster Recovery (DRS)","dateCreated":"2022-01-06T00:53:39+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#elemental-mediaconnect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental MediaConnect","description":"AWS Elemental MediaConnect","dateCreated":"2020-03-02T07:03:12+0000","dateUpdated":"2022-02-03T03:32:35+0000"},{"id":"GLOBAL#product#robomaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS RoboMaker","description"