{"items":[{"item":{"id":"customer-references#fair-trade-innovator","locale":"en_US","directoryId":"customer-references","name":"fair-trade-innovator","dateCreated":"2025-05-12T15:21:25+0000","dateUpdated":"2025-05-12T15:25:20+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eFair Trade USA uses AWS to improve working conditions for farmers.\u003c/p\u003e\n","featureImageURL":"https://d2908q01vomqb2.cloudfront.net/9e6a55b6b4563e652a23be9d623ca5055c356940/2025/03/21/fair_trade_usa_header-1024x512.png","featured":"0","displayLocation":"North America","customerNameLower":"fair trade","footerInfoText":"Published Date","description":"\u003cp\u003eFair Trade USA\u003cstrong\u003e\u0026trade;\u003c/strong\u003e is a nonprofit organization that is committed to eliminating poverty by promoting sustainable development through ethical trade.\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u0026nbsp;\u003c/p\u003e\n","industry":"Non profit","sortDate":"2025-03-21","headlineUrl":"https://aws.amazon.com/blogs/publicsector/how-fair-trade-usa-uses-aws-to-improve-working-conditions-for-farmers/","customer-name":"Fair Trade","enableShare":"1","publishedDate":"2025","contentType":"Customer Story","headline":"Fair Trade on AWS"}},"tags":[{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39