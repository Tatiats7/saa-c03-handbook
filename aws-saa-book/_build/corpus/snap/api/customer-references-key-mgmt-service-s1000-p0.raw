y","name":"Business Applications: Microsoft SQL","description":"Business Applications: Microsoft SQL","dateCreated":"2019-07-22T18:31:19+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#workload#microsoft","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"Microsoft","description":"Microsoft","dateCreated":"2021-01-06T00:09:49+0000","dateUpdated":"2022-02-03T03:36:04+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#aws-case-study-cardflight","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-cardflight","dateCreated":"2019-07-22T19:52:35+0000","dateUpdated":"2023-07-14T23:32:39+0000","additionalFields":{"featured":"0","descriptionSummary":"Payment startup CardFlight allows merchants to integrate EMV chip card payments into their existing mobile apps. The company\u0027s payment platform, which encrypts customers\u0027 sensitive financial information and delivers it to payment processors securely, is hosted on AWS. The PCI-compliant infrastructure has helped CardFlight bring its solution to market faster, while reducing IT capital expenditure and operating expenditure by around 40 percent compared to building and maintaining an in-house data center.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/CardFlight_Customer-Reference_Logo.34b7d853de065f9f57f0dd01463f85ffaf83ebe6.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eCardFlight brought its solution to market faster while reducing IT capex and opex approximately 40 percent by using an AWS PCI-compliant infrastructure instead of building and maintaining an on-premises data center. CardFlight is a payment solutions startup that helps merchants integrate EMV chip-card payments into existing mobile apps. The solution encrypts customers? sensitive financial information and delivers it to payment processors securely.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/cardflight/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"CardFlight","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: CardFlight"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#key-mgmt-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Key Management Service (KMS)","description":"AWS Key Management Service (KMS)","dateCreated":"2020-03-02T07:04:13+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US",