acute;s orient\u0026eacute;s s\u0026eacute;curit\u0026eacute;, associ\u0026eacute;s \u0026agrave; des processus d\u0026rsquo;automatisation de gestion de la charge, a permis de r\u0026eacute;aliser ces objectifs en ma\u0026icirc;trisant la dette technique et en limitant les co\u0026ucirc;ts.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/javelo-logo%401x.9080b91d7a2525a389ae07cc84d589f7a8d6e7cb.png","displayLocation":"France","customerNameLower":"javelo","footerInfoText":"Published Date","industry":"Other","sortDate":"2023-08-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/javelo/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Javelo","publishedDate":"2023","enableShare":"1","headline":"Javelo révolutionne la gestion des talents en entreprise en passant sur le Cloud AWS grâce à A1 Cloud Technologies","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#key-mgmt-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Key Management Service (KMS)","description":"AWS Key Management Service (KMS)","dateCreated":"2020-03-02T07:04:13+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#industry#other","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Other","description":"Other","dateCreated":"2020-06-13T03:24:41+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"F