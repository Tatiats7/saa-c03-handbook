oudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#quasar","locale":"en_US","directoryId":"customer-references","name":"quasar","dateCreated":"2023-06-01T23:06:29+0000","dateUpdated":"2023-06-08T04:07:46+0000","additionalFields":{"descriptionSummary":"Criada em 2019, a Quasar é uma consultoria especializada no desenvolvimento de softwares de gestão pública. No início de 2021, a empresa fechou um grande contrato com o governo de Minas Gerais, que representou crescimento e, ao mesmo tempo, o desafio de adequar seus preços para que pudesse levar suas soluções a municípios com até 20 mil habitantes. Com o apoio da AWS, a Quasar conseguiu redesenhar sua arquitetura, reduzindo seus custos em 90% e deixando-a pronta para atender este novo público.","featureImageURL":"https://d1.awsstatic.com/awsmp/solutions/security/rsinstititeu_cloudimage.20c280149af28044b9fdc570ce88f534e828a103.png","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/quasar_logo%402x.cd3754713ac6806a4230a2ab5230445c1c3eade3.png","displayLocation":"Brasil","customerNameLower":"quasar","footerInfoText":"Data de publicação","industry":"Serviços públicos gerais","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/quasar/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Quasar","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"Estrutura em nuvem AWS permite à Quasar levar serviços a pequenos municípios"}},"tags":[{"id":"GLOBAL#product#ses","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Email Service (SES)","description":"Amazon Simple Email Service (SES)","dateCreated":"2020-03-02T07:05:22+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#ecr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Registry (ECR)","description":"Amazon Elastic Container Registry (ECR)","dateCreated":"2020-03-02T07:02:55+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"