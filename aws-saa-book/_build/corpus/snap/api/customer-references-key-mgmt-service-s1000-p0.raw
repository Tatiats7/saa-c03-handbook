#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#hightail-case-study","locale":"en_US","directoryId":"customer-references","name":"hightail-case-study","dateCreated":"2019-07-22T19:44:30+0000","dateUpdated":"2021-12-22T19:20:50+0000","additionalFields":{"featured":"0","descriptionSummary":"Hightail moved multiple petabytes of customer data to AWS, enabling the company to improve performance by up to 17 times and cut the time to deploy to new regions from 24 weeks to 2 weeks. Hightail enables teams of marketers, creatives, external agencies, and freelancers to collaborate on visual content, accelerating creative review and approval cycles with intuitive and accessible tools.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Hightail_Customer-Reference_Logo.a929a52365df821e04aede69cea114cad87469a0.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eHightail moved multiple petabytes of customer data to AWS, enabling the company to improve performance by up to 17 times and cut the time to deploy to new regions from 24 weeks to 2 weeks. Hightail enables teams of marketers, creatives, external agencies, and freelancers to collaborate on visual content, accelerating creative review and approval cycles with intuitive and accessible tools. The company uses Amazon S3 as its storage solution, removing the need to manage infrastructure and allowing it to focus on developing innovative customer experiences.\u003c/p\u003e\r\n","industry":"Electronics","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/hightail/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Hightail","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Hightail Case Study"}},"tags":[{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#key-mgmt-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Key Management Service (KMS)","description":"AWS Key Management Service (KMS)","dateCreated":"2020-03-02T07:04:13+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29: