nt, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#exxon-mobil-case-study","locale":"en_US","directoryId":"customer-references","name":"exxon-mobil-case-study","dateCreated":"2020-11-12T18:43:59+0000","dateUpdated":"2023-07-12T01:40:44+0000","additionalFields":{"featured":"0","descriptionSummary":"ExxonMobil Global Projects Company built a platform on AWS that uses automation and real-time collaboration for document review, potentially saving 30,000 engineering hours per major capital project.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/exxon-mobil-logo@1x.254969c84828fed1a494cc4842ff6d92c46c6c46.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Energy","sortDate":"2020-11-12","headlineUrl":"https://aws.amazon.com/solutions/case-studies/exxon-mobil-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Exxon Mobil","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"ExxonMobil Global Projects Company Transforms Collaboration on Major Capital Projects Using AWS, with Projected Savings of Thousands of Engineering Hours"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":