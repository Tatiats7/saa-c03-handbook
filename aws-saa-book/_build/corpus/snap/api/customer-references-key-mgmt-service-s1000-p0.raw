ns","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#tech-category#containers","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Containers","description":"Containers","dateCreated":"2020-02-13T00:27:17+0000","dateUpdated":"2022-02-03T03:35:26+0000"},{"id":"GLOBAL#product#ec2-auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Auto Scaling","description":"Amazon EC2 Auto Scaling","dateCreated":"2020-03-02T07:02:53+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#telemedik-aws","locale":"en_US","directoryId":"customer-references","name":"telemedik-aws","dateCreated":"2023-06-01T23:10:25+0000","dateUpdated":"2023-07-14T23:32:26+0000","additionalFields":{"descriptionSummary":"Grupo Telemedik, el centro de contacto de telesalud más grande en Puerto Puerto Rico y Latinoamérica, es conformado por cuatro compañías en Puerto Rico y una sucursal en Barcelona (España). Con cerca de 500 asientos y bajo la misión de llevar las más innovadoras soluciones de salud a sus clientes, la compañía tenía una carencia de tecnología que le imposibilitaba alcanzar la innovación para impactar aún más la vida de sus pacientes. En este vídeo, el Dr. Joaquín Fernández, presidente y fundador de TeleMedik; Wanda López, directora de centro de contactos; y José Figeroa, director de sistema de información y tecnología, detallan cómo la empresa implementó soluciones de Amazon Web Services de la mano con el partner Symbee para establecer la plataforma Telemedik Global Cloud Solution, con la cual Telemedik logra desarrollar nuevos servicios de manera segura, rápida y sencilla para sus clientes.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/telemedik-logo%402x.0756e27c02673daf30985791289ba8dba73e3a4c.png","displayLocation":"Puerto Rico","footerInfoText":"Fecha de publicación","industry":"Telecomunicaciones","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/telemedik-aws/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"Telemedik","contentType":"Historia del cliente","headline":"Telemedik desarrolla plataforma cloud de innovación basada en servicios AWS"}},"tags":[{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notification Service (SNS)","dateCreated":"2020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#product#ses","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Email Service (SES)","description":"Amazon Simple Email Service (SES)","dateCreated":"2020-03-02T07:05:22+0000","dateUpdated":"202