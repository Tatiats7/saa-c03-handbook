n_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-perfect-corp","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-perfect-corp","dateCreated":"2020-01-30T01:08:13+0000","dateUpdated":"2021-12-22T19:06:05+0000","additionalFields":{"descriptionSummary":"Building its SaaS software on AWS has allowed Perfect Corp. to ensure GDPR compliance for global beauty brands in 67 countries, exceed 99.58 percent service availability with robust architecture, gain 25 percent cost savings by pre-allocating resources during peak periods, and maintain a latency of three seconds or less for live streaming tool. Taiwan-based Perfect Corp. gives consumers the ability to virtually try on makeup by using its AR- and AI-enabled software.","imageSrcUrl":"https://d1.awsstatic.com/events/aws-hosted-events/2019/hkt/PF_Logo.4f170fb030b5cd026b3b047dd2dd0ac1f7ce8381.png","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"Building its SaaS software on AWS has allowed Perfect Corp. to ensure GDPR compliance for global beauty brands in 67 countries, exceed 99.58 percent service availability with robust architecture, gain 25 percent cost savings by pre-allocating resources during peak periods, and maintain a latency of three seconds or less for live streaming tool. Taiwan-based Perfect Corp. gives consumers the ability to virtually try on makeup by using its AR- and AI-enabled software.","industry":"Retail","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/Perfect-Corp/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Perfect Corp.","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"AWS Case Study - Perfect Corp."}},"tags":[{"id":"GLOBAL#location#taiwan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Taiwan","description":"Taiwan","dateCreated":"2020-02-03T05:29:38+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#key-mgmt-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Key Management Service (KMS)","description":"AWS Key Management Service (KMS)","dateCreated":"2020-03-02T07:04:13+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#use-case#data-lakes","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Dat