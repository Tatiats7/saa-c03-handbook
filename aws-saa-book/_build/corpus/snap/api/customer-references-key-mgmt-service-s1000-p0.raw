:32:09+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"GLOBAL#tech-category#media-services","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Media Services","description":"Media Services","dateCreated":"2020-07-17T03:06:10+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#vodfactory-video","locale":"en_US","directoryId":"customer-references","name":"vodfactory-video","dateCreated":"2023-07-18T00:06:06+0000","dateUpdated":"2023-08-11T22:26:57+0000","additionalFields":{"videoSrcUrl":"https://youtu.be/VPAEJXb8FGk","descriptionSummary":"\u003cp\u003eFond\u0026eacute; \u0026agrave; Paris en 2013, VOD Factory est le sp\u0026eacute;cialiste de la vid\u0026eacute;o \u0026agrave; la demande en France. S\u0026rsquo;appuyant sur AWS pour d\u0026eacute;velopper sa solution \u0026quot;Otto\u0026quot;, VOD Factory permet aux propri\u0026eacute;taires de contenu de cr\u0026eacute;er leur propre plateforme de streaming. \u0026Eacute;galement \u0026eacute;diteur de services SVOD (Queerscreen, Shadowz, Spicee), VOD Factory est ainsi en mesure de faire b\u0026eacute;n\u0026eacute;ficier \u0026agrave; ses clients de sa propre exp\u0026eacute;rience m\u0026eacute;tier. Amen\u0026eacute; \u0026agrave; accueillir un nombre important et variable de connexions, VOD Factory tire parti de l\u0026rsquo;\u0026eacute;lasticit\u0026eacute; du Cloud AWS pour adapter son infrastructure \u0026agrave; la demande et garantir \u0026agrave; ses utilisateurs performance et disponibilit\u0026eacute; dans le monde entier. Dans cette vid\u0026eacute;o, Julien Vin-Ramarony, Pr\u0026eacute;sident de VOD Factory, nous explique pourquoi ses \u0026eacute;quipes ont fait appel \u0026agrave; AWS et nous \u0026eacute;claire sur les d\u0026eacute;fis que son entreprise souhaite relever \u0026agrave; l\u0026#39;avenir.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/VOD%20Factory%20-%20logo.302dad665c7b364e85940ceab56b226a4f5fc51e.png","displayLocation":"Europe, Moyen-Orient et Afrique","footerInfoText":"Date de publication","industry":"Logiciels et Internet","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/vodfactory-video/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"VOD Factory","enableShare":"1","publishedDate":"2021","contentType":"Témoignages clients","headline":"VOD Factory : l\u0027histoire d\u0027une solution clé en main pour créer sa propre plateforme de streaming"}},"tags":[{"id":"GLOBAL#product#elastic-inference","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Inference","description":"Amazon Elastic Inference","dateCreated":"2020-03-02T07:03:04+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#product#savings-plans","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Savings Plans","description":"Savings Plans","dateCreated":"2021-09-27T07:50:42+0000","dateUpdated":"2022-02-03T03:32:59+0000"},{"id":"GLOBAL#product#groundstation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Ground Station","description":"AWS Ground Station","dateCreated":"2020-03-02T07:03:44+0000","d