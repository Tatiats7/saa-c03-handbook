amage to a third-party’s person or property. BAAR is also part of the Green Card system, which insures drivers under one policy for international motor travel across Europe, Asia, and North Africa.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/baar-logo%401x.48937e4036d1452ff574f44fa32a462b0f824ac8.png","displayLocation":"Romania","customerNameLower":"baar","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/baar/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"BAAR","publishedDate":"2022","enableShare":"1","headline":"Romanian Motor Insurers\u0027 Bureau (BAAR) drives faster claims resolutions using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#cee","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central \u0026 Eastern Europe","description":"Central \u0026 Eastern Europe","dateCreated":"2020-03-10T05:12:39+0000","dateUpdated":"2022-02-03T03:31:41+0000"},{"id":"GLOBAL#product#key-mgmt-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Key Management Service (KMS)","description":"AWS Key Management Service (KMS)","dateCreated":"2020-03-02T07:04:13+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"customer-references#category#customer-engagement","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2019-07-22