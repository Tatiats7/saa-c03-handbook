000"}]},{"item":{"id":"customer-references#animaeducacao20200608stdyfugi","locale":"en_US","directoryId":"customer-references","name":"animaeducacao20200608stdyfugi","dateCreated":"2022-05-23T21:40:35+0000","dateUpdated":"2022-05-23T21:52:12+0000","additionalFields":{"descriptionSummary":"Join us to learn how João\u0027s team at Ânima Educação is building a digital platform for students in Brazil. Legacy learning management systems (LMK) are usually based on premises. Frequently students had to stand in long lines to physically register for classes or manage their assignments. Learn how João\u0027s team is migrating from a monolithic, on premises architecture, to a microservices-based architecture on AWS, by leveraging Amazon KMS, optimizing content loading with Amazon Route 53, and integrating Amazon Aurora and Amazon S3 for analytics.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/anima-educacao-logo%401x.360eb39a7909925c6e14b5d21ef24811e0a9eec2.png","displayLocation":"North America","footerInfoText":"Published Date","industry":"Education","sortDate":"2020-06-08","headlineUrl":"https://youtu.be/9yziTe6lBwk?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Ânima Educação: Digitizing Student Experience for Colleges in Brazil","customer-name":"Ânima Educação"}},"tags":[{"id":"GLOBAL#product#key-mgmt-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Key Management Service (KMS)","description":"AWS Key Management Service (KMS)","dateCreated":"2020-03-02T07:04:13+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","