"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#category#data-lakes-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Data Lakes \u0026 Analytics","description":"Data Lakes \u0026 Analytics","dateCreated":"2019-07-22T18:31:39+0000","dateUpdated":"2022-02-07T13:55:55+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#aws-case-study-national-renewable-energy-laboratory-s-openei-org","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-national-renewable-energy-laboratory-s-openei-org","dateCreated":"2019-07-22T19:54:23+0000","dateUpdated":"2023-07-12T01:40:42+0000","additionalFields":{"featured":"0","descriptionSummary":"\u003cp\u003eThe National Renewable Energy Laboratory (NREL) is the primary laboratory for renewable energy research in the United States. Using AWS, the organization can launch new websites in days instead of weeks and share energy data with thousands of researchers across the globe while reducing data curation costs by nearly 30 percent.\u003c/p\u003e\r\n","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/NationalRenewableEnergyLaboratory_Customer-Reference_Logo.6d75ba63a42d62495406cd0ae129d12d95793e69.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eOpenEI.org, managed for the U.S. Department of Energy by its National Renewable Energy Laboratory, is a free, open source knowledge sharing platform created to facilitate access to data, models, tools, and information that accelerate the transition to clean energy systems through informed decisions. Built on AWS, OpenEI.org makes use of Amazon EC2, Amazon EBS, Amazon S3, and Elastic Load Balancing.\u003c/p\u003e\r\n","industry":"Power \u0026 Utilities","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/openei/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"National Renewable Energy Laboratory","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: National Renewable Energy Laboratorys OpenEI.org"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+00