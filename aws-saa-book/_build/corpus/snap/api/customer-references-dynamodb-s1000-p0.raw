ustomer-references","name":"linius-technologies-case-study","dateCreated":"2021-10-01T01:55:47+0000","dateUpdated":"2021-12-22T23:20:01+0000","additionalFields":{"descriptionSummary":"Linius Technologies and Racing.com use AWS to codevelop video virtualization solutions that have increased user engagement for Racing.com products by up to 125 percent. Linius’ mission is to make the world’s videos accessible as data using its globally patented Video Virtualization Engine™. The solutions use AWS Step Functions to create data presentation workflows, AWS Lambda for API authentication, and Amazon CloudFront for content delivery.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Linius%20_logo%401x.16799c45838e368c63095c96a6df9f48547d8a34.png","displayLocation":"Australia","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/linius-technologies-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Linius Technologies Boosts Engagement with Data-Driven Video Playlists for Racing.com","customer-name":"Linius Technologies"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#location#australia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia","description":"Australia","dateCreated":"2020-02-03T05:29:12+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"customer-references#category#customer-engagement","locale":"en_US","tagNamespaceId":"customer-ref