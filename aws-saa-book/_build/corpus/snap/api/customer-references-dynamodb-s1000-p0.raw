ted":"2022-02-03T03:35:27+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2023-07-15T01:16:11+0000"},{"id":"GLOBAL#location#germany","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Germany","description":"Germany","dateCreated":"2020-02-03T05:29:55+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#bmw","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"bmw","description":"\u003cp\u003eBMW is a customer in the Innovator Program.\u003c/p\u003e\n","dateCreated":"2022-08-12T19:46:58+0000","dateUpdated":"2022-08-12T19:46:58+0000"}]},{"item":{"id":"customer-references#aws-case-study-unalis","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-unalis","dateCreated":"2019-07-22T19:54:02+0000","dateUpdated":"2023-07-14T23:32:41+0000","additionalFields":{"featured":"0","descriptionSummary":"Unalis provides mobile gaming content and applications and uses social media to deliver technical information, videos, illustrations, and e-commerce services to traditional Chinese-speaking markets in Asia. Running on AWS enabled Unalis to save $370,000 in server costs in the first year, reduce the number of employees needed to run its infrastructure by half, and cut three months off the time required to bring a new game to production.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/unalis-logo.c2e8dd7ce415a5f24a4f4cc91a5c8993f56565b0.png","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003eUnalis provides mobile gaming content and applications and uses social media to deliver technical information, videos, illustrations, and e-commerce services to traditional Chinese-speaking markets in Asia. The business is running its mobile games, mobile analytics platform, and social media services on AWS. This enabled Unalis to save about $370,000 in server costs in the first year, reduce the number of employees needed to run its infrastructure by half from about 20 to 10, and cut three months from the time required to bring a new game to production.\u003c/p\u003e\r\n","industry":"Gaming","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/unalis/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Unalis","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Unalis"}},"tags":[{"id":"GLOBAL#language