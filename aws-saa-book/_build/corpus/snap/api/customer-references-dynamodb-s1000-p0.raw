anguage#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#product#cognito","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Cognito","description":"Amazon Cognito","dateCreated":"2020-03-02T07:02:17+0000","dateUpdated":"2022-02-03T03:32:25+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"}]},{"item":{"id":"customer-references#mediastream","locale":"en_US","directoryId":"customer-references","name":"mediastream","dateCreated":"2023-01-18T00:47:32+0000","dateUpdated":"2023-06-08T04:07:42+0000","additionalFields":{"descriptionSummary":"Mediastream es una compañía que ayuda a los medios y a las grandes empresas que quieren usar las tecnologías de streaming de forma fácil. La empresa lleva más de 15 años en el mercado, con clientes en toda Latinoamérica, parte de Europa e los EE.UU. En este video, Luis Ahumada, fundador y CEO de Mediastream, detalla la evolución del uso de los servicios AWS en la compañía, lo que, sin embargo, formó las bases para que Mediastream lograra escalar y tener la infraestructura rápida y disponible para prestar servicios eficientes en cualquier lugar del mundo.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/mediastream_logo%402x.7705d0b9fba7afa2a8b1a7163d98041b20ee31e1.png","displayLocation":"Chile","customerNameLower":"mediastream","footerInfoText":"Fecha de publicación","industry":"Medios y entretenimiento","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/mediastream/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Mediastream","publishedDate":"2022","enableShare":"1","headline":"AWS ayuda Mediastream a llevar servicios escalables a cualquier lugar del mundo","contentType":"Historia del cliente"}},"tags":[{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US"