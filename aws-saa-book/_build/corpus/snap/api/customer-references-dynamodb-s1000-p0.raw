n RDS), Amazon DynamoDB, and Amazon EMR to provide marketers with a detailed view of their consumers and improve business outcomes.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/salesforce_Logo%401x.e3ea487b7f4ec96d760a1240c5b36f93823d1c54.png","displayLocation":"United States","customerNameLower":"salesforce","footerInfoText":"Published Date","industry":"Digital Marketing","sortDate":"2022-08-22","headlineUrl":"https://aws.amazon.com/solutions/case-studies/salesforce-san-francisco-summit-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Salesforce","publishedDate":"2022","enableShare":"1","headline":"Salesforce Creates a Single Source of Data Truth for Its Customer Data Platform Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#industry#digital-marketing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Digital Marketing","description":"Digital Marketing","dateCreated":"2020-01-16T17:42:16+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#vid