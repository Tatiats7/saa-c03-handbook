ces","name":"gen-digital-video-case-study","dateCreated":"2024-09-20T16:53:01+0000","dateUpdated":"2024-09-20T16:57:53+0000","additionalFields":{"descriptionSummary":"This case study details how Gen achieved over 90% accuracy across more than 1 million installations for AI scam detection and reduced end-to-end response times (excluding LLM calls) to less than 1 second using AWS Lambda and AWS Step Functions.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/gen%20digital%20logo%401x.ca817e9178a6c405df120156c8d174e9bf1f6227.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/gen%20digital%20logo%401x.ca817e9178a6c405df120156c8d174e9bf1f6227.png","displayLocation":"North America","customerNameLower":"gen","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2024-09-16","headlineUrl":"https://aws.amazon.com/solutions/case-studies/gen-digital-video-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Gen","publishedDate":"2024","enableShare":"1","headline":"Gen Achieves over 90% Accuracy for Norton Genie Scam Detection Using AWS Serverless and AI Services","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#step-functions","locale":"en_US","tagNamespac