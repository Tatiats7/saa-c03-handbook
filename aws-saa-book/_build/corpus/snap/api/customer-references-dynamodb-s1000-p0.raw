 AWS-Services ein, um diese Tradition des Wandels fortzuführen: Beispielsweise bringt es das industrielle Internet der Dinge (Industrial Internet of Things, IIoT) in Eisenbahnen und Fabriken, entwickelt intelligente Infrastruktur für Gebäude sowie verteilte Energiesysteme und implementiert AI in seine Cybersicherheit-Plattform.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Siemens_Customer-Reference_Logo%401x.bb038521df5899223d4bd8364182c2fc69ef288d.png","displayLocation":"Nordamerika","customerNameLower":"siemens","industry":"Biowissenschaften","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/siemens/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"Kundengeschichte","customer-name":"Siemens","headline":"Siemens on AWS"}},"tags":[{"id":"customer-references#category#app-integration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Application Integration","description":"Application Integration","dateCreated":"2019-07-22T18:30:54+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless",