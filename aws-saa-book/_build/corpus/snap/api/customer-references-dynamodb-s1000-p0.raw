{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#cinepolis-klic","locale":"en_US","directoryId":"customer-references","name":"cinepolis-klic","dateCreated":"2023-06-01T23:04:47+0000","dateUpdated":"2023-06-08T04:07:42+0000","additionalFields":{"descriptionSummary":"Cinépolis es una empresa mexicana que ofrece servicios de diversión y entretenimiento a los clientes. Es líder de la industria cinematográfica en México y Latinoamérica: es la cuarta cadena más grande a nivel mundial y la más importante fuera de Estados Unidos. Ofrece un servicio de streaming a sus clientes, llamado Cinépolis Klic, el cual vive en la nube de AWS desde que nació. El reto que tenía la compañía era migrar la plataforma de Cinépolis (con exhibición de taquilla y venta de boletos) precisamente a la nube de AWS para digitalizar sus servicios.","featureImageURL":"https://d1.awsstatic.com/industry-images-customer-references/cinepolis.ea68756c99bde5fb0cf409e1a127ceaab1acc0f0.jpg","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/cinepolis_logo%401x.05ef2da49bb908d59725a7e59120de873d03492a.png","displayLocation":"México","customerNameLower":"cinepolis","footerInfoText":"Fecha de publicación","industry":"Medios y entretenimiento","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/cinepolis-klic/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Cinepolis","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"A través de AWS, Cinépolis apuesta a lo digital, a la omnicanalidad y la personalización"}},"tags":[{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#location#mexico","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Mexico","description":"Mexico","dateCreated":"2020-04-09T00:25:53+0000","dateUpdated":"2022-02-03T03:31:31+0000"},{"id":"GLOBAL#tech-category#devtools","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Developer Tools","description":"Developer Tools","dateCreated":"2020-01-16T17:43:16+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#migration"