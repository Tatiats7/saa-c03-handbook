e":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"},{"id":"GLOBAL#industry#travel","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Travel","description":"Travel","dateCreated":"2020-01-16T17:42:42+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#axa-innovator","locale":"en_US","directoryId":"customer-references","name":"axa-innovator","dateCreated":"2024-06-28T07:22:40+0000","dateUpdated":"2024-07-01T15:52:56+0000","additionalFields":{"descriptionSummary":"AXA Group (AXA) is a leading international insurance organization headquartered in France with nearly 150,000 employees and a presence in 60 countries. It started its cloud journey in 2016 and now drives its ongoing digital transformation using Amazon Web Services (AWS). The business has accelerated its cloud adoption by creating a custom global landing zone following AWS best practices and using a range of services. This has given its 100 operating companies autonomy in innovation while ensuring a standardized and secure approach globally. AXA continues to innovate in the cloud by exploring services such as machine learning (ML) and business intelligence on AWS to deliver the next generation of insurance to customers worldwide.","featureImageURL":"https://d1.awsstatic.com/gcrp_AXAInnovator-tile_300x205.eb3afe005666141e7e8260226dc5633afe1f4b34.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/AXA_logo.69470e0cccfe8a13ce1b75f4aaaa37a9b7a796e9.png","displayLocation":"France","customerNameLower":"axa","footerInfoText":"Published Date","description":"\u003cp\u003eUsing AWS to easily comply with complex security requirements within a heavily regulated industry\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u0026nbsp;\u003c/p\u003e\n","industry":"Financial Services","sortDate":"2024-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/innovators/axa/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Axa","publishedDate":"2024","enableShare":"1","headline":"AXA on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Mobile","description":"Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2023-08-22T20:28:38+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNames