n-security","locale":"en_US","directoryId":"customer-references","name":"dropbox-hellosign-security","dateCreated":"2021-11-06T04:54:17+0000","dateUpdated":"2021-12-22T23:17:41+0000","additionalFields":{"descriptionSummary":"Cloud-based file storage and smart workspaces company Dropbox acquired the electronic signature and storage solution HelloSign in 2019. Already using Amazon Web Services (AWS) for many of its infrastructure needs, the company decided to expand its use of AWS to enhance its security posture. In just 6 months, HelloSign upgraded its security by using a suite of scalable, customized security tools from AWS, implementing best practices, saving developer time, improving security response time, and averting security events.","imageSrcUrl":"https://d1.awsstatic.com/hellosign-logo-1x.198d798e06859287babe5a6d22b2695ef467aa87.png","displayLocation":"Asia Pacific","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2021-11-05","headlineUrl":"https://aws.amazon.com/solutions/case-studies/dropbox-hellosign-security/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Dropbox Layers AWS Security Services to Scale Its Signature Service Protection","customer-name":"Dropbox"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#enterprise-hybrid","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Enterprise \u0026 Hybrid","description":"Enterprise \u0026 Hybrid","dateCreated":"2019-07-22T18:31:50+0000","dateUpdated":"2022-05-09T