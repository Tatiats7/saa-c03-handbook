ory","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#halodoc20200312wtoyjw","locale":"en_US","directoryId":"customer-references","name":"halodoc20200312wtoyjw","dateCreated":"2022-05-23T21:41:41+0000","dateUpdated":"2023-07-12T01:35:30+0000","additionalFields":{"descriptionSummary":"Halodoc, a Jakarta-based healthtech platform, uses tele-health and artificial intelligence to connect patients, doctors, and pharmacies. Join builder Adrian De Luca as he dives deep into the solutions architecture of this Indonesian health-tech platform that provides healthcare services in one of the most challenging traffic environments in the world. Explore how they evolved their monolithic back end into decoupled microservices with Amazon EC2 \u0026 SQS, adopted serverless to cost effectively support new user functionality with AWS Lambda, and manage the high volume and velocity of data with Amazon DynamoDB, RDS and Redshift.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Halodoc_Customer-Reference_Logo.fc6d17259a45918129235e4d4b0c4ff559c757be.png","displayLocation":"Indonesia","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2020-03-12","headlineUrl":"https://youtu.be/gdieNSxZC4Y?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDat