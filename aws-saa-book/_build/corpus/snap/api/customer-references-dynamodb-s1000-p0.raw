#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#tech-category#gen-ai","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Generative AI","description":"\u003cp\u003eGenerative AI\u003c/p\u003e\n","dateCreated":"2023-08-22T20:28:41+0000","dateUpdated":"2024-05-23T20:34:52+0000"},{"id":"customer-references#category#gen-ai","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gen AI","description":"\u003cp\u003eGenerative Artificial Intelligence\u003c/p\u003e\n","dateCreated":"2023-07-10T17:07:31+0000","dateUpdated":"2023-07-10T17:07:31+0000"}]},{"item":{"id":"customer-references#amaonote-case-study","locale":"en_US","directoryId":"customer-references","name":"amaonote-case-study","dateCreated":"2024-08-31T00:46:29+0000","dateUpdated":"2024-09-18T00:53:32+0000","additionalFields":{"descriptionSummary":"Amanote can onboard new large university customers for its note-taking app in less than 2 minutes, scale to accommodate thousands of new users in a few hours, and handle up to 3 million queries per customer per month. Its app is integrated into learning management systems (LMS) used in higher-education facilities and large enterprises. Amanote needed to ensure that its app could be easily integrated as an LMS plugin, with customization kept to a minimum to assist sales. It built a fully serverless cloud setup, using AWS Lambda to handle queries and deliver multiple app features. Amanote has optimized its costs and can easily deliver its products to customers worldwide with minimal disruption.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Amanotelogo%401x.b6fcec98191b4721f224a1dd463086dda8d339cd.png","displayLocation":"Belgium","customerNameLower":"amanote","footerInfoText":"Published Date","industry":"Education","sortDate":"2024-08-29","headlineUrl":"https://aws.amazon.com/solutions/case-studies/amaonote-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Amanote","publishedDate":"2024","enableShare":"1","headline":"Amanote Optimizes Note-Taking App for Learners, Handling Millions of Queries on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUp