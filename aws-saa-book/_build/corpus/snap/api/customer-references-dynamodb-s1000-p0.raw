2-02-12T02:01:31+0000"},{"id":"GLOBAL#product#codepipeline","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodePipeline","description":"AWS CodePipeline","dateCreated":"2020-03-02T07:02:13+0000","dateUpdated":"2022-02-03T03:32:25+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#zappos-case-study","locale":"en_US","directoryId":"customer-references","name":"zappos-case-study","dateCreated":"2020-03-02T20:07:49+0000","dateUpdated":"2021-12-22T22:41:17+0000","additionalFields":{"featured":"0","descriptionSummary":"Zappos uses analytics built on AWS technology to personalize search results for individual users without noticeable latency, achieving higher search-to-clickthrough rates and reducing return rates.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/zappos-logo@1x.beaa428481cd50b53f87832f15543cc16d46e17f.png","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Retail","sortDate":"2020