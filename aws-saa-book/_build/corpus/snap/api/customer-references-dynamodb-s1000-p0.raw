ddle East","description":"Middle East","dateCreated":"2020-04-09T03:53:16+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Internet of Things (IoT)","description":"Internet of Things (IoT)","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2023-08-22T20:28:39+0000"},{"id":"GLOBAL#product#iot-analytics","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS IoT Analytics","description":"AWS IoT Analytics","dateCreated":"2020-03-02T07:03:56+0000","dateUpdated":"2022-02-03T03:32:42+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#coca-cola","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Coca-Cola","description":"Coca-Cola","dateCreated":"2022-04-25T19:06:03+0000","dateUpdated":"2022-06-07T17:22:42+0000"},{"id":"customer-references#big-rocks#aws-for-data","locale":"en_US","tagNamespaceId":"customer-references#big-rocks","name":"AWS for Data","description":"\u003cp\u003eAWS for Data is a marketing \u0026ldquo;Big Rock\u0026rdquo; initiative that tells the story around how AWS can provide the most comprehensive set of data capabilities spanning databases, analytics, business intelligence, and machine learning for an end-to-end data strategy.\u003c/p\u003e\n","dateCreated":"2024-02-14T22:32:15+0000","dateUpdated":"2024-02-14T22:32:15+0000"}]},{"item":{"id":"customer-references#paypay","locale":"en_US","directoryId":"customer-references","name":"paypay","dateCreated":"2021-06-18T07:37:00+0000","dateUpdated":"2022-12-22T17:40:44+0000","additionalFields":{"descriptionSummary":"PayPay is a mobile payment service that allows users to pay using QR codes and bar codes. The number of registered users has surpassed 33 million since it was first released two years ago in October 2018. PayPay Corporation, the developer and operator of the service, uses Amazon Web Services (AWS) as the infrastructure platform for its services, and is building distributed systems utilizing a microservices architecture. From the decision to develop the system through to its release was a scant three months. This initial launch was made possible by using AWS along with a development team including multinational members from Japan, India and Canada. Even now, the company is continuing with service updates aiming to develop PayPay into a \"Super App.\"","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/paypay-logo%401x.dfead1e98edf1f39fa487dfb70bfdead34814773.png","displayLocation":"Japan","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2021-06-17","headlineUrl":"https://aws.amazon.com/solutions/case-studies/paypay/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"PayPay","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Utilizing AWS microservices architecture to make cashless payments more widespread. QR code payment service used by 33 million people* that was released in three months."}},"tags":[{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#finserv","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Financial Services","description":"Financial Services","dateCreated":"2019