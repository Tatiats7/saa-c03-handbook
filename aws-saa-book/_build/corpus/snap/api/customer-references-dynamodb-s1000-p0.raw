el Looney Tunes – World of Mayhem. A companhia, que no início apenas desenvolvia seus jogos, a partir de 2013 passou a utilizar a nuvem e os serviços AWS para levá-los aos usuários, permitindo centenas de milhares de jogadores ativos diariamente e milhões de sessões sem falhas.","featureImageURL":"https://d1.awsstatic.com/industry-images-customer-references/aquiris%20wonderbox.3b507c8c63b914b26d8cef5ec3daf5b799de8365.png","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/aquiris_logo-1%402x.773e91a549af8aec546c71e7b2f6c22dbd556243.png","displayLocation":"Brasil","customerNameLower":"aquiris","footerInfoText":"Data de publicação","industry":"Jogos","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/aquiris/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Aquiris","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"Com flexibilidade da Amazon Web Services, Aquiris atende milhões de jogadores online sem falhas"}},"tags":[{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-ca