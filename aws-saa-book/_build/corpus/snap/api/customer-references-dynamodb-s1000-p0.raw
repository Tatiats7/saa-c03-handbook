gory#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#location#dach","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"DACH","description":"DACH","dateCreated":"2020-02-03T05:29:52+0000","dateUpdated":"2022-02-03T03:31:47+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#townsq03232022kljnefhnfelnadal","locale":"en_US","directoryId":"customer-references","name":"townsq03232022kljnefhnfelnadal","dateCreated":"2022-05-23T21:43:26+0000","dateUpdated":"2022-06-10T21:39:51+0000","additionalFields":{"descriptionSummary":"TownSq is a digital community platform that allows for neighbors, board members, and management teams to collaborate with one another and elevate the community experience. TownSq leverages Data and Analytics capabilities to help users gain greater insights into business performance, client benchmarking, engagement levels, and success rates for their services. TownSq utilizes the AWS Data Lab to accelerate their development in order to deploy algorithms that highlight unmet client needs, automate key process, and provide recommendation to mitigate risk. The TownSq team has also built a functioning Data Lake, an ETL pipeline able to process data from multiple sources (DynamoDB, MongoDB and various ERP systems) and a data warehouse using Kinesis, Glue, DynamoDB, S3 and Aurora. As a result from insights, TownSq is able to refocus their product roadmap towards richer ROI opportunities and dramatically increase engagement on newly-launched features for their clients in communities across the United States.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/town-sq-logo%401x.88625e617dec06cffec645cc9cef3172f8431c3d.png","displayLocation":"United States","customerNameLower":"townsq","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-03-23","headlineUrl":"https://youtu.be/E8BGpIxzYc4?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"TownSq","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"TownSq: Providing Performance Insights to Community Managers"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#content-t