type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-myriad-group","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-myriad-group","dateCreated":"2019-07-22T19:50:58+0000","dateUpdated":"2023-07-14T23:32:47+0000","additionalFields":{"featured":"0","descriptionSummary":"Myriad Group is a French-Swiss software company that develops white-labeled cellphone software and owns Versy, a social networking application it markets to Latin American consumers. The company consolidated 16 different legacy IT systems into one on AWS. By using AWS, it was able to launch a new version of Versy with just 12 people—instead of the 120 it would have required in the past—while growing its customer user base nearly fivefold in one year.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/myriad-logo.eb3bedfe1415a40a161a8bca87c74fb01164edac.jpg","displayLocation":"France","footerInfoText":"Published Date","description":"\u003cp\u003eMyriad Group is a French-Swiss software company that develops white-labeled cellphone software as well as Versy, a social networking application it markets directly to Latin American consumers. The company consolidated 16 different legacy IT systems into one on AWS. By using AWS, it was able to launch a new version of Versy with just 12 people?instead of the 120 it would have required in the past?while growing its customer user base nearly five-fold in one year.\u003c/p\u003e\r\n","industry":"Telecommunications","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/myriad-group/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Myriad Group","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Myriad Group"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#industry#telecommunications","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Telecommunications","description":"Telecommunications","dateCreated":"2020-01-16T17:42:41+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#category#mobile","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Mobile","description":"Mobile","dateCreated":"2019-07-22T18:32:14+0000","dateUpdated":"2022-03-24T02:42:27+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-cenique","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-cenique","dateCreated":"2019-07-22T19:53:45+0000","dateUpdated":"2023-07-14T23:32:45+0000","additionalFields":{"featured":"0","descriptionSummary":"Cenique\u0027s shopper-insight and digital-signage solutions provide retailers across the globe with an easy way to analyze in-store customer behavior and optimize marketing strategies accordingly. The company migrated its analytics platform to AWS after experiencing frequent downtime with on-premises servers. By moving to AWS, Cenique has reduced its operating costs by 60 percent and scaled to support a tenfold increase in customers.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Cenique_Customer-Reference_Logo.67fcecfa7d2528f44bf54af670a5bbfdbb52751d.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","description":"\u003cp\u003eCenique?s shopper-insight and digital-signage solutions provide retailers across the globe an easy way to analyze in-store customer behavior and optimize marketing strategies accordingly. The company migrated its analytics platform to AWS after experiencing frequent downtime with on-premises servers. By moving to AWS, Cenique has reduced its operating costs by 60 percent and scaled to support a tenfold increase in customers.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/cenique/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Cenique","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Cenique"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":