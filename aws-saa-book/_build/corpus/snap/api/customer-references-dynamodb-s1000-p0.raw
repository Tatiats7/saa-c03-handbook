"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#greenn-clouddog-2025","locale":"en_US","directoryId":"customer-references","name":"greenn-clouddog-2025","dateCreated":"2025-02-19T21:55:06+0000","dateUpdated":"2025-03-06T23:49:26+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eA Greenn \u0026eacute; uma plataforma de vendas online de produtos digitais - como livros eletr\u0026ocirc;nicos, cursos, mentorias e produtos f\u0026iacute;sicos - que integra uma s\u0026eacute;rie de solu\u0026ccedil;\u0026otilde;es que facilitam o com\u0026eacute;rcio eletr\u0026ocirc;nico. Criada com foco em empreendedores digitais, a plataforma oferece funcionalidades como gest\u0026atilde;o de assinaturas e antecipa\u0026ccedil;\u0026atilde;o de receitas. Este ano a empresa tornou-se uma subadquirente gra\u0026ccedil;as \u0026agrave; adequa\u0026ccedil;\u0026atilde;o de seu ambiente ao padr\u0026atilde;o PCI. O trabalho foi feito com o suporte da Clouddog, parceira AWS, que remodelou a arquitetura de seguran\u0026ccedil;a da empresa com servi\u0026ccedil;os AWS, permitindo a obten\u0026ccedil;\u0026atilde;o da certifica\u0026ccedil;\u0026atilde;o PCI em menos de seis meses.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Greenn%20Logo%20200x70px.09631ad08394eebbf1c1c6981835ed0d82c7d8b1.png","displayLocation":"Brazil","footerInfoText":"2025","industry":"Software \u0026 Internet","sortDate":"2025-02-19","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/greenn-clouddog/","customer-name":"Greenn","enableShare":"1","publishedDate":"2025","contentType":"Case Study","headline":"Serviços de Segurança AWS Levam Greenn a Obter a Certificação PCI"}},"tags":[{"id":"GLOBAL#tech-category#arch-strategy","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Architecture Strategy","description":"Architecture Strategy","dateCreated":"2020-01-16T17:43:08+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#eventbridge","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EventBridge","description":"Amazon EventBridge","dateCreated":"2020-03-02T07:03:23+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#product#cloudtrail","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudTrail","description":"AWS CloudTrail","dateCreated":"2020-03-02T07:02:05+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":