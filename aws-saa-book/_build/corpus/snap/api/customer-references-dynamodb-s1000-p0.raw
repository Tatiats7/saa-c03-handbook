0-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"}]},{"item":{"id":"customer-references#arre-voice-datastax-2025","locale":"en_US","directoryId":"customer-references","name":"arre-voice-datastax-2025","dateCreated":"2025-02-04T23:15:35+0000","dateUpdated":"2025-03-06T23:39:05+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eArr\u0026eacute; Voice wanted to enhance user engagement on its digital media platform with personalized content recommendations. The company needed a scalable solution capable of processing large volumes of user data while supporting artificial intelligence (AI)-driven algorithms for content personalization. By transitioning to a microservices architecture, using Amazon Web Services (AWS), and implementing Astra DB, a vector database from AWS Partner DataStax, Arr\u0026eacute; Voice enabled real-time data handling and improved operational efficiency. Astra DB\u0026rsquo;s query capabilities and developer tools facilitated the rapid development of its recommendation engine, which now generates over 30 million personalized suggestions per month with a 90-percent reduction in latency.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Arre%20Voice%2070x70px.c3c3852c2c4626d9d1a9aee0c45f65f0dc108eb5.png","displayLocation":"India","footerInfoText":"2025","industry":"Media \u0026 Entertainment","sortDate":"2025-02-04","headlineUrl":"https://aws.amazon.com/partners/success/arre-voice-datastax/","customer-name":"Arré Voice","enableShare":"1","publishedDate":"2025","contentType":"Case Study","headline":"Arré Voice Enhances User Engagement and Reduces Latency by 90% with DataStax Astra DB and AWS"}},"tags":[{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"GLOBAL#product#neptune","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Neptune","description":"Amazon Neptune","dateCreated":"2020-03-02T07:04:40+0000","dateUpdated":"2022-02-03T03:32:52+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#product#titan","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Titan","description":"Amazon Titan","dateCreated":"2023-03-31T23:11:26+0000","dateUpdated":"2023-08-18T20:06:52+0000"},{"id":"GLOBAL#product#batch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Batch","description":"AWS Batch","dateCreated":"2020-03-02T07:01:42+0000","dateUpdated":"2022-02-03T03:32:19+0000"},{"id":"GLOBAL#product#bedrock","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Bedrock","description":"Amazon Bedrock","dateCreated":"2023-04-13T19:06:46+0000","dateUpdated":"2023-04-13T19:06:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"}]},{"item":{"id":"customer-references#rs-group-tech-mahindra-2025","locale":"en_US","directoryId":"customer-references","name":"rs-group-tech-mahindra-2025","dateCreated":"2025-02-04T22:52:41+0000","dateUpdated":"2025-03-06T23:00:17+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eRS Group, a global product and service solutions provider for industrial customers, faced challenges with its on-premises infrastructure, which limited its ability to scale and innovate. RS Group partnered with AWS Partner Tech Mahindra and Amazon Web Service (AWS) for a full lift-and-shift migration to the cloud. The migration, of which the digital production platform move was completed in only 48 hours without any unplanned downtime, has improved RS Group\u0026rsquo;s performance up to 150 percent. It has accelerated the time it takes to make infrastructure changes up to 95 percent and lowered technical debt by 12 percent. Operating on AWS has also empowered RS Group to scale efficiently, enhance resilience, and continuously innovate with AWS services.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/RS%20Group%20Logo%20200x70px.3462ee7b8b6dfc30fb57bfc2c57d7d4095093dde.png","displayLocation":"United Kingdom","footerInfoText":"2025","industry":"Manufacturing","sortDate":"2025-02-04","headlineUrl":"https://aws.amazon.com/partners/success/rs-group-tech-mahindra/","enableShare":"1","publishedDate":"2025","contentType":"Case Study","headline":"48 Hours, 0 Unplanned Downtime: How Tech Mahindra and AWS Helped RS Group Migrate to the Cloud"}},"tags":[{"id":"GLOBAL#location#uk","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United Kingdom","description":"United Kingdom","dateCreated":"2020-02-03T05:30:18+0000","dateUpdated":"2022-02-03T03:31:52+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#application-migration-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Application Migration Service","description":"AWS Application Migration Service","dateCreated":"2022-08-15T20:58:56+0000","dateUpdated":"2022-09-24T05:36:20+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"