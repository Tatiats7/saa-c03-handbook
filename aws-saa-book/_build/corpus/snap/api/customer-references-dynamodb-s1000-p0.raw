Updated":"2023-07-14T23:32:47+0000","additionalFields":{"descriptionSummary":"AdRoll is a global leader in digital advertising retargeting products. AdRoll chose Amazon Web Services (AWS) because of its global presence, the maturity of the platform, and its ability to scale services to support business growth. Learn how AdRoll saves money by building and growing on AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/adroll-logo@1x.ddabbd5e98be2d943555e0d62acba888bc39c6ac.png","displayLocation":"North America","footerInfoText":"Published Date","industry":"Digital Marketing","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/adroll-tco/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2015","customer-name":"AdRoll","contentType":"Customer Story","headline":"AWS Case Study: How AdRoll Lowers Costs with AWS"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Optimization","description":"\u003cp\u003eCost Optimization\u003c/p\u003e\n","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2023-07-13T00:08:24+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCre