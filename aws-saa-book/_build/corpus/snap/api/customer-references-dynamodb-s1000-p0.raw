y","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000","dateUpdated":"2022-02-03T03:32:39+0000"}]},{"item":{"id":"customer-references#copec-case-study-from-es-directory","locale":"en_US","directoryId":"customer-references","name":"copec-case-study-from-es-directory","dateCreated":"2024-02-03T03:46:41+0000","dateUpdated":"2024-02-06T01:35:38+0000","additionalFields":{"descriptionSummary":"En 2022, COPEC, una de las principales distribuidoras de combustible de Chile, adoptó Red Hat OpenShift (ROSA) en Amazon Web Services como su nuevo canal de integraciones. De la mano con Escala 24x7, la compañía logró hacer su transformación tecnológica en tres meses.\nEn este video, Eduardo Diaz, arquitecto de integraciones, y Olaya Medina, jefa de arquitectura de COPEC, explican que la empresa definió que todas sus nuevas plataformas serían construidas con servicios de AWS. La nueva arquitectura los llevó a beneficios de negocio como la reducción de los tiempos de respuesta en un 50%, tener la capacidad de escalar y mejorar su time-to-market.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/copec%20logo%402x.87cf65990d1991c831e3fb316a5ed2a00736303a.png","displayLocation":"Chile","customerNameLower":"copec","footerInfoText":"Fecha de publicación","industry":"Fabricación","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/copec-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Copec","enableShare":"1","publishedDate":"2023","contentType":"Historia del cliente","headline":"COPEC reduce tiempos de respuesta en un 50% con migración a la nube AWS"}},"tags":[{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Cust