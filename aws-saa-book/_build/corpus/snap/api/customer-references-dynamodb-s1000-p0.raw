:"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"}]},{"item":{"id":"customer-references#booking-innovator","locale":"en_US","directoryId":"customer-references","name":"booking-innovator","dateCreated":"2024-06-28T07:22:48+0000","dateUpdated":"2024-08-07T18:41:50+0000","additionalFields":{"descriptionSummary":"Seamlessly connecting millions of travelers with memorable experiences every day—including accommodation, flights, rides, and attractions—Booking.com is one of the world’s leading online travel platforms. Its mission is to make it easier for everyone to experience the world. No matter who you are or where you want to go, Booking.com can help make it happen. The company uses Amazon Web Services (AWS) and generative artificial intelligence (AI) to put more than 150 petabytes of data to work to improve booking services. Collaborating with AWS Professional Services, and using technologies such as Amazon SageMaker and Amazon Bedrock, it has built a scalable machine learning framework that’s accelerating experimentation and innovation.","featureImageURL":"https://d1.awsstatic.com/customer-references-case-studies-logos/ASSET_Booking_345x230.6d1a839f5d26baf0232f22d4e264d96630376cce.jpg","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/booking-logo%401x.fda414955b3dae1d3ec5545437154192ed682b6b.png","displayLocation":"Netherlands","customerNameLower":"booking","footerInfoText":"Published Date","description":"\u003cp\u003eImproving travel recommendations and removing friction using generative artificial intelligence (AI)\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u0026nbsp;\u003c/p\u003e\n","industry":"Hospitality","sortDate":"2024-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/innovators/booking/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Booking","publishedDate":"2024","enableShare":"1","headline":"Booking.com on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#language#english","loc