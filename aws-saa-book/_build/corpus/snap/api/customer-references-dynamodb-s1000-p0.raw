rences#category#data-lakes-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Data Lakes \u0026 Analytics","description":"Data Lakes \u0026 Analytics","dateCreated":"2019-07-22T18:31:39+0000","dateUpdated":"2022-02-07T13:55:55+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"}]},{"item":{"id":"customer-references#wabco-video","locale":"en_US","directoryId":"customer-references","name":"wabco-video","dateCreated":"2020-11-09T18:09:29+0000","dateUpdated":"2021-12-23T01:00:27+0000","additionalFields":{"featured":"0","descriptionSummary":"WABCO has been providing commercial vehicle technology for more than 150 years. Its systems for braking, suspension, stability, and more, can be found on most commercial vehicles. For 25 years, the company has been helping fleet operators reduce inefficiencies in road transportation with telematics devices that collect data for better business decisions. Today, much of that decision-making is automated—a trend that will continue as vehicles and systems become more sophisticated and autonomous. The backend that supports this comprises 700 servers that monitor 160,000 connected vehicles, making 1 million data inserts a minute. As the autonomous and connected vehicle ecosystem grows, WABCO is moving to a more scalable infrastructure in the cloud that will support innovation in areas such as artificial intelligence and machine learning. In this video, Philippe Colpron, vice president and global leader, fleet solutions at WABCO, explains how Amazon Web Services (AWS) technologies—such as AWS IoT Core and Amazon DynamoDB—helped the company halve its time to market and expand its portfolio with new products.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/WABCO_Customer-Reference_Logo@1x.46344843969bd9036c8059d4e549e238588fe388.png","displayLocation":"Switzerland","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/wabco-video/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"WABCO","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"WABCO Grows Its Smart Vehicle Ecosystem on AWS"}},"tags":[{"id