":"customer-references#innovator#engie","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"ENGIE","description":"ENGIE","dateCreated":"2022-09-15T00:48:27+0000","dateUpdated":"2022-09-15T00:48:27+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#industry#energy","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Energy","description":"Energy","dateCreated":"2020-07-15T21:58:51+0000","dateUpdated":"2022-02-03T03:32:02+0000"},{"id":"GLOBAL#language#italian","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Italian","description":"Italian","dateCreated":"2020-03-03T06:40:49+0000","dateUpdated":"2022-02-03T03:31:25+0000"}]},{"item":{"id":"customer-references#atresmedia-case-study","locale":"en_US","directoryId":"customer-references","name":"atresmedia-case-study","dateCreated":"2019-07-19T15:12:03+0000","dateUpdated":"2021-12-22T19:11:03+0000","additionalFields":{"featured":"0","descriptionSummary":"By using AWS, Atresmedia has created two new platforms that have grown its digital user base by 25 times to 5 million. The global media group caters to an international audience of 73 million people and already operates six TV channels and four radio stations.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Atresmedia_Customer-Reference_Logo.d0c6df5d377a09537731844720f07dae7c6b8e9d.png","displayLocation":"Spain","footerInfoText":"Published Date","description":"\u003cp\u003eBy using AWS, Atresmedia has created two new platforms that have grown its digital user base by 25 times to 5 million. The global media group caters to an international audience of 73 million people and already operates six TV channels and four radio stations. To attract younger, more digitally savvy users, it launched its AtresPlayer and Flooxer channels by using Amazon EC2 and Amazon CloudFront to deliver faster television-streaming experiences.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/atresmedia/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Atresmedia","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Atresmedia Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","descrip