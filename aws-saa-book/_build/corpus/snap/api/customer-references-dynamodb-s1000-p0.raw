escription":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#intuit-contact-center-case-study","locale":"en_US","directoryId":"customer-references","name":"intuit-contact-center-case-study","dateCreated":"2020-03-13T21:03:45+0000","dateUpdated":"2023-07-19T03:04:49+0000","additionalFields":{"featured":"0","descriptionSummary":"Intuit uses Amazon Connect to power an integrated customer contact center providing voice, web, chat, and messaging services to millions of customers.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/intuit-logo%401x.abf7c40ea61ce4d0953ca761007c94e44fb36e58.png","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/intuit-contact-center-case-