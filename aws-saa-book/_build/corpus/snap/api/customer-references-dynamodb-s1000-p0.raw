:"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#industry#travel","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Travel","description":"Travel","dateCreated":"2020-01-16T17:42:42+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#location#japan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Japan","description":"Japan","dateCreated":"2020-02-03T05:29:23+0000","dateUpdated":"2022-02-03T03:31:39+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#app-integration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Application Integration","description":"Application Integration","dateCreated":"2019-07-22T18:30:54+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#modern-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Modern Applications","description":"\u003cp\u003eModern applications are built with a combination of modular architecture patterns, serverless operational models, and agile developer processes.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:15:46+0000","dateUpdated":"2023-07-14T01:15:46+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"},{"id":"GLOBAL#industry#automotive","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Automotive","description":"Automotive","dateCreated":"2020-01-16T17:42:11+0000","dateUpdated":"2022-02-03T03:32:00+0000"}]},{"item":{"id":"customer-references#travelex-integration-on-aws","locale":"en_US","directoryId":"customer-references","name":"travelex-integration-on-aws","dateCreated":"2024-11-01T16:08:49+0000","dateUpdated":"2024-11-01T16:33:52+0000","additionalFields":{"descriptionSummary":"Travelex started a digital transformation initiative to simplify and modernize its technology infrastructure. Travelex had built an extensive network of technology systems and used five separate extract, transform, load (ETL) solutions to integrate those systems, and faced challenges such as tight coupling, high licensing costs, and scalability issues. To build its modern solution, Travelex used Integration on AWS — a broad suite of purpose-built application, file, and data integration services provided by AWS. Travelex was now able to seamlessly connect its source applications, such as point-of-sale systems for its physical locations, to its destination applications—including Travelex compliance, fraud, finance, and marketing systems and partner software-as-a-service (SaaS) solutions. As a result of using Integration on AWS services including AWS Lambda and Amazon API Gateway, Travelex was now able to reduce 70% in integration costs, 90% in operational costs, 40% in infrastructure overhead, and save £395,000 in third-party license fees.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Travelex_Logo.86ceb559b73a36cf3addff36d29e3283df01d37e.png","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Travelex_Logo.86ceb559b73a36cf3addff36d29e3283df01d37e.png","displayLocation":"Americas","customerNameLower":"travelex","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2024-10-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/travelex-integration-on-aws/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Travelex","publishedDate":"2024","enableShare":"1","headline":"Travelex Reduces Integration Costs by 70% Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#language#english","locale":"en_US","t