ternet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#swindon-borough-council-case-study","locale":"en_US","directoryId":"customer-references","name":"swindon-borough-council-case-study","dateCreated":"2021-10-02T00:53:14+0000","dateUpdated":"2023-07-14T23:32:52+0000","additionalFields":{"featured":"0","descriptionSummary":"Illegal waste disposal—known as fly-tipping in the United Kingdom (UK)—includes the dumping of waste on unauthorised sites and roads. Fly-tipping had become a real problem for Swindon Borough Council. The council recognised that its citizens needed an easier way to report dumped rubbish and that its clear-up teams needed better information so they could work more efficiently and effectively.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/swindon-borough-council-logo%401x.e8219f9cca9578d471df1f9bf9d9f5e17de13508.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","industry":"Other","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/swindon-borough-council-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Swindon Borough Council","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Swindon Improves Response to Illegal Waste Disposal with Artificial Intelligence"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tag