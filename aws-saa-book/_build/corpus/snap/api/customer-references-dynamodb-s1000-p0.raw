,"dateUpdated":"2023-07-14T23:32:30+0000","additionalFields":{"descriptionSummary":"Genoplan offers products and services related to genetic analysis using biotechnology and IT, and provides information about individuals\u0027 genetic predisposition in a simple way. It also offers exercise tips and improving lifestyle habits related to various areas of genetic studies, culled from analyzing large volumes of genetic data. This helps its customers such as companies plan for personalized health care products and services.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/genoplan-logo@1x.6c1abbaed89380c86a8a9bf4a530cc3083fa5e4a.png","displayLocation":"Asia Pacific","footerInfoText":"Published Date","industry":"Life Sciences","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/genoplan/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","customer-name":"Genoplan","contentType":"Customer Story","headline":"Genoplan establishes a foundation for Asia\u0027s leading genetic testing service on AWS"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","lo