tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#euler-hermes-video","locale":"en_US","directoryId":"customer-references","name":"euler-hermes-video","dateCreated":"2020-11-09T18:04:33+0000","dateUpdated":"2021-12-22T20:20:47+0000","additionalFields":{"descriptionSummary":"Headquartered in Paris, France, Euler Hermes provides trade credit insurance, protecting more than 66,000 clients against bad debt. In 2019, the company covered more than €950 billion of transactions, resulting in a turnover of €2.9 billion.Protecting clients at this scale requires a high-performing infrastructure. Euler Hermes receives 600,000 credit limit requests each month relating to 30 million businesses, 82 percent of which must be dealt with in real time.Recently, new platforms and marketplaces have been launched that threaten to disrupt the credit insurance industry. To maintain its position and drive innovation, Euler Hermes moved to Amazon Web Services (AWS) and saw faster time to market for new services, more control over costs, and greater ability to integrate with new market entrants’ services via APIs.In this video, Antoine Larmanjat, chief information officer at Euler Hermes, shares the story of the company’s journey to the cloud and explains why it decided on a serverless-first policy.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Euler-Hermes_Customer-Reference_Logo@1x.ce571f3ae2a50cd5ae7a2cf0d9033786a63828ee.png","displayLocation":"France","footerInfoText":"Published Date","industry":"Insurance","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/euler-hermes-video/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Euler Hermes Rides Out Market Disruption Using AWS","customer-name":"Euler Hermes"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","da