lementação, e a escalabilidade exigida pelo serviço, o Itaú fez 100% do desenvolvimento na nuvem AWS.","featureImageURL":"https://d1.awsstatic.com/industry-images-customer-references/itau_pix.b01654b0227540875edb5199d519ac36ba1ee5a7.jpg","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/itau-logo%402x.cc96e60df104954c8960737a54830d300847fb5a.png","displayLocation":"Brasil","customerNameLower":"itaú","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/itau-pix/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Itaú","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"Itaú Unibanco acelera desenvolvimento do Pix na nuvem AWS"}},"tags":[{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notific