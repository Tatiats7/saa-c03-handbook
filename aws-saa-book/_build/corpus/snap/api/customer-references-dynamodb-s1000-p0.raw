"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#salesforce","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Salesforce","description":"Salesforce","dateCreated":"2022-09-15T00:48:41+0000","dateUpdated":"2022-09-15T00:48:41+0000"}]},{"item":{"id":"customer-references#nexon-testimonial","locale":"en_US","directoryId":"customer-references","name":"nexon-testimonial","dateCreated":"2021-03-13T00:29:52+0000","dateUpdated":"2021-12-23T02:00:42+0000","additionalFields":{"descriptionSummary":"Building on AWS and working with AWS Enterprise Support, Nexon’s Mobile Publishing Division uses Amazon DynamoDB, Amazon Aurora, and Elastic Load Balancing to provide a stable online experience for players during launches of new game titles like \"HIT\" and to quickly respond to and resolve player-facing issues. By building on AWS, Nexon enables its engineering teams to focus their efforts on the most impactful workloads and ensure operational excellence for the company, all while reducing annual infrastructure costs by 30 percent.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/nexon_Logo%401x.5557c13d8b82bfa497f88e23e12fcb5a50853da6.png","displayLocation":"Korea","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2021-03-12","headlineUrl":"https://aws.amazon.com/solut