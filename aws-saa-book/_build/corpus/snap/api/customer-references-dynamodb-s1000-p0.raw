nguage","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#agesic-msp","locale":"en_US","directoryId":"customer-references","name":"agesic-msp","dateCreated":"2023-06-01T23:10:00+0000","dateUpdated":"2023-06-08T04:07:35+0000","additionalFields":{"descriptionSummary":"El Ministerio de Salud Pública (MSP) de Uruguay junto con la Agencia de Gobierno Electrónico y Sociedad de la Información y del Conocimiento (Agesic), el programa Salud.uy y otros proveedores de tecnología han desarrollado un nuevo sistema de solicitud de agenda para la campaña de vacunas contra el Covid-19 utilizando servicios en la nube de Amazon Web Services. El sistema fue puesto en producción en dos días y actualmente permite que toda la población adulta pueda solicitar agenda y obtener día y hora para vacunarse.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/agesic_logo%401x.27ca0f22b73e8f229ca105cf70a8c4b05140810d.png","displayLocation":"Uruguay","footerInfoText":"Fecha de publicación","industry":"Servicios públicos generales","sortDate":"2021-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/agesic-msp/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"Historia del cliente","customer-name":"Agencia de Sistemas de la Informacion (AGESIC)","headline":"Con AWS, Uruguay pone sistema de solicitud de agenda de vacunación en operación en tiempo récord"}},"tags":[{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"201