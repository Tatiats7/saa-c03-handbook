OBAL#tech-category","name":"Internet of Things (IoT)","description":"Internet of Things (IoT)","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2023-08-22T20:28:39+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#kinesis-data-streams","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis Data Streams","description":"Amazon Kinesis Data Streams","dateCreated":"2020-05-08T03:45:11+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2023-07-15T01:16:11+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"}]},{"item":{"id":"customer-references#aws-case-study-remind","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-remind","dateCreated":"2019-07-22T19:51:02+0000","dateUpdated":"2022-01-21T02:41:36+0000","additionalFields":{"featured":"0","descriptionSummary":"Remind is a web and mobile application that enables U.S. school teachers to send text messages to students and stay in touch with parents. Remind built its platform as a service on Amazon ECS and runs its entire messaging application infrastructure on AWS. Using Amazon ECS has significantly improved application performance and freed Remind\u0027s engineers to focus on developing and deploying applications.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Remind_Customer-Reference_Logo.2e892e8e7b72f90bec14687629405f7cca77d3b1.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRemind is a communication tool that helps teachers connect instantly with students and parents by sending quick, simple messages to any device. Remind leverages the breadth and scalability of the AWS cloud to deliver more than 200 million messages a month between parents, teachers, and students while supporting 400,000 new users per day during back-to-school season. The company has built an open-source developer platform called Empire that leverages Amazon EC2 Container Service (Amazon ECS) to support 30 applications, 36 Amazon ECS container instances, and 244 containers in production.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/remind/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Remind","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Cas