ted":"2022-02-03T03:32:46+0000"}]},{"item":{"id":"customer-references#delivery-hero-data-protection","locale":"en_US","directoryId":"customer-references","name":"delivery-hero-data-protection","dateCreated":"2024-08-23T15:46:26+0000","dateUpdated":"2024-08-23T15:50:04+0000","additionalFields":{"descriptionSummary":"An online food delivery firm spanning 70 countries across 4 continents, Delivery Hero needs to handle data in accordance with legislation in the regions where it operates. Using Amazon Web Services (AWS), says director of site reliability engineering Shery Brauner, gives Delivery Hero a range of tools and technologies to help it manage data securely and deliver the customer-centric service the company is famous for.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Delivery-Hero-Logo.051a35304e784d088c38a03322ba5c6dda9d3415.png","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Delivery-Hero-Logo.051a35304e784d088c38a03322ba5c6dda9d3415.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"delivery hero","footerInfoText":"Published Date","industry":"Hospitality","sortDate":"2024-08-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/delivery-hero-data-protection/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Delivery Hero","publishedDate":"2024","enableShare":"1","headline":"Delivery Hero’s Global Success Relies on Local Data Compliance Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Mobile","description":"Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2023-08-22T20:28:38+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#dacadoo-data-protection","locale":"en_US","directoryId":"customer-references","name":"dacadoo-data-protection","dateCreated":"2024-08-23T15:46:30+0000","dateUpdated":"2024-08-23T15:50:04+0000","additionalFields":{"descriptionSummary":"Switzerland-based software-as-a-service startup dacadoo aims to help people improve their health and wellbeing through its digital health engagement solutions. The company has customers around the globe, so processing data securely and in line with laws like the General Data Protection Regulation (GDPR) in Europe and the Health Insurance Portability and Accountability Act (HIPAA) in the US is vital. Geoffrey Schiavon, dacadoo’s head of marketing and client success, talks about delivering a compelling experience to customers’ end users, and how support from AWS is a winner.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Dacadoo%20Logo.ffc48d2142157608dfc74a14c326f56697b861c1.png","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Dacadoo%20Logo.ffc48d2142157608dfc74a14c326f56697b861c1.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"dacadoo","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2024-08-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/dacadoo-data-protection/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"dacadoo","publishedDate":"2024","enableShare":"1","headline":"dacadoo Keeps Data Secure, Compliant for Customers Worldwide Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Mobile","description":"Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2023-08-22T20:28:38+0000"},{"id":"GLOBAL#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Mid-Market Territory (MMT)","description":"Mid-Market Territory (MMT)","dateCreated":"2021-06-04T06:35:43+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API G