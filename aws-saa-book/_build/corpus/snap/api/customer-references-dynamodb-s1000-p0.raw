020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"}]},{"item":{"id":"customer-references#uala-case-study","locale":"en_US","directoryId":"customer-references","name":"uala-case-study","dateCreated":"2023-06-01T23:04:36+0000","dateUpdated":"2023-07-14T23:32:38+0000","additionalFields":{"descriptionSummary":"Ualá es una empresa de servicios financieros que trabaja constantemente en brindar nuevas soluciones para mejorar la vida financiera de las personas y de comercios. Con operaciones en México, Colombia y Argentina, la compañía fue lanzada en 2017.\nHoy con más de 5 millones de usuarios, Ualá quiere alcanzar los 25 millones en la región en no más que cinco años. Ezequiel Mina, director de tecnología de Ualá, explica cómo la empresa se preparó para el éxito del negocio: apuntó hacia servicios escalables; construyó una arquitectura utilizando Amazon API Gateway, AWS Lambda y Amazon DynamoDB. \"Pasados cinco años, tenemos exactamente la misma arquitectura que el primer día\", dice Mina.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/uala-logo%402x.3a78f8fb13fd0a634b4b9fab034d91a0e10b2557.png","displayLocation":"Argentina","customerNameLower":"ualá","footerInfoText":"Fecha de publicación","industry":"Servicios financieros","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/uala-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ualá","enableShare":"1","publishedDate":"2023","contentType":"Historia del cliente","he