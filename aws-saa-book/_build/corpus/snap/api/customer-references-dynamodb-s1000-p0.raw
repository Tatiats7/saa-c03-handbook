espaceId":"GLOBAL#location","name":"China","description":"China","dateCreated":"2020-02-03T05:29:17+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#tech-category#media-services","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Media Services","description":"Media Services","dateCreated":"2020-07-17T03:06:10+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#elemental-mediapackage","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental MediaPackage","description":"AWS Elemental MediaPackage","dateCreated":"2020-03-02T07:03:17+0000","dateUpdated":"2022-02-03T03:32:35+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#elemental-medialive","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental MediaLive","description":"AWS Elemental MediaLive","dateCreated":"2020-03-02T07:03:15+0000","dateUpdated":"2022-02-03T03:32:35+0000"},{"id":"GLOBAL#location#hongkong","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Hong Kong","description":"Hong Kong","dateCreated":"2020-02-03T05:29:18+0000","dateUpdated":"2022-02-03T03:31:38+0000"}]},{"item":{"id":"customer-references#bbpos","locale":"en_US","directoryId":"customer-references","name":"bbpos","dateCreated":"2021-08-20T23:52:01+0000","dateUpdated":"2022-12-19T23:24:22+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eWith AWS, BBPOS can support customers in more than 50 countries with single-digit millisecond latency and real-time visibility into its IoT devices. Based in Hong Kong, BBPOS was one of the founders of mobile point-of-sale (mPOS) devices and supporting software. The company uses AWS Global Accelerator for low-latency data transfers, Amazon OpenSearch Service for real-time analytics, and AWS Fargate to automatically scale containers in a serverless fashion.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/bbpos_logo%401X.3c4b30363f43ece328624809abd13124c0ba3bf9.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2021-08-20","headlineUrl":"https://aws.amazon.com/solutions/case-studies/bbpos/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"BBPOS","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"BBPOS Brings Real-Time Visibility to Payment Processing on AWS"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GL