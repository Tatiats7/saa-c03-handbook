e":"DevOps","description":"DevOps","dateCreated":"2020-06-05T07:06:27+0000","dateUpdated":"2022-02-03T03:32:10+0000"}]},{"item":{"id":"customer-references#xcaret","locale":"en_US","directoryId":"customer-references","name":"xcaret","dateCreated":"2023-06-01T23:05:06+0000","dateUpdated":"2023-07-12T01:35:38+0000","additionalFields":{"descriptionSummary":"AWS permitió a Xcaret pasar de un sistema analógico de venta de fotos a otro digital en tres meses. Apenas puesto en marcha el sistema digital, los clientes descargaron 22 TB de fotos ofrecidas en 4 diferentes tamaños y formatos para múltiples aplicaciones y dispositivos.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/xcaret_logo%401x.e11c91f39a40dc753c49c4f85aba16b966062031.png","displayLocation":"México","customerNameLower":"xcaret","footerInfoText":"Fecha de publicación","industry":"Hostelería","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/Xcaret/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Xcaret","enableShare":"1","publishedDate":"2018","contentType":"Historia del cliente","headline":"Caso práctico de Xcaret"}},"tags":[{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin 