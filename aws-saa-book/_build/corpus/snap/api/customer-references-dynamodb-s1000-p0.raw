en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#innovasport","locale":"en_US","directoryId":"customer-references","name":"innovasport","dateCreated":"2023-06-01T23:11:10+0000","dateUpdated":"2023-06-08T04:07:33+0000","additionalFields":{"descriptionSummary":"Innovasport es una empresa que ya tiene cerca de 22 años en el mercado mexicano, 100% enfocada al sport guiter, con dos focos principales: Innovasport que está enfocada al deporte 100%, a lo que son los Sporting Goods, e Innvictus, que tiene un toque un poco más casual conocido como athletic specialty. Migró a Amazon Web Services en 2017, quien le ayudó a superar el reto que representó la pandemia por Covid-19, y le permitió tener un 200% de crecimiento orgánico en su e-commerce, gracias a una infraestructura con alta escalabilidad.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/innovasport-logo%402x.17af3c042c7a9d3abc05d16a3d15c11df88b7747.png","displayLocation":"México","footerInfoText":"Fecha de publicación","industry":"Venta al por menor","sortDate":"2021-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/innovasport/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"Historia del cliente","customer-name":"Innovasport","headline":"Innovasport alcanza crecimiento de 200% en e-commerce, aún en pandemia, utilizando tecnologías AWS"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03