":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-tixcraft","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-tixcraft","dateCreated":"2019-07-22T19:50:30+0000","dateUpdated":"2023-07-14T23:32:41+0000","additionalFields":{"featured":"0","descriptionSummary":"Founded in 2013, tixCraft provides ticketing services for concerts and other events in Taiwan. The company migrated its databases, websites, e-commerce, and associated systems for analysis and reporting to AWS. This has enabled tixCraft to support more than 2,500 orders per second and achieve 99.999 percent availability.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/tixcraft-logo.23c209b738ea2425927f9d1b5f60da269fa6831a.PNG","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003eFounded in 2013, tixCraft provides ticketing services for concerts and other events in Taiwan. The company has migrated its databases, websites, e-commerce, and associated systems for analysis and reporting to AWS. This has enabled tixCraft to scale its IT resources more than 130-fold in 30 minutes, support more than 2,500 orders per second, and achieve 99.999 percent availability.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/tixcraft/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"tixCraft","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: tixCraft"}},"tags":[{"