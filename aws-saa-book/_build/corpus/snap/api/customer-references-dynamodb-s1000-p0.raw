agNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#unicred","locale":"en_US","directoryId":"customer-references","name":"unicred","dateCreated":"2023-06-01T23:07:09+0000","dateUpdated":"2023-06-08T04:07:44+0000","additionalFields":{"descriptionSummary":"Em operação desde 1989 a Unicred é uma instituição financeira criada no Rio Grande do Sul para atender, inicialmente, profissionais de saúde. Com o tempo sua atuação tornou-se mais abrangente e hoje a cooperativa oferece os mesmos serviços dos bancos tradicionais, de conta corrente a cartões de crédito. Em 2019, a instituição decidiu lançar seu cartão próprio, projeto que já nasceu na nuvem AWS.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/unicred-logo%402x.97c8971859a9e6d213dff4cff1fc6adcfa9ef85a.png","displayLocation":"Brasil","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2021-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/unicred/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"História do cliente","customer-name":"Unicred do Brasil","headline":"Unicred leva processamento de cartões para infraestrutura AWS"}},"tags":[{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUp