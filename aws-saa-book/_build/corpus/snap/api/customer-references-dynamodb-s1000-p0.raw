 operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#paytron-case-study","locale":"en_US","directoryId":"customer-references","name":"paytron-case-study","dateCreated":"2022-10-11T20:29:52+0000","dateUpdated":"2022-10-11T21:03:05+0000","additionalFields":{"descriptionSummary":"Paytron launches its business on AWS and process millions of dollars of payments per month in more than 180 countries, deploys new features 20 times daily, launches new corporate credit card, and attracts top engineering talent.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Paytron_logo%401x.a75937f57cda4fbcf84fe933c1233a1004f68d21.png","displayLocation":"Australia","customerNameLower":"paytron","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/paytron-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Paytron","publishedDate":"2022","enableShare":"1","headline":"Paytron Launches and Scales Global Payments Platform Processing Millions of Dollars of Monthly Payments on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless"