-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"IoT","description":"IoT","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2022-02-03T03:35:28+0000"}]},{"item":{"id":"customer-references#williamhill3i4m6df0w","locale":"en_US","directoryId":"customer-references","name":"williamhill3i4m6df0w","dateCreated":"2022-05-23T21:44:01+0000","dateUpdated":"2022-05-23T21:53:34+0000","additionalFields":{"descriptionSummary":"William Hill have built a high-performance DDOS and Edge Protection platform using AWS Services - (CloudFront, Shield Advanced, WAF, R5 Instances, Lambda and DynamoDB and Streams). The solution has been effective in mitigating a 177 GBPS DDOS attack and 48 million attempted exploits (so far in 2019) from across 121,000 IPs and 196 countries. In addition, their build successfully blocked 63 million requests from 180,000 IPs from 202 countries - all trying to scrape pricing and event data, which is successful is highly detrimental to the business and customer experience.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/william-hill-logo%401x.3834fbad9237d7f7687e0ddf3b4a4ef37203f367.png","displayLocation":"Europe, Middle East, \u0026 Africa","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2020-01-28","headlineUrl":"https://youtu.be/d0EE1HuZSEU?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"William Hill: High-performance DDOS Protection with AWS","customer-name":"William Hill Plc"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07