t","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#methodology#devops","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"DevOps","description":"DevOps","dateCreated":"2020-06-05T07:06:27+0000","dateUpdated":"2022-02-03T03:32:10+0000"}]},{"item":{"id":"customer-references#aws-case-study-doapp","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-doapp","dateCreated":"2019-07-22T19:53:25+0000","dateUpdated":"2023-07-14T23:32:39+0000","additionalFields":{"featured":"0","descriptionSummary":"DoApp provides more than 460 web and mobile applications for news organizations in 150 markets across the United States, with support for the iOS, Android, Amazon Fire, and mobile web platforms. The company uses AWS to publish, update, and serve content to apps, particularly news apps that can be customized for individual organizations. Using AWS, the company\u0027s 12 employees—including just three backend developers—can provide uninterrupted availability while continually innovating and winning new clients across the globe.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/DoApp%20Logo%20Color.0ce431faaf07c3626cbf5a698565a6b9758c3cee.jpg","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eDoApp provides more than 460 web and mobile applications for news organizations in 150 markets across the United States, with support for the iOS, Android, Amazon Fire, and mobile web platforms. The company uses Amazon Web Services to publish, update, and serve content to apps, particularly news apps that can be customized for individual organizations. By using AWS, the company?s 12 employees?including just three backend developers?have been able to provide content with uninterrupted availability for nearly five years while continually innovating and winning new clients across the globe.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/doapp/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"DoApp","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: DoApp"}},"tags":[{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:43+0000","dateUpdated":"2022-02-03T03:36:00+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated