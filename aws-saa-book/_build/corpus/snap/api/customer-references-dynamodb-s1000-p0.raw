03T03:31:14+0000"},{"id":"GLOBAL#product#elb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Elastic Load Balancing (ELB)","description":"Elastic Load Balancing (ELB)","dateCreated":"2020-03-02T07:03:09+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Internet of Things (IoT)","description":"Internet of Things (IoT)","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2023-08-22T20:28:39+0000"},{"id":"customer-references#category#iot","locale":"en_US","tagNamespaceId":"customer-references#category","name":"IoT","description":"IoT","dateCreated":"2019-07-22T18:32:05+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#industry#electronics","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Electronics","description":"Electronics","dateCreated":"2020-06-25T04:07:00+0000","dateUpdated":"2022-02-03T03:32:02+0000"},{"id":"GLOBAL#industry#semiconductors","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Semiconductors","description":"Semiconductors","dateCreated":"2020-08-31T04:01:50+0000","dateUpdated":"2022-02-03T03:32:07+0000"}]},{"item":{"id":"customer-references#aws-case-study-democratic-national-committee","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-democratic-national-committee","dateCreated":"2019-07-22T19:51:08+0000","dateUpdated":"2023-05-26T18:28:16+0000","additionalFields":{"featured":"0","descriptionSummary":"The Democratic National Committee (DNC) assists local, state, and federal Democratic candidates. The organization moved from a traditional IT infrastructure to AWS to run its website and to gather, store, and deliver voter data to other political organizations. By using AWS, the DNC reduced its IT footprint, cut costs, and scales its website easily to handle spikes in traffic.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/DemocraticNationalCommittee_Customer-Reference_Logo.28020d754365a953c9ad3c55df5a6dd558881b7a.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eThe Democratic National Committee (DNC) assists local, state, and federal Democratic candidates. The organization moved from a traditional IT infrastructure to AWS to run its website and to gather, store, and deliver voter data to other political organizations. By using AWS, the DNC reduced its IT footprint, cut costs, and can scale its website easily to handle spikes in traffic.\u003c/p\u003e\r\n","industry":"Government","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/democratic-national-committee/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Democratic National Committee","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Democratic National Committee"}},"tags":[{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamesp