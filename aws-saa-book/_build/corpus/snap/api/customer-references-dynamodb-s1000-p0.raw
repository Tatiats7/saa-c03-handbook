39:42+0000","dateUpdated":"2022-06-27T20:43:38+0000"},{"id":"customer-references#customer-segment#public-sector-govt","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Government","description":"Government","dateCreated":"2019-07-22T18:39:47+0000","dateUpdated":"2022-03-19T00:18:44+0000"},{"id":"customer-references#product#ec2","locale":"en_US","tagNamespaceId":"customer-references#product","name":"ec2","description":"EC2","dateCreated":"2019-07-22T18:34:10+0000","dateUpdated":"2021-03-01T19:27:00+0000"},{"id":"customer-references#industry#government","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"government","description":"Government","dateCreated":"2019-07-17T22:21:31+0000","dateUpdated":"2021-02-22T20:33:28+0000"},{"id":"customer-references#product#elb","locale":"en_US","tagNamespaceId":"customer-references#product","name":"elb","description":"ELB","dateCreated":"2019-07-22T18:34:48+0000","dateUpdated":"2021-02-27T00:44:18+0000"},{"id":"customer-references#product#rds","locale":"en_US","tagNamespaceId":"customer-references#product","name":"rds","description":"RDS","dateCreated":"2019-07-22T18:36:41+0000","dateUpdated":"2021-02-27T00:44:14+0000"},{"id":"customer-references#product#cloudfront","locale":"en_US","tagNamespaceId":"customer-references#product","name":"cloudfront","description":"CloudFront","dateCreated":"2019-07-22T18:33:08+0000","dateUpdated":"2021-02-27T00:44:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-frontier-games","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-frontier-games","dateCreated":"2019-07-22T19:53:46+0000","dateUpdated":"2023-07-14T23:32:47+0000","additionalFields":{"featured":"0","descriptionSummary":"Frontier Games is a United Kingdom-based video game company. It turned to AWS to develop and host its games, including Zoo Tycoon, Elite: Dangerous, and Coaster Crazy. Using AWS, Frontier Games can scale compute resources easily to handle large spikes in user traffic and is saving up to 30 percent compared to using a traditional technology infrastructure, allowing it to focus financial resources on game development instead of on IT hardware.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/frontier-logo.4fec601216d6f48a8aafadf33dd3115987e80d13.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","description":"\u003cp\u003eFrontier Games is a UK-based video game company. It turned to AWS to develop and host its games, including Zoo Tycoon, Elite: Dangerous, and Coaster Crazy. By using AWS, Frontier Games can scale compute resources easily to handle large spikes in user traffic with popular titles, and is saving up to 30 percent compared to using a traditional technology infrastructure, allowing it to focus financial resources on game development instead of on IT hardware.\u003c/p\u003e\r\n","industry":"Gaming","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/frontier-games/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Frontier Games","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Frontier Games"}},"tags":[{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#uk","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United Kingdom","description":"United Kingdom","dateCreated":"2020-02-03T05:30:18+0000","dateUpdated":"2022-02-03T03:31:52+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#category#web-hosting","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Web Hosting","description":"Web Hosting","dateCreated":"2019-07-22T18:32:28+0000","dateUpdated":"2022-03-30T20:30:49+0000"},{"id":"GLOBAL#location#ukir","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"UK/IR","description":"UK/IR","dateCreated":"2020-02-19T23:06:44+0000","dateUpdated":"2022-02-03T03:31:51+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-general-electric-s-digital-transformation-it","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-general-electric-s-digital-transformation-it","dateCreated":"2024-11-12T00:53:54+0000","dateUpdated":"2024-11-12T01:13:41+0000","additionalFields":{"descriptionSummary":"General Electric (GE) opera in 180 paesi ed è un azienda leader nella produzione ad impiego industriale da oltre un secolo. Grazie a una combinazione di software, analisi e ingegneria di prim\u0027ordine, GE aiuta le aziende di tutto il mondo a lavorare in modo più efficiente, affidabile e sicuro. L’impresa utilizza oltre 2000 applicazioni cloud e 55 servizi AWS per aumentare la portata, l’efficienza e le prestazioni nei settori dell\u0027aviazione, dell\u0027energia elettrica, della sanità e dell\u0027energia rinnovabile.","featureImageURL":"https://d1.awsstatic.com/aws-key-pages/homepage-key-pages/customer-stories-logo/GE.69d638be1bb211236c8d87590e8ee0be001b543c.jpg","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/GEPower_Customer-Reference_Logo.7100af15f7461bdc2ea9edec4f9b61e536c54f48.png","displayLocation":"Americas","customerNameLower":"ge healthcare","footerInfoText":"Published Date","description":"\u003cp\u003eCombining engineering with analytics to help people work more efficiently and safely\u003c/p\u003e\r\n","industry":"Electronics \u0026 Semiconductors","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/general-electric/","customer-name":"GE Healthcare","enableShare":"1","publishedDate":"2015","contentType":"Storia del cliente","headline":"General Electric su AWS"}},"tags":[{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000",