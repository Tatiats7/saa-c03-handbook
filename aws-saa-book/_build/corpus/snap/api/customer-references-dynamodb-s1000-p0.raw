nt, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#soundbus-case-study","locale":"en_US","directoryId":"customer-references","name":"soundbus-case-study","dateCreated":"2019-07-19T15:11:10+0000","dateUpdated":"2023-07-14T23:32:38+0000","additionalFields":{"featured":"0","descriptionSummary":"SoundBus Technologies Co., Ltd. uses AWS to maintain stable operations around the clock and faster service time, greatly improving the user experience while reducing the operation and maintenance workload and labor costs. SoundBus is a new-media technology company that enables users to interact with each other through an innovative \"sound code\" technology similar to QR code.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/China/SoundBus-logo-en.64361e55f8445ce55b8890d6a287feb750cdc349.png","displayLocation":"China","footerInfoText":"Published Date","description":"\u003cp\u003eRead the Soundbus customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/soundbus/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Soundbus","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Soundbus Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000