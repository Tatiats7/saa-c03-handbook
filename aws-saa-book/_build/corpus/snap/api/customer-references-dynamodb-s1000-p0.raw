:"2022-09-15T00:48:28+0000","dateUpdated":"2022-09-15T00:48:28+0000"},{"id":"GLOBAL#product#service-catalog","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Service Catalog","description":"AWS Service Catalog","dateCreated":"2020-03-02T07:05:20+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"}]},{"item":{"id":"customer-references#acxiom-video-case-study","locale":"en_US","directoryId":"customer-references","name":"acxiom-video-case-study","dateCreated":"2022-09-01T00:15:49+0000","dateUpdated":"2022-09-01T00:20:23+0000","additionalFields":{"descriptionSummary":"Hear from Varadarajan Srinivasan, senior director of data science and machine learning engineering at Acxiom, on how the company uses Amazon SageMaker for propensity model scoring on a scalable machine learning platform.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/acxiom-logo%401x.4770eefda26e6aef7fc627067d51ce99cf33387a.png","displayLocation":"United States","customerNameLower":"acxiom","footerInfoText":"Published Date","industry":"Digital Marketing","sortDate":"2022-08-31","headlineUrl":"https://aws.amazon.com/solutions/case-studies/acxiom-video-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Acxiom","publishedDate":"2022","enableShare":"1","headline":"Acxiom Uses Amazon SageMaker for Propensity Scoring 3 Trillion Records","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#customer-engagement","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2019-07-22T18:31:37+0000","dateU