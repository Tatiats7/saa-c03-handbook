:31+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#elemental-appliances-software","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental Appliances \u0026 Software","description":"AWS Elemental Appliances \u0026 Software","dateCreated":"2020-03-02T07:03:10+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"customer-references#homepage-industry#media-entertainment","locale":"en_US","tagNamespaceId":"customer-references#homepage-industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2022-08-24T22:33:50+0000","dateUpdated":"2022-08-24T22:33:50+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"}]},{"item":{"id":"customer-references#velliv-case-study","locale":"en_US","directoryId":"customer-references","name":"velliv-case-study-de","dateCreated":"2022-05-14T20:14:10+0000","dateUpdated":"2024-09-20T20:36:23+0000","additionalFields":{"descriptionSummary":"Velliv ist in der stark regulierten Finanzdienstleistungsbranche tätig und mit mehr als 360 000 Kunden eines der größten dänischen Rentenversicherungsunternehmen. Als sich Velliv 2018 von seiner Muttergesellschaft Nordea trennte, bot sich die Chance, eine völlig neue, unabhängige IT-Infrastruktur aufzubauen. \nVelliv entschied sich für AWS, weil das Unternehmen über die nötige Reife verfügte, um die benötigte Cloud-Umgebung bereitzustellen. „Durch die Arbeit mit AWS sind wir ein bisschen klüger geworden“, meint Martin Eggert, Anwendungsarchitekt bei Velliv. „Als ich hörte, dass unsere große monolithische Anwendung auf AWS umgestellt werden würde, rechnete ich mit einer Herausforderung. Die Unternehmensarchitekten von Velliv haben jedoch mit Unterstützung unseres AWS-Partners Cognizant gezeigt, dass die Migration zu AWS machbar ist. Wir haben die Migration in nur 1 Jahr abgeschlossen. Es ist ein großer Erfolg, dass wir es in dieser kurzen Zeit geschafft haben.“","featureImageURL":"https://d1.awsstatic.com/emea-customer-references/emea-directory-customer-logos/Velliv-Customer-References-Logo%401x.52535df6f20a3c441e5d9a55447f591a4bd230c3.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/emea-customer-references/emea-directory-customer-logos/Velliv-Customer-References-Logo%401x.52535df6f20a3c441e5d9a55447f591a4bd230c3.png","displayLocation":"Dänemark","customerNameLower":"velliv, pension \u0026 livsforsikring a/s","industry":"Finanzdienstleistungen","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/velliv-case-study/?nc1\u003dh_ls\u0026did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Velliv, Pension \u0026 Livsforsikring A/S","enableShare":"1","publishedDate":"2022","contentType":"Kundengeschichte","headline":"Velliv schließt sichere, konforme Migration mit AWS ab"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#location#denmark","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Denmark","description":"Denmark","dateCreated":"2020-02-03T05:30:06+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East,