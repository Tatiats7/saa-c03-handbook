-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#alta-vr","locale":"en_US","directoryId":"customer-references","name":"alta-vr","dateCreated":"2022-03-05T03:54:29+0000","dateUpdated":"2022-03-05T03:56:35+0000","additionalFields":{"descriptionSummary":"Alta VR uses AWS to scale its game platform to accommodate tens of thousands of players daily, automatically support spikes in traffic, and provide a low-latency playing experience for gamers globally. Alta VR is an Australian virtual reality company that developed A Township Tale, a top-selling VR game for Oculus Quest. The company runs the game’s platform on AWS Lambda and Amazon DynamoDB, and uses Amazon EKS to automatically scale container clusters.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Alta_logo%401x.eb3162c68ecb36473b05b4957d5b4459bef76761.png","displayLocation":"Australia","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2022-03-04","headlineUrl":"https://aws.amazon.com/solutions/case-studies/alta-vr/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Alta VR Immerses Gamers in a Virtual Reality World with AWS","customer-name":"Alta VR"}},"tags":[{"id":"GLOBAL#location#australia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia","description":"Australia","dateCreated":"2020-02-03T05:29:12+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale