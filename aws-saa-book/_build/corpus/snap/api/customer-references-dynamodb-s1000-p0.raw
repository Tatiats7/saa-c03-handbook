anguage#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"customer-references#category#gen-ai","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gen AI","description":"\u003cp\u003eGenerative Artificial Intelligence\u003c/p\u003e\n","dateCreated":"2023-07-10T17:07:31+0000","dateUpdated":"2023-07-10T17:07:31+0000"},{"id":"GLOBAL#tech-category#gen-ai","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Generative AI","description":"\u003cp\u003eGenerative AI\u003c/p\u003e\n","dateCreated":"2023-08-22T20:28:41+0000","dateUpdated":"2024-05-23T20:34:52+0000"}]},{"item":{"id":"customer-references#heyjobs-data-protection","locale":"en_US","directoryId":"customer-references","name":"heyjobs-data-protection","dateCreated":"2024-07-26T11:33:24+0000","dateUpdated":"2025-03-06T23:23:19+0000","additionalFields":{"descriptionSummary":"HeyJobs measures its success by linking the right employers with the right talent. To do this it needs the latest technology that allows its engineers to create new features and functionality. Using Amazon Web Services (AWS) Managed Services, says chief technology officer Boris Diebold, liberates his team from operations, security, and systems updates. With faster development cycles and easier compliance with regulations such as General Data Protection Regulation (GDPR), HeyJobs can focus on maintaining a competitive edge.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/heyjobs-logo%401x.2de12445ecad456fcb854c542040f00ce8d30828.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/heyjobs-logo%401x.2de12445ecad456fcb854c542040f00ce8d30828.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"hey jobs","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2024-07-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/heyjobs-data-protection/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Hey Jobs","publishedDate":"2024","enableShare":"1","headline":"HeyJobs Keeps Focus on Innovation Using AWS Managed Services","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#cognito","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Cognito","description":"Amazon Cognito","dateCreated":"2020-03-02T07:02:17+0000","dateUpdated":"2022-02-03T03:32:25+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#category#data-protection","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Data Protection","description":"\u003cp\u003eData protection is the process of protecting sensitive information from damage, loss, or corruption.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:07:32+0000","dateUpdated":"2023-07-14T01:07:32+0000"}]},{"item":{"id":"customer-references#pga-tour-ecs-case-study","locale":"en_US","directoryId":"customer-references","name":"pga-tour-ecs-case-study","dateCreated":"2024-07-26T11:33:45+0000","dateUpdated":"2024-10-11T23:13:23+0000","additionalFields":{"descriptionSummary":"The PGA TOUR introduced Win, Cut Probability, a novel ML-powered analytics model that provides real-time insights into the likelihood of outcomes during tournaments. Powered by AWS, advanced data analytics, cloud infrastructure, and serverless services, the Win, Cut Probability model measures a player’s chances of advancing in and winning a tournament. Using Amazon Elastic Container Service (ECS) with AWS Fargate to run thousands of simulations and process nearly four billion records, the PGA TOUR can take advantage AWS’s elasticity, run their model quickly and scale as needed, while offloading the operational overhead of infrastructure management to AWS.","featureImageURL":"https://d1.awsstatic.com/awsih_card_img-pga_tour.b894c1d7fcbb7545618c04bc5614f5b27b1c9295.jpg","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/pga-tour_logo%401x.7cd90a3105fd3bb8452fda2f46959d7255c02368.png","displayLocation":"Americas","customerNameLower":"pga tour","footerInfoText":"Published Date","description":"\u003cp\u003eProviding real-time insights to its audience and creating an immersive viewing experience.\u003c/p\u003e\n","industry":"Media \u0026 Entertainment","sortDate":"2024-07-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/pga-tour-ecs-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"PGA Tour","publi