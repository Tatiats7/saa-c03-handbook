4-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#deliveroo","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Deliveroo","description":"Deliveroo","dateCreated":"2022-09-15T00:48:25+0000","dateUpdated":"2022-09-15T00:48:25+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#the-pokemon-company-case-study","locale":"en_US","directoryId":"customer-references","name":"the-pokemon-company-case-study","dateCreated":"2020-06-08T18:56:35+0000","dateUpdated":"2024-03-02T02:48:51+0000","additionalFields":{"featured":"0","descriptionSummary":"The Pokémon Company International migrated from a third-party NoSQL document database to Amazon Aurora PostgreSQL, significantly reducing monthly costs and consolidating 300 nodes to 30.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/pokemon-logo@1x.fa5637f0681a402b1cead2189ebf54b4f711825f.png","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/the-pokemon-company-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"The Pokémon Company","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"The Pokémon Company Migrates to AWS Purpose-Built Databases"}},"tags":[{"id":"GLOBAL#use-case#general-database-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"General Database Migration","description":"General Database Migration","dateCreated":"2020-06-05T06:37:24+0000","dateUpdated":"2022-02-03T03:35:41+0000"},{"id":"customer-references#category#database-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Database Migration","description":"Database Migration","dateCreated":"2019-07-22T18:31:40+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#elasticache-redis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache for Redis","description":"Amazon ElastiCache for Redis","dateCreated":"2020-03-03T00:16:59+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespa