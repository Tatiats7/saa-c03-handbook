age uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#metroplushealth-case-study","locale":"en_US","directoryId":"customer-references","name":"metroplushealth-case-study","dateCreated":"2021-02-15T20:57:35+0000","dateUpdated":"2023-07-12T01:35:18+0000","additionalFields":{"descriptionSummary":"Using an AWS-powered chatbot, MetroPlusHealth was able to offer help to 54,000 of its members most vulnerable to the COVID-19 pandemic in just 3 weeks and connect members in need with social services.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/metroplus-logo@1x.376da4d52f988ac289a57de403d53f259f9b3b23.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2021-02-15","headlineUrl":"https://aws.amazon.com/solutions/case-studies/metroplushealth-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"MetroPlusHealth","contentType":"Customer Story","headline":"Using AWS, MetroPlusHealth Reaches Out to 80,000 At-Risk New Yorkers"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#customer-engagement","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2019