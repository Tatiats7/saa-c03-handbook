is tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#zomato","locale":"en_US","directoryId":"customer-references","name":"zomato","dateCreated":"2022-04-09T03:08:53+0000","dateUpdated":"2023-07-14T23:32:31+0000","additionalFields":{"descriptionSummary":"In 2020, Zomato engaged Amazon Web Services (AWS) to migrate Profile Store to Amazon DynamoDB. After the migration, Zomato maintained a near-100 percent uptime even during the peak periods, such as Diwali and New Year’s Eve, as well as reduced operational costs by 25 percent.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/zomato-logo%401x.219df00b51676268636442b79ee156ce8d2a12dc.png","displayLocation":"India","footerInfoText":"Published Date","industry":"Hospitality","sortDate":"2022-04-08","headlineUrl":"https://aws.amazon.com/solutions/case-studies/zomato/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","customer-name":"Zomato","contentType":"Customer Story","headline":"Zomato Handles Up To 2.5x More Transactions After Migrating Non-Relational Database To AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOB