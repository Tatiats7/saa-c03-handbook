{"items":[{"item":{"id":"customer-references#exists-case-study","locale":"en_US","directoryId":"customer-references","name":"exists-case-study","dateCreated":"2024-12-16T17:36:37+0000","dateUpdated":"2024-12-16T17:40:50+0000","additionalFields":{"descriptionSummary":"Learn how Exists in the gaming industry is building an AI-powered solution on AWS that can use natural language text prompts to create 3D games in minutes.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Exists_logo%401x.081339c3ca46ecbe28878a44fee0e3fc3588c086.jpg","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Exists_logo%401x.081339c3ca46ecbe28878a44fee0e3fc3588c086.jpg","displayLocation":"Israel","customerNameLower":"exists.ai","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2024-11-19","headlineUrl":"https://aws.amazon.com/solutions/case-studies/exists-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Exists.ai","publishedDate":"2024","enableShare":"1","headline":"Building an AI Solution for Quick Game Creation with Natural Language Using AWS with Exists","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#middle-east-africa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East \u0026 Africa","description":"Middle East \u0026 Africa","dateCreated":"2020-02-03T05:30:19+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"customer-references#category#gaming","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gaming","description":"Gaming","dateCreated":"2019-07-22T18:31:55+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#game-tech","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name