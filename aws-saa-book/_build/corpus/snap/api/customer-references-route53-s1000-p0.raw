-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#aws-case-study-newsweek","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-newsweek","dateCreated":"2019-07-22T19:56:07+0000","dateUpdated":"2021-12-22T19:44:08+0000","additionalFields":{"featured":"0","descriptionSummary":"Newsweek specializes in print and online news coverage for a wide range of topics, including politics, business, and world events. Since 2009, the publication has reduced operating costs seventy-five percent by employing AWS as the foundation of its online presence.","imageSrcUrl":"https://d1.awsstatic.com/whiteboard-graphics/use-cases/Images/newsweek_daily_beast.7871470c000a34c9c5a3d00f9fc4ca879d25be11.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eNewsweek specializes in print and online news coverage for a wide range of topics, including politics, business, and world events. Since 2009, the publication has reduced operating costs seventy-five percent by employing Amazon Web Services (AWS) as the foundation of its online presence. Newsweek\u0026#39;s infrastructure was built using Amazon Elastic Compute Cloud (Amazon EC2), Amazon Simple Storage Service (Amazon S3), Amazon Relational Database Service (Amazon RDS), and Amazon CloudFront. Newsweek also uses Amazon Route 53, which saves the publication ninety-three percent in Domain Name System costs.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/newsweek/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Newsweek","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Newsweek"}},"tags":[{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#business-category#cloud-cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-06-05T07:06:41+0000","dateUpdated":"2022-02-03T03:31:02+0000"},{"id":"GLOBAL#use-case#datacenter-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2020-08-18T05:17:48+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US",