03c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#iconloop-case-study","locale":"en_US","directoryId":"customer-references","name":"iconloop-case-study","dateCreated":"2020-05-21T17:48:19+0000","dateUpdated":"2023-07-14T23:32:46+0000","additionalFields":{"descriptionSummary":"ICONLOOP selected AWS for its global presence so that it could build its globally dispersed network of blockchain nodes, “Icon Development Network”.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Iconloop_Customer-Reference_Logo.62648fe90824e2e614492c63ae363cddc52f77d8.png","displayLocation":"Korea","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/partners/success/iconloop/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","customer-name":"ICONLOOP","contentType":"Customer Story","headline":"AWS Partner Case Study: ICONLOOP"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId