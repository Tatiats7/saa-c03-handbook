ted":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#workload#microsoft","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"Microsoft","description":"Microsoft","dateCreated":"2021-01-06T00:09:49+0000","dateUpdated":"2022-02-03T03:36:04+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#aws-case-study-interflora","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-interflora","dateCreated":"2019-07-22T19:50:29+0000","dateUpdated":"2023-07-14T23:32:42+0000","additionalFields":{"featured":"0","descriptionSummary":"Interflora Spain is a business unit of Fleurop-Interflor, the Swiss-based company that operates a floral delivery network doing business in 150 countries. Interflora Spain uses AWS to run its customer-facing e-commerce platform and backend systems, including its Microsoft Dynamics ERP system and big data, business intelligence, and data backup projects. Using AWS, the company can handle seasonal spikes in orders, can quickly and easily update its e-commerce platform, and has made internal business processes more efficient.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/interlfora-logo.3230d23d0d2a58cf947d1f4fd8c16d6e0ccc3d1b.png","displayLocation":"Spain","footerInfoText":"Published Date","description":"\u003cp\u003eInterflora Spain is a business unit of Fleurop-Interflor, the Swiss-based company that operates a floral delivery network doing business in 150 countries. Interflora Spain uses AWS to run its customer-facing e-commerce platform and backend systems, including its Microsoft Dynamics ERP system and big data, business intelligence, and data backup projects. By using AWS, the company can handle seasonal spikes in orders, can quickly and easily update its e-commerce platform, and has made internal business processes more efficient.\u003c/p\u003e\r\n","industry":"Retail","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/interflora/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Interflora","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Interflora"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12T02:01:29+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-referen