d of on IT hardware.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/frontier-logo.4fec601216d6f48a8aafadf33dd3115987e80d13.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","description":"\u003cp\u003eFrontier Games is a UK-based video game company. It turned to AWS to develop and host its games, including Zoo Tycoon, Elite: Dangerous, and Coaster Crazy. By using AWS, Frontier Games can scale compute resources easily to handle large spikes in user traffic with popular titles, and is saving up to 30 percent compared to using a traditional technology infrastructure, allowing it to focus financial resources on game development instead of on IT hardware.\u003c/p\u003e\r\n","industry":"Gaming","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/frontier-games/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Frontier Games","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Frontier Games"}},"tags":[{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#l