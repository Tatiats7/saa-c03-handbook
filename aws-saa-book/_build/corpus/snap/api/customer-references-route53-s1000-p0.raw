":{"featured":"0","descriptionSummary":"Slack provides a messaging platform for unifying diverse communications services. By using AWS, Slack can scale up to serve a user base that\u0027s growing five percent each week, add capacity for new users in mere seconds, and protect the confidentiality of its customers\u0027 information while processing 30 million messages weekly.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Slack_Customer-Reference_Logo.f348479af42f9ec232c9d9fe518f6ba1a83d5eca.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the Slack case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of companies.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/slack/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Slack","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"Slack Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+