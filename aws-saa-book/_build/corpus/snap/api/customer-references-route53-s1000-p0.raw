pos de respuesta rápida, reutilización de componentes, así como una fácil y rápida integración entre los diferentes sistemas que utilizan.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/upn_logo%401x.fb039fc1cb488ee3b8d3005fd04bfb24f47bb392.png","displayLocation":"Perú","customerNameLower":"universidad privada del norte","footerInfoText":"Fecha de publicación","industry":"Educación","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/universidad-privada-del-norte/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Universidad Privada del Norte","enableShare":"1","publishedDate":"2021","contentType":"Historia del cliente","headline":"Transformación digital de UPN, meta cumplida con AWS"}},"tags":[{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#use-case#general-database-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"General Database Migration","description":"General Database Migration","dateCreated":"2020-06-05T06:37:24+0000","dateUpdated":"2022-02-03T03:35:41+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#peru","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Peru","description":"Peru","dateCreated":"2021-02-19T05:32:36+0000","dateUpdated":"2022-02-03T03:31:33+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+000