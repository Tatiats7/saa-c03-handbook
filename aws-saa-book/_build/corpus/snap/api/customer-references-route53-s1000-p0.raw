3c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"customer-references#category#hcls","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Healthcare \u0026 Life Sciences","description":"Healthcare \u0026 Life Sciences","dateCreated":"2019-07-22T18:31:58+0000","dateUpdated":"2022-05-14T20:13:37+0000"}]},{"item":{"id":"customer-references#olx-group-case-study","locale":"en_US","directoryId":"customer-references","name":"olx-group-case-study","dateCreated":"2022-05-14T20:14:12+0000","dateUpdated":"2022-05-14T20:15:14+0000","additionalFields":{"descriptionSummary":"The global network of trading platforms OLX Group uses CloudFront Functions to improve offerings for users as part of a wholesale solution on AWS that saved time for engineers and cut the cost of compute at the edge.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/olx-group-logo%401x.566dce19c12423bb82c862e166a6a864ede135c2.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-05-13","headlineUrl":"https://aws.amazon.com/solutions/case-studies/olx-group-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"OLX Saves 50% Using CloudFront Functions for Edge Compute on AWS","customer-name":"OLX Group"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location",