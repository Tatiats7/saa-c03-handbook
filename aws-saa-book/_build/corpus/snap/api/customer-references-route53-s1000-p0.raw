","dateCreated":"2020-03-02T07:02:55+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#product#ec2-auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Auto Scaling","description":"Amazon EC2 Auto Scaling","dateCreated":"2020-03-02T07:02:53+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notification Service (SNS)","dateCreated":"2020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"}]},{"item":{"id":"customer-references#porto-case-study","locale":"en_US","directoryId":"customer-references","name":"porto-case-study","dateCreated":"2023-06-01T23:04:25+0000","dateUpdated":"2023-06-08T04:07:49+0000","additionalFields":{"descriptionSummary":"Fundada há mais de 75 anos, a Porto se consolidou no mercado de seguros, especialmente de automóveis. Nos últimos anos, vem diversificando sua atuação e, hoje, é um verdadeiro ecossistema de soluções de serviços de proteção com tecnologia embarcada, para melhorar e facilitar a experiência do cliente, atuando com três verticais de negócios: Porto Seguro, Porto Saúde e Porto Bank. Em um movimento de modernizar o seu ambiente tecnológico e dar velocidade aos objetivos estabelecidos, a empresa tem investido em serviços em nuvem. Marcos Sirelli, diretor de tecnologia da Porto, Ivan Barale, superintendente de plataformas, arquitetura e engenharia da Porto, e Claudia Ramos, gerente de cloud e DevSecOps da Porto, contam como as soluções em nuvem da AWS atendem às demandas da Companhia por agilidade, modernização, flexibilidade, disponibilidade e escalabilidade. Como destaque, eles detalham o app desenvolvido em cloud para se tornar um ecossistema de interação com seus clientes. Neste vídeo, os executivos contam mais sobre este e outros casos de aplicação de AWS na Porto.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/porto-logo%402x.36a9d42219b7c7aae2df53ddfc1616c441eea4bb.png","displayLocation":"Brasil","customerNameLower":"porto","footerInfoText":"Data de publicação","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/porto-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Porto","enableShare":"1","p