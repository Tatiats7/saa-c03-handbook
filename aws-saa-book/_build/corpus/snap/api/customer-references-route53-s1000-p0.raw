ame":"zalora","dateCreated":"2024-02-27T00:36:25+0000","dateUpdated":"2024-02-27T00:48:16+0000","additionalFields":{"descriptionSummary":"Zalora migrated to Amazon CloudFront in just two weeks to lower IT costs and website response times, helping the e-tailer meet new budget guidelines while better serving customers.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/zalora-logo%401x.a944ebd100a075f5affebab27f59a6b869336c1b.png","displayLocation":"Singapore","customerNameLower":"zalora","footerInfoText":"Published Date","industry":"Retail","sortDate":"2024-02-25","headlineUrl":"https://aws.amazon.com/solutions/case-studies/zalora/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Zalora","publishedDate":"2024","enableShare":"1","headline":"Zalora Boosts Site Performance by 46% by Migrating its Content Delivery Network to AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#business-category#cloud-cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-06-05T07:06:41+0000","dateUpdated":"2022-02-03T03:31:02+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#retail","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Retail","description":"Retail"