]},{"item":{"id":"customer-references#intraway-from-es-directory","locale":"en_US","directoryId":"customer-references","name":"intraway-from-es-directory","dateCreated":"2024-02-03T03:47:05+0000","dateUpdated":"2024-02-06T01:35:38+0000","additionalFields":{"descriptionSummary":"Intraway and its software as a service (SaaS) orchestration solution, Symphonica, lead in cloud-based, no-code automation open source software systems for telecommunications providers. Headquartered in the United States, Intraway also has offices in Argentina, Colombia, Mexico, Peru and Uruguay. The company developed a high-resilience solution capable of operating across Amazon Web Services (AWS) multi-regions. Because of its innovative and disruptive approach, Symphonica provides new services faster with improved customer service quality.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/intraway-logo%401x.c1dc59b1e132bb10fdd8e1f29d6c844ceea24b46.png","displayLocation":"Argentina","customerNameLower":"intraway","footerInfoText":"Published Date","industry":"Telecommunications","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/intraway/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Intraway","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Intraway Creates a High-Availability, Resilient, Multi-region Telecommunications Product on AWS"}},"tags":[{"id":"GLOBAL#location#argentina","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Argentina","description":"Argentina","dateCreated":"2020-06-12T23:30:42+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-referen