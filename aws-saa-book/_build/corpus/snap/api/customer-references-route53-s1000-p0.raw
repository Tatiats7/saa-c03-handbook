L#product","name":"Elastic Load Balancing (ELB)","description":"Elastic Load Balancing (ELB)","dateCreated":"2020-03-02T07:03:09+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#british-columbia-institute-of-technology-case-study","locale":"en_US","directoryId":"customer-references","name":"british-columbia-institute-of-technology-case-study","dateCreated":"2019-07-22T19:43:26+0000","dateUpdated":"2022-01-21T02:40:31+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS and AWS Educate, the British Columbia Institute of Technology (BCIT), equips students with cloud-computing resources and skills to help them succeed after they finish school. BCIT is one of Canada\u0027s largest post-secondary polytechnic schools.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/BCIT.76e98b2246a156469d11603e8dbe3b5494a5854e.png","displayLocation":"Canada","footerInfoText":"Published Date","description":"\u003cp\u003eUsing AWS and AWS Educate, the British Columbia Institute of Technology (BCIT), equips students with cloud-computing resources and skills to help them succeed after they finish school. BCIT is one of Canada\u0026#39;s largest post-secondary polytechnic schools. Students at BCIT use their AWS Educate credits for compute resources used in labs, including Amazon Elastic Compute Cloud, Amazon Simple Storage Service, and Amazon Route 53. These exercises move from theory into practice, helping students get the skills they need to secure a job after graduation.\u003c/p\u003e\r\n","industry":"Education","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/british-columbia-institute-of-technology/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"British Columbia Institute of Technology","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"British Columbia Institute of Technology  Case Study"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#ind