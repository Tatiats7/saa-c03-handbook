ernet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-international-centre-for-radio-astronomy-research-icrar","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-international-centre-for-radio-astronomy-research-icrar","dateCreated":"2019-07-22T19:59:22+0000","dateUpdated":"2022-01-21T02:43:07+0000","additionalFields":{"featured":"0","descriptionSummary":"The International Centre for Radio Astronomy Research (ICRAR) is part of a large international team developing the Square Kilometre Array (SKA)—a universe-mapping radio telescope of unprecedented size and sensitivity. By using AWS to manage crowd-sourced CPU cycles, ICRAR has the compute capacity to analyze between 400 and 500 galaxies simultaneously.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/ICRAR_Customer-Reference_Logo.3d25f79bab0f0c31226fe12dfa04cabb5080de9e.png","displayLocation":"Asia Pacific","footerInfoText":"Published Date","description":"\u003cp\u003eThe International Centre for Radio Astronomy Research (ICRAR) is part of a large international team currently developing the Square Kilometre Array (SKA) ? a Universe-mapping radio telescope of unprecedented size and sensitivity. By using AWS to manage crowd-sourced CPU cycles, ICRAR has the compute capacity to analyze between 400 and 500 galaxies simultaneously.\u003c/p\u003e\r\n","industry":"Government","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/icrar/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"International Centre for Radio Astronomy Research (ICRAR)","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: International Centre for Radio Astronomy Research (ICRAR)"}},"tags":[{"id":"GLOBAL#product#glacier","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon S3 Glacier","description":"Amazon S3 Glacier","dateCreated":"2020-03-02T07:03:38+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"customer-references#category#dev-and-test","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dev \u0026 Test","description":"Dev \u0026 Test","dateCreated":"2019-07-22T18:31:47+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"20