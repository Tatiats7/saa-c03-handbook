Created":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#industry#prof-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Professional Services","description":"Professional Services","dateCreated":"2020-06-25T04:07:49+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-next-media","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-next-media","dateCreated":"2019-07-22T19:53:56+0000","dateUpdated":"2023-07-14T23:32:47+0000","additionalFields":{"featured":"0","descriptionSummary":"Next Media is a media, entertainment, and gaming services business with annual revenues of HK$3 billion. The company runs its Hong Kong news and entertainment websites and mobile applications on AWS. Using AWS enables Next Media to launch new applications in half the time without increasing operating costs while eliminating the need to purchase up to 50 new servers.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/next-media-logo.1fa0c209a07c67dff121b23140f481eebe342aa2.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","description":"\u003cp\u003eNext Media is a media, entertainment, and gaming services business with annual revenues of HK$3 billion. The company is running its Hong Kong news and entertainment websites and mobile applications in AWS. Moving to AWS has enabled Next Media to launch new applications in half the time at existing operating cost levels while eliminating the need to purchase up to 50 new servers.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/next-media/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Next Media","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Next Media"}},"tags":[{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:43+0000","dateUpdated":"2022-02-03T03:36:00+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon R