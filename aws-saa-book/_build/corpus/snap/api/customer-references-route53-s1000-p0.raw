ateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"}]},{"item":{"id":"customer-references#sigab","locale":"en_US","directoryId":"customer-references","name":"sigab","dateCreated":"2023-06-01T23:04:44+0000","dateUpdated":"2023-06-08T04:07:42+0000","additionalFields":{"descriptionSummary":"El Sistema de Información para la Gestión y Operación del Servicio Público de Aseo de Bogotá (SIGAB) es el nuevo esquema de aseo para la ciudad de Bogotá, capital de Colombia, que cuenta con 7.9 millones de habitantes a 2022; a través de este sistema se da servicio a 2.5 millones de usuarios, con 588 camiones recolectores, que requerían tener un mayor control tanto de actividades como monitoreo de rutas y tiempos. El nuevo esquema de aseo requería información de la operación y gestión del servicio que prestan los concesionarios (Promoambiental Distrito, Limpieza Metropolitana, Cuidad Limpia, Bogotá Limpia y Área Limpia) en cada área de servicio exclusivo asignada, información que será consolidada en el SIGAB que usa los servicios de AWS para tener una disponibilidad de la información y la posibilidad de dar seguimiento en tiempo real al servicio.","featureImageURL":"https://d1.awsstatic.com/industry-images-customer-references/SIGAB.1588ea985ffbe47a13af385b36be6762ae9d1a66.jpg","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/sigab%402x.4a4d2851d9b7f966b4e81e85c7e62cfacf4f5188.png","displayLocation":"Colombia","customerNameLower":"sigab (proceraseo)","footerInfoText":"Fecha de publicación","industry":"State and Local Government","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/sigab/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"SIGAB (Proceraseo)","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"Bogotá más limpia gracias a SIGAB, que vive en la nube de AWS"}},"tags":[{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#backup","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Backup","description":"AWS Backup","dateCreated":"2020-03-02T07:01:40+0000","dateUpdated":"2022-02-03T03:32:19+0000"},{"id":"GLOBAL#industry#general-public-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"General Public Services","description":"General Public Services","dateCreated":"2020-01-16T17:42:24+0000","dateUpdated":"2022-02-