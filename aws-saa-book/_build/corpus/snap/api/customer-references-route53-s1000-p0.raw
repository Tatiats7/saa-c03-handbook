ed":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#health-guru-case-study","locale":"en_US","directoryId":"customer-references","name":"health-guru-case-study","dateCreated":"2019-07-22T19:58:15+0000","dateUpdated":"2023-07-14T23:32:46+0000","additionalFields":{"featured":"0","descriptionSummary":"Health Guru is one of the leading providers of online health information videos. Faced with scalability and performance challenges, the company switched to AWS, resulting in a 92.5 percent improvement in web service performance.","imageSrcUrl":"https://d1.awsstatic.com/architecture-diagrams/customers/healthguru-logo.8ac2690c67c64c3f21676fa2e4bafc938d752489.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eHealth Guru is one of the leading providers of online health information videos. Faced with scalability and performance challenges, the company switched to AWS, resulting in a 92.5% improvement in web service performance.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/health-guru/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Health Guru","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"Health Guru Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-royal-opera-house","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-royal-opera-house","dateCreated":"2019-07-22T19:56:51+0000","dateUpdated":"2022-01-21T02:42:43+0000","additionalFields":{"featured":"0","descriptionSummary":"The Royal Opera House (ROH) is one of the busiest opera houses in the world, home to London\u0027s Royal Opera and the Royal Ballet. Using AWS, The Royal Opera House is able to scale to meet demand for ticket purchasing peaks, improve customer experience and reduce wait times from four hours to a few minutes.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/RoyalOperaHouse_Customer-Reference_Logo.ab27001d05df882ded52aecd23157869d0d0b7e5.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","description":"\u003cp\u003eLast year, London?s Royal Opera House (ROH) conducted 478 performances, reaching 700,000 through its main stage performances. Ticket sales came at predictable peak times, yet these peaks were difficult and costly to manage with outdated IT. Wishing to simplify its infrastructure while creating a more accessible online ticket purchase experience that aligned with ROH?s philosophy of creating better access to the arts, ROH looked for a better solution. Since migrating to the AWS Cloud, ticket purchase wait times have decreased from four hours to minutes.\u003c/p\u003e\r\n","industry":"Nonprofit","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/royal-opera-house/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Royal Opera House","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Royal Opera House"}},"tags":[{"id":"customer-references#customer-segment#public-sector-nonprofit","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Nonprofit","description":"Nonprofit","dateCreated":"2019-07-22T18:39:49+0000","dateUpdated":"2022-05-09T21:31:14+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+0000"},{"id":"GLOBAL#location#uk","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United Kingdom","description":"United Kingdom","dateCreated":"2020-02-03T05:30:18+0000","dateUpdated":"2022-02-03T03:31:52+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases