y#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"}]},{"item":{"id":"customer-references#mercado-libre-pt","locale":"en_US","directoryId":"customer-references","name":"mercado-libre-pt","dateCreated":"2023-06-01T23:08:23+0000","dateUpdated":"2023-08-11T00:24:46+0000","additionalFields":{"descriptionSummary":"Com uma população de mais de 650 milhões de pessoas, a América Latina está testemunhando um dos maiores crescimentos no uso da internet pelo mundo. Desde a sua criação, em 1999, o Mercado Livre aproveitou esse crescimento para se tornar a maior empresa de comércio eletrônico e serviços financeiros da América Latina. O Mercado Livre opera em 18 países e, atualmente, conta com mais de 76 milhões de usuários ativos, segundo dados do trimestre encerrado em junho de 2021. O marketplace do Mercado Livre tem mais de 5 mil vendedores fora da América Latina, que geralmente operam em Inglês.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/r2018/r/seer/customers/600x400_Mercado-Libre_Horizontal_Logo.591869641e3359d8ad7c938d4413445babdacda7.png","displayLocation":"Argentina","footerInfoText":"Data de publicação","industry":"Varejo","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/mercado-libre-pt/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Mercado Libre (Mercado Livre)","enableShare":"1","publishedDate":"2021","contentType":"História do cliente","head