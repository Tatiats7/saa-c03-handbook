 America","description":"Central America","dateCreated":"2021-02-19T05:32:25+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#aws-case-study-kaplan","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-kaplan","dateCreated":"2019-07-22T19:54:00+0000","dateUpdated":"2022-01-21T02:42:10+0000","additionalFields":{"featured":"0","descriptionSummary":"Kaplan is a global provider of educational services for individuals, schools, and businesses. Kaplan migrated the datacenter hosting applications and databases for its Kaplan Test Prep division to the AWS Cloud, allowing it to reduce its datacenter footprint and deliver content faster to customers around the world.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/kaplan-logo.eee9227b02613d24f4585adea037c02feb6253d8.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eKaplan is a global provider of educational services for individuals, schools, and businesses. After Hurricane Sandy in 2012, Kaplan migrated the datacenter hosting applications and databases for the Kaplan Test Prep division to the AWS Cloud. As a result, Kaplan has reduced its datacenter footprint and improved user experience by leveraging multiple AWS regions to deliver content faster to its customers around the world.\u003c/p\u003e\r\n","industry":"Education","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/kaplan/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Kaplan","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Kaplan"}},"tags":[{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"customer-references#category#business-applications-microsoft","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: Microsoft","description":"Business Applications: Microsoft","dateCreated":"2019-07-22T18:31:11+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US