nserv","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Financial Services","description":"Financial Services","dateCreated":"2019-07-22T18:31:53+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#location#norway","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Norway","description":"Norway","dateCreated":"2020-02-03T05:30:09+0000","dateUpdated":"2022-02-03T03:31:51+0000"},{"id":"GLOBAL#product#shield","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Shield","description":"AWS Shield","dateCreated":"2020-03-02T07:05:24+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#location#nordics","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Nordics","description":"Nordics","dateCreated":"2020-02-03T05:30:04+0000","dateUpdated":"2022-02-03T03:31:50+0000"}]},{"item":{"id":"customer-references#telecomargentina","locale":"en_US","directoryId":"customer-references","name":"telecomargentina","dateCreated":"2023-06-01T23:05:33+0000","dateUpdated":"2023-06-08T04:07:41+0000","additionalFields":{"descriptionSummary":"Telecom Argentina es una empresa líder de soluciones de conectividad y entretenimiento con más de 23.000 colaboradores. Ofrece a más de 29 millones de clientes individuales, empresas e instituciones de todo el país servicio seguro, flexible y dinámico, en todos sus dispositivos, con conexiones fijas y móviles de alta velocidad, y una plataforma de contenidos en vivo y a demanda que integra series, películas, gaming, música y programas de TV. En la actualidad está transitando un camino de profunda transformación digital de sus operaciones y de su cultura, en la que la cloudificación resulta uno de los principales habilitadores tecnológicos.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/telecom_logo%401x.9e357acae61471fdcc122f4a221253c1ca8ba99d.png","displayLocation":"Argentina","customerNameLower":"telecom argentina","footerInfoText":"Fecha de publicación","industry":"Telecomunicaciones","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/telecomargentina/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Telecom Argentina","enableShare":"1","publishedDate":"2020","contentType":"Historia del cliente","headline":"Telecom Argentina inicia su estrategia de cloud hibrida con AWS"}},"tags":[{"id":"GLOBAL#product#elastic-beanstalk","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elastic Beanstalk","description":"AWS Elastic Beanstalk","dateCreated":"2020-03-02T07:03:00+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#product#mgmt-console","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Management Console","descriptio