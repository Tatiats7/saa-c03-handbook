on":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#aws-case-study-ie-business-school","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-ie-business-school","dateCreated":"2019-07-22T19:58:32+0000","dateUpdated":"2022-01-21T02:43:01+0000","additionalFields":{"featured":"0","descriptionSummary":"IE University, located in Madrid, is a top international business graduate school that incorporates a significant online component. Using an AWS solution, the school improved access to more than 99.9 percent uptime for students and instructors located worldwide.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/IE_logo.34971daeb1ff3af7eb9d36e970320735acdf5de1.jpg","displayLocation":"Spain","footerInfoText":"Published Date","description":"\u003cp\u003eIE is an international graduate school in Madrid, Spain. The school is dedicated to educating business leaders based on a global focus, entrepreneurial spirit, and humanistic approach. IE includes an international faculty of 600 instructors and students representing more than 90 nationalities. Over 45,000 alumni hold management positions in 100 countries. IE stresses high-quality research and multidisciplinary, integrative education programs. The school?s innovative learning processes blends online and onsite formats, making it a pioneer in international education. IE has been ranked the number one business school in Europe by both the Financial Times and BusinessWeek.\u003c/p\u003e\r\n","industry":"Education","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ie-business-school/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"IE Business School","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: IE Business School"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","descr