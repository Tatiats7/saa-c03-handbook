gory#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#business-category#cloud-cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-06-05T07:06:41+0000","dateUpdated":"2022-02-03T03:31:02+0000"},{"id":"GLOBAL#product#guardduty","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon GuardDuty","description":"Amazon GuardDuty","dateCreated":"2020-03-02T07:03:46+0000","dateUpdated":"2022-02-03T03:32:40+0000"},{"id":"GLOBAL#product#textract","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Textract","description":"Amazon Textract","dateCreated":"2020-03-02T07:05:47+0000","dateUpdated":"2022-02-03T03:33:04+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"}]},{"item":{"id":"customer-references#evidence-technology","locale":"en_US","directoryId":"customer-references","name":"evidence-technology","dateCreated":"2023-06-01T23:03:31+0000","dateUpdated":"2023-06-08T04:07:44+0000","additionalFields":{"descriptionSummary":"Evidence Technology es una empresa mexicana que ha creado un sistema de gestión empresarial, ofreciendo sus servicios a pequeñas y medianas empresas principalmente. Por medio de innovaciones tecnológicas, radicadas totalmente en la nube y en alianza con AWS, ha logrado facilitar y automatizar los procesos de administración en más de 21 industrias, a quienes no solo les ha permitido tener acceso a una tecnología de punta, sino que, además, les da un gran abanico de soluciones concentradas en un solo sistema, que cuenta con la confianza, seguridad y calidad de AWS.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/evidence-technology-logo%402x.e26aed23de280969693fc6363ca61c246b56a5ab.png","displayLocation":"México","customerNameLower":"evidence","footerInfoText":"Fecha de publicación","industry":"Software e Internet","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/evidence-technology/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Evidence","enableShare":"1","publishedDate":"2021","contentType":"Historia del cliente","headline":"Evidence Technology: PyMEs favorecidas por la infraestructura basada en AWS"}},"tags":[{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#ec2-auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Auto Scaling","description":"Amazon EC2 Auto Scaling","dateCreated":"2020-03-02T07:02:53+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#lightsail","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Lightsail","description":"Amazon Lightsail","dateCreated":"2020-03-02T07:04:25+0000","dateUpdated":"2022-02-03T03:32:47+0000