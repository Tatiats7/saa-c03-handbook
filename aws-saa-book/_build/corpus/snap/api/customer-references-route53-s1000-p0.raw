S","tagNamespaceId":"GLOBAL#tech-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-01-16T17:43:13+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#comprehend","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Comprehend","description":"Amazon Comprehend","dateCreated":"2020-03-02T07:02:18+0000","dateUpdated":"2022-02-03T03:32:25+0000"},{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12T02:01:29+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"}]},{"item":{"id":"customer-references#dnb-case-study","locale":"en_US","directoryId":"customer-references","name":"dnb-case-study","dateCreated":"2020-11-09T18:04:13+0000","dateUpdated":"2021-12-23T00:24:27+0000","additionalFields":{"descriptionSummary":"DNB is the largest financial services group in Norway, offering loans, savings, insurance, and pension products. It has 2 million retail customers, 226,000 corporate clients, and around 9,000 employees.In this video, Nicolai Rygh, chief information officer and executive vice president for personal banking at DNB, explains how and why the company used Amazon Web Services (AWS) to build its new mobile banking app.The bank wanted to move away from its monolithic application, so it built more than 40 serverless AWS Lambda functions running in Amazon Virtual Private Cloud subnets to segregate data. APIs connect the app to core banking services in on-premises datacenters. The app uses Amazon Route 53, Amazon CloudFront, and AWS Shield Advanced for security and networking. The bank has also taken the opportunity to rehost its chatbot and small-business app on AWS and is currently working on a project to migrate its website.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/DNB_Customer-Reference_Logo_@1x.93efbb59d75a60adf48384baae771a352d07238b.png","displayLocation":"Norway","footerInfoText":"Published Date","industry":"Banking","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/dnb-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"DNB Transforms Customer Interactions with New Mobile Banking App","customer-name":"DNB"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#banking","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Banking","description":"Banking","dateCreated":"2021-12-14T00:56:19+00