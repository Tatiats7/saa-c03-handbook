 Hosting","description":"Web Hosting","dateCreated":"2019-07-22T18:32:28+0000","dateUpdated":"2022-03-30T20:30:49+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#codedeploy","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodeDeploy","description":"AWS CodeDeploy","dateCreated":"2020-03-02T07:02:12+0000","dateUpdated":"2022-02-03T03:32:24+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#devtools","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Developer Tools","description":"Developer Tools","dateCreated":"2020-01-16T17:43:16+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#berlin-philharmonic-case-study","locale":"en_US","directoryId":"customer-references","name":"berlin-philharmonic-case-study","dateCreated":"2019-07-19T17:08:50+0000","dateUpdated":"2022-01-21T02:40:23+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, the Berlin Philharmonic can stream 200 HD videos simultaneously and provides users with the best possible viewing experience by utilizing multiple AWS Regions. The Berlin Philharmonic\u0027s Digital Concert Hall provides a virtual concert hall for its listeners all over the world, letting listeners enjoy recorded concerts uninterrupted.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/BerlinerPhilharmoniker_Customer-Reference__Logo.15e57ed8a697caf0141889f862a285a61418e5f0.png","displayLocation":"Germany","footerInfoText":"Published Date","description":"\u003cp\u003eThe Berlin Philharmonic, together with the Digital Concert Hall, provides a virtual concert hall for its listeners all over the world. Through the use of AWS, the Berlin Philharmonic lets its listeners enjoy recorded concerts uninterrupted, no matter where in the world these classical music fans are found.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/bph/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Berlin Philharmonic","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Berlin Philharmonic Case Study"}},"tags":[{"id":"GLOBAL#location#germany","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Germany","description":"Germany","dateCreated":"2020-02-03T05:29:55+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02