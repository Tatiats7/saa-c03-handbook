-study-9gag","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-9gag","dateCreated":"2019-07-22T20:00:23+0000","dateUpdated":"2023-07-14T23:32:39+0000","additionalFields":{"featured":"0","descriptionSummary":"After switching to AWS, Hong Kong-based 9GAG, Inc. reported improved availability for its entertainment website, a 20 percent improvement in server response time, and a nearly 20 percent improvement in overall network activity.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/9GAG_Customer-Reference_Logo.87620e7b3b5b1964c644f4c258e29d934618c736.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","description":"\u003cp\u003eAfter switching to Amazon Web Services (AWS), Hong Kong-based 9GAG, Inc. reports improved availability for its entertainment website, a 20% improvement in server response time, and a nearly 20% improvement in overall network activity.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/9gag/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"9GAG","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: 9GAG"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#tech-category#databases",