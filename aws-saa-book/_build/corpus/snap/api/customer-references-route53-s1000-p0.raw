":"2023-06-08T04:07:48+0000","additionalFields":{"descriptionSummary":"Desde 2015, a companhia vem passando por um processo de transformação digital com o objetivo de transformar-se em uma plataforma de soluções que alia experiência de compra e atendimento diferenciado. Parte desta estratégia, o desenvolvimento e a integração de seus canais digitais vem sendo realizado desde 2019 com base na nuvem e nos serviços AWS.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/petz_logo%402x.2679386e60793ce42d7ceb76d81dcd52298d3ac0.png","displayLocation":"Brasil","customerNameLower":"petz","footerInfoText":"Data de publicação","industry":"Varejo","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/petz-digital-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Petz","enableShare":"1","publishedDate":"2023","contentType":"História do cliente","headline":"AWS acelera transformação digital da Petz"}},"tags":[{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Auto Scaling","description":"AWS Auto Scaling","dateCreated":"2020-03-02T07:01:39+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverles