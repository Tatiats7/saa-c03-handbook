ch-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#transdev","locale":"en_US","directoryId":"customer-references","name":"transdev","dateCreated":"2024-06-11T01:50:37+0000","dateUpdated":"2024-06-11T01:58:35+0000","additionalFields":{"descriptionSummary":"Transdev a choisi de mener de front une double transformation : la modernisation de ses environnements informatiques obsolètes et la migration de ces mêmes environnements vers le cloud en un seul trajet. En 2016, le groupe initie donc un premier mouvement vers le cloud, convaincu qu’opérer un datacenter va devenir une mission trop complexe et coûteuse à l’avenir. Après une pause liée à la pandémie, le groupe a migré en 2022 plus de 400 serveurs de production et une centaine d’applications, et a pu décommissionner son data center en France fin 2023.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/transdev-logo%401x.c5525f6a0dec152e8ec9e15312df71e301e8c39e.png","displayLocation":"France","customerNameLower":"transdev","footerInfoText":"Published Date","industry":"Transport \u0026 Logistics","sortDate":"2024-04-16","headlineUrl":"https://aws.amazon.com/solutions/case-studies/transdev/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Transdev","publishedDate":"2024","enableShare":"1","headline":"Transdev valide son ticket pour le Cloud AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#elb","locale":"en_US","tagNamespaceId":"GLOBAL#product