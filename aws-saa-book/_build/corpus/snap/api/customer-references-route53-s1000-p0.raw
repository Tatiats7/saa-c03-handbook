cription":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#elb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Elastic Load Balancing (ELB)","description":"Elastic Load Balancing (ELB)","dateCreated":"2020-03-02T07:03:09+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"}]},{"item":{"id":"customer-references#waypoint","locale":"en_US","directoryId":"customer-references","name":"waypoint","dateCreated":"2023-06-01T23:03:55+0000","dateUpdated":"2023-06-08T04:07:43+0000","additionalFields":{"descriptionSummary":"Waypoint es una empresa chilena dedicada al desarrollo de logística, despacho, control y monitoreo de transporte de servicio y alimentos, mediante tecnología telemétrica y localización GPS. Las operaciones de Waypoint exigen un control absoluto de tracking de origen a destino, cumpliendo cada una de las demandas del servicio que ofrecen a sus clientes. En el año 2015, una crisis de blackout por espacio de 16 horas, produjo la necesidad de buscar un proveedor de tecnología que les permitiera blindar los procesos. Así aparece AWS para Waypoint. Para conocer más detalle sobre la historia, vea a Gonzalo Vásquez, Gerente de Investigación y Desarrollo de la compañía, quien explica por qué AWS les ha permitido mantener el control de una manera no sólo inmediata sino transparente, beneficiando a sus clientes finales. Conozca su experiencia sobre la tecnología y servicio de AWS y el impacto en el mejoramiento del negocio de Waypoint.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/case-studies/Latam%20Cases%20Assets/Waypoint_LOGO1.a773dad7304ac53374e6cae8b348902c08b232ff.png","displayLocation":"Chile","customerNameLower":"waypoint","footerInfoText":"Fecha de publicación","industry":"Servicios profesionales","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/waypoint/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Waypoint","enableShare":"1","publishedDate":"2019","contentType":"Historia del cliente","headline":"Caso práctico de Waypoint"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:1