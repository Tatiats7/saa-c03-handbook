020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-ramco","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-ramco","dateCreated":"2019-07-22T19:54:38+0000","dateUpdated":"2023-07-14T23:32:41+0000","additionalFields":{"featured":"0","descriptionSummary":"Ramco Systems provides cloud-based enterprise solutions to more than 150,000 users in over 35 countries. By leveraging AWS, Ramco can improve server-provisioning time for customers by more than 80 percent, while reducing both its capital and operating expenditures by more than 40 percent compared to its on-premise data center.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Ramco_Customer-Reference_Logo.3590cabd66318c675db741f6096f955380f4029d.png","displayLocation":"India","footerInfoText":"Published Date","description":"\u003cp\u003eRamco Systems provides cloud-based enterprise solutions to more than 150,000 users in over 35 countries. By leveraging Amazon Web Services (AWS), Ramco is able to improve server-provisioning time for customers by more than 80%, while reducing both its capital and operating expenditures by more than 40% compared to its on-premises data center.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ramco/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ramco","enableShare":"1","