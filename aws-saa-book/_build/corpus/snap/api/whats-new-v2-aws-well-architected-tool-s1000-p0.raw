{"items":[{"item":{"id":"whats-new-v2#launch-xustb4thuut5na6limp5rt","locale":"en_US","directoryId":"whats-new-v2","name":"launch-xustb4thuut5na6limp5rt","dateCreated":"2026-10-01T19:19:05+0000","dateUpdated":"2026-10-01T20:16:53+0000","additionalFields":{"nofollow":"0","noindex":"0","postBody":"\u003cp\u003eAWS announces the preview of AWS Well-Architected Agent, a AI-powered service that is the next-gen evolution of AWS Trusted Advisor and the AWS Well-Architected Tool. The agent analyzes and optimizes AWS infrastructure across cost, security, performance, and reliability, delivering contextualized recommendations prioritized by business goals. It automatically correlates key metrics and application topology against Well-Architected best practices and analyzes Terraform, CDK templates and CloudFormation templates to deliver automation-ready fixes where applicable.\u003c/p\u003e\n\u003cp\u003eWith AWS Well-Architected Agent, teams can define their business goals and get prioritized recommendations prioritized by impact and effort at the resource, application, and architecture levels. For example, a team prioritizing reliability can receive recommendations to add multi-AZ failover to a critical database, complete with an SSM runbook that automates the configuration change and a cross-pillar analysis showing how this change affects cost and performance before you commit. Where applicable, recommendations are delivered with SSM runbooks, prescriptive CLI scripts, and guided console walkthroughs so teams can move quickly. The agent can also conduct automated reviews of your IaC templates that include Terraform, CloudFormation, or CDK templates, identifying\u0026nbsp;gaps, and returning the IaC code changes needed to align with Well-Architected best practices.\u003c/p\u003e\n\u003cp\u003eAccess to the AWS Well-Architected Agent and its recommendations is available in US East (N. Virginia), US East (Ohio), and US West (Oregon). You can onboard workloads from any AWS commercial Region. AWS Well-Architected Agent is delivered by AWS Support and available to AWS customers with an AWS Support plan.\u003c/p\u003e\n\u003cp\u003eLearn more about AWS Well-Architected Agent in the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/userguide/wa-agent.html\"\u003eUser Guide\u003c/a\u003e. Get started \u003ca href\u003d\"https://us-east-1.console.aws.amazon.com/wellarchitected/home?region\u003dus-east-1#/\"\u003ehere\u003c/a\u003e.\u003c/p\u003e\n","nosnippet":"0","headlineUrl":"/about-aws/whats-new/2026/10/aws-well-architected-agent/","postDateTime":"2026-10-01T20:00:00Z","headline":"AWS Well-Architected Agent is now available in preview "}},"tags":[{"id":"whats-new-v2#general-products#aws-support","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-support","description":"general:products/aws-support","dateCreated":"2023-11-09T13:57:23+0000","dateUpdated":"2023-11-09T13:57:23+0000"},{"id":"whats-new-v2#year#2026","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2026","description":"description placeholder","dateCreated":"2025-12-05T19:55:40+0000","dateUpdated":"2025-12-05T19:55:40+0000"},{"id":"whats-new-v2#general-products#aws-cloudformation","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-cloudformation","description":"general:products/aws-cloudformation","dateCreated":"2023-11-09T13:50:49+0000","dateUpdated":"2023-11-09T13:50:49+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#marketing-marchitecture#cost-management","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"cost-management","description":"marketing:marchitecture/cost-management","dateCreated":"2023-11-07T18:00:11+0000","dateUpdated":"2023-11-07T18:00:11+0000"},{"id":"whats-new-v2#general-products#aws-cloud-development-kit","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-cloud-development-kit","description":"general:products/aws-cloud-development-kit","dateCreated":"2023-11-09T13:55:46+0000","dateUpdated":"2023-11-09T13:55:46+0000"},{"id":"whats-new-v2#general-products#aws-trusted-advisor","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-trusted-advisor","description":"general:products/aws-trusted-advisor","dateCreated":"2023-11-09T13:58:48+0000","dateUpdated":"2023-11-09T13:58:48+0000"},{"id":"whats-new-v2#general-products#aws-systems-manager","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-systems-manager","description":"general:products/aws-systems-manager","dateCreated":"2023-11-09T13:50:46+0000","dateUpdated":"2023-11-09T13:50:46+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"}]},{"item":{"id":"whats-new-v2#launch-o3qt8jeadcmpd1jakud9jn","locale":"en_US","directoryId":"whats-new-v2","name":"launch-o3qt8jeadcmpd1jakud9jn","dateCreated":"2025-11-13T19:28:35+0000","dateUpdated":"2025-11-24T18:54:16+0000","additionalFields":{"nofollow":"0","noindex":"0","postBody":"\u003cp\u003eToday, AWS announces the release of one new - Responsible AI and two updated Machine Learning and Generative AI Well-Architected Lenses. These lenses are designed to help organizations implement AI workloads that prioritize responsible AI practices, technical excellence, and specialized business use-cases. These lenses provide comprehensive guidance for organizations at any stage of their AI journey, addressing the growing need for structured approaches to building responsible, secure, reliable, and efficient AI workloads. The lenses are particularly valuable for business leaders, data scientists, ML engineers, and risk and compliance professionals working with AI technologies.\u003cbr\u003e\n\u003cbr\u003e\nThe three AI lenses - Responsible AI, Generative AI, and Machine Learning - work together to provide a comprehensive guidance for AI development. The Responsible AI lens guides safe, fair, and secure AI development. It helps balance business needs with technical requirements, streamlining the transition from experimentation to production. The Generative AI lens helps customers evaluate large language model (LLM) based architectures and it’s updates include guidance for Amazon SageMaker HyperPod users, new insights on Agentic AI, and updated architectural scenarios. The Machine Learning lens guides organizations in evaluating workloads across both modern AI and traditional machine learning approaches. Recent updates focus on key areas including enhanced data and AI collaborative workflows, AI-assisted development capabilities, large-scale infrastructure provisioning, and customizable model deployment. These improvements are powered by key AWS services including Amazon SageMaker Unified Studio, Amazon Q, Amazon SageMaker HyperPod, and Amazon Bedrock.\u003cbr\u003e\n\u003cbr\u003e\nRead the \u003ca href\u003d\"https://aws.amazon.com/blogs/architecture/architecting-for-ai-excellence-aws-launches-three-well-architected-lenses-at-reinvent-2025/\" target\u003d\"_blank\"\u003elaunch blog\u003c/a\u003e to learn more about our launches, comprehensive architectural guidance throughout your AI journey, and implementation strategies.\u003c/p\u003e\n","nosnippet":"0","headlineUrl":"/about-aws/whats-new/2025/11/new-aws-well-architected-lenses-ai-ml-workloads","postDateTime":"2025-11-18T17:00:00Z","headline":"New AWS Well-Architected Lenses for AI and ML workloads"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#general-products#aws-govcloud-us","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-govcloud-us","description":"general:products/aws-govcloud-us","dateCreated":"2023-11-07T18:41:18+0000","dateUpdated":"2023-11-07T18:41:18+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#year#2025","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2025","description":"\u003cp\u003e2025\u003c/p\u003e\n","dateCreated":"2024-12-30T16:07:22+0000","dateUpdated":"2024-12-30T16:07:22+0000"}]},{"item":{"id":"whats-new-v2#v1729248680","locale":"en_US","directoryId":"whats-new-v2","name":"launch-c3c3i6KqXRRHgJz6pbksbB","dateCreated":"2025-04-17T17:34:06+0000","dateUpdated":"2025-04-17T21:56:07+0000","additionalFields":{"headlineUrl":"/about-aws/whats-new/2025/04/well-architected-generative-ai-lens/","postBody":"\u003cp\u003eThe AWS Well-Architected Generative AI Lens is now available, offering a guidance document to optimize generative AI workloads in the cloud. This new lens is a powerful addition to the Well-Architected Framework, designed to guide organizations through the complexities of implementing generative AI workloads. It provides structured, prescriptive guidance covering the entire generative AI lifecycle - from initial impact scoping to model selection, customization, integration, deployment, and continuous iteration.\u003cbr /\u003e\n\u003cbr /\u003e\nThe lens offers several key benefits, including cloud-agnostic guidance applicable across various environments and AI tools, comprehensive coverage of all six Well-Architected pillars, and flexible application for organizations at any stage of their AI journey. It enables thorough assessment of architectures using large language models (LLMs) and helps business leaders and data scientists navigate critical decisions in generative AI implementation.\u003cbr /\u003e\n\u003cbr /\u003e\nBy addressing specific data architecture requirements for generative AI workloads and providing a framework for continuous improvement, this lens promotes a robust, secure, and efficient solutions. Whether you\u0026#39;re exploring your first generative AI project or scaling existing implementations, the Well-Architected Generative AI Lens offers insights to enhance your cloud-based AI initiatives.\u003cbr /\u003e\n\u003cbr /\u003e\nThe Generative AI Lens is available as an AWS-official lens in the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/userguide/lens-catalog.html\" target\u003d\"_blank\"\u003eLens Catalog\u003c/a\u003e of the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/userguide/intro.html\" target\u003d\"_blank\"\u003eAWS Well-Architected Tool\u003c/a\u003e.\u003cbr /\u003e\n\u0026nbsp;\u003c/p\u003e\n","postDateTime":"2025-04-17T10:00:00-07:00","headline":"Introducing the Well-Architected Generative AI Lens"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#year#2025","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2025","description":"\u003cp\u003e2025\u003c/p\u003e\n","dateCreated":"2024-12-30T16:07:22+0000","dateUpdated":"2024-12-30T16:07:22+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"}]},{"item":{"id":"whats-new-v2#v1711019351","locale":"en_US","directoryId":"whats-new-v2","name":"xkgmi2rQ7QvTQsKfzsvCfB","dateCreated":"2025-03-21T16:00:16+0000","dateUpdated":"2025-04-09T17:02:11+0000","additionalFields":{"nofollow":"0","noindex":"0","postBody":"\u003cp\u003eThe latest Well-Architected Framework update is now available in the Well-Architected Tool, featuring updates and improvements for 78 new best practices that offer actionable guidance to help organizations build more secure, resilient, scalable, and sustainable workloads.\u003cbr /\u003e\n\u003cbr /\u003e\nWith this release, the Well-Architected Framework has refreshed 100% of each pillar, including the Reliability Pillar, with 14 of its best practices updated for the first time since major Framework improvements started in 2022.\u003cbr /\u003e\n\u003cbr /\u003e\nWith the refreshed AWS Well-Architected Framework, organizations can use our actionable guidance to help achieve more operable, secure, sustainable, scalable, and resilient environment and workload solutions.\u003cbr /\u003e\n\u003cbr /\u003e\nThe updated AWS Well-Architected Framework is available now for all AWS customers. To learn more about the AWS Well-Architected Framework, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/framework/welcome.html\" target\u003d\"_blank\"\u003eAWS Well-Architected Framework documentation\u003c/a\u003e.\u003c/p\u003e\n","nosnippet":"0","headlineUrl":"/about-aws/whats-new/2025/04/new-guidance-well-architected-tool","postDateTime":"2025-04-09T13:00:00-04:00","headline":"New Guidance in the Well-Architected Tool"}},"tags":[{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#year#2025","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2025","description":"\u003cp\u003e2025\u003c/p\u003e\n","dateCreated":"2024-12-30T16:07:22+0000","dateUpdated":"2024-12-30T16:07:22+0000"}]},{"item":{"id":"whats-new-v2#p164172708","locale":"en_US","directoryId":"whats-new-v2","name":"iogXxnwt6vup38iDBLnQJA","dateCreated":"2024-10-29T18:23:26+0000","dateUpdated":"2024-11-06T19:19:21+0000","additionalFields":{"nofollow":"0","noindex":"0","postBody":"\u003cp\u003eToday, we are announcing updates to the AWS Well-Architected Framework, featuring comprehensive guidance to help customers build and operate secure, high-performing, resilient, and efficient workloads on AWS. This update includes 14 newly refreshed best practices, including the Reliability Pillar, representing the first major improvements since 2022.\u003cbr /\u003e\n\u003cbr /\u003e\nThe refreshed Framework offers prescriptive guidance, expanded best practices, and updated resources to help customers tailor AWS recommendations to their specific needs, accelerating cloud adoption and applying best practices more effectively.\u003cbr /\u003e\n\u003cbr /\u003e\nThese updates strengthen workload security, reliability, and efficiency, empowering organizations to scale confidently and build resilient, sustainable architectures. The Reliability Pillar, in particular, provides deeper insights for creating dependable cloud solutions.\u003cbr /\u003e\n\u003cbr /\u003e\nWhat partners are saying about the updated guidance: Well-Architected Partner, 6Pillar, CEO, Lorenzo Modesto \u0026ldquo;While the updated content that the AWS Well-Architected Team is generating is massively helpful for both WA Partners and those AWS Consulting Partners who want to become WA Partners, what\u0026rsquo;s most powerful is the focus on partners automating their WA practices.\u0026rdquo;\u003cbr /\u003e\n\u003cbr /\u003e\nThe updated AWS Well-Architected Framework is available now for all AWS customers. Updates in this release will be incorporated into the AWS Well-Architected Tool in future releases, which you can use to review your workloads, address important design considerations, and help you follow the AWS Well-Architected Framework guidance. To learn more about the AWS Well-Architected Framework, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/framework/welcome.html\" target\u003d\"_blank\"\u003eAWS Well-Architected Framework documentation\u003c/a\u003e.\u003cbr /\u003e\n\u0026nbsp;\u003c/p\u003e\n","nosnippet":"0","headlineUrl":"/about-aws/whats-new/2024/11/aws-well-architected-enhanced-implementation-guidance","postDateTime":"2024-11-06T14:15:00-05:00","contentType":"launch announcement","headline":"AWS Well-Architected adds enhanced implementation guidance"}},"tags":[{"id":"whats-new-v2#year#2024","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2024","description":"year#2024","dateCreated":"2024-01-02T21:28:59+0000","dateUpdated":"2024-09-17T18:03:36+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"}]},{"item":{"id":"whats-new-v2#v1404552991","locale":"en_US","directoryId":"whats-new-v2","name":"launch-of9XDTc3fB5CuwZ6FUC1aj","dateCreated":"2024-06-21T16:44:06+0000","dateUpdated":"2024-06-27T20:10:21+0000","additionalFields":{"headlineUrl":"/about-aws/whats-new/2024/06/updates-expansion-aws-well-architected-lens-catalog/","postBody":"\u003cp\u003eAWS is excited to announce updates to the Well-Architected Framework and Lens Catalog. This latest update brings a comprehensive expansion to customers with expanded guidance on architectural best practices, empowering them to build and maintain optimized, secure, and resilient workloads in the cloud.\u003cbr /\u003e\n\u003cbr /\u003e\nThe Framework updates provide more recommendations for AWS services, observability, generative AI, and operating models. We also refreshed the lists of resources and overall Framework structure. This update reduces redundancies, enhances consistency, and empowers customers to more accurately identify and address risks.\u003cbr /\u003e\n\u003cbr /\u003e\nWe also expanded the Lens Catalog in the Well-Architected Tool to include additional industry-specific best practices. The Lens Catalog now includes the new \u003ca href\u003d\"https://aws.amazon.com/blogs/industries/announcing-the-aws-well-architected-financial-service-industry-lens/\" target\u003d\"_blank\"\u003eFinancial Services Industry Lens\u003c/a\u003e and updates to the \u003ca href\u003d\"https://aws-blogs-prod.amazon.com/mt/announcing-the-aws-well-architected-mergers-and-acquisitions-lens/\" target\u003d\"_blank\"\u003eMergers and Acquisitions Lens.\u003c/a\u003e Additionally, we made significant updates to the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/change-enablement-in-the-cloud/change-enablement-in-the-cloud.html\" target\u003d\"_blank\"\u003eChange Enablement in the Cloud whitepaper\u003c/a\u003e. With these updates to lenses and guidance, customers can optimize, secure, and align their cloud architectures based on their unique requirements.\u003cbr /\u003e\n\u003cbr /\u003e\nBy leveraging the updated Well-Architected Framework and Lens Catalog, customers can follow the most current and comprehensive architectural best practices to confidently design, deploy, and operate their workloads in the cloud. To learn more about the AWS Well-Architected Framework and Lens Catalog updates, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/framework/welcome.html\" target\u003d\"_blank\"\u003eAWS Well-Architected Framework documentation \u003c/a\u003eand explore the updated lenses in the \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected\" target\u003d\"_blank\"\u003eWell-Architected Tool\u003c/a\u003e.\u003cbr /\u003e\n\u0026nbsp;\u003c/p\u003e\n","postDateTime":"2024-06-27T10:00:00-07:00","headline":"Updates and Expansion to the AWS Well-Architected Framework and Lens Catalog"}},"tags":[{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#year#2024","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2024","description":"year#2024","dateCreated":"2024-01-02T21:28:59+0000","dateUpdated":"2024-01-02T21:28:59+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2024-04-aws-well-architected-tool-connector-jira","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2024/04/aws-well-architected-tool-connector-jira/","dateCreated":"2024-04-16T19:03:56+0000","dateUpdated":"2024-07-25T14:49:01+0000","additionalFields":{"postBody":"\u003cp\u003eToday, AWS Well-Architected introduces a new connector for Jira, which helps you create a closed-loop mechanism to efficiently manage and track your risks over time. You can now configure the Well-Architected Tool to generate Jira tickets and send updates directly to the Well-Architected Tool as tickets are resolved.\u003c/p\u003e\r\n\u003cp\u003eYou can now easily monitor progress from initial risk identification through remediation in one streamlined workflow. Increase your efficiency by reducing manual effort of marking Best Practices as complete in the Well-Architected Tool. Jira tickets will include notes from the Well-Architected Tool, providing seamless context and allowing you to address issues and improvements quickly.\u003c/p\u003e\r\n\u003cp\u003eUse the AWS Well-Architected Tool Connector for Jira in the following AWS Regions: US East (N. Virginia, Ohio), US West (N. California, Oregon), Canada (Central), Europe (Frankfurt, Ireland, London, Paris, Stockholm), South America (São Paulo), Asia Pacific (Singapore, Sydney, Tokyo, Seoul, Mumbai, Hong Kong), Middle East (Bahrain).\u003c/p\u003e\r\n\u003cp\u003eFor more information, see the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/userguide/jira.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Tool documentation\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2024-04-16T19:03:39Z","headlineUrl":"/about-aws/whats-new/2024/04/aws-well-architected-tool-connector-jira/","postDateTime":"2024-04-16T07:00:00Z","contentType":"Launch Announcement","headline":"Announcing the AWS Well-Architected Tool Connector for Jira","postSummary":"\u003cp\u003eToday, AWS Well-Architected introduces a new connector for Jira, which helps you create a closed-loop mechanism to efficiently manage and track your risks over time. You can now configure the Well-Architected Tool to generate Jira tickets and send updates directly to the Well-Architected Tool as tickets are resolved.\u003c/p\u003e\r\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#year#2024","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2024","description":"year#2024","dateCreated":"2024-01-02T21:28:59+0000","dateUpdated":"2024-01-02T21:28:59+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2024-03-well-architected-new-lenses-lens-catalog","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2024/03/well-architected-new-lenses-lens-catalog/","dateCreated":"2024-03-26T17:02:43+0000","dateUpdated":"2024-07-25T14:48:47+0000","additionalFields":{"postBody":"\u003cp\u003eAWS is pleased to announce 4 new  industry and domain specific lenses to the Lens Catalog within the AWS Well-Architected Tool. This update gives customer access to additional expert-authored lenses so they can better tailor their reviews to focus on industry-specific and technology-focused topics most relevant to their business\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003e\u0026nbsp;Each lens provides a comprehensive set of guidelines and questions that help customers focus on critical aspects relevant to their specific domain, with industry best practices. The Connected Mobility Lens highlights the integration of IoT and machine learning for automotive companies. The Government Lens provides a path for compliance, security, and scalability for public sector functions. The DevOps Guidance Lens aims to speed up innovation while adhering to regulatory norms. The Migration Lens delivers an effective approach for transferring workloads to AWS efficiently. Lastly, the  Data Analytics Lens has been updated to offer additional insights into analytics.\u0026nbsp;\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003e\u0026nbsp;AWS will continue to add lenses to the Lens Catalog as new technologies emerge, ensuring you can always stay up to date with the latest trends.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eThe lenses in Lens Catalog are available in all AWS Regions where the AWS Well-Architected Tool is available and are also available as white papers. To get started using the Lens Catalog and the variety of new lenses, log into the AWS Well-Architected Tool via\u0026nbsp;the \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Management Console\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2024-03-26T17:02:30Z","headlineUrl":"/about-aws/whats-new/2024/03/well-architected-new-lenses-lens-catalog/","postDateTime":"2024-03-26T12:00:00Z","contentType":"Launch Announcement","headline":"Well-Architected adds 4 new lenses to the Lens Catalog","postSummary":"\u003cp\u003eAWS is pleased to announce 4 new  industry and domain specific lenses to the Lens Catalog within the AWS Well-Architected Tool. This update gives customer access to additional expert-authored lenses so they can better tailor their reviews to focus on industry-specific and technology-focused topics most relevant to their business\u003cbr\u003e\r\n\u003c/p\u003e\r\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2024","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2024","description":"year#2024","dateCreated":"2024-01-02T21:28:59+0000","dateUpdated":"2024-01-02T21:28:59+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2023-11-aws-well-architected-tool-lens-catalog","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2023/11/aws-well-architected-tool-lens-catalog/","dateCreated":"2023-11-27T03:34:09+0000","dateUpdated":"2024-07-25T14:55:59+0000","additionalFields":{"postBody":"\u003cp\u003eToday, \u003ca href\u003d\"https://aws.amazon.com/architecture/well-architected/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected\u003c/a\u003e (AWS WA) announces the general availability of the Lens Catalog in the \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Tool\u003c/a\u003e (AWS WA Tool). The Lens Catalog is a new, central lens repository for customers looking to explore, review, and implement the latest cloud best practices available from AWS.\u003c/p\u003e\r\n\u003cp\u003eThe Lens Catalog provides you with a central place to access expert-authored lenses from AWS. The Lens Catalog significantly expands the breadth and depth of industry-specific and technology-focused lenses, so you can better tailor your reviews to focus on the topics most important to your business. AWS will continue to add lenses to the Lens Catalog as new technologies emerge, ensuring you can always stay up to date with the latest trends.\u003c/p\u003e\r\n\u003cp\u003eThe Lens Catalog is available in all AWS Regions where the AWS WA Tool is available. See the \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Services By Region\u003c/a\u003e list for the latest information.\u0026nbsp;\u003c/p\u003e\r\n\u003cp\u003eTo get started using the Lens Catalog, log into the AWS Well-Architected Tool via the \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Management Console\u003c/a\u003e or view the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/userguide/lens-catalog.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003edocumentation\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2023-11-27T04:24:32Z","headlineUrl":"/about-aws/whats-new/2023/11/aws-well-architected-tool-lens-catalog/","postDateTime":"2023-11-26T08:00:00Z","contentType":"Launch Announcement","headline":"Announcing Lens Catalog for the AWS Well-Architected Tool","postSummary":"\u003cp\u003eToday, \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/architecture/well-architected.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected\u003c/a\u003e (AWS WA) announces the general availability of the Lens Catalog in the \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/well-architected-tool.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Tool\u003c/a\u003e (AWS WA Tool). The Lens Catalog is a new, central lens repository for customers looking to explore, review, and implement the latest cloud best practices available from AWS.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#year#2023","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2023","description":"year#2023","dateCreated":"2023-11-07T18:00:12+0000","dateUpdated":"2023-11-07T18:00:12+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#general-products#aws-govcloud-us","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-govcloud-us","description":"general:products/aws-govcloud-us","dateCreated":"2023-11-07T18:41:18+0000","dateUpdated":"2023-11-07T18:41:18+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2023-10-reduce-duplication-well-architected-templates","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2023/10/reduce-duplication-well-architected-templates/","dateCreated":"2023-11-09T14:53:56+0000","dateUpdated":"2024-07-25T14:57:51+0000","additionalFields":{"postBody":"\u003cp\u003eIntroducing AWS Well-Architected Review Templates, designed to eliminate duplication and foster consistency across your workloads. With the Well-Architected Tool\u0027s latest feature, you can effortlessly craft review templates to answer questions, update notes, and even incorporate Custom Lenses across your workloads.\u003c/p\u003e\r\n\u003cp\u003eMoreover, you can apply these templates to define new workloads, providing workload owners with a pre-populated baseline to kick-start their reviews. Review templates empower your teams to concentrate on the pivotal aspects of their workloads, ensure uniformity in reviews, and eradicate redundancy for commonly asked questions. Experience a more efficient workflow with Well-Architected review templates.\u003c/p\u003e\r\n\u003cp\u003eThe Review Templates feature in the AWS Well-Architected Tool is now available in the following AWS Regions: US East (N. Virginia, Ohio), US West (N. California, Oregon), Canada (Central), Europe (Frankfurt, Ireland, London, Paris, Stockholm), South America (São Paulo), Asia Pacific (Singapore, Sydney, Tokyo, Seoul, Mumbai, Hong Kong), Middle East (Bahrain), and AWS GovCloud (US) Regions.\u003c/p\u003e\r\n\u003cp\u003eTo learn more about this feature, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/userguide/review-templates.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected documentation\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2023-10-03T20:51:18Z","headlineUrl":"/about-aws/whats-new/2023/10/reduce-duplication-well-architected-templates/","postDateTime":"2023-10-03T12:00:00Z","contentType":"Launch Announcement","headline":"Reduce duplication using Well-Architected Templates","postSummary":"\u003cp\u003eIntroducing AWS Well-Architected Review Templates, designed to eliminate duplication and foster consistency across your workloads. With the Well-Architected Tool\u0027s latest feature, you can effortlessly craft review templates to answer questions, update notes, and even incorporate Custom Lenses across your workloads.\u003c/p\u003e\r\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#year#2023","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2023","description":"year#2023","dateCreated":"2023-11-07T18:00:12+0000","dateUpdated":"2023-11-07T18:00:12+0000"},{"id":"whats-new-v2#marketing-marchitecture#aws-marketplace-and-partners","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"aws-marketplace-and-partners","description":"marketing:marchitecture/aws-marketplace-and-partners","dateCreated":"2023-11-09T13:52:50+0000","dateUpdated":"2023-11-09T13:52:50+0000"},{"id":"whats-new-v2#marketing-marchitecture#artificial-intelligence","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"artificial-intelligence","description":"marketing:marchitecture/artificial-intelligence","dateCreated":"2023-11-07T19:26:14+0000","dateUpdated":"2023-11-07T19:26:14+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2023-10-updates-aws-well-architected-framework","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2023/10/updates-aws-well-architected-framework/","dateCreated":"2023-11-09T14:54:30+0000","dateUpdated":"2024-07-25T14:59:05+0000","additionalFields":{"postBody":"\u003cp\u003eAWS is pleased to announce an update to the \u003ca href\u003d\"https://aws.amazon.com/architecture/well-architected/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Framework\u003c/a\u003e, which will provide customers and partners with more prescriptive guidance on building and operating in the cloud, and enable them to stay up-to-date on the latest architectural best practices in a constantly evolving technological landscape.\u003c/p\u003e\r\n\u003cp\u003eThe enhanced implementation guidance for the new and updated best practices in this release are more prescriptive, including enhanced recommendations and steps on reusable architecture patterns targeting specific business outcomes in the AWS Cloud.\u003c/p\u003e\r\n\u003cp\u003eThe new version of the AWS Well-Architected Framework is described in the AWS Well-Architected whitepapers and is available in the \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Tool\u003c/a\u003e in the following AWS Regions: US East (N. Virginia, Ohio), US West (N. California, Oregon), Canada (Central), Europe (Frankfurt, Ireland, London, Paris, Stockholm), South America (São Paulo), Asia Pacific (Singapore, Sydney, Tokyo, Seoul, Mumbai, Hong Kong), Middle East (Bahrain), and AWS GovCloud (US) Regions.\u003c/p\u003e\r\n\u003cp\u003eTo review the latest updates to the AWS Well-Architected Framework, log into the AWS Well-Architected Tool through the \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Management Console\u003c/a\u003e or access via the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/framework/welcome.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Framework whitepapers\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2023-10-03T20:52:44Z","headlineUrl":"/about-aws/whats-new/2023/10/updates-aws-well-architected-framework/","postDateTime":"2023-10-03T12:00:00Z","contentType":"Launch Announcement","headline":"New updates to the AWS Well-Architected Framework","postSummary":"\u003cp\u003eAWS is pleased to announce an update to the \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/architecture/well-architected.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Framework\u003c/a\u003e, which will provide customers and partners with more prescriptive guidance on building and operating in the cloud, and enable them to stay up-to-date on the latest architectural best practices in a constantly evolving technological landscape.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#year#2023","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2023","description":"year#2023","dateCreated":"2023-11-07T18:00:12+0000","dateUpdated":"2023-11-07T18:00:12+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#marketing-marchitecture#aws-marketplace-and-partners","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"aws-marketplace-and-partners","description":"marketing:marchitecture/aws-marketplace-and-partners","dateCreated":"2023-11-09T13:52:50+0000","dateUpdated":"2023-11-09T13:52:50+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2023-06-well-architected-introduces-profiles","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2023/06/well-architected-introduces-profiles/","dateCreated":"2023-11-09T15:00:49+0000","dateUpdated":"2024-07-25T15:02:43+0000","additionalFields":{"postBody":"\u003cp\u003eAWS Well-Architected introduces Profiles, which allows customers to tailor their Well-Architected reviews based on their business goals. This feature creates a mechanism for continuous improvement by encouraging customers to review their workloads with certain goals in mind first, and then complete the remaining Well-Architected review questions.\u003c/p\u003e\r\n\u003cp\u003eCustomers can create a profile by answering a set of pre-defined questions related to their current business goals. Once the profile is applied to a workload, customers are then presented with a set of prioritized Well-Architected questions that are aligned to their desired outcomes. Customers can also share their Profiles with other accounts and with AWS Organizations to help them scale their business priorities across their organizations.\u003c/p\u003e\r\n\u003cp\u003eThe Profiles feature in the AWS Well-Architected Tool is now available in the following AWS Regions: US East (N. Virginia, Ohio), US West (N. California, Oregon), Canada (Central), Europe (Frankfurt, Ireland, London, Paris, Stockholm), South America (São Paulo), Asia Pacific (Singapore, Sydney, Tokyo, Seoul, Mumbai, Hong Kong), Middle East (Bahrain). \u003c/p\u003e\r\n\u003cp\u003eTo learn more about this feature, \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/userguide/intro.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003evisit the AWS Well-Architected documentation\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2023-06-13T17:15:40Z","headlineUrl":"/about-aws/whats-new/2023/06/well-architected-introduces-profiles/","postDateTime":"2023-06-13T12:00:00Z","contentType":"Launch Announcement","headline":"Well-Architected introduces Profiles","postSummary":"\u003cp\u003eAWS Well-Architected introduces Profiles, which allows customers to tailor their Well-Architected reviews based on their business goals. This feature creates a mechanism for continuous improvement by encouraging customers to review their workloads with certain goals in mind first, and then complete the remaining Well-Architected review questions.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#year#2023","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2023","description":"year#2023","dateCreated":"2023-11-07T18:00:12+0000","dateUpdated":"2023-11-07T18:00:12+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2023-05-aws-well-architected-tool-integration-service-catalog-appregistry","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2023/05/aws-well-architected-tool-integration-service-catalog-appregistry/","dateCreated":"2023-11-09T15:03:28+0000","dateUpdated":"2024-07-25T14:31:46+0000","additionalFields":{"postBody":"\u003cp\u003eAWS is pleased to announce an enhancement to the AWS Well-Architected (WA) Tool integration with AWS Service Catalog AppRegistry (AR). This integration allows customers to now filter their AWS Trusted Advisor checks based on resources defined within application, helping surface the most relevant checks in the Well-Architected console.\u003c/p\u003e\r\n\u003cp\u003eIn addition to adding an application to an existing workload in WA, customers can also view their workload ARN, workload name, and medium and high risk counts per application within the AppRegistry Console, making it easier to see which applications have Well-Architected reviews associated with them.\u003c/p\u003e\r\n\u003cp\u003eThis launch is available for customers in the following AWS Regions: US East (N. Virginia, Ohio), US West (N. California, Oregon), Canada (Central), Europe (Frankfurt, Ireland, London, Paris, Stockholm), South America (Sao Paulo), Asia Pacific (Singapore, Sydney, Tokyo, Seoul, Mumbai, Hong Kong), Middle East (Bahrain), and AWS GovCloud (US) Regions. The ability to reference Well-Architected metadata in AppRegistry is not available in AWS GovCloud (US) Regions.\u003c/p\u003e\r\n\u003cp\u003e\u0026nbsp;Review the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/userguide/intro.html\" target\u003d\"_blank\"\u003eAWS Well-Architected documentation\u003c/a\u003e to get started.\u0026nbsp;\u003cbr\u003e\r\n\u003c/p\u003e\r\n","modifiedDate":"2023-05-03T18:59:07Z","headlineUrl":"/about-aws/whats-new/2023/05/aws-well-architected-tool-integration-service-catalog-appregistry/","postDateTime":"2023-05-03T07:00:00Z","contentType":"Launch Announcement","headline":"AWS Well-Architected Tool Deepens Integration with AWS Service Catalog AppRegistry","postSummary":"\u003cp\u003eAWS is pleased to announce an enhancement to the AWS Well-Architected (WA) Tool integration with AWS Service Catalog AppRegistry (AR). This integration allows customers to now filter their AWS Trusted Advisor checks based on resources defined within application, helping surface the most relevant checks in the Well-Architected console.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#year#2023","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2023","description":"year#2023","dateCreated":"2023-11-07T18:00:12+0000","dateUpdated":"2023-11-07T18:00:12+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2023-04-aws-well-architected-framework-prescriptive-guidance","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2023/04/aws-well-architected-framework-prescriptive-guidance/","dateCreated":"2023-11-09T14:45:16+0000","dateUpdated":"2024-07-25T14:52:43+0000","additionalFields":{"postBody":"\u003cp\u003eAWS is pleased to announce an update to the \u003ca href\u003d\"https://aws.amazon.com/architecture/well-architected/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Framework\u003c/a\u003e, which will provide customers and partners with more prescriptive guidance on building and operating in the cloud, and enable them to stay up-to-date on the latest architectural best practices in a constantly evolving technological landscape.\u003c/p\u003e\r\n\u003cp\u003eThe enhanced prescriptive guidance included in this update provides customers and partners with new and refreshed best practices, implementation steps, architectural patterns, and more outcome-driven improvement plans, helping them more easily identify and mitigate risks.\u003c/p\u003e\r\n\u003cp\u003eThe new version of the AWS Well-Architected Framework is now available within the AWS Well-Architected whitepapers and in the \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Tool\u003c/a\u003e in the following AWS Regions: US East (N. Virginia, Ohio), US West (N. California, Oregon), Canada (Central), Europe (Frankfurt, Ireland, London, Paris, Stockholm), South America (Sao Paulo), Asia Pacific (Singapore, Sydney, Tokyo, Seoul, Mumbai, Hong Kong), Middle East (Bahrain), and AWS GovCloud (US) Regions.\u003c/p\u003e\r\n\u003cp\u003eTo review the latest updates to the AWS Well-Architected Framework, log into the AWS Well-Architected Tool via the \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Management Console\u003c/a\u003e or access via the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/framework/welcome.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Framework whitepapers\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\r\n","modifiedDate":"2023-04-10T21:52:41Z","headlineUrl":"/about-aws/whats-new/2023/04/aws-well-architected-framework-prescriptive-guidance/","postDateTime":"2023-04-10T07:00:00Z","contentType":"Launch Announcement","headline":"AWS Well-Architected Framework strengthens prescriptive guidance","postSummary":"\u003cp\u003eAWS is pleased to announce an update to the \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/architecture/well-architected.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Framework\u003c/a\u003e, which will provide customers and partners with more prescriptive guidance on building and operating in the cloud, and enable them to stay up-to-date on the latest architectural best practices in a constantly evolving technological landscape.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#year#2023","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2023","description":"year#2023","dateCreated":"2023-11-07T18:00:12+0000","dateUpdated":"2023-11-07T18:00:12+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2023-03-aws-well-architected-tool-consolidated-report-enhanced-search","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2023/03/aws-well-architected-tool-consolidated-report-enhanced-search/","dateCreated":"2023-11-09T14:44:13+0000","dateUpdated":"2024-07-25T14:45:18+0000","additionalFields":{"postBody":"\u003cp\u003eAWS is pleased to announce two new features in the \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Tool\u003c/a\u003e (AWS WA Tool)—Consolidated Report and Enhanced Search—that will enable customers to quickly identify risk themes across their workloads and scale improvements across their organization.\u003c/p\u003e\r\n\u003cp\u003eConsolidated Report enables customers to see an overview of risks across all their workloads, helping them more easily identify risk trends. This macro-level view helps executive stakeholders understand where common issues lie, and prioritize team resources to drive widespread improvement. Enhanced Search makes it easier to find relevant workloads quickly using additional search criteria, such as workload name, workload ID, and workload ARN within the AWS Management Console.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eConsolidated Report and Enhanced Search functionally are available within the AWS WA Tool for customers in the following AWS Regions: US East (N. Virginia, Ohio), US West (N. California, Oregon), Canada (Central), Europe (Frankfurt, Ireland, London, Paris, Stockholm), South America (Sao Paulo), Asia Pacific (Singapore, Sydney, Tokyo, Seoul, Mumbai, Hong Kong), Middle East (Bahrain), and AWS GovCloud (US) Regions.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eTo learn more about Consolidated Report and Enhanced Search, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/userguide/dashboard.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS WA Tool Documentation\u003c/a\u003e.\u003cbr\u003e\r\n\u003c/p\u003e\r\n","modifiedDate":"2023-03-30T19:13:50Z","headlineUrl":"/about-aws/whats-new/2023/03/aws-well-architected-tool-consolidated-report-enhanced-search/","postDateTime":"2023-03-30T07:00:00Z","contentType":"Launch Announcement","headline":"AWS Well-Architected Tool Announces Consolidated Report and Enhanced Search functionality","postSummary":"\u003cp\u003eAWS is pleased to announce two new features in the \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/well-architected-tool.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Tool\u003c/a\u003e (AWS WA Tool)—Consolidated Report and Enhanced Search—that will enable customers to quickly identify risk themes across their workloads and scale improvements across their organization.\u003c/p\u003e\r\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2023","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2023","description":"year#2023","dateCreated":"2023-11-07T18:00:12+0000","dateUpdated":"2023-11-07T18:00:12+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-11-aws-well-architected-tool-workload-discovery-speeds-reviews","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/11/aws-well-architected-tool-workload-discovery-speeds-reviews/","dateCreated":"2023-11-09T14:53:30+0000","dateUpdated":"2024-07-25T14:24:10+0000","additionalFields":{"postBody":"\u003cp\u003eAWS is pleased to announce the availability of two new features in the \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Tool\u003c/a\u003e\u0026nbsp;(AWS WA Tool)—integrations with \u003ca href\u003d\"https://aws.amazon.com/premiumsupport/technology/trusted-advisor/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Trusted Advisor\u003c/a\u003e\u0026nbsp;and \u003ca href\u003d\"https://docs.aws.amazon.com/servicecatalog/latest/arguide/intro-app-registry.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Service Catalog AppRegistry\u003c/a\u003e—that will help you more easily discover the information needed to answer Well-Architected review questions and shorten your review time. \u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003ePreviously, customers conducting AWS Well-Architected Framework reviews had to spend time verifying their answers by double checking their workloads to see if they were following best practices; there wasn’t a clear link between the workload being reviewed and it’s associated resources. With the AWS Trusted Advisor integration, the AWS WA Tool now presents findings based on automated Trusted Advisor resource checks, providing you with further contextual information during your reviews. This change improves the accuracy of your answers and the speed of your review. \u003c/p\u003e\r\n\u003cp\u003eThe AWS WA Tool is also now integrated with AWS Service Catalog AppRegistry. AWS Service Catalog AppRegistry lets you store your AWS applications, their associated resource collections, and application attribute groups. The integration with AWS Service Catalog AppRegistry provides you with better visibility into which applications are associated with which workloads during the Well-Architected review process, saving you time by tracking and organizing your workload\u0027s associated resources.\u003c/p\u003e\r\n\u003cp\u003eAWS Service Catalog AppRegistry in the AWS WA Tool is generally available for all customers. Access to AWS Trusted Advisor checks within the AWS WA Tool is based on the customer\u0027s AWS Support Plan. The AWS WA Tool is available in the following AWS Regions: US East (N. Virginia, Ohio), US West (N. California, Oregon), Canada (Central), Europe (Frankfurt, Ireland, London, Paris, Stockholm), South America (Sao Paulo), Asia Pacific (Singapore, Sydney, Tokyo, Seoul, Mumbai, Hong Kong), Middle East (Bahrain), and AWS GovCloud (US) Regions. \u003c/p\u003e\r\n\u003cp\u003eTo get started with the new AWS Trusted Advisor integration, visit the \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS WA Tool in the AWS Management Console\u003c/a\u003e\u0026nbsp;and turn on AWS Trusted Advisor support or \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/userguide/intro.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eview documentation\u003c/a\u003e. To get started with the new AWS Service Catalog AppRegistry integration, visit the \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS WA Tool in the AWS Management Console\u003c/a\u003e\u0026nbsp;and add resources to a new or existing workload.\u003c/p\u003e\r\n","modifiedDate":"2022-11-07T20:46:56Z","headlineUrl":"/about-aws/whats-new/2022/11/aws-well-architected-tool-workload-discovery-speeds-reviews/","postDateTime":"2022-11-07T08:00:00Z","contentType":"Launch Announcement","headline":"AWS Well-Architected Tool improves workload discovery and speeds up reviews","postSummary":"\u003cp\u003eAWS is pleased to announce the availability of two new features in the \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/well-architected-tool.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Tool\u003c/a\u003e\u0026nbsp;(AWS WA Tool)—integrations with \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/premiumsupport/technology/trusted-advisor.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Trusted Advisor\u003c/a\u003e\u0026nbsp;and \u003ca href\u003d\"https://docs.aws.amazon.com/servicecatalog/latest/arguide/intro-app-registry.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Service Catalog AppRegistry\u003c/a\u003e—that will help you more easily discover the information needed to answer Well-Architected review questions and shorten your review time. \u003cbr\u003e\r\n\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-govcloud-us","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-govcloud-us","description":"general:products/aws-govcloud-us","dateCreated":"2023-11-07T18:41:18+0000","dateUpdated":"2023-11-07T18:41:18+0000"},{"id":"whats-new-v2#general-products#aws-service-catalog","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-service-catalog","description":"general:products/aws-service-catalog","dateCreated":"2023-11-09T13:51:16+0000","dateUpdated":"2023-11-09T13:51:16+0000"},{"id":"whats-new-v2#general-products#aws-trusted-advisor","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-trusted-advisor","description":"general:products/aws-trusted-advisor","dateCreated":"2023-11-09T13:58:48+0000","dateUpdated":"2023-11-09T13:58:48+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-08-aws-well-architected-tool-available-aws-govcloud-us-regions","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/08/aws-well-architected-tool-available-aws-govcloud-us-regions/","dateCreated":"2023-11-09T14:50:27+0000","dateUpdated":"2024-07-25T14:59:26+0000","additionalFields":{"postBody":"\u003cp\u003eAWS is excited to announce that the AWS Well-Architected Tool is now available in AWS GovCloud (US) Regions. AWS GovCloud (US) is an isolated region designed to host sensitive data and regulated workloads in the cloud. The AWS Well-Architected Tool is used to help customers review the state of their applications and workloads against architectural best practices, and improve decision-making, minimize risks, and reduce costs. With this Region expansion, customers with specific regulatory and compliance requirements and AWS Partners in both the public and commercial sectors can now conduct self-service Well-Architected Reviews.\u003c/p\u003e\r\n\u003cp\u003eThis new capability is available to customers and AWS partners at no additional charge in the AWS Management Console. With this regional expansion, the AWS Well-Architected Tool is now available in the following AWS Regions: US East (Ohio, N. Virginia), US West (N. California, Oregon), Canada (Central), Europe (Frankfurt, Ireland, London, Paris, Stockholm), South America (São Paulo), Asia Pacific (Singapore, Sydney, Tokyo, Seoul, Mumbai, Hong Kong), and Middle East (Bahrain), and AWS GovCloud (US) Regions. To learn more about AWS Well-Architected Tool, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/govcloud-us/latest/UserGuide/govcloud-wellarchitected.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003edocumentation\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eproduct page\u003c/a\u003e. To engage with an AWS Well-Architected Partner, visit the \u003ca href\u003d\"https://partners.amazonaws.com/search/partners?facets\u003d%27Program+:+Well+Architected%27\u0026amp;size\u003d10\u0026amp;start\u003d0\u0026amp;sort\u003dRelevance\u0026amp;view\u003dGrid\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Partner Solution Finder\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2022-08-17T21:59:09Z","headlineUrl":"/about-aws/whats-new/2022/08/aws-well-architected-tool-available-aws-govcloud-us-regions/","postDateTime":"2022-08-17T12:00:00Z","contentType":"Launch Announcement","headline":"AWS Well-Architected Tool now available in AWS GovCloud (US) Regions","postSummary":"\u003cp\u003eAWS is excited to announce that the AWS Well-Architected Tool is now available in AWS GovCloud (US) Regions. AWS GovCloud (US) is an isolated region designed to host sensitive data and regulated workloads in the cloud. The AWS Well-Architected Tool is used to help customers review the state of their applications and workloads against architectural best practices, and improve decision-making, minimize risks, and reduce costs. With this Region expansion, customers with specific regulatory and compliance requirements and AWS Partners in both the public and commercial sectors can now conduct self-service Well-Architected Reviews.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"},{"id":"whats-new-v2#general-products#aws-govcloud-us","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-govcloud-us","description":"general:products/aws-govcloud-us","dateCreated":"2023-11-07T18:41:18+0000","dateUpdated":"2023-11-07T18:41:18+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-06-aws-well-architected-tool-organizations-integration","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/06/aws-well-architected-tool-organizations-integration/","dateCreated":"2023-11-09T14:37:33+0000","dateUpdated":"2024-07-25T14:58:13+0000","additionalFields":{"postBody":"\u003cp\u003eAWS Well-Architected Tool now integrates with AWS Organizations enabling cloud architects to share their workloads and custom lenses more broadly across their organization. AWS Organizations is an account management service that allows customers to consolidate multiple AWS accounts into a single, centrally managed organization. This update will increase efficiency and make it easier to share lenses and workloads with multiple accounts. \u003c/p\u003e\r\n\u003cp\u003eWell-Architected customers will be able to give access to specific teams or departments by sharing their workloads and custom lenses across different subsets within an organization. This will promote collaboration between teams and will save customers time, allowing them to scale faster across a wider audience. Additionally, customers will be able to better control access to workloads and custom lenses. \u003c/p\u003e\r\n\u003cp\u003eThis new capability is available to customers and AWS Partners at no additional charge in the AWS Management Console and is offered in all \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eRegions\u003c/a\u003e\u0026nbsp;where \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Tool\u003c/a\u003e\u0026nbsp;is available. The AWS Well-Architected Tool is designed to help you review the state of your applications and workloads, and provides a central place for architectural best practices and tools to improve decision-making, minimize risks, and reduce costs. To learn more about AWS Well-Architected Tool, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003edocumentation\u003c/a\u003e\u0026nbsp;and \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eProduct Page\u003c/a\u003e. To engage with an AWS Well-Architected Partner, visit the \u003ca href\u003d\"https://partners.amazonaws.com/search/partners?facets\u003d%27Program+:+Well+Architected%27\u0026amp;size\u003d10\u0026amp;start\u003d0\u0026amp;sort\u003dRelevance\u0026amp;view\u003dGrid\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Partner Solution Finder\u003c/a\u003e. \u003c/p\u003e\r\n","modifiedDate":"2022-06-30T20:48:19Z","headlineUrl":"/about-aws/whats-new/2022/06/aws-well-architected-tool-organizations-integration/","postDateTime":"2022-06-30T07:00:00Z","contentType":"Launch Announcement","headline":"Integration of AWS Well-Architected Tool with AWS Organizations","postSummary":"\u003cp\u003eAWS Well-Architected Tool now integrates with AWS Organizations enabling cloud architects to share their workloads and custom lenses more broadly across their organization. AWS Organizations is an account management service that allows customers to consolidate multiple AWS accounts into a single, centrally managed organization. This update will increase efficiency and make it easier to share lenses and workloads with multiple accounts. \u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-06-aws-well-architected-tool-adds-enhancements-custom-lenses","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/06/aws-well-architected-tool-adds-enhancements-custom-lenses/","dateCreated":"2023-11-09T14:40:04+0000","dateUpdated":"2024-07-25T14:33:07+0000","additionalFields":{"postBody":"\u003cp\u003eAWS Well-Architected Tool now allows customers to preview custom lens content before publishing, add additional URLs to helpful resources and improvement plans, and use tags to assign metadata to their custom lenses.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eAWS Well-Architected Tool is designed to help you review the state of your applications and workloads, and it provides a central place for architectural best practices and guidance. Customers who use the AWS Well-Architected Tool often have internal best practices they follow, and custom lenses provide the ability to create content based on their internal best practices. With a custom lens, customers can create their own pillars, questions, best practices, helpful resources, and improvement plans. Customers can then share them across their entire organization to measure workloads consistently, specify rules to determine which options result in high or medium risk, and provide guidance on how to resolve those risks.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eTo help lens authors validate their lenses, they can now preview their custom lens content before publishing. To allow authors to provide more resource information for best practices, they can now add additional URLs to helpful resources and improvement plans within a custom lens. Additionally, customers can now use AWS tags to assign metadata to a custom lens. With custom lenses, AWS Well-Architected Tool becomes a single place for customers to review and measure best practices while performing associated operational reviews for all technology across their organization.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eThese updates are available to customers and AWS Partners at no additional charge in the AWS Management Console and are offered in all Regions where the \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Tool\u003c/a\u003e\u0026nbsp;is available. To learn more about AWS Well-Architected Tool and custom lenses, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eDocumentation\u003c/a\u003e\u0026nbsp;and \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eProduct Page\u003c/a\u003e. To engage with an AWS Well-Architected Partner, visit the \u003ca href\u003d\"https://partners.amazonaws.com/search/partners?facets\u003d%27Program+:+Well+Architected%27\u0026amp;size\u003d10\u0026amp;start\u003d0\u0026amp;sort\u003dRelevance\u0026amp;view\u003dGrid\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Partner Solution Finder\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2022-06-21T18:42:00Z","headlineUrl":"/about-aws/whats-new/2022/06/aws-well-architected-tool-adds-enhancements-custom-lenses/","postDateTime":"2022-06-21T07:00:00Z","contentType":"Launch Announcement","headline":"AWS Well-Architected Tool adds multiple enhancements to custom lenses","postSummary":"\u003cp\u003eAWS Well-Architected Tool now allows customers to preview custom lens content before publishing, add additional URLs to helpful resources and improvement plans, and use tags to assign metadata to their custom lenses.\u003cbr\u003e\r\n\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-05-aws-community-well-architected-tool","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/05/aws-community-well-architected-tool/","dateCreated":"2023-11-09T14:37:03+0000","dateUpdated":"2024-07-25T14:39:45+0000","additionalFields":{"postBody":"\u003cp\u003eAWS Well-Architected Tool now features direct access to AWS re:Post, a community-driven, questions-and-answers service designed to help AWS customers remove technical roadblocks, accelerate innovation, and enhance operation. AWS re:Post has 40+ topics including a community specific to AWS Well-Architected.\u003c/p\u003e\r\n\u003cp\u003eTo get started, from AWS Well-Architected Tool select “Ask an Expert” and access the AWS re:Post community dedicated to AWS Well-Architected. In this community, customers can ask questions related to designing, building, deploying, and operating workloads on AWS. During workload reviews with the AWS Well-Architected Tool, customers can reference AWS re:Post for questions related to specific topics, or ask questions to start a discussion and get answers. The re:Post community includes AWS customers, partners, and employees. The topics and posts within this community are monitored by AWS Well-Architected subject matter experts.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eThis new functionality is available to customers and AWS Partners at no additional charge in the AWS Management Console and is offered in all \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eRegions\u003c/a\u003e where \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Tool\u003c/a\u003e is available.\u0026nbsp; The AWS Well-Architected Tool is designed to help you review the state of your applications and workloads, and provides a central place for architectural best practices and tools to improve decision-making, minimize risks, and reduce costs. To learn more about AWS Well-Architected Tool, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eDocumentation\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eProduct Page\u003c/a\u003e. To engage with an AWS Well-Architected Partner visit the \u003ca href\u003d\"https://partners.amazonaws.com/search/partners?facets\u003d%27Program+:+Well+Architected%27\u0026amp;size\u003d10\u0026amp;start\u003d0\u0026amp;sort\u003dRelevance\u0026amp;view\u003dGrid\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Partner Solution Finder\u003c/a\u003e.\u003cbr\u003e\r\n\u003c/p\u003e\r\n","modifiedDate":"2022-05-31T21:14:11Z","headlineUrl":"/about-aws/whats-new/2022/05/aws-community-well-architected-tool/","postDateTime":"2022-05-31T07:00:00Z","contentType":"Launch Announcement","headline":"Access the AWS re:Post community from the AWS Well-Architected Tool","postSummary":"\u003cp\u003eAWS Well-Architected Tool now features direct access to AWS re:Post, a community-driven, questions-and-answers service designed to help AWS customers remove technical roadblocks, accelerate innovation, and enhance operation. AWS re:Post has 40+ topics including a community specific to AWS Well-Architected.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-03-aws-sustainability-pillar-available-in-well-architected-tool","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/03/aws-sustainability-pillar-available-in-well-architected-tool/","dateCreated":"2023-11-09T14:50:54+0000","dateUpdated":"2024-07-25T14:40:59+0000","additionalFields":{"postBody":"\u003cp\u003eAWS introduced the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/sustainability-pillar/sustainability-pillar.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eSustainability Pillar\u003c/a\u003e during re:Invent 2021 to help customers minimize the environmental impacts of running cloud workloads. Today, the Sustainability Pillar is available for customers to use during workload reviews in the \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Tool\u003c/a\u003e, a central place for cloud architecture best practices and guidance. The Sustainability Pillar is designed to help CTOs, architects, developers, and operations team members contribute to an increasing number of sustainability targets set by their organizations.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eThe practice of sustainability involves understanding the impacts of the services used, quantifying impacts through the entire workload lifecycle, and applying design principles and best practices to reduce these impacts. Review your cloud architecture using the Sustainability Pillar in the AWS Well-Architected Tool to learn and measure energy consumption and the environmental impacts of your cloud workloads. After you have completed a review, the tool provides an improvement plan with direct actions to reduce resource usage and increase efficiency. Review your workloads periodically using the Sustainability Pillar to make informed decisions in balancing security, cost, performance, reliability, and operational excellence with sustainability outcomes for your cloud workloads. \u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eThe Sustainability Pillar is available to customers and AWS Partners at no additional charge in the AWS Management Console and is offered in all \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eRegions\u003c/a\u003e where the \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Tool\u003c/a\u003e is available. To learn more about the AWS Well-Architected Tool, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eDocumentation\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eProduct Page.\u003c/a\u003e To engage with an AWS Well-Architected Partner visit the \u003ca href\u003d\"https://partners.amazonaws.com/search/partners?facets\u003d%27Program+:+Well+Architected%27\u0026amp;size\u003d10\u0026amp;start\u003d0\u0026amp;sort\u003dRelevance\u0026amp;view\u003dGrid\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Partner Solution Finder\u003c/a\u003e.\u003cbr\u003e\r\n\u003c/p\u003e\r\n","modifiedDate":"2022-03-31T22:26:01Z","headlineUrl":"/about-aws/whats-new/2022/03/aws-sustainability-pillar-available-in-well-architected-tool/","postDateTime":"2022-03-31T20:54:00Z","contentType":"Launch Announcement","headline":"Sustainability Pillar is now available in AWS Well-Architected Tool","postSummary":"\u003cp\u003eAWS introduced the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/sustainability-pillar/sustainability-pillar.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eSustainability Pillar\u003c/a\u003e during re:Invent 2021 to help customers minimize the environmental impacts of running cloud workloads. Today, the Sustainability Pillar is available for customers to use during workload reviews in the \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/well-architected-tool.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Tool\u003c/a\u003e, a central place for cloud architecture best practices and guidance. The Sustainability Pillar is designed to help CTOs, architects, developers, and operations team members contribute to an increasing number of sustainability targets set by their organizations.\u003cbr\u003e\r\n\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2021-12-aws-well-architected-tool-trusted-advisor-checks","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2021/12/aws-well-architected-tool-trusted-advisor-checks/","dateCreated":"2023-11-09T14:44:56+0000","dateUpdated":"2024-07-25T14:21:19+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/architecture/well-architected/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected\u003c/a\u003e now supports four new \u003ca href\u003d\"https://aws.amazon.com/premiumsupport/technology/trusted-advisor/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Trusted Advisor\u003c/a\u003e \u003ca href\u003d\"https://docs.aws.amazon.com/awssupport/latest/user/trusted-advisor-check-reference.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003echecks\u003c/a\u003e as a unified home of best practice recommendations to identify the most impactful risks and take action to mitigate them. The new checks are:\u003c/p\u003e\r\n\u003cp\u003e1. AWS Well-Architected high risk issues for cost optimization\u003cbr\u003e\r\n2. AWS Well-Architected high risk issues for performance efficiency\u003cbr\u003e\r\n3. AWS Well-Architected high risk issues for security\u003cbr\u003e\r\n4. AWS Well-Architected high risk issues for reliability\u003c/p\u003e\r\n\u003cp\u003eCustomers use Well-Architected to review their workloads against AWS best practices. As an output of the review, Well-Architected provides customers with a list of high and medium risk issues based on best practices defined by the Well-Architected framework for each pillar. The Trusted Advisor checks sourced from Well-Architected will contain an aggregated count of the number of HRIs (High Risk Issues) discovered per pillar per workload based on the self-assessment that customers performed during the Well-Architected review. AWS customers will access the Trusted Advisor checks sourced from Well-Architected to identify and prioritize workloads with high HRI count, select the workloads that are critical to them, and dig deeper into specific HRIs. The checks will include timestamps for review start date, recent review date, and the workload type to distinguish production and non-production workloads.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eThe new checks are available to view in the \u003ca href\u003d\"http://console.aws.amazon.com/trustedadvisor/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Trusted Advisor Console\u003c/a\u003e and accessible via the \u003ca href\u003d\"https://docs.aws.amazon.com/awssupport/latest/APIReference/Welcome.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Support API\u003c/a\u003e. Customers can set up alerts based on the results of Trusted Advisor checks. To learn more about setting up alarms using Amazon CloudWatch, see \u003ca href\u003d\"https://docs.aws.amazon.com/awssupport/latest/user/cloudwatch-metrics-ta.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eCreating Trusted Advisor alarms using CloudWatch\u003c/a\u003e. For a full set of Trusted Advisor Best Practice Checks, see \u003ca href\u003d\"https://docs.aws.amazon.com/awssupport/latest/user/trusted-advisor-check-reference.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Trusted Advisor best practice checklist\u003c/a\u003e. Go \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/framework/welcome.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003ehere\u003c/a\u003e for AWS Well-Architected Framework.\u003c/p\u003e\r\n","modifiedDate":"2021-12-20T22:49:10Z","headlineUrl":"/about-aws/whats-new/2021/12/aws-well-architected-tool-trusted-advisor-checks/","postDateTime":"2021-12-20T08:00:00Z","contentType":"Launch Announcement","headline":"AWS Well-Architected Tool adds four new Trusted Advisor checks","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/architecture/well-architected.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected\u003c/a\u003e now supports four new \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/premiumsupport/technology/trusted-advisor.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Trusted Advisor\u003c/a\u003e \u003ca href\u003d\"https://docs.aws.amazon.com/awssupport/latest/user/trusted-advisor-check-reference.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003echecks\u003c/a\u003e as a unified home of best practice recommendations to identify the most impactful risks and take action to mitigate them. The new checks are:\u003c/p\u003e\r\n\u003cp\u003e1. AWS Well-Architected high risk issues for cost optimization\u003cbr\u003e\r\n2. AWS Well-Architected high risk issues for performance efficiency\u003cbr\u003e\r\n3. AWS Well-Architected high risk issues for security\u003cbr\u003e\r\n4. AWS Well-Architected high risk issues for reliability\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-trusted-advisor","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-trusted-advisor","description":"general:products/aws-trusted-advisor","dateCreated":"2023-11-09T13:58:48+0000","dateUpdated":"2023-11-09T13:58:48+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#year#2021","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2021","description":"year#2021","dateCreated":"2023-11-09T14:24:35+0000","dateUpdated":"2023-11-09T14:24:35+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2021-12-new-sustainability-pillar-aws-well-architected-framework","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2021/12/new-sustainability-pillar-aws-well-architected-framework/","dateCreated":"2023-11-09T14:49:01+0000","dateUpdated":"2024-07-25T14:30:59+0000","additionalFields":{"postBody":"\u003cp\u003eThe AWS Well-Architected Framework has been helping AWS customers improve their cloud workloads since 2015. The framework consists of design principles, questions, and best practices across multiple pillars: Operational Excellence, Security, Reliability, Performance Efficiency, and Cost Optimization. Today we are introducing a new AWS Well-Architected Sustainability Pillar to help organizations learn, measure, and improve workloads using environmental best practices for cloud computing.\u003c/p\u003e\r\n\u003cp\u003eWith an increasing number of organizations setting sustainability targets, CTOs, architects, developers, and operations team members are seeking ways that they can directly contribute to their organization\u0027s sustainability goals. Using the new AWS Well-Architected Sustainability Pillar, you can make informed decisions in balancing security, cost, performance, reliability, and operational excellence with sustainability outcomes for your cloud workloads. Every action taken to reduce resource usage and increase efficiency across all components of a workload contributes to a reduced environmental impact for that workload as well as contributing to your organization\u0027s wider sustainability goals.\u003c/p\u003e\r\n\u003cp\u003eTo learn more, see the new \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/sustainability-pillar/sustainability-pillar.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eSustainability Pillar\u003c/a\u003e for the \u003ca href\u003d\"https://aws.amazon.com/architecture/well-architected/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Well-Architected Framework\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2021-12-02T18:36:44Z","headlineUrl":"/about-aws/whats-new/2021/12/new-sustainability-pillar-aws-well-architected-framework/","postDateTime":"2021-12-02T08:00:00Z","contentType":"Launch Announcement","headline":"New Sustainability Pillar for the AWS Well-Architected Framework","postSummary":"\u003cp\u003eThe AWS Well-Architected Framework has been helping AWS customers improve their cloud workloads since 2015. The framework consists of design principles, questions, and best practices across multiple pillars: Operational Excellence, Security, Reliability, Performance Efficiency, and Cost Optimization. Today we are introducing a new AWS Well-Architected Sustainability Pillar to help organizations learn, measure, and improve workloads using environmental best practices for cloud computing.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#year#2021","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2021","description":"year#2021","dateCreated":"2023-11-09T14:24:35+0000","dateUpdated":"2023-11-09T14:24:35+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2021-11-aws-well-architected-tool-custom-lenses","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2021/11/aws-well-architected-tool-custom-lenses/","dateCreated":"2023-11-09T14:37:43+0000","dateUpdated":"2024-07-25T14:20:12+0000","additionalFields":{"postBody":"\u003cp\u003eThe AWS Well-Architected Tool now offers the ability for customers to create their own custom lenses. \u003c/p\u003e\r\n\u003cp\u003eMany customers who use the AWS Well-Architected Tool have internal best practices they follow in addition to the AWS best practices provided by the AWS Well-Architected Framework. Historically, customers have had to track these best practices in separate documents and tools, making it difficult to gather insights into their overall architectural health. With the addition of custom lenses, the AWS Well-Architected Tool will become a single place for customers to review and measure best practices while performing associated operational reviews for all technology across their organization. \u003c/p\u003e\r\n\u003cp\u003eWithin a custom lens, customers can create their own pillars, questions, best practices, helpful resources, and improvement plans.  They also can specify rules to determine which options, when not followed, result in high or medium risk issues being flagged. Customers then provide their own guidance for resolving the risk. Custom lenses can be shared across multiple AWS accounts for more visibility. \u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eTo create your custom lens, sign in to the AWS Well-Architected Tool in the \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Management Console\u003c/a\u003e and choose \u003cb\u003eCustom lenses\u003c/b\u003e to get started. This feature is available to customers and AWS Partners at no additional charge and is offered in all Regions where the AWS Well-Architected Tool\u0026nbsp;is available: US East (N. Virginia, Ohio), US West (N. California), US West (Oregon), Canada (Central), Europe (Frankfurt), Europe (Ireland), Europe (London), Europe (Paris), Europe (Stockholm), South America (Sao Paulo), Asia Pacific (Singapore), Asia Pacific (Sydney), Asia Pacific (Tokyo), Asia Pacific (Seoul), Asia Pacific (Mumbai), Asia Pacific (Hong Kong), and Middle East (Bahrain).\u003c/p\u003e\r\n\u003cp\u003eTo learn more about custom lenses, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS WA Tool Documentation\u003c/a\u003e\u0026nbsp;and \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eProduct Page\u003c/a\u003e. To learn more about how to engage an AWS Well-Architected Partner Program member, visit the \u003ca href\u003d\"https://aws.amazon.com/partners/well-architected-program/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eProgram Page\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2021-11-29T19:01:32Z","headlineUrl":"/about-aws/whats-new/2021/11/aws-well-architected-tool-custom-lenses/","postDateTime":"2021-11-29T08:00:00Z","contentType":"Launch Announcement","headline":"Customize your AWS Well-Architected Review using Custom Lenses ","postSummary":"\u003cp\u003eThe AWS Well-Architected Tool now offers the ability for customers to create their own custom lenses. \u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#year#2021","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2021","description":"year#2021","dateCreated":"2023-11-09T14:24:35+0000","dateUpdated":"2023-11-09T14:24:35+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2021-07-mark-individual-best-practices-as-not-applicable-within-the-aws-well-architected-tool","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2021/07/mark-individual-best-practices-as-not-applicable-within-the-aws-well-architected-tool/","dateCreated":"2023-11-09T14:34:17+0000","dateUpdated":"2024-07-25T14:03:17+0000","additionalFields":{"postBody":"\u003cp\u003eThe AWS Well-Architected Tool (AWS WA Tool) now offers the ability for customers and AWS Partners to mark individual best practices as not applicable during their workload review.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eThere are instances where customers and AWS Partners might not need to measure a workload against a specific best practice due to factors such as business needs, or organizational maturity. Now the AWS Well-Architected Tool provides a way to mark those best practices as not applicable, and record why the best practice does not apply. Customers and AWS Partners can also mark best practices as not applicable using the Well-Architected API.\u0026nbsp;\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eThis feature is available to customers and AWS Partners at no additional charge and is offered in all Regions where the \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected/\" target\u003d\"_blank\"\u003eAWS WA Tool\u003c/a\u003e is available; US East (N. Virginia, Ohio), US West (N. California, Oregon), Canada (Central), Europe (Frankfurt, Ireland, London, Paris, Stockholm), South America (Sao Paulo), Asia Pacific (Singapore, Sydney, Tokyo, Seoul, Mumbai, Hong Kong), and Middle East (Bahrain). \u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eTo learn more about marking best practices as not applicable within the AWS Well-Architected Tool, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/\" target\u003d\"_blank\"\u003eAWS WA Tool Documentation\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\" target\u003d\"_blank\"\u003eProduct Page\u003c/a\u003e. To learn more about how to engage an AWS Well-Architected Partner Program member visit the \u003ca href\u003d\"https://aws.amazon.com/partners/programs/well-architected/\" target\u003d\"_blank\"\u003eProgram Page\u003c/a\u003e.\u003cbr\u003e\r\n\u003c/p\u003e\r\n","modifiedDate":"2021-07-14T22:15:58Z","headlineUrl":"/about-aws/whats-new/2021/07/mark-individual-best-practices-as-not-applicable-within-the-aws-well-architected-tool/","postDateTime":"2021-07-14T07:00:00Z","contentType":"Launch Announcement","headline":"Mark individual best practices as not applicable within the AWS Well-Architected Tool ","postSummary":"\u003cp\u003eThe AWS Well-Architected Tool (AWS WA Tool) now offers the ability for customers and AWS Partners to mark individual best practices as not applicable during their workload review.\u003cbr\u003e\r\n\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2021","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2021","description":"year#2021","dateCreated":"2023-11-09T14:24:35+0000","dateUpdated":"2023-11-09T14:24:35+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-12-apis-now-available-for-aws-well-architected-tool","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/12/apis-now-available-for-aws-well-architected-tool/","dateCreated":"2023-11-09T14:02:07+0000","dateUpdated":"2024-07-25T13:13:48+0000","additionalFields":{"postBody":"\u003cp\u003eThe AWS Well-Architected Tool now offers APIs that allow customers and APN partners to extend AWS Well-Architected functionality, best practices, measurements, and learnings into their existing architecture governance processes, applications, and workflows. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eWith the introduction of APIs for the AWS Well-Architected Tool (AWS WA Tool), customers can now build their own integrations to support a broad range of use cases, including the ability to integrate AWS WA Tool data into centralized reporting tools, and integrate identified risks with ticketing and program management systems. The API also enables automation of best practice detection. APN partners can incorporate AWS Well-Architected into their own tools, and engage on integration projects with enterprises. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eBy using the AWS Well-Architected Tool API, companies can effectively govern workloads across many AWS accounts, always stay up to date on the latest best practices, and scale AWS Well-Architected principles across their teams and systems.  \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThe AWS WA Tool APIs are available to customers at no additional charge and are offered in all Regions where the tool is available: US East (N. Virginia, Ohio), US West (N. California, Oregon), Canada (Central), Europe (Frankfurt, Ireland, London, Paris, Stockholm), South America (Sao Paulo), Asia Pacific (Singapore, Sydney, Tokyo, Seoul, Mumbai, Hong Kong), and Middle East (Bahrain). \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eTo learn more about the AWS Well-Architected Tool APIs, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/\" target\u003d\"_blank\"\u003eAWS WA Tool Documentation\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\" target\u003d\"_blank\"\u003eProduct Page\u003c/a\u003e. To learn more about how to engage an AWS Well-Architected Partner Program member visit the \u003ca href\u003d\"https://aws.amazon.com/partners/well-architected-program/\" target\u003d\"_blank\"\u003eProgram Page\u003c/a\u003e. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-12-16T16:14:11Z","headlineUrl":"/about-aws/whats-new/2020/12/apis-now-available-for-aws-well-architected-tool/","postDateTime":"2020-12-16T12:31:00Z","contentType":"Launch Announcement","headline":"APIs now available for the AWS Well-Architected Tool","postSummary":"\u003cp\u003eThe AWS Well-Architected Tool now offers APIs that allow customers and APN partners to extend AWS Well-Architected functionality, best practices, measurements, and learnings into their existing architecture governance processes, applications, and workflows. \u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#marketing-marchitecture#partner-network","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"partner-network","description":"marketing:marchitecture/partner-network","dateCreated":"2023-11-09T13:50:48+0000","dateUpdated":"2023-11-09T13:50:48+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#reinvent-2020-others-w3","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"reinvent-2020-others-w3","description":"marketing:marchitecture/reinvent-2020-others-w3","dateCreated":"2023-11-09T13:58:30+0000","dateUpdated":"2023-11-09T13:58:30+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-12-aws-well-architected-tool-supports-aws-saas-lens","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/12/aws-well-architected-tool-supports-aws-saas-lens/","dateCreated":"2023-11-09T14:08:06+0000","dateUpdated":"2024-07-25T13:14:06+0000","additionalFields":{"postBody":"\u003cp\u003e  The AWS SaaS Factory Program and AWS Well-Architected teams have combined their expertise in architectural best practices and knowledge of SaaS solutions to launch the new AWS Well-Architected SaaS Lens.\u003c/p\u003e\n\u003cp\u003eThe AWS Well-Architected SaaS Lens adds questions tailored to SaaS workloads to the\u0026nbsp;\u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\"\u003eAWS Well-Architected Tool\u003c/a\u003e.\u0026nbsp;These questions are intended to drive critical thinking for developing and operating SaaS workloads. The AWS Well-Architected Tool is based on the \u003ca href\u003d\"https://aws.amazon.com/architecture/well-architected/\"\u003eAWS Well-Architected Framework\u003c/a\u003e, which is a collection of the latest AWS architectural best practices developed to help you build secure, high-performing, resilient, and efficient applications. By answering a set of questions for each of the Framework pillars, the AWS Well-Architected Tool provides a detailed report that helps you understand potential risks in your workloads and identifies next steps for improvement.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eAWS Solution Architects from the \u003ca href\u003d\"https://aws.amazon.com/partners/saas-factory/\"\u003eAWS SaaS Factory Program\u003c/a\u003e,\u0026nbsp;having worked with thousands of Independent Software Vendors (ISV) and AWS Partner Network (APN) Partners, view these Well-Architected best practices as a key component of building and operating SaaS architecture on AWS. You can use the SaaS lens to conduct a self-service review of your existing or new workloads, or you can work with an \u003ca href\u003d\"https://aws.amazon.com/partners/saas-on-aws/partner-solutions/?partner-solutions-cards.sort-by\u003ditem.additionalFields.partnerName\u0026amp;partner-solutions-cards.sort-order\u003dasc\"\u003eAWS SaaS Competency Partner\u003c/a\u003e or \u003ca href\u003d\"https://aws.amazon.com/partners/well-architected-program/\"\u003eAWS Well-Architected Partner\u003c/a\u003e for a professional hands-on engagement designed to review and improve your SaaS workloads.\u003c/p\u003e\n\u003cp\u003eCheck out the SaaS Lens in the \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected\"\u003eAWS Well-Architected Tool Console\u003c/a\u003e. Learn more in the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/index.html\"\u003eWell-Architected Tool User Guide\u003c/a\u003e. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-12-18T23:48:25Z","headlineUrl":"/about-aws/whats-new/2020/12/aws-well-architected-tool-supports-aws-saas-lens/","postDateTime":"2020-12-03T14:45:00Z","contentType":"Launch Announcement","headline":"AWS Well-Architected Tool now Supports AWS SaaS Lens","postSummary":"\u003cp\u003e  The AWS SaaS Factory Program and AWS Well-Architected teams have combined their expertise in architectural best practices and knowledge of SaaS solutions to launch the new AWS Well-Architected SaaS Lens.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#reinvent-2020-others-w1","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"reinvent-2020-others-w1","description":"marketing:marchitecture/reinvent-2020-others-w1","dateCreated":"2023-11-09T13:58:10+0000","dateUpdated":"2023-11-09T13:58:10+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#marketing-marchitecture#partner-network","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"partner-network","description":"marketing:marchitecture/partner-network","dateCreated":"2023-11-09T13:50:48+0000","dateUpdated":"2023-11-09T13:50:48+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#marketing-marchitecture#developer-tools","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"developer-tools","description":"marketing:marchitecture/developer-tools","dateCreated":"2023-11-07T22:40:35+0000","dateUpdated":"2023-11-07T22:40:35+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-12-aws-foundational-technical-review-lens-available-aws-well-architected-tool","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/12/aws-foundational-technical-review-lens-available-aws-well-architected-tool/","dateCreated":"2023-11-09T14:05:22+0000","dateUpdated":"2024-07-25T13:06:42+0000","additionalFields":{"postBody":"\u003cp\u003eAWS Partner Network (APN) Partners are now able to prepare for the APN \u003ca href\u003d\"https://aws.amazon.com/partners/technical-baseline-review/\"\u003eFoundational Technical Review\u003c/a\u003e (FTR) by applying the new AWS Well-Architected Tool FTR Lens to workloads when you conduct a Well-Architected Framework Review in the \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\"\u003eAWS Well-Architected Tool\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eThe FTR, formerly known as the Technical Baseline Review, is the APN review process that validates APN Partner workloads for a select set of AWS best practices that are fundamental for promoting customer success. This new AWS Well-Architected Tool Lens provides a way for APN Partners to prepare for the FTR by assessing workloads for APN FTR requirements and remediating issues based on prescriptive improvement plans.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003e The AWS Well-Architected FTR Lens includes best practices for security, reliability, and operational excellence, representing the best-practice requirements necessary for membership in the AWS Partner Network.  These best practices help partners take their first step to becoming Well-Architected.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003e The new FTR Lens in the AWS Well-Architected Tool is available to customers and APN Partners at no additional charge and is offered in all Regions where the \u003ca href\u003d\"https://signin.aws.amazon.com/signin?redirect_uri\u003dhttps%3A%2F%2Fus-east-2.console.aws.amazon.com%2Fconsole%2Fhome%3Fregion%3Dus-east-2%26state%3DhashArgs%2523%26isauthcode%3Dtrue\u0026amp;client_id\u003darn%3Aaws%3Aiam%3A%3A015428540659%3Auser%2Fhomepage\u0026amp;forceMobileApp\u003d0\u0026amp;code_challenge\u003dFKN0fBBF2L8EnJ1DfSYxwvVdK7Tl3dj6u0f4mEPAcvk\u0026amp;code_challenge_method\u003dSHA-256\"\u003eAWS Well-Architected Tool is available\u003c/a\u003e. To learn more about the AWS Well-Architected Tool, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/index.html\"\u003eUser Guide\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\"\u003eProduct Page\u003c/a\u003e. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003e\u003ca href\u003d\"https://partners.amazonaws.com/search/partners?facets\u003d%27Program+:+Well+Architected%27\u0026amp;size\u003d10\u0026amp;start\u003d0\u0026amp;sort\u003dRelevance\u0026amp;view\u003dGrid\"\u003eAWS Well-Architected Partners\u003c/a\u003e can help you review and improve your workloads. To learn more about becoming an AWS Well-Architected Partner, visit the \u003ca href\u003d\"https://aws.amazon.com/partners/programs/well-architected/\"\u003eAWS Well-Architected Partner Program\u003c/a\u003e page.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003e\u003cb\u003e\u003ci\u003e\u003csup\u003eUpdate: 1/31/2023 -\u0026nbsp;The AWS Foundational Technical Review Lens has been deprecated but you can continue to use the Well-Architected tool to prepare for Foundational Technical Review.\u003c/sup\u003e\u003c/i\u003e\u003c/b\u003e\u003c/p\u003e\r\n","modifiedDate":"2023-01-31T16:54:05Z","headlineUrl":"/about-aws/whats-new/2020/12/aws-foundational-technical-review-lens-available-aws-well-architected-tool/","postDateTime":"2020-12-03T08:30:00Z","contentType":"Launch Announcement","headline":"AWS Foundational Technical Review Lens now available in the AWS Well-Architected Tool","postSummary":"\u003cp\u003eAWS Partner Network (APN) Partners are now able to prepare for the APN \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/partners/technical-baseline-review.html\"\u003eFoundational Technical Review\u003c/a\u003e (FTR) by applying the new AWS Well-Architected Tool FTR Lens to workloads when you conduct a Well-Architected Framework Review in the \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/well-architected-tool.html\"\u003eAWS Well-Architected Tool\u003c/a\u003e.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#marketing-marchitecture#partner-network","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"partner-network","description":"marketing:marchitecture/partner-network","dateCreated":"2023-11-09T13:50:48+0000","dateUpdated":"2023-11-09T13:50:48+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#marketing-marchitecture#reinvent-2020-others-w1","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"reinvent-2020-others-w1","description":"marketing:marchitecture/reinvent-2020-others-w1","dateCreated":"2023-11-09T13:58:10+0000","dateUpdated":"2023-11-09T13:58:10+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-07-updates-aws-well-architected-framework-tool","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/07/updates-aws-well-architected-framework-tool/","dateCreated":"2023-11-09T14:09:39+0000","dateUpdated":"2024-07-25T13:33:11+0000","additionalFields":{"postBody":"\u003cp\u003eThe latest update to the AWS Well-Architected Framework is now available and reflects the latest best practice guidance for designing and deploying cloud workloads. An integral part of the AWS Well-Architected Tool (AWS WA Tool), the AWS Well-Architected Framework has been a guide for building secure, efficient, reliable, cost-effective, and high-performance workloads on AWS since 2015. It continues to evolve and improve as new cloud services and capabilities are introduced.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThis update includes new and updated questions, best practices, and improvement plans, plus additional examples and architectural considerations. We have added new best practices in operational excellence (organization), reliability (workload architecture), and cost optimization (practice Cloud Financial Management). \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eStarting today, all new workloads in the AWS WA Tool will use the new version of the Framework. For existing workloads, you are given the option to upgrade to the new version of the Framework. By using the most recent version, you can be assured that you are getting the best guidance AWS has to offer on operating, building, and adapting workloads for AWS. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eWith this update, the AWS WA Tool and the Framework whitepapers are now available in a total of 10 languages: English, Spanish, French, German, Italian, Portuguese, Korean, Japanese, Simplified Chinese, and Traditional Chinese. The AWS WA Tool is generally available in the following AWS Regions: US East (N. Virginia, Ohio), US West (N. California, Oregon), Europe (Frankfurt, Ireland, London, Paris, Stockholm), South America (Sao Paulo), Asia Pacific (Singapore, Sydney, Tokyo, Seoul, Mumbai, Hong Kong), Middle East (Bahrain), and Canada (Central).\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eTo get started using the AWS Well-Architected Tool with the new version of the AWS Well-Architected Framework, open the \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected\"\u003eAWS Well-Architected Tool\u003c/a\u003e in the AWS Management Console. To learn more, visit the \u003ca href\u003d\"https://aws.amazon.com/architecture/well-architected/\"\u003eAWS Well-Architected website\u003c/a\u003e where the Framework whitepapers are available to read online, or download them to your Kindle or other device.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-07-09T16:39:56Z","headlineUrl":"/about-aws/whats-new/2020/07/updates-aws-well-architected-framework-tool/","postDateTime":"2020-07-09T15:17:50Z","contentType":"Launch Announcement","headline":"Updates to the AWS Well-Architected Framework and the AWS Well-Architected Tool","postSummary":"\u003cp\u003eThe latest update to the AWS Well-Architected Framework is now available and reflects the latest best practice guidance for designing and deploying cloud workloads. An integral part of the AWS Well-Architected Tool (AWS WA Tool), the AWS Well-Architected Framework has been a guide for building secure, efficient, reliable, cost-effective, and high-performance workloads on AWS since 2015. It continues to evolve and improve as new cloud services and capabilities are introduced.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-06-the-aws-well-architected-tool-is-now-available-in-the-middle-east-bahrain-asia-pacific-hong-kong-and-canada-central-regions","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/06/the-aws-well-architected-tool-is-now-available-in-the-middle-east-bahrain-asia-pacific-hong-kong-and-canada-central-regions/","dateCreated":"2023-11-09T14:08:51+0000","dateUpdated":"2024-07-25T13:12:05+0000","additionalFields":{"postBody":"\u003cp\u003eThe AWS Well-Architected Tool is now available in the Middle East (Bahrain), Asia Pacific (Hong Kong), and Canada (Central) Regions. The AWS Well-Architected Tool helps you review your workloads against AWS architectural best practices, and provides guidance on improving your cloud architectures. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eWith this regional expansion, the tool is now available in the following AWS Regions: US East (N. Virginia, Ohio), US West (N. California, Oregon), Canada (Central), Europe (Frankfurt, Ireland, London, Paris, Stockholm), South America (Sao Paulo), Asia Pacific (Singapore, Sydney, Tokyo, Seoul, Mumbai, Hong Kong), and Middle East (Bahrain).\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eTo get started, visit the \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected/\"\u003eAWS Management Console\u003c/a\u003e. To learn more, refer to the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/index.html\"\u003eUser Guide\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\"\u003eProduct Overview\u003c/a\u003e. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-06-24T19:22:48Z","headlineUrl":"/about-aws/whats-new/2020/06/the-aws-well-architected-tool-is-now-available-in-the-middle-east-bahrain-asia-pacific-hong-kong-and-canada-central-regions/","postDateTime":"2020-06-24T10:00:00Z","contentType":"Launch Announcement","headline":"The AWS Well-Architected Tool is now available in the Middle East (Bahrain), Asia Pacific (Hong Kong), and Canada (Central) Regions","postSummary":"\u003cp\u003eThe AWS Well-Architected Tool is now available in the Middle East (Bahrain), Asia Pacific (Hong Kong), and Canada (Central) Regions. The AWS Well-Architected Tool helps you review your workloads against AWS architectural best practices, and provides guidance on improving your cloud architectures. \u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-04-aws-well-architected-tool-available-additional-regions","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/04/aws-well-architected-tool-available-additional-regions/","dateCreated":"2023-11-09T14:00:59+0000","dateUpdated":"2024-07-25T13:30:07+0000","additionalFields":{"postBody":"\u003cp\u003eThe AWS Well-Architected Tool is now available in the Northern California, São Paulo, and Singapore Regions. The AWS Well-Architected Tool helps you review your workloads against AWS architectural best practices, and provides guidance on improving your cloud architectures.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eWith this regional expansion, the tool is now available in the following AWS Regions: US East (N. Virginia, Ohio), US West (N. California, Oregon), Europe (Frankfurt, Ireland, London, Paris, Stockholm), South America (São Paulo), and Asia Pacific (Singapore, Sydney, Tokyo, Seoul, Mumbai).\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eTo get started, visit the \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected/\" target\u003d\"_blank\"\u003eAWS Management Console\u003c/a\u003e. To learn more, refer to the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/index.html\" target\u003d\"_blank\"\u003eUser Guide\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\" target\u003d\"_blank\"\u003eProduct Overview\u003c/a\u003e. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-04-30T19:12:14Z","headlineUrl":"/about-aws/whats-new/2020/04/aws-well-architected-tool-available-additional-regions/","postDateTime":"2020-04-30T10:52:00Z","contentType":"Launch Announcement","headline":"The AWS Well-Architected Tool is now available in the Northern California, São Paulo, and Singapore Regions","postSummary":"\u003cp\u003eThe AWS Well-Architected Tool is now available in the Northern California, São Paulo, and Singapore Regions. The AWS Well-Architected Tool helps you review your workloads against AWS architectural best practices, and provides guidance on improving your cloud architectures.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-02-the-aws-well-architected-tool-is-now-available-in-the-stockholm-paris-and-mumbai-regions","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/02/the-aws-well-architected-tool-is-now-available-in-the-stockholm-paris-and-mumbai-regions/","dateCreated":"2023-11-09T14:01:45+0000","dateUpdated":"2024-07-25T13:24:00+0000","additionalFields":{"postBody":"\u003cp\u003eThe AWS Well-Architected Tool is now available in the Stockholm, Paris, and Mumbai Regions. The AWS Well-Architected Tool helps you review your workloads against AWS architectural best practices, and provides guidance on improving your cloud architectures.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eWith this regional expansion, the tool is now available in the following AWS Regions: US East (N. Virginia, Ohio), US West (Oregon), Europe (Frankfurt, Ireland, London, Paris, Stockholm), and Asia Pacific (Sydney, Tokyo, Seoul, Mumbai).\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eTo get started, visit the \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected/\"\u003eAWS Management Console\u003c/a\u003e. To learn more, refer to the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/index.html\"\u003eUser Guide\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\"\u003eProduct Overview\u003c/a\u003e. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-02-26T20:43:17Z","headlineUrl":"/about-aws/whats-new/2020/02/the-aws-well-architected-tool-is-now-available-in-the-stockholm-paris-and-mumbai-regions/","postDateTime":"2020-02-26T10:00:00Z","contentType":"Launch Announcement","headline":"The AWS Well-Architected Tool is now available in the Stockholm, Paris, and Mumbai Regions","postSummary":"\u003cp\u003eThe AWS Well-Architected Tool is now available in the Stockholm, Paris, and Mumbai Regions. The AWS Well-Architected Tool helps you review your workloads against AWS architectural best practices, and provides guidance on improving your cloud architectures.\u003cbr\u003e\n\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-02-aws-well-architected-tool-now-supports-aws-serverless-lens","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/02/aws-well-architected-tool-now-supports-aws-serverless-lens/","dateCreated":"2023-11-09T13:57:24+0000","dateUpdated":"2024-07-25T13:11:21+0000","additionalFields":{"postBody":"\u003cp\u003eThe AWS Well-Architected Tool (AWS WA Tool) now supports the AWS Serverless Lens, which provides best practices for reviewing serverless workloads.\u003c/p\u003e\n\u003cp\u003eThe AWS WA Tool is based on the AWS Well-Architected Framework, which was developed to help you build secure, high-performing, resilient, and efficient applications using the latest AWS architectural best practices. By answering a set of questions across the five pillars of the Framework, the AWS WA Tool provides a detailed report that helps you understand potential risks in your workload and identifies next steps for improvement. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThe AWS Serverless Lens adds additional questions and best practices across the five pillars of the Framework that are specifically tailored for serverless workloads. The AWS Serverless Lens in the AWS WA Tool can be applied to new and existing workloads to understand potential risks and identify next steps for improvement. You can also work with an AWS Well-Architected Partner Program member to review and improve your serverless workloads.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThe AWS Serverless Applications Lens in the AWS WA Tool is available to customers at no additional charge and is offered in all Regions where the AWS Well-Architected Tool is available: US East (N. Virginia, Ohio), US West (Oregon), Europe (Frankfurt, Ireland, London), and Asia Pacific (Seoul, Sydney, Tokyo) Regions. To learn more about the AWS Well-Architected Tool, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/index.html\"\u003eUser Guide\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\"\u003eProduct Page\u003c/a\u003e. For more information about the AWS Serverless Applications Lens, see the \u003ca href\u003d\"https://d1.awsstatic.com/whitepapers/architecture/AWS-Serverless-Applications-Lens.pdf\"\u003ewhitepaper\u003c/a\u003e. To engage with an AWS Well-Architected Partner Program member, or to learn more about the program, see the \u003ca href\u003d\"https://aws.amazon.com/partners/well-architected-program/\"\u003ePartner Program Page\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-02-11T20:41:35Z","headlineUrl":"/about-aws/whats-new/2020/02/aws-well-architected-tool-now-supports-aws-serverless-lens/","postDateTime":"2020-02-11T10:00:00Z","contentType":"Launch Announcement","headline":"AWS Well-Architected Tool now supports AWS Serverless Lens","postSummary":"\u003cp\u003eThe AWS Well-Architected Tool (AWS WA Tool) now supports the AWS Serverless Lens, which provides best practices for reviewing serverless workloads.\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-01-introducing-workload-shares-in-aws-well-architected-tool","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/01/introducing-workload-shares-in-aws-well-architected-tool/","dateCreated":"2023-11-09T13:50:47+0000","dateUpdated":"2024-07-25T13:02:59+0000","additionalFields":{"postBody":"\u003cp\u003eThe AWS Well-Architected Tool now offers you a simple way to share workloads with other AWS accounts. Many customers use multiple AWS accounts to provide administrative autonomy for their teams. With Workload Shares, you can now create workloads in the AWS account of your choice and share them with AWS accounts used by other members of your review team or with a centralized AWS account. This feature enables shared visibility into High Risk Issues (HRIs) identified in workloads and streamlines collaboration with other workload reviewers, such as a Cloud Center of Excellence Lead, a member of your AWS account team or an AWS Well-Architected Partner Program member. The Workload Shares feature can help you manage and drive down HRIs over time without requiring direct access to the AWS account where the workload is defined.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eWorkload Shares is available to customers at no additional charge and is offered in all Regions where the AWS Well-Architected Tool is available: US East (N. Virginia, Ohio), US West (Oregon), Europe (Frankfurt, Ireland, London), and Asia Pacific (Seoul, Sydney, Tokyo) Regions.\u0026nbsp;To learn more about AWS Well-Architected Tool, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/index.html\" target\u003d\"_blank\"\u003eDocumentation\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\" target\u003d\"_blank\"\u003eProduct Page\u003c/a\u003e. To learn more about how to engage an AWS Well-Architected Partner Program member visit the \u003ca href\u003d\"https://aws.amazon.com/partners/well-architected-program/\" target\u003d\"_blank\"\u003eProgram Page\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-01-10T19:25:51Z","headlineUrl":"/about-aws/whats-new/2020/01/introducing-workload-shares-in-aws-well-architected-tool/","postDateTime":"2020-01-10T12:44:00Z","contentType":"Launch Announcement","headline":"Introducing Workload Shares in AWS Well-Architected Tool","postSummary":"\u003cp\u003eThe AWS Well-Architected Tool now offers you a simple way to share workloads with other AWS accounts. Many customers use multiple AWS accounts to provide administrative autonomy for their teams. With Workload Shares, you can now create workloads in the AWS account of your choice and share them with AWS accounts used by other members of your review team or with a centralized AWS account. This feature enables shared visibility into High Risk Issues (HRIs) identified in workloads and streamlines collaboration with other workload reviewers, such as a Cloud Center of Excellence Lead, a member of your AWS account team or an AWS Well-Architected Partner Program member. The Workload Shares feature can help you manage and drive down HRIs over time without requiring direct access to the AWS account where the workload is defined.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-01-aws-well-architected-tool-now-available-asia-pacific-seoul-region","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/01/aws-well-architected-tool-now-available-asia-pacific-seoul-region/","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2024-07-25T13:09:52+0000","additionalFields":{"postBody":"\u003cp\u003eThe AWS Well-Architected Tool is now available in the Asia Pacific (Seoul) Region and the tool has been localized into Korean. The AWS Well-Architected Tool helps you review your workloads against AWS architectural best practices, and provides guidance on improving your cloud architectures.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eWith this Regional expansion, the tool is available in the following AWS Regions: US East (N. Virginia, Ohio), US West (Oregon), Europe (Frankfurt, Ireland, London), and Asia Pacific (Sydney, Tokyo, Seoul).\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eTo get started, visit the \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected/\" target\u003d\"_blank\"\u003eAWS Management Console\u003c/a\u003e. To learn more, refer to the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/index.html\" target\u003d\"_blank\"\u003eUser Guide\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\" target\u003d\"_blank\"\u003eProduct Overview\u003c/a\u003e. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-01-10T18:05:20Z","headlineUrl":"/about-aws/whats-new/2020/01/aws-well-architected-tool-now-available-asia-pacific-seoul-region/","postDateTime":"2020-01-10T11:18:00Z","contentType":"Launch Announcement","headline":"The AWS Well-Architected Tool is now available in the Asia Pacific (Seoul) Region","postSummary":"\u003cp\u003eThe AWS Well-Architected Tool is now available in the Asia Pacific (Seoul) Region and the tool has been localized into Korean. The AWS Well-Architected Tool helps you review your workloads against AWS architectural best practices, and provides guidance on improving your cloud architectures.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-12-aws-well-architected-tool-available-in-europe-frankfurt-region","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/12/aws-well-architected-tool-available-in-europe-frankfurt-region/","dateCreated":"2023-11-09T14:21:15+0000","dateUpdated":"2024-07-25T13:29:01+0000","additionalFields":{"postBody":"\u003cp\u003eThe AWS Well-Architected Tool is now available in the Europe (Frankfurt) Region. The AWS Well-Architected Tool helps you review your workloads against AWS architectural best practices, and provides guidance on improving your cloud architectures.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eWith this Regional expansion, the tool is available in the following AWS Regions: US East (N. Virginia, Ohio), US West (Oregon), Europe (Frankfurt, Ireland, London), and Asia Pacific (Sydney, Tokyo).\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eTo get started, visit the \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected/\"\u003eAWS Management Console\u003c/a\u003e. To learn more, refer to[AH1] the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/index.html\"\u003eUser Guide\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\"\u003eProduct Overview\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-12-11T21:37:41Z","headlineUrl":"/about-aws/whats-new/2019/12/aws-well-architected-tool-available-in-europe-frankfurt-region/","postDateTime":"2019-12-11T10:46:35Z","contentType":"Launch Announcement","headline":"The AWS Well-Architected Tool is now available in the Europe (Frankfurt) Region ","postSummary":"\u003cp\u003eThe AWS Well-Architected Tool is now available in the Europe (Frankfurt) Region. The AWS Well-Architected Tool helps you review your workloads against AWS architectural best practices, and provides guidance on improving your cloud architectures.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-09-aws-well-architected-tool-now-available-tokyo-region-and-localized-into-japanese","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/09/aws-well-architected-tool-now-available-tokyo-region-and-localized-into-japanese/","dateCreated":"2023-11-09T14:04:42+0000","dateUpdated":"2024-07-25T13:28:10+0000","additionalFields":{"postBody":"\u003cp\u003eAWS Well-Architected Tool is now available in the Asia Pacific (Tokyo) Region and the tool has been localized into Japanese. AWS Well-Architected Tool helps you review your workloads against AWS architectural best practices, and provides guidance on improving your cloud architectures.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eWith this regional expansion, the tool is available in the following AWS Regions: US East (N. Virginia, Ohio), US West (Oregon), Europe (Ireland), Europe (London), and Asia Pacific (Sydney, Tokyo). \u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eTo get started, visit the \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected/\"\u003eAWS Management Console\u003c/a\u003e. To learn more, see the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/index.html\"\u003eDocumentation\u003c/a\u003e and the \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\"\u003eProduct page\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-10-06T05:02:34Z","headlineUrl":"/about-aws/whats-new/2019/09/aws-well-architected-tool-now-available-tokyo-region-and-localized-into-japanese/","postDateTime":"2019-09-25T14:34:00Z","contentType":"Launch Announcement","headline":"AWS Well-Architected Tool now available in the Asia Pacific (Tokyo) Region and localized into Japanese","postSummary":"\u003cp\u003eAWS Well-Architected Tool is now available in the Asia Pacific (Tokyo) Region and the tool has been localized into Japanese. AWS Well-Architected Tool helps you review your workloads against AWS architectural best practices, and provides guidance on improving your cloud architectures.\u003cbr\u003e\n\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-07-aws-well-architected-tool-available-aws-europe-region","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/07/aws-well-architected-tool-available-aws-europe-region/","dateCreated":"2023-11-09T14:17:35+0000","dateUpdated":"2024-07-25T13:24:15+0000","additionalFields":{"postBody":"\u003cp\u003eThe AWS Well-Architected Tool is now available in AWS Europe (London) region. The AWS Well-Architected Tool helps you review your workloads against the latest AWS architectural best practices, and get guidance on how to improve your cloud architectures.  \u0026nbsp;\u003c/p\u003e\n\u003cp\u003e  With this regional expansion, the tool is available in US East (N. Virginia, Ohio), US West (Oregon), Europe (Ireland), Europe (London), and Asia Pacific (Sydney) Regions.\u003c/p\u003e\n\u003cp\u003eTo get started, visit the \u003ca href\u003d\"https://console.aws.amazon.com/\"\u003eAWS Management Console\u003c/a\u003e. To learn more, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/index.html\"\u003eDocumentation\u003c/a\u003e and the \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\"\u003eProduct page\u003c/a\u003e.\u003c/p\u003e\n","modifiedDate":"2019-10-06T05:01:41Z","headlineUrl":"/about-aws/whats-new/2019/07/aws-well-architected-tool-available-aws-europe-region/","postDateTime":"2019-07-24T12:10:00Z","contentType":"Launch Announcement","headline":"AWS Well-Architected Tool is now available in AWS Europe (London) region","postSummary":"\u003cp\u003eThe AWS Well-Architected Tool is now available in AWS Europe (London) region. The AWS Well-Architected Tool helps you review your workloads against the latest AWS architectural best practices, and get guidance on how to improve your cloud architectures.  \u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-04-aws-well-architected-tool-is-now-available-in-aws-asia-pacific-sydney-region","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/04/aws-well-architected-tool-is-now-available-in-aws-asia-pacific-sydney-region/","dateCreated":"2023-11-09T14:07:22+0000","dateUpdated":"2024-07-25T13:12:26+0000","additionalFields":{"postBody":"\u003cp\u003eThe AWS Well-Architected Tool is now available in AWS Asia Pacific (Sydney) region. The AWS Well-Architected Tool was introduced in Nov 2018 to help you review your workloads against the latest AWS architectural best practices, and get guidance on how to improve your cloud architectures. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003e                With this regional expansion, the tool is available in US East (N. Virginia, Ohio), US West (Oregon), Europe (Ireland), and Asia Pacific (Sydney) Regions.\u003c/p\u003e\n\u003cp\u003eTo get started, visit the \u003ca href\u003d\"https://console.aws.amazon.com/\" target\u003d\"_blank\"\u003eAWS Management Console\u003c/a\u003e. To learn more, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/index.html\" target\u003d\"_blank\"\u003eDocumentation\u003c/a\u003e and the \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\" target\u003d\"_blank\"\u003eProduct\u003c/a\u003e page.\u003cbr\u003e\n\u003c/p\u003e\n","modifiedDate":"2019-11-08T22:20:06Z","headlineUrl":"/about-aws/whats-new/2019/04/aws-well-architected-tool-is-now-available-in-aws-asia-pacific-sydney-region/","postDateTime":"2019-04-30T10:15:00Z","contentType":"Launch Announcement","headline":"AWS Well-Architected Tool is now available in AWS Asia Pacific (Sydney) region","postSummary":"\u003cp\u003eThe AWS Well-Architected Tool is now available in AWS Asia Pacific (Sydney) region. The AWS Well-Architected Tool was introduced in Nov 2018 to help you review your workloads against the latest AWS architectural best practices, and get guidance on how to improve your cloud architectures. \u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-02-aws-well-architected-tool-now-supports-architecture-reviews-for","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/02/aws-well-architected-tool-now-supports-architecture-reviews-for-/","dateCreated":"2023-11-09T14:15:52+0000","dateUpdated":"2024-07-25T13:36:35+0000","additionalFields":{"postBody":"\u003cp\u003eYou can now use the AWS Well-Architected Tool to also perform architectural reviews for hybrid cloud workloads as well as workloads which are fully deployed on-premises.\u003c/p\u003e\n\u003cp\u003eWhen you define your workload, you now have the option to select both the AWS and the non-AWS Region(s) in which your workload is deployed. This allows you to document whether your workload is fully deployed on AWS, is partially deployed on AWS or running completely on-premises. You can then continue with the Well-Architected review as before.\u003c/p\u003e\n\u003cp\u003eTo learn more, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/userguide/\"\u003eDocumentation\u003c/a\u003e and the \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\"\u003eProduct page\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:59:48Z","headlineUrl":"/about-aws/whats-new/2019/02/aws-well-architected-tool-now-supports-architecture-reviews-for-/","postDateTime":"2019-02-19T00:00:00Z","contentType":"Launch Announcement","headline":"AWS Well-Architected Tool now supports architecture reviews for On Premises and Hybrid Cloud workloads","postSummary":"\u003cp\u003eYou can now use the AWS Well-Architected Tool to also perform architectural reviews for hybrid cloud workloads as well as workloads which are fully deployed on-premises.\u003c/p\u003e\n\u003cp\u003eWhen you define your workload, you now have the option to select both the AWS and the non-AWS Region(s) in which your workload is deployed. This allows you to document whether your workload is fully deployed on AWS, is partially deployed on AWS or running completely on-premises. You can then continue with the Well-Architected review as before.\u003c/p\u003e\n\u003cp\u003eTo learn more, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/userguide/\"\u003eDocumentation\u003c/a\u003e and the \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\"\u003eProduct page\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2018-11-introducing-aws-well-architected-tool","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2018/11/introducing-aws-well-architected-tool/","dateCreated":"2023-11-09T14:24:29+0000","dateUpdated":"2024-07-25T14:07:42+0000","additionalFields":{"postBody":"\u003cp\u003eYou can now use the AWS Well-Architected Tool to review your workloads against the latest AWS architectural best practices, and get guidance on how to improve your cloud architectures. The tool is based on the AWS Well-Architected Framework, which was developed to help you build secure, high-performing, resilient, and efficient application architectures.\u003c/p\u003e\n\u003cp\u003eUsing the tool, you can review your workloads using a consistent process, understand potential risks in your workload architectures and identify next steps for improvement. Define your workload, and answer a set of questions across the five pillars of the Well Architected Framework. The AWS Well-Architected Tool will then provide a plan describing the improvements that can be applied to the workload.\u003c/p\u003e\n\u003cp\u003eThere’s no charge for the AWS Well-Architected Tool; you pay only for any AWS resources that you consume. The AWS Well-Architected Tool is available in US East (N. Virginia), US East (Ohio), US West (Oregon), and Europe (Ireland). To get started, \u003ca href\u003d\"https://console.aws.amazon.com/wellarchitected/home\"\u003evisit the AWS Management Console\u003c/a\u003e. To learn more, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/wellarchitected/latest/userguide/\"\u003eDocumentation\u003c/a\u003e and the \u003ca href\u003d\"https://aws.amazon.com/well-architected-tool/\"\u003eProduct page.\u003c/a\u003e\u003c/p\u003e\n","modifiedDate":"2019-11-08T22:18:41Z","headlineUrl":"/about-aws/whats-new/2018/11/introducing-aws-well-architected-tool/","postDateTime":"2018-11-29T15:00:00Z","contentType":"Launch Announcement","headline":"AWS Well-Architected Tool Now Available","postSummary":"\u003cp\u003eYou can now use the AWS Well-Architected Tool to review your workloads against the latest AWS architectural best practices, and get guidance on how to improve your cloud architectures. The tool is based on the AWS Well-Architected Framework, which was developed to help you build secure, high-performing, resilient, and efficient application architectures.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-well-architected-tool","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-well-architected-tool","description":"general:products/aws-well-architected-tool","dateCreated":"2023-11-09T13:50:31+0000","dateUpdated":"2023-11-09T13:50:31+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#year#2018","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2018","description":"year#2018","dateCreated":"2023-11-09T14:20:09+0000","dateUpdated":"2023-11-09T14:20:09+0000"}]}],"metadata":{"count":41,"totalHits":41},"fieldTypes":{"regionalAvailability":"LongText","nofollow":"Boolean","date":"Date","language":"Text","title":"Text","postDateTime":"DateTime","body":"Text","postSummary":"LongText","ctaLabel":"Text","mediaThumbnail":"Text","nosnippet":"Boolean","price":"Text","ctaLink":"URL","headline":"Text","contentType":"Text","bodyBack":"LongText","secondaryCTALabel":"Text","primaryCTALink":"URL","noindex":"Boolean","level":"Text","heading":"Text","mediaType":"Text","mediaAlt":"Text","headlineUrl":"Text","mediaSrc":"URL","durationMinutes":"Number","badge":"JSON","videoImageUrl":"URL","postBody":"LongText","secondaryCTALink":"URL","Video":"URL","modifiedDate":"DateTime","namePerson":"Text","location":"Text","time":"Text","publishedDate":"DateTime","durationReadtime":"Number","primaryCTALabel":"Text"}}