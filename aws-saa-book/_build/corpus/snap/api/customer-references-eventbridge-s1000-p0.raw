ocale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#agriculture","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Agriculture","description":"Agriculture","dateCreated":"2020-06-25T04:02:53+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"customer-references#big-rocks#aws-for-data","locale":"en_US","tagNamespaceId":"customer-references#big-rocks","name":"AWS for Data","description":"\u003cp\u003eAWS for Data is a marketing \u0026ldquo;Big Rock\u0026rdquo; initiative that tells the story around how AWS can provide the most comprehensive set of data capabilities spanning databases, analytics, business intelligence, and machine learning for an end-to-end data strategy.\u003c/p\u003e\n","dateCreated":"2024-02-14T22:32:15+0000","dateUpdated":"2024-02-14T22:32:15+0000"}]},{"item":{"id":"customer-references#propertyfinder12222021kjnaefocihadw","locale":"en_US","directoryId":"customer-references","name":"propertyfinder12222021kjnaefocihadw","dateCreated":"2022-05-23T21:43:01+0000","dateUpdated":"2022-05-23T21:53:10+0000","additionalFields":{"descriptionSummary":"Property Finder Group is the leading real estate digital platform in the Middle East with Property Finder UAE (propertyfinder.ae) being the largest real estate platform in the UAE. They offer a wide range of residential and commercial properties for sale and rent. Property Finder are running their entire set of production applications (around 250+) on Amazon EKS with 100% spot instances. They migrated from On-Demand EC2 instance based monolith deployment to a microservices based architecture on Amazon EKS. YoY, they have seen almost a 15% reduction in costs after migrating to EKS. They use a combination of event based architecture with Rabbit MQ, Lambda, EventBridge and EKS with Spot instances.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/property-finder-logo%401x.efb1597c2724f47efaed744e2e830533c5f87623.png","displayLocation":"Europe, Middle East, \u0026 Africa","footerInfoText":"Published Date","industry":"Consumer Packaged Goods (CPG)","sortDate":"2021-12-22","headlineUrl":"https://youtu.be/cnZeOytEkIM?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Property Finder: Running Production Workloads with Amazon EKS on 100% Amazon EC2 Spot Instances","customer-name":"Property Finder"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#video","locale":"en_U