rid","dateCreated":"2019-07-22T18:31:50+0000","dateUpdated":"2022-05-09T21:31:12+0000"},{"id":"customer-references#category#hybrid-cloud-architecture","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Hybrid Cloud Architecture","description":"Hybrid Cloud Architecture","dateCreated":"2019-07-22T18:32:02+0000","dateUpdated":"2023-10-28T22:02:50+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"}]},{"item":{"id":"customer-references#porto-case-study","locale":"en_US","directoryId":"customer-references","name":"porto-case-study","dateCreated":"2023-06-01T23:04:25+0000","dateUpdated":"2023-06-08T04:07:49+0000","additionalFields":{"descriptionSummary":"Fundada há mais de 75 anos, a Porto se consolidou no mercado de seguros, especialmente de automóveis. Nos últimos anos, vem diversificando sua atuação e, hoje, é um verdadeiro ecossistema de soluções de serviços de proteção com tecnologia embarcada, para melhorar e facilitar a experiência do cliente, atuando com três verticais de negócios: Porto Seguro, Porto Saúde e Porto Bank. Em um movimento de modernizar o seu ambiente tecnológico e dar velocidade aos objetivos estabelecidos, a empresa tem investido em serviços em nuvem. Marcos Sirelli, diretor de tecnologia da Porto, Ivan Barale, superintendente de plataformas, arquitetura e engenharia da Porto, e Claudia Ramos, gerente de cloud e DevSecOps da Porto, contam como as soluções em nuvem da AWS atendem às demandas da Companhia por agilidade, modernização, flexibilidade, disponibilidade e escalabilidade. Como destaque, eles detalham o app desenvolvido em cloud para se tornar um ecossistema de interação com seus clientes. Neste vídeo, os executivos contam mais sobre este e outros casos de aplicação de AWS na Porto.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/porto-logo%402x.36a9d42219b7c7aae2df53ddfc1616c441eea4bb.png","displayLocation":"Brasil","customerNameLower":"porto","footerInfoText":"Data de publicação","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/porto-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Porto","enableShare":"1","publishedDate":"2023","contentType":"História do cliente","headline":"AWS apoia modernização de serviços na Porto"}},"tags":[{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notification Service (SNS)","dateCreated":"2020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#solutions-use-case#uc-smb","locale":"en_US","tagNamespaceId":"GLOBAL#solutions-use-case","name":"Small \u0026 Medium Business","description":"Small \u0026 Medium Business","dateCreated":"2022-08-23T05:49:46+0000","date