:"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#product#codebuild","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodeBuild","description":"AWS CodeBuild","dateCreated":"2020-03-02T07:02:08+0000","dateUpdated":"2022-02-03T03:32:24+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#consorcioanalytics","locale":"en_US","directoryId":"customer-references","name":"consorcioanalytics","dateCreated":"2023-06-01T23:09:04+0000","dateUpdated":"2023-06-08T04:07:36+0000","additionalFields":{"descriptionSummary":"Consorcio es una empresa líder en Chile en los negocios de seguros, financiero y de corredores de bolsa. En este video, Alejandro Truan, sugerente de advanced analytics en Consorcio, nos cuenta como el área de tecnología apoyó la institución en su proceso de cambio de visión, que desde el 2018 pasó a ser centrada en el cliente. La base de este cambio estaba en la centralización de todos los datos del grupo.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/consorcio_logo%401x.4f4ed9a3e34f945b60ad8a91a9b3a88f1d06b8fb.png","displayLocation":"Chile","footerInfoText":"Fecha de publicación","industry":"Servicios financieros","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/consorcioanalytics/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"Historia del cliente","customer-name":"Consorcio Financiero","headline":"Cómo AWS ayudó Consorcio a formar bases para dar un mejor servicio a los clientes"}},"tags":[{"id":"GLOBAL#business-category#cust-engagement","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2020-06-05T07:06:46+0000","dateUpdated":"2022-02-03T03:31:03+0000"},{"id":"customer-references#category#customer-engagement","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2019-07-22T18:31:37+0000","dateUpdated":"2022-03-21T23:37:45+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Gove