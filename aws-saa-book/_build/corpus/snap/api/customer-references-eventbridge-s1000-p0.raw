y#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#tacobell06092021kjsnfoksaef","locale":"en_US","directoryId":"customer-references","name":"tacobell06092021kjsnfoksaef","dateCreated":"2022-05-23T21:43:15+0000","dateUpdated":"2023-07-12T01:35:37+0000","additionalFields":{"descriptionSummary":"Taco Bell built a Serverless data integration platform to handle the complex task of creating unique menu\u0027s for each of their over 7000 restaurants. This menu middleware utilizes Aurora combined with Amplify, DynamoDB, Lambda, API Gateway, and Step Functions to create a scaleable cost effective data pipeline. Top it off by learning about their hot new internal service Diablo: Data Integration and Batch Lambda Orchestration - an easily extensible internal platform of reusable assets all built using Lambda and Step Functions. Disclaimer: Taco Bell\u0027s facts and figures detailed during the course of this presentation have been approximated and were used for illustrative purposes only.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/taco-bell_Logo%401x.d2526e7661a600cddf762dd287401a17b0ddc107.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Hospitality","sortDate":"2021-06-09","headlineUrl":"https://youtu.be/hf9nMAG9XoU?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"YUM Brands - Taco Bell Inc.","contentType":"Customer Story","headline":"Taco Bell: Aurora as The Heart of the Menu Middleware and Data Integration Platform for Taco Bell"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda",