teCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#iktos","locale":"en_US","directoryId":"customer-references","name":"iktos","dateCreated":"2023-06-01T23:25:26+0000","dateUpdated":"2023-08-11T22:26:58+0000","additionalFields":{"videoSrcUrl":"https://www.youtube.com/watch?v\u003diAhygDzeblE","descriptionSummary":"\u003cp\u003eSoci\u0026eacute;t\u0026eacute; d\u0026rsquo;intelligence artificielle sp\u0026eacute;cialis\u0026eacute;e dans la chimie, Iktos concentre l\u0026rsquo;ensemble de son activit\u0026eacute; \u0026agrave; aider les acteurs de l\u0026rsquo;industrie pharmaceutique \u0026agrave; acc\u0026eacute;l\u0026eacute;rer le processus de d\u0026eacute;veloppement de nouveaux m\u0026eacute;dicaments. Nicolas DO HUU, Co-founder \u0026amp; Chief Technology Officer chez Iktos, nous exprime les besoins et les probl\u0026eacute;matiques d\u0026rsquo;Iktos et comment AWS a su accompagner l\u0026rsquo;entreprise en pleine croissance \u0026agrave; d\u0026eacute;ployer rapidement ses solutions dans le cloud tout en b\u0026eacute;n\u0026eacute;ficiant de la puissance de calcul pour la recherche interne. Iktos a d\u0026eacute;cid\u0026eacute; de migrer vers le cloud pour faciliter la gestion du datacenter notamment la s\u0026eacute;curit\u0026eacute; et afin de gagner en scalabilit\u0026eacute;. Les bases de donn\u0026eacute;es, le message passing et l\u0026rsquo;acc\u0026egrave;s \u0026agrave; des GPU performants, font partie des services propos\u0026eacute;s par le cloud AWS n\u0026eacute;cessaires \u0026agrave; l\u0026rsquo;infrastructure d\u0026rsquo;Iktos. Cela a permis \u0026agrave; leurs d\u0026eacute;ploiements de passer de 3 semaines \u0026agrave; 1 jour et demi. Apr\u0026egrave;s le d\u0026eacute;veloppement de l\u0026rsquo;infrastructure de production sur AWS, la prochaine \u0026eacute;tape est de migrer l\u0026rsquo;infrastructure de R\u0026amp;D.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/iktos_Logo.7ab9062eb0c95b94734028ba88b8a47b5310f699.PNG","displayLocation":"France","customerNameLower":"iktos","footerInfoText":"Date de publication","industry":"Santé","sortDate":"2022-07-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/iktos/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Iktos","enableShare":"1","publishedDate":"2022","contentType":"Témoignages clients","headline":"Iktos : Le déploiement rapide et à grande échelle de solutions clients d’une entreprise d’IA en pleine croissance"}},"tags":[{"id":"GLOBAL#customer-enablement#developer-support","locale":"en_US","tagNamespaceId":"GLOBAL#customer-enablement","name":"AWS Developer Support","description":"AWS Developer Support","dateCreated":"2020-09-04T04:06:26+0000","dateUpdated":"2022-02-03T03:31:13+0000"},{"id":"GLOBAL#product#augmented-ai","locale":"en_US","tagNames