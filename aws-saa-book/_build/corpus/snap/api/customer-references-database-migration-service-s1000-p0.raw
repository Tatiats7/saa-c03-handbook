LOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#elemental-mediaconvert","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental MediaConvert","description":"AWS Elemental MediaConvert","dateCreated":"2020-03-02T07:03:13+0000","dateUpdated":"2022-02-03T03:32:35+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#media-services","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Media Services","description":"Media Services","dateCreated":"2020-07-17T03:06:10+0000","dateUpdated":"2022-02-03T03:35:28+0000"}]},{"item":{"id":"customer-references#amazon-fulfillment-technologies-aurora-case-study","locale":"en_US","directoryId":"customer-references","name":"amazon-fulfillment-technologies-aurora-case-study","dateCreated":"2019-07-19T14:56:29+0000","dateUpdated":"2023-07-19T03:04:55+0000","additionalFields":{"featured":"0","descriptionSummary":"Amazon migrated its Inventory Management Services from Oracle Database to Amazon Aurora to improve availability and scalability and reduce its operational burden. Amazon is the world\u0027s leading online retailer and provides a wide range of cloud services through its Amazon Web Services (AWS) division.","imageSrcUrl":"https://d1.awsstatic.com/amazon-logo-1x.a64c3eedfb84347ecf50e210637c0cf810922e10.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eAmazon migrated its Inventory Management Services from Oracle Database to Amazon Aurora to improve availability and scalability and reduce its operational burden. Amazon is the world\u0026#39;s leading online retailer and provides a wide range of cloud services through its Amazon Web Services (AWS) division. The company moved 700 Oracle instances to Amazon Aurora with PostgreSQL compatibility, achieving greater throughput, scalability, and resiliency.\u003c/p\u003e\r\n","industry":"Retail","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/amazon-fulfillment-aurora/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Amazon Fulfillment Technologies","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Amazon Fulfillment Technologies Aurora Case Study"}},"tags":[{"id":"customer-references#innovator#amazon","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Amazon","description":"Amazon","dateCreated":"2022-04-25T19:05:23+0000","dateUpdated":"2022-06-27T20:43:38+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"GLOBAL#product#database-migration-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Database Migration Service (DMS)","description":"AWS Database Migration Service (DMS)","dateCreated":"2020-03-02T07:02:30+0000","dateUpdated":"2022-02-03T03:32:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#retail","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Retail","description":"Retail","dateCreated":"2020-01-16T17:42:39+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"}]},{"item":{"id":"customer-references#amazon-advertising-case-study","locale":"en_US","directoryId":"customer-references","name":"amazon-advertising-case-study","dateCreated":"2019-07-19T14:58:37+0000","dateUpdated":"2023-07-19T03:04:55+0000","additionalFields":{"featured":"0","descriptionSummary":"Amazon Advertising Engineering and Development (AED) increased throughput and avoided a three-year project to rebuild performance monitors and management tools by shifting data held in Oracle databases to Amazon RDS. AED builds, manages, and scales the technologies that undergird Amazon\u0027s programmatic advertising offerings.","imageSrcUrl":"https://d1.awsstatic.com/amazon-logo-1x.a64c3eedfb84347ecf50e210637c0cf810922e10.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eAmazon Advertising Engineering and Development (AED) increased throughput exponentially and avoided a three-year project to rebuild performance monitors and management tools by shifting data held in Oracle databases to Amazon RDS. AED builds, manages, and scales the technologies that undergird Amazon\u0026#39;s programmatic advertising offerings. The new solution uses PostgreSQL relational databases that are fully managed by Amazon RDS, with Amazon S3 for storing backups.\u003c/p\u003e\r\n","industry":"Retail","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/Amazonadvertising/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Amazon Advertising","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Amazon Advertising Case Study"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description"