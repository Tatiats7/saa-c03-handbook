dated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#database-migration-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Database Migration Service (DMS)","description":"AWS Database Migration Service (DMS)","dateCreated":"2020-03-02T07:02:30+0000","dateUpdated":"2022-02-03T03:32:27+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#korean-broadcasting-system-case-study","locale":"en_US","directoryId":"customer-references","name":"korean-broadcasting-system-case-study","dateCreated":"2019-07-19T14:56:37+0000","dateUpdated":"2022-12-22T17:42:25+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, Korean Broadcasting System (KBS) scales to meet surges in demand for media content, completes jobs with just a few clicks, and saves 50 percent on event services. KBS is a public broadcasting station that broadcasts many types of programs in Korea and other parts of the world.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/KBS_Customer-Reference_Logo.7e85766e364eecf951767d92685fbdf0dfda499a.png","displayLocation":"Korea","footerInfoText":"Published Date","description":"\u003cp\u003eKBS is a public broadcasting station that broadcasts many types of programs in Korea and other parts of the world. KBS is the first broadcasting station that successfully migrated all of its customer service to AWS Cloud, and it has closed the previous data center. AWS has migrated the ones that were previously done by the equipment by using AWS Elemental MediaLive and AWS Elemental MediaConvert.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/kbs/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Korean Broadcasting System","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Korean Broadcasting System Case Study"}},"tags":[{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterp