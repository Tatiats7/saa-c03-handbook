id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#database-migration-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Database Migration Service (DMS)","description":"AWS Database Migration Service (DMS)","dateCreated":"2020-03-02T07:02:30+0000","dateUpdated":"2022-02-03T03:32:27+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"}]},{"item":{"id":"customer-references#ubisoft-case-study","locale":"en_US","directoryId":"customer-references","name":"ubisoft-case-study","dateCreated":"2025-04-17T22:59:57+0000","dateUpdated":"2025-04-17T23:01:43+0000","additionalFields":{"descriptionSummary":"With almost no downtime or impact on players, Ubisoft migrated its large Challenge Services database to Amazon DynamoDB, increasing scalability while cutting database costs by 90 percent.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Ubisoft_Customer-Reference_Logo.2f069cebbe9b4bdd0dfff2478af0e53d032dd50c.png","displayLocation":"France","customerNameLower":"ubisoft","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2024-11-14","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ubisoft-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ubisoft","publishedDate":"2024","enableShare":"1","headline":"Ubisoft’s Online Services Team Reduced Database Costs by 90% Using Amazon DynamoDB","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#database-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Database Migration","description":"Database Migration","dateCreated":"2019-07-22T18:31:40+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#use-case#general-database-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"General Database Migration","description":"General Database Migration","dateCreated":"2020-06-05T06:37:24+0000","dateUpdated":"2022-02-03T03:35:41+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:2