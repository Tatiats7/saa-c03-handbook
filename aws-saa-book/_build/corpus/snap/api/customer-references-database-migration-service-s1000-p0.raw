escription":"AWS CodeBuild","dateCreated":"2020-03-02T07:02:08+0000","dateUpdated":"2022-02-03T03:32:24+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#sbi-sumishin-net-bank","locale":"en_US","directoryId":"customer-references","name":"sbi-sumishin-net-bank","dateCreated":"2020-11-12T18:44:32+0000","dateUpdated":"2021-12-22T22:42:08+0000","additionalFields":{"featured":"0","descriptionSummary":"SSNB migrated its internet banking system database from Oracle Database to Amazon Aurora PostgreSQL, projecting cost savings of 80% over 5 years, and migrated its call center to Amazon Connect.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/ssnb-logo@1x.d9afdf2ab76bcb6639fae778a5b00df8428b08bc.png","displayLocation":"Japan","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2020-11-12","headlineUrl":"https://aws.amazon.com/solutions/case-studies/sbi-sumishin-net-bank/?did\u003dcr_card\u0026trk\u003dcr_card"