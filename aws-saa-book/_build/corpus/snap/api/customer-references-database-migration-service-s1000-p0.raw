+0000","dateUpdated":"2022-02-03T03:32:30+0000"}]},{"item":{"id":"customer-references#bridestory-case-study","locale":"en_US","directoryId":"customer-references","name":"bridestory-case-study","dateCreated":"2020-05-12T19:09:54+0000","dateUpdated":"2021-12-22T22:37:40+0000","additionalFields":{"descriptionSummary":"By decoupling its monolithic architecture to containers on the AWS Cloud, Bridestory reduced deployment time from three weeks to one day and achieved a failure rate of just one percent. Bridestory is an Indonesia-based web and mobile application that provides brides with wedding inspirations and links to potential vendors.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/bridestory@1x.ae83d0c2fe6e6e1430d5529ff1d504b321956d98.jpg","displayLocation":"Asia Pacific","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/bridestory/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Bridestory Uses Containers on AWS to Improve Agility","customer-name":"Bridestory.com"}},"tags":[{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:43+0000","dateUpdated":"2022-02-03T03:36:00+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US",