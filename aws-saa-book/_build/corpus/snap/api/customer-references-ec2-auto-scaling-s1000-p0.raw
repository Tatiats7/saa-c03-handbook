the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#creative-assembly-case-study","locale":"en_US","directoryId":"customer-references","name":"creative-assembly-case-study","dateCreated":"2022-06-10T21:40:11+0000","dateUpdated":"2022-06-10T21:41:02+0000","additionalFields":{"descriptionSummary":"Gaming company CA has developed multiplayer modes for Total War: WARHAMMER III and launched eight new live games by going all in on AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/creative-assembly-logo%401x.049e6b6259fdaa51c4b101b2dfc622e3c2dfd82d.png","displayLocation":"United Kingdom","customerNameLower":"creative assembly","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2022-06-10","headlineUrl":"https://aws.amazon.com/solutions/case-studies/creative-assembly-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Creative Assembly","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Creative Assembly Supports Players While Launching Total War: WARHAMMER III on AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-0