stomer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#ec2-auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Auto Scaling","description":"Amazon EC2 Auto Scaling","dateCreated":"2020-03-02T07:02:53+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#btobet-case-study","locale":"en_US","directoryId":"customer-references","name":"btobet-case-study","dateCreated":"2022-10-03T18:33:44+0000","dateUpdated":"2022-10-11T21:03:06+0000","additionalFields":{"descriptionSummary":"Betting on sporting events from the Olympics to Premier League soccer matches is a billion-dollar market characterized by surges in customer demand around live events. BtoBet provides betting and gambling businesses with its sportsbook solution, allowing individuals to place bets on sporting events. Since migrating to AWS, BtoBet can scale compute resources to handle spikes in demand and deliver a responsive experience for its partners and their players. It has also launched in new global markets and has the resources to support triple-digit customer growth. Using AWS, the company can manage double the volume of betting transactions without expanding its IT team.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/btobet-logo%401x.4df0a2219e8e635f58051432a3203b73a47807fd.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"btobet","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/BtoBet-Case-Study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"BtoBet","publishedDate":"2022","enableShare":"1","headline":"BtoBet Processes Trillions of Betting Requests, Boosts Customer Loyalty Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#locati