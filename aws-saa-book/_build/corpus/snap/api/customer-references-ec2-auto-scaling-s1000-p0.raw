teCreated":"2019-07-22T18:31:40+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#fucn-ec2","locale":"en_US","directoryId":"customer-references","name":"fucn-ec2","dateCreated":"2023-06-01T23:08:27+0000","dateUpdated":"2023-07-14T23:32:25+0000","additionalFields":{"descriptionSummary":"La Fundación Universitaria Católica del Norte es pionera y líder en educación virtual en Colombia. Hace alrededor de dos años, la institución inició una estrategia de automatización y transformación digital liderada por el sacerdote Rector Diego Luis Rendón Urrea y el CTO Ingeniero Yovany Álvarez Correa. De esa manera, se apropió de la gestión tecnológica e impulsó la innovación en sus procesos. Resultó que la transformación le ha permitido no sólo avanzar en temas de innovación y enseñanza, sino que también estar preparada para enfrentar la pandemia de manera mucho más simple.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/catolicadelnorte_logo%401x.be6