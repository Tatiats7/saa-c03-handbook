ategory#developer-tools","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Developer Tools","description":"\u003cp\u003eHost code, build, test, and deploy your applications quickly and effectively with AWS developer tools. Leverage core tools like software development kits (SDKs), code editors, and continuous integration and delivery (CI/CD) services for DevOps software development. Use machine learning (ML) -guided best practices and abstractions to improve agility, security, velocity, and code quality.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:14:12+0000","dateUpdated":"2023-07-14T01:14:12+0000"}]},{"item":{"id":"customer-references#goepik","locale":"en_US","directoryId":"customer-references","name":"goepik","dateCreated":"2023-06-01T23:09:02+0000","dateUpdated":"2023-06-08T04:07:41+0000","additionalFields":{"descriptionSummary":"A GoEpik é uma startup que oferece uma plataforma de hiper-customização de processos permitindo a empresas e empreendedores criarem de maneira autônoma soluções para Indústria 4.0 e transformação digital.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/Latam%20Cases%20Assets/GoEpik_LOGO1.abca976be3d8a59eebe454dac1a3aaad7098dc73.jpg","displayLocation":"Brasil","footerInfoText":"Data de publicação","industry":"Serviços profissionais","sortDate":"2019-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/goepik/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2019","contentType":"História do cliente","customer-name":"GoEpik","headline":"Estudo de caso AWS: GoEpik"}},"tags":[{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#prof-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Professional Services","description":"Professional Services","da