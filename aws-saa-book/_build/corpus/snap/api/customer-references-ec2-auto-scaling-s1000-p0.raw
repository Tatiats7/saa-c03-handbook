English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#hospital-sirio-libanes-case-study","locale":"en_US","directoryId":"customer-references","name":"hospital-sirio-libanes-case-study","dateCreated":"2024-08-15T21:35:25+0000","dateUpdated":"2024-08-15T21:43:38+0000","additionalFields":{"descriptionSummary":"Encompassing an expansive area of approximately 1,076,391 square feet in the heart of São Paulo, Brazil, alongside a cutting-edge healthcare facility in Brasília, the Sírio-Libanês Hospital is a hub offering over 60 specialized medical fields and a capacity exceeding 500 hospital beds. Bridging a multidisciplinary clinical team with state-of-the-art technologies, the hospital has consistently achieved pioneering milestones.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/hospital-sirio-libanes%402x.d48972885f39f72ec6a6500927dc8dec85524046.png","displayLocation":"Brazil","customerNameLower":"hospital sírio libanes","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/hospital-sirio-libanes-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Hospital Sírio Libanes","publishedDate":"2023","enableShare":"1","headline":"Sírio-Libanês Hospital Revolutionizes its Cloud Financial Management in 5 Months","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#organizations","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Organizations","description":"AWS Organizations","dateCreated":"2020-03-02T07:04:43+0000","dateUpdated":"2022-02-0