Created":"2020-03-02T07:02:27+0000","dateUpdated":"2022-02-03T03:32:27+0000"},{"id":"GLOBAL#product#application-migration-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Application Migration Service","description":"AWS Application Migration Service","dateCreated":"2022-08-15T20:58:56+0000","dateUpdated":"2022-09-24T05:36:20+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#cloudsearch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudSearch","description":"Amazon CloudSearch","dateCreated":"2020-03-02T07:02:03+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#ses","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Email Service (SES)","description":"Amazon Simple Email Service (SES)","dateCreated":"2020-03-02T07:05:22+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#certificate-mgr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Certificate Manager","description":"AWS Certificate Manager","dateCreated":"2020-03-02T07:01:45+0000","dateUpdated":"2022-02-03T03:32:20+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"}]},{"item":{"id":"customer-references#unimed-case-storage","locale":"en_US","directoryId":"customer-references","name":"unimed-case-storage","dateCreated":"2023-06-01T23:04:44+0000","dateUpdated":"2023-07-12T01:35:23+0000","additionalFields":{"descriptionSummary":"Com mais de 5 mil médicos cooperados e mais de 1,48 milhão de clientes em 34 municípios mineiros, em 2018, a Unimed BH iniciou a construção de um ambiente em nuvem flexível, seguro e capaz de trabalhar com informação em tempo real.Cynthia Araujo, gerente de desenvolvimento de informação para o negócio da Unimed BH, explica que a cooperativa escolheu trabalhar com a AWS não apenas pela inovação dos serviços oferecidos, mas também pela postura de parceria demonstrada pela companhia. A especialista conta que a instituição começou usando Amazon Simple Storage Service (Amazon S3) e depois evoluiu para produtos como Amazon SageMaker, automatizando cerca de 35% das autorizações médicas e ganhando capacidade de trabalhar dados para oferecer cuidado integrado aos clientes e apoiar programas de atenção à saúde do idoso e gestante.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/Latam%20Cases%20Assets/Unimed_BH_LOGO1.f2aa4f715aaf597e713ba3ef1bc9d24f76ca7ab7.jpg","displayLocation":"Brasil","customerNameLower":"unimed bh","footerInfoText":"Data de publicação","industry":"Saúde","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/unimed-case-storage/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Unimed BH","enableShare":"1","publishedDate":"2023","contentType":"História do cliente","headline":"Com AWS, Unimed BH reduz para 1,5 minuto as respostas de autorizações médicas"}},"tags":[{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#glacier","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon S3 Glacier","description":"Amazon S3 Glacier","dateCreated":"2020-03-02T07:03:38+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#c