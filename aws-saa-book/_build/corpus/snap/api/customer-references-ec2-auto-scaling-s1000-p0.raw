43:13+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#ec2-spot-instances","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Spot Instances","description":"Amazon EC2 Spot Instances","dateCreated":"2022-04-26T06:27:16+0000","dateUpdated":"2022-04-26T06:27:16+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#jotabasso","locale":"en_US","directoryId":"customer-references","name":"jotabasso","dateCreated":"2023-06-01T23:04:29+0000","dateUpdated":"2023-06-08T04:07:49+0000","additionalFields":{"descriptionSummary":"A Jotabasso é uma empresa brasileira de sementes e agricultura com sede no Cerrado, que é uma ecorregião de savana tropical que se estende por grande parte do Brasil central e se tornou popular para atividades agrícolas no final dos anos 1990 e início dos anos 2000. A empresa também trabalha com diversos setores de diferentes operações agrícolas.\n\nA Jotabasso se originou no Rio Grande do Sul antes de se mudar para a região do Cerrado na década de 1970. Foi uma das primeiras empresas de sementes daquela região e hoje tem mais de 900 funcionários, com cinco unidades de produção nas áreas centrais do Brasil.\n\nHoje, a empresa é especializada no plantio de soja e outros grãos, como trigo, milho e sorgo, que são usados principalmente como ração animal. A Jotabasso também se aventurou na criação de gado de corte. A organização opera grandes laboratórios de análise de sementes e instalações de armazenamento e criou um sistema integrado de lavoura-pecuária e confinamento para ajudar os agricultores a aumentar a produtividade e a sustentabilidade.\n\nPara manter e expandir todas as suas atividades com maior eficiência, a Jotabasso decidiu procurar um provedor de nuvem que pudesse hospedar seus dados e ajudar a empresa a criar soluções tecnológicas inovadoras para suas operações e usuários.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/jotabasso-logo%402x.e706d28cc6c94d999729b54b3f38986197427921.png","displayLocation":"Brasil","customerNameLower":"jotabasso","footerInfoText":"Data de publicação","industry":"Varejo","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/jotabasso/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Jotabasso","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"Modernizando a agricultura em grande escala com a nuvem AWS"}},"tags":[{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"20