dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"}]},{"item":{"id":"customer-references#ipschile","locale":"en_US","directoryId":"customer-references","name":"ipschile","dateCreated":"2023-06-01T23:06:11+0000","dateUpdated":"2023-06-08T04:07:40+0000","additionalFields":{"descriptionSummary":"El Instituto de Previsión Social (IPS) es la institución responsable de acercar diversos beneficios previsionales y sociales a las personas. En enero pasado, tras la aprobación de la Pensión Garantizada Universal (PGU), tuvo que poner en marcha un rápido proceso de habilitación de la plataforma digital para soportar un proceso de carga masiva de consultas en forma simultánea -lo que abarcaría a cerca de 2 millones de personas- además de estar disponible para recibir solicitudes del beneficio. La tecnología en la nube de AWS fue clave para que en solo seis días esta plataforma quedara a disposición de la ciudadanía, para atender las solicitudes de los usuarios que aumentaron en casi un 900%.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/ips_logo%401x.cc9bc8f32c0a286472544da6c45cae82b196a35a.png","displayLocation":"Chile","customerNameLower":"ips","footerInfoText":"Fecha de publicación","industry":"Servicios públicos generales","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/ipschile/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"IPS","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"IPS utiliza tecnología en la nube para implementar la Pensión Garantizada Universal y llevar mejores servicios a 2 millones de chilenos"}},"tags":[{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"customer-references#customer-segment#public-sector-govt","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Government","description":"Government","dateCreated":"2019-07-22T18:39:47+0000","dateUpdated":"2022-03-19T00:18:44+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-refere