000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#product#ec2-auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Auto Scaling","description":"Amazon EC2 Auto Scaling","dateCreated":"2020-03-02T07:02:53+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#location#indonesia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Indonesia","description":"Indonesia","dateCreated":"2020-02-03T05:29:22+0000","dateUpdated":"2022-02-03T03:31:36+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#confeorg","locale":"en_US","directoryId":"customer-references","name":"confeorg","dateCreated":"2023-06-01T23:11:31+0000","dateUpdated":"2023-07-14T23:32:26+0000","additionalFields":{"descriptionSummary":"La Confederación Nacional de Organismos de Apoyo al Tránsito (CONFEORG) es una entidad sin ánimo de lucro que agremia y representa a los organismos de apoyo a las autoridades de tránsito; empresas que prestan servicios relacionados con el tránsito en Colombia como: exámenes de aptitud médica y psicométrica, cursos de enseñanza automovilística para aspirantes a conducir vehículos, revisiones técnico-mecánicas y de emisiones contaminantes de vehículos, y cursos sobre normas de tránsito para infractores. Con la ayuda de AWS y su partner IKTINUS, lograron lanzar la aplicación en tiempo récord y cumplieron con todos los requisitos exigidos por la Superintendencia de Industria y Comercio (SIC), entre ellos, tener una disponibilidad del 98.5%.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/confeorg-logo%402x.479e4b1f2e7e0e6e7b083ea42625f1a5a3b5ff58.png","displayLocation":"Colombia","footerInfoText":"Fecha de publicación","i