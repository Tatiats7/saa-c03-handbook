gs, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#infor-innovator","locale":"en_US","directoryId":"customer-references","name":"infor-innovator","dateCreated":"2020-07-27T20:20:30+0000","dateUpdated":"2024-06-26T18:58:55+0000","additionalFields":{"featured":"0","descriptionSummary":"Infor uses AWS to help more than 73,000 customers in more than 200 countries and territories improve operations, drive growth, and quickly adapt to changes in business demands.","featureImageURL":"https://d1.awsstatic.com/infor_option_1.6891017c3784e4e0a8dcab779984f648dab0b066.png","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Infor_Customer-Reference_Logo.e38229a2c8481a14fdcf67d002b2a25379808c7a.png","displayLocation":"North America","footerInfoText":"Published Date","description":"\u003cp\u003eDelivering secure, scalable, innovative, and compliant solutions\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u0026nbsp;\u003c/p\u003e\n","industry":"Professional Services","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/innovators/infor/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Infor","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Infor on AWS"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","local