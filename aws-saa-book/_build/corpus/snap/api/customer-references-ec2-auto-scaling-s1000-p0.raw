ed Date","industry":"Software \u0026 Internet","sortDate":"2022-10-06","headlineUrl":"https://aws.amazon.com/solutions/case-studies/itom-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"i-Tom Solutions","publishedDate":"2022","enableShare":"1","headline":"iTom Boosts Business and Scales for Growth Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#documentdb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DocumentDB","description":"Amazon DocumentDB","dateCreated":"2020-03-02T07:02:46+0000","dateUpdated":"2022-02-03T03:32:30+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#secrets-mgr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Secrets Manager","description":"AWS Secrets Manager","dateCreated":"2020-03-02T07:05:14+0000","dateUpdated":"2022-02-03T03:32:59+0000"},{"id":"GLOBAL#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Mid-Market Territory (MMT)","description":"Mid-Market Territory (MMT)","dateCreated":"2021-06-04T06:35:43+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","descrip