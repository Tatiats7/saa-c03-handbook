y be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#springventuregroup-marketplace11","locale":"en_US","directoryId":"customer-references","name":"springventuregroup-marketplace11","dateCreated":"2021-01-05T00:59:46+0000","dateUpdated":"2023-07-14T23:32:30+0000","additionalFields":{"featured":"0","descriptionSummary":"Spring Venture Group, a US direct-to-consumer brokerage of Medicare insurance services, uses AWS Service Catalog to ensure fast server provisioning that complies with Amazon HIPAA BAA.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Spring_Venture_Group_logo%401x.4eafa44812d6146696b7ce57397243fb841aa55d.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Consumer Packaged Goods (CPG)","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/SpringVentureGroup-marketplace11/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Spring Venture Group","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"AWS Helps Spring Venture Group Grow and Stay Compliant"}},"tags":[{"id":"GLOBAL#industry#cpg","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Consumer Packaged Goods (CPG)","description":"Consumer Packaged Goods (CPG)","dateCreated":"2020-06-25T04:03:18+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBA