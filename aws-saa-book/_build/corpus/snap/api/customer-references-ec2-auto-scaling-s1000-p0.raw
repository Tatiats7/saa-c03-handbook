"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#agesic-msp","locale":"en_US","directoryId":"customer-references","name":"agesic-msp","dateCreated":"2023-06-01T23:10:00+0000","dateUpdated":"2023-06-08T04:07:35+0000","additionalFields":{"descriptionSummary":"El Ministerio de Salud Pública (MSP) de Uruguay junto con la Agencia de Gobierno Electrónico y Sociedad de la Información y del Conocimiento (Agesic), el programa Salud.uy y otros proveedores de tecnología han desarrollado un nuevo sistema de solicitud de agenda para la campaña de vacunas contra el Covid-19 utilizando servicios en la nube de Amazon Web Services. El sistema fue puesto en producción en dos días y actualmente permite que toda la población adulta pueda solicitar agenda y obtener día y hora para vacunarse.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/agesic_logo%401x.27ca0f22b73e8f229ca105cf70a8c4b05140810d.png","displayLocation":"Uruguay","footerInfoText":"Fecha de publicación","industry":"Servicios públicos generales","sor