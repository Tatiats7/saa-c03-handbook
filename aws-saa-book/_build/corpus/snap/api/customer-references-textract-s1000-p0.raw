"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#use-case#datacenter-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2020-08-18T05:17:48+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"}]},{"item":{"id":"customer-references#iihm-workmates-2025","locale":"en_US","directoryId":"customer-references","name":"iihm-workmates-2025","dateCreated":"2025-02-19T00:17:45+0000","dateUpdated":"2025-03-06T23:45:03+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eThe Indian Institute of Hotel Management (IIHM) specializes in hospitality education that offers high-quality training and effective placement solutions. Based in India, the institute worked with AWS Partner Workmates to implement an AWS generative AI solution based on Amazon Bedrock. As a result, IIHM is seeing 50 percent faster interviews, 90 percent hiring accuracy, and a 20\u0026ndash;30 percent higher rate of student job placements. In addition, surveys show that IIHM has created a more engaging learning environment, with 75 percent of educators and students now feeling more secure interacting with AI-generated content.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/IIHM%20Logo%20200x70px.09a730e2cfc6396e280b03a830144ff966b4f31e.png","displayLocation":"India","footerInfoText":"2025","industry":"Education","sortDate":"2025-02-18","headlineUrl":"https://aws.amazon.com/solutions/case-studies/iihm-workmates/","customer-name":"Indian Institute of Hotel Management","enableShare":"1","publishedDate":"2025","contentType":"Case Study","headline":"Indian Institute of Hotel Management Streamlines Hospitality Recruitment and Enhances Education with AWS AI-Driven Innovations"}},"tags":[{"id":"GLOBAL#product#key-mgmt-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Key Management Service (KMS)","description":"AWS Key Management Service (KMS)","dateCreated":"2020-03-02T07:04:13+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#transcribe","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Transcribe","description":"Amazon Transcribe","dateCreated":"2020-03-02T07:05:51+0000","dateUpdated":"2022-02-03T03:33:04+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#bedrock","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Bedrock","description":"Amazon Bedrock","dateCreated":"2023-04-13T19:06:46+0000","dateUpdated":"2023-04-13T19:06:46+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#product#auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Auto Scaling","description":"AWS Auto Scaling","dateCreated":"2020-03-02T07:01:39+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#textract","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Textract","description":"Amazon Textract","dateCreated":"2020-03-02T07:05:47+0000","dateUpdated":"2022-02-03T03:33:04+0000"}]},{"item":{"id":"customer-references#contra-costa-county-district-attorney-scalecapacity-2025","locale":"en_US","directoryId":"customer-references","name":"contra-costa-county-district-attorney-scalecapacity-2025","dateCreated":"2025-02-14T21:30:17+0000","dateUpdated":"2025-03-06T23:42:09+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eThe Contra Costa County District Attorney\u0026#39;s Office works to prevent crime, seek justice, and enhance public safety for the residents of Contra Costa County, California. The office needed to create a new solution to automate sensitive data redaction to comply with a new state Race-Blind Charging mandate. To meet this requirement, the office worked with the AWS account team and AWS Partner ScaleCapacity to build an AI-driven Race-Blind Charging solution on AWS. With this solution, the District Attorney\u0026#39;s Office achieved compliance in six months, can now automatically redact sensitive data from case documents, and can thoroughly test and deploy any new redaction rule changes in less than a week.\u003cspan style\u003d\"display:none\"\u003e\u0026nbsp;\u003c/span\u003e\u003cspan style\u003d\"display:none\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Contra%20Costa%20County%2070x70px.5145886dbc12ce6761b8932e487bbb161b756712.png","displayLocation":"United States","footerInfoText":"2025","industry":"General Public Services","sortDate":"2025-02-14","headlineUrl":"https://aws.amazon.com/solutions/case-studies/contra-costa-county-district-attorney-scalecapacity/","customer-name":"Contra Costa County District Attorney\u0027s Office","enableShare":"1","publishedDate":"2025","contentType":"Case Study","headline":"Contra Costa County District Attorney\u0027s Office Makes Unbiased Charging Decisions with ScaleCapacity Generative AI Solution on AWS"}},"tags":[{"id":"GLOBAL#product#bedrock","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Bedrock","description":"Amazon Bedrock","dateCreated":"2023-04-13T19:06:46+0000","dateUpdated":"2023-04-13T19:06:46+0000"},{"id":"GLOBAL#product#ses","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Email Service (SES)","description":"Amazon Simple Email Service (SES)","dateCreated":"2020-03-02T07:05:22+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#textract","loc