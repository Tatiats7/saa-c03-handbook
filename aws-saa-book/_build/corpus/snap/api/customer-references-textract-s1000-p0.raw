#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#business-category#cust-engagement","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2020-06-05T07:06:46+0000","dateUpdated":"2022-02-03T03:31:03+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"}]},{"item":{"id":"customer-references#paytm-case-study","locale":"en_US","directoryId":"customer-references","name":"paytm-case-study","dateCreated":"2022-01-08T04:42:41+0000","dateUpdated":"2023-07-14T23:32:42+0000","additionalFields":{"descriptionSummary":"Paytm is one of India’s largest financial services companies, offering solutions ranging from payments, e-commerce, banking, and more, to serve the underbanked population and businesses in India. To keep pace with business growth and a rapidly increasing pool of users and customers, the company adopted Amazon Textract, which instantly and accurately extracts text and data from users’ identity document images. Amazon Textract helped Paytm eliminate manual data entry and cut KYC processing time from weeks to minutes.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Paytm_logo%401x.fe999fd5d0e5da9e07a45e1c3a1011bc1f791de5.png","displayLocation":"India","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-01-07","headlineUrl":"https://aws.amazon.com/solutions/case-studies/paytm-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","customer-name":"Paytm","contentType":"Customer Story","headline":"Paytm Achieves User Onboarding in Minutes Using Amazon Textract"}},"tags":[{"id":"GLOBAL#product#textract","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Textract","description":"Amazon Textract","dateCreated":"2020-03-02T07:05:47+0000","dateUpdated":"2022-02-03T03:33:04+0000"},{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"