#product","name":"Amazon AppStream 2.0","description":"Amazon AppStream 2.0","dateCreated":"2020-03-02T07:01:30+0000","dateUpdated":"2022-02-03T03:32:17+0000"},{"id":"GLOBAL#product#monitron","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Monitron","description":"Amazon Monitron","dateCreated":"2021-11-17T07:15:42+0000","dateUpdated":"2022-02-03T03:32:51+0000"},{"id":"GLOBAL#product#deep-learning-containers","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Deep Learning Containers","description":"AWS Deep Learning Containers","dateCreated":"2020-03-02T07:02:37+0000","dateUpdated":"2022-02-03T03:32:28+0000"},{"id":"GLOBAL#product#xray","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS X-Ray","description":"AWS X-Ray","dateCreated":"2020-03-03T00:18:27+0000","dateUpdated":"2022-02-03T03:33:08+0000"},{"id":"GLOBAL#product#migration-hub","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Migration Hub","description":"AWS Migration Hub","dateCreated":"2020-03-02T07:04:36+0000","dateUpdated":"2022-02-03T03:32:51+0000"},{"id":"GLOBAL#product#mgmt-console","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Management Console","description":"AWS Management Console","dateCreated":"2020-03-02T07:04:33+0000","dateUpdated":"2022-02-03T03:32:50+0000"},{"id":"GLOBAL#product#personalize","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Personalize","description":"Amazon Personalize","dateCreated":"2020-03-02T07:04:50+0000","dateUpdated":"2022-02-03T03:32:54+0000"},{"id":"GLOBAL#product#ivs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Interactive Video Service","description":"Amazon Interactive Video Service","dateCreated":"2020-11-20T00:43:24+0000","dateUpdated":"2022-02-03T03:32:44+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#writer-business-services","locale":"en_US","directoryId":"customer-references","name":"writer-business-services","dateCreated":"2021-05-14T18:55:26+0000","dateUpdated":"2021-12-22T20:25:28+0000","additionalFields":{"descriptionSummary":"By migrating its cash management application to AWS, Writer Safeguard has improved its ability to experiment with new technologies and scale instantly to respond to business demand. Writer Business Services provides cash management, information management, realty, and relocation services to corporate customers in India.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(@1x---@2x)/Writer_logo@1x.6e1eb5f63aad583a18a5d4c4667431439ee68b7b.png","displayLocation":"India","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/writer-business-services/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Writer Safeguard Achieves 99.999% Availability with Cash Management Solution on AWS","cus