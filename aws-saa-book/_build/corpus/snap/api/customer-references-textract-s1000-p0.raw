mespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#volkswagen-group-case-study","locale":"en_US","directoryId":"customer-references","name":"volkswagen-group-case-study","dateCreated":"2021-05-28T20:20:34+0000","dateUpdated":"2023-07-19T03:04:54+0000","additionalFields":{"featured":"0","descriptionSummary":"The Volkswagen Group reduces label defects during vehicle production by using an intelligent Sign Inspection (iSI) solution built on AWS. During vehicle production, workers must apply 25 different labels that contain country-specific safety, usability, and specification data to comply with various regulations. Using Volkswagen\u0027s Digital Production Platform, powered by AWS IoT and machine learning services, Porsche implemented an automated solution to detect label errors and notify in-line workers. Now Volkswagen has a modular, scalable iSI solution that it can implement at its automotive plants worldwide.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/volkswagen-group-logo@1x.b28acee85fe276a4231c3680afe59f7a1107bcd3.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2021-05-28","headlineUrl":"https://aws.amazon.com/solutions/case-studies/volkswagen-group-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Volkswagen Group","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Volkswagen Group Automates Sign Inspection Workflow Using AWS"}},"tags":[{"id":"GLOBAL#product#greengrass","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS IoT Greengrass","description":"AWS IoT Greengrass","dateCreated":"2020-03-02T07:03:43+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"customer-references#customer-segment#enterpris