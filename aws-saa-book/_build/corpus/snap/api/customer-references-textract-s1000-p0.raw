T17:07:31+0000"}]},{"item":{"id":"customer-references#friboi-darede-2024","locale":"en_US","directoryId":"customer-references","name":"friboi-darede-2024","dateCreated":"2025-01-22T00:17:24+0000","dateUpdated":"2025-03-06T17:54:22+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eParte do grupo JBS, a Friboi \u0026eacute; reconhecida por sua capacidade de inova\u0026ccedil;\u0026atilde;o e lideran\u0026ccedil;a no setor de carne bovina, com presen\u0026ccedil;a em mais de 150 pa\u0026iacute;ses. Com seu foco cada vez maior em sustentabilidade, a companhia contou com o suporte da AWS Partner, Darede, para o desenvolvimento de seu portal de OCR, que utiliza Machine Learning e IA generativa para reunir e analisar os documentos que comprovam o funcionamento de sua Cadeia de Fornecimento Sustent\u0026aacute;vel.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Friboi%20Logo%20200x70px.5def9f478525327a02112b546120052a3826ecaa.png","industry":"Manufacturing","sortDate":"2024-09-03","enableShare":"1","headlineUrl":"https://aws.amazon.com/pt/partners/success/friboi-darede/","publishedDate":"2024","contentType":"Case Study","headline":"Darede desenvolve o Portal OCR para a Friboi utilizando Machine Learning e IA generativa AWS"}},"tags":[{"id":"GLOBAL#product#bedrock","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Bedrock","description":"Amazon Bedrock","dateCreated":"2023-04-13T19:06:46+0000","dateUpdated":"2023-04-13T19:06:46+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id"