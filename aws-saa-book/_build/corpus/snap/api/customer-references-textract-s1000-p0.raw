{"items":[{"item":{"id":"customer-references#verisk-analytics-reinvent2024","locale":"en_US","directoryId":"customer-references","name":"verisk-analytics-reinvent2024","dateCreated":"2025-05-02T15:51:02+0000","dateUpdated":"2025-05-02T16:09:27+0000","additionalFields":{"descriptionSummary":"Discover how Verisk, a leading solutions provider in the insurance industry, accelerated innovation and reduced manual processes by over 90% by migrating and modernizing with AWS. In this video, Verisk shares how moving out of on-premises data centers, using services like Amazon Textract, and modernizing .NET applications with the AWS Application Modernization Lab (AML) helped them streamline operations, reduce costs, and unlock the power of generative AI.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/verisk-logo%401x.6bba2fe91dd451380ef71333ebb30bdfbf4a97e9.jpg","displayLocation":"United States","customerNameLower":"verisk analytics","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2025-04-11","headlineUrl":"https://www.youtube.com/watch?v\u003dT1dn-FaBmP8\u0026did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Verisk Analytics","publishedDate":"2025","enableShare":"1","headline":"Verisk Drives Insurance Innovation with Generative AI \u0026 .NET Modernization","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#business-category#cloud-cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-06-05T07:06:41+0000","dateUpdated":"2022-02-03T03:31:02+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-