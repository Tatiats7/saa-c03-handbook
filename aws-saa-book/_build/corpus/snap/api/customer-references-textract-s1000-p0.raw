tegory","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#italian","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Italian","description":"Italian","dateCreated":"2020-03-03T06:40:49+0000","dateUpdated":"2022-02-03T03:31:25+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#kendra","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kendra","description":"Amazon Kendra","dateCreated":"2020-12-08T20:12:42+0000","dateUpdated":"2022-02-03T03:32:44+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"}]},{"item":{"id":"customer-references#jump","locale":"en_US","directoryId":"customer-references","name":"jump","dateCreated":"2023-07-17T23:44:59+0000","dateUpdated":"2023-08-11T22:26:57+0000","additionalFields":{"videoSrcUrl":"https://www.youtube.com/watch?v\u003d6Uq9Qvtzitw","descriptionSummary":"\u003cp\u003eJump facilite le quotidien des personnes souhaitant devenir freelances en leur proposant de les embaucher en CDI - tout en restant leur propre patron sans avoir \u0026agrave; g\u0026eacute;rer le volet administratif. Sebastian CACERES, CTO chez Jump, partage l\u0026rsquo;ambition de multiplier par 5 le nombre de salari\u0026eacute;s freelances d\u0026rsquo;ici fin 2022. Sa probl\u0026eacute;matique principale : rester proche des clients en proposant une disponibilit\u0026eacute; en continue et une structure pour ses utilisateurs. Le Cloud AWS a su fournir les fonctionnalit\u0026eacute;s permettant \u0026agrave; Jump de r\u0026eacute;pondre \u0026agrave; ses besoins de haute disponibilit\u0026eacute;, flexibilit\u0026eacute;, scalabilit\u0026eacute; et de s\u0026eacute;curit\u0026eacute; pour un investissement moindre en amont. Le passage au cloud a eu pour effet d\u0026rsquo;offrir plus d\u0026rsquo;agilit\u0026eacute; \u0026agrave; Jump en leur permettant de faire du test and learn gr\u0026acirc;ce aux diff\u0026eacute;rentes fonctionnalit\u0026eacute;s et services propos\u0026eacute;s. Jump souhaite aller plus loin et s\u0026rsquo;int\u0026eacute;resse aujourd\u0026rsquo;hui \u0026agrave; l\u0026rsquo;architecture bas\u0026eacute;e sur des \u0026eacute;v\u0026eacute;nements, la scalabilit\u0026eacute; et les services \u0026agrave; l\u0026rsquo;\u0026eacute;chelle mondiale.\u003c/p\u003e\r\n","featured":"0","featureImageURL":"https://i.ytimg.com/vi/6Uq9Qvtzitw/maxresdefault.jpg","imageSrcUrl":"https://d1.awsstatic.com/%c3%89tude%20de%20cas%20AWS%20%20Jump.ba964f2b5a82506027f093a6dd39620de314eb70.jpg","displayLocation":"France","customerNameLower":"jump","footerInfoText":"Date de publication","industry":"Services professionnels","sortDate":"2022-06-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/jump/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Jump","enableShare":"1","publishedDate":"2022","contentType":"Témoignages clients","headline":"Jump : Une solution innovante pour les freelances en recherche d’une proximité client toujours plus forte"}},"tags":[{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#product#lightsail","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Lightsail","description":"Amazon Lightsail","dateCreated":"2020-03-02T07:04:25+0000","dateUpdated":"2022-02-03T03:32:47+0000"},{"id":"GLOBAL#product#gamelift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon GameLift","description":"Amazon GameLift","dateCreated":"2020-03-02T07:03:36+0000"