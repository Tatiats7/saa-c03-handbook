-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#business-category#cust-engagement","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2020-06-05T07:06:46+0000","dateUpdated":"2022-02-03T03:31:03+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"}]},{"item":{"id":"customer-references#banco-inter-awsmarketplace","locale":"en_US","directoryId":"customer-references","name":"banco-inter-awsmarketplace","dateCreated":"2021-11-06T04:55:42+0000","dateUpdated":"2023-06-08T04:07:45+0000","additionalFields":{"descriptionSummary":"A fintech Banco Inter S.A. (Inter) precisava avaliar sua pilha de tecnologia para atender às demandas de consumo após expandir sua base de clientes de 400 mil para 15 milhões de clientes em apenas 3 anos. Para concretizar isso, a empresa precisava agregar e avaliar dados em tempo real para conseguir lançar mais produtos e serviços, além de aprimorar a satisfação do cliente. Com base na solidez dos resultados anteriores, o Inter recorreu à Amazon Web Services (AWS) para ajustar cada detalhe de seu aplicativo e avaliar sua pilha de tecnologia. O Inter conseguiu ampliar sua visibilidade usando o software disponível no AWS Marketplace, um catálogo digital com milhares de ofertas de fornecedores independentes de software que deixam mais simples encontrar, testar, comprar e implantar software executado na AWS.","imageSrcUrl":"https://d1.awsstatic.com/banco%20inter%20600x400.58949e9f03b716448bac1229b382e32534cd700c.png","displayLocation":"Brasil","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/Banco-Inter-AWSMarketplace/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","customer-name":"Banco Inter","contentType":"História do cliente","headline":"Inter expande serviços de fintech e atende a 15 milhões de clientes na AWS"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"G