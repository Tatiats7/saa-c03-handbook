s services such as Corezoid Process Engine from the Amazon Marketplace to accelerate provisioning and innovation.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/SpaceBank_Customer-References_Logo@1x.a8568c8d156b28159bc0e634f66f88918fc63aff.png","displayLocation":"Georgia","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/space-neobank-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Space Neobank","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"TBC Launches Space Neobank in 8 Months Using AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#georgia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Georgia","description":"Georgia","dateCreated":"2020-04-09T03:36:46+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#rekognition","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Rekognition","description":"Amazon Rekognition","dateCreated":"2020-03-02T07:05:04+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Servic