 AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#suprdaily-case-study","locale":"en_US","directoryId":"customer-references","name":"suprdaily-case-study","dateCreated":"2022-07-09T00:37:49+0000","dateUpdated":"2023-07-12T01:35:37+0000","additionalFields":{"descriptionSummary":"Supr Daily, a subsidiary of Swiggy, used machine learning on AWS to accelerate image recognition and enhance inventory forecasting while scaling seamlessly with little overhead to meet higher demand.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Supr-Daily_Logo%401x.78a6ab74c829e0600870d401a343a8879379ceb9.png","displayLocation":"India","customerNameLower":"supr daily","footerInfoText":"Published Date","industry":"Hospitality","sortDate":"2022-07-08","headlineUrl":"https://aws.amazon.com/solutions/case-studies/suprdaily-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Supr Daily","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Supr Daily Improves Partner and Customer Experiences Using Machine Learning on AWS"}},"tags":[{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","da