ms linear and passive videos into smart videos. Its artificial intelligence understands the content of a video and enriches it with metadata.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Synchronized_Customer-Reference_Logo@1x.0f38cb6b174393d7012e9c0869a453e7e144a3ee.png","displayLocation":"France","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/customer-references-tf1-synchronized/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Synchronized and TF1 use AWS Rekognition to automate thumbnail creation for more than  500 hours of programmes","customer-name":"Synchronized"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#loca