S","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#category#mobile","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Mobile","description":"Mobile","dateCreated":"2019-07-22T18:32:14+0000","dateUpdated":"2022-03-24T02:42:27+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"}]},{"item":{"id":"customer-references#icmec-case-study","locale":"en_US","directoryId":"customer-references","name":"icmec-case-study","dateCreated":"2019-07-19T14:58:10+0000","dateUpdated":"2022-01-21T02:44:51+0000","additionalFields":{"featured":"0","descriptionSummary":"By moving to the AWS Cloud, the International Centre for Missing \u0026 Exploited Children (ICMEC) reduced the costs of maintenance and pushed its IT teams to be more creative. ICMEC\u0026#39;s mission is to eradicate child abduction, sexual abuse, and exploitation.","imageSrcUrl":"https://d1.awsstatic.com/WWPS/images/ICMEC_logo.b1a0341dcea0f09958bd3d80c050306875e3816c.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eBy moving to the AWS Cloud, the International Centre for Missing \u0026amp; Exploited Children (ICMEC) reduced the costs of maintenance and pushed its IT teams to be more creative. ICMEC\u0026#39;s mission is to eradicate child abduction, sexual abuse, and exploitation. ICMEC created the GMCNgine, a centralized platform that uses artificial intelligence, machine learning, and Amazon Rekognition to scour the internet for photos of children to compare against images from ongoing cases of missing children from across the globe. The results provide law enforcement and NGOs with leads on the possible whereabouts of missing children.\u003c/p\u003e\r\n","industry":"Nonprofit","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/icmec/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ICMEC","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"ICMEC Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#public-sector-nonprofit","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Nonprofit","description":"Nonprofit","dateCreated":"2019-07-22T18:39:49+0000","dateUpdated":"2022-05-09T21:31:14+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#rekognition","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Rekognition","description":"Amazon Rekognition","dateCreated":"2020-03-02T07:05:04+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","loca