tion":"Customer Engagement","dateCreated":"2020-06-05T07:06:46+0000","dateUpdated":"2022-02-03T03:31:03+0000"},{"id":"customer-references#category#blockchain","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Blockchain","description":"Blockchain","dateCreated":"2019-07-22T18:31:06+0000","dateUpdated":"2022-06-07T17:22:39+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#pbs-rekognition-case-study","locale":"en_US","directoryId":"customer-references","name":"pbs-rekognition-case-study","dateCreated":"2022-10-18T21:00:21+0000","dateUpdated":"2023-07-19T03:04:58+0000","additionalFields":{"descriptionSummary":"Public Broadcasting Service (PBS) shares how it is using Machine Learning and AI on AWS to streamline media content operations by creating an enterprise knowledge graph to gather granular moment, segment, or even frame level metadata on attributes including facial object and mood recognitio