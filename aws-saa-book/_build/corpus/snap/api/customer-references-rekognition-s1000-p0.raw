ionalFields":{"featured":"0","descriptionSummary":"ingatlan.com reduces the cost of analyzing 20,000–30,000 photos a day by 60 percent using AWS. ingatlan.com is an online property listings marketplace in Hungary. The company uses Amazon Rekognition and its DetectText feature to ensure that photos comply with its terms of service.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Ingatlan_Customer-Reference_Logo.115c43f9221ded3fdf985e34fb6e6471db4776aa.png","displayLocation":"Hungary","footerInfoText":"Published Date","industry":"Construction \u0026 Real Estate","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ingatlan-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ingatlan.com","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"ingatlan.com Improves Customer Experience for Uploading Photos Using AWS Machine Learning"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#hungary","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Hungary","description":"Hungary","dateCreated":"2020-03-10T05:14:32+0000","dateUpdated":"2022-02-03T03:31:43+0000"},{"id":"GLOBAL#location#cee","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central \u0026 Eastern Europe","description":"Central \u0026 Eastern Europe","dateCreated":"2020-03-10T05:12:39+0000","dateUpdated":"2022-02-03T03:31:41+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#construction-real-estate","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Construction \u0026 Real E