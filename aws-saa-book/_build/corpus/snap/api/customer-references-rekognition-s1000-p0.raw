)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aella-credit-case-study","locale":"en_US","directoryId":"customer-references","name":"aella-credit-case-study","dateCreated":"2019-07-19T15:11:42+0000","dateUpdated":"2023-07-14T23:32:46+0000","additionalFields":{"featured":"0","descriptionSummary":"Aella Credit gains a competitive edge, improves identity verification, and grows from 5,000 to 200,000 customers in several months. The organization provides access to credit to customers across Nigeria through an online loan-processing platform.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/AellaCredit_Customer-Reference_Logo.146da430f6730359382d0ace3428213262d2795c.png","displayLocation":"Nigeria","footerInfoText":"Published Date","description":"\u003cp\u003eAella Credit gains a competitive edge, improves identity verification, and grows from 5,000 to 200,000 customers in several months. The organization provides access to credit to customers across Nigeria through an online loan-processing platform. Aella Credit uses AWS to support its loan-processing software and takes advantage of Amazon Rekognition for identity verification.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/aellacredit/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Aella Credit","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Aella Credit Case Study"}},"tags":[{"id":"GLOBAL#location#middle-east-africa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East \u0026 Africa","description":"Middle East \u0026 Africa","dateCreated":"2020-02-03T05:30:19+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03