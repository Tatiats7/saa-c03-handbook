,"description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#ssa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Sub-Saharan Africa","description":"Sub-Saharan Africa","dateCreated":"2020-03-10T05:18:06+0000","dateUpdated":"2022-02-03T03:31:58+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#customer-enablement#skills-guild","locale":"en_US","tagNamespaceId":"customer-references#customer-enablement","name":"Skills Guild","description":"\u003cp\u003eTag created in response to this request: https://issues.amazon.com/CSDIR-298\u003c/p\u003e\n\n\u003cp\u003eAWS Skills Guild is a consultative engagement designed to inspire organization-wide cloud adoption and unlock innovation. It accelerates the cultural and technological shifts necessary for transformation by helping develop and launch a bespoke cloud enablement initiative using the AWS Skills Guild framework. Each engagement uses cloud excitement, skills application, and community development to layer formal education with hands-on training activities \u0026ndash; ultimately increasing cloud skill confidence and igniting a culture of continuous learning.\u003c/p\u003e\n","dateCreated":"2023-07-05T23:40:01+0000","dateUpdated":"2023-07-05T23:40:01+0000"}]},{"item":{"id":"customer-references#marinus-analytics-databases-case-study","locale":"en_US","directoryId":"customer-references","name":"marinus-analytics-databases-case-study","dateCreated":"2020-08-31T22:11:53+0000","dateUpdated":"2023-07-14T23:32:42+0000","additionalFields":{"featured":"0","descriptionSummary":"Marinus Analytics provides an optimal tool in the fight against human trafficking, called Traffic Jam, by generating actionable context and leads with the help of Amazon Neptune\u0027s managed graph database.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/marinus-logo@1x.7ee8fc4aaeef7fe21e0d4b28fbc01dfefe94cb52.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2020-08-31","headlineUrl":"https://aws.amazon.com/solutions/case-studies/marinus-analytics-databases-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"marinus analytics","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Marinus Analytics Equips Law Enforcement to Fight Human Trafficking with Amazon Neptune"}},"tags":[{"id":"GLOBAL#product#neptune","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Neptune","description":"Amazon Neptune","dateCreated":"2020-03-02T07:04:40+0000","dateUpdated":"2022-02-03T03:32:52+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":