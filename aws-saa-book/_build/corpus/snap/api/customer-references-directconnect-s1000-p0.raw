02-03T03:35:27+0000"},{"id":"GLOBAL#location#argentina","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Argentina","description":"Argentina","dateCreated":"2020-06-12T23:30:42+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notification Service (SNS)","dateCreated":"2020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"customer-references#innovator#mercado-libre","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Mercado Libre","description":"Mercado Libre","dateCreated":"2022-09-15T00:48:36+0000","dateUpdated":"2022-09-15T00:48:36+0000"}]},{"item":{"id":"customer-references#despegar2","locale":"en_US","directoryId":"customer-references","name":"despegar2","dateCreated":"2023-06-01T23:08:47+0000","dateUpdated":"2023-07-12T01:35:41+0000","additionalFields":{"descriptionSummary":"Hace dos años Despegar tenía su arquitectura consolidada y orientada a microservicios, cada uno de ellos con su propia base de datos. Como resultado, la compañía llegó a tener más de 120 Cassandras instaladas, más de 80 MySQL, 70 MongoDBs y más de 40 elasticsearch (Amazon ES). Con esa estructura, los analistas no podían analizar los datos de un solo lugar y racional. Así que Despegar eligió las soluciones de AWS como base para montar su estructura de data lake. Hoy la compañía logra transferir un montón de datos todas las noches de sus máquinas a las máquinas de AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/despegar_logo%401x.f06fcbe7cb92dd6b0c694618b96b151199270f96.png","displayLocation":"Argentina","footerInfoText":"Fecha de publicación","industry":"Viajes","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/despegar2/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","custo