irectory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#athenahealth-case-study","locale":"en_US","directoryId":"customer-references","name":"athenahealth-case-study","dateCreated":"2023-08-10T01:02:15+0000","dateUpdated":"2024-02-20T22:26:26+0000","additionalFields":{"descriptionSummary":"Healthcare technology company athenahealth Inc. built a centralized network security architecture on AWS, improving its resilience and monitoring capabilities for egress traffic.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/aetnahealth-logo%401x.593e93067605397f17ebe9c5233e6ab48cf3e43b.png","displayLocation":"United States","customerNameLower":"athenahealth","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2023-08-03","headlineUrl":"https://aws.amazon.com/solutions/case-studies/athenahealth-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"athenahealth","publishedDate":"2023","enableShare":"1","headline":"athenahealth Saves Inspection Costs Using AWS Security Services","contentType":"Customer Story"}},"tags":[{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"GLOBAL#product#cloudformation","loca