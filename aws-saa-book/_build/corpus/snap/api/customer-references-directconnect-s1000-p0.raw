00","dateUpdated":"2022-02-03T03:32:15+0000"},{"id":"GLOBAL#product#budgets","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Budgets","description":"AWS Budgets","dateCreated":"2020-03-02T07:01:44+0000","dateUpdated":"2022-02-03T03:32:19+0000"},{"id":"GLOBAL#product#sumerian","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Sumerian","description":"Amazon Sumerian","dateCreated":"2020-03-02T07:05:42+0000","dateUpdated":"2022-02-03T03:33:03+0000"},{"id":"GLOBAL#product#elemental-mediatailor","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental MediaTailor","description":"AWS Elemental MediaTailor","dateCreated":"2020-03-02T07:03:20+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#product#resilience-hub","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Resilience Hub","description":"AWS Resilience Hub","dateCreated":"2021-11-17T07:15:55+0000","dateUpdated":"2022-02-03T03:32:57+0000"},{"id":"GLOBAL#product#cloud9","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Cloud9","description":"AWS Cloud9","dateCreated":"2020-03-02T07:01:52+0000","dateUpdated":"2022-02-03T03:32:21+0000"},{"id":"GLOBAL#product#cloudtrail","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudTrail","description":"AWS CloudTrail","dateCreated":"2020-03-02T07:02:05+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#product#elasticache-redis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache for Redis","description":"Amazon ElastiCache for Redis","dateCreated":"2020-03-03T00:16:59+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#gsr05102022lknsefgnlkef","locale":"en_US","directoryId":"customer-references","name":"gsr05102022lknsefgnlkef","dateCreated":"2023-02-08T01:16:46+0000","dateUpdated":"2023-07-14T23:32:37+0000","additionalFields":{"descriptionSummary":"GSR provides liquidity by connecting to dozens of crypto exchanges around the world. One of the main requirements is fast and secure connectivity to these locations. GSR leverages multiple regions in the AWS Global Infrastructure for physical proximity to exchanges. For the connectivity, GSR uses AWS PrivateLink or AWS Private Connect. GSR also replicates the data across AWS regions using various technologies, including Aurora Global Databases.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/gsr-logo%401x.6a641e2628cd35423810cceeda38e9a8c31f002b.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"gsr zug gmbh","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-05-10","headlineUrl":"https://youtu.be/U1P8vZTEB-k?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"GSR Zug GmbH","publishedDate":"2022","enableShare":"1","headline":"GSR: A Crypto Market Maker and Ecosystem Partner","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#batch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Batch","description":"AWS Batch","dateCreated":"2020-03-02T07:01:42+0000","dateUpdated":"2022-02-03T03:32:19+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#directconnect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Direct Connect","description":"AWS Direct Connect","dateCreated":"2020-03-02T07:02:43+0000","dateUpdated":"2022-02-03T03:32:30+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#efs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic File System (EFS)","description":"Amazon Elastic File System (EFS)","dateCreated":"2020-03-02T07:02:57+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#category#network","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2019-07-22T18:32:15+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#vpc-privatelink","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS PrivateLink","description":"AWS PrivateLink","dateCreated":"2020-03-02T07:06:02+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#reference-arch-diagram","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Reference Architecture Diagram","description":"Reference Architecture Diagram","dateCreated":"2020-04-29T05:19:31+0000","dateUpdated":"2022-02-03T03:31:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#toyota03292022sldkfgsghsef","locale":"en_US","directoryId":"customer-references","name":"toyota03292022sldkfgsghsef","dateCreated":"2022-05-23T21:43:28+0000","dateUpdated":"2023-07-20T21:56:25+0000","additionalFields":{"descriptionSummary":"Toyota manufactures and distributes cars worldwide that are meticulously logged in vehicle data warehouses and data marts to provide insights on service checks and sales reports. Toyota migrated and modernized its on-premises vehicle data warehouse and data marts by leveraging a Lake House architecture on AWS. Data is securely migrated from the source systems on-premises to AWS using AWS Direct Connect and ingested in data integration tools running on Amazon EC2 such as Kafka, Talend, and Databricks. Data is pushed into different layers for transformation with Amazon S3, AWS Glue, and Amazon RDS. To obtain read-optimized data, data is ingested into Amazon Redshift. Amazon Redshift Spectrum and Amazon Athena are leveraged by Toyota\u0027s Data Scientists, Analysts, and Business user teams to produce self-service reports. With this Lake House architecture, Toyota has improved their time to market and eliminated the duplication of data.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/toyota-logo%401x.c83b34d7e548358fef55603b0869cee53cc6a4b0.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2022-03-29","headlineUrl":"https://youtu.be/Kp51k6LY-2c?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Toyota Motor North America","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Toyota Motor NA: Lake House Architecture for Data and Analytics"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000","dateUpdated":"