er-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2020-08-18T05:17:48+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#business-category#cust-engagement","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2020-06-05T07:06:46+0000","dateUpdated":"2022-02-03T03:31:03+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#cloudhsm","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudHSM","description":"AWS CloudHSM","dateCreated":"2020-03-02T07:01:58+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#directconnect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Direct Connect","description":"AWS Direct Connect","dateCreated":"2020-03-02T07:02:43+0000","dateUpdated":"2022-02-03T03:32:30+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Mobile","description":"Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2023-08-22T20:28:38+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#category#developer-tools","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Developer Tools","description":"\u003cp\u003eHost code, build, test, and deploy your applications quickly and effectively with AWS developer tools. Leverage core tools like software development kits (SDKs), code editors, and continuous integration and delivery (CI/CD) services for DevOps software development. Use machine learning (ML) -guided best practices and abstractions to improve agility, security, velocity, and code quality.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:14:12+0000","dateUpdated":"2023-07-14T01:14:12+0000"}]},{"item":{"id":"customer-references#celgene-case-study","locale":"en_US","directoryId":"customer-references","name":"celgene-case-study","dateCreated":"2019-07-22T19:48:22+0000","dateUpdated":"2023-07-12T01:35:34+0000","additionalFields":{"featured":"0","descriptionSummary":"Celgene uses AWS to enable secure collaboration between internal and external researchers, allow individual scientists to launch hundreds or even thousands of compute nodes, and reduce the time it takes to do computational jobs from weeks to hours. Celgene is a global biopharmaceutical company that creates drugs that fight cancer and other diseases and disorders.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Celgene_Customer-Reference_Logo.d5d89eed59946b6c0a7faa7887ffd9d24b0bb269.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the Celgene customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Life Sciences","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/celgene/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Celgene","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Celgene Case Study"}},"tags":[{"id":"GLOBAL#product#glacier","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon S3 Glacier","description":"Amazon S3 Glacier","dateCreated":"2020-03-02T07:03:38+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpda