3eQ2, Inc., a financial experience company, partnered with AWS Partner Presidio to migrate its largest revenue-generating digital banking product to AWS, avoiding a costly on-premises hardware investment. Q2 set an ambitious goal to decrease costs by 25% to better serve each customer. The AWS migration would prove integral to achieving this goal. To satisfy a tight timeline and rigid uptime requirements, Presidio developed an automated, parallel migration platform called \u0026ldquo;Q2 Migration Manager\u0026rdquo; (Q2MM) to accelerate the project.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Q2%20Logo%201%20200x70px.c57fb61664fa0caa3c14d40a8a1f4082d39429b8.png","footerInfoText":"2025","industry":"Financial Services","sortDate":"2025-02-18","enableShare":"1","headlineUrl":"https://aws.amazon.com/solutions/case-studies/q2-presidio/","publishedDate":"2025","contentType":"Video Testimonial","customer-name":"Q2","headline":"Presidio Migrates Q2, Inc. Digital Banking Product to AWS to Accelerate Innovation While Reducing Costs"}},"tags":[{"id":"GLOBAL#product#directconnect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Direct Connect","description":"AWS Direct Connect","dateCreated":"2020-03-02T07:02:43+0000","dateUpdated":"2022-02-03T03:32:30+0000"},{"id":"GLOBAL#product#transitgateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Transit Gateway","description":"AWS Transit Gateway","dateCreated":"2020-03-02T07:05:54+0000","dateUpdated":"2022-02-03T03:33:05+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#vpc-privatelink","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS PrivateLink","description":"AWS PrivateLink","dateCreated":"2020-03-02T07:06:02+0000","dateUpdated":"