ences#innovator#mercado-libre","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Mercado Libre","description":"Mercado Libre","dateCreated":"2022-09-15T00:48:36+0000","dateUpdated":"2022-09-15T00:48:36+0000"},{"id":"customer-references#category#mobile","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Mobile","description":"Mobile","dateCreated":"2019-07-22T18:32:14+0000","dateUpdated":"2022-03-24T02:42:27+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#category#developer-tools","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Developer Tools","description":"\u003cp\u003eHost code, build, test, and deploy your applications quickly and effectively with AWS developer tools. Leverage core tools like software development kits (SDKs), code editors, and continuous integration and delivery (CI/CD) services for DevOps software development. Use machine learning (ML) -guided best practices and abstractions to improve agility, security, velocity, and code quality.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:14:12+0000","dateUpdated":"2023-07-14T01:14:12+0000"}]},{"item":{"id":"customer-references#fox-reinvent-media-services-case-study","locale":"en_US","directoryId":"customer-references","name":"fox-reinvent-media-services-case-study","dateCreated":"2023-09-06T22:56:40+0000","dateUpdated":"2023-09-06T23:23:15+0000","additionalFields":{"descriptionSummary":"FOX uses Amazon Web Services (AWS) to innovate the way live television is created and distributed. Now a year into their strategic collaboration agreement with AWS, FOX is using AWS Media Services to create adaptable, elastic, and efficient workflows to move the television technology industry forward.","imag