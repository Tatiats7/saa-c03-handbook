e Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#cloudhsm","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudHSM","description":"AWS CloudHSM","dateCreated":"2020-03-02T07:01:58+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#national-instruments-case-study","locale":"en_US","directoryId":"customer-references","name":"national-instruments-case-study","dateCreated":"2019-07-22T19:46:38+0000","dateUpdated":"2023-09-21T00:18:57+0000","additionalFields":{"descriptionSummary":"National Instruments has reduced testing costs by more than $1 million and shaved months off its software development process by using AWS. National Instruments is a global company that provides advanced technology to engineers and scientists, with systems-design software that accelerates productivity and innovation in cutting-edge fields such as healthcare technology, mobile computing, and space research.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/NationalInstruments_Customer-Reference_Logo.9190e253243b6e2570adea5e870c730bc775e79b.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"National Instruments (NI) has reduced testing costs by more than $1 million and shaved months off its software development process by using AWS. National Instruments is a global company that provides advanced technology to engineers and scientists, with systems-design software that accelerates productivity and innovation in cutting-edge fields such as healthcare technology, mobile computing, and space research. NI is using Amazon Elastic Compute Cloud Spot Instances to save time and money while improving the quality of products it offers to customers. ","industry":"Electronics \u0026 Semiconductors","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/national-instruments/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"National Instruments","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"National Instruments Case Study"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":