inahealth-case-study","dateCreated":"2023-08-29T20:54:19+0000","dateUpdated":"2024-02-20T22:26:26+0000","additionalFields":{"descriptionSummary":"Allina Health uses a PACS solution in the cloud from Visage, an AWS Partner, to reduce the time it takes radiologists to load medical images by 67 percent, benefiting patients by providing quicker results.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/AllinaHealth_logo%401x.dc86d7e807ae6fcd559a0450018c36ade109db51.jpg","displayLocation":"United States","customerNameLower":"allina health","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2023-08-17","headlineUrl":"https://aws.amazon.com/solutions/case-studies/allinahealth-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Allina Health","publishedDate":"2023","enableShare":"1","headline":"Allina Health Optimizes Imaging in the Cloud Using Visage and AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#directconnect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Direct Connect","description":"AWS Direct Connect","dateCreated":"2020-03-02T07:02:43+0000","dateUpdated":"2022-02-03T03:32:30+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_