ly.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/AudioCodes-logo.80e15af2cd1d49650b3325acd6c0f0d3b7db1417.jpg","displayLocation":"Israel","footerInfoText":"Published Date","description":"\u003cp\u003eAudioCodes, based in Israel, develops Voice over IP (VoiP) infrastructure service applications for organizations and enterprises worldwide. The company uses AWS to host its VoiP applications and connect directly to proprietary hardware using AWS Direct Connect. As a result of using AWS, AudioCodes lowered its price point by 300% and broadened its customer base globally.\u003c/p\u003e\r\n","industry":"Telecommunications","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/audiocodes/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"AudioCodes","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: AudioCodes"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#middle-east-africa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East \u0026 Africa","description":"Middle East \u0026 Africa","dateCreated":"2020-02-03T05:30:19+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#directconnect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Direct Connect","description":"AWS Direct Connect","dateCreated":"2020-03-02T07:02:43