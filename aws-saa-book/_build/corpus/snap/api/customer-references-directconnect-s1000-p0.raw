teCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#workload#sap","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"SAP","description":"SAP","dateCreated":"2021-01-06T00:09:56+0000","dateUpdated":"2022-02-03T03:36:05+0000"},{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#industry#prof-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Professional Services","description":"Professional Services","dateCreated":"2020-06-25T04:07:49+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#transport-logistics","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Transport \u0026 Logistics","description":"Transport \u0026 Logistics","dateCreated":"2020-06-25T04:08:39+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#aws-case-study-hess-corporation","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-hess-corporation","dateCreated":"2019-07-22T19:55:30+0000","dateUpdated":"2023-07-12T01:40:42+0000","additionalFields":{"featured":"0","descriptionSummary":"When Hess Corporation announced divestiture plans for its downstream businesses in March 2013, the IT department decided to migrate the associated infrastructure in a way that would completely uncouple dependence from its on-premises datacenter. Working with APN Partner Nimbo, Hess used AWS to prepare its Energy Marketing business for acquisition in only six months—a process that would have taken twice as long with an on-premises environment.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/HessCorporation_Customer-Reference_Logo.4c92c08840bf8141e33f15fe2807e5360bb2716a.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eHess divested their Energy Marketing business to Direct Energy. Moving this environment to AWS allowed them to quickly hand over to the buyer a completely contained, and functioning set of Enterprise applications and associated infrastructure. The main metric with this divestiture was time to market. There was no hardware to purchase or stage. Their ability to fail fast, and adjust course appropriately helped them to \u0026quot;lift and shift\u0026quot; this environment quicker then they could have done it on premises. They started building the environment in July 2013, and just went into production on January 12th 2014. They plan to hand this environment over to Direct Energy on February 13th 2014. Nimbo was the partner who helped them with this deployment. Ironically, Nimbo was Microsoft Azure Partner of the Year for 2013. They are mostly using Windows, Oracle, SQL Server and F5 and Citrix from the Marketplace. They have all of these apps running in a VPC with Direct Connect.\u003c/p\u003e\r\n","industry":"Energy","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/hess-corporation/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Hess Corporation","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Hess Corporation"}},"tags":[{"id":"customer-references#category#dev-and-test","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dev \u0026 Test","description":"Dev \u0026 Test","dateCreated":"2019-07-22T18:31:47+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#catego