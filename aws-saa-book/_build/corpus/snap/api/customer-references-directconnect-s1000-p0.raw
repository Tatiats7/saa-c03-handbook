Updated":"2023-12-19T00:53:01+0000","additionalFields":{"descriptionSummary":"L\u0027innovation est au cœur de France Télévisions. Le groupe a choisi AWS pour inspirer et piloter sa transformation vers une organisation moderne axée sur le cloud. Le groupe s\u0027appuie fortement sur AWS Media Services pour ses opérations de streaming et ses activités publicitaires, et divers systèmes de base cruciaux bénéficient de la technologie et de l\u0027expertise d\u0027AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/france-televisions-france.tv-logo%401x.51ed278f7db2cbf03b5405ba17950c1e1874b661.png","displayLocation":"France","customerNameLower":"france télévisions","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2023-08-24","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/france-televisions/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"France Télévisions","publishedDate":"2023","enableShare":"1","headline":"Le Cloud, accélérateur de transition digitale pour les groupes audiovisuels","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#directconnect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Direct Connect","description":"AWS Direct Connect","dateCreated":"2020-03-02T07:02:43+0000","dateUpdated":"2022-02-03T03:32:30+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#media-services","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Media Services","description"