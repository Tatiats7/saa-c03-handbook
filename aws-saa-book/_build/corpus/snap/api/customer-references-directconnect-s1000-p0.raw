 conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#discover-case-study-2022","locale":"en_US","directoryId":"customer-references","name":"discover-case-study-2022","dateCreated":"2022-06-28T18:54:30+0000","dateUpdated":"2022-06-28T18:55:56+0000","additionalFields":{"descriptionSummary":"Discover Financial Services began migrating its settlement processes to AWS, making transaction processing and price changes faster and supporting business agility and technical innovation.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Discover_Logo%401x.178833a8207c395f3d516c31ed78212a62d7cfbd.png","displayLocation":"United States","customerNameLower":"discover financial services","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-06-24","headlineUrl":"https://aws.amazon.com/solutions/case-studies/discover-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Discover Financial Services","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Discover Financial Services Increases Transaction Processing Speed by 66% on AWS"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"