ry","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#innovator#toyota","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Toyota","description":"Toyota","dateCreated":"2022-09-15T00:48:43+0000","dateUpdated":"2022-09-15T00:48:44+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"}]},{"item":{"id":"customer-references#minnesota-data-lakes-video","locale":"en_US","directoryId":"customer-references","name":"minnesota-data-lakes-video","dateCreated":"2022-01-08T04:31:35+0000","dateUpdated":"2023-07-12T01:35:18+0000","additionalFields":{"descriptionSummary":"The Minnesota Department of Health (MDH) is responsible for Minnesotans\u0027 public health, including disease control and prevention, environmental health, public policy, and regulation of health care providers. In partnership with Minnesota IT Services—the state\u0027s information technology agency, which sets IT strategy, direction, policies, and standards—MDH built a unified solution to obtain secure, consistent access to curated health data on Amazon Web Services (AWS). Using data lakes on AWS, MDH is able to group data from subsystems to support the creation of the governor’s COVID-19 report, deliver notifications of exposure to COVID-19, host a staging area between the disease surveillance system and other systems, act as an access point for researchers and epidemiologists, and more.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/mn-minnesota-logo%401x.578d55599bbc00601a55e0a6f8615014c95f82e1.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2022-01-07","headlineUrl":"https://aws.amazon.com/solutions/case-studies/minnesota-data-lakes-video/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","customer-name":"Minnesota Department of Health and IT Services","contentType":"Customer Story","headline":"Minnesota Department of Health and IT Services Improve Data Availability on AWS"}},"tags":[{"id":"GLOBAL#product#security-hub","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Security Hub","description":"AWS Security Hub","dateCreated":"2020-03-02T07:05:15+0000","dateUpdated":"2022-02-03T03:32:59+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#config","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Config","description":"AWS Config","dateCreated":"2020-03-02T07:02:20+0000","dateUpdated":"2022-02-03T03:32:26+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video