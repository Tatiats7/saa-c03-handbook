ontent to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#midas-safety-case-study","locale":"en_US","directoryId":"customer-references","name":"midas-safety-case-study","dateCreated":"2020-10-09T19:36:28+0000","dateUpdated":"2021-12-22T20:24:32+0000","additionalFields":{"featured":"0","descriptionSummary":"By migrating its SAP environment to AWS, Midas Safety has reduced its TCO by 40 percent and ensured 99.9 percent uptime.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/midas_logo@1x.0fe68a7ba6e6b0b5e85bd835ea80e149842f3a9b.png","displayLocation":"India","footerInfoText":"Published Date","industry":"Manufacturing","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/midas-safety/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Midas Safety","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Midas Safety Lowers TCO by 40% running SAP on AWS"}},"tags":[{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03