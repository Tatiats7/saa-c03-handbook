T03:32:07+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"customer-references#innovator#netflix","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Netflix","description":"Netflix","dateCreated":"2022-04-25T19:06:40+0000","dateUpdated":"2022-06-10T21:39:50+0000"}]},{"item":{"id":"customer-references#mercado-libre-pt","locale":"en_US","directoryId":"customer-references","name":"mercado-libre-pt","dateCreated":"2023-06-01T23:08:23+0000","dateUpdated":"2023-08-11T00:24:46+0000","additionalFields":{"descriptionSummary":"Com uma população de mais de 650 milhões de pessoas, a América Latina está testemunhando um dos maiores crescimentos no uso da internet pelo mundo. Desde a sua criação, em 1999, o Mercado Livre aproveitou esse crescimento para se tornar a maior empresa de comércio eletrônico e serviços financeiros da América Latina. O Mercado Livre opera em 18 países e, atualmente, conta com mais de 76 milhões de usuários ativos, segundo dados do trimestre encerrado em junho de 2021. O marketplace do Mercado Livre tem mais de 5 mil vendedores fora da América Latina, que geralmente operam em Inglês.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/r2018/r/seer/customers/600x400_Mercado-Libre_Horizontal_Logo.591869641e3359d8ad7c938d4413445babdacda7.png","displayLocation":"Argentina","footerInfoText":"Data de publicação","industry":"Varejo","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/mercado-libre-pt/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Mercado Libre (Mercado Livre)","enableShare":"1","publishedDate":"2021","contentType":"História do cliente","headline":"Mercado Livre realiza traduções automáticas e precisas em escala usando o Amazon Translate"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:3