d":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#business-category#cust-engagement","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2020-06-05T07:06:46+0000","dateUpdated":"2022-02-03T03:31:03+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"}]},{"item":{"id":"customer-references#jps","locale":"en_US","directoryId":"customer-references","name":"jps","dateCreated":"2023-06-01T23:06:05+0000","dateUpdated":"2023-06-08T04:07:40+0000","additionalFields":{"descriptionSummary":"Jamaica Public Service (JPS) es el único distribuidor de electricidad en Jamaica. Hace aproximadamente tres años, la empresa tenía el desafío de poner una gran cantidad de información disponible para todos sus clientes. Con el apoyo de AWS, la compañía comenzó su camino hacia la transformación digital, moviendo su servicio al cliente de una manera rápida y eficiente, así como mejorando su rentabilidad a través de la nube AWS. Garry Barrow, director de operaciones en JPS, y Phillip Hamilton, especialista en TI para Infraestructura de la compañía, explican cómo lograron la capacidad de brindar soluciones en cuestión de minutos en lugar de semanas y ahorrar en almacenamiento al menos un 40%.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/JPS-logo%401x.3478528beeb40acda015c33b78052ade26565ed5.png","customerNameLower":"jps","footerInfoText":"Fecha de publicación","industry":"Energía","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/jps/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"JPS","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"AWS ayuda a transformar JPS de una organización tradicional a una digital"}},"tags":[{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#product#codecommit","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodeCommit","description":"AWS CodeCommit","dateCreated":"2020-03-02T07:02:10+0000","dateUpdated":"2022-02-03T03:32:24+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"customer-references#category#app-integration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Application Integration","description":"Application Integration","dateCreated":"2019-07-22T18:30:54+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03