e R\u0026amp;D.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/iktos_Logo.7ab9062eb0c95b94734028ba88b8a47b5310f699.PNG","displayLocation":"France","customerNameLower":"iktos","footerInfoText":"Date de publication","industry":"Santé","sortDate":"2022-07-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/iktos/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Iktos","enableShare":"1","publishedDate":"2022","contentType":"Témoignages clients","headline":"Iktos : Le déploiement rapide et à grande échelle de solutions clients d’une entreprise d’IA en pleine croissance"}},"tags":[{"id":"GLOBAL#customer-enablement#developer-support","locale":"en_US","tagNamespaceId":"GLOBAL#customer-enablement","name":"AWS Developer Support","description":"AWS Developer Support","dateCreated":"2020-09-04T04:06:26+0000","dateUpdated":"2022-02-03T03:31:13+0000"},{"id":"GLOBAL#product#augmented-ai","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Augmented AI","description":"Amazon Augmented AI","dateCreated":"2020-12-08T20:05:22+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#product#forecast","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Forecast","description":"Amazon Forecast","dateCreated":"2020-03-02T07:03:29+0000","dateUpdated":"2022-02-03T03:32:37+0000"},{"id":"GLOBAL#product#lookout-for-equipment","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Lookout for Equipment","description":"Amazon Lookout for Equipment","dateCreated":"2021-11-17T07:15:30+0000","dateUpdated":"2022-02-03T03:32:48+0000"},{"id":"GLOBAL#product#elemental-mediastore","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental MediaStore","description":"AWS Elemental MediaStore","dateCreated":"2020-03-02T07:03:18+0000","dateUpdated":"2022-02-03T03:32:35+0000"},{"id":"GLOBAL#product#efs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic File System (EFS)","descr