{"items":[{"item":{"id":"customer-references#hashicorp-reinvent2024","locale":"en_US","directoryId":"customer-references","name":"hashicorp-reinvent2024","dateCreated":"2025-05-02T15:50:46+0000","dateUpdated":"2025-05-02T16:09:28+0000","additionalFields":{"descriptionSummary":"With AWS Organizations, AWS CloudTrail, and AWS Config, HashiCorp can scale environments, monitor malicious activities, assess and manage resource configurations, unlock operational efficiencies, and simplify its cloud governance and compliance journey.This partnership streamlines hybrid and cloud deployments with solutions, providing customers with scalable, repeatable, and secure infrastructure strategies.","imageSrcUrl":"https://d1.awsstatic.com/events/jp/2024/aws-summit-japan/branding/sponsors/HashiCorp_web.20bb5c52e259cf6519973a5df84d217f46aa7b06.png","displayLocation":"United States","customerNameLower":"hashicorp","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2025-04-09","headlineUrl":"https://www.youtube.com/watch?v\u003dD9HtZ60z60Y\u0026did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"HashiCorp","publishedDate":"2025","enableShare":"1","headline":"HashiCorp simplifies cloud governance \u0026 compliance journey with AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#organizations","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Organizations","description":"AWS Organizations","dateCreated":"2020-03-02T07:04:43+0000","dateUpdated":"2022-