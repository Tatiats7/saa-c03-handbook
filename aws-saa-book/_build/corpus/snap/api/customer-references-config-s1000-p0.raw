r anderem das Direct Banking, Fahrzeugfinanzierungen, Leasing, Versicherungen und weitere Mobilitätsservices. VWFS weist eine Bilanzsumme von mehr als 225 Milliarden Euro auf und ist international in 48 Märkten mit eigenen Tochtergesellschaften, Beteiligungen und Joint Ventures vertreten.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/volkswagen-financial-services-logo%401x.e68eefdfea59f88f24cf6a63c65bdc4d1e892b14.png","displayLocation":"Deutschland","customerNameLower":"volkswagen financial services","industry":"Finanzdienstleistungen","sortDate":"2021-07-16","enableShare":"1","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/volkswagen-financial-services/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"Kundengeschichte","customer-name":"Volkswagen Financial Services","headline":"Volkswagen realisiert eine globale Plattform für Financial Services mit AWS"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#germany","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Germany","description":"Germany","dateCreated":"2020-02-03T05:29:55+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespace