industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"}]},{"item":{"id":"customer-references#scania","locale":"en_US","directoryId":"customer-references","name":"scania","dateCreated":"2023-09-06T22:57:17+0000","dateUpdated":"2023-09-06T23:23:16+0000","additionalFields":{"descriptionSummary":"Scania chose to partner with AWS for their cloud-first strategy,providing them with an agile, scalable, global innovation platform that allows them to quickly innovate new features and applications for their their customers and provides insights to internal stakeholders that drive business value.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Scania-logo-1x.c4a26af42ae361d799aca317a05f6744a5a84fde.png","displayLocation":"Sweden","customerNameLower":"scania","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/scania/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Scania","publishedDate":"2019","enableShare":"1","headline":"Scania Drives Toward Sustainable Transport Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#cognito","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Cognito","description":"Amazon Cognito","dateCreated":"2020-03-02T07:02:17+0000","dateUpdated":"2022-02-03T03:32:25+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Internet of Things (IoT)","description":"Internet of Things (IoT)","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2023-08-22T20:28:39+0000"},{"id":"customer-references#category#business-applications-microsoft-sql","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: Microsoft SQL","description":"Business Applications: Microsoft SQL","dateCreated":"2019-07-22T18:31:19+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#product#vpc-privatelink","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS PrivateLink","description":"AWS PrivateLink","dateCreated":"2020-03-02T07:06:02+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#tech-category#networking-content-de