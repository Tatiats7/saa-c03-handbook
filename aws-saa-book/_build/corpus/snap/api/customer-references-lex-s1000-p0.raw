product#lex","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Lex","description":"Amazon Lex","dateCreated":"2020-03-02T07:04:21+0000","dateUpdated":"2022-02-03T03:32:47+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#connect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Connect","description":"Amazon Connect","dateCreated":"2020-03-02T07:02:22+0000","dateUpdated":"2022-02-03T03:32:26+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#wafd-bank-case-study","locale":"en_US","directoryId":"customer-references","name":"wafd-bank-case-study","dateCreated":"2022-12-13T00:38:54+0000","dateUpdated":"2022-12-13T00:59:56+0000","additionalFields":{"descriptionSummary":"WaFd Bank implemented a new contact center solution using Amazon Lex and AWS Partner Talkdesk that reduced call times by up to 90 percent, improving both customer and agent experiences.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/wafd-bank-logo%401x.876146855fd03c1d14e7396e6783dd4775d4cdc9.png","displayLocation":"United States","customerNameLower":"wafd bank","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-11-22","headlineUrl":"https://aws.amazon.com/solutions/case-studies/wafd-bank-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"WaFd Bank","publishedDate":"2022","enableShare":"1","headline":"WaFd Bank Transforms Contact Centers Using Conversational AI on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05: