"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#etermax","locale":"en_US","directoryId":"customer-references","name":"etermax","dateCreated":"2023-06-01T23:08:33+0000","dateUpdated":"2023-06-08T04:07:37+0000","additionalFields":{"descriptionSummary":"Para Etermax el mayor valor agregado que han obtenido con AWS es la velocidad que pueden lograr, además de la alta capacidad de escalamiento en su infraestructura y la posibilidad de innovar constantemente por las facilidades que brinda el cloud de AWS. Con AWS maximizaron su cantidad de usuarios, en un mes pasaron de tener 2 millones a 25 millones de usuarios, sin presentar caídas en la plataforma y con un alto nivel de flexibilidad y agilidad.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/etermax_logo%401x.b49e8b4c334934101d49304628d50a1a7760eeed.png","displayLocation":"Argentina","footerInfoText":"Fecha de publicación","industry":"Videojuegos","sortDate":"2019-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/etermax/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2019","contentType":"Historia del cliente","customer-name":"ETERMAX","headline":"Caso Práctico de Etermax"}},"tags":[{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#product#kinesis","locale