-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#hcls","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Healthcare \u0026 Life Sciences","description":"Healthcare \u0026 Life Sciences","dateCreated":"2019-07-22T18:31:58+0000","dateUpdated":"2022-05-14T20:13:37+0000"}]},{"item":{"id":"customer-references#yelloh-case-study","locale":"en_US","directoryId":"customer-references","name":"yelloh-case-study","dateCreated":"2023-05-11T00:15:18+0000","dateUpdated":"2024-02-21T00:20:53+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eYelloh (formerly Schwan\u0026rsquo;s Home Delivery) wanted to transform into a modern mobile retailer. They wanted to become more effective in how they connect with customers and employees to ultimately enhance their food delivery operational model. Using Amazon Personalize, Yelloh is able to generate personalized product recommendations. They can now suggest new food items customers might like, based on previous orders and like-buyer baskets. This case study explains how this increased brand loyalty and purchase orders for the company.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/yelloh-logo%401x.057670cea933500618a605535e89622349adb531.png","displayLocation":"United States","customerNameLower":"yelloh","footerInfoText":"Published Date","industry":"Consumer Packaged Goods (CPG)","sortDate":"2023-05-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/yelloh-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Yelloh","publishedDate":"2023","enableShare":"1","headline":"Schwan Home Delivery Makes Connections Using Amazon Personalize","contentType":"Customer Story"}},"tags":[{"id":"customer-