ated":"2024-08-23T15:46:23+0000","dateUpdated":"2024-08-23T15:50:04+0000","additionalFields":{"descriptionSummary":"Working with Amazon Web Services (AWS) Partner Cation Consulting, the National Council for the Blind of Ireland (NCBI) uses generative artificial (AI) to deliver information to people with sight loss through voice technology. The solution, which uses Amazon Alexa and Amazon Lex, provides a blueprint that other charities and non-governmental organizations can use to change people’s lives.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/NCBI-logo-2%401x.caa5af505c56cb0a726f20c5c919a77a971af9bf.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/NCBI-logo-2%401x.caa5af505c56cb0a726f20c5c919a77a971af9bf.png","displayLocation":"Ireland","customerNameLower":"ncbi","footerInfoText":"Published Date","industry":"Social Services","sortDate":"2024-08-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ncbi-generative-ai/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"NCBI","publishedDate":"2024","enableShare":"1","headline":"NCBI Gives People with Sight Loss Access to Information Using Generative AI and AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Mid-Market Territory (MMT)","description":"Mid-Market Territory (MMT)","dateCreated":"2021-06-04T06:35:43+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"G