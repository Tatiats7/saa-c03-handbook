:"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"}]},{"item":{"id":"customer-references#traeger07182022sifjspogejpok","locale":"en_US","directoryId":"customer-references","name":"traeger07182022sifjspogejpok","dateCreated":"2023-02-08T01:17:05+0000","dateUpdated":"2023-02-08T01:38:41+0000","additionalFields":{"descriptionSummary":"Learn how Traeger Grills processes orders and personalizes their customer support experience for their newly launched Traeger Provisions service. You\u0027ll learn how they use EventBridge  in conjunction with Kinesis Data Firehose to send real time data to S3 which is then processed and stored in Dynamo DB. You\u0027ll also see how they personalize customer experience using Amazon Connect along with Pinpoint and use Lex to get input from customer to send them to specialized queues.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/traeger-logo%401x.0e9c3bcab736ffe09f0062a911db8eda68f48595.jpg","displayLocation":"United States","customerNameLower":"traeger pellet grills","footerInfoText":"Published Date","industry":"Consumer Packaged Goods (CPG)","sortDate":"2022-07-18","headlineUrl":"https://youtu.be/hlVnmCfydIs?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Traeger Pellet Grills","publishedDate":"2022","enableShare":"1","headline":"Traeger Provisions: Personalizing Customer Support Experiences on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#kinesis-data-firehose","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis Firehose","description":"Amazon Kinesis Firehose","dateCreated":"2020-05-08T03:42:48+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40