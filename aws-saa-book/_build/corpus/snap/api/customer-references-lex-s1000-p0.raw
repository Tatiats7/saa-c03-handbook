drock and AWS Lambda, Buddi accelerates development to deliver value and insight at a faster pace for its security and healthcare customers. Equipped with cutting-edge personal location technology, these organizations can maintain safer communities and help people lead more independent lives.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/buddi%20logo%20%401x.c328cd2d5fcb3686b39668848a07eb58e7b30d05.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/buddi%20logo%20%401x.c328cd2d5fcb3686b39668848a07eb58e7b30d05.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"buddi","footerInfoText":"Published Date","industry":"Semiconductors","sortDate":"2024-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/buddi-generative-ai/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Buddi","publishedDate":"2024","enableShare":"1","headline":"Buddi Helps Customers Cut Crime, Improve Communities Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03