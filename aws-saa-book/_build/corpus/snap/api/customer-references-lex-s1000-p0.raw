ated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#bedrock","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Bedrock","description":"Amazon Bedrock","dateCreated":"2023-04-13T19:06:46+0000","dateUpdated":"2023-04-13T19:06:46+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"customer-references#industry#hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"hospitality","description":"Hospitality","dateCreated":"2020-03-23T20:15:24+0000","dateUpdated":"2021-01-26T00:37:15+0000"},{"id":"customer-references#industry#travel","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel","description":"Travel","dateCreated":"2020-05-29T23:12:09+0000","dateUpdated":"2021-02-09T21:53:22+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#observe-ai-case-study","locale":"en_US","directoryId":"customer-references","name":"observe-ai-case-study","dateCreated":"2024-08-26T19:49:20+0000","dateUpdated":"2025-01-23T23:19:10+0000","additionalFields":{"descriptionSummary":"This case study explores how Observe AI, a conversational AI platform, leverages AWS to build a scalable and secure solution for its customers.","featured":"0","featureImageURL":"https://d1.awsstatic.com/customer-references-case-studies-logos/observe-ai-innovator-hub.44a82f3b544f21d91d242ed542a2e73d91c8de7e.png","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/OBSERVE_AI_logo%401x.a071785a2123b3edae0ac401b6df4692e87515d1.png","displayLocation":"India","customerNameLower":"observe.ai","footerInfoText":"Published Date","description":"Observe.AI developed and open-sourced the One Load Audit Framework on AWS to optimize machine learning model costs, boost developer efficiency, and scale to meet data growth.","industry":"Software \u0026 Internet","sortDate":"2024-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/observe-ai-case-study?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Observe.AI","publishedDate":"2024","enableShare":"1","headline":"Observe.AI Cuts Costs by Over 50% with Machine Learning on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","