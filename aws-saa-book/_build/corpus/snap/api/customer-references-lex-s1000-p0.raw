{"items":[{"item":{"id":"customer-references#nhs-midlands-lancashire-digital-space-2025","locale":"en_US","directoryId":"customer-references","name":"nhs-midlands-lancashire-digital-space-2025","dateCreated":"2025-02-14T22:05:49+0000","dateUpdated":"2025-03-06T23:44:40+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eNHS Midlands and Lancashire (NHS ML) supports nine Integrated Care Boards (ICBs) across England from its bases in the Midlands and North West, providing the high-quality transformational and back-office support they need. Using traditional methods for all patient contact was time consuming, ineffective, and expensive. The NHS ML Referral Management Centre chose AWS Partner Digital Space to migrate its patient contact center to Amazon Web Services (AWS) and deployed an automated multi-channel approach to patient communication and engagement. The innovative digital transformation of its patient waiting list management reduced waiting lists 9\u0026ndash;14%, depending on specialty.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/ML%20Logo%20200x70px.10ac1467f5beddafaaea61c9a933dffe3e241508.png","displayLocation":"United Kingdom","footerInfoText":"2025","industry":"Healthcare","sortDate":"2025-02-14","headlineUrl":"https://aws.amazon.com/solutions/case-studies/nhs-midlands-lancashire-digital-space/","customer-name":"NHS Midlands and Lancashire","enableShare":"1","publishedDate":"2025","contentType":"Case Study","headline":"NHS Midlands and Lancashire Launches Activate, Incorporating a Scalable, Cost-Effective Patient Contact Center Solution with Digital Space on AWS, Reducing Patient Waiting Lists by 9–14%"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tag