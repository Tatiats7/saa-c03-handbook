sstatic.com/case-studies/Astro_600x400.0b363df1fcfd8154a8ba005d8d07b823db40b1aa.jpg","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eBy using AWS deep-learning technologies, Astro took only six weeks to develop and deploy Astrobot Voice, the enterprise-grade voice email assistant that ships with its Astro email app. The company enables workplace teams to focus on what\u0019s important by using machine learning to make their communications more effective and less time-consuming. Astro built Astrobot by using Amazon Lex for speech recognition and language understanding.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/astro-technology/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Astro Technology","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Astro Technology Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#polly","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Polly","description":"Amazon Polly","dateCreated":"2020-03-02T07:04:53+0000","dateUpdated":"2022-02-03T03:32:54+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated"