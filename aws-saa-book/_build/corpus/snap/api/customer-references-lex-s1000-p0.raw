dateCreated":"2020-03-02T07:02:08+0000","dateUpdated":"2022-02-03T03:32:24+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#morrisons-connect-case-study","locale":"en_US","directoryId":"customer-references","name":"morrisons-connect-case-study","dateCreated":"2020-11-05T23:25:36+0000","dateUpdated":"2021-12-22T22:39:38+0000","additionalFields":{"featured":"0","descriptionSummary":"Morrisons, the United Kingdom\u0027s fourth-largest grocery chain, migrated its contact center to Amazon Connect in 8 weeks, improving customer service and enabling the company to quickly innovate and scale during peak traffic.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/morrisons-logo@1x.5b7831661d047e1eeb789c0bd8a17e3bf315c100.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","industry":"Retail","sortDate":"2020-11-05","headlineUrl":"https://aws.amazon.com/solutions/case-studies/Morrisons-Connect-case-study/?did\u003dcr