0-03-02T07:01:20+0000","dateUpdated":"2022-02-03T03:32:15+0000"},{"id":"GLOBAL#product#budgets","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Budgets","description":"AWS Budgets","dateCreated":"2020-03-02T07:01:44+0000","dateUpdated":"2022-02-03T03:32:19+0000"},{"id":"GLOBAL#product#sumerian","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Sumerian","description":"Amazon Sumerian","dateCreated":"2020-03-02T07:05:42+0000","dateUpdated":"2022-02-03T03:33:03+0000"},{"id":"GLOBAL#product#elemental-mediatailor","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental MediaTailor","description":"AWS Elemental MediaTailor","dateCreated":"2020-03-02T07:03:20+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#product#resilience-hub","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Resilience Hub","description":"AWS Resilience Hub","dateCreated":"2021-11-17T07:15:55+0000","dateUpdated":"2022-02-03T03:32:57+0000"},{"id":"GLOBAL#product#cloud9","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Cloud9","description":"AWS Cloud9","dateCreated":"2020-03-02T07:01:52+0000","dateUpdated":"2022-02-03T03:32:21+0000"},{"id":"GLOBAL#product#cloudtrail","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudTrail","description":"AWS CloudTrail","dateCreated":"2020-03-02T07:02:05+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#product#elasticache-redis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache for Redis","description":"Amazon ElastiCache for Redis","dateCreated":"2020-03-03T00:16:59+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#unum-case-study","locale":"en_US","directoryId":"customer-references","name":"unum-case-study","dateCreated":"2022-01-15T01:07:32+0000","dateUpdated":"2022-01-18T18:43:39+0000","additionalFields":{"descriptionSummary":"A leader in the employee benefits space, Unum helps millions of people gain affordable access to disability, life, accident, critical illness, dental, and vision benefits through their workplace. When Covid-19 hit, Unum doubled down on its digital strategy to accommodate more digital interactions with customers.  In this video, Gautam Roy, Senior Vice President and CTO of Unum, discusses Unum’s journey to build an omnichannel customer engagement platform using AWS services, including Amazon Connect. Benefits include an increase in the use of self-service channels, improved economics of the contact center, and increased employee satisfaction with intuitive tools and simplified call center management.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/unum-logo%401x.a20fac7b152a607fe97393f803cea81760c0461a.png","displayLocation":"North America","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-01-14","headlineUrl":"https://aws.amazon.com/solutions/case-studies/unum-video/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Unum Re-Imagines the Insurance Customer Experience","customer-name":"Unum"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#connect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Connect","description":"Amazon Connect","dateCreated":"2020-03-02T07:02:22+0000","dateUpdated":"2022-02-03T03:32:26+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"customer-references#category#contact-center","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Contact Center","description":"Contact Center","dateCreated":"2019-0