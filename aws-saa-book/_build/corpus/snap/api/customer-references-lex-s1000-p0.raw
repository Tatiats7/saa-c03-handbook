t","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#product#comprehend","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Comprehend","description":"Amazon Comprehend","dateCreated":"2020-03-02T07:02:18+0000","dateUpdated":"2022-02-03T03:32:25+0000"},{"id":"customer-references#category#business-productivity","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Productivity","description":"Business Productivity","dateCreated":"2019-07-22T18:31:25+0000","dateUpdated":"2022-05-23T21:40:03+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#gen-ai","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gen AI","description":"\u003cp\u003eGenerative Artificial Intelligence\u003c/p\u003e\n","dateCreated":"2023-07-10T17:07:31+0000","dateUpdated":"2023-07-10T17:07:31+0000"},{"id":"GLOBAL#customer-segment#isv","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Independent Software Vendor (ISV)","description":"Independent Software Vendor (ISV)","dateCreated":"2021-06-04T06:35:42+0000","dateUpdated":"2022-02-03T03:31:14+0000"}]},{"item":{"id":"customer-references#letsgetchecked-case-study","locale":"en_US","directoryId":"customer-references","name":"letsgetchecked-case-study","dateCreated":"2022-12-20T01:07:26+0000","dateUpdated":"2023-07-12T01:35:17+0000","additionalFields":{"descriptionSummary":"LetsGetChecked is a global healthcare solutions company that provides people with the tools to manage health from home through direct access to diagnostic testing, virtual care, and medication delivery for a wide range of health and wellness conditions. LetsGetChecked is available nationwide in the United States, the United Kingdom, and most EU countries. It is co-headquartered in Dublin and New York. The company’s at-home diagnostic and care services experienced high demand during the COVID-19 pandemic. Moving its call centers to Amazon Connect not only provided scalable performance, but also allowed integration with other core systems. Using Amazon Connect, LetsGetChecked built a foundation for its business transformation to a full-spectrum telehealth management business.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/LetsGetChecked-logo%401x.d0162448550b0428fb13ecaa30a1cd092d7c6b99.png","displayLocation":"UK/IR","customerNameLower":"letsgetchecked","footerInfoText":"Published Date","industry":"Professional Services","sortDate":"2022-12-19","headlineUrl":"https://aws.amazon.com/solutions/case-studies/letsgetchecked-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"LetsGetChecked","publishedDate":"2022","enableShare":"1","headline":"LetsGetChecked Transforms Home Healthcare Using AWS","contentType":"Customer Story