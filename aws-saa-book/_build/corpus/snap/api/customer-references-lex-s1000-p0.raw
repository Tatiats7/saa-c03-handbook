-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"customer-references#category#gen-ai","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gen AI","description":"\u003cp\u003eGenerative Artificial Intelligence\u003c/p\u003e\n","dateCreated":"2023-07-10T17:07:31+0000","dateUpdated":"2023-07-10T17:07:31+0000"}]},{"item":{"id":"customer-references#united-airlines","locale":"en_US","directoryId":"customer-references","name":"united-airlines","dateCreated":"2024-09-26T20:53:39+0000","dateUpdated":"2025-01-13T19:00:55+0000","additionalFields":{"descriptionSummary":"United Airlines is leading modernization in an industry that’s embracing change. The largest airline globally by number of seat miles, its mission is to “Connect People, Uniting the World.” Migrating tens of hundreds of applications to Amazon Web Services (AWS) has helped the business accelerate innovation, even in the midst of challenging market conditions. From supporting its technology team to save $2 billion and boosting developer productivity 40 percent, to using generative artificial intelligence (AI) to streamline passenger record processes and save months of manual effort. With services such as Amazon Bedrock, AWS IoT Core, and Amazon DocumentDB, United Airlines is transforming passenger experiences, increasing efficiency and security, and shaping the intelligent airport of tomorrow.","featureImageURL":"https://d1.awsstatic.com/united-airlines-innovator-card.b02c9f5e0f9d9f22f3d53377da0ebe6e256ce598.jpeg","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/united-airlines-logo.5700166296d2216b5abdb3666484a1866fcf6504.png","displayLocation":"Americas","customerNameLower":"united airlines","footerInfoText":"Published Date","description":"\u003cp\u003eTransforming passenger experiences, increasing efficiency and security, and shaping the intelligent airport of tomorrow.\u003c/p\u003e\n","industry":"Travel","sortDate":"2024-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/innovators/united-airlines/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"United Airlines","publishedDate":"2024","enableShare":"1","headline":"United Airlines on AWS","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000