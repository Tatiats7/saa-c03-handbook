Created":"2020-01-16T17:43:13+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"customer-references#category#mobile","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Mobile","description":"Mobile","dateCreated":"2019-07-22T18:32:14+0000","dateUpdated":"2022-03-24T02:42:27+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"}]},{"item":{"id":"customer-references#robot-care-systems-case-study","locale":"en_US","directoryId":"customer-references","name":"robot-care-systems-case-study","dateCreated":"2019-07-19T14:56:32+0000","dateUpdated":"2023-07-14T23:32:27+0000","additionalFields":{"featured":"0","descriptionSummary":"By using AWS RoboMaker to connect Lea, its robotic assistive walker, to the cloud, Robot Care Systems added an intuitive voice interface, OTA updates, and machine-learning-based analytics. The company builds robotic healthcare devices to help people live more independently.","imageSrcUrl":"https://d1.awsstatic.com/logos/lea-logo.54b78281b7f2d8fb61af8552deccdf14a3e89ec3.jpg","displayLocation":"Netherlands","footerInfoText":"Published Date","description":"\u003cp\u003eBy using AWS RoboMaker to connect Lea, its robotic assistive walker, to the cloud, Robot Care Systems added an intuitive voice interface, OTA updates, and machine-learning?based analytics. The company builds robotic healthcare devices to help people live more independently. Robot Care Systems is using AWS RoboMaker for ROS cloud extensions, Amazon Lex and Amazon Polly to support a voice interface, Amazon Rekognition for facial recognition, and Amazon SageMaker for machine learning for autonomous navigation.\u003c/p\u003e\r\n","industry":"Healthcare","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/robotcaresystems/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Robot Care Systems","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Robot Care Systems Case Study"}},"tags":[{"id":"GLOBAL#product#polly","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Polly","description":"Amazon Polly","dateCreated":"2020-03-02T07:04:53+0000","dateUpdated":"2022-02-03T03:32:54+0000"},{"id":"GLOBAL#location#netherlands","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Netherlands","description":"Netherlands","dateCreated":"2020-02-03T05:29:50+0000","dateUpdated":"2022-02-03T03:31:41+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#robomaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS RoboMaker","description":"AWS RoboMaker","dateCreated":"2020-03-02T07:05:05+0000","dateUpdated":"2022-02-03T03:32:57+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#rekognition","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Rekognition","description":"Amazon Rekognition","dateCreated":"2020-03-02T07:05:04+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL