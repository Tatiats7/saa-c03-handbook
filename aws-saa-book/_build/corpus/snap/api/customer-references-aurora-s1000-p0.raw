,{"item":{"id":"customer-references#concert-ua-case-study","locale":"en_US","directoryId":"customer-references","name":"concert-ua-case-study","dateCreated":"2022-12-05T23:59:03+0000","dateUpdated":"2023-07-14T23:32:36+0000","additionalFields":{"descriptionSummary":"Ukrainian music ticketing firm Concert.ua experienced unexpected spikes in traffic that overwhelmed its website. This left customers unable to complete transactions and affected the company’s revenue and reputation. In addition, its reliance on manual server provisioning made it difficult to quickly scale to meet demand. Since migrating to a serverless architecture built on AWS—and with fully automated scaling—Concert.ua has cut its infrastructure costs and improved customers’ ticket-purchasing experience.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/concert-ua-logo%401x.3f4af42149e28f88ef86291e77f7f72ce65d5063.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"concert ua","footerInfoText":"Published Date","industry":"Retail","sortDate":"2022-12-05","headlineUrl":"https://aws.amazon.com/solutions/case-studies/concert.ua-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Concert UA","publishedDate":"2022","enableShare":"1","headline":"Concert.ua Manages 1000% Traffic Spikes Using AWS Serverless","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#industry#retail","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Retail","description":"Retail","dateCreated":"2020-01-16T17:42:39+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#tech-category#containers","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Containers","description":"Containers","dateCreated":"2020-02-