gnlkef","locale":"en_US","directoryId":"customer-references","name":"gsr05102022lknsefgnlkef","dateCreated":"2023-02-08T01:16:46+0000","dateUpdated":"2023-07-14T23:32:37+0000","additionalFields":{"descriptionSummary":"GSR provides liquidity by connecting to dozens of crypto exchanges around the world. One of the main requirements is fast and secure connectivity to these locations. GSR leverages multiple regions in the AWS Global Infrastructure for physical proximity to exchanges. For the connectivity, GSR uses AWS PrivateLink or AWS Private Connect. GSR also replicates the data across AWS regions using various technologies, including Aurora Global Databases.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/gsr-logo%401x.6a641e2628cd35423810cceeda38e9a8c31f002b.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"gsr zug gmbh","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-05-10","headlineUrl":"https://youtu.be/U1P8vZTEB-k?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"GSR Zug GmbH","publishedDate":"2022","enableShare":"1","headline":"GSR: A Crypto Market Maker and Ecosystem Partner","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#batch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Batch","description":"AWS Batch","dateCreated":"2020-03-02T07:01:42+0000","dateUpdated":"2022-02-03T03:32:19+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","loca