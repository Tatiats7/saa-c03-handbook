ateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#4bill-case-study","locale":"en_US","directoryId":"customer-references","name":"4bill-case-study","dateCreated":"2022-10-03T18:33:49+0000","dateUpdated":"2023-07-14T23:32:34+0000","additionalFields":{"descriptionSummary":"Payment service provider 4bill had trouble dealing with spikes in traffic as demand for its services grew. As a result its retail customers frequently encountered delays in processing payments due to poor latency. Using AWS, 4bill built a cloud solution that quickly adapts to variable demand and ensures customers can reliably receive payments. It has tripled its total customer base, and 98 percent of all online payment transactions complete successfully on the first attempt. Prior to using AWS, this conversion rate was 87 percent.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/4bill-logo%401x.c4231468c772b754092fc3b5396daf074882d5c2.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"4bill","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/4bill-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"4bill","publishedDate":"2022","enableShare":"1","headline":"4bill Scales Up Payment Processing and Triples Customer Base Using AWS","contentType":"Customer Story"}},"tags":[{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#location#ukraine","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Ukraine","description":"Ukraine","dateCreated":"2020-04-09T03:38:21+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-typ