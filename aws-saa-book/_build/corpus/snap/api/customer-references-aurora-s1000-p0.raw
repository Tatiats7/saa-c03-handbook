ks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#best-western-case-study","locale":"en_US","directoryId":"customer-references","name":"best-western-case-study","dateCreated":"2022-07-02T00:20:05+0000","dateUpdated":"2023-07-12T01:40:54+0000","additionalFields":{"descriptionSummary":"Best Western Hotel and Resorts is serious about preventing data breaches. The global hospitality organization, with 18 brands and 4,700 hotels worldwide, needs to protect sensitive customer information to comply with data privacy regulations, including the California Consumer Privacy Act (CCPA) and the General Data Protection Regulation (GDPR).","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/best-western-hotels-logo%401x.2a16e087f07ac938d427eb0a9500c171980016c0.png","displayLocation":"Americas","customerNameLower":"best western","footerInfoText":"Published Date","industry":"Hospitality","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/best-western-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Best Western","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Best Western Uses DataMasque on AWS to Stop Data Breaches and Automate Key Processes"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"