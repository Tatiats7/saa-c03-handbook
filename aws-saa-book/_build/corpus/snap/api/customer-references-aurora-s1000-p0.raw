ent from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#the-pokemon-company-case-study-it","locale":"en_US","directoryId":"customer-references","name":"the-pokemon-company-case-study-it","dateCreated":"2024-11-12T00:54:22+0000","dateUpdated":"2024-11-12T01:13:41+0000","additionalFields":{"descriptionSummary":"The Pokémon Company International ha eseguito la migrazione da un database di documenti NoSQL di terze parti a un servizio di database AWS completamente gestito, riducendo significativamente i costi mensili e passando da 300 a 30 nodi.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/pokemon-logo@1x.fa5637f0681a402b1cead2189ebf54b4f711825f.png","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/the-pokemon-company-case-study/","customer-name":"The Pokémon Company","enableShare":"1","publishedDate":"2020","contentType":"Storia del cliente","headline":"The Pokémon Company esegue la migrazione a database AWS dedicati"}},"tags":[{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+