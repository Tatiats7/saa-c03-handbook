0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#location#chile","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Chile","description":"Chile","dateCreated":"2020-07-02T22:30:55+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"GLOBAL#tech-category#cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-01-16T17:43:13+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#comprehend","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Comprehend","description":"Amazon Comprehend","dateCreated":"2020-03-02T07:02:18+0000","dateUpdated":"2022-02-03T03:32:25+0000"},{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12T02:01:29+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"}]},{"item":{"id":"customer-references#intelimetrica","locale":"en_US","directoryId":"customer-references","name":"intelimetrica","dateCreated":"2023-06-01T23:04:17+0000","dateUpdated":"2023-06-08T04:07:43+0000","additionalFields":{"descriptionSummary":"Intelimétrica es una empresa que desarrolla soluciones de tecnología con un componente de analítica avanzada primordialmente para las industrias de servicios financieros y de logística. La empresa, que también es un Partner certificado de AWS, cuenta con un staff de 40 personas para ayudar a resolver retos de negocios de clientes en México, EE. UU., Colombia, Brasil y Australia. En este video, Mario Gamboa, CEO y Cofundador de Intelimétrica, nos cuenta cómo las soluciones de AWS, con su flexibilidad y capacidad de escalar y operar en la nube, atendió la necesidad que tenía la compañía de integrar información para aplicar algoritmos de machine learning y de analítica avanzada en sus servicios.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/intelimetrica_logo%401x.30917b69704db4ebb8a6f3fe1810d3b2c01d92d7.png","displayLocation":"México","footerInfoText":"Fecha de publicación","industry":"Software e Internet","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/intelimetrica/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Intelimétrica","enableShare":"1","publishedDate":"2020","contentType":"Historia del cliente","headline":"Intelimétrica trabaja con AWS para hacer ofertas tecnológicas más sofisticadas"}},"tags":[{"id":"GLOBAL#location#central-america","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central America","description":"Central America","dateCreated":"2021-02-19T05:32:25+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35: