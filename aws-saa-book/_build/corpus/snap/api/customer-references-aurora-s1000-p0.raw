ent","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#category#network","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2019-07-22T18:32:15+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#vpc-privatelink","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS PrivateLink","description":"AWS PrivateLink","dateCreated":"2020-03-02T07:06:02+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#reference-arch-diagram","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Reference Architecture Diagram","description":"Reference Architecture Diagram","dateCreated":"2020-04-29T05:19:31+0000","dateUpdated":"2022-02-03T03:31:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#swimmingau05092022ljkshneflijas","locale":"en_US","directoryId":"customer-references","name":"swimmingau05092022ljkshneflijas","dateCreated":"2023-02-08T01:16:49+0000","dateUpdated":"2024-03-02T02:48:50+0000","additionalFields":{"descriptionSummary":"Having won 9 gold, 3 silver, and 8 bronze medals along with setting a new world record in the woman\u0027s 4x100 freestyle relay in Tokyo 2021, the Australian Olympic Swim team delivered their most successful Olympic games ever.\nJoin builder Gerardo Estaba on this special episode of This is My Architecture as he explores how Swimming Australia use machine learning in the AWS cloud to assist swimming coaches with their relay order decisions. We explore how historical swimming results and other swimming data are ingested in the cloud, transformed and then used to train a machine learning algorithm that\u0027s queried by coaches using a custom app to help them predict swimming times and the best possible relay order.\n\nWe dive into Swimming Australia\u0027s event-driven architecture for their relay order prediction system, to understand how they ingest, transform and orchestrate data using AWS Glue, AWS Step Functions and Amazon Simple Storage Service (S3). We also learn how they leverage Amazon Athena and Amazon SageMaker to build, train, and deploy the relay order machine learning models, and how they leverage Amazon Aurora, AWS Lambda and Amazon API Gateway to process requests from the coaches application.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/swimming-australia-logo%401x.116d6fce066e744ffc6ba885a1b612087a86679b.png","displayLocation":"Asia Pacific","customerNameLower":"swimming australia","footerInfoText":"Published Date","industry":"Professional Services","sortDate":"2022-05-09","headlineUrl":"https://youtu.be/1VcpCVe3tLQ?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Swimming Australia","publishedDate":"2022","enableShare":"1","headline":"Swimming Australia: Going For Gold With Machine Learning","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Mobile","description":"Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2023-08-22T20:28:38+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000","