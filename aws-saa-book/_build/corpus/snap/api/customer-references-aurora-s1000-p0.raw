nd varnishes in Poland, Belarus, Ukraine, and Hungary. It worked with AWS APN Partner SE16N to build its AWS environment for SAP using AWS Lambda, Amazon EC2, and Amazon Aurora.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Sniezka_Customer-Reference_Logo.8ee5c87bc63fd62a8c40795fb5e185428a1b7ffb.png","displayLocation":"Europe, Middle East, \u0026 Africa","footerInfoText":"Published Date","industry":"Manufacturing","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/Sniezka-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Śnieżka","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Paint Firm Is Primed for International Growth withSAP on AWS"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"