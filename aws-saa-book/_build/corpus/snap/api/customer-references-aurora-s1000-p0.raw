02-03T03:31:07+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#tech-category#arch-strategy","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Architecture Strategy","description":"Architecture Strategy","dateCreated":"2020-01-16T17:43:08+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#moderna-global-summit-case-study","locale":"en_US","directoryId":"customer-references","name":"moderna-global-summit-case-study","dateCreated":"2023-09-06T22:57:05+0000","dateUpdated":"2023-09-07T23:50:15+0000","additionalFields":{"descriptionSummary":"Moderna began using Amazon Web Services (AWS) ten years ago and currently uses AWS services to run its research algorithms, support its digital manufacturing execution system, conduct data analytics in its clinical operations, build full integration of its digital systems, automate processes, and improve decision making with machine learning (ML) and artificial intelligence (AI).","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/moderna-innovator-logo.602bfdd3c41b0e7033e762c3557a5ff0633637d0.png","displayLocation":"United States","customerNameLower":"moderna","footerInfoText":"Published Date","industry":"Life Sciences","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/moderna-global-summit-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Moderna","publishedDate":"2021","enableShare":"1","headline":"Moderna Uses AWS to Develop Next-Gen Drugs","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#directconnect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Direct Connect","description":"AWS Direct Connect","dateCreated":"2020-03-02T07:02:43+0000","dateUpdated":"2022-02-03T03:32:30+0000"},{"id":"GLOBAL#product#efs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic File System (EFS)","description":"Amazon Elastic File System (EFS)","dateCreated":"2020-03-02T07:02:57+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOB