iption":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#cmm-de-universidad-de-chile","locale":"en_US","directoryId":"customer-references","name":"cmm-de-universidad-de-chile","dateCreated":"2023-06-01T23:11:37+0000","dateUpdated":"2023-07-14T23:32:26+0000","additionalFields":{"descriptionSummary":"Hace más de una década, el Centro de Modelamiento Matemático (CMM) de la Universidad de Chile anticipó que las tecnologías de información jugarían un rol fundamental en el desarrollo de la astronomía. De ese modo, los investigadores del CMM apostaron a que la computación en la nube sería un pilar fundamental del futuro de esta ciencia. Desde 2016 han utilizado dicha tecnología comprobando múltiples beneficios en cuanto a flexibilidad e interoperabilidad en sus proyectos de investigación.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/universidad-de-chile%402x.9302729725be7e65b7f5117a9b8b0d4bf2d839f0.png","displayLocation":"Chile","footerInfoText":"Fecha de publicación","industry":"Educación","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/cmm-de-universidad-de-chile/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"Universidad de Chile","contentType":"Historia del cliente","headline":"Proyecto global de astroinformática en la nube AWS promete cambiar el futuro de la sociedad"}},"