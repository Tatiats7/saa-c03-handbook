48+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"}]},{"item":{"id":"customer-references#vtex","locale":"en_US","directoryId":"customer-references","name":"vtex","dateCreated":"2023-06-01T23:05:28+0000","dateUpdated":"2023-06-08T04:07:47+0000","additionalFields":{"descriptionSummary":"A VTEX é uma plataforma comercial global, que trabalha com 2.500 marcas, lojas e empresas, ajudando-as a criar experiencias de e-commerce aos clientes, seja no ambiente B2C ou B2B. Para assegurar que seus clientes entreguem as melhores experiências aos usuários, incluindo ofertas personalizadas, entregas expressas e segurança de dados, a VTEX adota serviços da AWS. Neste vídeo, Amit Shah, diretor de estratégia (CSO) da VTEX, explica os motivos que levaram a empresa à escolha da AWS. Ele detalha a importância de se contar com um provedor com presença global, entre outras características dos serviços AWS. Confira.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/industry/automotive/logos/VTEX.8914cab096469018f9a5cb17157180fe7182d9c5.jpg","displayLocation":"Brasil","customerNameLower":"vtex","footerInfoText":"Data de publicação","industry":"Software e Internet","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/VTEX/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"VTEX","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"VTEX leva serviços de nível global a clientes em todo o mundo com AWS"}},"tags":[{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#product#rekognition","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Rekognition","description":"Amazon Rekognition","dateCreated":"2020-03-02T07:05:04+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notification Service (SNS)","dateCreated":"2020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated