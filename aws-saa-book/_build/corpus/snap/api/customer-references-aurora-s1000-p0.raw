ated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#tui-video","locale":"en_US","directoryId":"customer-references","name":"tui-video","dateCreated":"2020-11-09T18:09:11+0000","dateUpdated":"2023-07-12T01:40:53+0000","additionalFields":{"descriptionSummary":"Tui is one of the world’s largest travel companies, comprising tour operators, travel agencies, online portals, five airlines, over 400 hotels, and 17 cruise liners.The business traces its roots 70 years, but it has never shied away from modernization. During peak booking season, the group’s online operations handle nearly 60 billion searches, serve 400 million product combinations, and update 8 million prices per hour.Tui chose to move to Amazon Web Services (AWS) to improve the customer experience and enhance customer interactions using artificial intelligence (AI).In this video, Elke Reichart, chief digital officer at Tui, explains how the organization handles 18 percent more searches with 35 percent better search performance and saw 31 percent fewer customer complaints using AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/TUI_Customer-Reference_Logo@1x.ca041124ff6784cabbc736869e74ba723fbc6964.png","displayLocation":"Germany","footerInfoText":"Published Date","industry":"Travel \u0026 Hospitality","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/tui-video/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","customer-name":"Tui","contentType":"Customer Story","headline":"Tui Looks to AI for Happier Holidaymakers"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"customer-references#category#database-migration","locale":"en_US","tagNamespaceId":"c