s: SAP","description":"Business Applications: SAP","dateCreated":"2019-07-22T18:31:24+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Auto Scaling","description":"AWS Auto Scaling","dateCreated":"2020-03-02T07:01:39+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#location#chile","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Chile","description":"Chile","dateCreated":"2020-07-02T22:30:55+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notification Service (SNS)","dateCreated":"2020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2022-03-05T03:54:12+0000"}]},{"item":{"id":"customer-references#occmundial","locale":"en_US","directoryId":"customer-references","name":"occmundial","dateCreated":"2023-06-01T23:07:18+0000","dateUpdated":"2023-06-08T04:07:39+0000","additionalFields":{"descriptionSummary":"Online Career Center (OCC) es una empresa mexicana que actúa en la industria del empleo, ocupando la posición de bolsa de trabajo líder en México. Desde hace 22 años, OCC es una empresa en línea, de hecho, una de las primeras startups en línea del país. Cuenta con una cartera de 38 mil clientes que pagan por anunciar sus vacantes y así encontrar los mejores talentos. Por otro lado, OCC ayuda a millones de mexicanos a encontrar un mejor empleo. Desde hace años, la empresa viene evolucionando su cultura y prácticas de desarrollo, inteligencia artificial y operaciones. Para evolucionar en este sentido, OCC necesitaba cambiar los data centers on-premises y utilizar una infraestructura cloud-native. La empresa logró facilitar esta transformación cultural con los servicios y plataforma AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/occ_logo%401x.bb407adebccc14b37f572f384dd0be42c09bbba6.png","displayLocation":"México","footerInfoText":"Fecha de publicación","industry":"Servicios profesionales","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/occmundial/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"Historia del cliente","customer-name":"Online Career Center (OCC)","headline":"OCC utiliza AWS para apoyar la industria de empleos en México"}},"tags":[{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":