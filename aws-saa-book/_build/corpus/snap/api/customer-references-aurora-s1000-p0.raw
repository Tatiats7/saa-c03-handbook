02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"customer-references#innovator#airbnb","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Airbnb","description":"Airbnb","dateCreated":"2022-09-15T00:48:21+0000","dateUpdated":"2022-09-15T00:48:21+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#wappa","locale":"en_US","directoryId":"customer-references","name":"wappa","dateCreated":"2023-06-01T23:06:57+0000","dateUpdated":"2023-06-08T04:07:45+0000","additionalFields":{"descriptionSummary":"A Wappa nasceu há 15 anos com a proposta de revolucionar o mercado de gestão de despesas corporativas com transporte. Desde que migrou seu do banco de dados para Amazon Aurora seu processo de validação de usuários ficou 60% mais rápido, o tempo de report caiu 75% e o processo de pagamento está 70% mais ágil.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/Latam%20Cases%20Assets/WAPPA_Logo.b6672eb04b900c6310ca248e4a53e30fe1bfb0b0.png","displayLocation":"Brasil","footerInfoText":"Data de publicação","industry":"Transporte e logística","sortDate":"2018-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/Wappa/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2018","contentType":"História do cliente","customer-name":"Wappa","headline":"Estudo de caso AWS: Wappa"}},"tags":[{"id":"customer-references#category#database-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Database Migration","description":"Database Mi