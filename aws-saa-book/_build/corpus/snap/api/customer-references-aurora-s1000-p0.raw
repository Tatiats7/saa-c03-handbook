ice (SaaS)-Lösungen von powercloud, die auf AWS laufen, bieten eine bessere Option.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/powercloud-logo%401x.fb28bbdcbe0f132462cf1dfea5482555d9751785.png","displayLocation":"Germany","customerNameLower":"powercloud gmbh","footerInfoText":"Published Date","industry":"Energy","sortDate":"2022-12-08","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/powercloud-case-study/?nc1\u003dh_ls\u0026did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"powercloud GmbH","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"powercloud liefert kundenorientierte Erlebnisse für Versorgungsunternehmen mit AWS"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#germany","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Germany","description":"Germany","dateCreated":"2020-02-03T05:29:55+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Euro