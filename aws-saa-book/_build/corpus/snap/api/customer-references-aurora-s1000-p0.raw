S CodeDeploy","description":"AWS CodeDeploy","dateCreated":"2020-03-02T07:02:12+0000","dateUpdated":"2022-02-03T03:32:24+0000"},{"id":"GLOBAL#product#budgets","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Budgets","description":"AWS Budgets","dateCreated":"2020-03-02T07:01:44+0000","dateUpdated":"2022-02-03T03:32:19+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#connect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Connect","description":"Amazon Connect","dateCreated":"2020-03-02T07:02:22+0000","dateUpdated":"2022-02-03T03:32:26+0000"},{"id":"GLOBAL#use-case#general-database-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"General Database Migration","description":"General Database Migration","dateCreated":"2020-06-05T06:37:24+0000","dateUpdated":"2022-02-03T03:35:41+0000"},{"id":"customer-references#category#business-applications-ec2-windows-server","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: EC2 Windows Server","description":"Business Applications: EC2 Windows Server","dateCreated":"2019-07-22T18:31:09+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#product#organizations","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Organizations","description":"AWS Organizations","dateCreated":"2020-03-02T07:04:43+0000","dateUpdated":"2022-02-03T03:32:53+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"}]},{"item":{"id":"customer-references#jps","locale":"en_US","directoryId":"customer-references","name":"jps","dateCreated":"2023-06-01T23:06:05+0000","dateUpdated":"2023-06-08T04:07:40+0000","additionalFields":{"descriptionSummary":"Jamaica Public Service (JPS) es el único distribuidor de electricidad en Jamaica. Hace aproximadamente tres años, la empresa tenía el desafío de poner una gran cantidad de información disponible para todos sus clientes. Con el apoyo de AWS, la compañía comenzó su camino hacia la transformación digital, moviendo su servicio al cliente de una manera rápida y eficiente, así como mejorando su rentabilidad a través de la nube AWS. Garry Barrow, director de operaciones en JPS, y Phillip Hamilton, especialista en TI para Infraestructura de la compañía, explican cómo lograron la capacidad de brindar soluciones en cuestión de minutos en lugar de semanas y ahorrar en almacenamiento al menos un 40%.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/JPS-logo%401x.3478528beeb40acda015c33b78052ade26565ed5.png","customerNameLower":"jps","footerInfoText":"Fecha de publicación","industry":"Energía","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/jps/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"JPS","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"AWS ayuda a transformar JPS de una organización tradicional a una digital"}},"tags":[{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":