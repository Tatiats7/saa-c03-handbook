000"},{"id":"customer-references#innovator#general-electric","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"General Electric","description":"General Electric","dateCreated":"2022-09-15T00:48:30+0000","dateUpdated":"2022-09-15T00:48:30+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"GLOBAL#industry#energy","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Energy","description":"Energy","dateCreated":"2020-07-15T21:58:51+0000","dateUpdated":"2022-02-03T03:32:02+0000"},{"id":"GLOBAL#industry#power-utilities","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Power \u0026 Utilities","description":"Power \u0026 Utilities","dateCreated":"2020-01-16T17:42:37+0000","dateUpdated":"2022-02-03T03:32:08+0000"}]},{"item":{"id":"customer-references#aws-case-study-general-electric-s-digital-transformation-it","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-general-electric-s-digital-transformation-it","dateCreated":"2024-11-12T00:53:54+0000","dateUpdated":"2024-11-12T01:13:41+0000","additionalFields":{"descriptionSummary":"General Electric (GE) opera in 180 paesi ed è un azienda leader nella produzione ad impiego industriale da oltre un secolo. Grazie a una combinazione di software, analisi e ingegneria di prim\u0027ordine, GE aiuta le aziende di tutto il mondo a lavorare in modo più efficiente, affidabile e sicuro. L’impresa utilizza oltre 2000 applicazioni cloud e 55 servizi AWS per aumentare la portata, l’efficienza e le prestazioni nei settori dell\u0027aviazione, dell\u0027energia elettrica, della sanità e dell\u0027energia rinnovabile.","featureImageURL":"https://d1.awsstatic.com/aws-key-pages/homepage-key-pages/customer-stories-logo/GE.69d638be1bb211236c8d87590e8ee0be001b543c.jpg","featured":"0","im