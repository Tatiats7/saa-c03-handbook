red":"0","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/too-good-to-go-logo%401x.c3c4e672e354198bc93e7898fe585619d3525831.png","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/too-good-to-go-logo%401x.c3c4e672e354198bc93e7898fe585619d3525831.png","displayLocation":"Denmark","customerNameLower":"too good to go","footerInfoText":"Published Date","industry":"Hospitality","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/too-good-to-go-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Too Good To Go","publishedDate":"2023","enableShare":"1","headline":"Saving 250 Million Meals from Waste Using AWS Managed Services with Too Good To Go","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#location#nordics","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Nordics","description":"Nordics","dateCreated":"2020-02-03T05:30:04+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#location#denmark","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Denmark","description":"Denmark","dateCreated":"2020-02-03T05:30:06+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":