spaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"}]},{"item":{"id":"customer-references#save-the-children-spain-devoteam-2025","locale":"en_US","directoryId":"customer-references","name":"save-the-children-spain-devoteam-2025","dateCreated":"2025-02-20T21:50:56+0000","dateUpdated":"2025-03-07T01:09:54+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eSave the Children Spain, part of a global NGO protecting children\u0026rsquo;s rights, faced challenges with its on-premises data management system. Unable to effectively integrate and analyze information from multiple sources, it struggled to personalize donor outreach and optimize fundraising. Partnering with AWS Premier Consulting Partner Devoteam, it implemented a cloud-based data-lake solution using Amazon Web Services (AWS). This transformation enabled seamless data integration, enhanced donor insights, and improved campaign effectiveness. The new system streamlined operations, reduced costs, and allowed Save the Children Spain to redirect more resources to humanitarian projects, benefiting children in need worldwide.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Save%20the%20Children%20Logo%20200x70px.491babb980be27c18da5181b4073e5658ef5d2f5.png","displayLocation":"Spain","footerInfoText":"2025","industry":"General Public Services","sortDate":"2025-02-20","headlineUrl":"https://aws.amazon.com/solutions/case-studies/save-the-children-spain-devoteam/","customer-name":"Save the Children Spain","enableShare":"1","publishedDate":"2025","contentType":"Case Study","headline":"Save the Children Spain Cuts Costs and Improves Campaigns with Devoteam’s AWS-Powered Data Solution"}},"tags":[{"id":"GLOBAL#location#spain","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Spain","description":"Spain","dateCreated":"2020-02-03T05:30:16+0000","dateUpdated":"2022-02-03T03:31:49+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#industry#general-public-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"General Public Services","description":"General Public Services","dateCreated":"2020-01-16T17:42:24+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#product#appflow","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon AppFlow","description":"Amazon AppFlow","dateCreated":"2020-06-25T04:09:13+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#database-migration-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Database Migration Service (DMS)","description":"AWS Database Migration Service (DMS)","dateCreated":"2020-03-02T07:02:30+0000","dateUpdated":"2022-02-03T03:32:27+0000"},{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notification Service (SNS)","dateCreated":"2020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#eventbridge","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EventBridge","description":"Amazon EventBridge","dateCreated":"2020-03-02T07:03:23+0000","dateUpdated":"2022-02-03T03:32:36+0000"}]},{"item":{"id":"customer-references#ladbrokes-live-cloudar-2025","locale":"en_US","directoryId":"customer-references","name":"ladbrokes-live-cloudar-2025","dateCreated":"2025-02-20T20:57:19+0000","dateUpdated":"2025-03-06T23:49:23+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eLadbrokes.live, a provider of streaming sports entertainment content operating in Belgium, was grappling with critical challenges that hindered their ability to attract and retain users. Partnering with AWS Partner, Cloudar\u0026mdash;also based in Belgium\u0026mdash;the company transitioned to a cloud-native architecture powered by Amazon Web Services (AWS) technologies. This transformation enabled Ladbrokes.live to deliver a seamless, personalized user experience featuring avatars that can be customized to deliver information and statistics relevant to the viewers\u0026rsquo; interests, in their language of choice. The solution also helped Ladbrokes.live optimize operational costs and set the stage for continuous innovation in a highly competitive industry.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Ladbrokes%20Logo%20200x70px.f8991b1082a6e0d87051aac41a8dfa2928a3d970.png","displayLocation":"Belgium","footerInfoText":"2025","industry":"Media \u0026 Entertainment","sortDate":"2025-02-20","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ladbrokes-live-cloudar/","customer-name":"Ladbrokes.Live","enableShare":"1","publishedDate":"2025","contentType":"Case Study","headline":"Cloudar Helps Ladrokes.live Transform The Sports Fan Experience With Cloud-Native Scalability"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#bedrock","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Bedrock","description":"Amazon Bedrock","dateCreated":"2023-04-13T19:06:46+0000","dateUpdated":"2023-04-13T19:06:46+0000"},{"id":"GLOBAL#tech-category#analytics","locale