resas de energia do País, a Votorantim Energia iniciou uma nova jornada de transformação, que culminou na criação do programa Vértice, que prevê a substituição de sistemas legados e digitalização de processos de sua Comercializadora por uma nova plataforma analítica baseada na nuvem AWS.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/votorantim-energia-logo%402x.1282d2545f3324ea9ff3cfe0a6c7bca60d7661e0.png","displayLocation":"Brasil","footerInfoText":"Data de publicação","industry":"Energia e serviços públicos","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/votorantim-energia/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"Votorantim Energia","contentType":"História do cliente","headline":"Votorantim Energia desenvolve programa de transformação digital baseado na nuvem e serviços AWS"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#industry#power-utilities","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Power \u0026 Utilities","description":"Power \u0026 Utilities","dateCreated":"2020-01-16T17:42:37+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#