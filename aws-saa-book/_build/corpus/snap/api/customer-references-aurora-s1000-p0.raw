ustomer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#workload#sap","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"SAP","description":"SAP","dateCreated":"2021-01-06T00:09:56+0000","dateUpdated":"2022-02-03T03:36:05+0000"},{"id":"GLOBAL#location#indonesia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Indonesia","description":"Indonesia","dateCreated":"2020-02-03T05:29:22+0000","dateUpdated":"2022-02-03T03:31:36+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"IoT","description":"IoT","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"}]},{"item":{"id":"customer-references#jooycar","locale":"en_US","directoryId":"customer-references","name":"jooycar","dateCreated":"2023-06-01T23:11:01+0000","dateUpdated":"2023-06-08T04:07:34+0000","additionalFields":{"descriptionSummary":"Jooycar se funda en 2014 con el reto de entregar seguros de auto de una forma distinta y revolucionar la forma a través de la cual las personas se relacionan con un seguro de auto. A partir del 2018, Jooycar experimenta un crecimiento muy acelerado al identificar que los usuarios de su tecnología pagaban un 40% menos por su seguro. La empresa evolucionó sus servicios y multiplicó en promedia cada año en tres veces su volumen con una infraestructura basada en Amazon Web Services. Rodrigo Labbé, CEO de Jooycar, y Gonzalo Vásquez, CTO de la empresa, explican cuáles son los principales servicios utilizados por la compañía y cómo AWS le ha permitido triplicar su cartera de clientes sin problemas de infraestructura y aun reduciendo el costo individual por usuario.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/jooycar-logo%401x.24703b2a40081684bda2fc28615b225847e25137.png","displayLocation":"Chile","footerInfoText":"Fecha de publicación","industry":"Semiconductors","sortDate":"2021-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/jooycar/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"Historia del cliente","customer-name":"Jooycar","headline":"Jooycar triplica negocios a la vez de lograr reducir costos con AWS"}},"tags":[{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"customer-references#category#batch-processing","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Batch Processing","description":"Batch Processing","dateCreated":"2019-07-22T18:31:02+0000","dateUpdated":"2022-02-26T01:35:02+0000"},{"id":"GLOBAL#product#ecr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Registry (ECR)","description":"Amazon Elastic Container Registry (ECR)","dateCreated":"2020-03-02T07:02:55+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#product#cost-usage-report","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Cost and Usage Report","description":"AWS Cost and Usage Report","dateCreated":"2020-03-02