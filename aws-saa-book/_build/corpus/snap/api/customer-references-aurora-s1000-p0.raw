locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#universidad-tecnologica-de-honduras","locale":"en_US","directoryId":"customer-references","name":"universidad-tecnologica-de-honduras","dateCreated":"2023-06-01T23:10:20+0000","dateUpdated":"2023-07-14T23:32:26+0000","additionalFields":{"descriptionSummary":"La Universidad Tecnológica de Honduras es una de las universidades más grandes del país latinoamericano, con 25 mil estudiantes matriculados. La institución educativa es reconocida por la calidad de su educación y por tener a todos sus profesores con al menos una maestría para impartir clases y todas las direcciones con doctorado, además de la vanguardia tecnológica que han implementado desde hace muchos años. Como pioneros de las clases en línea y diversas soluciones tecnológicas relacionadas a su ámbito, la UTH adoptó servicios en la nube de AWS para innovar y brindar aún mejores experiencias de enseñanza en línea a los alumnos.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/Universidad-Tecnologica-de-Honduras-logo%402x.44e635bd6db1ff49bead4ba3a38032da73c72adb.png","displayLocation":"Latinoamérica","footerInfoText":"Fecha de publicación","industry":"Educación","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/Universidad-Tecnologica-de-Honduras/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"Universidad Tecnologica de Honduras","contentType":"Historia del cliente","headline":"UTH ofrece educación online eficaz para más de 25 mil alumnos, gracias a la nube de AWS"}},"tags":[{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000",