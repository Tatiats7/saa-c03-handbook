Updated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#workload#sap","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"SAP","description":"SAP","dateCreated":"2021-01-06T00:09:56+0000","dateUpdated":"2022-02-03T03:36:05+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"}]},{"item":{"id":"customer-references#clubpremier","locale":"en_US","directoryId":"customer-references","name":"clubpremier","dateCreated":"2020-11-05T23:25:09+0000","dateUpdated":"2023-07-12T01:35:41+0000","additionalFields":{"featured":"0","descriptionSummary":"Al posicionarse como el programa líder de lealtad de coalición en México, Club Premier permite a los 6.7 millones de Socios cambiar los Puntos acumulados por un sin número de beneficios, que van desde vuelos hasta catas de vino, cenas incomparables, artículos de la tienda en línea, hospedaje, cruceros y más. En 2018, la compañía decidió asumir la gestión de su motor de reservaciones para que nuevos servicios, funciones y ofertas fueran rápidamente creados y entregados a los Socios, garantizando experiencias memorables a esos clientes. Como parte de esta estrategia, Club Premier eligió la tecnología de Amazon Web Services como estándar para la creación de una arquitectura en la nube, servicios de análisis de datos y modelos “agile” de desarrollo como estándar.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/clubpremier_Logo%401x.10099450002f0abbcbec963c412b9086b4a52a21.png","displayLocation":"México","footerInfoText":"Fecha de publicación","industry":"Viajes","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/clubpremier/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"CLUB PREMIER","enableShare":"1","publishedDate":"2020","contentType":"Historia del cliente","headline":"Club Premier: 30% menos costos y 25% más eficiencia en desarrollo con infraestructura AWS"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"customer-references#category#customer-engagement","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2019-07-22T18:31:37+0000","dateUpdated":"2022-03-21T23:37:45+0000"},{"id":"GLOBAL#business-category#cloud-cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-06-05T07:06:41+0000","dateUpdated":"2022-02-03T03:31:02+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","des