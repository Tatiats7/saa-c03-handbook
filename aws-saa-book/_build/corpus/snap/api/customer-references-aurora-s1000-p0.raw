AL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"}]},{"item":{"id":"customer-references#wellola-case-study","locale":"en_US","directoryId":"customer-references","name":"wellola-case-study","dateCreated":"2024-06-12T18:23:58+0000","dateUpdated":"2024-06-13T17:12:07+0000","additionalFields":{"descriptionSummary":"Dublin-based health software provider Wellola believes communication is key to healthcare. It built its patient communication and care platform Portasana on Amazon Web Services (AWS) to benefit from scale, resilience, and ISO compliance in the AWS Cloud. Using AWS, says CEO Sonia Neary, Wellola has the confidence to securely handle sensitive, personally identifiable health information and serve healthcare organizations including National Health Services (NHS) Trusts.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/wellola%20logo%401x.6b4f6444f655f51b72fa63bbc69422563c8379b8.png","featured":"0","imageSrcUrl":"https://aws.amazon.com/solutions/case-studies/wellola-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","displayLocation":"Europe","customerNameLower":"wellola","footerInfoText":"Published Date","industry":"Healthcare","customer-name":"Wellola","enableShare":"1","publishedDate":"2023","headline":"Wellola Protects Data, Scales to Serve Leading Healthcare Organizations Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#climate-x-data-protection","locale":"en_US","directoryId":"customer-references","name":"climate-x-data-protection","dateCreated":"2024-06-12T18:23:44+0000","dateUpdated":"2024-09-18T00:53:32+0000","additionalFields":{"descriptionSummary":"Climate X provides climate risk data and analytics to help customers quantify the probability of severe weather events. It chooses to work with technologies that support security, stability, and speed. And it uses Amazon Web Services (AWS) for all these reasons. Data security and residency are important factors for its customers, and Aatish Thakerar, engineering director, says the startup can store, process, and protect data wherever it needs to using AWS.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/climate-x-logo%401x.1ebb3bae7780da15a2599e9e4ca22bba228be42b.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/climate-x-logo%401x.1ebb3bae7780da15a2599e9e4ca22bba228be42b.png","displayLocation":"Europe","customerNameLower":"climate x","footerInfoText":"Published Date","industry":"Software \u0026 Internet","headlineUrl":"https://aws.amazon.com/solutions/case-studies/climate-x-data-protection/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Climate X","enableShare":"