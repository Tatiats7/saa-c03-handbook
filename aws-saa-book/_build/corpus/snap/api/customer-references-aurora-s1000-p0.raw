gory#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"}]},{"item":{"id":"customer-references#leadinfo-case-study","locale":"en_US","directoryId":"customer-references","name":"leadinfo-case-study","dateCreated":"2022-06-27T20:43:55+0000","dateUpdated":"2022-06-27T20:55:55+0000","additionalFields":{"descriptionSummary":"Leadinfo is a Netherlands-based scale-up that helps B2B customers—from sports organizations, to digital marketing agencies, to heavy industry businesses in steel and packaging—target sales prospects by analyzing information about website visitors. It saw its business grow quickly after the COVID-19 pandemic put a stop to many face-to-face sales calls. By migrating its customer data from multiple databases on AWS to Amazon Aurora, Leadinfo reduced its monthly IT costs by 30 percent while improving developer efficiency by 50 percent. This has helped it to quickly roll out new features for customers and build a foundation for continued business growth.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/leadinfo-logo%401x.77ef5808c84cefac08c926994e9399247dfce8fe.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"leadinfo","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-06-24","headlineUrl":"https://aws.amazon.com/solutions/case-studies/leadinfo-case-study-2022/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Leadinfo","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Leadinfo Saves 30% on IT Costs, Improves Developer Efficiency by 50% Using AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#product#quicksight","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon QuickSight","description":"Amazon QuickSight","dateCreated":"2020-03-02T07:04:56+0000","dateUpdated":"2022-02-03T03:32:55+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#benelux","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Benelux","description":"Benelux","dateCreated":"2020-02-03T05:29:47+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#jump","locale":"en_US","directoryId":"customer-references","name":"jump","dateCreated":"2023-07-17T23:44:59+0000","dateUpdated":"2023-08-11T22:26:57+0000","additionalFields":{"videoSrcUrl":"https://www.youtube.com/watch?v\u003d6Uq9Qvtzitw","descriptionSummary":"\u003cp\u003eJump facilite le quotidien des personnes souhaitant devenir freelances en leur proposant de les embaucher en CDI - tout en restant leur propre patron sans avoir \u0026agrave; g\u0026eacute;rer le volet administratif. Sebastian CACERES, CTO chez Jump, partage l\u0026rsquo;ambition de multiplier par 5 le nombre de salari\u0026eacute;s freelances d\u0026rsquo;ici fin 2022. Sa probl\u0026eacute;matique principale : rester proche des clients en proposant une disponibilit\u0026eacute; en continue et une structure pour ses utilisateurs. Le Cloud AWS a su fournir les fonctionnalit\u0026eacute;s permettant \u0026agrave; Jump de r\u0026eacute;pondre \u0026agrave; ses besoins de haute disponibilit\u0026eacute;, flexibilit\u0026eacute;, scalabilit\u0026eacute; et de s\u0026eacute;curit\u0026eacute; pour un investissement moindre en amont. Le passage au cloud a eu pour effet d\u0026rsquo;offrir plus d\u0026rsquo;agilit\u0026eacute; \u0026agrave; Jump en leur permettant de faire du test and learn gr\u0026acirc;ce aux diff\u0026eacute;rentes fonctionnalit\u0026eacute;s et services propos\u0026eacute;s. Jump souhaite aller plus loin et s\u0026rsquo;int\u0026eacute;resse aujourd\u0026rsquo;hui \u0026agrave; l\u0026rsquo;architecture bas\u0026eacute;e sur des \u0026eacute;v\u0026eacute;nements, la scalabilit\u0026eacute; et les services \u0026agrave; l\u0026rsquo;\u0026eacute;chelle mondiale.\u003c/p\u003e\r\n","featured":"0","featureImageURL":"https://i.ytimg.com/vi/6Uq9Qvtzitw/maxresdefault.jpg","imageSrcUrl":"https://d1.awsstatic.com/%c3%89tude%20de%20cas%20AWS%20%20Jump.ba964f2b5a82506027f093a6dd39620de314eb70.jpg","displayLocation":"France","customerNameLower":"jump","footerInfoText":"Date de publication","industry":"Services professionnels","sortDate":"2022-06-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/jump/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Jump","enableShare":"1","publishedDate":"2022","contentType":"Témoignages clients","headline":"Jump : Une solution innovante pour les freelances en recherche d’une proximité client toujours plus forte"}},"tags":[{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#product#lightsail","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Lightsail","description":"Amazon Lightsail","dateCreated":"2020-03-02T07:04:25+0000","dateUpdated":"2022-02-03T03:32:47+0000"},{"id":"GLOBAL#product#gamelift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon GameLift","description":"Amazon GameLift","dateCreated":"2020-03-02T07:03:36+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#product#deep-learning-containers","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Deep Learning Containers","description":"AWS Deep Learning Containers","dateCreated":"2020-03-02T07:02:37+0000","dateUpdated":"2022-02-03T03:32:28+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#product#codepipeline","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodePipeline","description":"AWS CodePipeline","dateCreated":"2020-03-02T07:02:13+0000","dateUpdated":"2022-02-03T03:32:25+0000"},{"id":"GLOBAL#product#transfer-sftp","locale":"en_