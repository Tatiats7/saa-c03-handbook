:{"id":"customer-references#samtrafiken","locale":"en_US","directoryId":"customer-references","name":"samtrafiken","dateCreated":"2024-02-21T00:56:00+0000","dateUpdated":"2024-02-21T01:09:14+0000","additionalFields":{"descriptionSummary":"Samtrafiken developed a digital ticket distribution solution using AWS services, delivering a modern ticketing experience to travelers on Sweden’s national railway line. Samtrafiken coordinates ticketing for multimodal transport throughout the country’s 21 regions. To fulfill its mission of connecting all the public transportation entities, Samtrafiken needed a cloud solution that was scalable and simple to use. By using serverless AWS solutions, Samtrafiken maintains 99.99 percent uptime, reduces network latency, and boosts developer productivity.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/samtrafiken-logo%401x.cdf1bfa709ef192d9443271489557902c87c7798.png","displayLocation":"Sweden","customerNameLower":"samtrafiken","footerInfoText":"Published Date","industry":"Travel","sortDate":"2024-01-11","headlineUrl":"https://aws.amazon.com/solutions/case-studies/samtrafiken/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Samtrafiken","publishedDate":"2024","enableShare":"1","headline":"Building a Scalable Solution for Digital Ticket Distribution Using AWS with Samtrafiken","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#nordics","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Nordics","description":"Nordics","dateCreated":"2020-02-03T05:30:04+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#location#sweden","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Sweden","description":"Sweden","dateCreated":"2020-02-03T05:30:11+0000","dateUpdated":"2022-02-03T03:31:51+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0