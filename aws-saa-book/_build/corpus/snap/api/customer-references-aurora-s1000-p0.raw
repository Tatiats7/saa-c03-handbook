2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#industry#life-sciences","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Life Sciences","description":"Life Sciences","dateCreated":"2020-01-16T17:42:31+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#tableau-case-study","locale":"en_US","directoryId":"customer-references","name":"tableau-case-study","dateCreated":"2021-03-13T00:30:19+0000","dateUpdated":"2023-07-20T21:56:25+0000","additionalFields":{"featured":"0","descriptionSummary":"Tableau migrated its hybrid data infrastructure—starting with Tableau Online—to a single AWS solution and then went all in on AWS companywide, which improved performance and cut costs.","imageSrcUrl":"https://d1.awsstatic.com/Tableau%201x%20logo.6bc28a3ac194e13374128d3e80a154fe379d1683.png","displayLocation":"North America","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2021-03-12","headlineUrl":"https://aws.amazon.com/solutions/case-studies/tableau-online-migration-case-study?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Salesforce","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Tableau uses AWS to Scale Faster and Increase Resiliency of SaaS Offering"}},"tags":[{"id":"customer-references#customer-segment#strategic","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Strategic","description":"Strategic","dateCreated":"2019-07-22T18:39:52+0000","dateUpdated":"2022-04-02T00:32:18+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#product#elb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Elastic Load Balancing (ELB)","description":"Elastic Load Balancing (ELB)","dateCreated":"2020-03-02T07:03:09+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T