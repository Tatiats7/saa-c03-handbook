roduct#marketplace","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Marketplace","description":"AWS Marketplace","dateCreated":"2020-12-02T20:02:51+0000","dateUpdated":"2022-02-03T03:32:50+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#location#nordics","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Nordics","description":"Nordics","dateCreated":"2020-02-03T05:30:04+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#industry#enviro-protection","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Environmental Protection","description":"Environmental Protection","dateCreated":"2020-06-25T04:06:38+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#use-case#sustainability","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Sustainability","description":"Sustainability","dateCreated":"2021-07-02T05:53:58+0000","dateUpdated":"2022-02-03T03:35:58+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"}]},{"item":{"id":"customer-references#continental","locale":"en_US","directoryId":"customer-references","name":"continental","dateCreated":"2024-09-26T20:53:41+0000","dateUpdated":"2024-10-14T23:50:47+0000","additionalFields":{"descriptionSummary":"From one of the most recognized tire brands in the world to a connected mobility pioneer, Continental has seen success from 1871 to today thanks to its constant evolution. Using Amazon Web Services (AWS), the company has embraced the cloud and accelerated a software-driven vision. It built modular solution Continental Automotive Edge (CAEdge), which connects vehicles to the cloud and provides a virtual workbench to speed development from weeks to hours. And, by embarking on an organization-wide upskilling program and engaging with AWS Skills Guild, thousands of employees have generated more than 100 innovative business proposals. For Continental, investing in cloud capabilities means investing in its future as a key provider of intelligent connectivity for the automotive industry.","featureImageURL":"https://d1.awsstatic.com/continental-innovator-card.cfbdbc2c8216cc8bf13f9c5dfba701b603c45417.jpg","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/CONTINENTAL-Logo_black_200x70_1X.8a46411b5867d4c9c928c449c5991db64538ffe8.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"continental","footerInfoText":"Published Date","description":"\u003cp\u003eInvesting in its future as a key provider of intelligent connectivity for the automotive industry.\u003c/p\u003e\n","industry":"Automotive","sortDate":"2024-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/innovators/continental/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Continental","publishedDate":"2024","enableShare":"1","headline":"Continental on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#glue","local