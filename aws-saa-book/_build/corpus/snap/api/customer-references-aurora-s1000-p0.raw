reated":"2022-05-23T21:43:18+0000","dateUpdated":"2023-07-12T01:35:38+0000","additionalFields":{"descriptionSummary":"An exploration of using a serverless pipeline from a customer order (perhaps on a mobile phone) to the restaurant, to the delivery driver. This architecture integrates API Gateway, EventBridge, Lambda, Step-Functions and geofencing to fulfill orders on time at scale at low cost. Disclaimer: Taco Bell\u0027s facts and figures detailed during the course of this presentation have been approximated and were used for illustrative purposes only.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/taco-bell_Logo%401x.d2526e7661a600cddf762dd287401a17b0ddc107.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Hospitality","sortDate":"2021-07-19","headlineUrl":"https://youtu.be/sezX7CSbXTg?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"YUM Brands - Taco Bell Inc.","contentType":"Customer Story","headline":"Taco Bell: Order Middleware - Enabling Delivery Orders at Massive Scale"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#locat