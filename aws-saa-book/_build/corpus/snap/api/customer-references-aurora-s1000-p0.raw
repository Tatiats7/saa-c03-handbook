-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"}]},{"item":{"id":"customer-references#enersis-sustainability-case-study","locale":"en_US","directoryId":"customer-references","name":"enersis-sustainability-case-study","dateCreated":"2024-02-20T00:04:43+0000","dateUpdated":"2025-03-06T23:23:19+0000","additionalFields":{"descriptionSummary":"Although countries have reported their climate actions since 1990, the Paris Agreement, a treaty aiming to reduce climate change, mandates a consensus climate goal for all signatories starting in 2024. To facilitate the transition for cities, regions, and utility providers, Swiss climate-technology pioneer enersis built gaia.\ngaia provides a digital representation of physical objects—called a digital twin—so customers can understand current greenhouse gas emission sources, summarized through a dashboard. As a result, they can draw insights and track progress toward climate goals.","featured":"0","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/enersis-climate-intelligence-logo%401x.66214af102513263c38b00c154c2741cce3787af.png","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/enersis-climate-intelligence-logo%401x.66214af102513263c38b00c154c2741cce3787af.png","displayLocation":"Europe","customerNameLower":"enersis","footerInfoText":"Published Date","industry":"Energy","headlineUrl":"https://aws.amazon.com/solutions/case-studies/enersis-sustainability-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"enersis","enableShare":"1","publishedDate":"2023","headline":"enersis Paves the Way for Greener Cities with gaia, a Climate Solution Built on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+000