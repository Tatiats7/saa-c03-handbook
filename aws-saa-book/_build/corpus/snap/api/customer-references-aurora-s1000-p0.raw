"2022-07-02T00:19:46+0000","dateUpdated":"2023-07-14T23:32:36+0000","additionalFields":{"descriptionSummary":"OLX Autos switched from a multi-cloud to a single-cloud environment on AWS to reduce engineering complexity, eliminate downtime and lags, and save $333,000 per year. OLX Autos is a global marketplace for buying and selling used vehicles and belongs to the OLX Group.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/olx_logo%401x.c054fbd789e2d21d6883cc18aa6092ec1af57bc5.png","displayLocation":"India","customerNameLower":"olx autos","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/olx-autos-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"OLX Autos","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"OLX Autos Consolidates Workloads on AWS to Improve Stability and Reduce Operational Complexity"}},"tags":[{"id":"GLOBAL#product#mq","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon MQ","description":"Amazon MQ","dateCreated":"2020-03-02T07:04:38+0000","dateUpdated":"2022-02-03T03:32:51+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","n