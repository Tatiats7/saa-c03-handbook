ion":"Amazon GuardDuty","dateCreated":"2020-03-02T07:03:46+0000","dateUpdated":"2022-02-03T03:32:40+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"customer-references#innovator#picpay","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"PicPay","description":"\u003cp\u003eInnovator introduced in 2023.\u003c/p\u003e\n","dateCreated":"2023-08-10T19:04:30+0000","dateUpdated":"2023-08-10T19:04:30+0000"}]},{"item":{"id":"customer-references#vodfactory-video","locale":"en_US","directoryId":"customer-references","name":"vodfactory-video","dateCreated":"2023-07-18T00:06:06+0000","dateUpdated":"2023-08-11T22:26:57+0000","additionalFields":{"videoSrcUrl":"https://youtu.be/VPAEJXb8FGk","descriptionSummary":"\u003cp\u003eFond\u0026eacute; \u0026agrave; Paris en 2013, VOD Factory est le sp\u0026eacute;cialiste de la vid\u0026eacute;o \u0026agrave; la demande en France. S\u0026rsquo;appuyant sur AWS pour d\u0026eacute;velopper sa solution \u0026quot;Otto\u0026quot;, VOD Factory permet aux propri\u0026eacute;taires de contenu de cr\u0026eacute;er leur propre plateforme de streaming. \u0026Eacute;galement \u0026eacute;diteur de services SVOD (Queerscreen, Shadowz, Spicee), VOD Factory est ainsi en mesure de faire b\u0026eacute;n\u0026eacute;ficier \u0026agrave; ses clients de sa propre exp\u0026eacute;rience m\u0026eacute;tier. Amen\u0026eacute; \u0026agrave; accueillir un nombre important et variable de connexions, VOD Factory tire parti de l\u0026rsquo;\u0026eacute;lasticit\u0026eacute; du Cloud AWS pour adapter son infrastructure \u0026agrave; la demande et garantir \u0026agrave; ses utilisateurs performance et disponibilit\u0026eacute; dans le monde entier. Dans cette vid\u0026eacute;o, Julien Vin-Ramarony, Pr\u0026eacute;sident de VOD Factory, nous explique pourquoi ses \u0026eacute;quipes ont fait appel \u0026agrave; AWS et nous \u0026eacute;claire sur les d\u0026eacute;fis que son entreprise souhaite relever \u0026agrave; l\u0026#39;avenir.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/VOD%20Factory%20-%20logo.302dad665c7b364e85940ceab56b226a4f5fc51e.png","displayLocation":"Europe, Moyen-Orient et Afrique","footerInfoText":"Date de publication","industry":"Logiciels et Internet","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/vodfactory-video/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"VOD Factory","enableShare":"1","publishedDate":"2021","contentType":"Témoignages clients","headline":"VOD Factory : l\u0027histoire d\u0027une solution clé en main pour créer sa propre plateforme de streaming"}},"tags":[{"id":"GLOBAL#product#elastic-inference","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Inference","description":"Amazon Elastic Inference","dateCreated":"2020-03-02T07:03:04+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#product#savings-plans","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Savings Plans","description":"Savings Plans","dateCreated":"2021-09-27T07:50:42+0000","dateUpdated":"2022-02-03T03:32:59+0000"},