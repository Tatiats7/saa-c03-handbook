:"GLOBAL#location#australia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia","description":"Australia","dateCreated":"2020-02-03T05:29:12+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#anz","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia \u0026 New Zealand","description":"Australia \u0026 New Zealand","dateCreated":"2020-04-09T00:26:11+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#minnesota-data-lakes-video","locale":"en_US","directoryId":"customer-references","name":"minnesota-data-lakes-video","dateCreated":"2022-01-08T04:31:35+0000","dateUpdated":"2023-07-12T01:35:18+0000","additionalFields":{"descriptionSummary":"The Minnesota Department of Health (MDH) is responsible for Minnesotans\u0027 public health, including disease control and prevention, environmental health, public policy, and regulation of health care providers. In partnership with Minnesota IT Services—the state\u0027s information technology agency, which sets IT strategy, direction, policies, and standards—MDH built a unified solution to obtain secure, consistent access to curated health data on Amazon Web Services (AWS). Using data lakes on AWS, MDH is able to group data from subsystems to support the creation of the governor’s COVID-19 report, deliver notifications of exposure to COVID-19, host a staging area between the disease surveillance system and other systems, act as an access point for researchers and epidemiologists, and more.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/mn-minnesota-logo%401x.578d55599bbc00601a55e0a6f8615014c95f82e1.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2022-01-07","headlineUrl":"https://aws.amazon.com/solutions/case-studies/minnesota-data-lakes-video/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","customer-name":"Minnesota Department of Health and IT Services","contentType":"Customer Story","headline":"Minnesota Department of Health and IT Services Improve Data Availability on AWS"}},"tags":[{"id":"GLOBAL#product#security-hub","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Security Hub","description":"AWS Security Hub","dateCreated":"2020-03-02T07:05:15+0000","dateUpdated":"2022-02-03T03:32:59+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#config","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Config","description":"AWS Config","dateCreated":"2020-03-02T07:02:20+0000","dateUpdated":"2022-02-03T03:32:26+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"202