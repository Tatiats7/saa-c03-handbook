+0000","dateUpdated":"2024-05-17T18:27:21+0000","additionalFields":{"descriptionSummary":"When Trust Bank launched in 2022, Singapore was arguably oversaturated with banking options, with 98 percent of the population having at least one bank account. Yet, Trust Bank reached more than 100,000 customers within 10 days of its launch. In its first year, it onboarded around 14 percent of the market, making it one of the world’s fastest growing digital banks.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/logo%20trust%20bank%401x.bfc5e3b457dc63d18485908b4ab0a81bf7f1271f.png","displayLocation":"Other","customerNameLower":"trust bank","footerInfoText":"Published Date","industry":"Financial Services","headlineUrl":"https://aws.amazon.com/solutions/case-studies/trust-bank-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","customer-name":"Trust Bank","headline":"Trust Bank Builds a Scalable and Innovative Digital Bank on AWS","contentType":"Customer Story"}},"tags":[{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tag