0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#veracode-case-study","locale":"en_US","directoryId":"customer-references","name":"veracode-case-study","dateCreated":"2019-07-19T17:08:20+0000","dateUpdated":"2022-06-27T20:44:45+0000","additionalFields":{"featured":"0","descriptionSummary":"Veracode has achieved scalability and improved the speed and quality of its vulnerability detection products by beginning its migration to a microservices architecture on AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/veracode_Customer-Reference_Logo.8c2aeada0a092432679ab7f75173a465cac62a3b.png","displayLocation":"United States","customerNameLower":"veracode","footerInfoText":"Published Date","description":"\u003cp\u003eVeracode gives developers fast feedback on security risks, scales to support tens of thousands of vulnerability scans, and gets new features to market faster using Amazon Web Services. Veracode offers cloud-based application-security services. The company runs its Greenlight security-scan application on AWS Lambda and Amazon API Gateway.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2022-06-24","headlineUrl":"https://aws.amazon.com/solutions/case-studies/veracode-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Veracode","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Veracode Strengthens Its Software Security Platform Using Scalable AWS Services"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamesp