000","additionalFields":{"featured":"0","descriptionSummary":"Natura is part of the Natura \u0026Co group, the fourth-largest cosmetics company in the world, which operates in more than 70 countries and also comprises the Aesop, Avon, and The Body Shop brands. To support the international expansion of Natura\u0027s operations and business growth plans, Natura \u0026Co built on Amazon Web Services (AWS) and engaged AWS Professional Services to perform an AWS Well-Architected Framework Review of its new Global Sales Platform (GSP).","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/natura-logo%401x.2fed5d65b94a84522e299c3b44a2ac2f8626cd99.png","displayLocation":"Brazil","footerInfoText":"Published Date","industry":"Consumer Packaged Goods (CPG)","sortDate":"2021-07-06","headlineUrl":"https://aws.amazon.com/solutions/case-studies/well-architected-natura-case-study-en/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"NATURA COSMÉTICOS S.A.","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Natura Launches and Optimizes New Sales Platform for Consultants on AWS"}},"tags":[{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#product#cloudwatch",