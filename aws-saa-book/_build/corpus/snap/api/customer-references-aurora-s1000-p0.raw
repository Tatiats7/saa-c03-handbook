k for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#indigo-aurora-case-study","locale":"en_US","directoryId":"customer-references","name":"indigo-aurora-case-study","dateCreated":"2021-03-05T22:30:12+0000","dateUpdated":"2024-09-26T22:18:00+0000","additionalFields":{"descriptionSummary":"Agriculture technology provider Indigo Ag began to migrate its services to Amazon Aurora for a simple, scalable, fully managed solution that supports growth while decreasing work for its developers.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/indigo-logo%401x.916198432c2d941b8128296a2867c45a9abc0f72.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Agriculture","sortDate":"2021-03-05","headlineUrl":"https://aws.amazon.com/solutions/case-studies/indigo-aurora-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Indigo Ag","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Indigo Ag Uses Amazon Aurora to Scale Sustainable Agriculture Solutions"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNames