Created":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"}]},{"item":{"id":"customer-references#workhuman-data-protection","locale":"en_US","directoryId":"customer-references","name":"workhuman-data-protection","dateCreated":"2024-06-12T18:23:40+0000","dateUpdated":"2024-06-13T20:01:45+0000","additionalFields":{"descriptionSummary":"Workhuman’s social recognition software helps enterprises increase employee engagement, productivity, and satisfaction. The key: gratitude. Dealing with sensitive customer data, and adhering to General Data Protection Regulation (GDPR) and ISO 27001 standards, means data protection is “absolutely vital,” as vice president of architecture Mark Greville says. The Workhuman Cloud runs entirely on Amazon Web Services (AWS), and the company uses AWS support to help it create a secure architecture where customer and employee data is safe.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/workhuman-logo%401x.a8c8757fba6e8303cd6ca76ee18fae84d6bf3ad9.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/workhuman-logo%401x.a8c8757fba6e8303cd6ca76ee18fae84d6bf3ad9.png","displayLocation":"Europe","customerNameLower":"workhuman","footerInfoText":"Published Date","industry":"Professional Services","headlineUrl":"https://aws.amazon.com/solutions/case-studies/workhuman-data-protection/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Workhuman","enableShare":"1","publishedDate":"2023","headline":"Workhuman Protects Customer Data with Secure Architecture Built on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#prof-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Professional Services","d