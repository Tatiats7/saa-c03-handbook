nabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#hulu-case-study","locale":"en_US","directoryId":"customer-references","name":"hulu-case-study","dateCreated":"2019-07-22T19:44:53+0000","dateUpdated":"2021-12-22T19:27:53+0000","additionalFields":{"featured":"0","descriptionSummary":"Hulu is redefining the television experience for viewers by using AWS to support the addition of more than 50 live channels for its Hulu with Live TV offering. Hulu is an American subscription video-on-demand service owned by Hulu LLC, a joint venture with The Walt Disney Company, 21st Century Fox, Comcast, and Time Warner.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Hulu_Green_Customer-Reference_Logo.11626d9555561dc3140c7ff9840ef8fc32a71d6d.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the Hulu customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/hulu/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Hulu","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Hulu Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category"