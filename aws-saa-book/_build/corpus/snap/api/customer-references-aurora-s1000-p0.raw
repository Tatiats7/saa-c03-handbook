gNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#sustainability","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Sustainability","description":"Sustainability","dateCreated":"2022-01-18T21:36:39+0000","dateUpdated":"2022-05-09T21:31:10+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"}]},{"item":{"id":"customer-references#powercloud-case-study-en","locale":"en_US","directoryId":"customer-references","name":"powercloud-case-study-en","dateCreated":"2024-09-20T20:43:22+0000","dateUpdated":"2024-09-20T20:47:36+0000","additionalFields":{"descriptionSummary":"Used by 5 of the 6 biggest energy and utility companies in Germany, powercloud automates and streamlines business-critical functions. Its solutions have increased its customers’ operational efficiency, reduced their costs by up to 80 percent, and improved customer experience for their millions of energy users. Using AWS also allows powercloud to quickly scale resources to support international expansion and to securely store sensitive customer information, easing compliance burdens for utilities.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/powercloud-logo%401x.fb28bbdcbe0f132462cf1dfea5482555d9751785.png","displayLocation":"Germany","customerNameLower":"powercloud gmbh","footerInfoText":"Published Date","industry":"Energy","sortDate":"2022-12-08","headlineUrl":"https://aws.amazon.com/solutions/case-studies/powercloud-case-study/?nc1\u003dh_ls\u0026did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"powercloud GmbH","publishedDate":"2022","enableShare":"1","headline":"powercloud Delivers Customer-Centric Experiences to Utilities Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#location#dach","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"DACH","description":"DACH","dateCreated":"2020-02-03T05:29:52+0000","dateUpdated":"2022-02-03T03:31:47+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"