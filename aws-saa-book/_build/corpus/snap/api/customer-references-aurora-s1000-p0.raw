id":"customer-references#category#network","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2019-07-22T18:32:15+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#elemental-mediatailor","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental MediaTailor","description":"AWS Elemental MediaTailor","dateCreated":"2020-03-02T07:03:20+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#product#elemental-mediaconvert","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental MediaConvert","description":"AWS Elemental MediaConvert","dateCreated":"2020-03-02T07:03:13+0000","dateUpdated":"2022-02-03T03:32:35+0000"},{"id":"GLOBAL#product#transcribe","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Transcribe","description":"Amazon Transcribe","dateCreated":"2020-03-02T07:05:51+0000","dateUpdated":"2022-02-03T03:33:04+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Mobile","description":"Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2023-08-22T20:28:38+0000"}]},{"item":{"id":"customer-references#parquearauco","locale":"en_US","directoryId":"customer-references","name":"parquearauco","dateCreated":"2023-06-01T23:07:06+0000","dateUpdated":"2023-06-08T04:07:39+0000","additionalFields":{"descriptionSummary":"Fundada en 1980, Parque Arauco es una empresa chilena encargada de administrar y crear espacios de encuentro para las personas. Hace algunos años, para seguir creciendo, surgió la necesidad de que la empresa conociera mejor al cliente que está en el centro comercial. Así empezaron con una estrategia customer centric y data driven. El gran volumen de datos generados conllevó a implementar las soluciones de AWS para no solo gestionar la capacidad de cómputo sino también centralizar y manejar los datos para analizarlos como una manera a traer insights para la compañía.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/parquearauco_logo%401x.87d06ddb8e78eac1f08626bb0464970521db214a.png","displayLocation":"Chile","footerInfoText":"Fecha de publicación","industry":"Venta al por menor","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/parquearauco/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"Historia del cliente","customer-name":"Parque Arauco","headline":"Parque Arauco implementa data lake en seis meses con soluciones AWS"}},"tags":[{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#control-tower","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Control Tower","description":"AWS Control Tower","dateCreated":"2020-03-02T07:02:23+0000","dateUpdated":"2022-02-03T03:32:26+0000"},{"id":"customer-references#category#data-lakes-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Data Lakes \u0026 Analytics","description":"Data Lakes \u0026 Analytics","dateCreated":"2019-07-22T18:31:39+0000","dateUpdated":"2022-02-07T13:55:55+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_U