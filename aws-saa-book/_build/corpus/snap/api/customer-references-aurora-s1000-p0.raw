category","name":"IoT","description":"IoT","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2022-02-03T03:35:28+0000"}]},{"item":{"id":"customer-references#carvajal","locale":"en_US","directoryId":"customer-references","name":"carvajal","dateCreated":"2023-06-01T23:09:30+0000","dateUpdated":"2023-06-08T04:07:36+0000","additionalFields":{"descriptionSummary":"Carvajal pasó por una compleja migración a AWS, pues contaba con varios servidores instalados desde 1998, 2000 y 2003, con muchas aplicaciones basadas en plataformas de software antiguas. Trabajando con el socio de negocios Avanxo, Carvajal utiliza la mayoría de los servicios de AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/carvajal_Logo%401x.facdce6bb26d18e2515262770affa5083d4735ae.png","displayLocation":"Colombia","footerInfoText":"Fecha de publicación","industry":"Servicios financieros","sortDate":"2018-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/Carvajal/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2018","contentType":"Historia del cliente","customer-name":"Carvajal","headline":"Caso práctico de Carvajal Tecnología y Servicios"}},"tags":[{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamesp