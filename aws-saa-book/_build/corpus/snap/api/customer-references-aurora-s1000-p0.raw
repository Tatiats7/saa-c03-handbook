rvices and tools it delivers to the company.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/autodesk-logo-2022%401x.c2c78e83fe77cfbe57e586f0465bf8f70e5089ce.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2021-05-21","headlineUrl":"https://aws.amazon.com/solutions/case-studies/autodesk-migration-modernization-infographic/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Autodesk","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Autodesk Increases Efficiency, Reduces Costs through Large-Scale Migration and Modernization on AWS"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"customer-references#category#training-certification","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Training \u0026 Certification","description":"Training \u0026 Certification","dateCreated":"2019-07-22T18:32:26+0000","dateUpdated":"2022-02-26T01:35:03+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"