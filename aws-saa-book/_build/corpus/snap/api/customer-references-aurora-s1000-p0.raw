-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#product#directory-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Directory Service","description":"AWS Directory Service","dateCreated":"2020-03-02T07:02:45+0000","dateUpdated":"2022-02-03T03:32:30+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#industry#energy","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Energy","description":"Energy","dateCreated":"2020-07-15T21:58:51+0000","dateUpdated":"2022-02-03T03:32:02+0000"},{"id":"GLOBAL#product#kinesis-data-firehose","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis Firehose","description":"Amazon Kinesis Firehose","dateCreated":"2020-05-08T03:42:48+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#industry#power-utilities","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Power \u0026 Utilities","description":"Power \u0026 Utilities","dateCreated":"2020-01-16T17:42:37+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#industry#oil-gas","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Oil \u0026 Gas","description":"Oil \u0026 Gas","dateCreated":"2020-01-16T17:42:36+0000","dateUpdated":"2022-02-03T03:32:07+0000"}]},{"item":{"id":"customer-references#zs-case-study","locale":"en_US","directoryId":"customer-references","name":"zs-case-study","dateCreated":"2023-08-24T06:46:54+0000","dateUpdated":"2023-09-07T23:50:14+0000","additionalFields":{"descriptionSummary":"ZS is a management consulting and technology firm focused on transforming global healthcare and beyond. They leverage leading-edge analytics, plus the power of data, science, and products, to help clients make more intelligent decisions, deliver innovative solutions, and improve outcomes for all. Founded in 1983, ZS has more than 12,000 employees in 35 offices worldwide. More than 130 companies have already used ZS’s products to drive business decisions, and over 100,000 pharmaceutical field reps worldwide have used ZS’s insights to engage their customers. To further enhance their capabilities in the healthcare industry, ZS is continuing to enhance its portfolio of products. In 2021, ZS launched ZAIDYNTM, an intelligent, cloud-native platform that helps life sciences organizations shape the future. Its analytics, algorithms and workflows empower people, transform processes, and unlock real value. Designed to learn and grow with our clients, the platform is modular, future-ready and fueled by global connectivity. And as more people engage, share and build, our platform gets smarter—helping organizations fuel discovery, connect with customers, deliver treatments, and improve lives. Today, ZAIDYN, built on Amazon Web Services, has been launched and operated in the Chinese market.","imageSrcUrl":"https://d1.awsstatic.com/case-studies-cards-imgs/ZS%20logox70.83fe9de5bb0416b0e9d1345d07e48d6c55f7398d.png","displayLocation":"China","customerNameLower":"zs case study","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/zs-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ZS Case Study","publishedDate":"2022","enableShare":"1","headline":"Shaping the Future of Life Sciences with ZS China ’s ZAIDYN Platform powered By AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#location#china","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"China","description":"China","dateCreated":"2020-02-03T05:29:17+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"customer-references#category#saas","locale":"en_US","tagNamespaceId":"customer-references#category","name":"SaaS","description":"SaaS","dateCreated":"2019-07-22T18:32:20+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#fox-innovator","locale":"en_US","directoryId":"customer-references","name":"fox-innovator","dateCreated":"2022-05-03T00:28:56+0000","dateUpdated":"2024-08-07T18:41:49+0000","additionalFields":{"featured":"0","featureImageURL":"https://d1.awsstatic.com/aws-key-pages/homepage-key-pages/customer-stories-logo/Fox.b05d6c74c51a22bdb3cc3d34cc51bcead2755166.jpg","descriptionSummary":"\u003cp\u003eMillions of viewers engage with content from FOX through its\u0026nbsp;broadcast and OTT platforms. FOX leverages AWS\u0026nbsp;to pioneer the future of world-class live and on-demand content delivery.\u003c/p\u003e\n","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/fox-logo%401x.c53ed2aa45c6ef9479d33bb6963b1070455b252c.png","displayLocation":"United States","customerNameLower":"fox corporation","footerInfoText":"Published Date","description":"\u003cp\u003eMigrating about 8 PB of content from its on-premises storage to the cloud in only 6 weeks\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u0026nbsp;\u003c/p\u003e\n","industry":"Media \u0026 Entertainment","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/innovators/fox/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"FOX Corporation","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"FOX on AWS"}},"tags":[{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#mq","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon MQ","description":"Amazon MQ","dateCreated":"2020-03-02T07:04:38+0000","dateUpdated":"2022-02-03T03:32:51+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Mobile","description":"Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2023-08-22T20:28:38+0000"},{"id":"GLOBAL#product#elemental-medialive","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental MediaLive","description":"AWS Elemental MediaLive","dateCreated":"2020-03-02T07:03:15+0000","dateUpdated":"2022-02-03T03:32:35+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#elemental-med