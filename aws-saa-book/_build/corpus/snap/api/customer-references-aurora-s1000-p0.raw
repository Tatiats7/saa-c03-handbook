ted":"2020-06-18T18:13:48+0000","dateUpdated":"2021-12-22T20:20:34+0000","additionalFields":{"descriptionSummary":"The Pokémon Company International (TPCi) is a subsidiary of The Pokémon Company in Japan and manages the Pokémon brand outside of Asia. By migrating its user database and authentication system, Pokémon Trainer Club, to Amazon Aurora, TPCi reduced downtime from 168 hours over a six-month period pre-migration to zero downtime or degradation post-migration.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/pokemon-logo@1x.fa5637f0681a402b1cead2189ebf54b4f711825f.png","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/the-pokemon-company-international-case-study?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"The Pokémon Company International Migrates Its Live Database to Aurora PostgreSQL","customer-name":"The Pokémon Company International"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"customer-references#category#gaming","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gaming","description":"Gaming","dateCreated":"2019-07-22T18:31:55+0000","dateUpdated":"2022-03-05T03:54:12+0000"}]},{"item":{"id":"customer-references#orsted-obviux-case-study","locale":"en_US","directoryId":"customer-references","name":"orsted-obviux-case-study","dateCreated":"2020-05-12T19:50:01+0000","dateUpdated":"2023-07-12T01:40:46+0000","additionalFields":{"featured":"0","descriptionSummary":"\u003cp\u003eGreen energy company \u0026Oslash;rsted created its own software startup, Obviux, built entirely in the cloud. Obviux builds streamlined billing software for the energy sector. The company relies on Amazon RDS for MySQL to manage the Amazon Aurora database it uses to store data from more than 1 million customers and 1.2 million smart meters.\u003c/p\u003e\r\n","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/obviux@1x.3c3508b80027d39ad34d3ca74806595171a3df72.png","displayLocation":"Denmark","footerInfoText":"Published Date","industry":"Power \u0026 Utilities","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/orsted-obviux/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ørsted","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Green Energy Company Ørsted Builds Software Startup Obviux on AWS"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#industry#power-utilities","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Power \u0026 Utilities","description":"Power \u0026 Utilities","dateCreated":"2020-01-16T17:42:37+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#industry#energy","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Energy","description":"Energy","dateCreated":"2020-07-15T21:58:51+0000","dateUpdated":"2022-02-03T03:32:02+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#use-case#sustainability","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","