ust-engagement","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2020-06-05T07:06:46+0000","dateUpdated":"2022-02-03T03:31:03+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#product#codebuild","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodeBuild","description":"AWS CodeBuild","dateCreated":"2020-03-02T07:02:08+0000","dateUpdated":"2022-02-03T03:32:24+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#pearson-digitally-transforms","locale":"en_US","directoryId":"customer-references","name":"pearson-digitally-transforms","dateCreated":"2021-02-22T20:20:15+0000","dateUpdated":"2024-03-12T07:21:32+0000","additionalFields":{"featureImageURL":"https://d1.awsstatic.com/aws-key-pages/homepage-key-pages/customer-stories-logo/Pearson.73ed33224c978f0d75a8da1d2755e87c599502e2.jpg","descriptionSummary":"Pearson cut costs by $5 million in 1 year, scaled to serve hundreds of millions of learners, and removed the burden of database management from in-house staff by using AWS.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/pearson-logo%401x.3d48da03240be6fda73055c8c28858804f1504b0.png","displayLocation":"Americas","customerNameLower":"pearson","footerInfoText":"Published Date","description":"\u003cp\u003eEnabling more personalized education at scale to hundreds of millions of learners\u003c/p\u003e\n","industry":"Education","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/pearson-digitally-transforms-infographic/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Pearson","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Pearson Digitally Transforms on AWS (Infographic)"}},"tags":[{"id":"GLOBAL#content-type#infographic","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Infographic","description":"Infographic","dateCreated":"2020-06-12T23:29:11+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2023-07-15T01:16:11+0000"},{"id":"GLO