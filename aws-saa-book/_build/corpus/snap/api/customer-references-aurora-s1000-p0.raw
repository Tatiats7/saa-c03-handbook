ts journey toward digital transformation, moving its customer service quickly and efficiently, as well as improving its profitability through the AWS Cloud.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/JPS-logo%401x.3478528beeb40acda015c33b78052ade26565ed5.png","displayLocation":"Caribbean","customerNameLower":"jamaica public service","footerInfoText":"Published Date","industry":"Energy","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/jps-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Jamaica Public Service","publishedDate":"2022","enableShare":"1","headline":"AWS Supports JPS on its Transformation Journey from Traditional to Digital","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GL