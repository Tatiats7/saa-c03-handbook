tomer-references#nintendo-dena-case-study","locale":"en_US","directoryId":"customer-references","name":"nintendo-dena-case-study","dateCreated":"2021-10-01T01:57:29+0000","dateUpdated":"2021-12-22T23:21:16+0000","additionalFields":{"descriptionSummary":"Nintendo is well known for its gaming console, but the global game maker is also committed to delivering its services via mobile devices, including on smartphones. To launch the \"Mario Kart Tour\" in 2019, Nintendo and DeNA adopted Amazon Aurora as their database, instead of using a self-managed MySQL (MySQL running on Amazon EC2). This ensured the performance and scalability necessary for users to play the game comfortably, and at the same time, greatly reduced the person-power required for operation.","imageSrcUrl":"https://d1.awsstatic.com/events/jp/2021/innovate-data/customer-logos/nintendo-dena.5a912d5fed70986cca1fcda7b9be917f072aefe2.png","displayLocation":"Japan","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/nintendo-dena-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Nintendo Turns to Amazon Aurora to Support The Mario Kart Tour","customer-name":"Nintendo"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":