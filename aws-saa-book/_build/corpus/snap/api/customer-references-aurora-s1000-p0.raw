. It runs on Amazon Elastic Container Service (Amazon ECS) and Amazon Aurora to package its application, with little to no changes to the application itself.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(@1x---@2x)/Classic_group_logo@1x.ac1206607c8a7c5b3a5d54fb14de148503c8089a.png","displayLocation":"New Zealand","footerInfoText":"Published Date","industry":"Construction \u0026 Real Estate","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/classicgroup/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Classic Group","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Classic Group Builds Better Homes 60% Faster with AWS"}},"tags":[{"id":"GLOBAL#use-case#general-database-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"General Database Migration","description":"General Database Migration","dateCreated":"2020-06-05T06:37:24+0000","dateUpdated":"2022-02-03T03:35:41+0000"},{"id":"customer-references#category#database-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Database Migration","description":"Database Migration","dateCreated":"2019-07-22T18:31:40+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","t