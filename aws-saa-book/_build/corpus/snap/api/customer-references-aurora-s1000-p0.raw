spaceId":"GLOBAL#product","name":"AWS Outposts","description":"AWS Outposts","dateCreated":"2020-03-02T07:04:45+0000","dateUpdated":"2022-02-03T03:32:53+0000"},{"id":"GLOBAL#product#eventbridge","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EventBridge","description":"Amazon EventBridge","dateCreated":"2020-03-02T07:03:23+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#product#snowmobile","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Snowmobile","description":"AWS Snowmobile","dateCreated":"2020-03-02T07:05:32+0000","dateUpdated":"2022-02-03T03:33:01+0000"},{"id":"GLOBAL#product#directconnect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Direct Connect","description":"AWS Direct Connect","dateCreated":"2020-03-02T07:02:43+0000","dateUpdated":"2022-02-03T03:32:30+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#translate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Translate","description":"Amazon Translate","dateCreated":"2020-03-02T07:05:56+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#product#private-5g","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Private 5G","description":"AWS Private 5G","dateCreated":"2021-12-16T04:57:42+0000","dateUpdated":"2022-02-03T03:32:55+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#astrazeneca-video-case-study","locale":"en_US","directoryId":"customer-references","name":"astrazeneca-video-case-study","dateCreated":"2022-07-02T00:20:17+0000","dateUpdated":"2023-07-19T03:05:02+0000","additionalFields":{"descriptionSummary":"AstraZeneca uses AWS in reimagining its drug discovery process, with a goal to develop medicines more quickly, cost effectively, and with a higher probability of success. Scientists now have access to data that is findable, accessible, interoperable, and reusable so that they can quickly generate actionable insights that previously took days or weeks, ultimately benefiting millions of patients.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/astrazeneca_Logo%401x.17b667208f14e5b450ebf1e95ecba0c85fda3328.png","displayLocation":"United States","customerNameLower":"astrazeneca","footerInfoText":"Published Date","industry":"Life Sciences","sortDate":"2022-07-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/astrazeneca-video-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"AstraZeneca","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"AstraZeneca Uses AWS in Quest to Accelerate Identification and Development of Life-Changing Medications"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamesp