ng. GE Aerospace used Amazon Web Services (AWS) to resolve its ODS challenges and save hundreds of thousands of dollars in yearly costs.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/ge%20aerospace%401x.1d47d52f33a15aff1433217021c6647fdf71d30e.png","displayLocation":"Other","customerNameLower":"ge aerospace","footerInfoText":"Published Date","industry":"Energy","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ge-aerospace-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","customer-name":"GE Aerospace","headline":"Improving Query Performance by Nearly 70% Using Amazon Redshift with GE Aerospace","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#other","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Other","description":"Other","dateCreated":"2021-07-30T05:52:05+0000","dateUpdated":"2022-02-03T03:31:59+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+000