","dateUpdated":"2022-02-03T03:32:21+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#node-real","locale":"en_US","directoryId":"customer-references","name":"node-real","dateCreated":"2022-10-17T22:22:23+0000","dateUpdated":"2022-10-18T17:56:21+0000","additionalFields":{"descriptionSummary":"NodeReal is a blockchain infrastructure and services provider that offers one-stop blockchain infrastructure services including full-fledged node services, blockchain as a service, and blockchain application tools and Application Programming Interface (API). Founded in 2021, NodeReal onboarded around 10,000 developers within its first 12 months, including projects such as BNB Chain, Aptos, CoinMarketCap, CertiK, Galxe, Trust Wallet, and ApeSwap.\n\nNodeReal is fully built and deployed on Amazon Web Services (AWS), which helps to maintain performance, stability, and scalability of its blockchain infrastructure. The company now handles 700,000 API requests per second from its Web3 customers. Furthermore, it supports 70 percent of all public API requests for the BNB Chain, making it the leading blockchain infrastructure provider for Web3 companies on the BNB Chain.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/nodereal-logo%401x.bd42ef7be50baf3c93a303be9ef380f0d4551980.png","displayLocation":"Hong Kong","customerNameLower":"nodereal","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-10-17","headlineUrl":"https://aws.amazon.com/solutions/case-studies/node-real/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"NodeReal","publishedDate":"2022","enableShare":"1","headline":"NodeReal Provides Scalable Infrastructure Solutions With Strong Price Performance for Web3 Development","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#location#china","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"China","description":"China","dateCreated":"2020-02-03T05:29:17+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-