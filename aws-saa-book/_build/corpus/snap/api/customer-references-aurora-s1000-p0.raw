-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"customer-references#innovator#delivery-hero","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Delivery Hero","description":"\u003cp\u003eInnovator introduced in 2023.\u003c/p\u003e\n","dateCreated":"2023-08-10T19:02:56+0000","dateUpdated":"2023-08-10T19:02:56+0000"}]},{"item":{"id":"customer-references#enpicom-case-study","locale":"en_US","directoryId":"customer-references","name":"enpicom-case-study","dateCreated":"2022-05-14T20:14:07+0000","dateUpdated":"2022-05-14T20:15:08+0000","additionalFields":{"descriptionSummary":"Dutch bioinformatics software engineering company ENPICOM provides powerful data analysis software and customized solutions to decode the immune system and improve human health.  Looking for a cost-efficient solution that would offer secure data management and speed up the analysis, the company migrated its cloud-based IGX Platform to Amazon Web Services (AWS). Using AWS, ENPICOM has improved scalability and performance by 3 times compared to its previous systems.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/enpicom-logo%401x.8dd797dc21993ff46be6da4d032f740ccd5efcaf.png","displayLocation":"Europe, Middle East, \u0026 Africa","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-05-13","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ENPICOM-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"ENPICOM Supports Faster Insights for Therapeutic Antibody Discovery Using AWS","customer-name":"Enpicom"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#netherlands","locale":"en