atured":"0","featureImageURL":"https://d1.awsstatic.com/aws-key-pages/homepage-key-pages/customer-stories-logo/Carrier.0460fdfa68f1ab42ed777b43428f3da45e3905bd.jpg","descriptionSummary":"Carrier, a provider of heating, ventilation, and air conditioning systems, modernized on AWS, reducing its technical debt and lowering infrastructure costs by 45–50 percent.","imageSrcUrl":"https://d1.awsstatic.com/carrier-logo-1x.ec3d16340c90d7ee0764cf34b3010b2d9f140c73.png","displayLocation":"United States","customerNameLower":"carrier global","footerInfoText":"Published Date","description":"\u003cp\u003eReducing food spoilage across the cold chain\u003c/p\u003e\n","industry":"Manufacturing","sortDate":"2021-06-04","headlineUrl":"https://aws.amazon.com/solutions/case-studies/carrier-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Carrier Global","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Reducing food spoilage across the cold chain"}},"tags":[{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#appstream2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon AppStream 2.0","description":"Amazon AppStream 2.0","dateCreated":"2020-03-02T07:01:30+0000","dateUpdated":"2022-02-03T03:32:17+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNa