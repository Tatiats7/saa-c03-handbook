2022-02-03T03:32:18+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#product#codedeploy","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodeDeploy","description":"AWS CodeDeploy","dateCreated":"2020-03-02T07:02:12+0000","dateUpdated":"2022-02-03T03:32:24+0000"}]},{"item":{"id":"customer-references#visma","locale":"en_US","directoryId":"customer-references","name":"visma","dateCreated":"2020-01-23T22:00:47+0000","dateUpdated":"2021-12-22T22:34:45+0000","additionalFields":{"featured":"0","descriptionSummary":"Visma migrates critical Windows workloads to AWS and increases new feature releases from six yearly to more than six monthly, cuts deployment time from 30 minutes to 5 minutes, and increases the customer base for one application by four times. Headquartered in Oslo, Norway, the company is a leading provider of cloud-based business applications. Visma moved many of its .NET applications to AWS, relying on Amazon Aurora MySQL, Amazon EC2, and AWS CloudFormation.","imageSrcUrl":"https://d1.awsstatic.com/events/Nordics/visma.fd0b746d073b0ad4eba5aba526fb78a567065693.png","displayLocation":"Norway","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/visma-case-study/?did\u003dcr_card\u002