ll be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#calgary-airport-authority-case-study","locale":"en_US","directoryId":"customer-references","name":"calgary-airport-authority-case-study","dateCreated":"2023-06-06T17:22:12+0000","dateUpdated":"2024-02-20T22:25:55+0000","additionalFields":{"descriptionSummary":"To improve performance, reduce costs, and mitigate passenger-service disruptions in the event of a cybersecurity incident, the Calgary Airport Authority migrated its on-premises data center to the AWS Cloud.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/YYC-Logo%401x.bb1207c1008b83b60a69de40b8fc7b71f61f01ce.png","displayLocation":"Canada","customerNameLower":"calgary airport authority","footerInfoText":"Published Date","industry":"Airlines","sortDate":"2023-05-18","headlineUrl":"https://aws.amazon.com/solutions/case-studies/calgary-airport-authority-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Calgary Airport Authority","publishedDate":"2023","enableShare":"1","headline":"Calgary Airport Authority Enhances Cybersecurity on the AWS Cloud","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#customer-segment#non-profit","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Non-profit","description":"Non-profit","dateCreated":"2021-06-04T06:35:44+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId