references#frollo","locale":"en_US","directoryId":"customer-references","name":"frollo","dateCreated":"2021-03-08T20:16:14+0000","dateUpdated":"2022-12-14T01:11:26+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eBy building its machine learning models on Amazon SageMaker, Frollo has achieved 95 percent or greater accuracy when categorizing real-time spending transactions on its app. Frollo is the first Australian FinTech authorized to use open-banking data to improve customers\u0026rsquo; financial health through its B2C mobile app and its B2B Data Enrichment API.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(@1x---@2x)/Frollo_logo@1x.d5c20f842189dce703ba5f0b5d2bb75f957b4ec7.png","displayLocation":"Australia","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/frollo/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Frollo","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Frollo Provides a Fast Track to Open Banking on AWS"}},"tags":[{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#finserv","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Financial Services","description":"Financial Services","dateCreated":"2019-07-22T18:31:53+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceI