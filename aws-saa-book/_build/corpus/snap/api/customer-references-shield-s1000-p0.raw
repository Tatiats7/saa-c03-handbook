"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#glacier","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon S3 Glacier","description":"Amazon S3 Glacier","dateCreated":"2020-03-02T07:03:38+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#app-integration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Application Integration","description":"Application Integration","dateCreated":"2019-07-22T18:30:54+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#innovator#itau","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"itau","description":"\u003cp\u003eInnovator introduced in 2023.\u003c/p\u003e\n","dateCreated":"2023-08-10T19:03:48+0000","dateUpdated":"2023-08-10T19:03:48+0000"}]},{"item":{"id":"customer-references#itau-data-mesh-from-pt-directory","locale":"en_US","directoryId":"customer-references","name":"itau-data-mesh-from-pt-directory","dateCreated":"2024-02-03T03:48:35+0000","dateUpdated":"2024-04-19T23:19:31+0000","additionalFields":{"descriptionSummary":"O Itaú Unibanco está entre os maiores bancos da América Latina. A instituição oferece múltiplos serviços, como plataformas de investimentos, atacado, seguros e contas correntes, entre outros.\n\nO banco tem a missão de se tornar cada vez mais digital, em uma estratégia que envolve mudanças na forma com que seus times trabalham, a modernização de suas tecnologias e uma transformação em sua cultura, com foco em fortalecer a centralidade no cliente e o uso de dados em escala para o desenvolvimento de soluções.\n\nCom essa ambição, a instituição estruturou uma arquitetura de dados no modelo de data mesh com o suporte da AWS, e contou com o suporte da companhia para criar processos que viabilizassem o projeto. A partir da nova estrutura, o Itaú Unibanco obteve benefícios como uma redução de 95% no tempo de processamento de análise do cliente.\n\nNeste vídeo, Moisés Nascimento, chief data officer do Itaú Unibanco, e Roberto Figueira, superintendente de engenharia e plataforma de dados da instituição, contam como o banco reestruturou sua estratégia de dados e implementou a arquitetura data mesh para que eles pudessem ser distribuídos pelas comunidades que desenvolvem seus produtos. Moisés afirma que esses dados foram disponibilizados através da nova arquitetura e, em menos de seis meses, centenas de usuários já estavam criando contas dentro do data mesh.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/itau_logo%401x.387d8a15132c385d83aa638d391b8802b2f31fc6.png","displayLocation":"Brasil","customerNameLower":"itaú","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/itau-data-mesh/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Itaú","enableShare":"1","publishedDate":"2023","contentType":"História do cliente","headline":"Itaú Unibanco adota a arquitetura data mesh e conta com o suporte da AWS"}},"tags":[{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#shield","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Shield","description":"AWS Shield","dateCreated":"2020-03-02T07:05:24+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references