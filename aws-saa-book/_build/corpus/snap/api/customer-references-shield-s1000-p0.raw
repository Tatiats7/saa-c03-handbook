18:31:09+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#shield","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Shield","description":"AWS Shield","dateCreated":"2020-03-02T07:05:24+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000","dateUpdated":"2022-02-03T03:32:39+0000"}]},{"item":{"id":"customer-references#rappi-fin-ops-from-es-directory","locale":"en_US","directoryId":"customer-references","name":"rappi-fin-ops-from-es-directory","dateCreated":"2024-02-03T03:47:48+0000","dateUpdated":"2024-02-06T01:35:37+0000","additionalFields":{"descriptionSummary":"A pandemia colocou à prova a capacidade do Rappi de realizar entregas rapidamente, portanto, foi necessário inovar em infraestrutura. No entanto, a empresa precisava ter bases financeiras para justificar o uso de ferramentas tecnológicas, e isso só poderia ser alcançado pelo monitoramento em tempo real das necessidades e das potenciais soluções tecnológicas para medir a eficiência de custo. Dessa maneira, com a implementação do FinOps e dos serviços da AWS, com os quais já trabalhava há muitos anos, obtiveram uma otimização de 90% do investimento em infraestrutura. A empresa, que atualmente processa 25 milhões de pedidos por mês, adquiriu flexibilidade para executar mais de 10 mil instâncias spot do Amazon Elastic Compute Cloud (Amazon EC2) em horários de pico.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/rappi-logo%401x.e3f6d852f68b6a673150b380f45ac07e0a763a10.png","displayLocation":"Brasil","customerNameLower":"rappi","footerInfoText":"Data de publicação","industry":"Hotelaria","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/rappi-fin-ops/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Rappi","enableShare":"1","publishedDate":"2023","contentType":"História do cliente","headline":"Rappi otimizou a relação de custo-benefício em 90% na Nuvem AWS devido ao FinOps"}},"tags":[{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#product#efs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic File System (EFS)","description":"Amazon Elastic File System (EFS)","dateCreated":"2020-03-02T07:02:57+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#auto-sc