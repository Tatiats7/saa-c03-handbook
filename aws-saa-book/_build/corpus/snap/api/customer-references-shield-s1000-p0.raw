ication","industry":"Construction et immobilier","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/nexity/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Nexity","enableShare":"1","publishedDate":"2021","contentType":"Témoignages clients","headline":"Nexity propulse sa Direction des Solutions et Innovations Numériques dans le cloud avec AWS"}},"tags":[{"id":"GLOBAL#product#robomaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS RoboMaker","description":"AWS RoboMaker","dateCreated":"2020-03-02T07:05:05+0000","dateUpdated":"2022-02-03T03:32:57+0000"},{"id":"GLOBAL#product#mwaa","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Managed Workflows for Apache Airflow (MWAA)","description":"Amazon Managed Workflows for Apache Airflow (MWAA)","dateCreated":"2021-08-28T07:04:25+0000","dateUpdated":"2022-02-03T03:32:52+0000"},{"id":"GLOBAL#product#snowball","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Snowball","description":"AWS Snowball","dateCreated":"2020-03-02T07:05:27+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#product#sso","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Single Sign-On (SSO)","description":"AWS Single Sign-On (SSO)","dateCreated":"2020-03-02T07:05:37+0000","dateUpdated":"2023-06-01T00:45:24+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#tech-category#quantum","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Quantum Technologies","description":"Quantum Technologies","dateCreated":"2020-04-22T21:01:57+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#snowball-edge","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Snowball Edge","description":"AWS Snowball Edge","dateCreated":"2020-03-02T07:05: