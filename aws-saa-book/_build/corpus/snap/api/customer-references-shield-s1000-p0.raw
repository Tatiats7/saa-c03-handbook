1-01-06T00:09:49+0000","dateUpdated":"2022-02-03T03:36:04+0000"},{"id":"GLOBAL#product#shield","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Shield","description":"AWS Shield","dateCreated":"2020-03-02T07:05:24+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#location#hongkong","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Hong Kong","description":"Hong Kong","dateCreated":"2020-02-03T05:29:18+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#paypay","locale":"en_US","directoryId":"customer-references","name":"paypay","dateCreated":"2021-06-18T07:37:00+0000","dateUpdated":"2022-12-22T17:40:44+0000","additionalFields":{"descriptionSummary":"PayPay is a mobile payment service that allows users to pay using QR codes and bar codes. The number of registered users has surpassed 33 million since it was first released two years ago in October 2018. PayPay Corporation, the developer and operator of the service, uses Amazon Web Services (AWS) as the infrastructure platform for its services, and is building distributed systems utilizing a microservices architecture. From the decision to develop the system through to its release was a scant three months. This initial launch was made possible by using AWS along with a development team including multinational members from Japan, India and Canada. Even now, the company is continuing with service updates aiming to develop PayPay into a \"Super App.\"","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/paypay-logo%401x.dfead1e98edf1f39fa487dfb70bfdead34814773.png","displayLocation":"Japan","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2021-06-17","headlineUrl":"https://aws.amazon.com/solutions/case-studies/paypay/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"PayPay","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Utilizing AWS microservices architecture to make cashless payments more widespread. QR code payment service used by 33 million people* that was released in three months."}},"tags":[{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#finserv","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Financial Services","description":"Financial Services","dateCreated":"2019-07-22T18:31:53+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","