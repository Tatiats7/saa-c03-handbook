ustomer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#supercell-edge-services-case-stud","locale":"en_US","directoryId":"customer-references","name":"supercell-edge-services-case-stud","dateCreated":"2022-06-27T20:44:07+0000","dateUpdated":"2022-06-27T20:56:02+0000","additionalFields":{"descriptionSummary":"Supercell uses Amazon CloudFront, AWS Local Zones, and AWS security services to deliver dynamic, low-latency game content to a globally distributed community of 250 million monthly users.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/supercell-logo%401x.0fe8c7be0985b4cd285ffd90fad5f9e4feffa71c.png","displayLocation":"Finland","customerNameLower":"supercell","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2022-06-24","headlineUrl":"https://aws.amazon.com/solutions/case-studies/supercell-edge-services-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Supercell","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Supercell Delivers Dynamic, Low-Latency Games to Millions of Players Using AWS Edge Services"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#waf","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS WAF","description":"AWS WAF","dateCreated":"2020-03-02T07:06:04+0000","dateUpdated":"2022-02-03T03:33:07+0000"},{"id":"GLOBAL#location#finland","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Finland","description":"Finland","dateCreated":"2020-02-03T05:30:08+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#control-tower","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Control Tower","description":"AWS Control Tower","dateCreated":"2020-03-02T07:02:23+0000","dateUpdated":"2022-02-03T03:32:26+0000"},{"id":"GLOBAL#product#shield","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Shield","description":"AWS Shield","dateCreated":"2020-03-02T07:05:24+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#product#global-accelerator","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Global Accelerator","description":"AWS Global Accelerator","dateCreated":"2020-03-02T07:03:39+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"customer-references#category#gaming","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gaming","description":"Gaming","dateCreated":"2019-07-22T18:31:55+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"GLOBAL#location#nordics","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Nordics","description":"Nordics","dateCreated":"2020-02-03T05:30:04+0000","dateUpdated":"2022-02-03T03:31:50+0000"}]},{"item":{"id":"customer-references#jump","locale":"en_US","directoryId":"customer-references","name":"jump","dateCreated":"2023-07-17T23:44:59+0000","dateUpdated":"2023-08-11T22:26:57+0000","additionalFields":{"videoSrcUrl":"https://www.youtube.com/watch?v\u003d6Uq9Qvtzitw","descriptionSummary":"\u003cp\u003eJump facilite le quotidien des personnes souhaitant devenir freelances en leur proposant de les embaucher en CDI - tout en restant leur propre patron sans avoir \u0026agrave; g\u0026eacute;rer le volet administratif. Sebastian CACERES, CTO chez Jump, partage l\u0026rsquo;ambition de multiplier par 5 le nombre de salari\u0026eacute;s freelances d\u0026rsquo;ici fin 2022. Sa probl\u0026eacute;matique principale : rester proche des clients en proposant une disponibilit\u0026eacute; en continue et une structure pour ses utilisateurs. Le Cloud AWS a su fournir les fonctionnalit\u0026eacute;s permettant \u0026agrave; Jump de r\u0026eacute;pondre \u0026agrave; ses besoins de haute disponibilit\u0026eacute;, flexibilit\u0026eacute;, scalabilit\u0026eacute; et de s\u0026eacute;curit\u0026eacute; pour un investissement moindre en amont. Le passage au cloud a eu pour effet d\u0026rsquo;offrir plus d\u0026rsquo;agilit\u0026eacute; \u0026agrave; Jump en leur permettant de faire du test and learn gr\u0026acirc;ce aux diff\u0026eacute;rentes fonctionnalit\u0026eacute;s et services propos\u0026eacute;s. Jump souhaite aller plus loin et s\u0026rsquo;int\u0026eacute;resse aujourd\u0026rsquo;hui \u0026agrave; l\u0026rsquo;architecture bas\u0026eacute;e sur des \u0026eacute;v\u0026eacute;nements, la scalabilit\u0026eacute; et les services \u0026agrave; l\u0026rsquo;\u0026eacute;chelle mondiale.\u003c/p\u003e\r\n","featured":"0","featureImageURL":"https://i.ytimg.com/vi/6Uq9Qvtzitw/maxresdefault.jpg","imageSrcUrl":"https://d1.awsstatic.com/%c3%89tude%20de%20cas%20AWS%20%20Jump.ba964f2b5a82506027f093a6dd39620de314eb70.jpg","displayLocation":"France","customerNameLower":"jump","footerInfoText":"Date de publication","industry":"Services professionnels","sortDate":"2022-06-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/jump/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Jump","enableShare":"1","publishedDate":"2022","contentType":"Témoignages clients","headline":"Jump : Une solution innovante pour les freelances en recherche d’une proximité client toujours plus forte"}},"tags":[{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#product#lightsail","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Lightsail","description":"Amazon Lightsail","dateCreated":"2020-03-02T07:04:25+0000","dateUpdated":"2022-02-03T03:32:47+0000"},{"id":"GLOBAL#product#gamelift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon GameLift","description":"Amazon GameLift","dateCreated":"2020-03-02T07:03:36+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#product#deep-learning-containers","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Deep Learning Containers","description":"AWS Deep Learning Containers","dateCreated":"2020-03-02T07:02:37+0000","dateUpdated":"2022-02-03T03:32:28+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#product#codepipeline","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodePipeline","description":"AWS CodePipeline","dateCreated":"2020-03-02T07:02:13+0000","dateUpdated":"2022-02-03T03:32:25+0000"},{"id":"GLOBAL#product#transfer-sftp","locale":"en_US","tagNamespaceId":"GLOBAL#product