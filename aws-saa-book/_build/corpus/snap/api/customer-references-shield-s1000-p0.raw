GLOBAL#product#migration-hub","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Migration Hub","description":"AWS Migration Hub","dateCreated":"2020-03-02T07:04:36+0000","dateUpdated":"2022-02-03T03:32:51+0000"},{"id":"GLOBAL#product#mgmt-console","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Management Console","description":"AWS Management Console","dateCreated":"2020-03-02T07:04:33+0000","dateUpdated":"2022-02-03T03:32:50+0000"},{"id":"GLOBAL#product#personalize","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Personalize","description":"Amazon Personalize","dateCreated":"2020-03-02T07:04:50+0000","dateUpdated":"2022-02-03T03:32:54+0000"},{"id":"GLOBAL#product#ivs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Interactive Video Service","description":"Amazon Interactive Video Service","dateCreated":"2020-11-20T00:43:24+0000","dateUpdated":"2022-02-03T03:32:44+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#baazi-games-case-study","locale":"en_US","directoryId":"customer-references","name":"baazi-games-case-study","dateCreated":"2021-10-09T04:18:59+0000","dateUpdated":"2023-07-14T23:32:50+0000","additionalFields":{"descriptionSummary":"Baazi Games, an India technology gaming company specializing in skill-based real money games for over 10 million users, turned to AWS to secure its IT infrastructure against external threats. It successfully mitigated more than 50 DDoS attacks within 6 months to ensure business continuity.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Baazi_Games_logo%401x.607ec51619687414f8a56a96b76a078bf144a3ca.png","displayLocation":"India","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/baazi-games-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"Baazi Games","contentType":"Customer Story","headline":"Game On! Baazi Games Builds Enhanced Cyber Defenses with AWS Security Services"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+000