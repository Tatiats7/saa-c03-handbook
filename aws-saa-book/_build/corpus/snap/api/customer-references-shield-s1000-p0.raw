0","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#codedeploy","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodeDeploy","description":"AWS CodeDeploy","dateCreated":"2020-03-02T07:02:12+0000","dateUpdated":"2022-02-03T03:32:24+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Mobile","description":"Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2023-08-22T20:28:38+0000"},{"id":"customer-references#innovator#itau","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"itau","description":"\u003cp\u003eInnovator introduced in 2023.\u003c/p\u003e\n","dateCreated":"2023-08-10T19:03:48+0000","dateUpdated":"2023-08-10T19:03:48+0000"}]},{"item":{"id":"customer-references#rtvc","locale":"en_US","directoryId":"customer-references","name":"rtvc","dateCreated":"2023-06-01T23:05:03+0000","dateUpdated":"2023-06-08T04:07:42+0000","additionalFields":{"descriptionSummary":"Radio Televisión Nacional de Colombia (RTVC) es el sistema de medios públicos de los colombianos. Con una cobertura cercana al 93% de la población total, RTVC es la única opción en muchos lugares de Colombia para acceder a contenidos de entretenimiento, informativos y culturales. La compañía tenía los desafíos de aumentar la flexibilidad en la operación, la eficiencia en el gasto y de eliminar activos por obsolescencia. Para eso implementó la tecnología en la nube de AWS. RTVC tiene con 