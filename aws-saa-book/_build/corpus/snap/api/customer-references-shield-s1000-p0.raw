e#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"}]},{"item":{"id":"customer-references#europebet-case-study","locale":"en_US","directoryId":"customer-references","name":"europebet-case-study","dateCreated":"2022-10-11T20:30:17+0000","dateUpdated":"2023-07-14T23:32:34+0000","additionalFields":{"descriptionSummary":"Europebet, a licensed online gambling, roulette, and casino provider in Georgia, experienced a series of distributed denial of service (DDoS) attacks and was prone to latency issues. This caused website outages and slowed down site performance. Using AWS, it strengthened its security and DDoS protection, and lowered latency by offloading all its caching. It now saves around $20,000 a month on ISP costs, has improved the customer experience, and reduced its website loading time by around 75 percent.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Europebet%401x.fc9be678d2881ab122ce3d7c114d4e7e6ab4478e.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"neollet","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/europebet-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Neollet","publishedDate":"2021","enableShare":"1","headline":"Europebet Stays Secure and Competitive Using AWS, Reduces Website Loading Time by 75%","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#shield","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Shield","description":"AWS Shield","dateCreated":"2020-03-02T07:05:24+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022