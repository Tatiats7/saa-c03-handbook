description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"}]},{"item":{"id":"customer-references#dream11-innovator","locale":"en_US","directoryId":"customer-references","name":"dream11-innovator","dateCreated":"2024-10-17T20:53:38+0000","dateUpdated":"2025-02-07T00:06:13+0000","additionalFields":{"descriptionSummary":"\u003cdiv\u003e\n\u003cdiv\u003e\n\u003cp\u003e\u003ca href\u003d\"https://www.dream11.com/\" rel\u003d\"noopener\" target\u003d\"_blank\"\u003eDream11\u003c/a\u003e is the world\u0026rsquo;s largest fantasy sports platform with more than 220 million users playing fantasy sports ranging from cricket and football to kabaddi and basketball. The flagship brand of \u003ca href\u003d\"https://www.dreamsports.group/\" rel\u003d\"noopener\" target\u003d\"_blank\"\u003eDream Sports\u003c/a\u003e, India\u0026rsquo;s leading sports technology company, it has partnerships with several national and international sports bodies and cricketers. Using Amazon Web Services (AWS), Dream11 has supported its expansion, developing new features and services fast and protecting users from disruption. Its Scaler tool combined with AWS technologies help it scale dynamically and cost-effectively to handle millions of requests a minute and hundreds of sporting events a day.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n","featureImageURL":"https://d1.awsstatic.com/customer-references-case-studies-logos/AWS_Dream11_25_03_2024-13.5d3e4d0037bae236d1738bff7b843fb1884c97b6.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Dream11_logo@1x.8bd61dba7f6169504a32d2611ccf883955606efb.png","displayLocation":"India","customerNameLower":"dream11","footerInfoText":"Published Date","description":"\u003cp\u003eSupporting user base expansion from 2 million to more than 200 million in 4 years.\u003c/p\u003e\n","industry":"Media \u0026 Entertainment","sortDate":"2024-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/innovators/dream-11/","customer-name":"Dream11","enableShare":"1","publishedDate":"2024","contentType":"Customer Story","headline":"Dream11 on AWS"}},"tags":[{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdat