03:32:31+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#location#ukir","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"UK/IR","description":"UK/IR","dateCreated":"2020-02-19T23:06:44+0000","dateUpdated":"2022-02-03T03:31:51+0000"},{"id":"GLOBAL#workload#oracle","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"Oracle","description":"Oracle","dateCreated":"2021-01-06T00:09:51+0000","dateUpdated":"2022-02-03T03:36:05+0000"},{"id":"GLOBAL#workload#sap","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"SAP","description":"SAP","dateCreated":"2021-01-06T00:09:56+0000","dateUpdated":"2022-02-03T03:36:05+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#aws-case-study-citymaps","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-citymaps","dateCreated":"2019-07-22T19:50:37+0000","dateUpdated":"2023-07-12T01:40:49+0000","additionalFields":{"featured":"0","descriptionSummary":"The mission of startup Citymaps is to make mapping a social activity. Using AWS, Citymaps has been able to focus its team on development initiatives rather than operations, and has been able to scale up seamlessly during traffic spikes of up to 500 percent above normal.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Citymaps_Customer-Reference_Logo.05e9bf8622e14e78ff4df61d6a3cc7f85a958b7e.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eThe mission of startup Citymaps is to make mapping a social activity. Citymaps makes a social mapping platform available on iOS, Android, and the web, and provides users with an intuitive mapping interface that is hosted on AWS. Using AWS, Citymaps has been able to focus its team on development initiatives rather than operations, and has been able to scale up seamlessly during traffic spikes of 400-500 percent above normal.\u003c/p\u003e\r\n","industry":"Travel \u0026 Hospitality","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/citymaps/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Citymaps","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Citymaps"}},"tags":[{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notification Service (SNS)","dateCreated":"2020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#travel","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Travel","description":"Travel","dateCreated":"2020-01-16T17:42:42+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#aws-case-study-realeyes","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-realeyes","dateCreated":"2019-07-22T19:50:17+0000","dateUpdated":"2023-07-14T23:32:41+0000","additionalFields":{"featured":"0","descriptionSummary":"Business-intelligence firm Realeyes delivers emotion analytics to customers through its video-analysis platform. Realeyes runs its video storage, processing, and analytics platform on AWS. Using AWS, the startup has reduced development time for its data-collection service from months to weeks.","imageSrcUrl":"https://d1.awsstatic.com/logos/600x400_logos/600x400_realeyes_logo.99df23f66ff4b4f02a70a5058042142c8021bb6c.jpg","displayLocation":"Estonia","footerInfoText":"Published Date","description":"\u003cp\u003eUsing state-of-the-art human behavior recognition analysis, Realeyes is a platform that measures peoples? emotions as they view video content through their computers? webcams. The firm works with brands, media companies, and market research agencies to deliver business intelligence through emotion analytics. It recruits volunteer participants from around the world to take part in individual studies to test responses to video content. The results of these studies help organizations focus their marketing messages and make content placement decisions that maximize impact. Founded in 2007, with headquarters in London and offices in the U.S. and Hungary, the startup counts among its clients many Fortune 500 companies and some of the biggest brands in the world, including Coca-Cola, Samsung, and Walt Disney.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/realeyes/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Realeyes","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Realeyes"}},"tags":[{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUp