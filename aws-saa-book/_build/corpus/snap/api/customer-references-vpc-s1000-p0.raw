ale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Remote Work \u0026 Learning","description":"Remote Work \u0026 Learning","dateCreated":"2020-08-20T04:26:30+0000","dateUpdated":"2022-02-03T03:35:55+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#perfios-case-study","locale":"en_US","directoryId":"customer-references","name":"perfios-case-study","dateCreated":"2021-11-23T01:53:26+0000","dateUpdated":"2023-07-14T23:32:50+0000","additionalFields":{"descriptionSummary":"With ML on AWS, Perfios analyzes bank statements in more than 200 formats and processes loan applications in just 35 minutes. Perfios enables lenders to automate customer onboarding, decisioning, risk pricing, and fulfillment using its Data Analytics and Aggregation platform. The FinTech is using Amazon Textract to extract and categorize data from bank statements and Amazon SageMaker to score applications.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Perfios_logo%401x.f1b209f076b9a066affe0f08cd7f230fd063da4a.png","displayLocation":"India","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2021-11-22","headlineUrl":"https://aws.amazon.com/solutions/case-studies/perfios-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"Perfios","contentType":"Customer Story","headline":"Perfios Processes Over 2 Million Financial Documents per Month Using Amazon Textract"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#textract","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Textract","description":"Amazon Textract","dateCreated":"2020-03-02T07:05:47+0000","dateUpdated":"2022-02-03T03:33:04+0000"},{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GL