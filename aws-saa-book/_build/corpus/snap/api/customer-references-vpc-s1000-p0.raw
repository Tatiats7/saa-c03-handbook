OBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-8-securities","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-8-securities","dateCreated":"2019-07-22T20:00:02+0000","dateUpdated":"2023-07-14T23:32:45+0000","additionalFields":{"featured":"0","descriptionSummary":"8 Securities accomplishes its mission of reinventing investing in Hong Kong by providing a Trading Portal where users have access to resources that enable them to learn from and exchange ideas with like-minded investors. To maintain a cost-effective, reliable, scalable, flexible computing platform, the company uses several services from AWS, including Amazon EC2 with Elastic IP Addresses, Amazon EBS, Amazon VPC, and Elastic Load Balancing.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/8Securities_Customer-Reference_Logo.b96a0b1c34c1be24a2b465a1f167b4cd43fdb45c.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","description":"\u003cp\u003e8 Securities accomplishes its mission of reinventing investing in Hong Kong by providing a Trading Portal where users have access to resources that enable them to learn from and exchange ideas with like-minded investors. To maintain a cost-effective, reliable, scalable, flexible computing platform, the company uses several services from Amazon Web Services, including Amazon EC2 with Elastic IP Addresses, Amazon EBS, Amazon VPC, and Amazon ELB.\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/8-securities/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"8 Securities","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: 8 Securities"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":