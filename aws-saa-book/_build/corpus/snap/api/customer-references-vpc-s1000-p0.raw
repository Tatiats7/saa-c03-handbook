ng \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-vodafone-italy-it","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-vodafone-italy-it","dateCreated":"2024-11-12T00:55:12+0000","dateUpdated":"2024-11-12T01:13:39+0000","additionalFields":{"descriptionSummary":"Vodafone Italia è una controllata con sede a Milano di Vodafone Group Plc, una società di telecomunicazioni mobili leader del settore che opera in oltre 30 paesi in tutto il mondo. Dopo 15 anni di costante crescita nel mercato della telefonia mobile italiano, oggi Vodafone conta più di 30 milioni di clienti mobili. Nell\u0027esercizio finanziario 2012 l\u0027azienda ha dichiarato più di 8 miliardi di USD di profitti derivati dai servizi.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/VodafoneItaly_Customer-Reference_Logo.c0d1be102898f136225385c08cb7cda97f88d089.png","displayLocation":"Italy","footerInfoText":"Published Date","description":"\u003cp\u003eVodafone Italy wanted a secure solution that would make it easy for its customers to buy credit for mobile phone SIM cards. Working with AWS Partner Storm Reply, Vodafone created a compliant, secure solution on AWS that can scale to handle thousands of daily transactions while reducing capital expenditures by 30%.\u003c/p\u003e\r\n","industry":"Telecommunications","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/vodafone-italy/","customer-name":"Vodafone Italy","enableShare":"1","publishedDate":"2014","contentType":"Storia del cliente","headline":"Caso di studio Vodafone Italia"}},"tags":[{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#italy","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Italy","description":"Italy","dateCreated":"2020-02-03T05:30:02+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#industry#telecommunications","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Telecommunications","description":"Telecommunications","dateCreated":"2020-01-16T17:42:41+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-0