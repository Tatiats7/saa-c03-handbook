amespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#location#other","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Other","description":"Other","dateCreated":"2021-07-30T05:52:05+0000","dateUpdated":"2022-02-03T03:31:59+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Mid-Market Territory (MMT)","description":"Mid-Market Territory (MMT)","dateCreated":"2021-06-04T06:35:43+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"}]},{"item":{"id":"customer-references#capital-express-netred-es-2025","locale":"en_US","directoryId":"customer-references","name":"capital-express-netred-es-2025","dateCreated":"2025-02-20T20:30:30+0000","dateUpdated":"2025-03-06T23:48:44+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eLa compa\u0026ntilde;\u0026iacute;a de servicios de factoring Capital Express quer\u0026iacute;a mejorar las evaluaciones de los clientes y hacer crecer su negocio, pero ten\u0026iacute;a un sistema obsoleto que dificultaba el acceso a los datos. La compa\u0026ntilde;\u0026iacute;a recurri\u0026oacute; al socio de AWS, NetRed, para migrar sus datos utilizando los servicios de Amazon Web Services (AWS). Gracias a la migraci\u0026oacute;n, Capital Express pudo crear Advance, una innovadora herramienta de gesti\u0026oacute;n financiera que ofrece un procesamiento de datos en tiempo real. La implementaci\u0026oacute;n de Advance redujo los costos operativos mensuales en un 94 por ciento. Tambi\u0026eacute;n disminuy\u0026oacute; el tiempo necesario para la inscripci\u0026oacute;n de clientes y las consultas de TI a solo cinco minutos. Estas mejoras han agilizado las operaciones y permiten una prestaci\u0026oacute;n de servicios m\u0026aacute;s r\u0026aacute;pida, lo que aumenta dr\u0026aacute;sticamente el potencial de crecimiento de Capital Express y ayuda a satisfacer las necesidades de los clientes con mayor rapidez.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Capital%20Express%20Logo%20200x70px.53db0b44c9b01b2a4966a2e27211ad98a79df25b.png","displayLocation":"Chile","footerInfoText":"2025","industry":"Financial Services","sortDate":"2025-02-20","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/capital-express-netred/","customer-name":"Capital Express","enableShare":"1","publishedDate":"2025","contentType":"Case Study","headline":"Capital Express Reduce los Costos Operativos Mensuales en un 94% con NetRed y AWS"}},"tags":[{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#amplify","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Amplify","description":"AWS Amplify","dateCreated":"202