The Icahn School of Medicine at Mount Sinai is looking for clues to the genetic causes of breast and ovarian cancers. The team uses AWS to search and analyze more than 100 TB of genomics data to investigate the causes of those aggressive forms of cancer.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/IcahnSchoolofMedicineatMountSinai_Customer-Reference_Logo.b503080db3f4a11d2c30ff4251a57e2314ee4bd1.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eThe Icahn School of Medicine at Mount Sinai is looking for clues to the genetic causes of breast and ovarian cancers. The team uses AWS to search and analyze more than 100 TB of genomics data to investigate the causes of those aggressive forms of cancer.\u003c/p\u003e\r\n","industry":"Education","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/mt-sinai/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Icahn School of Medicine at Mount Sinai","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"Icahn School of Medicine at Mount Sinai Case Study"}},"tags":[{"id":"GLOBAL#product#glacier","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon S3 Glacier","description":"Amazon S3 Glacier","dateCreated":"2020-03-02T07:03:38+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"customer-references#category#high-performance-computing","locale":"en_US","tagNamespaceId":"customer-references#category","name":"High Performance Computing","description":"High Performance Computing","dateCreated":"2019-07-22T18:32:00+0000","dateUpdated":"2022-02-26T01:35:03+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#langua