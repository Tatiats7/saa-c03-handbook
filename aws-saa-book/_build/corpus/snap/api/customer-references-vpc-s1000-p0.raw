dateCreated":"2022-05-23T21:40:41+0000","dateUpdated":"2022-05-23T21:52:14+0000","additionalFields":{"descriptionSummary":"Alan from AQR, a global investment management firm, explains how he and his team created an AWS platform as a service (PaaS), enabling teams to develop their containerized applications on Amazon ECS while providing free security certificates, SSL communication, and Kerberos authentication as side-car security services.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/AQR-logo-1x.a2a77e6347f12cc4d1dece873262941a3478ac1b.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2020-05-04","headlineUrl":"https://youtu.be/ftIdBG-UgFY?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"AQR: Using ECS to Provide Dev Teams Security \u0026 Authentication on a Scalable Container Platform","customer-name":"AQR Capital Management, LLC"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name