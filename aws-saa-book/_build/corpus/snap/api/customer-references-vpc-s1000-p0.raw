rectory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"}]},{"item":{"id":"customer-references#smatis-2019","locale":"en_US","directoryId":"customer-references","name":"smatis-2019","dateCreated":"2024-08-14T20:33:49+0000","dateUpdated":"2024-08-14T20:40:29+0000","additionalFields":{"descriptionSummary":"Étude de cas AWS : Smatis","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/logos/200x100_logos/200x100_SMATIS_Logo.b39ac17a6cd6360245b493a87935967453fe1e03.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"groupe ugo","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2019-07-09","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/smatis/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Groupe UGO","publishedDate":"2019","enableShare":"1","headline":"Étude de cas AWS : Smatis","contentType":"Customer Story"}},"t