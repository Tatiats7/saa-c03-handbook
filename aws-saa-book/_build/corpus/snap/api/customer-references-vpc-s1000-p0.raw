"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#viewfin-metaverse-case-study","locale":"en_US","directoryId":"customer-references","name":"viewfin-metaverse-case-study","dateCreated":"2019-07-19T15:11:17+0000","dateUpdated":"2023-07-14T23:32:46+0000","additionalFields":{"featured":"0","descriptionSummary":"With AWS, ViewFin Metaverse is able to build a secure, stable, and dependable blockchain-as-a-service (BaaS) platform to provide blockchain-based digital solutions to customers from a wide range of sectors including finance, business, art, and medical. ViewFin Metaverse is a fintech company focusing on blockchain technologies; its main offerings include Metaverse and Metaverse BaaS.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/China/yuanjie-logo.c3892cb3d8701ec8481321e6fdafb35de38e9822.jpg","displayLocation":"China","footerInfoText":"Published Date","description":"\u003cp\u003eWith AWS, ViewFin Metaverse is able to build a secure, stable, and dependable blockchain-as-a-service (BaaS) platform to provide blockchain-based digital solutions to customers from a wide range of sectors including finance, business, art, and medical. ViewFin Metaverse is a fintech company focusing on blockchain technologies; its main offerings include Metaverse and Metaverse BaaS. Amazon Web Services used by ViewFin Metaverse include Amazon EC2, Amazon S3, Amazon CloudWatch, Amazon DynamoDB, Amazon RDS, Amazon EMR, Amazon RedShift, Amazon Kinesis, Amazon Kinesis Firehose, Amazon ElastiCache, Amazon Elastic Container Registry (Amazon ECR), AWS IAM, and AWS Developer Support.\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/viewfin/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ViewFin Metaverse","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"ViewFin Metaverse Case Study"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":