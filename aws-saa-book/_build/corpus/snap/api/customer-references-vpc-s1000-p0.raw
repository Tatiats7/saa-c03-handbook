omer-references","name":"union-medical-healthcare-umh-case-study","dateCreated":"2019-07-19T15:19:23+0000","dateUpdated":"2023-07-12T01:35:22+0000","additionalFields":{"featured":"0","descriptionSummary":"Union Medical Healthcare (UMH) can produce key financial reports 50 percent faster while giving executives real-time insight into the company\u0027s business performance with SAP S/4HANA Finance running on AWS. UMH provides medical and healthcare services in the Greater China Region.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/UnionMedicalHealthcare_Customer-Reference_Logo.1973ac4bc7c08cecb62ce5b145e44036fbfd5e01.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","description":"\u003cp\u003eUMH studied the possibility of running SAP S/4HANA Finance on a cloud-based infrastructure. The company looked at offerings from Amazon Web Services (AWS), the Google Cloud Platform (GCP), and China-based Tencent Cloud. Says Ngai, \u001cWe quickly determined that GCP didn\u0019t have locations in China, so we decided not to use it. AWS, however, did have Chinese locations and it had worked with SAP to certify the AWS Cloud for SAP S/4HANA.\u001d\u003c/p\u003e\r\n","industry":"Healthcare","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/umh/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Union Medical Healthcare (UMH)","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Union Medical Healthcare (UMH) Case Study"}},"tags":[{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12T02:01:29+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T0