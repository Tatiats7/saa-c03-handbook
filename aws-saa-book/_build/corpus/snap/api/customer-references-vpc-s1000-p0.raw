ted":"2023-03-11T00:56:40+0000","dateUpdated":"2023-03-11T01:02:01+0000","additionalFields":{"descriptionSummary":"Aquiris is today one of the largest game developers in the country, recognized for popular games such as the racing arcade Horizon Chase Turbo, the creative Wonderbox: The Adventure Maker and the mobile F2P Looney Tunes - World of Mayhem. The company, which initially only developed its games, started using the cloud and AWS services to bring them to users, allowing hundreds of thousands of daily active players and millions of flawless sessions.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/aquiris_logo%401x.b9fb97269095ed4ca7671f3cb6930eadbff872c7.png","displayLocation":"Brazil","customerNameLower":"aquiris","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/aquiris-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Aquiris","publishedDate":"2022","enableShare":"1","headline":"With the flexibility of Amazon Web Services, Aquiris serves millions of online gamers flawlessly","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enter