.awsstatic.com/case-studies/Latam%20Cases%20Assets/Logo%20INPE%202.c1b702ffae80511fb98f867ba806734ff2c46534.png","displayLocation":"Brasil","customerNameLower":"inpe","footerInfoText":"Data de publicação","industry":"Proteção ambiental","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/INPE/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"INPE","enableShare":"1","publishedDate":"2019","contentType":"História do cliente","headline":"Estudo de caso AWS: INPE"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#archiving","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Archiving","description":"Archiving","dateCreated":"2020-06-05T06:36:56+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#data-lakes-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Data Lakes \u0026 Analytics","description":"Data Lakes \u0026 Analytics","dateCreated":"2019-07-22T18:31:39+0000","dateUpdated":"2022-02-07T13:55:55+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story"