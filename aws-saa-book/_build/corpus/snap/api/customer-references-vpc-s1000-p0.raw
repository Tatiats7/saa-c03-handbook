cale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS WAF","description":"AWS WAF","dateCreated":"2020-03-02T07:06:04+0000","dateUpdated":"2022-02-03T03:33:07+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"}]},{"item":{"id":"customer-references#baar","locale":"en_US","directoryId":"customer-references","name":"baar","dateCreated":"2023-02-21T00:04:51+0000","dateUpdated":"2024-07-11T23:51:23+0000","additionalFields":{"descriptionSummary":"Romania-based BAAR plays a key role in keeping motorists protected on the roads. An independent, nonprofit organization, it’s made up of 11 members, all of which deal with motor third-party liability (MTPL) insurance. MTPL ensures that, in the event of an accident, the driver responsible is covered for any damage to a third-party’s person or property. BAAR is also part of the Green Card system, which insures drivers under one policy for international motor travel across Europe, Asia, and North Africa.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/baar-logo%401x.48937e4036d1452ff574f44fa32a462b0f824ac8.png","displayLocation":"Romania","customerNameLower":"baar","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/baar/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"BAAR","pu