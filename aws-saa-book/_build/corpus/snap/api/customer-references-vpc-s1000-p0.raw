eated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#aws-case-study-pristine","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-pristine","dateCreated":"2019-07-22T19:57:20+0000","dateUpdated":"2023-07-14T23:32:28+0000","additionalFields":{"featured":"0","descriptionSummary":"Pristine helps medical professionals deliver quality, cost effective, and accessible care through its product, EyeSight, for Google Glass. The company is all in on the AWS Cloud and leverages tools like Docker to achieve continuous deployment with near-zero downtime.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/pristine-logo.2cfba596f191a3833df3b56b445e8c6acaa79727.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003ePristine helps medical professionals deliver quality, cost effective, and accessible care through its product, EyeSight, for Google Glass. The company is all in on the AWS Cloud and leverages tools like Docker to achieve continuous deployment with near-zero downtime. By using AWS and Docker, Pristine can build HIPAA-compliant enterprise-grade products with great efficiency.\u003c/p\u003e\r\n","industry":"Healthcare","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/pristine/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Pristine","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Pristine"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","des