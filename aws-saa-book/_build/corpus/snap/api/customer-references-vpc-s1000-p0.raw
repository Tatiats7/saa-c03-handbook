"},{"id":"GLOBAL#product#elb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Elastic Load Balancing (ELB)","description":"Elastic Load Balancing (ELB)","dateCreated":"2020-03-02T07:03:09+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#location#ssa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Sub-Saharan Africa","description":"Sub-Saharan Africa","dateCreated":"2020-03-10T05:18:06+0000","dateUpdated":"2022-02-03T03:31:58+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-jobvite","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-jobvite","dateCreated":"2019-07-22T19:51:07+0000","dateUpdated":"2023-07-14T23:32:40+0000","additionalFields":{"featured":"0","descriptionSummary":"Jobvite is a recruiting platform for the social web that integrates applicant tracking, employee referrals, recruitment marketing, and video interviews under one cloud-based platform. After experiencing unexpected service interruptions, the company migrated its entire platform—including its databases, application servers, reporting framework, and email notification services—to AWS. Using AWS, Jobvite has decreased its operational costs by 35 percent and increased the availability of its application to better than 99.98 percent.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Jobvite_Customer-Reference_Logo.7878882552c01fd4edbe8be89636822d7a057181.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eJobvite is a recruiting platform for the social web that integrates applicant tracking, employee referrals, recruitment marketing, and video interviews under one cloud-based platform. After experiencing unexpected service interruptions, the company decided to migrate its entire platform?including its databases, application servers, reporting framework, and email notification services?to AWS. By using AWS, Jobvite has decreased its operational costs by 35 percent and increased the availability of its application to better than 99.98 percent.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/jobvite/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Jobvite","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Jobvite"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"customer-references#category#business-applications-microsoft","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: Microsoft","description":"Business Applications: Microsoft","dateCreated":"2019-07-22T18:31:11+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#cont