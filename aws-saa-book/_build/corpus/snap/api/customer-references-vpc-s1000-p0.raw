8d00f9760d6.png","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003eBQool provides software that helps Amazon sellers manage reviews and feedback as well as compete with rivals. The company is running its seller software suite?Repricing Central, Feedback Central, and Review Central?in AWS. This enabled BQool to achieve 99.999 percent infrastructure availability while reducing the time required to launch new services by a month.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/bqool/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"BQool","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: BQool"}},"tags":[{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"customer-references#category#business-applications-microsoft-net","locale":"en_US","tagNamespaceId":"customer-references#category","name":"business-applications-microsoft-net","description":"Business Applications: Microsoft .NET","dateCreated":"2019-07-22T18:31:16+0000","dateUpdated":"2020-11-25T01:38:29+0000"},{"id":"GLOBAL#location#taiwan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Taiwan","description":"Taiwan","dateCreated":"2020-02-03T05:29:38+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:3