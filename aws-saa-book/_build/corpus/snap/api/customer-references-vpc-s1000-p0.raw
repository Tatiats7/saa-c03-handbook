 Entertainment","dateCreated":"2022-08-24T22:33:50+0000","dateUpdated":"2022-08-24T22:33:50+0000"},{"id":"GLOBAL#product#lex","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Lex","description":"Amazon Lex","dateCreated":"2020-03-02T07:04:21+0000","dateUpdated":"2022-02-03T03:32:47+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#innovator#sony","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Sony","description":"Sony","dateCreated":"2022-09-15T00:48:43+0000","dateUpdated":"2022-09-15T00:48:43+0000"}]},{"item":{"id":"customer-references#mercadolibreml","locale":"en_US","directoryId":"customer-references","name":"mercadolibreml","dateCreated":"2022-10-18T21:00:00+0000","dateUpdated":"2025-05-17T00:14:47+0000","additionalFields":{"descriptionSummary":"Mercado Libre es la plataforma de e-commerce más grandes de Latinoamérica. A cada segundo en Mercado Libre se concretan más de 11 compras y se realizan más de 6 mil búsquedas, generando un gran volumen de datos. La compañía desarrolló internamente una plataforma que permite almacenar y analizar datos para mejorar la experiencia del usuario. En este video, los expertos de Mercado Libre nos cuentan cómo las soluciones en la nube de AWS, cómo  sagemaker, Amazon Simple Storage Service (Amazon S3), y Amazon Elastic Compute Cloud (Amazon EC2) ayudaron a que Mercado Libre pusiera en práctica una estrategia de Machine Learning y lograra sumar valor al producto, garantizando una experiencia de uso increíble a los más de 40 millones de usuarios de su plataforma.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/case-studies/Latam%20Cases%20Assets/Mercado%20Libre_LOGO.0955d23d605c14ee7ba4d786ae7c26b703bba625.png","displayLocation":"Argentina","footerInfoText":"Fecha de publicación","industry":"Venta al por menor","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/mercadolibreml/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Mercado Libre (Mercado Livre)","publishedDate":"2020","enableShare":"1","headline":"Mercado Libre implementa su estrategia de Machine Learning con AWS","contentType":"Historia del cliente"}},"tags":[{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id