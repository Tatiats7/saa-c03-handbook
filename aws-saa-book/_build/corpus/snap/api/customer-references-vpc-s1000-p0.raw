ateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#pinterest","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Pinterest","description":"Pinterest","dateCreated":"2022-09-15T00:48:40+0000","dateUpdated":"2022-09-15T00:48:40+0000"}]},{"item":{"id":"customer-references#aws-case-study-qlik","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-qlik","dateCreated":"2019-07-22T20:00:00+0000","dateUpdated":"2023-07-14T23:32:40+0000","additionalFields":{"featured":"0","descriptionSummary":"Qlik is a worldwide leader in visual analytics and business intelligence, with a mission to help customers see the whole story that lives within their data. The company wanted to develop a SaaS-based delivery model on AWS for its Qlik Sense product. Using AWS and working with Slalom, Qlik was able to release a beta product to the public in 18 weeks, meeting an aggressive company goal.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Qlik_Customer-Reference_Logo.662c771d998b707916b0e061abb4fdef11f35243.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eQlik wanted to create a cloud-based marketplace to highlight its partners and the products and services available for Qlik\u0019s business discovery platform. Working with Model Metrics, an Advanced Consulting Partner member of the AWS Partner Network, Qlik created a scalable and secure solution for more than 1400 partners.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/qlik/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Qlik","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Qlik"}},"tags":[{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#product#ses","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Email Service (SES)","description":"Amazon Simple Email Service (SES)","dateCreated":"2020-03-02T07:05:22+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"i