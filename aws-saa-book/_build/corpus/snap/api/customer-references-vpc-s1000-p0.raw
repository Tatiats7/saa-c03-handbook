nizations","dateCreated":"2020-03-02T07:04:43+0000","dateUpdated":"2022-02-03T03:32:53+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"}]},{"item":{"id":"customer-references#bancamiga","locale":"en_US","directoryId":"customer-references","name":"bancamiga","dateCreated":"2023-06-01T23:04:11+0000","dateUpdated":"2023-06-08T04:07:43+0000","additionalFields":{"descriptionSummary":"Bancamiga es un banco universal en Venezuela con más de 500 empleados. La institución llevó un proceso de transformación e innovación tecnológica que le ha permitido idear nuevas estrategias para el sector financiero y posicionar la marca como referencia en el país. En este video, Roberto Parra, vicepresidente de Tecnología de Bancamiga, explica que la empresa eligió a AWS y al partner Siscotel para ayudarla a redefinir su infraestructura tecnológica, lo que le ha permitido más de 40% en esquemas de ahorro en infraestructura on-premises y un aumento promedio de 70% en la interacción con los clientes, entre otros beneficios.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/bancamiga-logo%402x.30615bfda3a295f7695e255aeaa41de50852896a.png","displayLocation":"Venezuela","customerNameLower":"bancamiga","footerInfoText":"Fecha de publicación","industry":"Servicios financieros","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/bancamiga/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Bancamiga","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"Bancamiga posiciona su marca en Venezuela con proceso de innovación basado en AWS"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#blockchain","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Blockchain","description":"Blockchain","dateCreated":"2020-01-16T17:43:09+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#blockchain","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Blockchain","description":"Blockchain","dateCreated":"2019-07-22T18:31:06+0000","dateUpdated":"2022-06-07T17:22:39+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#elb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Elastic Load Balancing (ELB)","description":"Elastic Load Balancing (ELB)","dateCreated":"2020-03-02T07:03:09+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","n