an in-house data center.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/CardFlight_Customer-Reference_Logo.34b7d853de065f9f57f0dd01463f85ffaf83ebe6.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eCardFlight brought its solution to market faster while reducing IT capex and opex approximately 40 percent by using an AWS PCI-compliant infrastructure instead of building and maintaining an on-premises data center. CardFlight is a payment solutions startup that helps merchants integrate EMV chip-card payments into existing mobile apps. The solution encrypts customers? sensitive financial information and delivers it to payment processors securely.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/cardflight/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"CardFlight","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: CardFlight"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#key-mgmt-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Key Management Service (KMS)","description":"AWS Key Management Service (KMS)","dateCreated":"2020-03-02T07:04:13+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"G