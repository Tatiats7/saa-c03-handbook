03:35:29+0000"}]},{"item":{"id":"customer-references#davivienda-case-study","locale":"en_US","directoryId":"customer-references","name":"davivienda-case-study","dateCreated":"2022-06-27T20:44:33+0000","dateUpdated":"2023-06-08T04:07:40+0000","additionalFields":{"descriptionSummary":"El Banco Davivienda (Davivienda), una entidad bancaria con sede en Colombia, fiel a su política de talento humano que busca desarrollar el máximo potencial de sus colaboradores y ofrecerles oportunidades de crecimiento, decidió apoyar al personal que trabaja a distancia al proporcionarles las herramientas que necesitan para realizar sus labores diarias desde casa. Aunque parte del personal ya había comenzado a trabajar a distancia, el banco tuvo que configurar una red privada virtual (VPN) para instalar nuevas estaciones de trabajo y establecer una conexión segura con los sistemas bancarios de Davivienda. Este proceso podía tardar hasta tres días en completarse y, en muchos casos, requería que el banco transportara el hardware de apoyo y otros activos fuera de las instalaciones.","featureImageURL":"https://d1.awsstatic.com/IMG_2488.f0d905de5bbd6534d402b456deb5ea21da21686a.jpeg","imageSrcUrl":"https://d1.awsstatic.com/NM%20DaviviendaLogoV1.04b25f5fc989b2f99d3af28f52db3ecee116ceb7.png","displayLocation":"Colombia","customerNameLower":"davivienda","footerInfoText":"Fecha de publicación","industry":"Servicios financieros","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/davivienda-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Davivienda","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"El Banco Davivienda adopta un modelo de lugar de trabajo híbrido mediante Amazon WorkSpaces"}},"tags":[{"id":"GLOBAL#product#directory-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Directory Service","description":"AWS Directory Service","dateCreated":"2020-03-02T07:02:45+0000","dateUpdated":"2022-02-03T03:32:30+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#euc","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"End-User Computing (EUC)","description":"End-User Computing (EUC)","dateCreated":"2020-01-16T17:43:18+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#colombia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Colombia","description":"Colombia","dateCreated":"2020-07-02T22:31:04+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#product#systems-mgr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Systems Manager","description":"AWS Systems Manager","dateCreated":"2020-03-02T07:05:44+0000","dateUpdated":"2022-02-03T03:33:03+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_U