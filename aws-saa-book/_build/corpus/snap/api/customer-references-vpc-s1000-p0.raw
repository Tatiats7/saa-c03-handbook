u003dcr_card","customer-name":"PayU","publishedDate":"2022","enableShare":"1","headline":"PayU Helps Customers Make Secure Online Payments Faster by Streamlining Firewall Management on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#network-firewall","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Network Firewall","description":"AWS Network Firewall","dateCreated":"2021-11-17T07:15:44+0000","dateUpdated":"2022-02-03T03:32:52+0000"},{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#category#finserv","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Financial Services","description":"Financial Services","dateCreated":"2019-07-22T18:31:53+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"GLOBAL#product#global-accelerator","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Global Accelerator","description":"AWS Global Accelerator","dateCreated":"2020-03-02T07:03:39+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#ypf","locale":"en_US","directoryId":"customer-references","name":"ypf","dateCreated":"2023-06-01T23:05:55+0000","dateUpdated":"2023-06-08T04:07:41+0000","additionalFields":{"descriptionSummary":"El gigante energético argentino YPF ha avanzado rápidamente durante la pandemia Covid-19 para migrar gran parte de su plataforma tecnológica a la nube. En asociación con Amazon Web Services, la quinta compañía petrolera más grande de la región ya está comenzando a ahorrar gastos en tecnología con una nueva y más flexible estructura de costos. Además, la compañía ya disfruta de un acceso más ubicuo a sus datos y también se beneficia de una postura de ciber seguridad más robusta. Los próximos pasos de la empresa incluyen aprovechar de tecnologías como la inteligencia artificial y la analítica avanzada para mejorar la toma de decisiones.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/ypf%401x.5ae68a40d601996e68c48f29787718732b03760d.png","displayLocation":"Argentina","customerNameLower":"ypf","footerInfoText":"Fecha de publicación","industry":"Energía","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/ypf/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"YPF","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"YPF mejora su TCO en tecnología con nueva estructura basada en AWS"}},"tags":[{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#industry#energy","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Energy","description":"Energy","dateCreated":"2020-07-15T21:58:51+0000","dateUpdated":"2022-02-03T03:32:02+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#argentina","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Argentina","description":"Argentina","dateCreated":"2020-06-12T23:30:42+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"}]},{"item":{"id":"customer-references#rotoplas","locale":"en_US","directoryId":"customer-references","name":"rotoplas","dateCreated":"2023-06-01T23:06:13+0000","dateUpdated":"2023-06-08T04:07:40+0000","additionalFields":{"descriptionSummary":"Grupo Rotoplas es una empresa mexicana con presencia en 15 países y con 27 líneas de productos, 17 plantas, más de 3,300 colaboradores y 12 mil distribuidores. Posee 29 mil puntos de venta y 50 mil puntos de servicios. La empresa contaba con un data center propio para su operación desde Estados Unidos hasta Argentina, y ante la edad de sus 300 servidores y la demanda por más capacidad, buscaron un proveedor que les ayudara a tener mayor escalabilidad, seguridad y disponibilidad. AWS fue su aliado en la migración de su negocio a la nube, la cual, además, se realizó en tiempo récord.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/rotoplas_Logo%401x.a2e976a6fa99d3e584ef36179ba7da5b9b65af45.png","displayLocation":"México","customerNameLower":"rotoplas","footerInfoText":"Fecha de publicación","industry":"Fabricación","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/rotoplas/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Rotoplas","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"Rotoplas reduce en un 50% los tiempos de downtime de sistemas con migración de su negocio a la nube en tiempo récord"}},"tags":[{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#cloudtrail","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudTrail","description":"AWS CloudTrail","dateCreated":"2020-03-02T07:02:05+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#product#codeguru","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CodeGuru","description":"Amazon CodeGuru","dateCreated":"2020-12-08T20:07:48+0000","dateUpdated":"2022-02-03T03:32:25+0000"},{"id":"GLOBAL#product#workdocs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon WorkDoc