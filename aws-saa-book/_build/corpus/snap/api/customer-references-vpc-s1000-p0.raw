ated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#alert-logic-cost-management","locale":"en_US","directoryId":"customer-references","name":"alert-logic-cost-management","dateCreated":"2021-10-27T08:04:31+0000","dateUpdated":"2021-12-22T23:15:09+0000","additionalFields":{"descriptionSummary":"As Alert Logic continues to migrate workloads to AWS, it has launched an organization-wide effort to manage and optimize cloud costs.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/alert-logic-logo%401x.deab4c4aed4c615da3d44f8ac3657b0e9f4b8176.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2021-10-26","headlineUrl":"https://aws.amazon.com/solutions/case-studies/alert-logic-cost-management/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Alert Logic Reduces Cloud Costs 28% by Leveraging AWS Financial Management Strategies","customer-name":"Alert Logic"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","