cial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"}]},{"item":{"id":"customer-references#skyalert","locale":"en_US","directoryId":"customer-references","name":"skyalert","dateCreated":"2023-04-19T23:27:16+0000","dateUpdated":"2023-06-08T04:07:41+0000","additionalFields":{"descriptionSummary":"SkyAlert es una empresa de tecnología innovadora que contribuye a alertar oportunamente a millones de personas que viven en zonas vulnerables, promoviendo una cultura de prevención ante riesgos naturales. Con el objetivo de brindar a los clientes, tanto empresas y negocios como particulares, las herramientas adecuadas para que puedan estar prevenidos ante un evento sísmico, SkyAlert migró recientemente su infraestructura de Azure a la nube de Amazon Web Services. Bajo la nueva tecnología, la empresa logró integrar una operación del Internet de las Cosas (IoT) a los servicios y servidores AWS, además de implantar un servicio eficiente de envío de alertas que le permite escalar y enviar millones de mensajes en pocos segundos, ayudando a salvar vidas en casos de sismos.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/skyalert_logo%401x.27b39f5ae8919cd5eac26ac7e8af6df26e3df29d.png","displayLocation":"México","customerNameLower":"skyalert","footerInfoText":"Fecha de publicación","industry":"Software e Internet","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/skyalert/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"SkyAlert","publishedDate":"2020","enableShare":"1","headline":"SkyAlert utiliza servicios AWS para ayudar a salvar vidas ante riesgos naturales","contentType":"Historia del cliente"}},"tags":[{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"IoT","description":"IoT","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBA