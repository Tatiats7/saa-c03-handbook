ycle trips, directions, driving times, traffic conditions, carpool information, parking options, and more.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/600x400__511_logo.b499e8dddec888ffb748db756c3aee7f1ba2cbdc.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"The San Francisco Bay Area\u0019s Metropolitan Transportation Commission (MTC) delivers up-to-date online traveler information to tens of thousands of commuters daily, scales to support thousands of additional website users each day, and significantly lowers costs using AWS.","industry":"Government","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/mtc511/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"MTC 511","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"MTC 511 Case Study"}},"tags":[{"id":"customer-references#category#high-performance-computing","locale":"en_US","tagNamespaceId":"customer-references#category","name":"High Performance Computing","description":"High Performance Computing","dateCreated":"2019-07-22T18:32:00+0000","dateUpdated":"2022-02-26T01:35:03+0000"},{"id":"GLOBAL#product#appstream2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon AppStream 2.0","description":"Amazon AppStream 2.0","dateCreated":"2020-03-02T07:01:30+0000","dateUpdated":"2022-02-03T03:32:17+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:4