OBAL#use-case","name":"High Performance Compute","description":"High Performance Compute","dateCreated":"2020-06-05T06:37:26+0000","dateUpdated":"2022-02-03T03:35:41+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#aws-case-study-national-renewable-energy-laboratory-s-openei-org","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-national-renewable-energy-laboratory-s-openei-org","dateCreated":"2019-07-22T19:54:23+0000","dateUpdated":"2023-07-12T01:40:42+0000","additionalFields":{"featured":"0","descriptionSummary":"\u003cp\u003eThe National Renewable Energy Laboratory (NREL) is the primary laboratory for renewable energy research in the United States. Using AWS, the organization can launch new websites in days instead of weeks and share energy data with thousands of researchers across the globe while reducing data curation costs by nearly 30 percent.\u003c/p\u003e\r\n","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/NationalRenewableEnergyLaboratory_Customer-Reference_Logo.6d75ba63a42d62495406cd0ae129d12d95793e69.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eOpenEI.org, managed for the U.S. Department of Energy by its National Renewable Energy Laboratory, is a free, open source knowledge sharing platform created to facilitate access to data, models, tools, and information that accelerate the transition to clean energy systems through informed decisions. Built on AWS, OpenEI.org makes use of Amazon EC2, Amazon EBS, Amazon S3, and Elastic Load Balancing.\u003c/p\u003e\r\n","industry":"Power \u0026 Utilities","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/openei/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"National Renewable Energy Laboratory","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: National Renewable Energy Laboratorys OpenEI.org"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"