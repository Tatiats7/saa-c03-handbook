","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"}]},{"item":{"id":"customer-references#waypoint","locale":"en_US","directoryId":"customer-references","name":"waypoint","dateCreated":"2023-06-01T23:03:55+0000","dateUpdated":"2023-06-08T04:07:43+0000","additionalFields":{"descriptionSummary":"Waypoint es una empresa chilena dedicada al desarrollo de logística, despacho, control y monitoreo de transporte de servicio y alimentos, mediante tecnología telemétrica y localización GPS. Las operaciones de Waypoint exigen un control absoluto de tracking de origen a destino, cumpliendo cada una de las demandas del servicio que ofrecen a sus clientes. En el año 2015, una crisis de blackout por espacio de 16 horas, produjo la necesidad de buscar un proveedor de tecnología que les permitiera blindar los procesos. Así aparece AWS para Waypoint. Para conocer más detalle sobre la historia, vea a Gonzalo Vásquez, Gerente de Investigación y Desarrollo de la compañía, quien explica por qué AWS les ha permitido mantener el control de una manera no sólo inmediata sino transparente, beneficiando a sus clientes finales. Conozca su experiencia sobre la tecnología y servicio de AWS y el impacto en el mejoramiento del negocio de Waypoint.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/case-studies/Latam%20Cases%20Assets/Waypoint_LOGO1.a773dad7304ac53374e6cae8b348902c08b232ff.png","displayLocation":"Chile","customerNameLower":"waypoint","footerInfoText":"Fecha de publicación","industry":"Servicios profesionales","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/waypoint/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Waypoint","enableShare":"1","publishedDate":"2019","contentType":"Historia del cliente","headline":"Caso práctico de Waypoint"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","da