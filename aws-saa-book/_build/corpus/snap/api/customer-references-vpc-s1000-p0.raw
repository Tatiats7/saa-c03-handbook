escription":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#workload#sap","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"SAP","description":"SAP","dateCreated":"2021-01-06T00:09:56+0000","dateUpdated":"2022-02-03T03:36:05+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#indonesia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Indonesia","description":"Indonesia","dateCreated":"2020-02-03T05:29:22+0000","dateUpdated":"2022-02-03T03:31:36+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#btobet-case-study","locale":"en_US","directoryId":"customer-references","name":"btobet-case-study","dateCreated":"2022-10-03T18:33:44+0000","dateUpdated":"2022-10-11T21:03:06+0000","additionalFields":{"descriptionSummary":"Betting on sporting events from the Olympics to Premier League soccer matches is a billion-dollar market characterized by surges in customer demand around live events. BtoBet provides betting and gambling businesses with its sportsbook solution, allowing individuals to place bets on sporting events. Since migrating to AWS, BtoBet can scale compute resources to handle spikes in demand and deliver a responsive experience for its partners and their players. It has also launched in new global markets and has the resources to support triple-digit customer growth. Using AWS, the company can manage double the volume of betting transactions without expanding its IT team.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/btobet-logo%401x.4df0a2219e8e635f58051432a3203b73a47807fd.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"btobet","footerInfoText":"Published Date","