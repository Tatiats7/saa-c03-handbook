":"2019-07-22T19:47:23+0000","dateUpdated":"2023-07-14T23:32:32+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, Kdan Mobile supported growth from 1.5 million users to 10 million users over three years, achieved 99.999 percent availability, and is able to scale to support demand peaks. Kdan Mobile provides mobile applications and online services for digital content creation.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/600x400_kdan_logo.2380170ac123049bdc06be08c5cfd2255da4c87a.png","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003eUsing AWS, Kdan Mobile supported growth from 1.5 million users to 10 million users over three years, achieved 99.999 percent availability, and is able to scale to support demand peaks.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/kdan/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Kdan Mobile","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"Kdan Mobile Case Study"}},"tags":[{"id":"GLOBAL#industry#cpg","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Consumer Packaged Goods (CPG)","description":"Consumer Packaged Goods (CPG)","dateCreated":"2020-06-25T04:03:18+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#taiwan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Taiwan","description":"Taiwan","dateCreated":"2020-02-03T05:29:38+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35: