"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#aws-case-study-anhanguera","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-anhanguera","dateCreated":"2019-07-22T19:54:48+0000","dateUpdated":"2022-01-21T02:42:17+0000","additionalFields":{"featured":"0","descriptionSummary":"Anhanguera is one of the largest universities in Brazil and one of the largest users of Moodle, an e-learning platform for collaborative learning. When Anhanguera needed to scale the platform to meet user demand, the university leveraged AWS to build a solution that would deliver applications reliably and grow with the user population.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Anhanguera_Customer-Reference_Logo.a52da7ba983a72d4abb2a0668473812fed0788c0.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eAnhanguera is one of the largest universities in Brazil and one of the largest users of Moodle, an e-learning platform for collaborative learning. When Anhanguera needed to scale the platform to meet user demand, the university leveraged AWS to build a solution that would deliver applications reliably and grow with the user population.\u003c/p\u003e\r\n","industry":"Education","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/anhanguera/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Anhanguera","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Anhanguera"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34