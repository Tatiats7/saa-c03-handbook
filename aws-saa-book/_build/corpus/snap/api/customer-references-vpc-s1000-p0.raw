2-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#location#mexico","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Mexico","description":"Mexico","dateCreated":"2020-04-09T00:25:53+0000","dateUpdated":"2022-02-03T03:31:31+0000"}]},{"item":{"id":"customer-references#beetrack-fargate","locale":"en_US","directoryId":"customer-references","name":"beetrack-fargate","dateCreated":"2023-06-01T23:11:48+0000","dateUpdated":"2023-07-14T23:32:26+0000","additionalFields":{"descriptionSummary":"Beetrack es un software para la optimización y el monitoreo de entregas de última milla. La empresa comenzó en 2013 con una infraestructura en la nube de Amazon Web Services (AWS). Con una cultura de innovación continua, Beetrack siempre fue adoptando las más nuevas tecnologías de AWS, lo que le ha permitido crecer rápidamente y avanzar en las ofertas de servicios entregando cada vez mayor valor a sus clientes. Actualmente también utiliza tecnologías de seguridad, para contenedores y de desarrollos de aplicaciones serverless que garantizan integración con ERPs de los clientes, además de flexibilidad casi infinita para el procesamiento de más de 400 requests por segundo.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/beetrack-logo%402x.1a4238024f77f037b566df7c64a2bb57a731341a.png","displayLocation":"Colombia","footerInfoText":"Fecha de publicación","industry":"Transporte y logística","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/beetrack-fargate/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"Beetrack","contentType":"Historia del cliente","headline":"Beetrack usa AWS para entregar una excelente experiencia a todo un ecosistema"}},"tags":[{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#colombia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Colombia","description":"Colombia","dateCreated":"2020-07-02T22:31:04+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNames