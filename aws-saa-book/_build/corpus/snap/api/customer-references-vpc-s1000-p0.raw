":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRed Lion Hotels Corporation is about to launch a set of web and mobile platforms that will provide hyper-localized research and booking experiences for travelers. AWS Solutions Provider 2nd Watch is helping Red Lion migrate from a co-location facility in order to develop the new platforms on Amazon EC2 with Elastic Load Balancing, Amazon S3, Amazon VPC, and Amazon CloudFront.\u003c/p\u003e\r\n","industry":"Travel \u0026 Hospitality","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/red-lion/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Red Lion Hotels","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Red Lion Hotels"}},"tags":[{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"customer-references#category#business-applications-microsoft","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: Microsoft","description":"Business Applications: Microsoft","dateCreated":"2019-07-22T18:31:11+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category"