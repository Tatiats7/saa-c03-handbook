product#global-accelerator","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Global Accelerator","description":"AWS Global Accelerator","dateCreated":"2020-03-02T07:03:39+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#product#appmesh","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS App Mesh","description":"AWS App Mesh","dateCreated":"2020-03-02T07:01:28+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Internet of Things (IoT)","description":"Internet of Things (IoT)","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2023-08-22T20:28:39+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#hcls","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Healthcare \u0026 Life Sciences","description":"Healthcare \u0026 Life Sciences","dateCreated":"2019-07-22T18:31:58+0000","dateUpdated":"2022-05-14T20:13:37+0000"}]},{"item":{"id":"customer-references#orange-bank","locale":"en_US","directoryId":"customer-references","name":"orange-bank","dateCreated":"2023-06-01T23:05:17+0000","dateUpdated":"2023-07-18T00:18:09+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eOrange Bank, premi\u0026egrave;re banque 100% mobile fran\u0026ccedil;aise, mise sur la simplicit\u0026eacute; et sur les services innovants pour se d\u0026eacute;marquer par rapport \u0026agrave; ses concurrents. Pour r\u0026eacute;aliser sa strat\u0026eacute;gie, elle a d\u0026eacute;cid\u0026eacute;, accompagn\u0026eacute;e par Ippon, AWS Advanced Consulting Partner, de migrer sur le Cloud AWS. \u0026Agrave; la cl\u0026eacute; : la ma\u0026icirc;trise de son SI, une homog\u0026eacute;n\u0026eacute;isation des outils et des pratiques, et la mise en place d\u0026rsquo;un environnement DevOps. Le tout lui donne l\u0026rsquo;agilit\u0026eacute; n\u0026eacute;cessaire pour ses projets futurs, tout en ayant gagn\u0026eacute; en s\u0026eacute;curit\u0026eacute; et en ayant limit\u0026eacute; ses besoins en ressources gr\u0026acirc;ce aux services manag\u0026eacute;s.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Orange%20Bank%20-%20logo.d05bec6ebdbaee8d15be1d077b4cdb7790fe5ef4.png","displayLocation":"France","customerNameLower":"orange bank","footerInfoText":"Date de publication","industry":"Services financiers","sortDate":"2023-03-23","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/orange-bank/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Orange Bank","enableShare":"1","publishedDate":"2023","contentType":"Témoignages clients","headline":"Orange Bank gagne la maîtrise de son SI avec Ippon et AWS"}},"tags":[{"id":"GLOBAL#language#french","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"French","description":"French","dateCreated":"2020-03-03T06:40:44+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#category#finserv","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Financial Services","description":"Financial Services","dateCreated":"2019-07-22T18:31:53+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type