0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#infor-govcloud","locale":"en_US","directoryId":"customer-references","name":"infor-govcloud","dateCreated":"2020-10-07T21:30:10+0000","dateUpdated":"2023-07-12T01:35:17+0000","additionalFields":{"featured":"0","descriptionSummary":"Business SaaS applications leader Infor grows its regulated industries SaaS business 100 percent annually by going all in on AWS and using AWS GovCloud (US) secure, multilayered regulatory compliance capabilities.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Infor_Customer-Reference_Logo.e38229a2c8481a14fdcf67d002b2a25379808c7a.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"General Public Services","sortDate":"2020-10-07","headlineUrl":"https://aws.amazon.com/solutions/case-studies/infor-govcloud/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Infor","enableShare":"1","publishedDate":"2020","contentT