nt Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#zalora-sap-case-study","locale":"en_US","directoryId":"customer-references","name":"zalora-sap-case-study","dateCreated":"2020-07-06T18:16:56+0000","dateUpdated":"2023-07-14T23:32:41+0000","additionalFields":{"descriptionSummary":"By launching SAP S/4HANA on AWS, Zalora has streamlined internal processes such as backups and system refreshes, expanding its compute capacity by 900 percent in two years.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/ZALORA_Customer-Reference_Logo.f2c0ecd929fa5ab5f003a6b21ce8894c1bf52776.png","displayLocation":"S