description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#personalize","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Personalize","description":"Amazon Personalize","dateCreated":"2020-03-02T07:04:50+0000","dateUpdated":"2022-02-03T03:32:54+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"}]},{"item":{"id":"customer-references#quasar","locale":"en_US","directoryId":"customer-references","name":"quasar","dateCreated":"2023-06-01T23:06:29+0000","dateUpdated":"2023-06-08T04:07:46+0000","additionalFields":{"descriptionSummary":"Criada em 2019, a Quasar é uma consultoria especializada no desenvolvimento de softwares de gestão pública. No início de 2021, a empresa fechou um grande contrato com o governo de Minas Gerais, que representou crescimento e, ao mesmo tempo, o desafio de adequar seus preços para que pudesse levar suas soluções a municípios com até 20 mil habitantes. Com o apoio da AWS, a Quasar conseguiu redesenhar sua arquitetura, reduzindo seus custos em 90% e deixando-a pronta para atender este novo público.","featureImageURL":"https://d1.awsstatic.com/awsmp/solutions/security/rsinstititeu_cloudimage.20c280149af28044b9fdc570ce88f534e828a103.png","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/quasar_logo%402x.cd3754713ac6806a4230a2a