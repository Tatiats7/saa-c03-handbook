00","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#avaloq02022022jknsfelinaflnks","locale":"en_US","directoryId":"customer-references","name":"avaloq02022022jknsfelinaflnks","dateCreated":"2022-05-23T21:40:44+0000","dateUpdated":"2022-05-23T21:52:15+0000","additionalFields":{"descriptionSummary":"Avaloq, a leading financial technology and services provider for banking and wealth management, built a system to generate full-fledged and highly secure core banking environments (\"bank-in-a-box\") in the AWS Cloud. The brain for this system is built on Amazon EKS, which allows Avaloq to focus on activities that generate value for their customers, while AWS does the operational heavy lifting.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/avaloq-logo%401x.524ec7a24e6ffb83ebd7867cd8f01ba52354b654.png","displayLocation":"Switzerland","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-02-02","headlineUrl":"https://youtu.be/XG6mHvi4eNU?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Avaloq: Automating the Provisioning of a Bank-in-a-Box in Minutes Using Amazon EKS","customer-name":"Avaloq"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#ecr","locale":"en_US","tagNamespaceId":"GLOBAL#product","na