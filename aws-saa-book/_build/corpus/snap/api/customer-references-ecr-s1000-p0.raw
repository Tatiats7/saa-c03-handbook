id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#ecr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Registry (ECR)","description":"Amazon Elastic Container Registry (ECR)","dateCreated":"2020-03-02T07:02:55+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#confeorg","locale":"en_US","directoryId":"customer-references","name":"confeorg","dateCreated":"2023-06-01T23:11:31+0000","dateUpdated":"2023-07-14T23:32:26+0000","additionalFields":{"descriptionSummary":"La Confederación Nacional de Organismos de Apoyo al Tránsito (CONFEORG) es una entidad sin ánimo de lucro que agremia y representa a los organismos de apoyo a las autoridades de tránsito; empresas que prestan servicios relacionados con el tránsito en Colombia como: exámenes de aptitud médica y psicométrica, cursos de enseñanza automovilística para aspirantes a conducir vehículos, revisiones técnico-mecánicas y de emisiones contaminantes de vehículos, y cursos sobre normas de tránsito para infractores. Con la ayuda de AWS y su partner IKTINUS, lograron lanzar la aplicación en tiempo récord y cumplieron con todos los requisitos exigidos por la Superintendencia de Industria y Comercio (SIC), entre ellos, tener una disponibilidad del 98.5%.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/confeorg-logo%402x.479e4b1f2e7e0e6e7b083ea42625f1a5a3b5ff58.png","displayLocation":"Colombia","footerInfoText":"Fecha de publicación","industry":"Servicios profesionales","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/confeorg/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"Confederación Nacional de Organismos de Apoyo al Tránsito","contentType":"Historia del cliente","headline":"CONFEORG logra lanzar una plataforma virtual pública con los servicios de AWS"}},"tags":[{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notification Service (SNS)","dateCreated":"2020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000