t","dateCreated":"2020-06-05T07:06:46+0000","dateUpdated":"2022-02-03T03:31:03+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#product#codebuild","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodeBuild","description":"AWS CodeBuild","dateCreated":"2020-03-02T07:02:08+0000","dateUpdated":"2022-02-03T03:32:24+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#hpi-case-study","locale":"en_US","directoryId":"customer-references","name":"hpi-case-study","dateCreated":"2023-09-06T08:23:11+0000","dateUpdated":"2023-09-06T09:30:44+0000","additionalFields":{"descriptionSummary":"HP Inc. was formerly known as Hewlett-Packard (HP), HP Inc. was founded in 1939 with headquarters in California, USA, technology company with businesses covering IT infrastructures, global services, commercial and home computers, and print and image services. HP owns business entities worldwide, including HP Information Technology R\u0026D (Shanghai) Co., Ltd., which focuses on HP printers and personal systems. Its software R\u0026D department, tasked to develop a unified service platform for HP’s personal system software (PSSW), plans to deploy the HP Horizon Platform on Amazon Web Services.","imageSrcUrl":"https://d1.awsstatic.com/case-studies-cards-imgs/hpi-logo%2070x70.355355049fd876322f8328073237be221ff002ab.png","displayLocation":"China","customerNameLower":"hpi","footerInfoText":"Published Date","industry":"Manufacturing","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/hpi-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"HPI","publishedDate":"2021","enableShare":"1","headline":"HP Inc. Powers its Horizon Platform in China on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagName