arketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2023-03-aws-storage-gateway-new-regions","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2023/03/aws-storage-gateway-new-regions/","dateCreated":"2023-11-09T15:02:30+0000","dateUpdated":"2024-07-25T14:27:03+0000","additionalFields":{"postBody":"\u003cp\u003eAWS Storage Gateway expands availability to the AWS Asia Pacific (Hyderabad) and AWS Asia Pacific (Melbourne) Regions enabling customers to deploy and manage hybrid cloud storage for their on-premises workloads.\u003c/p\u003e\r\n\u003cp\u003eAWS Storage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited storage in the cloud. You can use AWS Storage Gateway for backing up and archiving data to AWS, providing on-premises file shares backed by cloud storage, and providing on-premises applications low latency access to data in the cloud.\u003c/p\u003e\r\n\u003cp\u003eVisit the AWS Storage Gateway \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eproduct page\u003c/a\u003e to learn more. Access the AWS Storage Gateway \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003econsole\u003c/a\u003e to get started. To see all the Regions where AWS Storage Gateway is available, please visit the \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Region table\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2023-03-15T17:03:10Z","headlineUrl":"/about-aws/whats-new/2023/03/aws-storage-gateway-new-regions/","postDateTime":"2023-03-15T12:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway is now available in AWS Asia Pacific (Hyderabad) and AWS Asia Pacific (Melbourne) Regions","postSummary":"\u003cp\u003eAWS Storage Gateway expands availability to the AWS Asia Pacific (Hyderabad) and AWS Asia Pacific (Melbourne) Regions enabling customers to deploy and manage hybrid cloud storage for their on-premises workloads.\u003c/p\u003e\r\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2023","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2023","description":"year#2023","dateCreated":"2023-11-07T18:00:12+0000","dateUpdated":"2023-11-07T18:00:12+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2023-01-aws-storage-gateway-europe-spain-zurich-regions","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2023/01/aws-storage-gateway-europe-spain-zurich-regions/","dateCreated":"2023-11-09T14:48:06+0000","dateUpdated":"2024-07-25T14:51:58+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e expands availability to the AWS Europe (Spain) and AWS Europe (Zurich) Regions enabling customers to deploy and manage hybrid cloud storage for their on-premises workloads.\u003c/p\u003e\r\n\u003cp\u003eAWS Storage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited storage in the cloud. You can use AWS Storage Gateway for backing up and archiving data to AWS, providing on-premises file shares backed by cloud storage, and providing on-premises applications low latency access to data in the cloud.\u003c/p\u003e\r\n\u003cp\u003eVisit the AWS Storage Gateway \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eproduct page\u003c/a\u003e to learn more. Access the AWS Storage Gateway \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003econsole\u003c/a\u003e to get started. To see all the Regions where AWS Storage Gateway is available, please visit the \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Region table\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2023-01-26T19:28:13Z","headlineUrl":"/about-aws/whats-new/2023/01/aws-storage-gateway-europe-spain-zurich-regions/","postDateTime":"2023-01-26T08:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway is now available in AWS Europe (Spain) and AWS Europe (Zurich) Regions","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e expands availability to the AWS Europe (Spain) and AWS Europe (Zurich) Regions enabling customers to deploy and manage hybrid cloud storage for their on-premises workloads.\u003c/p\u003e\r\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#year#2023","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2023","description":"year#2023","dateCreated":"2023-11-07T18:00:12+0000","dateUpdated":"2023-11-07T18:00:12+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-12-aws-storage-gateway-management-console-file-share-creation-amazon-s3-file-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/12/aws-storage-gateway-management-console-file-share-creation-amazon-s3-file-gateway/","dateCreated":"2023-11-09T14:44:34+0000","dateUpdated":"2024-07-25T15:00:58+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e now makes it simpler and faster for you to get started with setting up and managing your hybrid cloud storage workflow with \u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/s3/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon S3 File Gateway\u003c/a\u003e. Using the Storage Gateway management console, you can now quickly create a new file share in a single step and just a few clicks: Choose between configuring an NFS or an SMB file share. Then, connect to a new or existing Amazon S3 bucket. Lastly, finalize your file share access configuration. In addition to a refreshed look and feel, you get enhanced wizard instructions and updated in-console help panel information, helping you to seamlessly navigate the file share creation process.\u003c/p\u003e\r\n\u003cp\u003eAmazon S3 File Gateway enables your on-premises applications to seamlessly store files as objects in Amazon S3, and access them using industry standard file access protocols NFS and SMB. You can use Amazon S3 File Gateway for migrating on-premises file data to AWS while maintaining fast on-premises access to recently accessed data, backing up on-premises file data to AWS, and providing on-premises applications low latency access to data stored in Amazon S3.\u003c/p\u003e\r\n\u003cp\u003eThis capability is available starting today in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eall AWS Regions\u003c/a\u003e. Visit the \u003ca href\u003d\"https://docs.aws.amazon.com/filegateway/latest/files3/what-is-file-s3.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eStorage Gateway User guide\u003c/a\u003e to learn more, or log into the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eStorage Gateway management console\u003c/a\u003e to get started.\u003c/p\u003e\r\n","modifiedDate":"2022-12-27T18:02:23Z","headlineUrl":"/about-aws/whats-new/2022/12/aws-storage-gateway-management-console-file-share-creation-amazon-s3-file-gateway/","postDateTime":"2022-12-27T13:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway management console simplifies file share creation for Amazon S3 File Gateway","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e now makes it simpler and faster for you to get started with setting up and managing your hybrid cloud storage workflow with \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/file/s3.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon S3 File Gateway\u003c/a\u003e. Using the Storage Gateway management console, you can now quickly create a new file share in a single step and just a few clicks: Choose between configuring an NFS or an SMB file share. Then, connect to a new or existing Amazon S3 bucket. Lastly, finalize your file share access configuration. In addition to a refreshed look and feel, you get enhanced wizard instructions and updated in-console help panel information, helping you to seamlessly navigate the file share creation process.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-12-aws-storage-gateway-terraform-modules-amazon-s3-file-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/12/aws-storage-gateway-terraform-modules-amazon-s3-file-gateway/","dateCreated":"2023-11-09T14:43:40+0000","dateUpdated":"2024-07-25T14:45:33+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e introduces Terraform modules for deploying Amazon S3 File Gateways in VMware environments. You can now leverage Infrastructure as Code (IaC) to automate and streamline the provisioning and configuration of Amazon S3 File Gateways, providing users with a faster, repeatable, and secure deployment option that can scale.\u003c/p\u003e\r\n\u003cp\u003eThis new capability provides you with a customizable Terraform module that you can use to provision Amazon S3 File Gateways, and create all the resources and dependencies needed to fully deploy the gateway and file shares in your VMware environment. The Terraform module will provision the gateway VM, activate the gateway, configure the cache disk, join the gateway to a domain, create the S3 buckets, and create the file shares and map them to the S3 buckets. Customers can get started by downloading the \u003ca href\u003d\"https://github.com/aws-ia/terraform-aws-storagegateway\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eTerraform Storage Gateway module\u003c/a\u003e source code on GitHub. Please refer to this \u003ca href\u003d\"https://aws.amazon.com/blogs/storage/automate-amazon-s3-file-gateway-deployments-in-vmware-with-terraform-by-hashicorp/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eblog\u003c/a\u003e for details on how to use this new capability.\u003c/p\u003e\r\n\u003cp\u003eAWS Storage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited storage in the cloud. You can use AWS Storage Gateway for backing up and archiving data to AWS, providing on-premises file shares backed by cloud storage, and providing on-premises applications low latency access to data in the cloud.\u003c/p\u003e\r\n\u003cp\u003eVisit the AWS Storage Gateway \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eproduct page\u003c/a\u003e, and access the AWS Storage Gateway \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003econsole\u003c/a\u003e to get started. To see all the Regions where AWS Storage Gateway is available, please visit the \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Region table\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2022-12-16T19:10:52Z","headlineUrl":"/about-aws/whats-new/2022/12/aws-storage-gateway-terraform-modules-amazon-s3-file-gateway/","postDateTime":"2022-12-16T13:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway introduces Terraform modules for Amazon S3 File Gateway","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e introduces Terraform modules for deploying Amazon S3 File Gateways in VMware environments. You can now leverage Infrastructure as Code (IaC) to automate and streamline the provisioning and configuration of Amazon S3 File Gateways, providing users with a faster, repeatable, and secure deployment option that can scale.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-11-aws-storage-gateway-available-aws-middle-east-uae-region","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/11/aws-storage-gateway-available-aws-middle-east-uae-region/","dateCreated":"2023-11-09T14:41:10+0000","dateUpdated":"2024-07-25T14:31:41+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e expands availability to the AWS Middle East (UAE) Region enabling customers to deploy and manage hybrid cloud storage for their on-premises workloads.\u003c/p\u003e\r\n\u003cp\u003eAWS Storage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited storage in the cloud. You can use AWS Storage Gateway for backing up and archiving data to AWS, providing on-premises file shares backed by cloud storage, and providing on-premises applications low latency access to data in the cloud.\u003c/p\u003e\r\n\u003cp\u003eVisit the AWS Storage Gateway \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eproduct page\u003c/a\u003e to learn more. Access the AWS Storage Gateway \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003econsole\u003c/a\u003e to get started. To see all the Regions where AWS Storage Gateway is available, please visit the \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Region table\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2022-11-10T22:30:44Z","headlineUrl":"/about-aws/whats-new/2022/11/aws-storage-gateway-available-aws-middle-east-uae-region/","postDateTime":"2022-11-10T13:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway is now available in the AWS Middle East (UAE) Region","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e expands availability to the AWS Middle East (UAE) Region enabling customers to deploy and manage hybrid cloud storage for their on-premises workloads.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-10-aws-storage-gateway-increases-cloud-upload-download-performance-2x-tape-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/10/aws-storage-gateway-increases-cloud-upload-download-performance-2x-tape-gateway/","dateCreated":"2023-11-09T14:43:10+0000","dateUpdated":"2024-07-25T14:26:44+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e increases \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eTape Gateway\u003c/a\u003e throughput performance by up to 2x for backing up data to and restoring data from the cloud, helping you to meet application backup and recovery times of your business. With this launch, your on-premises Tape Gateway can backup data to the cloud up to 2x faster than before, up to 5.2 Gbps, and read data from the cloud up to 2x faster than before, up to 8 Gbps. This enhancement enables you to upload more data per gateway to the cloud in your backup window, accelerate restore times of your data stored in the cloud, and optimize on-premises storage used by the gateway.\u003c/p\u003e\r\n\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/#supported_backup_software\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eTape Gateway supports all leading backup applications\u003c/a\u003e and enables you to replace physical tapes on premises with virtual tapes in AWS without changing existing workflows. Tape Gateway caches data on premises for low-latency access, compresses and encrypts data in transit to AWS, and transitions virtual tapes from Amazon S3 Standard to Amazon S3 Glacier Flexible Retrieval or Amazon S3 Glacier Deep Archive to help you minimize storage costs. \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Snowball with Tape Gateway\u003c/a\u003e supports offline migration of data stored on physical tapes to AWS.\u003c/p\u003e\r\n\u003cp\u003eThis performance enhancement is available on new gateways starting today and will be made available on existing gateways through a software update starting October 13, 2022. This new performance enhancement is available at no additional cost. For best practices on achieving higher throughput performance, visit the AWS Storage Gateway \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/tgw/Performance.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eUser Guide\u003c/a\u003e. To get started, visit the AWS Storage Gateway \u003ca href\u003d\"http://console.aws.amazon.com/storagegateway\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003econsole\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2022-10-06T21:39:11Z","headlineUrl":"/about-aws/whats-new/2022/10/aws-storage-gateway-increases-cloud-upload-download-performance-2x-tape-gateway/","postDateTime":"2022-10-06T12:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway increases cloud upload and download performance by up to 2x for Tape Gateway","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e increases \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/vtl.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eTape Gateway\u003c/a\u003e throughput performance by up to 2x for backing up data to and restoring data from the cloud, helping you to meet application backup and recovery times of your business. With this launch, your on-premises Tape Gateway can backup data to the cloud up to 2x faster than before, up to 5.2 Gbps, and read data from the cloud up to 2x faster than before, up to 8 Gbps. This enhancement enables you to upload more data per gateway to the cloud in your backup window, accelerate restore times of your data stored in the cloud, and optimize on-premises storage used by the gateway.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-10-aws-storage-gateway-simplifies-gateways-alarms","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/10/aws-storage-gateway-simplifies-gateways-alarms/","dateCreated":"2023-11-09T14:53:42+0000","dateUpdated":"2024-07-25T14:37:57+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e\u0026nbsp;makes it simpler and faster for you to start setting up and managing your hybrid-cloud storage workflows. Now, using the Storage Gateway console, you can easily create an \u003ca href\u003d\"https://aws.amazon.com/pm/ec2/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon EC2\u003c/a\u003e\u0026nbsp;instance for your cloud-based gateway in just a few clicks. In the updated \u003cb\u003eCreate Gateway\u003c/b\u003e wizard, simply enter the VPC network, VPC subnet, and key pair for your EC2 instance and select \u003cb\u003eLaunch instance\u003c/b\u003e to automatically create and launch an EC2 instance with minimally required settings including instance type, cache storage, upload buffer, and inbound security ports.\u003c/p\u003e\r\n\u003cp\u003eIn addition, you can now automatically configure recommended \u003ca href\u003d\"https://aws.amazon.com/cloudwatch/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon CloudWatch\u003c/a\u003e\u0026nbsp;alarms for your gateway, helping you proactively monitor your gateway’s health in one click. In the updated \u003cb\u003eCreate Gateway\u003c/b\u003e wizard, select \u003cb\u003eCreate Storage Gateway’s recommended alarms\u003c/b\u003e\u0026nbsp;and Storage Gateway automatically configures a set of best practice alarms for your new gateway.\u0026nbsp;You can also add recommended or custom alarms to your existing gateway by navigating to your gateway’s detail page and selecting this option from the \u003cb\u003eMonitoring\u003c/b\u003e tab. Once you have configured your alarms, you can easily monitor the alarm state of your gateways from the \u003cb\u003eGateway overview\u003c/b\u003e page.\u003c/p\u003e\r\n\u003cp\u003eAWS Storage Gateway is a hybrid-cloud storage service that provides on-premises applications access to virtually unlimited storage in the cloud. You can use Storage Gateway for backing up and archiving data to AWS, providing on-premises file shares backed by cloud storage, and providing on-premises applications low-latency access to in-cloud data.\u003c/p\u003e\r\n\u003cp\u003eThis capability is available in all \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Regions\u003c/a\u003e where Storage Gateway is available. For AWS Storage Gateway pricing information, visit the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/pricing/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003epricing page\u003c/a\u003e. To get started, visit the AWS Storage Gateway \u003ca href\u003d\"https://signin.aws.amazon.com/signin?redirect_uri\u003dhttps%3A%2F%2Fus-west-1.console.aws.amazon.com%2Fstoragegateway%3Ffromtb%3Dtrue%26hashArgs%3D%2523%26isauthcode%3Dtrue%26region%3Dus-west-1%26state%3DhashArgsFromTB_us-west-1_d3333f7222e14a03\u0026amp;client_id\u003darn%3Aaws%3Asignin%3A%3A%3Aconsole%2Fstoragegateway\u0026amp;forceMobileApp\u003d0\u0026amp;code_challenge\u003dtnVGNfmN7thLXGYtVQacD-1tgTTs5qj6eboWP4WUq5A\u0026amp;code_challenge_method\u003dSHA-256\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003econsole\u003c/a\u003e. To learn more, visit the AWS Storage Gateway \u003ca href\u003d\"https://docs.aws.amazon.com/filegateway/latest/filefsxw/Main_monitoring-gateways-common.html#cloudwatch-alarms-create-recommended\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eUser Guide\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2022-10-06T21:43:10Z","headlineUrl":"/about-aws/whats-new/2022/10/aws-storage-gateway-simplifies-gateways-alarms/","postDateTime":"2022-10-06T07:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway simplifies creating new gateways and alarms ","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e\u0026nbsp;makes it simpler and faster for you to start setting up and managing your hybrid-cloud storage workflows. Now, using the Storage Gateway console, you can easily create an \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/pm/ec2.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon EC2\u003c/a\u003e\u0026nbsp;instance for your cloud-based gateway in just a few clicks. In the updated \u003cb\u003eCreate Gateway\u003c/b\u003e wizard, simply enter the VPC network, VPC subnet, and key pair for your EC2 instance and select \u003cb\u003eLaunch instance\u003c/b\u003e to automatically create and launch an EC2 instance with minimally required settings including instance type, cache storage, upload buffer, and inbound security ports.\u003c/p\u003e\r\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-10-aws-storage-gateway-15-tib-tapes","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/10/aws-storage-gateway-15-tib-tapes/","dateCreated":"2023-11-09T14:55:22+0000","dateUpdated":"2024-07-25T14:37:59+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e\u0026nbsp;increases the maximum supported virtual tape size on \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eTape Gateway\u003c/a\u003e\u0026nbsp;from 5 TiB to 15 TiB, enabling you to store more data on a single virtual tape and reducing the number of tapes you need to manage. Additionally, this enhancement makes migrating long-term retention data stored on physical tapes to AWS easier by enabling you to copy data from Linear Tape-Open (LTO) generation 1 to generation 7 tapes to a virtual tape in AWS.\u003c/p\u003e\r\n\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/#supported_backup_software\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eTape Gateway supports all leading backup applications\u003c/a\u003e\u0026nbsp;and enables you to replace physical tapes on premises with virtual tapes in AWS without changing existing workflows. Tape Gateway caches data on premises for low-latency access, compresses and encrypts data in transit to AWS, and moves virtual tapes from Amazon S3 Standard to Amazon S3 Glacier Flexible Retrieval or Amazon S3 Glacier Deep Archive to help you minimize storage costs. \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Snowball with Tape Gateway\u003c/a\u003e\u0026nbsp;supports offline migration of data stored on physical tapes to AWS.\u003c/p\u003e\r\n\u003cp\u003eThe new capability is available on new gateways starting today, and will be made available on existing gateways through a software update starting October 13, 2022. For Tape Gateway pricing information, visit the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/pricing/#Tape_Gateway_pricing\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003epricing page\u003c/a\u003e. To get started, visit the AWS Storage Gateway \u003ca href\u003d\"https://signin.aws.amazon.com/signin?redirect_uri\u003dhttps%3A%2F%2Fus-west-1.console.aws.amazon.com%2Fstoragegateway%3Ffromtb%3Dtrue%26hashArgs%3D%2523%26isauthcode%3Dtrue%26region%3Dus-west-1%26state%3DhashArgsFromTB_us-west-1_d3333f7222e14a03\u0026amp;client_id\u003darn%3Aaws%3Asignin%3A%3A%3Aconsole%2Fstoragegateway\u0026amp;forceMobileApp\u003d0\u0026amp;code_challenge\u003dtnVGNfmN7thLXGYtVQacD-1tgTTs5qj6eboWP4WUq5A\u0026amp;code_challenge_method\u003dSHA-256\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003emanagement console\u003c/a\u003e. To learn more, visit the AWS Storage Gateway \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/tgw/WhatIsStorageGateway.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eUser Guide\u003c/a\u003e. \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/tgw/WhatIsStorageGateway.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003e\u003c/a\u003e\u003c/p\u003e\r\n","modifiedDate":"2022-10-06T21:40:21Z","headlineUrl":"/about-aws/whats-new/2022/10/aws-storage-gateway-15-tib-tapes/","postDateTime":"2022-10-06T07:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway now supports 15 TiB tapes","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e\u0026nbsp;increases the maximum supported virtual tape size on \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/vtl.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eTape Gateway\u003c/a\u003e\u0026nbsp;from 5 TiB to 15 TiB, enabling you to store more data on a single virtual tape and reducing the number of tapes you need to manage. Additionally, this enhancement makes migrating long-term retention data stored on physical tapes to AWS easier by enabling you to copy data from Linear Tape-Open (LTO) generation 1 to generation 7 tapes to a virtual tape in AWS.\u003c/p\u003e\r\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-06-aws-storage-gateway-hardware-appliance-purchase-resellers","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/06/aws-storage-gateway-hardware-appliance-purchase-resellers/","dateCreated":"2023-11-09T14:48:48+0000","dateUpdated":"2024-07-25T14:19:46+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e\u0026nbsp;is expanding the ways you can purchase the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/hardware-appliance/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway Hardware Appliance\u003c/a\u003e, and for the first-time enabling resellers to offer the appliance. Now you can procure the hardware appliance through the reseller of your choice, and leverage your existing purchasing agreements.\u003c/p\u003e\r\n\u003cp\u003eAWS Storage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited storage in the cloud. You can use AWS Storage Gateway for backing up and archiving data to AWS, providing on-premises file shares backed by cloud storage, and providing on-premises applications low latency access to data in the cloud. The AWS Storage Gateway Hardware Appliance provides you with a simple out-of-the-box experience to deploy storage gateway on-premises. The hardware appliance is a physical, standalone, validated server configuration that comes pre-loaded with Storage Gateway software, and provides all the required compute, memory, network, and storage resources for creating and configuring the gateway for on-premises hybrid cloud storage deployments, and is managed from the AWS Console. The hardware appliance supports Amazon S3 File Gateway, Amazon FSx File Gateway, Tape Gateway, and Volume Gateway.\u003c/p\u003e\r\n\u003cp\u003eAWS has partnered with \u003ca href\u003d\"https://partners.amazonaws.com/partners/001E000000Rl0yUIAR/Tech%20Data\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eTD Synnex\u003c/a\u003e, a global IT distributor, to offer the AWS Storage Gateway Hardware Appliance exclusively through resellers. To purchase the hardware appliance, contact your preferred reseller for availability, pricing, and purchasing information. The Storage Gateway Hardware Appliance is supported in \u003ca href\u003d\"https://docs.aws.amazon.com/general/latest/gr/sg.html#sg-hardware-appliance\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003e16 AWS Regions\u003c/a\u003e. To learn more, visit the AWS Storage Gateway Hardware Appliance \u003ca href\u003d\"https://aws.amazon.com/storagegateway/hardware-appliance/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eproduct page\u003c/a\u003e, or online \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/index.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003edocumentation\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2022-06-01T17:07:12Z","headlineUrl":"/about-aws/whats-new/2022/06/aws-storage-gateway-hardware-appliance-purchase-resellers/","postDateTime":"2022-06-01T07:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway Hardware Appliance now available for purchase through resellers","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e\u0026nbsp;is expanding the ways you can purchase the \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/hardware-appliance.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway Hardware Appliance\u003c/a\u003e, and for the first-time enabling resellers to offer the appliance. Now you can procure the hardware appliance through the reseller of your choice, and leverage your existing purchasing agreements.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"},{"id":"whats-new-v2#general-products#amazon-fsx-for-windows-file-server","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-fsx-for-windows-file-server","description":"general:products/amazon-fsx-for-windows-file-server","dateCreated":"2023-11-09T13:51:03+0000","dateUpdated":"2023-11-09T13:51:03+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-05-aws-backup-audit-manager-adds-amazon-s3-storage-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/05/aws-backup-audit-manager-adds-amazon-s3-storage-gateway/","dateCreated":"2023-11-09T14:40:14+0000","dateUpdated":"2024-07-25T14:40:17+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/backup/faqs/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Backup Audit Manager\u003c/a\u003e\u0026nbsp;now allows you to audit and report on the compliance of your data protection policies for \u003ca href\u003d\"https://aws.amazon.com/s3/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon S3\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e. Using AWS Backup Audit Manager, you can now continuously evaluate the backup activity of your Amazon S3 and AWS Storage Gateway resources and generate audit reports that can help you demonstrate compliance with organizational best practices or regulatory standards.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eAWS Backup Audit Manager provides automated alerting that you can now use to identify your Amazon S3 and AWS Storage Gateway resources that are not attached to a backup plan, audit whether your backups are immutable using \u003ca href\u003d\"https://docs.aws.amazon.com/aws-backup/latest/devguide/vault-lock.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Backup Vault Lock\u003c/a\u003e’s WORM (write-once, read-many) capabilities, and track whether your AWS Storage Gateway backups are protected by storing separable copies across AWS Regions and AWS accounts. You can use AWS Backup Audit Manager’s automated alerting to detect violations of your organizational data protection policies and take corrective actions to meet your business continuity and compliance needs.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eAWS Backup Audit Manager is available in the US East (Ohio, N. Virginia), US West (N. California, Oregon), Canada (Central), Europe (Frankfurt, Ireland, London, Paris, Stockholm), South America (Sao Paulo), Asia Pacific (Hong Kong, Mumbai, Seoul, Singapore, Sydney, Tokyo), and Middle East (Bahrain) Regions. To learn more about AWS Backup Audit Manager, visit the AWS Backup \u003ca href\u003d\"https://aws.amazon.com/backup/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eproduct page\u003c/a\u003e and \u003ca href\u003d\"https://docs.aws.amazon.com/aws-backup/latest/devguide/whatisbackup.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003edocumentation\u003c/a\u003e. To get started, visit the \u003ca href\u003d\"https://console.aws.amazon.com/backup\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Backup console\u003c/a\u003e.\u003cbr\u003e\r\n\u003c/p\u003e\r\n","modifiedDate":"2022-05-26T17:38:57Z","headlineUrl":"/about-aws/whats-new/2022/05/aws-backup-audit-manager-adds-amazon-s3-storage-gateway/","postDateTime":"2022-05-25T08:00:00Z","contentType":"Launch Announcement","headline":"AWS Backup Audit Manager adds support for Amazon S3 and AWS Storage Gateway","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/backup/faqs.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Backup Audit Manager\u003c/a\u003e\u0026nbsp;now allows you to audit and report on the compliance of your data protection policies for \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/s3.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon S3\u003c/a\u003e and \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e. Using AWS Backup Audit Manager, you can now continuously evaluate the backup activity of your Amazon S3 and AWS Storage Gateway resources and generate audit reports that can help you demonstrate compliance with organizational best practices or regulatory standards.\u003cbr\u003e\r\n\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-backup","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-backup","description":"general:products/aws-backup","dateCreated":"2023-11-09T13:50:45+0000","dateUpdated":"2023-11-09T13:50:45+0000"},{"id":"whats-new-v2#general-products#aws-audit-manager","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-audit-manager","description":"general:products/aws-audit-manager","dateCreated":"2023-11-08T18:02:35+0000","dateUpdated":"2023-11-08T18:02:35+0000"},{"id":"whats-new-v2#general-products#amazon-s3","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-s3","description":"general:products/amazon-s3","dateCreated":"2023-11-09T13:53:07+0000","dateUpdated":"2023-11-09T13:53:07+0000"},{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-03-aws-storage-gateway-vmware-microsoft-hypervisors","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/03/aws-storage-gateway-vmware-microsoft-hypervisors/","dateCreated":"2023-11-09T14:51:50+0000","dateUpdated":"2024-07-25T14:40:54+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e adds support for VMware ESXi 7.0 and Microsoft Hyper-V 2022 and 2019 hypervisors, enabling you to deploy your gateway virtual machines on the latest versions of these hypervisors. \u0026nbsp;\u003c/p\u003e\r\n\u003cp\u003eAWS Storage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited storage in the cloud. You can use AWS Storage Gateway for backing up and archiving data to AWS, providing on-premises file shares backed by cloud storage, and providing on-premises applications low latency access to data in the cloud.\u003c/p\u003e\r\n\u003cp\u003eThis capability is available starting today in all AWS Regions. Visit the AWS Storage Gateway \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/index.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003edocumentation pages\u003c/a\u003e to learn more, and access the AWS Storage Gateway \u003ca href\u003d\"https://signin.aws.amazon.com/signin?redirect_uri\u003dhttps%3A%2F%2Fus-west-1.console.aws.amazon.com%2Fstoragegateway%3Ffromtb%3Dtrue%26hashArgs%3D%2523%26isauthcode%3Dtrue%26region%3Dus-west-1%26state%3DhashArgsFromTB_us-west-1_d3333f7222e14a03\u0026amp;client_id\u003darn%3Aaws%3Asignin%3A%3A%3Aconsole%2Fstoragegateway\u0026amp;forceMobileApp\u003d0\u0026amp;code_challenge\u003dtnVGNfmN7thLXGYtVQacD-1tgTTs5qj6eboWP4WUq5A\u0026amp;code_challenge_method\u003dSHA-256\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003emanagement console\u003c/a\u003e to get started.\u003c/p\u003e\r\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\r\n","modifiedDate":"2022-03-31T22:54:02Z","headlineUrl":"/about-aws/whats-new/2022/03/aws-storage-gateway-vmware-microsoft-hypervisors/","postDateTime":"2022-03-31T07:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway updates support for VMware and Microsoft hypervisors","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e adds support for VMware ESXi 7.0 and Microsoft Hyper-V 2022 and 2019 hypervisors, enabling you to deploy your gateway virtual machines on the latest versions of these hypervisors. \u0026nbsp;\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-02-aws-storage-gateway-recover-files-amazon-fsx-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/02/aws-storage-gateway-recover-files-amazon-fsx-gateway/","dateCreated":"2023-11-09T14:50:45+0000","dateUpdated":"2024-07-25T14:55:52+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon FSx File Gateway\u003c/a\u003e\u0026nbsp;now enables your on-premises file share users to browse and restore previous versions of files that are stored on \u003ca href\u003d\"https://aws.amazon.com/fsx/windows/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon FSx for Windows File Server file systems\u003c/a\u003e\u0026nbsp;by the Windows Volume Shadow Copy Service (VSS). This capability enables quick and easy self-service recovery of files in case of a loss due to an accident or malware.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eFile share users often need to recover previous versions due to errors, accidental deletions, or malware attacks. Prior to this launch, Amazon FSx File Gateway users required an administrator to provide access to Shadow Copies (snapshots) of file systems, or to restore files from backups. With this new capability, Microsoft Windows users can simply click on the Previous Versions tab in their Windows File explorer, and restore individual files, or entire directories, without help from an IT administrator. This self-service approach increases productivity and reduces administrative workload. For users to get access to the previous file versions, administrators must make sure that periodic \u003ca href\u003d\"https://docs.aws.amazon.com/fsx/latest/WindowsGuide/shadow-copies-fsxW.html#shadow-cpy-config-ovrvw\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eVSS Shadow copies are configured on the file systems\u003c/a\u003e.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eAmazon FSx File Gateway provides bandwidth-efficient, low-latency cached access to Amazon FSx for Windows File Server file systems from on-premises environments. It enables administrators to take advantage of fully managed cloud file storage, by extending Amazon FSx for Windows File Server file systems into their on-premises environment. This eliminates the costly, time-consuming management of on-premises Windows File Servers, while users benefit from \u003ca href\u003d\"https://aws.amazon.com/fsx/windows/features/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eall of the features\u003c/a\u003e\u0026nbsp;of Windows file sharing.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eThis capability is now available on new gateways in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eall AWS regions\u003c/a\u003e. For existing gateways, this new capability will be made available during the next scheduled software update. Visit the documentation pages for \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/WhatIsStorageGateway.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e\u0026nbsp;and \u003ca href\u003d\"https://docs.aws.amazon.com/fsx/latest/WindowsGuide/what-is.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon FSx for Windows File Server\u003c/a\u003e\u0026nbsp;to learn more, and access the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway console\u003c/a\u003e\u0026nbsp;to get started.\u003cbr\u003e\r\n\u003c/p\u003e\r\n","modifiedDate":"2022-02-04T21:09:21Z","headlineUrl":"/about-aws/whats-new/2022/02/aws-storage-gateway-recover-files-amazon-fsx-gateway/","postDateTime":"2022-02-04T08:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway enables on-premises users to recover previous versions of files on Amazon FSx File Gateway","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/file.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon FSx File Gateway\u003c/a\u003e\u0026nbsp;now enables your on-premises file share users to browse and restore previous versions of files that are stored on \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/fsx/windows.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon FSx for Windows File Server file systems\u003c/a\u003e\u0026nbsp;by the Windows Volume Shadow Copy Service (VSS). This capability enables quick and easy self-service recovery of files in case of a loss due to an accident or malware.\u003cbr\u003e\r\n\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#general-products#amazon-fsx-for-windows-file-server","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-fsx-for-windows-file-server","description":"general:products/amazon-fsx-for-windows-file-server","dateCreated":"2023-11-09T13:51:03+0000","dateUpdated":"2023-11-09T13:51:03+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-01-amazon-s3-file-gateway-schedule-based-network-bandwidth-throttling","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/01/amazon-s3-file-gateway-schedule-based-network-bandwidth-throttling/","dateCreated":"2023-11-09T14:34:16+0000","dateUpdated":"2024-07-25T14:16:41+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/s3/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon S3 File Gateway\u003c/a\u003e now\u0026nbsp;supports schedule-based network bandwidth throttling, enabling you to optimize network use between your data center and Amazon S3 storage for data synchronization. Customers that share their internet or DirectConnect access with other on premises applications and users, can now schedule when and how much bandwidth S3 File Gateway uses.\u003c/p\u003e\r\n\u003cp\u003eWith this launch, you can throttle network bandwidth used by the gateway to synchronize on-premises data with AWS, based on a schedule you set on the gateway. This gives you the ability to optimally use your network connection to AWS, regulating bandwidth use during peak time to minimize network congestion and using all your available bandwidth during off-peak hours.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eAmazon S3 File Gateway enables your on-premises applications to seamlessly store files as objects in Amazon S3, and access them using industry standard file access protocols such as NFS and SMB. You can use Amazon S3 File Gateway for migrating on-premises file data to AWS while maintaining fast on-premises access to recently accessed data, backing up on-premises file data to AWS, and providing on-premises applications low latency access to data stored in Amazon S3.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eThis capability is now available on new gateways in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eall commercial regions\u003c/a\u003e. For existing gateways, this new capability will be made available during the next scheduled software update. Visit the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway product page\u003c/a\u003e to learn more and access the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway console\u003c/a\u003e to get started.\u003c/p\u003e\r\n","modifiedDate":"2022-02-24T16:03:14Z","headlineUrl":"/about-aws/whats-new/2022/01/amazon-s3-file-gateway-schedule-based-network-bandwidth-throttling/","postDateTime":"2022-01-25T08:00:00Z","contentType":"Launch Announcement","headline":"Amazon S3 File Gateway adds schedule-based network bandwidth throttling","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/file/s3.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon S3 File Gateway\u003c/a\u003e now\u0026nbsp;supports schedule-based network bandwidth throttling, enabling you to optimize network use between your data center and Amazon S3 storage for data synchronization. Customers that share their internet or DirectConnect access with other on premises applications and users, can now schedule when and how much bandwidth S3 File Gateway uses.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#marketing-marchitecture#migration","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"migration","description":"marketing:marchitecture/migration","dateCreated":"2023-11-08T19:09:35+0000","dateUpdated":"2023-11-08T19:09:35+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-01-aws-storage-gateway-management-console-creation","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/01/aws-storage-gateway-management-console-creation/","dateCreated":"2023-11-09T14:49:22+0000","dateUpdated":"2024-07-25T14:16:07+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e\u0026nbsp;now makes it simpler and faster for you to get started with setting up and managing your hybrid cloud storage workflow. Using the Storage Gateway management console, you can now quickly create a new gateway in four easy steps: First, complete your local gateway setup. Second, connect your gateway to AWS. Third, activate your gateway. Fourth, finalize your gateway configuration.\u003c/p\u003e\r\n\u003cp\u003eIn addition to a refreshed look and feel, you get enhanced wizard instructions and updated in-console help panel information, helping you to seamlessly navigate the gateway creation steps. Furthermore, once your gateway is created, you can now customize the layout of your Storage Gateway resources to fit your needs using the new\u0026nbsp;\u003cb\u003ePreferences\u003c/b\u003e\u0026nbsp;setting in the management console, where you can customize the displayed resource details and number of items.\u003c/p\u003e\r\n\u003cp\u003eStorage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited storage in the cloud. You can use Storage Gateway for backing up and archiving data to AWS, providing on-premises file shares backed by cloud storage, and providing on-premises applications low latency access to in-cloud data.\u003c/p\u003e\r\n\u003cp\u003eThis capability is available starting today in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eall AWS Regions\u003c/a\u003e. Visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/WhatIsStorageGateway.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eStorage Gateway User guide\u003c/a\u003e\u0026nbsp;to learn more, or log into the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eStorage Gateway console\u003c/a\u003e\u0026nbsp;to get started.\u003c/p\u003e\r\n","modifiedDate":"2022-01-18T22:10:59Z","headlineUrl":"/about-aws/whats-new/2022/01/aws-storage-gateway-management-console-creation/","postDateTime":"2022-01-18T08:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway management console simplifies gateway creation and management","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e\u0026nbsp;now makes it simpler and faster for you to get started with setting up and managing your hybrid cloud storage workflow. Using the Storage Gateway management console, you can now quickly create a new gateway in four easy steps: First, complete your local gateway setup. Second, connect your gateway to AWS. Third, activate your gateway. Fourth, finalize your gateway configuration.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-01-aws-storage-gateway-jakarta-region","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/01/aws-storage-gateway-jakarta-region/","dateCreated":"2023-11-09T14:50:34+0000","dateUpdated":"2024-07-25T14:18:54+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e is now available in the AWS Asia Pacific (Jakarta) Region. \u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eAWS Storage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited storage in the cloud. You can use AWS Storage Gateway for backing up and archiving data to AWS, providing on-premises file shares backed by cloud storage, and providing on-premises applications low latency access to data in the cloud.\u003c/p\u003e\r\n\u003cp\u003eAWS Storage Gateway is available in all commercial \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Regions\u003c/a\u003e, \u003ca href\u003d\"https://aws.amazon.com/govcloud-us/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS GovCloud (US) Regions\u003c/a\u003e, and the Amazon China (Beijing) Region, operated by Sinnet, and the Amazon China (Ningxia) Region, operated by NWCD. Visit the AWS Storage Gateway \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eproduct page\u003c/a\u003e to learn more. Access the AWS Storage Gateway \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003econsole\u003c/a\u003e to get started.\u003c/p\u003e\r\n","modifiedDate":"2022-01-13T20:32:00Z","headlineUrl":"/about-aws/whats-new/2022/01/aws-storage-gateway-jakarta-region/","postDateTime":"2022-01-13T08:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway is now available in the AWS Asia Pacific (Jakarta) Region","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e is now available in the AWS Asia Pacific (Jakarta) Region. \u003cbr\u003e\r\n\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#migration","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"migration","description":"marketing:marchitecture/migration","dateCreated":"2023-11-08T19:09:35+0000","dateUpdated":"2023-11-08T19:09:35+0000"},{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2022-01-aws-storage-gateway-dell-emc-networker-19-5-veeam-backup-replication-11a-tape-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2022/01/aws-storage-gateway-dell-emc-networker-19-5-veeam-backup-replication-11a-tape-gateway/","dateCreated":"2023-11-09T14:33:52+0000","dateUpdated":"2024-07-25T14:28:57+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e\u0026nbsp;now supports Dell EMC NetWorker 19.5 and Veeam Backup \u0026amp; Replication 11A on \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eTape Gateway\u003c/a\u003e, enabling you to backup and archive data from Dell EMC NetWorker and Veeam Backup \u0026amp; Replication to AWS without changing your backup workflows. With this announcement, Tape Gateway supports Dell EMC NetWorker 19.5 and Veeam Backup \u0026amp; Replication 11A running on Microsoft Windows Server 2019.\u003c/p\u003e\r\n\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/#supported_backup_software\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eTape Gateway supports all leading backup applications\u003c/a\u003e\u0026nbsp;and enables you to replace physical tapes on premises with virtual tapes in AWS without changing backup workflows. Tape Gateway caches data on premises for low latency access, compresses and encrypts data in transit to AWS, and stores archived virtual tapes in Amazon S3 Glacier Flexible Retrieval or Amazon S3 Glacier Deep Archive to help you minimize storage costs. \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Snowball with Tape Gateway\u003c/a\u003e supports offline migration of data stored on physical tapes to AWS.\u003c/p\u003e\r\n\u003cp\u003eThis capability is available starting today in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eall AWS Regions\u003c/a\u003e. For more information, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/GettingStartedTestGatewayVTL.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003etesting your gateway setup documentation\u003c/a\u003e, or see \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/create-gateway-vtl.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003estep-by-step instructions to get started in the AWS Storage Gateway user guide\u003c/a\u003e. Access the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eStorage Gateway console\u003c/a\u003e to get started.\u003c/p\u003e\r\n","modifiedDate":"2022-01-04T19:51:51Z","headlineUrl":"/about-aws/whats-new/2022/01/aws-storage-gateway-dell-emc-networker-19-5-veeam-backup-replication-11a-tape-gateway/","postDateTime":"2022-01-04T08:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway now supports Dell EMC NetWorker 19.5 and Veeam Backup \u0026 Replication 11A on Tape Gateway","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e\u0026nbsp;now supports Dell EMC NetWorker 19.5 and Veeam Backup \u0026amp; Replication 11A on \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/vtl.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eTape Gateway\u003c/a\u003e, enabling you to backup and archive data from Dell EMC NetWorker and Veeam Backup \u0026amp; Replication to AWS without changing your backup workflows. With this announcement, Tape Gateway supports Dell EMC NetWorker 19.5 and Veeam Backup \u0026amp; Replication 11A running on Microsoft Windows Server 2019.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#year#2022","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2022","description":"year#2022","dateCreated":"2023-11-09T14:33:49+0000","dateUpdated":"2023-11-09T14:33:49+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2021-12-amazon-s3-file-gateway-nfs-file-share-auditing","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2021/12/amazon-s3-file-gateway-nfs-file-share-auditing/","dateCreated":"2023-11-09T14:49:22+0000","dateUpdated":"2024-07-25T14:15:34+0000","additionalFields":{"modifiedDate":"2021-12-06T23:10:44Z","headlineUrl":"/about-aws/whats-new/2021/12/amazon-s3-file-gateway-nfs-file-share-auditing/","postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e now supports NFS file share auditing end-user access to files, folders, and file shares on Amazon S3 File Gateway.  Amazon S3 File Gateway provides on-premises applications with file-based, cached access to virtually unlimited cloud storage using SMB and NFS protocols.  This feature is intended for IT administrators and compliance managers who need audit logs about user access to files and folders for security and compliance requirements.\u0026nbsp;\u003c/p\u003e\r\n\u003cp\u003eWith this launch, NFS client operations for files and folders are logged to provide key operations for files and folders including create, delete, read, write, rename, and change of permissions.  You can publish logs to Amazon CloudWatch Logs or stream logs to Amazon Kinesis Data Firehose, enabling you to query, process, store, and archive logs and trigger actions.\u003c/p\u003e\r\n\u003cp\u003eThis capability is now available on new gateways in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eall commercial regions\u003c/a\u003e.  For existing gateways, this new capability will be made available during the next scheduled software update.  Visit the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway product page\u003c/a\u003e to learn more and access the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway console\u003c/a\u003e to get started. \u003c/p\u003e\r\n","postDateTime":"2021-12-06T08:00:00Z","contentType":"Launch Announcement","headline":"Amazon S3 File Gateway now supports NFS file share auditing"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2021","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2021","description":"year#2021","dateCreated":"2023-11-09T14:24:35+0000","dateUpdated":"2023-11-09T14:24:35+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2021-12-amazon-s3-file-gateway-force-closing-locked-files","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2021/12/amazon-s3-file-gateway-force-closing-locked-files/","dateCreated":"2023-11-09T14:49:34+0000","dateUpdated":"2024-07-25T14:53:34+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon S3 File Gateway\u003c/a\u003e now enables you to force-close locked files on SMB file shares on Amazon S3 File Gateway by providing access to local security groups.  Amazon S3 File Gateway provides on-premises applications with file-based, cached access to virtually unlimited cloud storage using SMB and NFS protocols.  End users and applications using files on SMB shares, may stop working on those files without closing them.  This leaves the files in an open, or locked, state.  Until now, gateway administrators did not have permissions to close these files.  \u003c/p\u003e\r\n\u003cp\u003eYou can now seamlessly assign force-closing permissions to users and groups from the connected Active Directory, by adding them to the GatewayAdmin local group using the AWS Storage Gateway console, API, or CLI.  The GatewayAdmin local group provides the permissions needed to force the closing of locked files on a given gateway.  Those added groups or individuals can then use the same windows tools they use today to unlock files on SMB file shares on the same gateway.\u003c/p\u003e\r\n\u003cp\u003eThis capability is now available on new gateways in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eall commercial regions\u003c/a\u003e.  For existing gateways, this new capability will be made available during the next scheduled software update.  Visit the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway product page\u003c/a\u003e to learn more and access the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway console\u003c/a\u003e to get started. \u003c/p\u003e\r\n","modifiedDate":"2021-12-06T23:01:44Z","headlineUrl":"/about-aws/whats-new/2021/12/amazon-s3-file-gateway-force-closing-locked-files/","postDateTime":"2021-12-06T08:00:00Z","contentType":"Launch Announcement","headline":"Amazon S3 File Gateway enables administrators to force the closing of locked files","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/file.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAmazon S3 File Gateway\u003c/a\u003e now enables you to force-close locked files on SMB file shares on Amazon S3 File Gateway by providing access to local security groups.  Amazon S3 File Gateway provides on-premises applications with file-based, cached access to virtually unlimited cloud storage using SMB and NFS protocols.  End users and applications using files on SMB shares, may stop working on those files without closing them.  This leaves the files in an open, or locked, state.  Until now, gateway administrators did not have permissions to close these files.  \u003c/p\u003e\r\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2021","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2021","description":"year#2021","dateCreated":"2023-11-09T14:24:35+0000","dateUpdated":"2023-11-09T14:24:35+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2021-11-aws-snow-family-offline-tape-data-migration-capability","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2021/11/aws-snow-family-offline-tape-data-migration-capability/","dateCreated":"2023-11-09T14:46:02+0000","dateUpdated":"2024-07-25T14:25:18+0000","additionalFields":{"postBody":"\u003cp\u003eToday, \u003ca href\u003d\"https://aws.amazon.com/snow/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Snow Family\u003c/a\u003e launches\u0026nbsp;a secure, offline tape data migration capability for AWS Snowball Edge, enabling you to migrate petabytes of data stored on physical tapes to AWS without changing your existing tape-based backup workflows. Using this capability, you can migrate tape data to AWS from environments, where you have network connectivity limitations, bandwidth constraints, and high network connection costs. Moving tape data to AWS helps you eliminate physical tape infrastructure expenses and gain online access to your tape data.\u003c/p\u003e\r\n\u003cp\u003eThe Snow Family tape data migration capability uses \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eTape Gateway’s\u003c/a\u003e Virtual Tape Library (VTL) capabilities on Snowball Edge Storage Optimized to deliver you a simple, integrated experience for tape data migration.\u0026nbsp;From Snow device ordering, setup and use at your site, to ingesting, storing, and accessing tape data in AWS is easier. AWS partners can use the Snowball Edge in their facilities, or at their customers’ sites to copy data from physical tapes to a VTL, without needing to restore tape data to its original form. Once your tape data is stored in AWS, you can restrict data access and enforce retention policies as you do with offsite storage of physical tapes. You can access your tape data stored in AWS through a Tape Gateway running in AWS or in your data center over the network.\u003c/p\u003e\r\n\u003cp\u003eYou can complete your tape data migration using Snowball Edge in three simple steps. First, order Snowball Edge from the AWS Snow Family management console. After you receive and setup the Snowball Edge device, you unlock it, and activate Tape Gateway. You can use Tape Gateway on Snowball Edge in place of a physical tape library without any changes to your current tape-based workflows. Second, you create virtual tapes on Tape Gateway and copy data from physical tapes to virtual tapes on Snowball Edge using your existing backup application. Third, after completing the data copy, you use the integrated logistics built into Snowball Edge to ship the device to the correct AWS location. AWS imports your data stored on Snowball Edge to Amazon S3 Glacier Flexible Retrieval or Amazon S3 Glacier Deep Archive based on the storage destination you selected when creating virtual tapes. You can view and manage your virtual tapes stored in AWS from the AWS Storage Gateway management console.\u003c/p\u003e\r\n\u003cp\u003eThe Snowball Edge tape data migration capability is available in US East (N. Virginia), US East (Ohio), US West (Oregon), US West (N. California), Europe (Ireland), Europe (Frankfurt), Europe (London), and Asia Pacific (Sydney) Regions. To learn more, visit the \u003ca href\u003d\"https://aws.amazon.com/snowball/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eproduct page\u003c/a\u003e, \u003ca href\u003d\"https://docs.aws.amazon.com/snowball/latest/developer-guide/using-snowball-tape-gateway.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003edocumentation\u003c/a\u003e, and \u003ca href\u003d\"https://aws.amazon.com/blogs/aws/new-offline-tape-migration-using-aws-snowball-edge/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS News launch blog\u003c/a\u003e. To get started, visit the \u003ca href\u003d\"https://console.aws.amazon.com/snowfamily\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Snow Family console\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2021-12-01T01:42:19Z","headlineUrl":"/about-aws/whats-new/2021/11/aws-snow-family-offline-tape-data-migration-capability/","postDateTime":"2021-11-30T08:00:00Z","contentType":"Launch Announcement","headline":"AWS Snow Family launches offline tape data migration capability","postSummary":"\u003cp\u003eToday, \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/snow.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Snow Family\u003c/a\u003e launches\u0026nbsp;a secure, offline tape data migration capability for AWS Snowball Edge, enabling you to migrate petabytes of data stored on physical tapes to AWS without changing your existing tape-based backup workflows. Using this capability, you can migrate tape data to AWS from environments, where you have network connectivity limitations, bandwidth constraints, and high network connection costs. Moving tape data to AWS helps you eliminate physical tape infrastructure expenses and gain online access to your tape data.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#migration","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"migration","description":"marketing:marchitecture/migration","dateCreated":"2023-11-08T19:09:35+0000","dateUpdated":"2023-11-08T19:09:35+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-snowball","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-snowball","description":"general:products/aws-snowball","dateCreated":"2023-11-09T13:57:05+0000","dateUpdated":"2023-11-09T13:57:05+0000"},{"id":"whats-new-v2#year#2021","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2021","description":"year#2021","dateCreated":"2023-11-09T14:24:35+0000","dateUpdated":"2023-11-09T14:24:35+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2021-09-aws-storage-gateway-tape-management-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2021/09/aws-storage-gateway-tape-management-gateway/","dateCreated":"2023-11-09T14:36:13+0000","dateUpdated":"2024-07-25T14:33:20+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e\u0026nbsp;now makes it easier and faster for you to search, view, and manage your virtual tapes stored in AWS using Tape Gateway. From the \u003cb\u003eTapes\u003c/b\u003e page in the Storage Gateway management console, you can now quickly search for tapes using common filters such as tape barcode and status. You simply select the desired filter from the drop-down menu and quickly narrow down your search to the relevant set of tapes, saving you time and management overhead. For example, to delete archived tapes exceeding your defined retention period, you can use the \u003cb\u003eArchived\u0026nbsp;\u003c/b\u003efilter, select the desired date range, and delete all tapes that match your specified filter in just a few clicks.\u003c/p\u003e\r\n\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/#supported_backup_software\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eTape Gateway supports all leading backup applications\u003c/a\u003e\u0026nbsp;and enables you to replace physical tapes on premises with virtual tapes in AWS without changing backup workflows. Tape Gateway caches data on premises for low latency access, compresses and encrypts data in transit to AWS, and transitions virtual tapes to Amazon S3 Glacier or Amazon S3 Glacier Deep Archive to help you minimize storage costs.\u003c/p\u003e\r\n\u003cp\u003eThis capability is available starting today in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eall AWS Regions\u003c/a\u003e. Visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/WhatIsStorageGateway.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eStorage Gateway User guide\u003c/a\u003e\u0026nbsp;to learn more, or log into the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eStorage Gateway console\u003c/a\u003e\u0026nbsp;to get started.\u003c/p\u003e\r\n","modifiedDate":"2021-09-24T20:09:50Z","headlineUrl":"/about-aws/whats-new/2021/09/aws-storage-gateway-tape-management-gateway/","postDateTime":"2021-09-24T07:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway simplifies tape management for Tape Gateway","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\" rel\u003d\"noopener\"\u003eAWS Storage Gateway\u003c/a\u003e\u0026nbsp;now makes it easier and faster for you to search, view, and manage your virtual tapes stored in AWS using Tape Gateway. From the \u003cb\u003eTapes\u003c/b\u003e page in the Storage Gateway management console, you can now quickly search for tapes using common filters such as tape barcode and status. You simply select the desired filter from the drop-down menu and quickly narrow down your search to the relevant set of tapes, saving you time and management overhead. For example, to delete archived tapes exceeding your defined retention period, you can use the \u003cb\u003eArchived\u0026nbsp;\u003c/b\u003efilter, select the desired date range, and delete all tapes that match your specified filter in just a few clicks.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2021","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2021","description":"year#2021","dateCreated":"2023-11-09T14:24:35+0000","dateUpdated":"2023-11-09T14:24:35+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2021-08-aws-storage-gateway-supports-quest-netvault-backup-13-tape-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2021/08/aws-storage-gateway-supports-quest-netvault-backup-13-tape-gateway/","dateCreated":"2023-11-09T14:35:15+0000","dateUpdated":"2024-07-25T14:14:24+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e now supports Quest NetVault Backup 13 on \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\" target\u003d\"_blank\"\u003eTape Gateway\u003c/a\u003e, enabling you to backup and archive data from Quest NetVault Backup to AWS without changing your backup workflows. With this announcement, Tape Gateway supports Quest NetVault Backup 13 running on Microsoft Windows Server 2012 R2 or Microsoft Windows Server 2016.\u003c/p\u003e\r\n\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/#supported_backup_software\" target\u003d\"_blank\"\u003eTape Gateway supports all leading backup applications\u003c/a\u003e and enables you to replace using physical tapes on premises with virtual tapes in AWS without changing backup workflows. Tape Gateway caches data on premises for low latency access, compresses and encrypts data in transit to AWS, and transitions virtual tapes to Amazon S3 Glacier or Amazon S3 Glacier Deep Archive to help you minimize storage costs.\u003c/p\u003e\r\n\u003cp\u003eThis capability is available starting today in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eall AWS Regions\u003c/a\u003e. For more information, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/backup-netvault.html\" target\u003d\"_blank\"\u003etesting your gateway setup documentation\u003c/a\u003e, or see \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/create-gateway-vtl.html\" target\u003d\"_blank\"\u003estep-by-step instructions to get started in the AWS Storage Gateway user guide\u003c/a\u003e. Access the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eStorage Gateway console\u003c/a\u003e\u0026nbsp;to get started.\u003cbr\u003e\r\n\u003c/p\u003e\r\n","modifiedDate":"2021-08-02T16:53:53Z","headlineUrl":"/about-aws/whats-new/2021/08/aws-storage-gateway-supports-quest-netvault-backup-13-tape-gateway/","postDateTime":"2021-08-02T16:20:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway now supports Quest NetVault Backup 13 on Tape Gateway ","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e now supports Quest NetVault Backup 13 on \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/vtl.html\" target\u003d\"_blank\"\u003eTape Gateway\u003c/a\u003e, enabling you to backup and archive data from Quest NetVault Backup to AWS without changing your backup workflows. With this announcement, Tape Gateway supports Quest NetVault Backup 13 running on Microsoft Windows Server 2012 R2 or Microsoft Windows Server 2016.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2021","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2021","description":"year#2021","dateCreated":"2023-11-09T14:24:35+0000","dateUpdated":"2023-11-09T14:24:35+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2021-07-aws-storage-gateway-adds-supports-aws-privatelink-amazon-s3-amazon-s3-access-points","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2021/07/aws-storage-gateway-adds-supports-aws-privatelink-amazon-s3-amazon-s3-access-points/","dateCreated":"2023-11-09T14:45:50+0000","dateUpdated":"2024-07-25T14:09:42+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e adds\u0026nbsp;support for AWS Privatelink for Amazon S3 and Amazon S3 Access Points.\u0026nbsp; If you use Amazon S3 File Gateway for your on-premises gateway (VMware, Microsoft Hyper V, Linux Kernel-based Virtual Machine (KVM) or AWS Storage Gateway Hardware Appliance), you can now create a private connection from your gateway directly to Amazon S3 without the need for an HTTP proxy.\u003c/p\u003e\r\n\u003cp\u003eYou can also now use Amazon S3 Access Points instead of bucket names to map file shares, enabling more access controls for applications connecting to AWS Storage Gateway file shares. You can easily add hundreds of access points without needing to worry about managing access through a single bucket policy that spans hundreds of use cases. Using S3 Access Points in your file shares, you can create file shares to shared data sets with policies tailored to the specific application.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eAWS Storage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited storage in the cloud. You can use AWS Storage Gateway for backing up and archiving data to AWS, providing on-premises file shares backed by cloud storage, and providing on-premises applications with low latency access to data in the cloud.\u0026nbsp;\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eThese capabilities are available on new gateways starting today in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eevery Region where AWS Storage Gateway is available\u003c/a\u003e.  Visit the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway product page\u003c/a\u003e to learn more. Access the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway console\u003c/a\u003e to get started. \u003c/p\u003e\r\n","modifiedDate":"2021-07-08T16:06:46Z","headlineUrl":"/about-aws/whats-new/2021/07/aws-storage-gateway-adds-supports-aws-privatelink-amazon-s3-amazon-s3-access-points/","postDateTime":"2021-07-08T07:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway adds support for AWS Privatelink for Amazon S3 and Amazon S3 Access Points","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e adds\u0026nbsp;support for AWS Privatelink for Amazon S3 and Amazon S3 Access Points.\u0026nbsp; If you use Amazon S3 File Gateway for your on-premises gateway (VMware, Microsoft Hyper V, Linux Kernel-based Virtual Machine (KVM) or AWS Storage Gateway Hardware Appliance), you can now create a private connection from your gateway directly to Amazon S3 without the need for an HTTP proxy.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#year#2021","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2021","description":"year#2021","dateCreated":"2023-11-09T14:24:35+0000","dateUpdated":"2023-11-09T14:24:35+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#migration","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"migration","description":"marketing:marchitecture/migration","dateCreated":"2023-11-08T19:09:35+0000","dateUpdated":"2023-11-08T19:09:35+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2021-06-aws-storage-gateway-is-now-available-in-the-aws-asia-pacific-osaka-region","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2021/06/aws-storage-gateway-is-now-available-in-the-aws-asia-pacific-osaka-region/","dateCreated":"2023-11-09T14:29:28+0000","dateUpdated":"2024-07-25T14:05:59+0000","additionalFields":{"postBody":"\u003cp\u003eAWS Storage Gateway is now available in the AWS Asia Pacific (Osaka) Region.\u003c/p\u003e\r\n\u003cp\u003eStorage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited storage in the cloud. You can use Storage Gateway for backing up and archiving data to AWS, providing on-premises file shares backed by cloud storage, and providing on-premises applications low latency access to in-cloud data. \u003c/p\u003e\r\n\u003cp\u003eStorage Gateway is available in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eall AWS launched regions worldwide\u003c/a\u003e. Visit the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway product page\u003c/a\u003e to learn more. Access the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway console\u003c/a\u003e to get started.\u003c/p\u003e\r\n","modifiedDate":"2021-06-30T21:37:25Z","headlineUrl":"/about-aws/whats-new/2021/06/aws-storage-gateway-is-now-available-in-the-aws-asia-pacific-osaka-region/","postDateTime":"2021-06-30T11:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway is now available in the AWS Asia Pacific (Osaka) Region","postSummary":"\u003cp\u003eAWS Storage Gateway is now available in the AWS Asia Pacific (Osaka) Region.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#migration","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"migration","description":"marketing:marchitecture/migration","dateCreated":"2023-11-08T19:09:35+0000","dateUpdated":"2023-11-08T19:09:35+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2021","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2021","description":"year#2021","dateCreated":"2023-11-09T14:24:35+0000","dateUpdated":"2023-11-09T14:24:35+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2021-04-amazon-fsx-file-gateway-delivers-faster-more-efficient-on-premises-access","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2021/04/amazon-fsx-file-gateway-delivers-faster-more-efficient-on-premises-access/","dateCreated":"2023-11-09T14:26:03+0000","dateUpdated":"2024-07-25T14:07:15+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e adds a new gateway type, Amazon FSx File Gateway, providing low-latency on-premises access to fully managed file shares in the cloud. Customers that want to take advantage of fully managed cloud file storage, but require low latency for their users and applications, can now easily extend \u003ca href\u003d\"https://aws.amazon.com/fsx/windows/\" target\u003d\"_blank\"\u003eAmazon FSx for Windows File Server\u003c/a\u003e into their existing on-premises environment. \u003c/p\u003e\r\n\u003cp\u003eMany on-premises desktop applications and workloads are latency-sensitive, which can lead to slower performance when directly accessing files from remote locations. Amazon FSx File Gateway optimizes your on-premises access by maintaining a local cache of frequently accessed data. This capability enables faster performance and reduced data transfer cost for file-based workloads such as user shares, documents, and content management.\u003c/p\u003e\r\n\u003cp\u003eTo get started, launch the Amazon FSx File Gateway as a virtual machine with a few clicks in the AWS Storage Gateway Management Console, or you can order an AWS Storage Gateway hardware appliance and deploy in your on-premises environment.  Amazon FSx File Gateway is available in all commercial \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eAWS Regions\u003c/a\u003e where Amazon FSx is available including \u003ca href\u003d\"https://aws.amazon.com/govcloud-us/\" target\u003d\"_blank\"\u003eAWS GovCloud (US) Regions\u003c/a\u003e, and the Amazon China (Beijing) Region, operated by Sinnet, and the Amazon China (Ningxia) Region, operated by NWCD. \u003c/p\u003e\r\n\u003cp\u003eTo learn more, visit the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/fsx/\" target\u003d\"_blank\"\u003efeature page\u003c/a\u003e, read the \u003ca href\u003d\"https://aws.amazon.com/blogs/aws/get-started-using-amazon-fsx-file-gateway-for-fast-cached-access-to-file-server-data-in-the-cloud/\" target\u003d\"_blank\"\u003eblog post\u003c/a\u003e, and visit the \u003ca href\u003d\"https://docs.aws.amazon.com/filegateway/latest/filefsxw/what-is-file-fsxw.html\" target\u003d\"_blank\"\u003edocumentation\u003c/a\u003e.\u003c/p\u003e\r\n","modifiedDate":"2021-04-27T22:32:15Z","headlineUrl":"/about-aws/whats-new/2021/04/amazon-fsx-file-gateway-delivers-faster-more-efficient-on-premises-access/","postDateTime":"2021-04-27T22:36:00Z","contentType":"Launch Announcement","headline":"Amazon FSx File Gateway delivers faster and more efficient on-premises access to fully managed file storage in the cloud","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e adds a new gateway type, Amazon FSx File Gateway, providing low-latency on-premises access to fully managed file shares in the cloud. Customers that want to take advantage of fully managed cloud file storage, but require low latency for their users and applications, can now easily extend \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/fsx/windows.html\" target\u003d\"_blank\"\u003eAmazon FSx for Windows File Server\u003c/a\u003e into their existing on-premises environment. \u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#general-products#amazon-fsx-for-windows-file-server","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-fsx-for-windows-file-server","description":"general:products/amazon-fsx-for-windows-file-server","dateCreated":"2023-11-09T13:51:03+0000","dateUpdated":"2023-11-09T13:51:03+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#year#2021","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2021","description":"year#2021","dateCreated":"2023-11-09T14:24:35+0000","dateUpdated":"2023-11-09T14:24:35+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#amazon-fsx-for-lustre","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-fsx-for-lustre","description":"general:products/amazon-fsx-for-lustre","dateCreated":"2023-11-09T13:51:18+0000","dateUpdated":"2023-11-09T13:51:18+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2021-04-aws-storage-gateway-achieves-fedramp-moderate-compliance","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2021/04/aws-storage-gateway-achieves-fedramp-moderate-compliance/","dateCreated":"2023-11-09T14:26:21+0000","dateUpdated":"2024-07-25T14:25:27+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e\u0026nbsp;has achieved Federal Risk and Authorization Management Program (FedRAMP) Moderate authorization, approved by the FedRAMP Joint Authorization Board (JAB), for the AWS US East (N. Virginia), US East (Ohio), US West (N. California), US West (Oregon) Regions. You can use AWS Storage Gateway to store and manage your critical data in AWS with up to the Moderate impact level.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eUS Federal agencies and commercial customers working with the US Federal government that operate under FedRAMP compliance programs can use AWS Storage Gateway to store their controlled unclassified information.\u003cbr\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eStorage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited storage in the cloud. You can use Storage Gateway for backing up and archiving data to AWS, providing on-premises file shares backed by cloud storage, and providing on-premises applications low latency access to in-cloud data. \u003cbr /\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eFor more information about FedRAMP compliance for AWS Storage Gateway, visit the \u003ca href\u003d\"https://aws.amazon.com/compliance/services-in-scope/\" target\u003d\"_blank\"\u003eFedRAMP compliance page\u003c/a\u003e. Storage Gateway is FedRAMP Moderate compliant in all US commercial Regions, and is FedRAMP High compliant in all US GovCloud Regions. Visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/WhatIsStorageGateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway user guide\u003c/a\u003e to learn more. Access the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eStorage Gateway console\u003c/a\u003e to get started. \u003cbr /\u003e\r\n\u003c/p\u003e\r\n","modifiedDate":"2021-04-14T21:13:18Z","headlineUrl":"/about-aws/whats-new/2021/04/aws-storage-gateway-achieves-fedramp-moderate-compliance/","postDateTime":"2021-04-14T19:24:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway achieves FedRAMP Moderate compliance","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e\u0026nbsp;has achieved Federal Risk and Authorization Management Program (FedRAMP) Moderate authorization, approved by the FedRAMP Joint Authorization Board (JAB), for the AWS US East (N. Virginia), US East (Ohio), US West (N. California), US West (Oregon) Regions. You can use AWS Storage Gateway to store and manage your critical data in AWS with up to the Moderate impact level.\u003cbr\u003e\r\n\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#year#2021","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2021","description":"year#2021","dateCreated":"2023-11-09T14:24:35+0000","dateUpdated":"2023-11-09T14:24:35+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2021-03-new-aws-storage-gateway-management-console-simplifies-gateway-creation-management","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2021/03/new-aws-storage-gateway-management-console-simplifies-gateway-creation-management/","dateCreated":"2023-11-09T14:44:11+0000","dateUpdated":"2024-07-25T14:05:11+0000","additionalFields":{"postBody":"\u003cp\u003eThe new \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway\" target\u003d\"_blank\"\u003eAWS Storage Gateway management console\u003c/a\u003e makes it easier for you to create, manage, and monitor resources such as file shares, tapes, and volumes. In addition to a refreshed look and feel, you can now connect your gateway with a simple activation key to help speed up deployment, and create new file shares using a streamlined process. You can easily configure your gateway to use Amazon Virtual Private Cloud (VPC) endpoints and leverage enhanced troubleshooting information for the endpoint configuration. Throughout the console, contextual information about your Storage Gateway resources is provided as part of the help panel, allowing you to easily find answers to common questions and browse related User guide content.\u003c/p\u003e\r\n\u003cp\u003eStorage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited storage in the cloud. You can use Storage Gateway for backing up and archiving data to AWS, providing on-premises file shares backed by cloud storage, and providing on-premises applications low latency access to in-cloud data.\u003c/p\u003e\r\n\u003cp\u003eThe new management console is available in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eevery AWS Region where Storage Gateway is available\u003c/a\u003e. Visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/WhatIsStorageGateway.html\" target\u003d\"_blank\"\u003eStorage Gateway User guide\u003c/a\u003e to learn more, or log into the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway\" target\u003d\"_blank\"\u003eStorage Gateway console\u003c/a\u003e and use the ‘New experience’ toggle to get started.\u003c/p\u003e\r\n","modifiedDate":"2021-03-31T21:51:38Z","headlineUrl":"/about-aws/whats-new/2021/03/new-aws-storage-gateway-management-console-simplifies-gateway-creation-management/","postDateTime":"2021-03-31T18:30:00Z","contentType":"Launch Announcement","headline":"New AWS Storage Gateway management console simplifies gateway creation and management","postSummary":"\u003cp\u003eThe new \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway\" target\u003d\"_blank\"\u003eAWS Storage Gateway management console\u003c/a\u003e makes it easier for you to create, manage, and monitor resources such as file shares, tapes, and volumes. In addition to a refreshed look and feel, you can now connect your gateway with a simple activation key to help speed up deployment, and create new file shares using a streamlined process. You can easily configure your gateway to use Amazon Virtual Private Cloud (VPC) endpoints and leverage enhanced troubleshooting information for the endpoint configuration. Throughout the console, contextual information about your Storage Gateway resources is provided as part of the help panel, allowing you to easily find answers to common questions and browse related User guide content.\u003c/p\u003e\r\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2021","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2021","description":"year#2021","dateCreated":"2023-11-09T14:24:35+0000","dateUpdated":"2023-11-09T14:24:35+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-11-aws-storage-gateway-now-supports-ibm-spectrum-protect-8-1-10-on-tape-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/11/aws-storage-gateway-now-supports-ibm-spectrum-protect-8-1-10-on-tape-gateway-/","dateCreated":"2023-11-09T13:57:58+0000","dateUpdated":"2024-07-25T13:31:04+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e now supports IBM Spectrum Protect 8.1.10 on \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\" target\u003d\"_blank\"\u003eTape Gateway\u003c/a\u003e, enabling you to backup and archive data from IBM Spectrum Protect to AWS without changing your backup workflows. With this announcement, Tape Gateway supports IBM Spectrum Protect 8.1.10 running on Red Hat Enterprise Linux (RHEL) version 7.6 or later, or SUSE Linux Enterprise Server (SLES) version 12, Service Pack 2 or later, and Microsoft Windows Server 2012 R2 or Microsoft Windows Server 2016.\u003c/p\u003e\n\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/#supported_backup_software\" target\u003d\"_blank\"\u003eTape Gateway supports all leading backup applications\u003c/a\u003e and enables you to replace using physical tapes on premises with virtual tapes in AWS without changing backup workflows. Tape Gateway caches data on premises for low latency access, compresses and encrypts data in transit to AWS, and transitions virtual tapes to Amazon S3 Glacier or Amazon S3 Glacier Deep Archive to minimize storage costs.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThis capability is available starting today in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eevery AWS Region where AWS Storage Gateway is available\u003c/a\u003e. For more information, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/backup-tsm.html\" target\u003d\"_blank\"\u003etesting your gateway setup documentation\u003c/a\u003e, or see \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/create-gateway-vtl.html\" target\u003d\"_blank\"\u003estep-by-step instructions to get started in the AWS Storage Gateway user guide.\u003c/a\u003e Access the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eStorage Gateway console\u003c/a\u003e to get started.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-11-24T20:41:42Z","headlineUrl":"/about-aws/whats-new/2020/11/aws-storage-gateway-now-supports-ibm-spectrum-protect-8-1-10-on-tape-gateway-/","postDateTime":"2020-11-24T12:45:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway now supports IBM Spectrum Protect 8.1.10 on Tape Gateway","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e now supports IBM Spectrum Protect 8.1.10 on \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\" target\u003d\"_blank\"\u003eTape Gateway\u003c/a\u003e, enabling you to backup and archive data from IBM Spectrum Protect to AWS without changing your backup workflows. With this announcement, Tape Gateway supports IBM Spectrum Protect 8.1.10 running on Red Hat Enterprise Linux (RHEL) version 7.6 or later, or SUSE Linux Enterprise Server (SLES) version 12, Service Pack 2 or later, and Microsoft Windows Server 2012 R2 or Microsoft Windows Server 2016.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#migration","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"migration","description":"marketing:marchitecture/migration","dateCreated":"2023-11-08T19:09:35+0000","dateUpdated":"2023-11-08T19:09:35+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-11-aws-storage-gateway-achieves-fedramp-compliance","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/11/aws-storage-gateway-achieves-fedramp-compliance/","dateCreated":"2023-11-09T14:09:01+0000","dateUpdated":"2024-07-25T13:23:50+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e\u0026nbsp;has achieved Federal Risk and Authorization Management Program (FedRAMP) High authorization, approved by the FedRAMP Joint Authorization Board (JAB), for the AWS GovCloud (US) Regions. FedRAMP compliance enables you to use AWS Storage Gateway to store and manage your critical workloads in the AWS GovCloud (US) Region’s authorization boundary with data up to the high impact level. \u003c/p\u003e\n\u003cp\u003eUS Federal agencies and commercial customers working with the US Federal government can now deploy AWS Storage Gateway in the AWS GovCloud (US) Region, providing you with an authorized solution which meets your FedRAMP compliance requirements.\u0026nbsp;High impact level security controls provide you with an environment to store your most sensitive, unclassified data.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eStorage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited cloud storage using NFS, SMB, iSCSI, and iSCSI-VTL interfaces through file, tape, and volume gateways. You can use the service for backing up and archiving data to AWS, providing on-premises file shares backed by cloud storage, and providing on-premises applications low latency access to in-cloud data.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eFor more information about FedRAMP compliance for AWS Storage Gateway, visit the \u003ca href\u003d\"https://aws.amazon.com/compliance/fedramp/\" target\u003d\"_blank\"\u003eFedRAMP compliance page\u003c/a\u003e. Storage Gateway is FedRAMP High compliant in GovCloud (US-West) and GovCloud (US-East) Regions. Visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/SERVICENAME-compliance.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u0026nbsp;user guide\u003c/a\u003e to learn more. Access the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eStorage Gateway console\u003c/a\u003e to get started. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-11-24T20:20:13Z","headlineUrl":"/about-aws/whats-new/2020/11/aws-storage-gateway-achieves-fedramp-compliance/","postDateTime":"2020-11-24T00:30:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway achieves FedRAMP compliance","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e\u0026nbsp;has achieved Federal Risk and Authorization Management Program (FedRAMP) High authorization, approved by the FedRAMP Joint Authorization Board (JAB), for the AWS GovCloud (US) Regions. FedRAMP compliance enables you to use AWS Storage Gateway to store and manage your critical workloads in the AWS GovCloud (US) Region’s authorization boundary with data up to the high impact level. \u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#marketing#migration-to-aws","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing","name":"migration-to-aws","description":"marketing:migration-to-aws","dateCreated":"2023-11-09T13:55:33+0000","dateUpdated":"2023-11-09T13:55:33+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-11-aws-backup-enables-aws-organizations-bring-cross-account-backup-feature","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/11/aws-backup-enables-aws-organizations-bring-cross-account-backup-feature/","dateCreated":"2023-11-09T13:57:41+0000","dateUpdated":"2024-07-25T13:08:41+0000","additionalFields":{"postBody":"\u003cp\u003eAWS Backup now supports cross-account backup, enabling AWS customers to securely copy backups across accounts within their AWS Organizations.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eCustomers can copy backups from the backup vault of the source account to the backup vaults of destination accounts, either on-demand or as part of a scheduled backup plan. These copies provide customers an additional layer of protection should the source account experience disruption from accidental or malicious deletion, disaster, or ransomware. Customers no longer need to manage multiple custom scripts or expensive third-party solutions. Customers can easily restore from the destination account or, alternatively, from a third account.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eMoreover, AWS Backup empowers customers to leverage cross-account backup and the previously launched cross-region backup simultaneously, copying backups to a different account in a different region enabling customers to meet their security, compliance, and business continuity requirements.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eCross-account backup leverages AWS Organizations to define the source and destination accounts. Customers may use their AWS Organizations management account to designate certain accounts as destination accounts. This helps customers ensure that backups are copied only to trusted accounts in the organization, and adds yet another layer of protection from unauthorized public exposure.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eCross-account backup continues AWS Backup\u0027s mission of helping customers further automate their data protection mechanisms.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003e\u003cb\u003eNote:\u003c/b\u003e \u003ci\u003eCross-account backup is currently not supported for Amazon DynamoDB tables or Amazon FSx file systems.\u003c/i\u003e\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/backup/\" target\u003d\"_blank\"\u003eAWS Backup\u003c/a\u003e is the centralized data protection offering from Amazon Web Services. It offers a cost-effective, fully-managed, and policy-based service that enables customers to protect their data. AWS Backup can also help customers support their regulatory compliance obligations and meet business continuity goals. With AWS Backup, you can centrally deploy data protection (backup) policies to configure, manage, and govern your backup activity across your AWS resources, including Amazon EBS volumes, Amazon Relational Database Service (RDS) databases (including Aurora clusters), Amazon DynamoDB tables, Amazon Elastic File System (EFS), Amazon EC2 instances, AWS Storage Gateway volumes, Amazon FSx for Lustre, and Amazon FSx for Windows File Server. \u003ca href\u003d\"https://aws.amazon.com/organizations/\" target\u003d\"_blank\"\u003eAWS Organizations\u003c/a\u003e helps you centrally manage, govern, and audit your environment as you grow and scale your AWS resources.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eFor more information on where AWS Backup is available, see the \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eAWS Regional Services List\u003c/a\u003e. To learn more about AWS Backup, please see our \u003ca href\u003d\"https://aws.amazon.com/backup/\" target\u003d\"_blank\"\u003eproduct page\u003c/a\u003e and \u003ca href\u003d\"https://docs.aws.amazon.com/aws-backup/\" target\u003d\"_blank\"\u003edocumentation\u003c/a\u003e.\u003cbr\u003e\n\u003c/p\u003e\n","modifiedDate":"2020-11-19T21:57:40Z","headlineUrl":"/about-aws/whats-new/2020/11/aws-backup-enables-aws-organizations-bring-cross-account-backup-feature/","postDateTime":"2020-11-19T12:47:00Z","contentType":"Launch Announcement","headline":"AWS Backup and AWS Organizations bring cross-account backup feature","postSummary":"\u003cp\u003eAWS Backup now supports cross-account backup, enabling AWS customers to securely copy backups across accounts within their AWS Organizations.\u003cbr\u003e\n\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#management-and-governance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"management-and-governance","description":"marketing:marchitecture/management-and-governance","dateCreated":"2023-11-07T19:30:55+0000","dateUpdated":"2023-11-07T19:30:55+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#general-products#amazon-aurora","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-aurora","description":"general:products/amazon-aurora","dateCreated":"2023-11-07T22:36:01+0000","dateUpdated":"2023-11-07T22:36:01+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#general-products#aws-organizations","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-organizations","description":"general:products/aws-organizations","dateCreated":"2023-11-09T13:50:49+0000","dateUpdated":"2023-11-09T13:50:49+0000"},{"id":"whats-new-v2#general-products#amazon-rds","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-rds","description":"general:products/amazon-rds","dateCreated":"2023-11-07T22:38:13+0000","dateUpdated":"2023-11-07T22:38:13+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"whats-new-v2#general-products#aws-backup","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-backup","description":"general:products/aws-backup","dateCreated":"2023-11-09T13:50:45+0000","dateUpdated":"2023-11-09T13:50:45+0000"},{"id":"whats-new-v2#general-products#amazon-ec2","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-ec2","description":"general:products/amazon-ec2","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#marketing-marchitecture#security-identity-and-compliance","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"security-identity-and-compliance","description":"marketing:marchitecture/security-identity-and-compliance","dateCreated":"2023-11-09T13:50:49+0000","dateUpdated":"2023-11-09T13:50:49+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-11-aws-storage-gateway-increases-local-storage-cache-for-tape-and-file-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/11/aws-storage-gateway-increases-local-storage-cache-for-tape-and-file-gateway/","dateCreated":"2023-11-09T14:00:30+0000","dateUpdated":"2024-07-25T13:14:00+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e now supports local storage cache of up to 64 TB for \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\" target\u003d\"_blank\"\u003eTape Gateway\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/storagegateway/volume/\" target\u003d\"_blank\"\u003eVolume Gateway\u003c/a\u003e, enabling low-latency access to larger working datasets at your premises. Now, you can easily scale your gateway’s local cache to manage more of your application data closer to your on-premises applications and users. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eWith this launch, you can improve performance for on-premises applications by managing more of your working datasets in the local cache. The increased scale of the local cache enables you to keep more data on premises minimizing your data access and restore times. Additionally, you can now buffer more data in the local cache for upload when you have limited network bandwidth available to upload data from your gateway to AWS. AWS Storage Gateway supports local storage cache of up to 64 TB for File Gateway, Tape Gateway, and Volume Gateway running on supported virtual machine hypervisors.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eStorage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited cloud storage using NFS, SMB, iSCSI, and iSCSI-VTL interfaces through file, tape, and volume gateways. You can use the service for backing up and archiving data to AWS, providing on-premises file shares backed by cloud storage, and providing on-premises applications low-latency access to in-cloud data. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThis expanded capability is available on new gateways starting today in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eevery Region where AWS Storage Gateway is available\u003c/a\u003e. For existing gateways this new capability will be made available during the next scheduled software update. To learn more, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/resource-gateway-limits.html#disk-sizes\" target\u003d\"_blank\"\u003eAWS Storage Gateway User Guide\u003c/a\u003e or read our \u003ca href\u003d\"https://aws.amazon.com/blogs/storage/aws-storage-gateway-increases-cache-4x-and-enhances-bandwidth-throttling\" target\u003d\"_blank\"\u003eblog\u003c/a\u003e. Access the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eStorage Gateway console\u003c/a\u003e to get started. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-11-09T19:02:09Z","headlineUrl":"/about-aws/whats-new/2020/11/aws-storage-gateway-increases-local-storage-cache-for-tape-and-file-gateway/","postDateTime":"2020-11-09T12:35:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway increases local storage cache by 4x for Tape and Volume Gateway","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e now supports local storage cache of up to 64 TB for \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/vtl.html\" target\u003d\"_blank\"\u003eTape Gateway\u003c/a\u003e and \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/volume.html\" target\u003d\"_blank\"\u003eVolume Gateway\u003c/a\u003e, enabling low-latency access to larger working datasets at your premises. Now, you can easily scale your gateway’s local cache to manage more of your application data closer to your on-premises applications and users. \u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage-day","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage-day","description":"marketing:marchitecture/storage-day","dateCreated":"2023-11-09T13:57:24+0000","dateUpdated":"2023-11-09T13:57:24+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-11-aws-storage-gateway-enhances-security-by-introducing-access-based-enumeration-for-file-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/11/aws-storage-gateway-enhances-security-by-introducing-access-based-enumeration-for-file-gateway/","dateCreated":"2023-11-09T14:07:15+0000","dateUpdated":"2024-07-25T13:29:34+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e introduces access-based enumeration for \u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/\" target\u003d\"_blank\"\u003eFile Gateway\u003c/a\u003e, enabling you to protect sensitive information by allowing you to prevent users from seeing SMB file shares, folders, and files that they would not be able to open based on their access permissions.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eWith this launch, you can now make all SMB file shares on a gateway visible to users, and filter the display of folders and files within a file share based on user permissions. This capability helps you protect sensitive information that could be visible in folder names or file names where users do not have permission to open the files or folders. In addition, it provides users with a simplified view of folder structures by only displaying the folders and files they can access. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eStorage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited cloud storage using NFS, SMB, iSCSI, and iSCSI-VTL interfaces through file, tape, and volume gateways. You can use the service for backing up and archiving data to AWS, providing on-premises file shares backed by cloud storage, and providing on-premises applications low latency access to in-cloud data.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThese capabilities are available on new gateways starting today in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eevery Region where AWS Storage Gateway is available\u003c/a\u003e. For existing gateways this new capability will be made available during the next scheduled software update. To learn more, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/managing-gateway-file.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway User Guide\u003c/a\u003e. Access the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eStorage Gateway console\u003c/a\u003e to get started. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-11-09T18:55:47Z","headlineUrl":"/about-aws/whats-new/2020/11/aws-storage-gateway-enhances-security-by-introducing-access-based-enumeration-for-file-gateway/","postDateTime":"2020-11-09T12:14:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway enhances security by introducing access-based enumeration for File Gateway","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e introduces access-based enumeration for \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/file.html\" target\u003d\"_blank\"\u003eFile Gateway\u003c/a\u003e, enabling you to protect sensitive information by allowing you to prevent users from seeing SMB file shares, folders, and files that they would not be able to open based on their access permissions.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#storage-day","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage-day","description":"marketing:marchitecture/storage-day","dateCreated":"2023-11-09T13:57:24+0000","dateUpdated":"2023-11-09T13:57:24+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-11-aws-storage-gateway-simplifies-in-cloud-processing-by-adding-file-level-upload-notifications-for-file-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/11/aws-storage-gateway-simplifies-in-cloud-processing-by-adding-file-level-upload-notifications-for-file-gateway/","dateCreated":"2023-11-09T14:03:38+0000","dateUpdated":"2024-07-25T13:21:48+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e introduces file-level upload notifications for \u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/\" target\u003d\"_blank\"\u003eFile Gateway\u003c/a\u003e, enabling you to trigger automated workflows in the cloud and easily process on-premises file data stored with AWS as Amazon Simple Storage Service (Amazon S3) objects. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eWith this launch, you can use File Gateway to automatically generate file-level upload notifications to Amazon CloudWatch when an on-premises file is uploaded to AWS through the gateway and stored as an Amazon S3 object. You can configure Amazon CloudWatch or Amazon EventBridge to send file-level upload events to an event target, such as AWS Lambda, and automatically trigger downstream workflows required by your business processes. For example, you can use file-level upload notifications to create an automated process to copy individual Amazon S3 objects to another Amazon S3 bucket as part of your data protection workflow.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eStorage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited cloud storage using NFS, SMB, iSCSI, and iSCSI-VTL interfaces through file, tape, and volume gateways. You can use the service for backing up and archiving data to AWS, providing on-premises file shares backed by cloud storage, and providing on-premises applications low latency access to in-cloud data.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThese capabilities are available on new gateways starting today in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eevery Region where AWS Storage Gateway is available\u003c/a\u003e. For existing gateways this new capability will be made available during the next scheduled software update. To learn more, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/monitoring-file-gateway.html#get-notification\" target\u003d\"_blank\"\u003eAWS Storage Gateway User Guide\u003c/a\u003e. Access the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eStorage Gateway console\u003c/a\u003e to get started. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-11-09T18:59:12Z","headlineUrl":"/about-aws/whats-new/2020/11/aws-storage-gateway-simplifies-in-cloud-processing-by-adding-file-level-upload-notifications-for-file-gateway/","postDateTime":"2020-11-09T12:04:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway simplifies in-cloud processing by adding file-level upload notifications for File Gateway ","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e introduces file-level upload notifications for \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/file.html\" target\u003d\"_blank\"\u003eFile Gateway\u003c/a\u003e, enabling you to trigger automated workflows in the cloud and easily process on-premises file data stored with AWS as Amazon Simple Storage Service (Amazon S3) objects. \u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage-day","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage-day","description":"marketing:marchitecture/storage-day","dateCreated":"2023-11-09T13:57:24+0000","dateUpdated":"2023-11-09T13:57:24+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-11-aws-storage-gateway-adds-schedule-based-network-bandwidth-throttling-tape-volume-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/11/aws-storage-gateway-adds-schedule-based-network-bandwidth-throttling-tape-volume-gateway/","dateCreated":"2023-11-09T13:57:24+0000","dateUpdated":"2024-07-25T13:05:53+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e now supports schedule-based network bandwidth throttling for \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\"\u003eTape Gateway\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/storagegateway/volume/\"\u003eVolume Gateway\u003c/a\u003e, enabling you to optimize network use between your data center and AWS for data synchronization. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003e  With this launch, you can throttle network bandwidth used by the gateway to synchronize on-premises data with AWS based on a schedule you set on the gateway. This enables you to optimally use your network connection to AWS, regulating bandwidth use during peak time to minimize network congestion and using all your available bandwidth during off-peak hours.\u003c/p\u003e\n\u003cp\u003eStorage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited cloud storage using NFS, SMB, iSCSI, and iSCSI-VTL interfaces through file, tape, and volume gateways. You can use the service for backing up and archiving data to AWS, providing on-premises file shares backed by cloud storage, and providing on-premises applications low latency access to in-cloud data. \u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eThis expanded capability is available on new gateways starting today in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\"\u003eevery Region where AWS Storage Gateway is available\u003c/a\u003e. For existing gateways this new capability will be made available during the next scheduled software update. To learn more, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/MaintenanceUpdateBandwidth-common.html#SchedulingBandwidthThrottling\"\u003eAWS Storage Gateway User Guide\u003c/a\u003e or read our \u003ca href\u003d\"https://aws.amazon.com/blogs/storage/aws-storage-gateway-increases-cache-4x-and-enhances-bandwidth-throttling\"\u003eblog\u003c/a\u003e. Access the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\"\u003eStorage Gateway console\u003c/a\u003e to get started. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-11-09T19:49:02Z","headlineUrl":"/about-aws/whats-new/2020/11/aws-storage-gateway-adds-schedule-based-network-bandwidth-throttling-tape-volume-gateway/","postDateTime":"2020-11-09T09:41:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway adds schedule-based network bandwidth throttling for Tape and Volume Gateway","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e now supports schedule-based network bandwidth throttling for \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/vtl.html\"\u003eTape Gateway\u003c/a\u003e and \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/volume.html\"\u003eVolume Gateway\u003c/a\u003e, enabling you to optimize network use between your data center and AWS for data synchronization. \u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage-day","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage-day","description":"marketing:marchitecture/storage-day","dateCreated":"2023-11-09T13:57:24+0000","dateUpdated":"2023-11-09T13:57:24+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-09-aws-storage-gateway-increases-performance-by-4x-for-file-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/09/aws-storage-gateway-increases-performance-by-4x-for-file-gateway/","dateCreated":"2023-11-09T14:04:20+0000","dateUpdated":"2024-07-25T13:06:46+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e increases performance for reading data from Amazon S3 for \u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/\" target\u003d\"_blank\"\u003eFile Gateway\u003c/a\u003e, providing you 4x faster access to data managed through the gateway. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eWith this launch, you can read files stored in Amazon S3 through the File Gateway at up to 4 Gbps, providing you faster on-premises access to data stored in AWS. Now you can restore backups stored in the cloud more quickly and provide end users with faster access to files in Amazon S3.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eStorage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited cloud storage using NFS, SMB, iSCSI, and iSCSI-VTL interfaces through file, tape, and volume gateways. You can use the service for backing up and archiving data to AWS, providing on-premises file shares backed by cloud storage, and providing on-premises applications low-latency access to in-cloud data.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThese capabilities are available on new gateways starting today in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eevery Region where AWS Storage Gateway is available\u003c/a\u003e. For existing gateways this new capability will be made available during the next scheduled software update. To learn more, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/Performance.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway User Guide\u003c/a\u003e. Access the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eStorage Gateway console\u003c/a\u003e to get started. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-09-01T16:57:56Z","headlineUrl":"/about-aws/whats-new/2020/09/aws-storage-gateway-increases-performance-by-4x-for-file-gateway/","postDateTime":"2020-09-01T10:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway increases performance by 4x for File Gateway","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e increases performance for reading data from Amazon S3 for \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/file.html\" target\u003d\"_blank\"\u003eFile Gateway\u003c/a\u003e, providing you 4x faster access to data managed through the gateway. \u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-08-aws-storage-gateway-adds-data-protection-features-for-tape-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/08/aws-storage-gateway-adds-data-protection-features-for-tape-gateway/","dateCreated":"2023-11-09T14:04:19+0000","dateUpdated":"2024-07-25T13:19:10+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e now supports Write-Once-Read-Many (WORM) and Tape Retention Lock on \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\" target\u003d\"_blank\"\u003eTape Gateway\u003c/a\u003e virtual tapes, providing you data protection features to meet regulatory compliance.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eWORM-enabled virtual tapes ensure that data on active tapes in your virtual tape library cannot be overwritten or erased, providing you an added layer of protection against malicious or accidental deletion of data. This new capability complements WORM capability of virtual tapes archived in Amazon S3 Glacier and Amazon S3 Glacier Deep Archive, providing you comprehensive data protection for both active and archived virtual tapes. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThe new Tape Retention Lock capability allows you to specify retention mode and period on archived virtual tapes, preventing them from being deleted for a fixed amount of time or even indefinitely, including permission controls on who can delete tapes or modify retention settings. Tape Retention Lock helps you comply with industry regulations on data that you need to retain for compliance purposes.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eTape Gateway enables you to replace using physical tapes on premises with virtual tapes in AWS without changing backup workflows. Tape Gateway caches data on premises for low-latency access, compresses and encrypts data in transit to AWS, and transitions virtual tapes to Amazon S3 Glacier or Amazon S3 Glacier Deep Archive to minimize storage costs.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThese capabilities are available on new gateways starting today and will be made available on existing gateways during the next software update. To learn more, see \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/create-gateway-vtl.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway User Guide\u003c/a\u003e or the latest \u003ca href\u003d\"http://aws.amazon.com/blogs/storage/protecting-archives-with-worm-and-tape-retention-lock\" target\u003d\"_blank\"\u003eAWS Storage Blog\u003c/a\u003e. Access the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eStorage Gateway console\u003c/a\u003e to get started. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-08-19T21:56:43Z","headlineUrl":"/about-aws/whats-new/2020/08/aws-storage-gateway-adds-data-protection-features-for-tape-gateway/","postDateTime":"2020-08-19T12:38:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway adds data protection features for Tape Gateway","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e now supports Write-Once-Read-Many (WORM) and Tape Retention Lock on \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/vtl.html\" target\u003d\"_blank\"\u003eTape Gateway\u003c/a\u003e virtual tapes, providing you data protection features to meet regulatory compliance.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#general-products#amazon-s3","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-s3","description":"general:products/amazon-s3","dateCreated":"2023-11-09T13:53:07+0000","dateUpdated":"2023-11-09T13:53:07+0000"},{"id":"whats-new-v2#general-products#amazon-simple-storage-service","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-simple-storage-service","description":"general:products/amazon-simple-storage-service","dateCreated":"2023-11-09T13:57:06+0000","dateUpdated":"2023-11-09T13:57:06+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-08-aws-storage-gateway-expands-availability-streamlines-ordering-hardware-appliance","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/08/aws-storage-gateway-expands-availability-streamlines-ordering-hardware-appliance/","dateCreated":"2023-11-09T14:05:47+0000","dateUpdated":"2024-07-25T13:14:51+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e expands international availability of the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/hardware-appliance/\"\u003eAWS Storage Gateway Hardware Appliance\u003c/a\u003e to several AWS Regions in Asia Pacific, South America, and Canada, and streamlines ordering through the AWS Console. The hardware appliance is now available for shipping to more international destinations in addition to the US and Europe. The ordering process is now streamlined to comply with corporate procurement policies for purchasing IT equipment. Customers can now request sales quotes and submit purchase orders directly on the AWS Console.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThe hardware appliance is a validated server configuration that is pre-loaded with the Storage Gateway software. The appliance is managed from the AWS Console or API and is designed for customers with environments that lack availability of virtualized infrastructure. It provides a simple out of the box deployment experience that does not require any additional infrastructure. With this launch, customers can easily and seamlessly order the hardware appliance directly on the AWS Console.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eStorage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited cloud storage using NFS, SMB, iSCSI, and iSCSI-VTL interfaces through file, tape, and volume gateways. You can use the service for backing up and archiving data to AWS, using on-premises file shares backed by cloud storage, and providing on-premises applications access to in-cloud data.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThe Storage Gateway Hardware Appliance is now supported in \u003ca href\u003d\"https://docs.aws.amazon.com/general/latest/gr/sg.html#sg-hardware-appliance\"\u003e16 AWS Regions\u003c/a\u003e. To learn more, read the \u003ca href\u003d\"https://aws.amazon.com/blogs/storage/expanded-availability-and-streamlined-ordering-of-the-aws-storage-gateway-hardware-appliance/\"\u003elaunch blog\u003c/a\u003e, visit the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/hardware-appliance/\"\u003eAWS Storage Gateway Hardware Appliance product page\u003c/a\u003e, and view the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/HardwareAppliance.html\"\u003edocumentation\u003c/a\u003e. Access the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\"\u003eStorage Gateway console\u003c/a\u003e to get started.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-08-12T18:21:20Z","headlineUrl":"/about-aws/whats-new/2020/08/aws-storage-gateway-expands-availability-streamlines-ordering-hardware-appliance/","postDateTime":"2020-08-12T09:36:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway expands availability and streamlines ordering of the hardware appliance","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e expands international availability of the \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/hardware-appliance.html\"\u003eAWS Storage Gateway Hardware Appliance\u003c/a\u003e to several AWS Regions in Asia Pacific, South America, and Canada, and streamlines ordering through the AWS Console. The hardware appliance is now available for shipping to more international destinations in addition to the US and Europe. The ordering process is now streamlined to comply with corporate procurement policies for purchasing IT equipment. Customers can now request sales quotes and submit purchase orders directly on the AWS Console.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-07-aws-storage-gateway-expands-fips-140-2-compliant-endpoints-to-all-north-america-regions","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/07/aws-storage-gateway-expands-fips-140-2-compliant-endpoints-to-all-north-america-regions/","dateCreated":"2023-11-09T13:57:56+0000","dateUpdated":"2024-07-25T13:26:10+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e now offers Federal Information Processing Standards (FIPS) 140-2 compliant endpoints in all North America Regions to protect sensitive information for regulated workloads. These endpoints terminate Transport Layer Security (TLS) sessions using a FIPS 140-2 validated cryptographic software module, making it easier for you to use Storage Gateway for regulated workloads. Companies contracting with the US and Canadian federal governments can now meet the FIPS security requirement to encrypt sensitive data in these Regions.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eTo use this new capability, choose the FIPS endpoint option when creating your Storage Gateway. Your gateway will connect to the FIPS endpoint to activate in your chosen AWS Region, and all data subsequently transferred by this gateway will only use FIPS validated encryption. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eFIPS 140-2 compliant endpoints for Storage Gateway are now available in the following \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eAWS Regions\u003c/a\u003e: US East (N. Virginia), US East (Ohio), US West (N. California), US West (Oregon), Canada (Central), and AWS GovCloud (US) Regions. You can learn more by reading the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/create-gateway-file.html#GettingStarted-service-endpoint-file\" target\u003d\"_blank\"\u003eAWS Storage Gateway User Guide\u003c/a\u003e or see the \u003ca href\u003d\"https://docs.aws.amazon.com/general/latest/gr/rande.html\" target\u003d\"_blank\"\u003eAWS service endpoints page\u003c/a\u003e.\u0026nbsp;Access the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eStorage Gateway console\u003c/a\u003e to get started.\u003c/p\u003e\n","modifiedDate":"2020-08-03T18:28:57Z","headlineUrl":"/about-aws/whats-new/2020/07/aws-storage-gateway-expands-fips-140-2-compliant-endpoints-to-all-north-america-regions/","postDateTime":"2020-07-31T11:30:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway expands FIPS 140-2 compliant endpoints to all North America Regions","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e now offers Federal Information Processing Standards (FIPS) 140-2 compliant endpoints in all North America Regions to protect sensitive information for regulated workloads. These endpoints terminate Transport Layer Security (TLS) sessions using a FIPS 140-2 validated cryptographic software module, making it easier for you to use Storage Gateway for regulated workloads. Companies contracting with the US and Canadian federal governments can now meet the FIPS security requirement to encrypt sensitive data in these Regions.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-07-aws-storage-gateway-increases-local-cache-storage-by-4-times-for-file-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/07/aws-storage-gateway-increases-local-cache-storage-by-4-times-for-file-gateway/","dateCreated":"2023-11-09T13:53:56+0000","dateUpdated":"2024-07-25T13:10:19+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e now supports a local cache of up to 64 TB for \u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/\" target\u003d\"_blank\"\u003eFile Gateway\u003c/a\u003e, improving performance for your on-premises applications by providing you with low-latency access to larger working data sets. Now, you can easily scale your gateway’s local cache to manage more of your application data closer to your on-premises applications and users. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eWith this launch, you can improve performance for on-premises applications by managing larger on-premises file shares to manage more of your working data sets in the local cache. The increased scale of the local cache enables you to keep more data on premises minimizing your data access and restore times. Additionally, you can now buffer more data in the local cache for upload when you have limited network bandwidth available to upload data from your gateway to Amazon S3.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eStorage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited cloud storage using NFS, SMB, iSCSI, and iSCSI-VTL interfaces through file, tape, and volume gateways. You can use the service for backing up and archiving data to AWS, providing on-premises file shares backed by cloud storage, and providing on-premises applications low-latency access to in-cloud data.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThis expanded capability is available on new gateways starting today in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eevery Region where AWS Storage Gateway is available\u003c/a\u003e. For existing gateways this new capability will be made available during the next scheduled software update. To learn more, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide\" target\u003d\"_blank\"\u003eAWS Storage Gateway User Guide\u003c/a\u003e. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-07-07T19:54:48Z","headlineUrl":"/about-aws/whats-new/2020/07/aws-storage-gateway-increases-local-cache-storage-by-4-times-for-file-gateway/","postDateTime":"2020-07-07T12:43:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway increases local cache storage by 4x for File Gateway ","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e now supports a local cache of up to 64 TB for \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/file.html\" target\u003d\"_blank\"\u003eFile Gateway\u003c/a\u003e, improving performance for your on-premises applications by providing you with low-latency access to larger working data sets. Now, you can easily scale your gateway’s local cache to manage more of your application data closer to your on-premises applications and users. \u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-07-aws-storage-gateway-simplifies-cache-management-for-file-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/07/aws-storage-gateway-simplifies-cache-management-for-file-gateway/","dateCreated":"2023-11-09T13:57:29+0000","dateUpdated":"2024-07-25T13:05:10+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e simplifies cache management for \u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/\" target\u003d\"_blank\"\u003eFile Gateway\u003c/a\u003e by enabling you to create multiple file shares for a single Amazon S3 bucket and synchronize the gateway’s local cache with an Amazon S3 bucket based on frequency of directory access. These enhancements simplify the management of your gateway by providing flexibility when configuring new file shares and streamlining the cache refresh process. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eWith this launch, you can now limit the number of S3 buckets necessary to manage the file shares you create on your File Gateway. You can define multiple S3 prefixes for a S3 bucket and map a single S3 prefix to a single gateway file share. You can also define gateway file share names to be independent of the S3 bucket name to fit your on-premises file share naming convention.  \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eIn addition, when multiple gateways access data from a single S3 bucket, you can enable a new gateway cache refresh process on a gateway by simply setting a specific period of time since the last access of a directory. This capability ensures that frequently accessed directories are automatically refreshed to synchronize with the S3 bucket and infrequently accessed directories are refreshed only when needed. Multiple directories can be refreshed concurrently without the need to create and manage a cache refresh workflow. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eStorage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited cloud storage using NFS, SMB, iSCSI, and iSCSI-VTL interfaces through file, tape, and volume gateways. You can use the service for backing up and archiving data to AWS, providing on-premises file shares backed by cloud storage, and providing on-premises applications low-latency access to in-cloud data.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThese capabilities are available on new gateways starting today in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eevery Region where AWS Storage Gateway is available\u003c/a\u003e. For existing gateways this new capability will be made available during the next scheduled software update. To learn more, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide\" target\u003d\"_blank\"\u003eAWS Storage Gateway User Guide\u003c/a\u003e. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-07-07T19:54:42Z","headlineUrl":"/about-aws/whats-new/2020/07/aws-storage-gateway-simplifies-cache-management-for-file-gateway/","postDateTime":"2020-07-07T12:39:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway simplifies cache management for File Gateway ","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e simplifies cache management for \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/file.html\" target\u003d\"_blank\"\u003eFile Gateway\u003c/a\u003e by enabling you to create multiple file shares for a single Amazon S3 bucket and synchronize the gateway’s local cache with an Amazon S3 bucket based on frequency of directory access. These enhancements simplify the management of your gateway by providing flexibility when configuring new file shares and streamlining the cache refresh process. \u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-05-aws-storage-gateway-consolidates-alarms-metrics-for-simplified-console-monitoring","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/05/aws-storage-gateway-consolidates-alarms-metrics-for-simplified-console-monitoring/","dateCreated":"2023-11-09T14:08:37+0000","dateUpdated":"2024-07-25T13:08:35+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e now consolidates monitoring of a gateway’s \u003ca href\u003d\"https://docs.aws.amazon.com/AmazonCloudWatch/latest/monitoring/AlarmThatSendsEmail.html\" target\u003d\"_blank\"\u003eCloudWatch Alarms\u003c/a\u003e\u0026nbsp;directly from the Storage Gateway console. Access to CloudWatch Alarms in the console, along with the existing CloudWatch Metrics, provides you continuous visibility into gateway health and performance all in one place. Now you can quickly take action on alarms triggered when defined metrics fall outside thresholds you configure.\u003c/p\u003e\n\u003cp\u003eWith this launch, you can monitor CloudWatch Alarms for gateway metrics such as cache status, disk performance, and health notifications for VMware vSphere high availability in the Storage Gateway console. You can also choose to receive alarm notifications by subscribing an alarm to the Amazon SNS from the Amazon CloudWatch console.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eStorage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited cloud storage using NFS, SMB, iSCSI, and iSCSI-VTL interfaces through file, tape, and volume gateways. You can use the service for backing up and archiving data to AWS, using on-premises file shares backed by cloud storage, and providing low-latency access to in-cloud data for on-premises applications.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eStarting today, you can access CloudWatch Alarms from the Storage Gateway console in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eevery Region\u003c/a\u003e where AWS Storage Gateway is available. Step-by-step instructions are located in the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/monitoring-file-gateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway User Guide\u003c/a\u003e. CloudWatch charges apply when you enable CloudWatch Alarms. For more information, visit the \u003ca href\u003d\"https://aws.amazon.com/cloudwatch/pricing/\" target\u003d\"_blank\"\u003eAmazon CloudWatch Pricing Page\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-05-29T20:04:22Z","headlineUrl":"/about-aws/whats-new/2020/05/aws-storage-gateway-consolidates-alarms-metrics-for-simplified-console-monitoring/","postDateTime":"2020-05-29T12:29:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway consolidates alarms and metrics for simplified console monitoring and management ","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e now consolidates monitoring of a gateway’s \u003ca href\u003d\"https://docs.aws.amazon.com/AmazonCloudWatch/latest/monitoring/AlarmThatSendsEmail.html\" target\u003d\"_blank\"\u003eCloudWatch Alarms\u003c/a\u003e\u0026nbsp;directly from the Storage Gateway console. Access to CloudWatch Alarms in the console, along with the existing CloudWatch Metrics, provides you continuous visibility into gateway health and performance all in one place. Now you can quickly take action on alarms triggered when defined metrics fall outside thresholds you configure.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#amazon-cloudwatch","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-cloudwatch","description":"general:products/amazon-cloudwatch","dateCreated":"2023-11-09T13:50:47+0000","dateUpdated":"2023-11-09T13:50:47+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-05-aws-storage-gateway-supports-fips-140-2-compliant-endpoints-aws-govcloud-regions","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/05/aws-storage-gateway-supports-fips-140-2-compliant-endpoints-aws-govcloud-regions/","dateCreated":"2023-11-09T14:01:36+0000","dateUpdated":"2024-07-25T13:07:17+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e now offers Federal Information Processing Standards (FIPS) 140-2 compliant endpoints in \u003ca href\u003d\"https://aws.amazon.com/govcloud-us/\"\u003eAWS GovCloud (US) Regions\u003c/a\u003e to protect sensitive information for regulated workloads. These endpoints terminate Transport Layer Security (TLS) sessions using a FIPS 140-2 validated cryptographic software module, making it easier for you to use Storage Gateway for regulated workloads. US Federal agencies and companies contracting with the US Federal government can now meet the FIPS security requirement to encrypt sensitive data.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eTo use this new capability, choose the FIPS endpoint option when creating your Storage Gateway. Your gateway will connect to the FIPS endpoint to activate in your chosen AWS Region, and all data subsequently transferred by this gateway will only use FIPS validated encryption. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eFIPS 140-2 compliant endpoints for Storage Gateway are available in AWS GovCloud (US-East) and AWS GovCloud (US-West). You can learn more by reading the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/create-gateway-file.html#GettingStarted-service-endpoint-file\"\u003eAWS Storage Gateway User Guide\u003c/a\u003e or see the \u003ca href\u003d\"https://docs.aws.amazon.com/general/latest/gr/rande.html\"\u003eAWS service endpoints page\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-05-22T19:05:16Z","headlineUrl":"/about-aws/whats-new/2020/05/aws-storage-gateway-supports-fips-140-2-compliant-endpoints-aws-govcloud-regions/","postDateTime":"2020-05-22T08:50:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway supports FIPS 140-2 compliant endpoints in AWS GovCloud (US) Regions","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e now offers Federal Information Processing Standards (FIPS) 140-2 compliant endpoints in \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/govcloud-us.html\"\u003eAWS GovCloud (US) Regions\u003c/a\u003e to protect sensitive information for regulated workloads. These endpoints terminate Transport Layer Security (TLS) sessions using a FIPS 140-2 validated cryptographic software module, making it easier for you to use Storage Gateway for regulated workloads. US Federal agencies and companies contracting with the US Federal government can now meet the FIPS security requirement to encrypt sensitive data.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"whats-new-v2#general-products#aws-govcloud-us","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-govcloud-us","description":"general:products/aws-govcloud-us","dateCreated":"2023-11-07T18:41:18+0000","dateUpdated":"2023-11-07T18:41:18+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-05-aws-storage-gateway-now-available-milan-cape-town","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/05/aws-storage-gateway-now-available-milan-cape-town/","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2024-07-25T13:09:30+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e is now available in AWS Europe (Milan) and AWS Africa (Cape Town) Regions. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eStorage Gateway is a hybrid cloud storage service that enables your on-premises applications to seamlessly use AWS cloud storage. You can use the service for backup and archiving, disaster recovery, cloud data processing, storage tiering, and migration, helping you reduce and simplify your datacenter, head office, branch office, and remote office storage infrastructure. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eStorage Gateway is available in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eall regions worldwide\u003c/a\u003e. Visit the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eStorage Gateway product page\u003c/a\u003e for more information.  \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-05-08T17:18:51Z","headlineUrl":"/about-aws/whats-new/2020/05/aws-storage-gateway-now-available-milan-cape-town/","postDateTime":"2020-05-08T09:49:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway is now available in AWS Europe (Milan) and AWS Africa (Cape Town) Regions","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e is now available in AWS Europe (Milan) and AWS Africa (Cape Town) Regions. \u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-04-aws-storage-gateway-adds-amazon-s3-intelligent-tiering-for-file-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/04/aws-storage-gateway-adds-amazon-s3-intelligent-tiering-for-file-gateway/","dateCreated":"2023-11-09T14:08:11+0000","dateUpdated":"2024-07-25T13:12:42+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e now supports \u003ca href\u003d\"https://aws.amazon.com/s3/storage-classes/\" target\u003d\"_blank\"\u003eAmazon S3 Intelligent-Tiering\u003c/a\u003e as a storage class for \u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/\" target\u003d\"_blank\"\u003eFile Gateway\u003c/a\u003e, enabling you to optimize storage costs automatically when data access patterns change, without impacting performance or incurring operational overhead. This eliminates the challenge of needing to have a deep understanding of your on-premises users and applications’ data access patterns. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eFile Gateway provides on-premises applications with file-based, cached access to virtually unlimited cloud storage using SMB and NFS protocols. With this launch, you can now select Amazon S3 Intelligent-Tiering as a storage class when you set up file shares on your File Gateway. Configuring File Gateway to store data to Amazon S3 Intelligent-Tiering delivers automatic cost savings by moving data between two tiers, frequent access and infrequent access, when access patterns change. It is ideal for workloads with access patterns that change frequently, or where the data is accessed by many applications with varying access patterns.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThis capability is available on new gateways starting today in every \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eRegion\u003c/a\u003e where AWS Storage Gateway is available and for existing gateways it will be made available through a software update by May 30, 2020. Step-by-step instructions are located in the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/GettingStartedCreateFileShare.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway User Guide\u003c/a\u003e. Please visit the \u003ca href\u003d\"https://aws.amazon.com/s3/\" target\u003d\"_blank\"\u003eAmazon S3\u003c/a\u003e page for details about storage class options and pricing information.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-07-23T21:09:49Z","headlineUrl":"/about-aws/whats-new/2020/04/aws-storage-gateway-adds-amazon-s3-intelligent-tiering-for-file-gateway/","postDateTime":"2020-04-30T12:26:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway adds Amazon S3 Intelligent-Tiering for File Gateway","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e now supports \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/s3/storage-classes.html\" target\u003d\"_blank\"\u003eAmazon S3 Intelligent-Tiering\u003c/a\u003e as a storage class for \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/file.html\" target\u003d\"_blank\"\u003eFile Gateway\u003c/a\u003e, enabling you to optimize storage costs automatically when data access patterns change, without impacting performance or incurring operational overhead. This eliminates the challenge of needing to have a deep understanding of your on-premises users and applications’ data access patterns. \u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#general-products#amazon-simple-storage-service","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-simple-storage-service","description":"general:products/amazon-simple-storage-service","dateCreated":"2023-11-09T13:57:06+0000","dateUpdated":"2023-11-09T13:57:06+0000"},{"id":"whats-new-v2#general-products#amazon-s3","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-s3","description":"general:products/amazon-s3","dateCreated":"2023-11-09T13:53:07+0000","dateUpdated":"2023-11-09T13:53:07+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-04-aws-storage-gateway-automates-creating-new-virtual-tapes-on-tape-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/04/aws-storage-gateway-automates-creating-new-virtual-tapes-on-tape-gateway/","dateCreated":"2023-11-09T14:07:45+0000","dateUpdated":"2024-07-25T13:09:17+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e automates creating new virtual tapes on \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\" target\u003d\"_blank\"\u003eTape Gateway\u003c/a\u003e, helping you eliminate manual management of new tapes, easily manage large deployments, and efficiently scale growing on-premises backup and archive storage needs. With this enhancement, Tape Gateway automatically creates new virtual tapes to maintain the minimum number of available tapes you configure and then makes these new tapes available for import by the backup application, enabling your backup jobs to run without interruption. Automatic tape creation removes the need for custom scripting as well as the manual process to create new virtual tapes.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eTape Gateway supports all leading backup applications and enables you to replace using physical tapes on premises with virtual tapes in AWS without changing backup workflows.\u0026nbsp;Tape Gateway caches virtual tapes on premises for low-latency data access, encrypts data between the gateway and AWS for secure data transfer, and compresses data and transitions virtual tapes between Amazon S3 and Amazon S3 Glacier, or Amazon S3 Glacier Deep Archive to minimize your storage costs. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThis capability is available on new gateways starting today and will be made available on existing gateways through a software update starting April 30, 2020. To get started with using Tape Gateway, see step-by-step instructions in the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/create-gateway-vtl.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway User Guide\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-04-24T00:13:23Z","headlineUrl":"/about-aws/whats-new/2020/04/aws-storage-gateway-automates-creating-new-virtual-tapes-on-tape-gateway/","postDateTime":"2020-04-23T12:46:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway automates creating new virtual tapes on Tape Gateway","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e automates creating new virtual tapes on \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/vtl.html\" target\u003d\"_blank\"\u003eTape Gateway\u003c/a\u003e, helping you eliminate manual management of new tapes, easily manage large deployments, and efficiently scale growing on-premises backup and archive storage needs. With this enhancement, Tape Gateway automatically creates new virtual tapes to maintain the minimum number of available tapes you configure and then makes these new tapes available for import by the backup application, enabling your backup jobs to run without interruption. Automatic tape creation removes the need for custom scripting as well as the manual process to create new virtual tapes.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-04-aws-storage-gateway-increases-tape-gateway-write-and-read-performance","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/04/aws-storage-gateway-increases-tape-gateway-write-and-read-performance/","dateCreated":"2023-11-09T13:55:29+0000","dateUpdated":"2024-07-25T13:02:42+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e increases performance for reading from and writing to virtual tapes on \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\" target\u003d\"_blank\"\u003eTape Gateway\u003c/a\u003e by 2x, enabling you to perform faster backup and recovery than before. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eWith this launch, your backup application can write data to the on-premises Tape Gateway’s storage cache 2x faster than before, at up to 5.2 Gbps, and read data from the cache 2x faster than before, at up to 8.2 Gbps. This improvement accelerates  backup and restore times between your backup application and Tape Gateway. Depending on the network speed between your premises and the AWS Cloud, you can also sustain write speeds of up to 5.2 Gbps from backup application to AWS through the gateway.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eTape Gateway supports all leading backup applications and enables you to replace using physical tapes on premises with virtual tapes in AWS without changing backup workflows. Tape Gateway caches virtual tapes on premises for low-latency data access, encrypts data between the gateway and AWS for secure data transfer, and compresses data and transitions virtual tapes between Amazon S3 and Amazon S3 Glacier, or Amazon S3 Glacier Deep Archive to minimize your storage costs. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThis performance enhancement is available on new gateways starting today and will be made available on existing gateways through a software update starting April 30, 2020. To get started with using Tape Gateway, see step-by-step instructions in the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/create-gateway-vtl.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway User Guide\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-04-23T21:35:33Z","headlineUrl":"/about-aws/whats-new/2020/04/aws-storage-gateway-increases-tape-gateway-write-and-read-performance/","postDateTime":"2020-04-23T12:18:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway increases Tape Gateway write and read performance by 2x","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e increases performance for reading from and writing to virtual tapes on \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/vtl.html\" target\u003d\"_blank\"\u003eTape Gateway\u003c/a\u003e by 2x, enabling you to perform faster backup and recovery than before. \u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-03-aws-storage-gateway-adds-audit-logs-for-file-gateway-to-address-enterprise-compliance-requirements","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/03/aws-storage-gateway-adds-audit-logs-for-file-gateway-to-address-enterprise-compliance-requirements/","dateCreated":"2023-11-09T14:06:45+0000","dateUpdated":"2024-07-25T13:11:16+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e,\u0026nbsp;now enables logging of end-user operations on files and folders for SMB file shares when using File Gateway. Logging allows you to comply with internal security policies, meet external compliance requirements, such as PCI, Sarbanes-Oxley, ISO27001, GDPR, and HIPAA, troubleshoot access errors, and analyze usage trends of your data.\u003c/p\u003e\n\u003cp\u003eFile Gateway provides on-premises applications with file-based, cached access to virtually unlimited cloud storage using SMB and NFS protocols. With this launch, SMB client operations for files and folders are logged to provide IT administrators and compliance managers with the information they need about user access to files and folders. Key operations logged for files and folders include create, delete, read, write, rename, and change of permissions. The logs are published to Amazon CloudWatch Logs where they can be reviewed and written to an Amazon S3 bucket of your choice and exported for use by third-party security information and event management (SIEM) applications.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eStarting today, when you activate a gateway, you can enable File Gateway audit logs in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eevery Region\u003c/a\u003e where AWS Storage Gateway is available. For existing gateways, this new capability will be available through a software update available on or before May 30, 2020. Step-by-step instructions are located in the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/monitoring-file-gateway.html#audit-logs\" target\u003d\"_blank\"\u003eAWS Storage Gateway User Guide\u003c/a\u003e. Charges for CloudWatch Logs apply when you enable File Gateway audit logs. For more information, visit the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/pricing/\" target\u003d\"_blank\"\u003eAWS Storage Gateway Pricing Page\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eAccess the \u003ca href\u003d\"https://aws.amazon.com/blogs/storage/aws-storage-gateway-adds-file-gateway-audit-logs/\" target\u003d\"_blank\"\u003estorage blog\u003c/a\u003e for more information about the File Gateway audit logs launch.\u003c/p\u003e\n","modifiedDate":"2020-03-31T19:48:26Z","headlineUrl":"/about-aws/whats-new/2020/03/aws-storage-gateway-adds-audit-logs-for-file-gateway-to-address-enterprise-compliance-requirements/","postDateTime":"2020-03-31T12:03:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway adds audit logs for File Gateway to address enterprise compliance requirements","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e,\u0026nbsp;now enables logging of end-user operations on files and folders for SMB file shares when using File Gateway. Logging allows you to comply with internal security policies, meet external compliance requirements, such as PCI, Sarbanes-Oxley, ISO27001, GDPR, and HIPAA, troubleshoot access errors, and analyze usage trends of your data.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-03-aws-storage-gateway-is-now-available-in-aws-govcloud-us-east","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/03/aws-storage-gateway-is-now-available-in-aws-govcloud-us-east/","dateCreated":"2023-11-09T13:55:01+0000","dateUpdated":"2024-07-25T13:01:17+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e is now available in the\u0026nbsp;\u003ca href\u003d\"https://aws.amazon.com/govcloud-us/\"\u003eAWS GovCloud\u003c/a\u003e (US-East) Region. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eStorage Gateway is a hybrid cloud storage service that enables your on-premises applications to seamlessly use AWS cloud storage. You can use the service for backup and archiving, disaster recovery, cloud data processing, storage tiering, and migration, helping you reduce and simplify your datacenter, head office, branch office, and remote office storage infrastructure.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eStorage Gateway is now available in available in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regions_az/\"\u003e22 Regions\u003c/a\u003e worldwide. Please visit our \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eproduct page\u003c/a\u003e for more information. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-03-12T22:59:18Z","headlineUrl":"/about-aws/whats-new/2020/03/aws-storage-gateway-is-now-available-in-aws-govcloud-us-east/","postDateTime":"2020-03-12T10:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway is now available in AWS GovCloud (US-East)","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e is now available in the\u0026nbsp;\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/govcloud-us.html\"\u003eAWS GovCloud\u003c/a\u003e (US-East) Region. \u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-govcloud-us","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-govcloud-us","description":"general:products/aws-govcloud-us","dateCreated":"2023-11-07T18:41:18+0000","dateUpdated":"2023-11-07T18:41:18+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-02-aws-storage-gateway-is-now-available-in-aws-china-ningxia","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/02/aws-storage-gateway-is-now-available-in-aws-china-ningxia/","dateCreated":"2023-11-09T13:57:31+0000","dateUpdated":"2024-07-25T13:02:40+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e is now available in the China (Ningxia) Region. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eStorage Gateway is a hybrid storage service that enables your on-premises applications to seamlessly use AWS cloud storage. You can use the service for backup and archiving, disaster recovery, cloud data processing, storage tiering, and migration, helping you reduce and simplify your datacenter, head office, branch, and remote office storage infrastructure.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eStorage Gateway is now available in available in twenty-one Regions worldwide. Please visit our \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eproduct page\u003c/a\u003e for more information. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-02-13T18:00:19Z","headlineUrl":"/about-aws/whats-new/2020/02/aws-storage-gateway-is-now-available-in-aws-china-ningxia/","postDateTime":"2020-02-13T10:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway is now available in AWS China (Ningxia)","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e is now available in the China (Ningxia) Region. \u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2020-02-aws-storage-gateway-available-linux-kvm-hypervisor","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2020/02/aws-storage-gateway-available-linux-kvm-hypervisor/","dateCreated":"2023-11-09T14:00:49+0000","dateUpdated":"2024-07-25T13:03:12+0000","additionalFields":{"postBody":"\u003cp\u003eThe \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e service now includes the Linux Kernel-based Virtual Machine (KVM) hypervisor as a deployment option for all gateway types. If you use KVM hypervisor-based on-premises infrastructure, you can now deploy Storage Gateway in your environment to access virtually unlimited cloud storage.\u003c/p\u003e\n\u003cp\u003e  KVM is an open source virtualization technology that lets you turn a Linux-based host machine into one or more virtual machines. With this launch, you have the option to deploy Storage Gateway on a KVM hypervisor. Storage Gateway supports QEMU-KVM on Red Hat Enterprise Linux 7.7, CentOS 7.7, and Ubuntu 18.04 LTS and 16.04 LTS, on host machines using an Intel x86 CPU with virtualization extension.\u003c/p\u003e\n\u003cp\u003e  Storage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited cloud storage using NFS, SMB, iSCSI, and iSCSI-VTL interfaces. You can use the service to backup and archive data to AWS, shift on-premises storage to cloud-backed file shares, and provide on-premises applications low-latency access to data in AWS. You can deploy Storage Gateway on a virtual appliance (VMware ESXi, Microsoft Hyper-V, Linux KVM) on premises, a hardware appliance on premises, or on an Amazon EC2 instance in AWS.\u003c/p\u003e\n\u003cp\u003eStorage Gateway is available in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\"\u003e20 AWS regions\u003c/a\u003e, including AWS GovCloud (US-West) and China (Beijing). To start using Storage Gateway, see \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/create-gateways.html\"\u003einstructions\u003c/a\u003e in the AWS Storage Gateway User Guide.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-02-04T20:03:32Z","headlineUrl":"/about-aws/whats-new/2020/02/aws-storage-gateway-available-linux-kvm-hypervisor/","postDateTime":"2020-02-04T13:25:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway is now available on Linux KVM hypervisor","postSummary":"\u003cp\u003eThe \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e service now includes the Linux Kernel-based Virtual Machine (KVM) hypervisor as a deployment option for all gateway types. If you use KVM hypervisor-based on-premises infrastructure, you can now deploy Storage Gateway in your environment to access virtually unlimited cloud storage.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#year#2020","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2020","description":"year#2020","dateCreated":"2023-11-09T13:50:17+0000","dateUpdated":"2023-11-09T13:50:17+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-11-aws-storage-gateway-increases-performance-for-tape-and-file-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/11/aws-storage-gateway-increases-performance-for-tape-and-file-gateway/","dateCreated":"2023-11-09T14:14:42+0000","dateUpdated":"2024-07-25T13:31:38+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e increases performance for reading data from AWS for \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\"\u003eTape Gateway\u003c/a\u003e, and for reading data and listing directories for \u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/\"\u003eFile Gateway\u003c/a\u003e, providing you faster access to data managed through these gateways.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eTape Gateway enables you to switch from using physical tapes on premises to virtual tapes in AWS without changing your backup workflows, and supports all leading backup applications. With this launch, your on-premises gateway can read tapes in your virtual tape library in AWS 3 times faster than before, at up to 2 Gbps, helping further reduce the time to recover your tapes from AWS.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eFile Gateway provides on-premises applications with file-based, cached access to virtually unlimited cloud storage. With this launch, you can read files from the gateway’s local cache at speeds up to 4.8 Gbps and files from AWS at up to 0.8 Gbps, providing you faster access to data stored in the cache or in AWS. In addition, you can now list directories 4 times faster than before, providing Network File System (NFS) or Server Message Block (SMB) users and applications quicker access to file metadata.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eStorage Gateway is available in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\"\u003e20 AWS regions\u003c/a\u003e, including AWS GovCloud (US-West) and China (Beijing). To \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/Performance.html\"\u003eoptimize your gateway’s performance\u003c/a\u003e, you can continuously \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/Main_monitoring-gateways-common.html#MonitoringGateways-common\"\u003emonitor its throughput\u003c/a\u003e, cache utilization, and access patterns, and accordingly adjust its storage, compute, or network resources. To get started, see \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/create-gateway-vtl.html\"\u003estep-by-step instructions\u003c/a\u003e in the AWS Storage Gateway User Guide.\u003cbr\u003e\n\u003c/p\u003e\n","modifiedDate":"2019-11-20T18:27:17Z","headlineUrl":"/about-aws/whats-new/2019/11/aws-storage-gateway-increases-performance-for-tape-and-file-gateway/","postDateTime":"2019-11-20T10:56:51Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway increases performance for Tape and File Gateway","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e increases performance for reading data from AWS for \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/vtl.html\"\u003eTape Gateway\u003c/a\u003e, and for reading data and listing directories for \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/file.html\"\u003eFile Gateway\u003c/a\u003e, providing you faster access to data managed through these gateways.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-11-aws-storage-gateway-adds-ha-vmware-performance-monitoring-metrics","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/11/aws-storage-gateway-adds-ha-vmware-performance-monitoring-metrics/","dateCreated":"2023-11-09T14:08:53+0000","dateUpdated":"2024-07-25T13:32:42+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e launched high availability (HA) for VMware environments, new reports on gateway performance, and additional options to manage gateway software updates. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eStorage Gateway now provides high availability on VMware through a set of health-checks integrated with VMware vSphere High Availability (VMware HA). With this enhancement, a Storage Gateway deployed in a VMware environment on-premises, or in \u003ca href\u003d\"https://aws.amazon.com/vmware/\"\u003eVMware Cloud on AWS\u003c/a\u003e, will automatically recover from most service interruptions in under 60 seconds. This update protects storage workloads against hardware, hypervisor, or network failures, or software errors, such as connection timeouts and file share or volume unavailability. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eAdditionally, with \u003ca href\u003d\"https://aws.amazon.com/cloudwatch/\"\u003eAmazon CloudWatch\u003c/a\u003e reports embedded into their Storage Gateway Management Console, customers now have ongoing visibility into cache utilization, gateway access patterns, and throughput and I/O metrics, enabling customers to more easily optimize storage, compute, and network resources allocated to their gateways as workloads evolve. The new gateway software maintenance options give customers more granular control over updates to their gateways, which helps them meet uptime requirements of enterprise-wide applications that need to operate without interruption.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThese capabilities are available for new gateways today and will be available for existing gateways in an upcoming update. To learn more visit the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway web page\u003c/a\u003e. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-11-21T20:04:56Z","headlineUrl":"/about-aws/whats-new/2019/11/aws-storage-gateway-adds-ha-vmware-performance-monitoring-metrics/","postDateTime":"2019-11-20T09:01:49Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway adds HA on VMware and new performance monitoring metrics","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e launched high availability (HA) for VMware environments, new reports on gateway performance, and additional options to manage gateway software updates. \u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-09-aws-storage-gateways-tape-gateway-now-available-in-aws-sao-paulo-region","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/09/aws-storage-gateways-tape-gateway-now-available-in-aws-sao-paulo-region/","dateCreated":"2023-11-09T14:14:51+0000","dateUpdated":"2024-07-25T13:31:26+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\"\u003eTape Gateway\u003c/a\u003e, a member of the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e service family, is now available in the AWS South America (Sao Paulo) Region.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eTape Gateway provides you a simple lift-and-shift of existing physical tape-based workflows to virtual tapes in AWS. You connect your existing backup application to a Tape Gateway deployed as a virtual or hardware appliance on your premises. Tape Gateway compresses, encrypts, and moves your tape to a virtual tape library in Amazon S3. When you eject or export a tape through the backup application, Tape Gateway archives that virtual tape from S3 to S3 Glacier or S3 Glacier Deep Archive. You can retrieve a tape archived in S3 Glacier and S3 Glacier Deep Archive to S3, typically within three-to-five hours and twelve hours, respectively.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eTape Gateway is available in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\"\u003e20 AWS regions\u003c/a\u003e, including GovCloud (US-West) and China (Beijing). To get started, see \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/create-gateway-vtl.html\"\u003estep-by-step instructions\u003c/a\u003e in the AWS Storage Gateway User Guide.\u003c/p\u003e\n","modifiedDate":"2019-10-06T05:02:33Z","headlineUrl":"/about-aws/whats-new/2019/09/aws-storage-gateways-tape-gateway-now-available-in-aws-sao-paulo-region/","postDateTime":"2019-09-24T13:29:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway’s Tape Gateway is now available in South America (Sao Paulo)","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/vtl.html\"\u003eTape Gateway\u003c/a\u003e, a member of the \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e service family, is now available in the AWS South America (Sao Paulo) Region.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-09-aws-storage-gateway-adds-amazon-cloudwatch-logging-and-metrics-for-file-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/09/aws-storage-gateway-adds-amazon-cloudwatch-logging-and-metrics-for-file-gateway/","dateCreated":"2023-11-09T14:09:54+0000","dateUpdated":"2024-07-25T13:18:47+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/\"\u003eFile Gateway\u003c/a\u003e, part of the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e service, now publishes health and performance logs and metrics to \u003ca href\u003d\"https://aws.amazon.com/cloudwatch/\"\u003eAmazon CloudWatch\u003c/a\u003e, providing you with continuous visibility into operations of your gateway in order to quickly respond to changes in your workload.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eFile Gateway provides on-premises applications with file-based, cached access to virtually unlimited cloud storage. With this launch, you can configure Amazon CloudWatch Logging to log configuration errors, such as insufficient bucket access privileges, or when applications use the gateway to access files that have transitioned to long-term Amazon S3 storage classes. You can subscribe to these log entries and be notified to correct the errors. Normal operations can be resumed and your file share clients can continue to access their data. You can use the new Amazon CloudWatch metrics to monitor CPU, cache disk, and RAM allocated to your gateway, enabling you to detect performance anomalies, and tune resources before your file share clients are impacted.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eStarting today, when you activate a gateway, you can enable monitoring in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\"\u003eevery region where AWS Storage Gateway is available\u003c/a\u003e. For existing gateways, this new capability will be available through a software update on or before October 9, 2019.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eLearn about \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/monitoring-file-gateway.html\"\u003emonitoring your File Gateway\u003c/a\u003e, and \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway?refid\u003dem_\"\u003etry these new AWS Storage Gateway features today\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-10-06T05:02:28Z","headlineUrl":"/about-aws/whats-new/2019/09/aws-storage-gateway-adds-amazon-cloudwatch-logging-and-metrics-for-file-gateway/","postDateTime":"2019-09-13T12:26:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway adds Amazon CloudWatch logging and metrics for File Gateway","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/file.html\"\u003eFile Gateway\u003c/a\u003e, part of the \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e service, now publishes health and performance logs and metrics to \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/cloudwatch.html\"\u003eAmazon CloudWatch\u003c/a\u003e, providing you with continuous visibility into operations of your gateway in order to quickly respond to changes in your workload.\u003cbr\u003e\n\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-09-aws-storage-gateway-supports-ibm-spectrum-protect-on-linux-and-5-tib-tapes","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/09/aws-storage-gateway-supports-ibm-spectrum-protect-on-linux-and-5-tib-tapes/","dateCreated":"2023-11-09T14:04:39+0000","dateUpdated":"2024-07-25T13:29:09+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\"\u003eTape Gateway\u003c/a\u003e, a member of the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e service family, now supports IBM Spectrum Protect (Tivoli Storage Manager) version 7.1.9 running on Linux. Tape Gateway also increases the maximum supported virtual tape size from 2.5 TiB to 5 TiB to help you store more data on a single tape and ease tape management.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eTape Gateway provides you a simple lift-and-shift of existing physical tape-based workflows to virtual tapes in AWS. You connect your existing backup application to a Tape Gateway deployed as a virtual or hardware appliance on your premises. Tape Gateway compresses, encrypts, and moves your tapes to a virtual tape library in Amazon S3. You can archive your tapes from S3 to S3 Glacier or S3 Glacier Deep Archive. You can retrieve a tape archived in S3 Glacier and S3 Glacier Deep Archive to S3, typically within three-to-five hours and twelve hours, respectively.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eAdditionally, Tape Gateway is compatible with Spectrum Protect version 7.1.9 running on Microsoft Windows. With this announcement, Tape Gateway supports most major backup applications giving you the ability to backup or archive data to AWS without changing your existing backup workflows. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eTape Gateway is available in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\"\u003e19 AWS regions\u003c/a\u003e,\u0026nbsp;including GovCloud (US-West) and China (Beijing). For more information, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/backup-tsm.html\"\u003eTesting Your Gateway Setup\u003c/a\u003e documentation, or see \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/create-gateway-vtl.html\"\u003estep-by-step instructions to get started\u003c/a\u003e in the AWS Storage Gateway User Guide.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-10-06T05:02:24Z","headlineUrl":"/about-aws/whats-new/2019/09/aws-storage-gateway-supports-ibm-spectrum-protect-on-linux-and-5-tib-tapes/","postDateTime":"2019-09-10T12:14:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway supports IBM Spectrum Protect on Linux, and 5 TiB tapes","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/vtl.html\"\u003eTape Gateway\u003c/a\u003e, a member of the \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e service family, now supports IBM Spectrum Protect (Tivoli Storage Manager) version 7.1.9 running on Linux. Tape Gateway also increases the maximum supported virtual tape size from 2.5 TiB to 5 TiB to help you store more data on a single tape and ease tape management.\u003cbr\u003e\n\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-08-aws-storage-gateway-now-available-in-asia-pacific","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/08/aws-storage-gateway-now-available-in-asia-pacific/","dateCreated":"2023-11-09T14:06:19+0000","dateUpdated":"2024-07-25T13:15:48+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e is now available in the AWS Asia Pacific (Hong Kong) Region. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eStorage Gateway is a hybrid cloud storage service that gives on-premises applications access to virtually unlimited AWS storage. Customers use the service to simplify storage management and reduce costs through key hybrid cloud storage use cases. These include moving backup and archiving to the cloud, reducing on-premises storage with cloud-backed file shares, and providing low-latency access to data in AWS.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eStorage Gateway is now available in available in \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/available-regions-intro.html\"\u003esix AWS Regions in Asia Pacific and twenty regions worldwide\u003c/a\u003e. Please visit our \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eproduct page\u003c/a\u003e for more information, or \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway\"\u003eget started in the AWS Console\u003c/a\u003e. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-10-06T05:02:01Z","headlineUrl":"/about-aws/whats-new/2019/08/aws-storage-gateway-now-available-in-asia-pacific/","postDateTime":"2019-08-14T17:12:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway is now available in Asia Pacific (Hong Kong)","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e is now available in the AWS Asia Pacific (Hong Kong) Region. \u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-08-aws-storage-gateway-now-supports-tag-on-create-and-tag-based-access-control","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/08/aws-storage-gateway-now-supports-tag-on-create-and-tag-based-access-control/","dateCreated":"2023-11-09T14:13:52+0000","dateUpdated":"2024-07-25T13:25:13+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e now supports adding tags at the time of resource creation, and tag-based access control. You can assign tags to all Storage Gateway resources including gateways, file shares, volumes, volume snapshots, and tapes when creating them. You can also define fine-grained access controls using tags and AWS Identity and Access Management (IAM) policies to control access to resources and actions. Tags are simple key-value pairs that you can assign to resources to  easily organize, search, and identify resources, create cost allocation  reports, and control access to resources.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eStorage Gateway is a hybrid cloud storage service that provides on-premises applications access to virtually unlimited cloud storage using NFS, SMB, iSCSI, and iSCSI-VTL interfaces. You can use the service for backing up and archiving data to AWS, shifting on-premises storage to cloud-backed file shares, and providing low-latency access to in cloud for on-premises applications.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eClick \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/tagging-resources-common.html\"\u003ehere\u003c/a\u003e to learn more on how to tag Storage Gateway resources and set tag-based access control policies using AWS Management Console, CLI, or SDK.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-10-06T05:02:00Z","headlineUrl":"/about-aws/whats-new/2019/08/aws-storage-gateway-now-supports-tag-on-create-and-tag-based-access-control/","postDateTime":"2019-08-13T13:01:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway now supports tag-on-create and tag-based access control","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e now supports adding tags at the time of resource creation, and tag-based access control. You can assign tags to all Storage Gateway resources including gateways, file shares, volumes, volume snapshots, and tapes when creating them. You can also define fine-grained access controls using tags and AWS Identity and Access Management (IAM) policies to control access to resources and actions. Tags are simple key-value pairs that you can assign to resources to  easily organize, search, and identify resources, create cost allocation  reports, and control access to resources.\u003cbr\u003e\n\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-08-amazon-workdocs-migration-service","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/08/amazon_workdocs_migration_service/","dateCreated":"2023-11-09T14:09:57+0000","dateUpdated":"2024-07-25T13:24:42+0000","additionalFields":{"postBody":"\u003cp\u003eAmazon WorkDocs is making generally available a migration service to help you migrate your organization\u0027s files to Amazon WorkDocs.\u003c/p\u003e\n\u003cp\u003eThe Amazon WorkDocs migration service helps you move your users\u0027 files and your departmental file shares to Amazon WorkDocs. The service can migrate large amounts of data, from tens of gigabytes to multiple terabytes from \u003ca href\u003d\"https://aws.amazon.com/s3/\" target\u003d\"_blank\"\u003eAmazon Simple Storage Service (S3)\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eUsing the Amazon WorkDocs migration service application, you can configure migration tasks, and target WorkDocs account and site to migrate data to. You can schedule the migration task to execute during a specific period as a one-time data transfer operation or have regular migrations so as to minimize downtime for your users. The migration service application provides up-to-date information and status on migration jobs including detailed reports once migration has successfully completed. The migration service application can be used by administrators of Amazon WorkDocs sites.\u003c/p\u003e\n\u003cp\u003eFor file migration from network file shares, Amazon WorkDocs migration service leverages \u003ca href\u003d\"https://aws.amazon.com/datasync/\" target\u003d\"_blank\"\u003eAWS DataSync\u003c/a\u003e which automatically handles many of the tasks related to data transfers such as network optimization and data integrity validation, which can slow down migrations or burden your IT operations. For more information about Amazon WorkDocs Migration Service see the \u003ca href\u003d\"https://docs.aws.amazon.com/workdocs/latest/adminguide/migration.html\" target\u003d\"_blank\"\u003eAmazon WorkDocs Administration Guide\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-10-06T05:01:58Z","headlineUrl":"/about-aws/whats-new/2019/08/amazon_workdocs_migration_service/","postDateTime":"2019-08-09T13:00:00Z","contentType":"Launch Announcement","headline":"Amazon WorkDocs Migration Service","postSummary":"\u003cp\u003eAmazon WorkDocs is making generally available a migration service to help you migrate your organization\u0027s files to Amazon WorkDocs.\u003c/p\u003e\n\u003cp\u003eThe Amazon WorkDocs migration service helps you move your users\u0027 files and your departmental file shares to Amazon WorkDocs. The service can migrate large amounts of data, from tens of gigabytes to multiple terabytes from \u003ca href\u003d\"https://aws.amazon.com/s3/\" target\u003d\"_blank\"\u003eAmazon Simple Storage Service (S3)\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eUsing the Amazon WorkDocs migration service application, you can configure migration tasks, and target WorkDocs account and site to migrate data to. You can schedule the migration task to execute during a specific period as a one-time data transfer operation or have regular migrations so as to minimize downtime for your users. The migration service application provides up-to-date information and status on migration jobs including detailed reports once migration has successfully completed. The migration service application can be used by administrators of Amazon WorkDocs sites.\u003c/p\u003e\n\u003cp\u003eFor file migration from network file shares, Amazon WorkDocs migration service leverages \u003ca href\u003d\"https://aws.amazon.com/datasync/\" target\u003d\"_blank\"\u003eAWS DataSync\u003c/a\u003e which automatically handles many of the tasks related to data transfers such as network optimization and data integrity validation, which can slow down migrations or burden your IT operations. For more information about Amazon WorkDocs Migration Service see the \u003ca href\u003d\"https://docs.aws.amazon.com/workdocs/latest/adminguide/migration.html\" target\u003d\"_blank\"\u003eAmazon WorkDocs Administration Guide\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#marketing#migration-to-aws","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing","name":"migration-to-aws","description":"marketing:migration-to-aws","dateCreated":"2023-11-09T13:55:33+0000","dateUpdated":"2023-11-09T13:55:33+0000"},{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"},{"id":"whats-new-v2#general-products#amazon-s3","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-s3","description":"general:products/amazon-s3","dateCreated":"2023-11-09T13:53:07+0000","dateUpdated":"2023-11-09T13:53:07+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#general-products#amazon-workspaces","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-workspaces","description":"general:products/amazon-workspaces","dateCreated":"2023-11-09T13:54:29+0000","dateUpdated":"2023-11-09T13:54:29+0000"},{"id":"whats-new-v2#general-products#aws-datasync","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-datasync","description":"general:products/aws-datasync","dateCreated":"2023-11-09T13:57:10+0000","dateUpdated":"2023-11-09T13:57:10+0000"},{"id":"whats-new-v2#general-products#amazon-simple-storage-service","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-simple-storage-service","description":"general:products/amazon-simple-storage-service","dateCreated":"2023-11-09T13:57:06+0000","dateUpdated":"2023-11-09T13:57:06+0000"},{"id":"whats-new-v2#general-products#amazon-workdocs","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-workdocs","description":"general:products/amazon-workdocs","dateCreated":"2023-11-09T13:54:41+0000","dateUpdated":"2023-11-09T13:54:41+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-06-file-gateway-adds-options-to-enforce-encryption-and-signing-for-smb-shares","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/06/file-gateway-adds-options-to-enforce-encryption-and-signing-for-smb-shares/","dateCreated":"2023-11-09T14:11:43+0000","dateUpdated":"2024-07-25T13:14:21+0000","additionalFields":{"postBody":"\u003cp\u003eAWS Storage Gateway now supports security level options for data transferred between the File Gateway and SMB clients. You can enforce encryption and signing on client requests, or use client-negotiated defaults, helping you meet organizational requirements for security and client compatibility.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/\"\u003eFile Gateway\u003c/a\u003e provides on-premises applications file-based, cached access to virtually unlimited cloud storage in Amazon S3. With this launch, you have three options for securing data between your SMB clients and gateway’s file shares: \u003ci\u003eEnforce Encryption\u003c/i\u003e, \u003ci\u003eEnforce Signing\u003c/i\u003e and \u003ci\u003eClient Negotiated\u003c/i\u003e. For environments where you only want to accept encrypted or signed requests, you can use the \u003ci\u003eEnforce Encryption\u003c/i\u003e or \u003ci\u003eEnforce Signing\u003c/i\u003e options. To expand applicability to a broader range of Windows operating systems and SMB clients, you can select the \u003ci\u003eClient Negotiated\u003c/i\u003e option. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThis feature is available \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\"\u003ein every region where AWS Storage Gateway is available\u003c/a\u003e. Starting today, you can configure these options for file shares on new gateways. For existing gateways, a software update will be made available in the console by July 21st, 2019, and it will be applied during your gateway’s maintenance window.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eLearn about \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/managing-gateway-file.html#security-strategy\"\u003ethe security level options here\u003c/a\u003e, and \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway?refid\u003dem_\"\u003etry these new AWS Storage Gateway features today\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-10-06T05:01:22Z","headlineUrl":"/about-aws/whats-new/2019/06/file-gateway-adds-options-to-enforce-encryption-and-signing-for-smb-shares/","postDateTime":"2019-06-24T11:33:00Z","contentType":"Launch Announcement","headline":"File Gateway adds options to enforce encryption and signing for SMB shares","postSummary":"\u003cp\u003eAWS Storage Gateway now supports security level options for data transferred between the File Gateway and SMB clients. You can enforce encryption and signing on client requests, or use client-negotiated defaults, helping you meet organizational requirements for security and client compatibility.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-06-aws-storage-gateway-now-supports-amazon-vpc-endpoints-aws-privatelink","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/06/aws-storage-gateway-now-supports-amazon-vpc-endpoints-aws-privatelink/","dateCreated":"2023-11-09T14:12:09+0000","dateUpdated":"2024-07-25T13:27:45+0000","additionalFields":{"postBody":"\u003cp\u003eCustomers can now use \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e to provide hybrid cloud storage through their \u003ca href\u003d\"https://aws.amazon.com/vpc/\"\u003eAmazon Virtual Private Cloud\u003c/a\u003e (Amazon VPC) using VPC endpoints. With this feature, the network connection between an on-premises Storage Gateway appliance and AWS can be restricted to private network routes, further securing storage workloads and administration activities. VPC endpoints for Storage Gateway are provided by \u003ca href\u003d\"https://aws.amazon.com/privatelink/\"\u003eAWS PrivateLink\u003c/a\u003e, a highly available, scalable technology that enables customers to privately connect their VPC to supported AWS services.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eAWS Storage Gateway is a hybrid cloud storage service that gives customers on-premises access to virtually unlimited cloud storage via virtual tape libraries, iSCSI volumes, and SMB and NFS file shares. Support for VPC endpoints enables customers to deploy Storage Gateway virtual machines and hardware appliances within private networks without opening up connections to the internet, increasing the security of Storage Gateway’s connection to Amazon S3 and other AWS services. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eCustomers can get started using Storage Gateway with PrivateLink today by deploying a new gateway using any gateway virtual machine (VM) image released after June 20, 2019. Using the AWS Console or CLI, users will be able to specify whether the gateway should connect to AWS over the internet or from within their VPC. VPC endpoints are configured during gateway creation, and once configured, all traffic to AWS from the VPC will flow over a private connection. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThis feature can be used in all regions where \u003ca href\u003d\"https://docs.aws.amazon.com/general/latest/gr/rande.html#sg_region\"\u003eAWS Storage Gateway is available\u003c/a\u003e. To learn more, visit the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway website\u003c/a\u003e, or get started in the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/home\"\u003eAWS Console\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-10-06T05:01:20Z","headlineUrl":"/about-aws/whats-new/2019/06/aws-storage-gateway-now-supports-amazon-vpc-endpoints-aws-privatelink/","postDateTime":"2019-06-20T15:39:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway now supports Amazon VPC endpoints with AWS PrivateLink","postSummary":"\u003cp\u003eCustomers can now use \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e to provide hybrid cloud storage through their \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/vpc.html\"\u003eAmazon Virtual Private Cloud\u003c/a\u003e (Amazon VPC) using VPC endpoints. With this feature, the network connection between an on-premises Storage Gateway appliance and AWS can be restricted to private network routes, further securing storage workloads and administration activities. VPC endpoints for Storage Gateway are provided by \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/privatelink.html\"\u003eAWS PrivateLink\u003c/a\u003e, a highly available, scalable technology that enables customers to privately connect their VPC to supported AWS services.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-05-aws-storage-gateway-service-adds-capability-move-virtual-tapes-from-amazon-s3-glacier-to-amazon-s3-glacier-deep-archive","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/05/aws-storage-gateway-service-adds-capability-move-virtual-tapes-from-amazon-s3-glacier-to-amazon-s3-glacier-deep-archive/","dateCreated":"2023-11-09T14:11:22+0000","dateUpdated":"2024-07-25T13:23:31+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\"\u003eTape Gateway\u003c/a\u003e, a member of the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e service family, adds capability to move your virtual tapes archived in Amazon S3 Glacier to Amazon S3 Glacier Deep Archive storage class, enabling you to further reduce the monthly cost to store long-term data in the cloud by up to 75%. S3 Glacier Deep Archive is a new S3 storage class that provides secure, durable object storage for long-term data retention and digital preservation. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eTape Gateway helps you move tape-based backups to AWS without making any changes to your existing backup workflows. You connect your existing backup application to a Tape Gateway deployed as a virtual or hardware appliance on your premises. Tape Gateway compresses, encrypts, and moves your tapes to a virtual tape library in Amazon S3. You can archive your tapes from S3 to S3 Glacier or S3 Glacier Deep Archive, and move tapes archived in S3 Glacier to S3 Glacier Deep Archive. You can retrieve your tapes archived in S3 Glacier and S3 Glacier Deep Archive to S3, in three-to-five hours and within twelve hours, respectively.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eStarting today, you can move a virtual tape archived in S3 Glacier to S3 Glacier Deep Archive using assign tape option in Tapes view of AWS Storage Gateway Console or AssignTapePool API.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eTape Gateway is available in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\"\u003e18 AWS regions\u003c/a\u003e, including GovCloud (US) and China (Beijing). For more information, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/GettingStartedTestGatewayVTL.html\"\u003eTesting Your Gateway Setup\u003c/a\u003e documentation, or see \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/create-gateway-vtl.html\"\u003estep-by-step instructions to get started\u003c/a\u003e in the AWS Storage Gateway User Guide.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003e  \u003cbr\u003e\n\u003c/p\u003e\n","modifiedDate":"2020-07-23T21:10:00Z","headlineUrl":"/about-aws/whats-new/2019/05/aws-storage-gateway-service-adds-capability-move-virtual-tapes-from-amazon-s3-glacier-to-amazon-s3-glacier-deep-archive/","postDateTime":"2019-05-28T13:30:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway Service Adds Capability to Move Virtual Tapes from Amazon S3 Glacier to Amazon S3 Glacier Deep Archive","postSummary":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\"\u003eTape Gateway\u003c/a\u003e, a member of the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e service family, adds capability to move your virtual tapes archived in Amazon S3 Glacier to Amazon S3 Glacier Deep Archive storage class, enabling you to further reduce the monthly cost to store long-term data in the cloud by up to 75%. S3 Glacier Deep Archive is a new S3 storage class that provides secure, durable object storage for long-term data retention and digital preservation. \u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"},{"id":"whats-new-v2#general-products#amazon-s3","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-s3","description":"general:products/amazon-s3","dateCreated":"2023-11-09T13:53:07+0000","dateUpdated":"2023-11-09T13:53:07+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#general-products#amazon-simple-storage-service","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-simple-storage-service","description":"general:products/amazon-simple-storage-service","dateCreated":"2023-11-09T13:57:06+0000","dateUpdated":"2023-11-09T13:57:06+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-05-aws-storage-gateway-enhances-access-control-for-smb-shares-to-access-objects-in-amazon-s3","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/05/AWS-Storage-Gateway-enhances-access-control-for-SMB-shares-to-access-objects-in-Amazon-s3/","dateCreated":"2023-11-09T14:04:48+0000","dateUpdated":"2024-07-25T13:35:44+0000","additionalFields":{"postBody":"\u003cp\u003eThe AWS Storage Gateway service added support for Access Control Lists (ACLs) to Server Message Block (SMB) shares on the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/\"\u003eFile Gateway\u003c/a\u003e, helping enforce data security standards when using the gateway for storing and accessing data in Amazon Simple Storage Service (S3). With this launch, you can apply Windows permissions and ownerships for up to 10 Access Control Entries (ACE), enabling you to provide fine grained access controls on individual files and folders in your gateway’s file share. Each ACE specifies Windows permissions and ownership for an Active Directory (AD) user or group. File Gateway offers SMB and Network File System (NFS) based access for on-premises applications to objects in Amazon S3. Through its local caching, optimized data transfer capabilities, and Amazon CloudWatch Events integrations, File Gateway enables automated hybrid cloud workflows, content distribution, backup, and data archival in Amazon S3. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eYou can create file shares on new File Gateways and enable SMB ACLs in every region where \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\"\u003eAWS Storage Gateway is available\u003c/a\u003e. To use this feature with file shares on existing gateways, a software update will be made generally available by May 29nd, 2019. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eLearn about using SMB ACLs \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/smb-acl.html\"\u003ehere\u003c/a\u003e, and \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/\"\u003etry these new AWS Storage Gateway features today.\u003c/a\u003e \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-07-23T21:10:06Z","headlineUrl":"/about-aws/whats-new/2019/05/AWS-Storage-Gateway-enhances-access-control-for-SMB-shares-to-access-objects-in-Amazon-s3/","postDateTime":"2019-05-08T20:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway enhances access control for SMB shares to store and access objects in Amazon S3 buckets","postSummary":"\u003cp\u003eThe AWS Storage Gateway service added support for Access Control Lists (ACLs) to Server Message Block (SMB) shares on the \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/file.html\"\u003eFile Gateway\u003c/a\u003e, helping enforce data security standards when using the gateway for storing and accessing data in Amazon Simple Storage Service (S3). With this launch, you can apply Windows permissions and ownerships for up to 10 Access Control Entries (ACE), enabling you to provide fine grained access controls on individual files and folders in your gateway’s file share. Each ACE specifies Windows permissions and ownership for an Active Directory (AD) user or group. File Gateway offers SMB and Network File System (NFS) based access for on-premises applications to objects in Amazon S3. Through its local caching, optimized data transfer capabilities, and Amazon CloudWatch Events integrations, File Gateway enables automated hybrid cloud workflows, content distribution, backup, and data archival in Amazon S3. \u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#general-products#aws-govcloud-us","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-govcloud-us","description":"general:products/aws-govcloud-us","dateCreated":"2023-11-07T18:41:18+0000","dateUpdated":"2023-11-07T18:41:18+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#amazon-simple-storage-service","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-simple-storage-service","description":"general:products/amazon-simple-storage-service","dateCreated":"2023-11-09T13:57:06+0000","dateUpdated":"2023-11-09T13:57:06+0000"},{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"},{"id":"whats-new-v2#general-products#amazon-s3","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-s3","description":"general:products/amazon-s3","dateCreated":"2023-11-09T13:53:07+0000","dateUpdated":"2023-11-09T13:53:07+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-04-introducing-aws-backup","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/04/introducing-aws-backup/","dateCreated":"2023-11-09T14:10:00+0000","dateUpdated":"2024-07-25T13:27:10+0000","additionalFields":{"postBody":"\u003cp\u003eAWS Backup is now available in the AWS Asia Pacific (Sydney) and EU (Frankfurt) Regions. \u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eAWS Backup is a fully managed backup service that makes it easy to centralize and automate the back up of data across AWS services in the cloud as well as on premises. With AWS Backup, protecting your AWS resources, such as Amazon EFS file systems, is as easy as a few clicks in the AWS Backup console. Customers can configure and audit the AWS resources they want to back up, automate backup scheduling, set retention policies, and monitor all recent backup and restore activity.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eUsing AWS Backup, you can centrally configure backup policies and monitor backup activity for AWS resources, such as Amazon EBS volumes, Amazon RDS databases, Amazon DynamoDB tables, Amazon EFS file systems, and AWS Storage Gateway volumes. AWS Backup provides a fully managed, policy-based backup solution, simplifying your backup management, enabling you to meet your business and regulatory backup compliance requirements. As customers build their applications in the AWS Cloud, data can become distributed across multiple AWS services, including database services, block storage, object storage, and file systems. While these services have backup capabilities, customers often create custom scripts to automate backup scheduling, enforce retention policies, and consolidate backup activity across AWS services.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eAWS Backup is available in the US East (Northern Virginia), US East (Ohio), US West (Oregon), EU (Frankfurt), EU (Ireland), and Asia Pacific (Sydney) Regions.\u0026nbsp;For more information on where AWS Backup is available, see the \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eAWS region table\u003c/a\u003e. Learn more on the \u003ca href\u003d\"https://aws.amazon.com/backup/\" target\u003d\"_blank\"\u003eAWS Backup\u003c/a\u003e page and the latest \u003ca href\u003d\"https://aws.amazon.com/blogs/aws/aws-backup-automate-and-centrally-manage-your-backups/\" target\u003d\"_blank\"\u003eblog\u003c/a\u003e.\u003c/p\u003e\n","modifiedDate":"2019-10-06T05:00:07Z","headlineUrl":"/about-aws/whats-new/2019/04/introducing-aws-backup/","postDateTime":"2019-04-04T08:00:00Z","contentType":"Launch Announcement","headline":"AWS Backup is Now Available in the AWS Asia Pacific (Sydney) and EU (Frankfurt) Regions","postSummary":"\u003cp\u003eAWS Backup is now available in the AWS Asia Pacific (Sydney) and EU (Frankfurt) Regions. \u003cbr\u003e\n\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#amazon-elastic-block-store","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-elastic-block-store","description":"general:products/amazon-elastic-block-store","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#general-products#aws-backup","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-backup","description":"general:products/aws-backup","dateCreated":"2023-11-09T13:50:45+0000","dateUpdated":"2023-11-09T13:50:45+0000"},{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"},{"id":"whats-new-v2#general-products#amazon-efs","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-efs","description":"general:products/amazon-efs","dateCreated":"2023-11-09T13:54:44+0000","dateUpdated":"2023-11-09T13:54:44+0000"},{"id":"whats-new-v2#general-products#amazon-rds","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-rds","description":"general:products/amazon-rds","dateCreated":"2023-11-07T22:38:13+0000","dateUpdated":"2023-11-07T22:38:13+0000"},{"id":"whats-new-v2#general-products#amazon-dynamodb","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-dynamodb","description":"general:products/amazon-dynamodb","dateCreated":"2023-11-09T13:53:06+0000","dateUpdated":"2023-11-09T13:53:06+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-03-s3-glacier-deep-archive","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/03/S3-glacier-deep-archive/","dateCreated":"2023-11-09T14:06:57+0000","dateUpdated":"2024-07-25T13:13:25+0000","additionalFields":{"postBody":"\u003cp\u003eAmazon Web Services is announcing the general availability of Amazon S3 Glacier Deep Archive, a new Amazon S3 storage class providing secure and durable object storage for long-term retention of data that is accessed rarely in a year. From just $0.00099 per GB-month (less than one-tenth of one cent, or about $1 per TB-month), S3 Glacier Deep Archive offers the lowest cost storage in the cloud, at prices lower than storing and maintaining data in on-premises magnetic tape libraries or archiving data offsite. To get started with S3 Glacier Deep Archive visit: \u003ca href\u003d\"https://aws.amazon.com/s3/storage-classes/\" target\u003d\"_blank\"\u003ehttps://aws.amazon.com/s3/storage-classes/\u003c/a\u003e.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eAll objects stored in the S3 Glacier Deep Archive storage class are replicated and stored across at least three geographically-dispersed Availability Zones, protected by 99.999999999% durability, and can be restored within 12 hours or less. S3 Glacier Deep Archive also offers a bulk retrieval option, where you can retrieve petabytes of data within 48 hours. With seven different storage class options, Amazon S3 provides the broadest array of cost-optimization options available in the cloud today. S3 Glacier Deep Archive expands our data archiving offerings, enabling you to select the optimal storage class based on storage and retrieval costs, and retrieval times. Choose S3 Glacier when you want retrieval options in minutes for archived data. Choose S3 Glacier Deep Archive when you want the lowest storage cost for archived data that is accessed at most once or twice a year, and you are willing to accept 12 or 48 hour latencies to first byte. S3 Glacier Deep Archive is very easy to use and requires minor configuration changes if you are already familiar with and using the S3 Glacier storage class. S3 Glacier Deep Archive is fully integrated with S3 features including S3 Storage Class Analysis, S3 Object Tagging, \u003ca href\u003d\"https://docs.aws.amazon.com/AmazonS3/latest/dev/lifecycle-transition-general-considerations.html\" target\u003d\"_blank\"\u003eS3 Lifecycle policies\u003c/a\u003e, S3 Object Lock, Cross-Region Replication, and server-side encryption, including customer-managed keys.\u003c/p\u003e\n\u003cp\u003eTo \u003ca href\u003d\"https://docs.aws.amazon.com/AmazonS3/latest/dev/restoring-objects.html\" target\u003d\"_blank\"\u003eretrieve data stored in S3 Glacier Deep Archive\u003c/a\u003e, you can initiate a “Restore” request using the Amazon S3 APIs or the Amazon S3 Management Console. The Restore creates a temporary copy of your data in the S3 RRS storage class while leaving the archived data intact in S3 Glacier Deep Archive. You can specify the amount of time in days for which the temporary copy is stored in S3. You can then access your temporary copy from S3 through an Amazon S3 GET request on the archived object.\u003c/p\u003e\n\u003cp\u003eThe easiest way to store data in S3 Glacier Deep Archive is to use the S3 PUT API to upload data directly. You can also upload data to S3 Glacier Deep Archive over the Internet or using AWS Direct Connect and the AWS Management Console, AWS Storage Gateway, AWS Command Line Interface, or the AWS Software Development Kit. S3 Glacier Deep Archive is integrated with \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\" target\u003d\"_blank\"\u003eTape Gateway\u003c/a\u003e, a cloud-based virtual tape library feature of AWS Storage Gateway. With this capability, you can now manage your on-premises tape-based backups and reduce monthly storage costs by choosing to archive your new virtual tapes in either the S3 Glacier or S3 Glacier Deep Archive storage classes.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eThe \u003ca href\u003d\"https://aws.amazon.com/s3/storage-classes/\" target\u003d\"_blank\"\u003eAmazon S3 Glacier Deep Archive storage class\u003c/a\u003e is now generally available in all commercial AWS Regions and \u003ca href\u003d\"https://aws.amazon.com/govcloud-us/\" target\u003d\"_blank\"\u003eAWS GovCloud (US)\u003c/a\u003e. To learn more about S3 Glacier Deep Archive, please visit \u003ca href\u003d\"https://aws.amazon.com/blogs/aws/new-amazon-s3-storage-class-glacier-deep-archive/\" target\u003d\"_blank\"\u003eJeff Barr’s News blog\u003c/a\u003e and the \u003ca href\u003d\"https://docs.aws.amazon.com/AmazonS3/latest/dev/storage-class-intro.html\" target\u003d\"_blank\"\u003eAmazon S3 Developer Guide, Storage Classes\u003c/a\u003e. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-07-23T21:10:32Z","headlineUrl":"/about-aws/whats-new/2019/03/S3-glacier-deep-archive/","postDateTime":"2019-03-27T11:30:00Z","contentType":"Launch Announcement","headline":"AWS Announces the General Availability of the Amazon S3 Glacier Deep Archive Storage Class in all Commercial AWS Regions and AWS GovCloud (US)","postSummary":"\u003cp\u003eAmazon Web Services is announcing the general availability of Amazon S3 Glacier Deep Archive, a new Amazon S3 storage class providing secure and durable object storage for long-term retention of data that is accessed rarely in a year. From just $0.00099 per GB-month (less than one-tenth of one cent, or about $1 per TB-month), S3 Glacier Deep Archive offers the lowest cost storage in the cloud, at prices lower than storing and maintaining data in on-premises magnetic tape libraries or archiving data offsite. To get started with S3 Glacier Deep Archive visit: \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/s3/storage-classes.html\" target\u003d\"_blank\"\u003ehttps://aws.amazon.com/s3/storage-classes/\u003c/a\u003e.\u003cbr\u003e\n\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"},{"id":"whats-new-v2#general-products#aws-govcloud-us","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-govcloud-us","description":"general:products/aws-govcloud-us","dateCreated":"2023-11-07T18:41:18+0000","dateUpdated":"2023-11-07T18:41:18+0000"},{"id":"whats-new-v2#general-products#amazon-simple-storage-service","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-simple-storage-service","description":"general:products/amazon-simple-storage-service","dateCreated":"2023-11-09T13:57:06+0000","dateUpdated":"2023-11-09T13:57:06+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#general-products#amazon-s3","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-s3","description":"general:products/amazon-s3","dateCreated":"2023-11-09T13:53:07+0000","dateUpdated":"2023-11-09T13:53:07+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-03-aws-storage-gateway-service-integrates-tape-gateway-with-amazon-s3-glacier-deeparchive-storage-class","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/03/aws-storage-gateway-service-integrates-tape-gateway-with-amazon-s3-glacier-deeparchive-storage-class/","dateCreated":"2023-11-09T14:00:51+0000","dateUpdated":"2024-07-25T13:11:49+0000","additionalFields":{"postBody":"\u003cp\u003eThe \u003ca href\u003d\"https://aws.amazon.com/storagegateway/features/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e service now integrates \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\" target\u003d\"_blank\"\u003eTape Gateway\u003c/a\u003e with Amazon S3 Glacier Deep Archive storage class, allowing you to store virtual tapes in the lowest-cost Amazon S3 storage class, reducing the monthly cost to store your long-term data in the cloud by up to 75%. S3 Glacier Deep Archive is a new S3 storage class that provides secure, durable object storage for long-term data retention and digital preservation. With this feature, Tape Gateway supports archiving your new virtual tapes directly to S3 Glacier and S3 Glacier Deep Archive, helping you meet your backup, archive, and recovery requirements.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eTape Gateway helps you move tape-based backups to AWS without making any changes to your existing backup workflows. You connect your existing backup application to a virtual tape library on the Tape Gateway (deployed as a virtual or hardware appliance). Tape Gateway compresses, encrypts, and moves your tapes to a virtual tape library in Amazon S3. You can archive your tapes in virtual tape library to S3 Glacier and S3 Glacier Deep Archive. The cache on the tape gateway ensures recent backups remain local, reducing restore times. You can retrieve your tapes archived in S3 Glacier and S3 Glacier Deep Archive to S3, in three-to-five hours and within twelve hours, respectively.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eTo get started, create a new virtual tape using AWS Storage Gateway Console or API, and set the archival storage pool either to Glacier Pool or Deep Archive Pool. When your backup application ejects the tape, the tape will be archived to your selected storage pool.\u003c/p\u003e\n\u003cp\u003eTape Gateway is available in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003e18 AWS regions\u003c/a\u003e, including AWS GovCloud (US) and China (Beijing). For more information, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/GettingStartedTestGatewayVTL.html\" target\u003d\"_blank\"\u003eTesting Your Gateway Setup\u003c/a\u003e documentation, or see \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/create-gateway-vtl.html\" target\u003d\"_blank\"\u003estep-by-step instructions to get started\u003c/a\u003e in the AWS Storage Gateway User Guide.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2020-07-23T21:10:24Z","headlineUrl":"/about-aws/whats-new/2019/03/aws-storage-gateway-service-integrates-tape-gateway-with-amazon-s3-glacier-deeparchive-storage-class/","postDateTime":"2019-03-27T11:30:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway Service Integrates Tape Gateway with Amazon S3 Glacier Deep Archive Storage Class","postSummary":"\u003cp\u003eThe \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/features.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e service now integrates \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/vtl.html\" target\u003d\"_blank\"\u003eTape Gateway\u003c/a\u003e with Amazon S3 Glacier Deep Archive storage class, allowing you to store virtual tapes in the lowest-cost Amazon S3 storage class, reducing the monthly cost to store your long-term data in the cloud by up to 75%. S3 Glacier Deep Archive is a new S3 storage class that provides secure, durable object storage for long-term data retention and digital preservation. With this feature, Tape Gateway supports archiving your new virtual tapes directly to S3 Glacier and S3 Glacier Deep Archive, helping you meet your backup, archive, and recovery requirements.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#amazon-simple-storage-service","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-simple-storage-service","description":"general:products/amazon-simple-storage-service","dateCreated":"2023-11-09T13:57:06+0000","dateUpdated":"2023-11-09T13:57:06+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#general-products#aws-govcloud-us","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-govcloud-us","description":"general:products/aws-govcloud-us","dateCreated":"2023-11-07T18:41:18+0000","dateUpdated":"2023-11-07T18:41:18+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"},{"id":"whats-new-v2#general-products#amazon-s3","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-s3","description":"general:products/amazon-s3","dateCreated":"2023-11-09T13:53:07+0000","dateUpdated":"2023-11-09T13:53:07+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-03-file-gateway-supports-amazon-s3-object-lock","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/03/file-gateway-supports-amazon-s3-object-lock/","dateCreated":"2023-11-09T14:15:34+0000","dateUpdated":"2024-05-01T01:11:59+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e added support for \u003ca href\u003d\"https://docs.aws.amazon.com/AmazonS3/latest/dev/object-lock-overview.html\"\u003eAmazon S3 Object Lock\u003c/a\u003e to File Gateway, enabling write-once-read-many (WORM) file-based systems to store and access objects in Amazon S3, using Object Lock’s Compliance or Governance modes.\u003c/p\u003e\n\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/file.html\"\u003eFile Gateway\u003c/a\u003e enables on-premises applications to access objects in Amazon S3 as files, through a local gateway deployed as a virtual or a \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/hardware-appliance.html\"\u003ehardware appliance\u003c/a\u003e. When you \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/GettingStartedCreateFileShare.html\"\u003ecreate a new file share\u003c/a\u003e or \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/managing-gateway-file.html\"\u003eupdate an existing one\u003c/a\u003e, you can configure it to use a bucket enabled for Amazon S3 Object Lock. Any modifications such as file edits, deletes or renames from the gateway’s NFS or SMB clients are stored as new versions of the object, without overwriting or deleting previous versions. This leaves the original, locked version of the object unchanged, enabling you to enforce policies as an added layer of data protection or for regulatory compliance.\u003c/p\u003e\n\u003cp\u003eThis new feature is available in all regions where \u003ca href\u003d\"https://docs.aws.amazon.com/general/latest/gr/rande.html#sg_region\"\u003eAWS Storage Gateway is available\u003c/a\u003e. To learn more about using File Gateway with Amazon S3 Object Lock, please visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/managing-gateway-file.html#s3-object-lock\"\u003eAWS Storage Gateway documentation\u003c/a\u003e or the whitepaper on \u003ca href\u003d\"https://d1.awsstatic.com/whitepapers/aws-storage-gateway-file-gateway-for-hybrid-architectures.pdf\"\u003eFile Gateway for Hybrid Architectures\u003c/a\u003e.\u003c/p\u003e\n","modifiedDate":"2020-07-23T21:10:37Z","headlineUrl":"/about-aws/whats-new/2019/03/file-gateway-supports-amazon-s3-object-lock/","postDateTime":"2019-03-21T18:18:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway adds support for Amazon S3 Object Lock to File Gateway","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e added support for \u003ca href\u003d\"https://docs.aws.amazon.com/AmazonS3/latest/dev/object-lock-overview.html\"\u003eAmazon S3 Object Lock\u003c/a\u003e to File Gateway, enabling write-once-read-many (WORM) file-based systems to store and access objects in Amazon S3, using Object Lock’s Compliance or Governance modes.\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"},{"id":"whats-new-v2#general-products#amazon-s3","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-s3","description":"general:products/amazon-s3","dateCreated":"2023-11-09T13:53:07+0000","dateUpdated":"2023-11-09T13:53:07+0000"},{"id":"whats-new-v2#general#products","locale":"en_US","tagNamespaceId":"whats-new-v2#general","name":"products","description":"general:products","dateCreated":"2023-11-09T13:59:34+0000","dateUpdated":"2023-11-09T13:59:34+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#general-products#amazon-simple-storage-service","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-simple-storage-service","description":"general:products/amazon-simple-storage-service","dateCreated":"2023-11-09T13:57:06+0000","dateUpdated":"2023-11-09T13:57:06+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-02-aws-storage-gateway-hw-appliance-eu-availability-and-storage-and-networking-options","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/02/aws-storage-gateway-hw-appliance-eu-availability-and-storage-and-networking-options/","dateCreated":"2023-11-09T14:15:49+0000","dateUpdated":"2024-07-25T13:34:04+0000","additionalFields":{"postBody":"\u003cp\u003eYou can now order and use the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e \u003ca href\u003d\"https://aws.amazon.com/storagegateway/hardware-appliance/\" target\u003d\"_blank\"\u003ehardware appliance\u003c/a\u003e in Europe, expand an appliance’s usable capacity to 12 TB, and choose to use a 10 Gigabit fiber optic network card instead of a copper network card. The expanded storage provides a larger local cache for low-latency access to data stored in AWS. The fiber optic network card provides an additional datacenter deployment option.    \u003c/p\u003e\n\u003cp\u003eAWS Storage Gateway enables hybrid cloud storage for backup, archiving and disaster recovery, application file storage, and data processing workflows. Storage Gateway uses standard storage protocols, so you can use cloud storage without modifying your applications.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThe hardware appliance can simplify procurement, deployment, and management of hybrid storage for locations with limited virtual machine infrastructure. The appliance is based on a Dell EMC PowerEdge server with a validated configuration to provide predictable performance. Storage Gateway can also be deployed as a VMware ESXi, Microsoft Hyper-V, or Amazon EC2 virtual machine.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eYou can buy the hardware appliance on \u003ca href\u003d\"https://www.amazon.co.uk/dp/B079RBVX3M\" target\u003d\"_blank\"\u003eAmazon UK\u003c/a\u003e or \u003ca href\u003d\"https://www.amazon.de/dp/B079RBVX3M\" target\u003d\"_blank\"\u003eAmazon Germany\u003c/a\u003e for delivery within Europe, and on \u003ca href\u003d\"https://www.amazon.com/dp/B079RBVX3M/\" target\u003d\"_blank\"\u003eAmazon\u003c/a\u003e for delivery in the United States, with an Amazon or \u003ca href\u003d\"https://www.amazon.com/b2b/info/amazon-business?layout\u003dlanding\" target\u003d\"_blank\"\u003eAmazon Business\u003c/a\u003e account. The appliance can be used with the \u003ca href\u003d\"https://docs.aws.amazon.com/general/latest/gr/rande.html#sg-hardware-appliance\" target\u003d\"_blank\"\u003esupported\u003c/a\u003e US and EU regions. Learn more on the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway web pages\u003c/a\u003e and \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/HardwareAppliance.html\" target\u003d\"_blank\"\u003edocumentation\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:59:47Z","headlineUrl":"/about-aws/whats-new/2019/02/aws-storage-gateway-hw-appliance-eu-availability-and-storage-and-networking-options/","postDateTime":"2019-02-25T09:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway hardware appliance is now available in Europe, and adds more storage and networking options","postSummary":"\u003cp\u003eYou can now order and use the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eAWS Storage Gateway\u003c/a\u003e \u003ca href\u003d\"https://aws.amazon.com/storagegateway/hardware-appliance/\" target\u003d\"_blank\"\u003ehardware appliance\u003c/a\u003e in Europe, expand an appliance’s usable capacity to 12 TB, and choose to use a 10 Gigabit fiber optic network card instead of a copper network card. The expanded storage provides a larger local cache for low-latency access to data stored in AWS. The fiber optic network card provides an additional datacenter deployment option.    \u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-01-aws-storage-gateway-announces-increased-throughput-performance-for-tape-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/01/aws-storage-gateway-announces-increased-throughput-performance-for-tape-gateway/","dateCreated":"2023-11-09T13:59:23+0000","dateUpdated":"2024-07-25T13:23:59+0000","additionalFields":{"postBody":"\u003cp\u003eThe AWS Storage Gateway’s \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\" target\u003d\"_blank\"\u003eTape Gateway\u003c/a\u003e configuration now provides increased throughput performance for virtual tape backups to AWS. Your on-premises backup applications can now write data to the local gateway cache at up to 2.7 Gbps, and read data from the cloud at up to 0.7 Gbps, by following \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/Performance.html#performance-tgw\" target\u003d\"_blank\"\u003epublished best practices\u003c/a\u003e.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eThe Tape Gateway helps you migrate your tape-based backup and archiving workflows to the AWS cloud easily, by connecting your existing backup application to a local Tape Gateway (deployed as a virtual or hardware appliance), which presents itself as a tape library. The Tape Gateway compresses, encrypts, and moves your backup data to AWS, storing it in durable Amazon S3 storage. The cache on the gateway ensures recent backups remain local, reducing restore times. You can also easily move your virtual tapes to an archive on Amazon Glacier for long-term retention on durable, low-cost storage, with predictable and cost-effective retrieval in three-to-five hours.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eTape Gateway is available in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eall AWS regions\u003c/a\u003e where Storage Gateway is available, except South America (São Paulo). For more information, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/GettingStartedTestGatewayVTL.html\" target\u003d\"_blank\"\u003eTesting Your Gateway Setup\u003c/a\u003e documentation, or see \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/create-gateway-vtl.html\" target\u003d\"_blank\"\u003estep-by-step instructions\u003c/a\u003e to get started in the AWS Storage Gateway User Guide.\u003cbr\u003e\n\u003c/p\u003e\n","modifiedDate":"2019-10-06T05:00:00Z","headlineUrl":"/about-aws/whats-new/2019/01/aws-storage-gateway-announces-increased-throughput-performance-for-tape-gateway/","postDateTime":"2019-01-22T09:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway Announces Increased Throughput Performance for Tape Gateway","postSummary":"\u003cp\u003eThe AWS Storage Gateway’s \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/vtl.html\" target\u003d\"_blank\"\u003eTape Gateway\u003c/a\u003e configuration now provides increased throughput performance for virtual tape backups to AWS. Your on-premises backup applications can now write data to the local gateway cache at up to 2.7 Gbps, and read data from the cloud at up to 0.7 Gbps, by following \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/Performance.html#performance-tgw\" target\u003d\"_blank\"\u003epublished best practices\u003c/a\u003e.\u003cbr\u003e\n\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-01-aws-storage-gateway-introduces-volume-detach-and-attach-feature","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/01/aws-storage-gateway-introduces-volume-detach-and-attach-feature-/","dateCreated":"2023-11-09T14:06:11+0000","dateUpdated":"2024-07-25T13:23:44+0000","additionalFields":{"postBody":"\u003cp\u003e                 \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e customers using the Volume Gateway configuration for block storage can now detach and attach volumes, from and to a Volume Gateway. You can use this feature to migrate volumes between gateways to refresh underlying server hardware, switch between virtual machine types, and move volumes to better host platforms or newer Amazon EC2 instances, as your data and performance demands grow.\u003c/p\u003e\n\u003cp\u003eThe volume detach functionality uploads and stores volume data and metadata from your local gateway to the Storage Gateway service in AWS. A detached volume can be easily attached later to a gateway on any \u003ca href\u003d\"https://aws.amazon.com/storagegateway/features/\"\u003esupported host platform\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eTo get started, you simply select the Detach Volume or Attach Volume option for a volume in the AWS Storage Gateway console, use the AWS API, or AWS SDK. This feature is available in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eall AWS regions where Storage Gateway is available\u003c/a\u003e. For more details, please visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/managing-volumes.html#attach-detach-volume\" target\u003d\"_blank\"\u003edocumentation for Managing Your Volume Gateway\u003c/a\u003e. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-10-06T05:00:00Z","headlineUrl":"/about-aws/whats-new/2019/01/aws-storage-gateway-introduces-volume-detach-and-attach-feature-/","postDateTime":"2019-01-22T08:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway Introduces Volume Detach and Attach Feature to Easily Move Volumes Between Different Host Platforms","postSummary":"\u003cp\u003e                 \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e customers using the Volume Gateway configuration for block storage can now detach and attach volumes, from and to a Volume Gateway. You can use this feature to migrate volumes between gateways to refresh underlying server hardware, switch between virtual machine types, and move volumes to better host platforms or newer Amazon EC2 instances, as your data and performance demands grow.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2019-01-aws-storage-gateway-integrates-with-aws-backup-to-protect-volume","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2019/01/aws-storage-gateway-integrates-with-aws-backup-to-protect-volume/","dateCreated":"2023-11-09T13:59:17+0000","dateUpdated":"2024-07-25T13:18:54+0000","additionalFields":{"postBody":"\u003cp\u003eYou can now use AWS Backup, an automated and centralized backup service, to protect volumes stored with the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e service’s block storage option, the Volume  Gateway. With AWS Backup, you can configure backups for Volume Gateway  volumes, automate backup scheduling, set retention policies, and monitor  backup and restore activity.\u003c/p\u003e\n\u003cp\u003eAWS Backup removes the need for custom solutions or manual processes by  providing a fully managed, policy-based backup solution to protect  gateway volumes, simplifying administration, and helping you meet your  business and regulatory compliance requirements. Volume backups managed  through AWS Backup are stored as Amazon EBS Snapshots and can be easily  restored to any Volume Gateway, or to an Amazon EBS volume for use with  Amazon EC2.\u003c/p\u003e\n\u003cp\u003eTo get started, you can assign your Volume Gateway volumes to a new or  existing AWS Backup plan from the AWS management console or use the AWS  Command Line Interface (CLI) tool. Alternatively, download the latest  AWS SDK and call the AWS Backup APIs for backup lifecycle management.  This feature is available in all \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eAWS regions where both Storage Gateway and AWS Backup are available\u003c/a\u003e,  which currently includes US East (N. Virginia), US East (Ohio), US West  (Oregon), and EU (Ireland). For more information, please visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/WhatIsStorageGateway.html\"\u003eStorage Gateway documentation\u003c/a\u003e.\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:59:56Z","headlineUrl":"/about-aws/whats-new/2019/01/aws-storage-gateway-integrates-with-aws-backup-to-protect-volume/","postDateTime":"2019-01-16T10:15:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway Integrates with AWS Backup to Protect Volumes Managed through Volume Gateway","postSummary":"\u003cp\u003eYou can now use AWS Backup, an automated and centralized backup service, to protect volumes stored with the \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e service’s block storage option, the Volume  Gateway. With AWS Backup, you can configure backups for Volume Gateway  volumes, automate backup scheduling, set retention policies, and monitor  backup and restore activity.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#year#2019","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2019","description":"year#2019","dateCreated":"2023-11-06T18:17:49+0000","dateUpdated":"2023-11-06T18:17:49+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2018-12-aws-storage-gateway-announces-increased-throughput-and-adds-new","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2018/12/aws-storage-gateway-announces-increased-throughput-and-adds-new-/","dateCreated":"2023-11-09T14:41:52+0000","dateUpdated":"2024-07-25T13:58:59+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e released various feature enhancements to \u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/\"\u003eFile Gateway\u003c/a\u003e, including increased performance, the option to selectively refresh portions of the gateway’s cache, and the ability to configure DNS and NTP settings.\u003c/p\u003e\n\u003cp\u003e\u003cspan style\u003d\"font-size: 11.0pt; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; color: #333333;\"\u003eFile Gateway enables on-premises applications to access objects in Amazon S3 as files, through a local gateway deployed on a\u003cspan class\u003d\"apple-converted-space\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/span\u003e\u003cspan style\u003d\"font-size: 11.0pt; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; color: black;\"\u003evirtual or a \u003ca href\u003d\"https://aws.amazon.com/storagegateway/hardware-appliance/\"\u003eHardware Appliance\u003c/a\u003e. You can now achieve write throughputs of up to 500 MB/s by following \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/Performance.html#performace-fgw\"\u003epublished best practices\u003c/a\u003e.\u003c/span\u003e\u003cspan style\u003d\"mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; color: black;\"\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eYou can now also do a selective \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/APIReference/API_RefreshCache.html\"\u003ecache refresh\u003c/a\u003e to update specific folders in the local File Gateway, further simplifying collaboration and content distribution workflows in geographically separated hybrid cloud environments.\u003c/p\u003e\n\u003cp\u003eAdditionally, you can now specify your own Domain Name Service (DNS) and Network Time Protocol (NTP) servers for File Gateways, simplifying integration with on-premises network and security policies.\u003c/p\u003e\n\u003cp\u003eThese features are available on new gateways in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\"\u003eall regions where AWS Storage Gateway is available\u003c/a\u003e. Existing gateways will automatically receive the updates in the next scheduled maintenance, or you can apply them through the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/home\"\u003emanagement console\u003c/a\u003e or \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/APIReference/API_Operations.html\"\u003eservice API\u003c/a\u003e.\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:59:22Z","headlineUrl":"/about-aws/whats-new/2018/12/aws-storage-gateway-announces-increased-throughput-and-adds-new-/","postDateTime":"2018-12-12T22:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway Announces Increased Throughput and Adds New Caching Capability","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e released various feature enhancements to \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/file.html\"\u003eFile Gateway\u003c/a\u003e, including increased performance, the option to selectively refresh portions of the gateway’s cache, and the ability to configure DNS and NTP settings.\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2018","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2018","description":"year#2018","dateCreated":"2023-11-09T14:20:09+0000","dateUpdated":"2023-11-09T14:20:09+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2018-11-aws-storage-gateway-virtual-tape-library-expands-support-of-comm","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2018/11/aws-storage-gateway-virtual-tape-library-expands-support-of-comm/","dateCreated":"2023-11-09T14:33:11+0000","dateUpdated":"2024-07-25T13:52:11+0000","additionalFields":{"postBody":"\u003cp\u003eThe \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\"\u003evirtual tape library, or Tape Gateway\u003c/a\u003e, now supports IBM Spectrum Protect (Tivoli Storage Manager) version 7.1.9 running on Microsoft Windows, and Bacula Enterprise Edition version 10. Additionally, Tape Gateway is compatible with new versions of common backup applications, including Veritas NetBackup 8, Veritas Backup Exec 20, Microsoft System Center Data Protection Manager (DPM) 2016, and Quest NetVault Backup 11 and 12.\u003c/p\u003e\n\u003cp\u003eThe Tape Gateway virtual tape library (VTL) helps you move your tape-based backup and archiving workflows to the AWS cloud easily, while keeping your existing backup applications in place. You connect your backup application to a local Tape Gateway (deployed as a virtual or hardware appliance), which presents itself as a tape library. The service compresses, encrypts and moves your backup data to AWS, storing it in a VTL backed by durable Amazon S3 storage. The local cache on the gateway provides low-latency access to recent backups. You can also easily move your virtual tapes to an archive on Amazon Glacier for long-term retention on durable, low-cost storage, with predictable retrieval in three-to-five hours.\u003c/p\u003e\n\u003cp\u003eTape Gateway is available in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\"\u003eall AWS regions\u003c/a\u003e where Storage Gateway is available, except South America (São Paulo). For more information, visit the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/GettingStartedTestGatewayVTL.html\"\u003eTesting Your Gateway Setup\u003c/a\u003e documentation, or see \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/create-gateway-vtl.html\"\u003estep-by-step instructions to get started\u003c/a\u003e in the AWS Storage Gateway User Guide.\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:58:23Z","headlineUrl":"/about-aws/whats-new/2018/11/aws-storage-gateway-virtual-tape-library-expands-support-of-comm/","postDateTime":"2018-11-13T17:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway Virtual Tape Library Expands Support of Common Backup Applications","postSummary":"\u003cp\u003eThe \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/vtl.html\"\u003evirtual tape library, or Tape Gateway\u003c/a\u003e, now supports IBM Spectrum Protect (Tivoli Storage Manager) version 7.1.9 running on Microsoft Windows, and Bacula Enterprise Edition version 10. Additionally, Tape Gateway is compatible with new versions of common backup applications, including Veritas NetBackup 8, Veritas Backup Exec 20, Microsoft System Center Data Protection Manager (DPM) 2016, and Quest NetVault Backup 11 and 12.\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2018","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2018","description":"year#2018","dateCreated":"2023-11-09T14:20:09+0000","dateUpdated":"2023-11-09T14:20:09+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2018-09-aws-storage-gateway-is-now-available-as-a-hardware-appliance","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2018/09/aws-storage-gateway-is-now-available-as-a-hardware-appliance/","dateCreated":"2023-11-09T14:27:15+0000","dateUpdated":"2024-07-25T14:06:18+0000","additionalFields":{"postBody":"\u003cp\u003eAWS Storage Gateway is now available pre-installed on a hardware appliance, which you can buy directly from amazon.com, and manage from the AWS console. The appliance is based on a Dell EMC PowerEdge server with a validated configuration, and provides you an additional deployment option to the existing VMware ESXi, Microsoft Hyper-V or Amazon EC2 virtual machines available today.\u003c/p\u003e\n\u003cp\u003eAWS Storage Gateway enables \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003ehybrid cloud storage\u003c/a\u003e. It connects on-premises applications to AWS storage services, and provides low-latency data access through local caching. You can use the service for backup, archiving and disaster recovery, tiering data to the cloud, application file storage, and data processing workflows. AWS Storage Gateway uses standard storage protocols (NFS, SMB, iSCSI, and iSCSI-VTL), so your applications can store \u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/\"\u003efiles\u003c/a\u003e, \u003ca href\u003d\"https://aws.amazon.com/storagegateway/features/#volume-gateway/\"\u003eblock volumes\u003c/a\u003e, snapshots, and \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\"\u003evirtual tape backups\u003c/a\u003e in AWS.\u003c/p\u003e\n\u003cp\u003eYou can buy the appliance on \u003ca href\u003d\"https://www.amazon.com/dp/B079RBVX3M\"\u003eamazon.com\u003c/a\u003e with an Amazon or \u003ca href\u003d\"https://www.amazon.com/b2b/info/amazon-business?layout\u003dlanding\" target\u003d\"_blank\"\u003eAmazon Business account\u003c/a\u003e, for delivery within the United States. The appliance can be used with the US East (Northern Virginia), US East (Ohio), US West (Oregon) and US West (Northern California) AWS regions. To learn more, visit the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e webpages and \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/HardwareAppliance.html\"\u003ethe hardware appliance documentation\u003c/a\u003e, or \u003ca href\u003d\"https://console.aws.amazon.com/console/home\"\u003etry it out\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:57:47Z","headlineUrl":"/about-aws/whats-new/2018/09/aws-storage-gateway-is-now-available-as-a-hardware-appliance/","postDateTime":"2018-09-18T09:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway Is Now Available as a Hardware Appliance","postSummary":"\u003cp\u003eAWS Storage Gateway is now available pre-installed on a hardware appliance, which you can buy directly from amazon.com, and manage from the AWS console. The appliance is based on a Dell EMC PowerEdge server with a validated configuration, and provides you an additional deployment option to the existing VMware ESXi, Microsoft Hyper-V or Amazon EC2 virtual machines available today.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2018","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2018","description":"year#2018","dateCreated":"2023-11-09T14:20:09+0000","dateUpdated":"2023-11-09T14:20:09+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2018-08-storage-gateway-adds-kms-support-for-encryption","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2018/08/storage-gateway-adds-kms-support-for-encryption/","dateCreated":"2023-11-09T14:23:29+0000","dateUpdated":"2024-07-25T14:07:30+0000","additionalFields":{"postBody":"\u003cp\u003eCustomers can now use AWS Key Management Service (KMS) to manage encryption of data stored in the cloud by \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e.\u0026nbsp;                 AWS KMS is a managed service that makes it easy for you to create and control encryption keys used to encrypt your data. Storage Gateway now supports AWS KMS for encryption of data stored in AWS by all gateway types. This includes virtual tapes managed by Tape Gateway, in-cloud volumes and EBS Snapshots created by Volume Gateway, and files stored as objects in Amazon Simple Storage Service (S3) by File Gateway.\u0026nbsp; \u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003e                   If AWS KMS is not used, all data stored in AWS by the Storage Gateway service is encrypted with Amazon S3-Managed Encryption Keys (SSE-S3) by default. In addition to encryption at rest, all data transferred between any type of Storage Gateway and AWS is encrypted using SSL.\u003c/p\u003e\n\u003cp\u003eThis feature is available in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eall AWS regions where Storage Gateway\u003c/a\u003e is available, except for the AWS China (Beijing) region. You can enable AWS KMS on Storage Gateway via the API. For more details, please visit \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/encryption.html\"\u003eStorage Gateway documentation for encrypting your data with AWS KMS\u003c/a\u003e.\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:57:32Z","headlineUrl":"/about-aws/whats-new/2018/08/storage-gateway-adds-kms-support-for-encryption/","postDateTime":"2018-08-01T18:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway Expands Support of AWS Key Management Service, Improving Encryption Capabilities","postSummary":"\u003cp\u003eCustomers can now use AWS Key Management Service (KMS) to manage encryption of data stored in the cloud by \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e.\u0026nbsp;                 AWS KMS is a managed service that makes it easy for you to create and control encryption keys used to encrypt your data. Storage Gateway now supports AWS KMS for encryption of data stored in AWS by all gateway types. This includes virtual tapes managed by Tape Gateway, in-cloud volumes and EBS Snapshots created by Volume Gateway, and files stored as objects in Amazon Simple Storage Service (S3) by File Gateway.\u0026nbsp; \u003cbr\u003e\n\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-kms","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-kms","description":"general:products/aws-kms","dateCreated":"2023-11-09T13:54:12+0000","dateUpdated":"2023-11-09T13:54:12+0000"},{"id":"whats-new-v2#general-products#aws-govcloud-us","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-govcloud-us","description":"general:products/aws-govcloud-us","dateCreated":"2023-11-07T18:41:18+0000","dateUpdated":"2023-11-07T18:41:18+0000"},{"id":"whats-new-v2#year#2018","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2018","description":"year#2018","dateCreated":"2023-11-09T14:20:09+0000","dateUpdated":"2023-11-09T14:20:09+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2018-06-aws-storage-gateway-adds-smb-support-to-store-objects-in-amazon-s3","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2018/06/aws-storage-gateway-adds-smb-support-to-store-objects-in-amazon-s3/","dateCreated":"2023-11-09T14:32:52+0000","dateUpdated":"2024-07-25T13:59:33+0000","additionalFields":{"postBody":"\u003cp\u003eThe AWS Storage Gateway service added the Server Message Block (SMB) protocol to \u003ca href\u003d\"https://aws.amazon.com/storagegateway/file\"\u003eFile Gateway\u003c/a\u003e, enabling file-based applications developed for Microsoft Windows to easily store and access objects in Amazon Simple Storage Service (S3). With File Gateway, applications can now store files as objects in Amazon S3 using SMB versions 2 and 3, as well as Network File System (NFS) versions 3 and 4.1. You can control access to File Gateway SMB file shares and objects using your corporate Active Directory (AD) domains, or you can use authenticated guest access. File Gateway caches your most recently used data locally, providing on-premises applications with low-latency access. File Gateway simplifies moving data to Amazon S3, supporting hybrid object-based workloads, such as machine learning and big data analytics, as well as backup and data archival in Amazon S3.\u003c/p\u003e\n\u003cp\u003eToday, you can create new File Gateways that support SMB \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003ein every region where AWS Storage Gateway is available\u003c/a\u003e. A software update for existing gateways will be made generally available by mid-July, 2018.\u003c/p\u003e\n\u003cp\u003eLearn about \u003ca href\u003d\"https://aws.amazon.com/storagegateway/file\"\u003eFile Gateway here\u003c/a\u003e, and \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway?refid\u003dem_\"\u003etry it out today\u003c/a\u003e. See \u003ca href\u003d\"https://aws.amazon.com/premiumsupport/knowledge-center/file-gateway-ec2/\"\u003ehow to set up File Gateway in this video\u003c/a\u003e and in the \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/create-file-gateway.html\"\u003edocumentation\u003c/a\u003e.\u003c/p\u003e\n","modifiedDate":"2020-07-23T22:49:55Z","headlineUrl":"/about-aws/whats-new/2018/06/aws-storage-gateway-adds-smb-support-to-store-objects-in-amazon-s3/","postDateTime":"2018-06-20T09:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway Adds SMB Support to Store and Access Objects in Amazon S3 Buckets","postSummary":"\u003cp\u003eThe AWS Storage Gateway service added the Server Message Block (SMB) protocol to \u003ca href\u003d\"https://aws.amazon.com/storagegateway/file\"\u003eFile Gateway\u003c/a\u003e, enabling file-based applications developed for Microsoft Windows to easily store and access objects in Amazon Simple Storage Service (S3). With File Gateway, applications can now store files as objects in Amazon S3 using SMB versions 2 and 3, as well as Network File System (NFS) versions 3 and 4.1. You can control access to File Gateway SMB file shares and objects using your corporate Active Directory (AD) domains, or you can use authenticated guest access. File Gateway caches your most recently used data locally, providing on-premises applications with low-latency access. File Gateway simplifies moving data to Amazon S3, supporting hybrid object-based workloads, such as machine learning and big data analytics, as well as backup and data archival in Amazon S3.\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-govcloud-us","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-govcloud-us","description":"general:products/aws-govcloud-us","dateCreated":"2023-11-07T18:41:18+0000","dateUpdated":"2023-11-07T18:41:18+0000"},{"id":"whats-new-v2#general-products#amazon-s3","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-s3","description":"general:products/amazon-s3","dateCreated":"2023-11-09T13:53:07+0000","dateUpdated":"2023-11-09T13:53:07+0000"},{"id":"whats-new-v2#year#2018","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2018","description":"year#2018","dateCreated":"2023-11-09T14:20:09+0000","dateUpdated":"2023-11-09T14:20:09+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#marketing-marchitecture#storage","locale":"en_US","tagNamespaceId":"whats-new-v2#marketing-marchitecture","name":"storage","description":"marketing:marchitecture/storage","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#general-products#amazon-simple-storage-service","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-simple-storage-service","description":"general:products/amazon-simple-storage-service","dateCreated":"2023-11-09T13:57:06+0000","dateUpdated":"2023-11-09T13:57:06+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2018-05-aws-storage-gateway-vtl-adds-support-for-novastor-datacenter","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2018/05/aws-storage-gateway-vtl-adds-support-for-novastor-datacenter/","dateCreated":"2023-11-09T14:37:58+0000","dateUpdated":"2024-07-25T13:54:55+0000","additionalFields":{"postBody":"\u003cp\u003eAWS Storage \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eGateway\u003c/a\u003e now supports NovaStor DataCenter versions 6 and 7 with the Tape Gateway \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl\"\u003evirtual tape library\u003c/a\u003e (VTL). Tape Gateway helps you move your tape-based backup and archiving workflows to the AWS cloud easily, using applications such as \u003ca href\u003d\"http://www.novastor.com/en/software/data-center-backup\" target\u003d\"_blank\"\u003eNovaStor DataCenter.\u003c/a\u003e With Tape Gateway, you backup application data locally to an appliance, which then moves the data to AWS and stores it in a VTL backed by durable Amazon S3 storage. Then, you can easily archive backups to Amazon Glacier for long-term retention on durable, low-cost storage, with the ability to retrieve virtual tapes in three-to-five hours.\u003c/p\u003e\n\u003cp\u003e                   Tape Gateway, with support for NovaStor DataCenter, is available in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\" target\u003d\"_blank\"\u003eall AWS regions\u003c/a\u003e where Storage Gateway is available, except South America (São Paulo).\u003c/p\u003e\n\u003cp\u003eFor more information, visit the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\"\u003eTape Gateway web page\u003c/a\u003e, or see \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/create-gateway-vtl.html\" target\u003d\"_blank\"\u003estep-by-step instructions to get started\u003c/a\u003e in the AWS Storage Gateway User Guide.\u003c/p\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:56:40Z","headlineUrl":"/about-aws/whats-new/2018/05/aws-storage-gateway-vtl-adds-support-for-novastor-datacenter/","postDateTime":"2018-05-24T13:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway VTL Expands Backup Application Support With NovaStor DataCenter","postSummary":"\u003cp\u003eAWS Storage \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\" target\u003d\"_blank\"\u003eGateway\u003c/a\u003e now supports NovaStor DataCenter versions 6 and 7 with the Tape Gateway \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl\"\u003evirtual tape library\u003c/a\u003e (VTL). Tape Gateway helps you move your tape-based backup and archiving workflows to the AWS cloud easily, using applications such as \u003ca href\u003d\"http://www.novastor.com/en/software/data-center-backup\" target\u003d\"_blank\"\u003eNovaStor DataCenter.\u003c/a\u003e With Tape Gateway, you backup application data locally to an appliance, which then moves the data to AWS and stores it in a VTL backed by durable Amazon S3 storage. Then, you can easily archive backups to Amazon Glacier for long-term retention on durable, low-cost storage, with the ability to retrieve virtual tapes in three-to-five hours.\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2018","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2018","description":"year#2018","dateCreated":"2023-11-09T14:20:09+0000","dateUpdated":"2023-11-09T14:20:09+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2018-04-tape-gateway-in-singapore","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2018/04/tape-gateway-in-singapore/","dateCreated":"2023-11-09T14:37:18+0000","dateUpdated":"2024-07-25T13:52:31+0000","additionalFields":{"postBody":"\u003cp\u003eYou can now backup to AWS in the Asia Pacific (Singapore) region using the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\"\u003eTape Gateway virtual tape library (VTL)\u003c/a\u003e configuration of \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e. Tape Gateway emulates a physical tape library, so instead of backing up to physical tapes, you can backup to virtual tapes stored in Amazon S3 and Amazon Glacier, using \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/#partners\"\u003ecommon backup applications\u003c/a\u003e such as Veeam, Veritas Backup Exec and NetBackup, Dell EMC NetWorker and Commvault.\u003c/p\u003e\n\u003cp\u003e                   Tape Gateway is available in \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\"\u003eAWS regions\u003c/a\u003e around the world. For more information on Storage Gateway, see the \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/\"\u003eAWS Storage Gateway User Guide\u003c/a\u003e and the \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/create-tape-gateway.html\"\u003estep-by-step instructions to get started\u003c/a\u003e.\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:55:59Z","headlineUrl":"/about-aws/whats-new/2018/04/tape-gateway-in-singapore/","postDateTime":"2018-04-04T18:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway VTL (Tape Gateway) is available in Asia Pacific (Singapore) Region","postSummary":"\u003cp\u003eYou can now backup to AWS in the Asia Pacific (Singapore) region using the \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/vtl.html\"\u003eTape Gateway virtual tape library (VTL)\u003c/a\u003e configuration of \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e. Tape Gateway emulates a physical tape library, so instead of backing up to physical tapes, you can backup to virtual tapes stored in Amazon S3 and Amazon Glacier, using \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/vtl/#partners\"\u003ecommon backup applications\u003c/a\u003e such as Veeam, Veritas Backup Exec and NetBackup, Dell EMC NetWorker and Commvault.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2018","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2018","description":"year#2018","dateCreated":"2023-11-09T14:20:09+0000","dateUpdated":"2023-11-09T14:20:09+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2018-04-file-gateway-supports-s3-one-zone-ia","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2018/04/file-gateway-supports-s3-one-zone-ia/","dateCreated":"2023-11-09T14:33:08+0000","dateUpdated":"2024-07-25T14:03:47+0000","additionalFields":{"postBody":"\u003cp\u003e                   The \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e service expanded the list of Amazon S3 storage classes supported by File Gateway to include S3 One Zone-Infrequent Access (S3 One Zone-IA). With this addition, you can now store and access your files as objects through the File Gateway using the S3 Standard, S3 Standard-IA and S3 One Zone-IA storage classes. \u003c/p\u003e\n\u003cp\u003eFile Gateway offers on-premises applications an \u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/\"\u003eNFS mount for objects in Amazon S3\u003c/a\u003e, enabling hybrid cloud use cases such as migration, backup, disaster recovery, data lakes, Big Data analytics, and data distribution.\u003c/p\u003e\n\u003cp\u003eYou can \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/GettingStartedCreateFileShare.html\"\u003ecreate a file share in S3 One Zone-IA\u003c/a\u003e through the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/home\"\u003emanagement console\u003c/a\u003e or the \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/APIReference/API_Operations.html\"\u003eservice API\u003c/a\u003e. This feature is available today in all \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\"\u003eAWS Regions\u003c/a\u003e where Storage Gateway is offered around the world.\u003cbr\u003e\n\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:56:00Z","headlineUrl":"/about-aws/whats-new/2018/04/file-gateway-supports-s3-one-zone-ia/","postDateTime":"2018-04-04T15:00:00Z","contentType":"Launch Announcement","headline":"File Gateway Supports Amazon S3 One Zone-IA","postSummary":"\u003cp\u003e                   The \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e service expanded the list of Amazon S3 storage classes supported by File Gateway to include S3 One Zone-Infrequent Access (S3 One Zone-IA). With this addition, you can now store and access your files as objects through the File Gateway using the S3 Standard, S3 Standard-IA and S3 One Zone-IA storage classes. \u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2018","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2018","description":"year#2018","dateCreated":"2023-11-09T14:20:09+0000","dateUpdated":"2023-11-09T14:20:09+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2018-03-storage-gateway-govcloud","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2018/03/storage-gateway-govcloud/","dateCreated":"2023-11-09T14:24:28+0000","dateUpdated":"2024-07-25T14:03:42+0000","additionalFields":{"postBody":"\u003cp\u003eCustomers can now use \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e                  to migrate, store and access data in the AWS GovCloud (US) Region from on-premises or AWS GovCloud (US) environments. Storage Gateway connects applications to AWS storage, enabling hybrid cloud architectures used for data migration, processing and analytics, file services, backup, and disaster recovery. With Storage Gateway, you can shift from buying storage or backup hardware to using AWS storage services, reducing physical infrastructure and management.    \u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003e                   The Storage Gateway service offers three types of gateways. \u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/\"\u003eFile Gateway\u003c/a\u003e enables you to store files as objects in Amazon S3, and access them through standard file protocols or the S3 API. \u003ca href\u003d\"https://aws.amazon.com/storagegateway/details/#volume_gateway/\"\u003eVolume Gateway\u003c/a\u003e presents block volumes that are automatically stored on AWS, as EBS Snapshots or as online tiered volumes. \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/\"\u003eTape Gateway\u003c/a\u003e acts as a Virtual Tape Library (VTL) that backup applications can use to store data on Amazon Glacier and S3. All gateway types secure and optimize data transfer to AWS, and integrate natively with other AWS services such as Amazon CloudWatch. \u003c/p\u003e\n\u003cp\u003e                   To use the service, you deploy a software appliance on vSphere, Hyper-V or Amazon EC2, and connect it to applications with file (NFS), block (iSCSI) and tape (iSCSI-VTL) protocols. The appliances include a local cache for low-latency data access.\u003c/p\u003e\n\u003cp\u003e                 In addition to the AWS GovCloud (US) Region, Storage Gateway is available in 16 other regions worldwide.     Learn more on our \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway details\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/storagegateway/pricing/\"\u003ePricing\u003c/a\u003e pages.\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:56:24Z","headlineUrl":"/about-aws/whats-new/2018/03/storage-gateway-govcloud/","postDateTime":"2018-03-28T22:21:43Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway Available in GovCloud (US)","postSummary":"\u003cp\u003eCustomers can now use \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e                  to migrate, store and access data in the AWS GovCloud (US) Region from on-premises or AWS GovCloud (US) environments. Storage Gateway connects applications to AWS storage, enabling hybrid cloud architectures used for data migration, processing and analytics, file services, backup, and disaster recovery. With Storage Gateway, you can shift from buying storage or backup hardware to using AWS storage services, reducing physical infrastructure and management.    \u003cbr\u003e\n\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#year#2018","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2018","description":"year#2018","dateCreated":"2023-11-09T14:20:09+0000","dateUpdated":"2023-11-09T14:20:09+0000"},{"id":"whats-new-v2#general-products#aws-govcloud-us","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-govcloud-us","description":"general:products/aws-govcloud-us","dateCreated":"2023-11-07T18:41:18+0000","dateUpdated":"2023-11-07T18:41:18+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2018-03-aws-storage-gateway-expands-automation-with-new-cloudwatch-event-and-support-for-requester-pays-buckets","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2018/03/aws-storage-gateway-expands-automation-with-new-cloudwatch-event-and-support-for-requester-pays-buckets/","dateCreated":"2023-11-09T14:24:22+0000","dateUpdated":"2024-07-25T13:46:53+0000","additionalFields":{"postBody":"\u003cp\u003eThe \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e service expanded the set of CloudWatch Events for File Gateway to help automate hybrid cloud workflows, and now supports \u0026quot;Requester Pays\u0026quot; Amazon S3 buckets.\u003c/p\u003e\n\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/\"\u003eFile Gateway\u003c/a\u003e enables on-premises applications to access objects in S3 as files. File contents and metadata are cached locally for optimal performance. The \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/APIReference/API_RefreshCache.html\" target\u003d\"_blank\"\u003erefresh cache\u003c/a\u003e operation synchronizes the local cache with S3.  The \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/monitoring-file-gateway.html#get-notification\" target\u003d\"_blank\"\u003enew Amazon CloudWatch Event\u003c/a\u003e occurs when a refresh cache operation finishes. Combined with file upload notification events, it enables you to automate workflows for data processing and content sharing in a hybrid cloud architecture.\u003c/p\u003e\n\u003cp\u003eFile Gateway can now access S3 buckets configured as \u0026quot;\u003ca href\u003d\"https://docs.aws.amazon.com/AmazonS3/latest/dev/RequesterPaysBuckets.html\" target\u003d\"_blank\"\u003eRequester Pays\u003c/a\u003e\u0026quot;. Typically, bucket owners pay the cost of downloading data, but with \u0026quot;Requester Pays\u0026quot; enabled, the requester pays for requests and data downloads. Such buckets can be used to share public data, such as \u003ca href\u003d\"https://archive.stsci.edu/hst/\" target\u003d\"_blank\"\u003eHubble Space Telescope observations\u003c/a\u003e, or \u003ca href\u003d\"https://www.fsa.usda.gov/programs-and-services/aerial-photography/\" target\u003d\"_blank\"\u003eUSDA Aerial Photography\u003c/a\u003e. File Gateway caches frequently used data locally, helping requesters to reduce latency and costs.\u003c/p\u003e\n\u003cp\u003eFile Gateway appliances can now also run on Amazon EC2 C5/M5 instances, and \u003ca href\u003d\"https://docs.aws.amazon.com/storagegateway/latest/userguide/managing-gateway-file.html#cross-account-access\" target\u003d\"_blank\"\u003esupport predefined cross-account bucket access\u003c/a\u003e using \u003ca href\u003d\"https://docs.aws.amazon.com/AmazonS3/latest/dev/acl-overview.html#canned-acl\" target\u003d\"_blank\"\u003eAmazon S3 Canned Access Control Lists (ACLs)\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eNew File Gateway appliances contain these features, and existing File Gateways will receive them automatically in the next scheduled maintenance update. You can apply the update manually through the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/home\" target\u003d\"_blank\"\u003emanagement console\u003c/a\u003e or \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/APIReference/API_Operations.html\" target\u003d\"_blank\"\u003eservice API\u003c/a\u003e.\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:56:16Z","headlineUrl":"/about-aws/whats-new/2018/03/aws-storage-gateway-expands-automation-with-new-cloudwatch-event-and-support-for-requester-pays-buckets/","postDateTime":"2018-03-08T12:04:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway Expands Automation with New CloudWatch Event, and Support for \"Requester Pays\" Buckets","postSummary":"\u003cp\u003eThe \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e service expanded the set of CloudWatch Events for File Gateway to help automate hybrid cloud workflows, and now supports \u0026quot;Requester Pays\u0026quot; Amazon S3 buckets.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#year#2018","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2018","description":"year#2018","dateCreated":"2023-11-09T14:20:09+0000","dateUpdated":"2023-11-09T14:20:09+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2018-02-switch-tape-backups-to-aws-with-the-storage-gateway-vtl-and-dell-emc-networker-v9","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2018/02/switch-tape-backups-to-aws-with-the-storage-gateway-vtl-and-dell-emc-networker-v9/","dateCreated":"2023-11-09T14:36:43+0000","dateUpdated":"2024-07-25T14:03:30+0000","additionalFields":{"postBody":"\u003cp\u003eThe AWS Storage Gateway service has expanded the capabilities of its \u003ca href\u003d\"http://aws.amazon.com/storagegateway/vtl\"\u003eTape Gateway virtual tape library (VTL)\u003c/a\u003e, adding support for Dell EMC NetWorker v9 as a supported backup application. You can now easily switch from tape to cloud backups using the Tape Gateway with Dell EMC NetWorker v9, while preserving established backup management processes. Backup applications write data to a local Tape Gateway appliance on-premises, and the Storage Gateway service stores the backups in a cloud-based VTL that uses scalable, cost-effective, and secure Amazon S3 and Amazon Glacier storage.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eFor more information, see \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/create-tape-gateway.html\"\u003estep-by-step instructions to get started\u003c/a\u003e, the list of \u003ca href\u003d\"https://aws.amazon.com/storagegateway/vtl/#partners\"\u003esupported backup applications\u003c/a\u003e, and the \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/\"\u003eAWS Storage Gateway User Guide\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:55:51Z","headlineUrl":"/about-aws/whats-new/2018/02/switch-tape-backups-to-aws-with-the-storage-gateway-vtl-and-dell-emc-networker-v9/","postDateTime":"2018-02-27T15:07:56Z","contentType":"Launch Announcement","headline":"Switch Tape Backups to AWS with the Storage Gateway VTL and Dell EMC NetWorker v9","postSummary":"\u003cp\u003eThe AWS Storage Gateway service has expanded the capabilities of its \u003ca href\u003d\"http://aws.amazon.com/storagegateway/vtl\"\u003eTape Gateway virtual tape library (VTL)\u003c/a\u003e, adding support for Dell EMC NetWorker v9 as a supported backup application. You can now easily switch from tape to cloud backups using the Tape Gateway with Dell EMC NetWorker v9, while preserving established backup management processes. Backup applications write data to a local Tape Gateway appliance on-premises, and the Storage Gateway service stores the backups in a cloud-based VTL that uses scalable, cost-effective, and secure Amazon S3 and Amazon Glacier storage.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2018","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2018","description":"year#2018","dateCreated":"2023-11-09T14:20:09+0000","dateUpdated":"2023-11-09T14:20:09+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2017-11-aws-storage-gateway-adds-upload-notifications-mime-type-detection-suse-linux-support-and-additional-features-to-file-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2017/11/aws-storage-gateway-adds-upload-notifications-mime-type-detection-suse-linux-support-and-additional-features-to-file-gateway/","dateCreated":"2023-11-09T14:29:05+0000","dateUpdated":"2024-07-25T13:42:50+0000","additionalFields":{"postBody":"\u003cp\u003eYou can now receive Amazon CloudWatch Events when files that are written to \u003ca href\u003d\"https://aws.amazon.com/storagegateway/details/\"\u003eAWS Storage Gateway\u003c/a\u003e’s file interface (\u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/\"\u003eFile Gateway\u003c/a\u003e) are uploaded to Amazon S3. You can use these notifications to trigger in-cloud or on-premises automated workflows. For instance, a file upload notification could initiate an API call to start a data processing job using AWS analytics services, such as Amazon Athena, or invoke an AWS Lambda function for transcoding. Alternatively, you can use a file upload notification to make a RefreshCache API call to File Gateways in remote offices, so that on-premises applications can then read the uploaded data, such as reports, files for print presses, code updates or database backup files.\u003c/p\u003e\n\u003cp\u003eAdditionally, you can now have the File Gateway infer the MIME type of an uploaded document by filename. With this capability, web browsers accessing a file from Amazon S3, directly or via Amazon CloudFront, can display it in its native file format, for instance, as a PDF or an image, instead of downloading it.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eOther new features include support for SUSE Linux Enterprise clients, forced deletion of file shares, and end-to-end performance improvements.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eAll of the features noted above are supported in every region AWS Storage Gateway is available today for newly created File Gateways. A software update for existing gateways will be made generally available on December 4, 2017. To request an earlier update, please \u003ca href\u003d\"https://aws.amazon.com/premiumsupport//\"\u003econtact AWS support\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eAWS Storage Gateway\u0027s file interface, the File Gateway, offers you a seamless way to connect local applications to Amazon S3 cloud storage in order to store files as durable objects. File Gateway provides an NFS mount for Amazon S3, with caching for low-latency local access.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eTo get started or learn more about File Gateway, visit \u003ca href\u003d\"https://aws.amazon.com/storagegateway/file/\"\u003eaws.amazon.com/storagegateway/file\u003c/a\u003e. \u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:54:24Z","headlineUrl":"/about-aws/whats-new/2017/11/aws-storage-gateway-adds-upload-notifications-mime-type-detection-suse-linux-support-and-additional-features-to-file-gateway/","postDateTime":"2017-11-17T22:32:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway adds upload notifications, MIME-type detection, SUSE Linux support and additional features to File Gateway","postSummary":"\u003cp\u003eYou can now receive Amazon CloudWatch Events when files that are written to \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/details.html\"\u003eAWS Storage Gateway\u003c/a\u003e’s file interface (\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/file.html\"\u003eFile Gateway\u003c/a\u003e) are uploaded to Amazon S3. You can use these notifications to trigger in-cloud or on-premises automated workflows. For instance, a file upload notification could initiate an API call to start a data processing job using AWS analytics services, such as Amazon Athena, or invoke an AWS Lambda function for transcoding. Alternatively, you can use a file upload notification to make a RefreshCache API call to File Gateways in remote offices, so that on-premises applications can then read the uploaded data, such as reports, files for print presses, code updates or database backup files.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2017","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2017","description":"year#2017","dateCreated":"2023-11-09T14:16:58+0000","dateUpdated":"2023-11-09T14:16:58+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2017-10-aws-storage-gateway-is-now-hipaa-eligible","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2017/10/aws-storage-gateway-is-now-hipaa-eligible/","dateCreated":"2023-11-09T14:31:25+0000","dateUpdated":"2024-07-25T13:47:57+0000","additionalFields":{"postBody":"\u003cp\u003eAWS Storage Gateway is now HIPAA eligible. If you have an executed \u003ca href\u003d\"https://aws.amazon.com/artifact/getting-started/#BAA_Agreements\"\u003eBusiness Associate Agreement (BAA)\u003c/a\u003e with AWS, you can now use Storage Gateway to store, backup and archive protected health information (PHI) on scalable, cost-effective, and secure AWS storage services, including Amazon S3, Amazon Glacier and Amazon EBS, which are also HIPAA eligible.\u003c/p\u003e\n\u003cp\u003eInformation on HIPAA eligible services on AWS can be found at our\u0026nbsp;\u003ca href\u003d\"https://aws.amazon.com/compliance/hipaa-compliance/\"\u003eHIPAA Compliance page\u003c/a\u003e, and you can enter into a BAA with AWS \u003ca href\u003d\"https://aws.amazon.com/artifact/getting-started/#BAA_Agreements\"\u003ehere\u003c/a\u003e. HIPAA eligibility for Storage Gateway applies to all gateway types (File, Volume and Tape), and all \u003ca href\u003d\"https://aws.amazon.com/about-aws/global-infrastructure/regional-product-services/\"\u003eAWS Regions\u003c/a\u003e where Storage Gateway is available. For more information, see the \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/GettingStarted.html\" target\u003d\"_blank\"\u003eGetting Started documentation\u003c/a\u003e for Storage Gateway, or \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/create/gateway\" target\u003d\"_blank\"\u003etry it out now\u003c/a\u003e!\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:55:27Z","headlineUrl":"/about-aws/whats-new/2017/10/aws-storage-gateway-is-now-hipaa-eligible/","postDateTime":"2017-10-31T12:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway is now HIPAA eligible","postSummary":"\u003cp\u003eAWS Storage Gateway is now HIPAA eligible. If you have an executed \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/artifact/getting-started/#BAA_Agreements\"\u003eBusiness Associate Agreement (BAA)\u003c/a\u003e with AWS, you can now use Storage Gateway to store, backup and archive protected health information (PHI) on scalable, cost-effective, and secure AWS storage services, including Amazon S3, Amazon Glacier and Amazon EBS, which are also HIPAA eligible.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2017","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2017","description":"year#2017","dateCreated":"2023-11-09T14:16:58+0000","dateUpdated":"2023-11-09T14:16:58+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2017-09-backup-to-aws-with-commvault-v11-and-the-aws-storage-gateway-virtual-tape-library-vtl","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2017/09/backup-to-aws-with-commvault-v11-and-the-aws-storage-gateway-virtual-tape-library-vtl/","dateCreated":"2023-11-09T14:33:13+0000","dateUpdated":"2024-07-25T13:55:45+0000","additionalFields":{"postBody":"\u003cp\u003eAWS Storage Gateway has added Commvault V11 as a supported backup application for use with its virtual tape library (VTL), the Tape Gateway. You can now use Commvault V11 and the Storage Gateway VTL to backup and archive application data to scalable, cost-effective, and secure Amazon S3 and Amazon Glacier storage, while preserving established tape management processes.\u003c/p\u003e\n\u003cp\u003e                    For more information, see \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/create-tape-gateway.html\"\u003estep-by-step instructions to get started\u003c/a\u003e and the complete list of \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/Requirements.html#requirements-backup-sw-for-vtl\"\u003esupported backup applications\u003c/a\u003e in the \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/\"\u003eAWS Storage Gateway User Guide\u003c/a\u003e.\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:53:46Z","headlineUrl":"/about-aws/whats-new/2017/09/backup-to-aws-with-commvault-v11-and-the-aws-storage-gateway-virtual-tape-library-vtl/","postDateTime":"2017-09-12T09:49:08Z","contentType":"Launch Announcement","headline":"Backup to AWS with Commvault V11 and the AWS Storage Gateway virtual tape library (VTL)","postSummary":"\u003cp\u003eAWS Storage Gateway has added Commvault V11 as a supported backup application for use with its virtual tape library (VTL), the Tape Gateway. You can now use Commvault V11 and the Storage Gateway VTL to backup and archive application data to scalable, cost-effective, and secure Amazon S3 and Amazon Glacier storage, while preserving established tape management processes.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2017","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2017","description":"year#2017","dateCreated":"2023-11-09T14:16:58+0000","dateUpdated":"2023-11-09T14:16:58+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2017-06-aws-storage-gateway-expands-file-gateway-to-run-on-microsoft-hyper-v","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2017/06/aws-storage-gateway-expands-file-gateway-to-run-on-microsoft-hyper-v/","dateCreated":"2023-11-09T14:18:54+0000","dateUpdated":"2024-07-25T14:00:02+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e has expanded file gateway to run on Microsoft Hyper-V 2008 R2 and 2012, in addition to the VMware and Amazon EC2 options previously available.\u003c/p\u003e\n\u003cp\u003e\u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/StorageGatewayConcepts.html#file-gateway-concepts\"\u003eFile gateway\u003c/a\u003e enables you to store and retrieve Amazon S3 objects through standard file storage protocols. With file gateway, existing applications or devices can use secure and durable cloud storage without needing to be modified.\u003c/p\u003e\n\u003cp\u003e                 You can download the Hyper-V virtual machine (VM) images for file gateway when creating a new gateway in the AWS Storage Gateway management console. This is available in \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/available-regions-intro.html\"\u003eall AWS regions\u003c/a\u003e from today. For more information, see our \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/create-file-gateway.html\"\u003eGetting Started documentation\u003c/a\u003e or \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/create/gateway\"\u003etry it out now\u003c/a\u003e!\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:52:58Z","headlineUrl":"/about-aws/whats-new/2017/06/aws-storage-gateway-expands-file-gateway-to-run-on-microsoft-hyper-v/","postDateTime":"2017-06-22T15:42:55Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway expands file gateway to run on Microsoft Hyper-V","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e has expanded file gateway to run on Microsoft Hyper-V 2008 R2 and 2012, in addition to the VMware and Amazon EC2 options previously available.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2017","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2017","description":"year#2017","dateCreated":"2023-11-09T14:16:58+0000","dateUpdated":"2023-11-09T14:16:58+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2017-05-aws-storage-gateway-now-provides-retrieval-of-archived-vritual-tapes-in-as-little-as-3-5-hours-adds-additional-virtual-tape-information-and-adds-cached-volume-cloning","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2017/05/aws-storage-gateway-now-provides-retrieval-of-archived-vritual-tapes-in-as-little-as-3-5-hours-adds-additional-virtual-tape-information-and-adds-cached-volume-cloning/","dateCreated":"2023-11-09T14:31:17+0000","dateUpdated":"2024-07-25T13:44:27+0000","additionalFields":{"postBody":"\u003cp\u003e                 For tape gateway users, you can now retrieve archived virtual tapes into your Virtual Tape Library (VTL) in as little as 3-5 hours. Prior to this launch, tape retrieval could take up to 24 hours. This faster access can help you speed up recovery of archived data. Additionally, to help you \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/managing-gateway-vtl.html\"\u003emanage your virtual tapes\u003c/a\u003e, we have enhanced the tape gateway console and API to show the date and time a tape was created, and the amount of data written to each virtual tape.\u003c/p\u003e\n\u003cp\u003e                 For volume gateway users, you can now \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/managing-volumes.html#clone-volume\"\u003eclone cached volumes\u003c/a\u003e. The cloning feature allows you to use the Storage Gateway Console or API to create a full copy of a cached volume from any cached volume in the same region. This simplified copy process reduces the time to copy volumes, which is especially important in disaster recovery scenarios.\u003c/p\u003e\n\u003cp\u003eThese new features are available to all customers. For existing gateways, a\u0026nbsp;\u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/MaintenanceManagingUpdate-common.html\"\u003esoftware update\u003c/a\u003e\u0026nbsp;will be applied automatically during your next scheduled weekly maintenance. You can also apply the update manually through the\u0026nbsp;\u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/home\"\u003eAWS Management Console\u003c/a\u003e or\u0026nbsp;\u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/APIReference/API_Operations.html\"\u003eservice API\u003c/a\u003e. For a list of regions where Storage Gateway is available,\u0026nbsp;\u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/available-regions-intro.html\"\u003eclick here\u003c/a\u003e. For more details and information on AWS Storage Gateway, see our\u0026nbsp;\u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/GettingStarted-common.html\"\u003eUser Guide\u003c/a\u003e.\u003cbr\u003e\n\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:52:41Z","headlineUrl":"/about-aws/whats-new/2017/05/aws-storage-gateway-now-provides-retrieval-of-archived-vritual-tapes-in-as-little-as-3-5-hours-adds-additional-virtual-tape-information-and-adds-cached-volume-cloning/","postDateTime":"2017-05-23T11:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway now provides retrieval of archived virtual tapes in as little as 3-5 hours, adds additional virtual tape information, and adds cached volume cloning","postSummary":"\u003cp\u003e                 For tape gateway users, you can now retrieve archived virtual tapes into your Virtual Tape Library (VTL) in as little as 3-5 hours. Prior to this launch, tape retrieval could take up to 24 hours. This faster access can help you speed up recovery of archived data. Additionally, to help you \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/managing-gateway-vtl.html\"\u003emanage your virtual tapes\u003c/a\u003e, we have enhanced the tape gateway console and API to show the date and time a tape was created, and the amount of data written to each virtual tape.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2017","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2017","description":"year#2017","dateCreated":"2023-11-09T14:16:58+0000","dateUpdated":"2023-11-09T14:16:58+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2017-05-aws-storage-gateway-is-now-available-in-the-asia-pacific-mumbai-region","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2017/05/aws-storage-gateway-is-now-available-in-the-asia-pacific-mumbai-region/","dateCreated":"2023-11-09T14:26:42+0000","dateUpdated":"2024-07-25T13:46:16+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e is now available in the Asia Pacific (Mumbai) Region.\u003c/p\u003e\n\u003cp\u003eThe AWS Storage Gateway service seamlessly enables hybrid cloud storage between on-premises environments and the AWS Cloud. It combines a multi-protocol storage appliance with highly efficient network connectivity to deliver local performance with virtually unlimited scale. You can use it in remote offices and datacenters for hybrid cloud workloads involving migration, bursting, and storage tiering, as well as to connect Amazon EC2-hosted applications to data in Amazon S3.\u003c/p\u003e\n\u003cp\u003eStorage Gateway is available in all six AWS Regions in Asia, and fifteen Regions worldwide. Please visit our \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eproduct page\u003c/a\u003e for more information.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:52:34Z","headlineUrl":"/about-aws/whats-new/2017/05/aws-storage-gateway-is-now-available-in-the-asia-pacific-mumbai-region/","postDateTime":"2017-05-02T09:30:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway is Now Available in the Asia Pacific (Mumbai) Region","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e is now available in the Asia Pacific (Mumbai) Region.\u003c/p\u003e\n\u003cp\u003eThe AWS Storage Gateway service seamlessly enables hybrid cloud storage between on-premises environments and the AWS Cloud. It combines a multi-protocol storage appliance with highly efficient network connectivity to deliver local performance with virtually unlimited scale. You can use it in remote offices and datacenters for hybrid cloud workloads involving migration, bursting, and storage tiering, as well as to connect Amazon EC2-hosted applications to data in Amazon S3.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2017","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2017","description":"year#2017","dateCreated":"2023-11-09T14:16:58+0000","dateUpdated":"2023-11-09T14:16:58+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2017-03-aws-storage-gateway-adds-read-only-file-shares-user-permission-squashing-and-scanning-for-added-and-removed-objects","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2017/03/aws-storage-gateway-adds-read-only-file-shares-user-permission-squashing-and-scanning-for-added-and-removed-objects/","dateCreated":"2023-11-09T14:31:30+0000","dateUpdated":"2024-07-25T13:40:11+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e has updated file gateway to add additional NFS mount options to your file share, and enable scanning for added and deleted objects in your mounted Amazon S3 bucket.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eUsing the \u003ca href\u003d\"https://console.aws.amazon.com/console/home\" target\u003d\"_blank\"\u003eStorage Gateway management console\u003c/a\u003e or service API you can now configure a file share to be exported read-only, or squash user permissions to a default user and group ID. This configuration is per file share, and provides additional control over how NFS clients can access and manipulate the objects in your S3 bucket.\u003c/p\u003e\n\u003cp\u003eAdditionally, a \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/APIReference/API_RefreshCache.html\" target\u003d\"_blank\"\u003enew API\u003c/a\u003e and console action enables you to initiate a scan for objects added to, or deleted from, the S3 bucket associated with a file share. This scan updates the inventory of objects maintained and stored on the gateway. The inventory is used when performing file system operations to reduce the latency and frequency of S3 requests. You can use this new action to make available as files, objects that have been added to your bucket by in-cloud workloads, S3 cross-region replication, or AWS Snowball.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eTogether these enhancements enable you to provision a single gateway writing to an S3 bucket, and any number of read-only gateways which are accessing the same bucket, to share file-based data across multiple sites or user groups.\u003c/p\u003e\n\u003cp\u003eThese new capabilities are available today in an updated VM image downloadable from the management console. For existing file gateways, a \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/MaintenanceManagingUpdate-common.html\" target\u003d\"_blank\"\u003esoftware update\u003c/a\u003e will be applied automatically during your next scheduled weekly maintenance. You can also apply the update manually through the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/home\" target\u003d\"_blank\"\u003emanagement console\u003c/a\u003e or \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/APIReference/API_Operations.html\" target\u003d\"_blank\"\u003eservice API\u003c/a\u003e.\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:52:18Z","headlineUrl":"/about-aws/whats-new/2017/03/aws-storage-gateway-adds-read-only-file-shares-user-permission-squashing-and-scanning-for-added-and-removed-objects/","postDateTime":"2017-03-28T15:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway adds read-only file shares, user permission squashing, and scanning for added and removed objects","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e has updated file gateway to add additional NFS mount options to your file share, and enable scanning for added and deleted objects in your mounted Amazon S3 bucket.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2017","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2017","description":"year#2017","dateCreated":"2023-11-09T14:16:58+0000","dateUpdated":"2023-11-09T14:16:58+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2017-02-aws-storage-gateway-supports-running-file-gateway-in-ec2-and-adds-file-share-security-options","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2017/02/aws-storage-gateway-supports-running-file-gateway-in-ec2-and-adds-file-share-security-options/","dateCreated":"2023-11-09T14:24:51+0000","dateUpdated":"2024-07-25T13:56:10+0000","additionalFields":{"postBody":"\u003cp\u003e                    \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e is today adding two new features to file gateway: support for running the gateway virtual machine (VM) in Amazon EC2, and limiting the NFS clients that can connect to a file share.\u003c/p\u003e\n\u003cp\u003e                    As with volume and tape gateways, you now have the option to create a file gateway that runs on an EC2 instance. This enables storing and retrieving Amazon S3 objects through standard file storage protocols from within EC2 for in-cloud workloads, application and data migration, and disaster recovery. The management console provides step-by-step instructions and walks you through creating a gateway running in EC2.\u003c/p\u003e\n\u003cp\u003e                    For added security on your file shares, you can now configure a list of IP addresses or networks that are allowed to mount the NFS export. This restricts access through the gateway to a set of known clients, and can be used as an alternative to network or firewall rules to control access to data in your S3 buckets. The list of allowed clients can be configured for new and existing file shares using the management console or service API.\u003c/p\u003e\n\u003cp\u003e                    These new capabilities are available in an updated VM image downloadable from the management console. For existing file gateways, a \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/MaintenanceManagingUpdate-common.html\"\u003esoftware update\u003c/a\u003e will be applied automatically during your next scheduled weekly maintenance. You can also apply the update manually through the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/home\" target\u003d\"_blank\"\u003emanagement console\u003c/a\u003e or \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/APIReference/API_Operations.html\"\u003eservice API\u003c/a\u003e.\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:51:59Z","headlineUrl":"/about-aws/whats-new/2017/02/aws-storage-gateway-supports-running-file-gateway-in-ec2-and-adds-file-share-security-options/","postDateTime":"2017-02-08T15:28:35Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway supports running file gateway in EC2 and adds file share security options","postSummary":"\u003cp\u003e                    \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e is today adding two new features to file gateway: support for running the gateway virtual machine (VM) in Amazon EC2, and limiting the NFS clients that can connect to a file share.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#amazon-ec2","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-ec2","description":"general:products/amazon-ec2","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2017","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2017","description":"year#2017","dateCreated":"2023-11-09T14:16:58+0000","dateUpdated":"2023-11-09T14:16:58+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2017-01-backup-to-aws-with-arcserve-backup-using-the-storage-gateway-virtual-tape-library","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2017/01/backup-to-aws-with-arcserve-backup-using-the-storage-gateway-virtual-tape-library/","dateCreated":"2023-11-09T14:17:09+0000","dateUpdated":"2024-07-25T13:44:15+0000","additionalFields":{"postBody":"\u003cp\u003eWe are pleased to announce we have added \u003ca href\u003d\"http://arcserve.com/\" target\u003d\"_blank\"\u003eArcserve Backup\u003c/a\u003e to the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e compatibility list. You can backup and archive from Arcserve Backup r17 using the Storage Gateway virtual tape library (VTL) to scalable, cost-effective, secure Amazon S3 and Amazon Glacier.\u003c/p\u003e\n\u003cp\u003eArcserve Backup is supported with Storage Gateway as of January 17, 2017. For more information, see \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/create-tape-gateway.html\"\u003estep-by-step instructions to get started\u003c/a\u003e and the complete list of \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/Requirements.html#requirements-backup-sw-for-vtl\"\u003ecompatible backup applications\u003c/a\u003e in the \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/\"\u003eAWS Storage Gateway User Guide\u003c/a\u003e.\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:51:57Z","headlineUrl":"/about-aws/whats-new/2017/01/backup-to-aws-with-arcserve-backup-using-the-storage-gateway-virtual-tape-library/","postDateTime":"2017-01-17T13:30:00Z","contentType":"Launch Announcement","headline":"Backup to AWS with Arcserve Backup using the Storage Gateway virtual tape library","postSummary":"\u003cp\u003eWe are pleased to announce we have added \u003ca href\u003d\"http://arcserve.com/\" target\u003d\"_blank\"\u003eArcserve Backup\u003c/a\u003e to the \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e compatibility list. You can backup and archive from Arcserve Backup r17 using the Storage Gateway virtual tape library (VTL) to scalable, cost-effective, secure Amazon S3 and Amazon Glacier.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2017","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2017","description":"year#2017","dateCreated":"2023-11-09T14:16:58+0000","dateUpdated":"2023-11-09T14:16:58+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2016-11-aws-storage-gateway-price-reductions","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2016/11/aws-storage-gateway-price-reductions/","dateCreated":"2023-11-09T14:20:39+0000","dateUpdated":"2024-07-25T13:42:10+0000","additionalFields":{"postBody":"\u003cp\u003eEffective December 1, 2016, we’re updating pricing for \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e, making it more cost-effective to adopt cloud storage for your on-premises applications. There will be 3 changes to pricing: storage prices for volume and virtual tapes will be reduced; the monthly gateway fee will be replaced with pricing based on the amount of data you write to AWS; and virtual tape retrieval will be simplified, moving from rate-based fees to per GB pricing.\u0026nbsp;\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003eStorage prices per GB will be reduced by up to 28% for volumes and virtual tapes, and up to 43% for archived virtual tapes. This follows the \u003ca href\u003d\"https://aws.amazon.com/blogs/aws/aws-storage-update-s3-glacier-price-reductions/\" target\u003d\"_blank\"\u003estorage price reduction\u003c/a\u003e announced on November 21, 2016 for Amazon S3 and Glacier.\u003c/li\u003e\n\u003cli\u003eThe monthly gateway fee will be replaced by pricing based on the amount of data your gateway writes to AWS when it is actively being used. In all regions, you will pay $0.01 per GB up to a monthly maximum of no more than $125 per gateway. For new customers, the first 100 GB will be free to enable you to setup and try the service.\u003cbr\u003e\nIf your gateway writes less than 12 TB of data per month to AWS, your monthly bill will be reduced. You can monitor the amount of data written by your gateway to AWS through existing \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/AWSStorageGatewayMetricsList-common.html\" target\u003d\"_blank\"\u003eAmazon CloudWatch metrics\u003c/a\u003e and you can \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/MaintenanceUpdateBandwidth-common.html\" target\u003d\"_blank\"\u003econfigure bandwidth limits\u003c/a\u003e on your gateway to manage your costs.\u003c/li\u003e\n\u003cli\u003eFor retrieval of archived virtual tapes, the current peak rate retrieval fee will be replaced with simpler per GB pricing. In all regions, you will pay $0.01 per GB of data retrieved giving more predictability to charges for retrieving data stored on your virtual tapes. For example, if you retrieve one virtual tape per month containing 1 TB of data you will pay $10.24 with the new pricing, which is up to a 97% reduction over the current rate-based fees. \u0026nbsp;\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eToday\u0027s price drop continues the AWS tradition of reducing our costs, and passing the savings along to our customers. This new pricing will be effective in all regions starting December 1, 2016 and reflected on the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/pricing/\"\u003eAWS Storage Gateway pricing page\u003c/a\u003e at that time. During the month of December, your billing estimates may not reflect the reduced prices. The new, lower prices, will be reflected in your statement at the end of the month.\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:51:20Z","headlineUrl":"/about-aws/whats-new/2016/11/aws-storage-gateway-price-reductions/","postDateTime":"2016-11-29T12:28:43Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway price reductions","postSummary":"\u003cp\u003eEffective December 1, 2016, we’re updating pricing for \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e, making it more cost-effective to adopt cloud storage for your on-premises applications. There will be 3 changes to pricing: storage prices for volume and virtual tapes will be reduced; the monthly gateway fee will be replaced with pricing based on the amount of data you write to AWS; and virtual tape retrieval will be simplified, moving from rate-based fees to per GB pricing.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2016","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2016","description":"year#2016","dateCreated":"2023-11-09T14:14:35+0000","dateUpdated":"2023-11-09T14:14:35+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2016-11-aws-storage-gateway-provides-a-file-interface-to-objects-in-your-amazon-s3-buckets","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2016/11/aws-storage-gateway-provides-a-file-interface-to-objects-in-your-amazon-s3-buckets/","dateCreated":"2023-11-09T14:19:55+0000","dateUpdated":"2024-07-25T13:43:52+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e now provides a virtual on-premises file server, which enables you to store and retrieve Amazon S3 objects through standard file storage protocols. With file gateway, existing applications or devices can use secure and durable cloud storage without needing to be modified. File gateway simplifies moving data into S3 for in-cloud workloads, provides cost-effective storage for backup and archive, or expands your on-premises storage into the cloud.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eFile gateway is available as a virtual machine image which you download from the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/home\" target\u003d\"_blank\"\u003eAWS Management Console\u003c/a\u003e. Once deployed in your data center and associated with your AWS account, your configured S3 buckets will be available as Network File System (NFS) mount points. Your applications read and write files and directories over NFS, interfacing to the gateway as a file server. In turn, the gateway translates these file operations into object requests on your S3 buckets. Like existing volume and tape gateways, your most recently used data is cached on the gateway for low-latency access, and data transfer between your data center and AWS is fully managed and optimized by the gateway. Once in S3, you can access the objects directly or manage them using features such as S3 Lifecycle Policies, object versioning, and cross-region replication.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eTo start using the new AWS Storage Gateway, click \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/create\" target\u003d\"_blank\"\u003ehere\u003c/a\u003e. There are no up-front commitments required and you pay only for what you use. To learn more, click \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003ehere\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:51:20Z","headlineUrl":"/about-aws/whats-new/2016/11/aws-storage-gateway-provides-a-file-interface-to-objects-in-your-amazon-s3-buckets/","postDateTime":"2016-11-29T12:12:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway provides a file interface to objects in your Amazon S3 buckets","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e now provides a virtual on-premises file server, which enables you to store and retrieve Amazon S3 objects through standard file storage protocols. With file gateway, existing applications or devices can use secure and durable cloud storage without needing to be modified. File gateway simplifies moving data into S3 for in-cloud workloads, provides cost-effective storage for backup and archive, or expands your on-premises storage into the cloud.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#year#2016","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2016","description":"year#2016","dateCreated":"2023-11-09T14:14:35+0000","dateUpdated":"2023-11-09T14:14:35+0000"},{"id":"whats-new-v2#general-products#amazon-s3","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-s3","description":"general:products/amazon-s3","dateCreated":"2023-11-09T13:53:07+0000","dateUpdated":"2023-11-09T13:53:07+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2016-11-backup-to-aws-with-hp-data-protector-9-07-using-storage-gateway-vtl","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2016/11/backup-to-aws-with-hp-data-protector-9-07-using-storage-gateway-vtl/","dateCreated":"2023-11-09T14:15:55+0000","dateUpdated":"2024-07-25T13:37:26+0000","additionalFields":{"postBody":"\u003cp\u003e  We are pleased to announce we have added HP Data Protector 9.07 to the AWS Storage Gateway-Virtual Tape Library (VTL) compatibility list. You can backup and archive from \u003ca href\u003d\"http://www8.hp.com/us/en/software-solutions/data-protector-backup-recovery-software/index.html\" target\u003d\"_blank\"\u003eHP Data Protector\u003c/a\u003e using Gateway-VTL to scalable, cost-effective, secure Amazon S3 and Amazon Glacier.\u003c/p\u003e\n\u003cp\u003e  HP Data Protector is supported with Storage Gateway as of November 2, 2016. For more information, see \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/GettingStartedTrySetupStep2-vtl.html\" target\u003d\"_blank\"\u003estep-by-step instructions to get started\u003c/a\u003e and the complete list of \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/Requirements.html#requirements-backup-sw-for-vtl\" target\u003d\"_blank\"\u003ecompatible backup applications\u003c/a\u003e in the \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/GettingStartedTrySetupStep2-vtl.html\" target\u003d\"_blank\"\u003eAWS Storage Gateway User Guide\u003c/a\u003e.\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:51:04Z","headlineUrl":"/about-aws/whats-new/2016/11/backup-to-aws-with-hp-data-protector-9-07-using-storage-gateway-vtl/","postDateTime":"2016-11-02T07:00:00Z","contentType":"Launch Announcement","headline":"Backup to AWS with HP Data Protector 9.07 using Storage Gateway VTL","postSummary":"\u003cp\u003e  We are pleased to announce we have added HP Data Protector 9.07 to the AWS Storage Gateway-Virtual Tape Library (VTL) compatibility list. You can backup and archive from \u003ca href\u003d\"http://www8.hp.com/us/en/software-solutions/data-protector-backup-recovery-software/index.html\" target\u003d\"_blank\"\u003eHP Data Protector\u003c/a\u003e using Gateway-VTL to scalable, cost-effective, secure Amazon S3 and Amazon Glacier.\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2016","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2016","description":"year#2016","dateCreated":"2023-11-09T14:14:35+0000","dateUpdated":"2023-11-09T14:14:35+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2016-08-weve-redesigned-the-aws-storage-gateway-console","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2016/08/weve-redesigned-the-aws-storage-gateway-console/","dateCreated":"2023-11-09T14:22:51+0000","dateUpdated":"2024-07-25T13:44:30+0000","additionalFields":{"postBody":"\u003cp\u003e  We’ve redesigned the \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e console making it easier to configure, manage, and monitor all your gateways, volumes, and virtual tapes. The simplified interface provides filterable views, and direct links to integrated services such as Amazon CloudWatch and Amazon EBS. The new console enables you to do tasks faster and with fewer clicks.\u003c/p\u003e\n\u003cp\u003eThe redesigned console is available to all customers and no action is required on your part. Please see our \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/GettingStarted-common.html\" target\u003d\"_blank\"\u003eGetting Started User Guide\u003c/a\u003e or \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/home\" target\u003d\"_blank\"\u003etry it now\u003c/a\u003e!\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:50:48Z","headlineUrl":"/about-aws/whats-new/2016/08/weve-redesigned-the-aws-storage-gateway-console/","postDateTime":"2016-08-30T08:00:00Z","contentType":"Launch Announcement","headline":"We’ve redesigned the AWS Storage Gateway console","postSummary":"\u003cp\u003e  We’ve redesigned the \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e console making it easier to configure, manage, and monitor all your gateways, volumes, and virtual tapes. The simplified interface provides filterable views, and direct links to integrated services such as Amazon CloudWatch and Amazon EBS. The new console enables you to do tasks faster and with fewer clicks.\u003c/p\u003e\n\u003cp\u003eThe redesigned console is available to all customers and no action is required on your part. Please see our \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/GettingStarted-common.html\" target\u003d\"_blank\"\u003eGetting Started User Guide\u003c/a\u003e or \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway/home\" target\u003d\"_blank\"\u003etry it now\u003c/a\u003e!\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2016","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2016","description":"year#2016","dateCreated":"2023-11-09T14:14:35+0000","dateUpdated":"2023-11-09T14:14:35+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2016-08-backup-and-archive-to-aws-storage-gateway-vtl-with-veeam-backup-and-replication-v9","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2016/08/backup-and-archive-to-aws-storage-gateway-vtl-with-veeam-backup-and-replication-v9/","dateCreated":"2023-11-09T14:29:57+0000","dateUpdated":"2024-07-25T13:48:19+0000","additionalFields":{"postBody":"\u003cp\u003eToday, we are adding Veeam Backup \u0026amp; Replication v9 to the AWS Storage Gateway-Virtual Tape Library (VTL) compatibility list. Backup and archive directly to scalable, cost-effective, secure Amazon S3 and Amazon Glacier using gateway-VTL with the latest version of Veeam Backup \u0026amp; Replication. \u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThis applies to all gateway-VTL customers running \u003ca target\u003d\"_blank\" href\u003d\"https://www.veeam.com/kb2147\"\u003eVeeam Backup \u0026amp; Replication v9 Update 2\u003c/a\u003e (9.0.0.1715 or later). To get started see the \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/GettingStartedTrySetupStep2-vtl.html\"\u003estep-by-step instructions\u003c/a\u003e and for more information see the \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/Requirements.html#requirements-backup-sw-for-vtl\"\u003ecomplete list of compatible backup applications\u003c/a\u003e in the \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/\"\u003eAWS Storage Gateway User Guide\u003c/a\u003e.\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:50:45Z","headlineUrl":"/about-aws/whats-new/2016/08/backup-and-archive-to-aws-storage-gateway-vtl-with-veeam-backup-and-replication-v9/","postDateTime":"2016-08-17T09:00:00Z","contentType":"Launch Announcement","headline":"Backup and archive to AWS Storage Gateway VTL with Veeam Backup \u0026 Replication v9","postSummary":"\u003cp\u003eToday, we are adding Veeam Backup \u0026amp; Replication v9 to the AWS Storage Gateway-Virtual Tape Library (VTL) compatibility list. Backup and archive directly to scalable, cost-effective, secure Amazon S3 and Amazon Glacier using gateway-VTL with the latest version of Veeam Backup \u0026amp; Replication. \u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2016","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2016","description":"year#2016","dateCreated":"2023-11-09T14:14:35+0000","dateUpdated":"2023-11-09T14:14:35+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2016-06-new-aws-accounts-default-to-long-ebs-and-storage-gateway-resource-ids","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2016/06/new-aws-accounts-default-to-long-ebs-and-storage-gateway-resource-ids/","dateCreated":"2023-11-09T14:22:18+0000","dateUpdated":"2024-07-25T13:36:37+0000","additionalFields":{"postBody":"\u003cp\u003eIn April, Amazon Web Services \u003ca href\u003d\"https://aws.amazon.com/blogs/aws/theyre-here-longer-ebs-and-storage-gateway-resource-ids-now-available/\"\u003eannounced the availability of longer volume and snapshot IDs for EBS and Storage Gateway\u003c/a\u003e. Starting today, June 29, 2016, all newly created AWS accounts will use longer volume and snapshot IDs by default in all regions except China (Beijing) and AWS GovCloud (US). If you have not yet tested your systems for compatibility with longer volume and snapshot IDs, you still have the option to request the shorter ID format if necessary. For new AWS regions launching later in 2016, all accounts will default to longer EC2 and EBS IDs, with the option to opt out if needed.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eWe strongly recommend testing your systems and opting into the longer ID format before December 2016. After you opt in, only new instances, reservations, volumes, or snapshots will receive longer IDs; existing resources will not be affected. Some AWS CLI and SDK versions are not compatible with longer IDs. From December, all new instances, reservations, volumes, and snapshots will be created with longer IDs.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eFor instructions regarding how to opt in to longer IDs, visit the \u003ca href\u003d\"https://aws.amazon.com/blogs/aws/theyre-here-longer-ebs-and-storage-gateway-resource-ids-now-available\"\u003eAWS Blog\u003c/a\u003e. More information about timelines, testing procedures, a full list of affected tools and compatible versions, and more can be found on the \u003ca href\u003d\"https://aws.amazon.com/ec2/faqs/\"\u003eEC2 FAQ\u003c/a\u003e and the \u003ca href\u003d\"http://docs.aws.amazon.com/AWSEC2/latest/UserGuide/resource-ids.html\"\u003eEC2 User Guide\u003c/a\u003e. If you have questions, please contact the \u003ca href\u003d\"https://console.aws.amazon.com/support/\"\u003eAWS support team\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:51:49Z","headlineUrl":"/about-aws/whats-new/2016/06/new-aws-accounts-default-to-long-ebs-and-storage-gateway-resource-ids/","postDateTime":"2016-06-29T10:00:00Z","contentType":"Launch Announcement","headline":"New AWS Accounts Default to Long EBS and Storage Gateway Resource IDs","postSummary":"\u003cp\u003eIn April, Amazon Web Services \u003ca href\u003d\"https://aws.amazon.com/blogs/aws/theyre-here-longer-ebs-and-storage-gateway-resource-ids-now-available/\"\u003eannounced the availability of longer volume and snapshot IDs for EBS and Storage Gateway\u003c/a\u003e. Starting today, June 29, 2016, all newly created AWS accounts will use longer volume and snapshot IDs by default in all regions except China (Beijing) and AWS GovCloud (US). If you have not yet tested your systems for compatibility with longer volume and snapshot IDs, you still have the option to request the shorter ID format if necessary. For new AWS regions launching later in 2016, all accounts will default to longer EC2 and EBS IDs, with the option to opt out if needed.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2016","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2016","description":"year#2016","dateCreated":"2023-11-09T14:14:35+0000","dateUpdated":"2023-11-09T14:14:35+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#amazon-elastic-block-store","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-elastic-block-store","description":"general:products/amazon-elastic-block-store","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"whats-new-v2#general-products#aws-govcloud-us","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-govcloud-us","description":"general:products/aws-govcloud-us","dateCreated":"2023-11-07T18:41:18+0000","dateUpdated":"2023-11-07T18:41:18+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2016-04-longer-format-for-ebs-and-storage-gateway-ids","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2016/04/longer-format-for-ebs-and-storage-gateway-ids/","dateCreated":"2023-11-09T14:29:44+0000","dateUpdated":"2024-07-25T13:39:10+0000","additionalFields":{"postBody":"\u003cp\u003e  In January, Amazon Web Services \u003ca href\u003d\"https://aws.amazon.com/blogs/aws/theyre-here-longer-ec2-resource-ids-now-available/\" target\u003d\"_blank\"\u003eannounced that longer IDs for EBS volumes and snapshots\u003c/a\u003e would be available in April. Starting today, you can opt in to using longer volume and snapshot IDs for EBS and Storage Gateway using APIs or the AWS Management Console. \u003c/p\u003e\n\u003cp\u003eIn addition, starting April 28th, all newly created AWS accounts will use longer EC2 instance and reservation IDs by default in all regions except China (Beijing) and AWS GovCloud (US). If you have not yet tested your systems for compatibility with longer EC2 instance and reservation IDs, you still have the option to request the shorter ID format if necessary. Starting in June, all new AWS accounts will automatically default to longer volume and snapshot IDs as well. For new AWS regions launching later in 2016, all accounts will default to longer EC2 and EBS IDs, with the option to opt out if needed.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eWe strongly recommend testing your systems and opting into the longer ID format before December 2016. After you opt in, only new instances, reservations, volumes, or snapshots will receive longer IDs; existing resources will not be affected. Some AWS CLI and SDK versions are not compatible with longer IDs. From December, all new instances, reservations, volumes, and snapshots will be created with longer IDs.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eFor instructions regarding how to opt in to longer IDs, visit the \u003ca target\u003d\"_blank\" href\u003d\"https://aws.amazon.com/blogs/aws/theyre-here-longer-ebs-and-storage-gateway-resource-ids-now-available\"\u003eAWS Blog\u003c/a\u003e. More information about timelines, testing procedures, a full list of affected tools and compatible versions, and more can be found on the \u003ca href\u003d\"https://aws.amazon.com/ec2/faqs/#longer-ids\"\u003eEC2 FAQ\u003c/a\u003e and the \u003ca target\u003d\"_blank\" href\u003d\"http://docs.aws.amazon.com/AWSEC2/latest/UserGuide/resource-ids.html\"\u003eEC2 User Guide\u003c/a\u003e. If you have questions, please contact the \u003ca target\u003d\"_blank\" href\u003d\"https://console.aws.amazon.com/support/\"\u003eAWS support team\u003c/a\u003e.\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:50:26Z","headlineUrl":"/about-aws/whats-new/2016/04/longer-format-for-ebs-and-storage-gateway-ids/","postDateTime":"2016-04-28T12:00:00Z","contentType":"Launch Announcement","headline":"Longer Format for EBS and Storage Gateway IDs ","postSummary":"\u003cp\u003e  In January, Amazon Web Services \u003ca href\u003d\"https://aws.amazon.com/blogs/aws/theyre-here-longer-ec2-resource-ids-now-available/\" target\u003d\"_blank\"\u003eannounced that longer IDs for EBS volumes and snapshots\u003c/a\u003e would be available in April. Starting today, you can opt in to using longer volume and snapshot IDs for EBS and Storage Gateway using APIs or the AWS Management Console. \u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2016","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2016","description":"year#2016","dateCreated":"2023-11-09T14:14:35+0000","dateUpdated":"2023-11-09T14:14:35+0000"},{"id":"whats-new-v2#general-products#amazon-elastic-block-store","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-elastic-block-store","description":"general:products/amazon-elastic-block-store","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#general-products#amazon-ec2","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"amazon-ec2","description":"general:products/amazon-ec2","dateCreated":"2023-11-07T20:59:48+0000","dateUpdated":"2023-11-07T20:59:48+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2016-03-aws-storage-gateway-now-supports-up-to-1-pb-virtual-tape-libraries-and-up-to-512-tb-of-stored-volumes-per-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2016/03/aws-storage-gateway-now-supports-up-to-1-pb-virtual-tape-libraries-and-up-to-512-tb-of-stored-volumes-per-gateway/","dateCreated":"2023-11-09T14:25:33+0000","dateUpdated":"2024-07-25T13:50:22+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e is pleased to announce increased capacity for both gateway-virtual tape library (VTL) and gateway-stored volumes. This enables you to store more data in AWS without needing to run additional gateways, reducing your cost and operational overhead.\u003c/p\u003e\n\u003cp\u003eFor \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/storage-gateway-vtl-concepts.html\"\u003egateway-VTL\u003c/a\u003e we have increased the maximum capacity of virtual tapes in a single VTL to 1 PB, a sevenfold increase from the previous 150 TB maximum storage capacity per VTL. You can now configure up to 1,500 virtual tapes, up to 2.5 TB each, for a maximum capacity of 1 PB. For \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/storage-gateway-stored-volume-concepts.html\"\u003egateway-stored volumes\u003c/a\u003e we have increased the maximum storage managed per gateway by 166% from 192 TB to 512 TB, enabling you to configure up to 32 volumes of up to 16 TB each. The maximum capacity for \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/storage-gateway-cached-concepts.html\"\u003egateway-cached volumes\u003c/a\u003e is unchanged, enabling up to 32 volumes of up to 32 TB each for a maximum capacity 1 PB for this type of gateway.\u003c/p\u003e\n\u003cp\u003eThese new capabilities are available in an updated AWS Storage Gateway virtual machine (VM) image downloadable from the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway\"\u003eAWS Management Console\u003c/a\u003e. For all existing gateways, the \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/MaintenanceManagingUpdate-common.html\"\u003esoftware update\u003c/a\u003e will be applied automatically during your gateway’s next scheduled weekly maintenance time. You can also apply the update manually on the AWS Management Console.\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:50:15Z","headlineUrl":"/about-aws/whats-new/2016/03/aws-storage-gateway-now-supports-up-to-1-pb-virtual-tape-libraries-and-up-to-512-tb-of-stored-volumes-per-gateway/","postDateTime":"2016-03-21T15:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway now supports up to 1 PB virtual tape libraries and up to 512 TB of stored volumes per gateway","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e is pleased to announce increased capacity for both gateway-virtual tape library (VTL) and gateway-stored volumes. This enables you to store more data in AWS without needing to run additional gateways, reducing your cost and operational overhead.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2016","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2016","description":"year#2016","dateCreated":"2023-11-09T14:14:35+0000","dateUpdated":"2023-11-09T14:14:35+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2016-03-aws-storage-gateway-is-now-available-in-aws-asia-pacific-seoul-region","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2016/03/aws-storage-gateway-is-now-available-in-aws-asia-pacific-seoul-region/","dateCreated":"2023-11-09T14:25:01+0000","dateUpdated":"2024-07-25T14:03:10+0000","additionalFields":{"postBody":"\u003cp\u003eWe are excited to announce availability of AWS Storage Gateway in the AWS Asia Pacific (Seoul) region.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e                   is a service connecting an on-premises software appliance with cloud-based storage to provide seamless integration between an organization’s IT environment and AWS’s storage infrastructure. The service allows you to make use of the AWS cloud for a secure, scalable, and cost-effective alternative to on-premises storage.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThe Seoul Region adds to the \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/available-regions-intro.html\"\u003e10 regions worldwide where AWS Storage Gateway is already available\u003c/a\u003e. For pricing and more information please visit our \u003ca href\u003d\"https://aws.amazon.com/storagegateway/pricing/\"\u003ePricing\u003c/a\u003e and \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eProduct Details\u003c/a\u003e pages.\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:50:15Z","headlineUrl":"/about-aws/whats-new/2016/03/aws-storage-gateway-is-now-available-in-aws-asia-pacific-seoul-region/","postDateTime":"2016-03-21T15:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway is now available in AWS Asia Pacific (Seoul) region","postSummary":"\u003cp\u003eWe are excited to announce availability of AWS Storage Gateway in the AWS Asia Pacific (Seoul) region.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2016","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2016","description":"year#2016","dateCreated":"2023-11-09T14:14:35+0000","dateUpdated":"2023-11-09T14:14:35+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2016-02-aws-storage-gateway-support-for-emc-networker-8-x-with-gateway-vtl","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2016/02/aws-storage-gateway-support-for-emc-networker-8-x-with-gateway-vtl/","dateCreated":"2023-11-09T14:14:49+0000","dateUpdated":"2024-07-25T13:34:43+0000","additionalFields":{"postBody":"\u003cp\u003eToday, we are announcing support for EMC NetWorker 8.x with AWS Storage Gateway-Virtual Tape Library (VTL). You can now backup and archive directly to scalable, cost-effective, secure Amazon S3 and Amazon Glacier storage using Gateway-VTL with NetWorker.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThis support applies to all new and existing gateways created or updated as of the September 16, 2015, AWS Storage Gateway\u0026nbsp;\u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/MaintenanceManagingUpdate-common.html\"\u003emaintenance update\u003c/a\u003e. For the complete list of \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/Requirements.html#requirements-backup-sw-for-vtl\"\u003esupported backup applications\u003c/a\u003e\u0026nbsp;and to get started, see the\u0026nbsp;\u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/GettingStartedTrySetupStep2-vtl.html\"\u003eAWS Storage Gateway-VTL User Guide\u003c/a\u003e.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:50:10Z","headlineUrl":"/about-aws/whats-new/2016/02/aws-storage-gateway-support-for-emc-networker-8-x-with-gateway-vtl/","postDateTime":"2016-02-29T09:13:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway support for EMC NetWorker 8.x with Gateway-VTL","postSummary":"\u003cp\u003eToday, we are announcing support for EMC NetWorker 8.x with AWS Storage Gateway-Virtual Tape Library (VTL). You can now backup and archive directly to scalable, cost-effective, secure Amazon S3 and Amazon Glacier storage using Gateway-VTL with NetWorker.\u0026nbsp;\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2016","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2016","description":"year#2016","dateCreated":"2023-11-09T14:14:35+0000","dateUpdated":"2023-11-09T14:14:35+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2015-09-aws-storage-gateway-reduces-virtual-tape-shelf-vts-storage-pricing","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2015/09/aws-storage-gateway-reduces-virtual-tape-shelf-vts-storage-pricing/","dateCreated":"2023-11-09T14:16:52+0000","dateUpdated":"2024-07-25T13:30:14+0000","additionalFields":{"postBody":"\u003cp\u003e  Effective September 1, 2015, we are decreasing the price for Virtual Tape Shelf (VTS) storage by 30-36% for \u003ca href\u003d\"https://aws.amazon.com/storagegateway/details/#Gateway-VTL\"\u003eGateway-Virtual Tape Library (VTL)\u003c/a\u003e in the US East (Northern Virginia), US West (Oregon), Europe (Ireland) regions. Data stored in VTS is backed by Amazon Glacier, and this change reflects the storage price reduction announced by Glacier on September 16, 2015.\u003c/p\u003e\n\u003cp\u003e  This new pricing will take effect automatically and no action is required on your part. For further details please visit \u003ca href\u003d\"https://aws.amazon.com/storagegateway/pricing/\"\u003eAWS Storage Gateway Pricing page\u003c/a\u003e.\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:49:36Z","headlineUrl":"/about-aws/whats-new/2015/09/aws-storage-gateway-reduces-virtual-tape-shelf-vts-storage-pricing/","postDateTime":"2015-09-25T12:30:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway Reduces Virtual Tape Shelf (VTS) Storage Pricing","postSummary":"\u003cp\u003e  Effective September 1, 2015, we are decreasing the price for Virtual Tape Shelf (VTS) storage by 30-36% for \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/details/#Gateway-VTL\"\u003eGateway-Virtual Tape Library (VTL)\u003c/a\u003e in the US East (Northern Virginia), US West (Oregon), Europe (Ireland) regions. Data stored in VTS is backed by Amazon Glacier, and this change reflects the storage price reduction announced by Glacier on September 16, 2015.\u003c/p\u003e\n\u003cp\u003e  This new pricing will take effect automatically and no action is required on your part. For further details please visit \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/pricing.html\"\u003eAWS Storage Gateway Pricing page\u003c/a\u003e.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2015","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2015","description":"year#2015","dateCreated":"2023-11-09T14:13:24+0000","dateUpdated":"2023-11-09T14:13:24+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2015-09-aws-storage-gateway-now-supports-1-pb-of-data-per-gateway-up-to-120-mbs-cloud-upload-rate-and-10-gb-networking","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2015/09/aws-storage-gateway-now-supports-1-pb-of-data-per-gateway-up-to-120-mbs-cloud-upload-rate-and-10-gb-networking/","dateCreated":"2023-11-09T14:14:32+0000","dateUpdated":"2024-07-25T13:43:10+0000","additionalFields":{"postBody":"\u003cp\u003e  \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e is pleased to announce increased capacity for Gateway-Cached Volumes and improved performance for all gateway types.\u003c/p\u003e\n\u003cp\u003eFor \u003ca target\u003d\"_blank\" href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/storage-gateway-cached-concepts.html\"\u003eGateway-Cached Volumes\u003c/a\u003e we have increased the maximum storage per gateway to 1 PB enabling you to configure up to 32 volumes of up to 32 TB each, a sevenfold increase from the previous 150 TB maximum storage per gateway. This enables you to store more data in AWS without needing to run additional gateways, reducing your cost and operational overhead.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003cp\u003eFor all gateway types, we now support upload rates of up to 120 MB/s, a 4x improvement; and for VMware ESXi hosted gateways we have added support for 10 Gb network adapters. These enhancements enable accelerated data upload rates to AWS where your data is durably stored and increase the amount of data that a single gateway can ingest each day.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003cp\u003eThese new capabilities are available in an updated AWS Storage Gateway virtual machine (VM) image downloadable from the \u003ca target\u003d\"_blank\" href\u003d\"https://console.aws.amazon.com/storagegateway\"\u003eAWS Management Console\u003c/a\u003e. For all existing gateways, a \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/MaintenanceManagingUpdate.html\" target\u003d\"_blank\"\u003esoftware update\u003c/a\u003e is available which can be applied manually through the Console, or the update will be applied automatically during your gateway’s next scheduled weekly maintenance time.\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:49:35Z","headlineUrl":"/about-aws/whats-new/2015/09/aws-storage-gateway-now-supports-1-pb-of-data-per-gateway-up-to-120-mbs-cloud-upload-rate-and-10-gb-networking/","postDateTime":"2015-09-16T12:45:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway now supports 1 PB of data per gateway, up to 120 MB/s cloud upload rate, and 10 Gb networking","postSummary":"\u003cp\u003e  \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e is pleased to announce increased capacity for Gateway-Cached Volumes and improved performance for all gateway types.\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2015","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2015","description":"year#2015","dateCreated":"2023-11-09T14:13:24+0000","dateUpdated":"2023-11-09T14:13:24+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2015-09-introducing-tagging-support-for-aws-storage-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2015/09/introducing-tagging-support-for-aws-storage-gateway/","dateCreated":"2023-11-09T14:25:16+0000","dateUpdated":"2024-07-25T13:37:00+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e now allows you to tag your gateways, volumes, and virtual tapes. Tags are labels you can define and associate with your AWS resources, which provide filtering capabilities on operations such as generating AWS usage or cost reports. For example, you can use tags to allocate Storage Gateway costs and usage between departments in your organization. You can then view the Storage Gateway costs for a particular department over a period of time, or identify the department with the most Storage Gateway usage.\u003c/p\u003e\n\u003cp\u003e                    You can add or remove tags for your Storage Gateway resources by using the \u003ca href\u003d\"https://console.aws.amazon.com/\"\u003eAWS Management Console\u003c/a\u003e or \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/APIReference/API_Operations.html\"\u003eStorage Gateway APIs\u003c/a\u003e. To learn more about tagging support in Storage Gateway, please see \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/tagging-resources.html\"\u003eTagging Storage Gateway Resources\u003c/a\u003e in the AWS Storage Gateway User Guide.\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:49:34Z","headlineUrl":"/about-aws/whats-new/2015/09/introducing-tagging-support-for-aws-storage-gateway/","postDateTime":"2015-09-02T10:23:00Z","contentType":"Launch Announcement","headline":"Introducing Tagging Support for AWS Storage Gateway","postSummary":"\u003cp\u003e\u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e now allows you to tag your gateways, volumes, and virtual tapes. Tags are labels you can define and associate with your AWS resources, which provide filtering capabilities on operations such as generating AWS usage or cost reports. For example, you can use tags to allocate Storage Gateway costs and usage between departments in your organization. You can then view the Storage Gateway costs for a particular department over a period of time, or identify the department with the most Storage Gateway usage.\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#year#2015","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2015","description":"year#2015","dateCreated":"2023-11-09T14:13:24+0000","dateUpdated":"2023-11-09T14:13:24+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2015-06-aws-storage-gateway-support-for-dell-netvault-backup-100-with-gateway-vtl","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2015/06/aws-storage-gateway-support-for-dell-netvault-backup-100-with-gateway-vtl/","dateCreated":"2023-11-09T14:27:51+0000","dateUpdated":"2024-07-25T13:39:54+0000","additionalFields":{"postBody":"\u003cp\u003eToday, we are announcing support for Dell NetVault Backup 10.0 with AWS Storage Gateway-Virtual Tape Library (VTL). You can now backup and archive directly to scalable, cost-effective, secure Amazon S3 and Amazon Glacier storage using Gateway-VTL with NetVault Backup.\u003c/p\u003e\r\n\u003cp\u003eThis support applies to new and existing gateways created or updated as of the December 16, 2014, AWS Storage Gateway \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/MaintenanceManagingUpdate-vtl.html\"\u003emaintenance update\u003c/a\u003e. For the complete list of \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/Requirements.html#requirements-backup-sw-for-vtl\"\u003esupported backup applications\u003c/a\u003e and to get started, see the \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/gateway-vtl.html\"\u003eAWS Storage Gateway-VTL User Guide\u003c/a\u003e.\u003c/p\u003e\r\n\u003cp style\u003d\"text-align: center;\"\u003e\u003csup\u003eModified 12/22/2021 – In an effort to ensure a great experience, expired links in this post have been updated or removed from the original post.\u003c/sup\u003e\u003c/p\u003e\r\n","modifiedDate":"2021-12-22T23:58:15Z","headlineUrl":"/about-aws/whats-new/2015/06/aws-storage-gateway-support-for-dell-netvault-backup-100-with-gateway-vtl/","postDateTime":"2015-06-22T13:00:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway support for Dell NetVault Backup 10.0 with Gateway-VTL","postSummary":"\u003cp\u003eToday, we are announcing support for Dell NetVault Backup 10.0 with AWS Storage Gateway-Virtual Tape Library (VTL). You can now backup and archive directly to scalable, cost-effective, secure Amazon S3 and Amazon Glacier storage using Gateway-VTL with NetVault Backup.\u003c/p\u003e\r\n\u003cp\u003eThis support applies to new and existing gateways created or updated as of the December 16, 2014, AWS Storage Gateway \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/MaintenanceManagingUpdate-vtl.html\"\u003emaintenance update\u003c/a\u003e. For the complete list of \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/Requirements.html#requirements-backup-sw-for-vtl\"\u003esupported backup applications\u003c/a\u003e and to get started, see the \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/gateway-vtl.html\"\u003eAWS Storage Gateway-VTL User Guide\u003c/a\u003e.\u003c/p\u003e\r\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2015","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2015","description":"year#2015","dateCreated":"2023-11-09T14:13:24+0000","dateUpdated":"2023-11-09T14:13:24+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2015-06-create-larger-stored-volumes-up-to-16-tb-with-aws-storage-gateway","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2015/06/create-larger-stored-volumes-up-to-16-tb-with-aws-storage-gateway/","dateCreated":"2023-11-09T14:25:03+0000","dateUpdated":"2024-07-25T13:43:15+0000","additionalFields":{"postBody":"\u003cp\u003eYou can now create larger \u003ca href\u003d\"https://aws.amazon.com/storagegateway/details/#Gateway-Stored_Volumes\"\u003estored volumes\u003c/a\u003e (up to 16 TB) with \u003ca href\u003d\"https://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e. Gateway-Stored volumes enable durable and inexpensive off-site backups that can be recovered on-site to your hardware or within Amazon EC2. They provide low-latency access to your data, and asynchronously back up to Amazon S3 in the form of \u003ca href\u003d\"https://aws.amazon.com/ebs/\"\u003eAmazon EBS\u003c/a\u003e snapshots. With the support for larger volumes (up from 1 TB), you will spend less time on maintenance and operational tasks like splitting datasets, striping smaller volumes, or coordinating backups across multiple volumes.\u003c/p\u003e\n\u003cp\u003eAs of June 3, 2015, an updated virtual machine (VM) image is available for download from the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway\"\u003eAWS Management Console\u003c/a\u003e. For all existing gateways a \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/MaintenanceManagingUpdate.html\"\u003esoftware update\u003c/a\u003e has been made available containing this enhancement and \u003ca href\u003d\"http://aws.amazon.com/releasenotes/2240007937437937\"\u003eother important maintenance items\u003c/a\u003e. It can be applied manually through the Console or automatically during the gateway’s next scheduled weekly maintenance time.\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:49:21Z","headlineUrl":"/about-aws/whats-new/2015/06/create-larger-stored-volumes-up-to-16-tb-with-aws-storage-gateway/","postDateTime":"2015-06-03T20:00:00Z","contentType":"Launch Announcement","headline":"Create larger stored volumes (up to 16 TB) with AWS Storage Gateway","postSummary":"\u003cp\u003eYou can now create larger \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway/details/#Gateway-Stored_Volumes\"\u003estored volumes\u003c/a\u003e (up to 16 TB) with \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/storagegateway.html\"\u003eAWS Storage Gateway\u003c/a\u003e. Gateway-Stored volumes enable durable and inexpensive off-site backups that can be recovered on-site to your hardware or within Amazon EC2. They provide low-latency access to your data, and asynchronously back up to Amazon S3 in the form of \u003ca href\u003d\"/content/aws.amazon.com/live/en_US/ebs.html\"\u003eAmazon EBS\u003c/a\u003e snapshots. With the support for larger volumes (up from 1 TB), you will spend less time on maintenance and operational tasks like splitting datasets, striping smaller volumes, or coordinating backups across multiple volumes.\u003c/p\u003e\n\u003cp\u003eAs of June 3, 2015, an updated virtual machine (VM) image is available for download from the \u003ca href\u003d\"https://console.aws.amazon.com/storagegateway\"\u003eAWS Management Console\u003c/a\u003e. For all existing gateways a \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/MaintenanceManagingUpdate.html\"\u003esoftware update\u003c/a\u003e has been made available containing this enhancement and \u003ca href\u003d\"http://aws.amazon.com/releasenotes/2240007937437937\"\u003eother important maintenance items\u003c/a\u003e. It can be applied manually through the Console or automatically during the gateway’s next scheduled weekly maintenance time.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#year#2015","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2015","description":"year#2015","dateCreated":"2023-11-09T14:13:24+0000","dateUpdated":"2023-11-09T14:13:24+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2015-04-support-for-symantec-backup-exec-2015-with-aws-storage-gateways-virtual-tape-library-vtl","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2015/04/support-for-symantec-backup-exec-2015-with-aws-storage-gateways-virtual-tape-library-vtl/","dateCreated":"2023-11-09T14:20:00+0000","dateUpdated":"2024-07-25T13:46:30+0000","additionalFields":{"postBody":"\u003cp\u003eToday, we are announcing support for Symantec Backup Exec 15 with AWS Storage Gateway-Virtual Tape Library (VTL). You can now backup and archive directly to scalable, cost-effective, secure Amazon S3 and Amazon Glacier storage using Gateway-VTL with Backup Exec 15. For the complete list of \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/Requirements.html#requirements-backup-sw-for-vtl\" target\u003d\"_blank\"\u003esupported backup applications\u003c/a\u003e and to get started, see the \u003ca target\u003d\"_blank\" href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/gateway-vtl.html\"\u003eAWS Storage Gateway-VTL User Guide\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eAlso, AWS Storage Gateway is now included on the Symantec Hardware Compatibility Lists (HCLs). The \u003ca href\u003d\"http://www.backupexec.com/compatibility\" target\u003d\"_blank\"\u003eBackup Exec Hardware Compatibility List (HCL)\u003c/a\u003e includes both disk and tape targets for AWS Storage Gateway-Cached and Gateway-VTL respectively, while the \u003ca href\u003d\"http://www.netbackup.com/compatibility\" target\u003d\"_blank\"\u003eNetBackup Hardware Compatibility List (HCL)\u003c/a\u003e includes AWS Storage Gateway-VTL. This support applies to new and existing gateways that were created or updated as of the December 16, 2014 AWS Storage Gateway \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/MaintenanceManagingUpdate-vtl.html\" target\u003d\"_blank\"\u003emaintenance update\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eSincerely,\u003cbr\u003e\nThe AWS Storage Gateway Team\u003cbr\u003e\n\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:49:16Z","headlineUrl":"/about-aws/whats-new/2015/04/support-for-symantec-backup-exec-2015-with-aws-storage-gateways-virtual-tape-library-vtl/","postDateTime":"2015-04-06T11:30:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway support for Symantec Backup Exec 15 with Gateway-VTL and inclusion on Symantec\u0027s Hardware Compatibility List (HCL)","postSummary":"\u003cp\u003eToday, we are announcing support for Symantec Backup Exec 15 with AWS Storage Gateway-Virtual Tape Library (VTL). You can now backup and archive directly to scalable, cost-effective, secure Amazon S3 and Amazon Glacier storage using Gateway-VTL with Backup Exec 15. For the complete list of \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/Requirements.html#requirements-backup-sw-for-vtl\" target\u003d\"_blank\"\u003esupported backup applications\u003c/a\u003e and to get started, see the \u003ca target\u003d\"_blank\" href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/gateway-vtl.html\"\u003eAWS Storage Gateway-VTL User Guide\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eAlso, AWS Storage Gateway is now included on the Symantec Hardware Compatibility Lists (HCLs). The \u003ca href\u003d\"http://www.backupexec.com/compatibility\" target\u003d\"_blank\"\u003eBackup Exec Hardware Compatibility List (HCL)\u003c/a\u003e includes both disk and tape targets for AWS Storage Gateway-Cached and Gateway-VTL respectively, while the \u003ca href\u003d\"http://www.netbackup.com/compatibility\" target\u003d\"_blank\"\u003eNetBackup Hardware Compatibility List (HCL)\u003c/a\u003e includes AWS Storage Gateway-VTL. This support applies to new and existing gateways that were created or updated as of the December 16, 2014 AWS Storage Gateway \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/MaintenanceManagingUpdate-vtl.html\" target\u003d\"_blank\"\u003emaintenance update\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eSincerely,\u003cbr\u003e\nThe AWS Storage Gateway Team\u003cbr\u003e\n\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#year#2015","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2015","description":"year#2015","dateCreated":"2023-11-09T14:13:24+0000","dateUpdated":"2023-11-09T14:13:24+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2014-12-16-aws-storage-gateway-api-calls-are-now-available-in-aws-cloudtrail","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2014/12/16/aws-storage-gateway-api-calls-are-now-available-in-aws-cloudtrail/","dateCreated":"2023-11-09T14:23:49+0000","dateUpdated":"2024-07-25T13:41:23+0000","additionalFields":{"postBody":"\u003cp\u003eWe are pleased to announce \u003ca adhocenable\u003d\"false\" href\u003d\"http://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e is now integrated with AWS CloudTrail. AWS CloudTrail is a service that records AWS API calls for your account and delivers log files to you. With CloudTrail, you can get a history of AWS API calls for your account, including API calls made via the AWS Management Console, AWS SDKs, command line tools, and higher-level AWS services (such as AWS CloudFormation). The AWS API call history produced by CloudTrail enables security analysis, resource change tracking, and compliance auditing.\u003c/p\u003e\n\u003cp\u003eIf you are already using AWS CloudTrail you will start seeing Storage Gateway API calls in your CloudTrail log. If you haven\u0027t turned on AWS CloudTrail for your account, you can turn on CloudTrail from the AWS Management Console in as few as two clicks. There is no additional charge for CloudTrail, but standard rates for Amazon S3 and Amazon SNS usage apply. Please visit the \u003ca href\u003d\"http://aws.amazon.com/cloudtrail/\" adhocenable\u003d\"false\"\u003eAWS CloudTrail detail page\u003c/a\u003e or the \u003ca href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/logging-using-cloudtrail.html\" adhocenable\u003d\"false\"\u003eAWS Storage Gateway user guide\u003c/a\u003e to learn more.\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:48:47Z","headlineUrl":"/about-aws/whats-new/2014/12/16/aws-storage-gateway-api-calls-are-now-available-in-aws-cloudtrail/","postDateTime":"2014-12-16T15:15:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway API calls are now available in AWS CloudTrail","postSummary":"\u003cp\u003eWe are pleased to announce \u003ca adhocenable\u003d\"false\" href\u003d\"http://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e is now integrated with AWS CloudTrail. AWS CloudTrail is a service that records AWS API calls for your account and delivers log files to you. With CloudTrail, you can get a history of AWS API calls for your account, including API calls made via the AWS Management Console, AWS SDKs, command line tools, and higher-level AWS services (such as AWS CloudFormation). The AWS API call history produced by CloudTrail enables security analysis, resource change tracking, and compliance auditing.\u003c/p\u003e\n"}},"tags":[{"id":"whats-new-v2#general-products#aws-cloudtrail","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-cloudtrail","description":"general:products/aws-cloudtrail","dateCreated":"2023-11-09T13:56:12+0000","dateUpdated":"2023-11-09T13:56:12+0000"},{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#year#2014","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2014","description":"year#2014","dateCreated":"2023-11-09T14:11:54+0000","dateUpdated":"2023-11-09T14:11:54+0000"}]},{"item":{"id":"whats-new-v2#about-aws-whats-new-2014-11-03-aws-storage-gateway-support-for-veeam-and-microsoft-backup-applications","locale":"en_US","directoryId":"whats-new-v2","name":"/about-aws/whats-new/2014/11/03/aws-storage-gateway-support-for-veeam-and-microsoft-backup-applications/","dateCreated":"2023-11-09T14:13:08+0000","dateUpdated":"2024-07-25T13:28:43+0000","additionalFields":{"postBody":"\u003cp\u003e\u003ca adhocenable\u003d\"false\" href\u003d\"http://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e now supports backup applications from Veeam and Microsoft, in addition to updated versions from Symantec. You can use these to backup and archive with a Storage Gateway Virtual Tape Library (VTL) to the scalable, cost-effective, and secure Amazon S3 and Glacier storage.\u003cbr\u003e\n\u003c/p\u003e\n\u003cp\u003eFor the full list of \u003ca adhocenable\u003d\"false\" href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/Requirements.html#requirements-backup-sw-for-vtl\"\u003esupported backup applications\u003c/a\u003e, and to get started, visit the \u003ca adhocenable\u003d\"false\" href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/gateway-vtl.html\"\u003eAWS Storage Gateway-VTL user guide\u003c/a\u003e. An updated virtual machine (VM) image is available for download on November 3, 2014 from the \u003ca adhocenable\u003d\"false\" href\u003d\"https://console.aws.amazon.com/storagegateway\"\u003eAWS Management Console\u003c/a\u003e. For existing gateways a \u003ca adhocenable\u003d\"false\" href\u003d\"http://docs.aws.amazon.com/storagegateway/latest/userguide/MaintenanceManagingUpdate.html\"\u003esoftware update\u003c/a\u003e will be available on November 17, 2014, and can be applied through the Console or during the gateway’s next scheduled weekly maintenance time.\u003cbr\u003e\n\u003c/p\u003e\n","modifiedDate":"2019-10-06T04:48:50Z","headlineUrl":"/about-aws/whats-new/2014/11/03/aws-storage-gateway-support-for-veeam-and-microsoft-backup-applications/","postDateTime":"2014-11-03T13:24:00Z","contentType":"Launch Announcement","headline":"AWS Storage Gateway support for Veeam and Microsoft backup applications","postSummary":"\u003cp\u003e\u003ca adhocenable\u003d\"false\" href\u003d\"http://aws.amazon.com/storagegateway/\"\u003eAWS Storage Gateway\u003c/a\u003e now supports backup applications from Veeam and Microsoft, in addition to updated versions from Symantec. You can use these to backup and archive with a Storage Gateway Virtual Tape Library (VTL) to the scalable, cost-effective, and secure Amazon S3 and Glacier storage.\u003cbr\u003e\n\u003c/p\u003e\n"}},"tags":[{"id":"GLOBAL#content-type#launch-announcement","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Launch Announcement","description":"Launch Announcement","dateCreated":"2020-04-29T05:19:27+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"whats-new-v2#general-products#aws-storage-gateway","locale":"en_US","tagNamespaceId":"whats-new-v2#general-products","name":"aws-storage-gateway","description":"general:products/aws-storage-gateway","dateCreated":"2023-11-09T13:52:51+0000","dateUpdated":"2023-11-09T13:52:51+0000"},{"id":"whats-new-v2#resource-operating-system#windows","locale":"en_US","tagNamespaceId":"whats-new-v2#resource-operating-system","name":"windows","description":"resource:operating-system/windows","dateCreated":"2023-11-09T14:08:35+0000","dateUpdated":"2023-11-09T14:08:35+0000"},{"id":"whats-new-v2#year#2014","locale":"en_US","tagNamespaceId":"whats-new-v2#year","name":"2014","description":"year#2014","dateCreated":"2023-11-09T14:11:54+0000","dateUpdated":"2023-11-09T14:11:54+0000"}]}],"metadata":{"count":118,"totalHits":118},"fieldTypes":{"regionalAvailability":"LongText","nofollow":"Boolean","date":"Date","language":"Text","title":"Text","postDateTime":"DateTime","body":"Text","postSummary":"LongText","ctaLabel":"Text","mediaThumbnail":"Text","nosnippet":"Boolean","price":"Text","ctaLink":"URL","headline":"Text","contentType":"Text","bodyBack":"LongText","secondaryCTALabel":"Text","primaryCTALink":"URL","noindex":"Boolean","level":"Text","heading":"Text","mediaType":"Text","mediaAlt":"Text","headlineUrl":"Text","mediaSrc":"URL","durationMinutes":"Number","badge":"JSON","videoImageUrl":"URL","postBody":"LongText","secondaryCTALink":"URL","Video":"URL","modifiedDate":"DateTime","namePerson":"Text","location":"Text","time":"Text","publishedDate":"DateTime","durationReadtime":"Number","primaryCTALabel":"Text"}}