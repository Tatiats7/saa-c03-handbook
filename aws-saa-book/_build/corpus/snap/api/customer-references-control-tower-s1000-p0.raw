ateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#control-tower","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Control Tower","description":"AWS Control Tower","dateCreated":"2020-03-02T07:02:23+0000","dateUpdated":"2022-02-03T03:32:26+0000"},{"id":"GLOBAL#product#transitgateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Transit Gateway","description":"AWS Transit Gateway","dateCreated":"2020-03-02T07:05:54+0000","dateUpdated":"2022-02-03T03:33:05+0000"}]},{"item":{"id":"customer-references#amaysim-spot","locale":"en_US","directoryId":"customer-references","name":"amaysim-spot","dateCreated":"2022-01-29T03:26:08+0000","dateUpdated":"2022-01-29T03:29:04+0000","additionalFields":{"descriptionSummary":"Mobile virtual network operator amaysim adopted a solution on Amazon EC2 Spot Instances and Amazon ECS that saved it 75 percent on compute costs, improved resilience, and enhanced its user experience.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/amaysim-200-logo.153ff0a8ab33800978031421a457a1769b8f36ac.png","displayLocation":"Australia","footerInfoText":"Published Date","industry":"Telecommunications","sortDate":"2022-01-28","headlineUrl":"https://aws.amazon.com/solutions/case-studies/amaysim-spot/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"amaysim Saves 75% on Compute Costs by Running Amazon EC2 Spot Instances","customer-name":"amaysim"}},"tags":[{"id":"GLOBAL#location#australia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia","description":"Australia","dateCreated":"2020-02-03T05:29:12+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Auto Scaling","description":"AWS Auto Scaling","dateCreated":"2020-03-02T07:01:39+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#telecommunications","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Telecommunications","description":"Telecommunications","dateCreated":"2020-01-16T17:42:41+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Cont