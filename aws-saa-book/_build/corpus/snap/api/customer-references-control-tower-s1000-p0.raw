://aws.amazon.com/es/solutions/case-studies/universidad-el-bosque/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Universidad El Bosque","enableShare":"1","publishedDate":"2021","contentType":"Historia del cliente","headline":"Universidad El Bosque adopta AWS para enfrentar los retos de la actualidad"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#glacier","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon S3 Glacier","description":"Amazon S3 Glacier","dateCreated":"2020-03-02T07:03:38+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#workload#microsoft","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"Microsoft","description":"Microsoft","dateCreated":"2021-01-06T00:09:49+0000","dateUpdated":"2022-02-03T03:36:04+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#remote-work-learning","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Remote Work \u0026 Learning","description":"Remote Work \u0026 Learning","dateCreated":"2020-08-31T22:04:33+0000","dateUpdated":"2022-03-24T02:42:2