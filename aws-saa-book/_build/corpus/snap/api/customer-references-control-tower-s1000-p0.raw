eCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12T02:01:29+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"customer-references#category#cloud-operations","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cloud Operations","description":"\u003cp\u003eAWS Cloud Operations provides a model and tools for a secure and efficient way to operate in the cloud. This is an initiative, not a product.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:05:06+0000","dateUpdated":"2023-07-14T01:05:06+0000"},{"id":"customer-references#category#business-resilience","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Resilience","description":"\u003cp\u003eIn business, resilience means dealing with adversity and shocks, and continuously adapting for growth.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:01:43+0000","dateUpdated":"2023-07-14T01:01:43+0000"}]},{"item":{"id":"customer-references#grupo-boticario-case-study-from-pt-directory","locale":"en_US","directoryId":"customer-references","name":"grupo-boticario-case-study-from-pt-directory","dateCreated":"2024-02-03T03:48:28+0000","dateUpdated":"2024-02-06T01:35:36+0000","additionalFields":{"descriptionSummary":"Fundado há 45 anos, o Grupo Boticário é formado por diferentes negócios que atuam em sinergia para criar produtos, serviços e soluções capazes de entregar boas experiências e sentimentos positivos aos clientes.\n\nNos últimos dez anos, o grupo cresceu em ritmo acelerado – hoje é dono de mais de dez marcas, mantém cerca de 4.000 lojas distribuídas pelo Brasil e atua em mais de 50 países no mundo. Para garantir a continuidade e a saúde das operações, o grupo passou também pela modernização e expansão da sua área de tecnologia.\n\nDaniel Knopfholz, vice-presidente de gente e tecnologia do Grupo Boticário, e Renato Pedigoni, diretor de tecnologia do Grupo Boticário, contam como a adoção de serviços AWS ajudou a potencializar a integração de ativos, incluindo produtos e serviços digitais. Eles destacam o uso da arquitetura em nuvem para integrar operações de e-commerce a lojas físicas, bem como para acelerar a inovação e viabilizar o trabalho descentralizado de mais de 2.500 profissionais de TI do grupo.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/grupo-boticario%402x.1ece276b2d751776085648a557807913f902ff56.png","displayLocation":"Brasil","customerNameLower":"grupo boticário","footerInfoText":"Data de publicação","industry":"Varejo","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/grupo-boticario-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Grupo Boticário","enableShare":"1","publishedDate":"2023","contentType":"História do cliente","headline":"Com AWS, Grupo Boticário integra operações do e-commerce e de suas 4.000 lojas"}},"tags":[{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#security-hub","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Security Hub","description":"AWS Security Hub","dateCreated":"2020-03-02T07:05:15+0000","dateUpdated":"2022-02-03T03:32:59+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterpris