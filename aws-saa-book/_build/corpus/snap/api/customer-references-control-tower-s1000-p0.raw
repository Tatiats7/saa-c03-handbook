 based in Australia. The company is using Amazon EKS to orchestrate Kubernetes workloads, AWS CloudFormation to run infrastructure as code, and AWS Control Tower to standardize governance.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Kasada_logo%401x.6bbb2f985839e477b572d540899ba76045187602.png","displayLocation":"Australia","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-03-04","headlineUrl":"https://aws.amazon.com/solutions/case-studies/kasada/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","customer-name":"Kasada","contentType":"Customer Story","headline":"Kasada Modernizes for Faster Velocity and Scaling on AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#config","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Config","description":"AWS Config","dateCreated":"2020-03-02T07:02:20+0000","dateUpdated":"2022-02-03T03:32:26+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#location#australia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia","description":"Australia","dateCreated":"2020-02-03T05:29:12+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#security-hub","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Security Hub","description":"AWS Security Hub","dateCreated":"2020-03-02T07:05:15+0000","dateUpdated":"2022-02-03T03:32:59+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#tech-category#containers","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Containers","description":"Containers","dateCreated":"2020-02-13T00:27:17+0000","dateUpdated":"2022-02-03T03:35:26+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#guardduty","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon GuardDuty","description":"Amazon GuardDuty","dateCreated":"2020-03-02T07:03:46+0000","dateUpdated":"2022-02-03T03:32:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Auto Scaling","description":"AWS Auto Scaling","dateCreated":"2020-03-02T07:01:39+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#location#anz","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia \u0026 New Zealand","description":"Australia \u0026 New Zealand","dateCreated":"2020-04-09T00:26:11+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#control-tower","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Control Tower","description":"AWS Control Tower","dateCreated":"2020-03-02T07:02:23+0000","dateUpdated":"2022-02-03T03:32:26+0000"},{"id":"customer-references#category#saas","locale":"en_US","tagNamespaceId":"customer-references#category","name":"SaaS","description":"SaaS","dateCreated":"2019-07-22T18:32:20+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"customer-references#category#devops","locale":"en_US","tagNamespaceId":"customer-references#category","name":"DevOps","description":"DevOps","dateCreated":"2019-07-22T18:31:49+0000","dateUpdated":"2022-03-05T03:54:11+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#methodology#devops","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"DevOps","description":"DevOps","dateCreated":"2020-06-05T07:06:27+0000","dateUpdated":"2022-02-03T03:32:10+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#authority-brands-case-study","locale":"en_US","directoryId":"customer-references","name":"authority-brands-case-study","dateCreated":"2022-02-19T04:21:28+0000","dateUpdated":"2022-02-19T08:42:05+0000","additionalFields":{"descriptionSummary":"Authority Brands is a parent company that provides technical, financial, and business operations support for 10+ home improvement franchises and 1,900+ locations under its umbrella. The company was acquiring businesses at different levels of maturity and with disparate legacy infrastructures. By migrating to the cloud on AWS, Authority Brands has simplified these legacy environments, improved system availability and disaster recovery, and accelerated the onboarding of new acquisitions onto its system. Authority Brands used AWS Professional Services for support during the migration and AWS Migration Acceleration Program (AWS MAP) for funding, and it is using AWS Control Tower, AWS Identity and Access Management (AWS IAM), and other AWS security services to strengthen its security posture. The company is in the process of building out a data warehouse and analytics solution to deploy cross-marketing campaigns across its customer base, powered by machine learning.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Authority-Brands_Customer-Reference_Logo%401x.19b81a93672d0d2facfdd53f5ff2711412ff4f69.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Professional Services","sortDate":"2022-02-18","headlineUrl":"https://aws.amazon.com/solutions/case-studies/authority-brands-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Authority Brands Simplifies Infrastructure and Fortifies Security Posture by Migrating to AWS","customer-name":"Authority Brands"}},"tags":[{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#use-case#datacenter-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2020-08-18T05:17:48+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#industry#prof-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Professional Services","description":"Professional Services","dateCreated":"2020-06-25T04:07:49+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#control-tower","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Control Tower","description":"AWS Control Tower","dateCreated":"2020-03-02T07:02:23+0000","dateUpdated":"2022-02-03T03:32:26+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"}]},{"item":{"id":"customer-references#appway02092022infoinawinfgesion","locale":"en_US","directoryId":"customer-references","name":"appway02092022infoinawinfgesion","dateCreated":"2022-05-23T21:40:38+0000","dateUpdated":"2022-05-23T21:52:13+0000","additionalFields":{"descriptionSummary":"Learn how Appway leveraged AWS for Financial Institutions to setup their business workflows fast and secure. These sensitive workflows such as client onboarding require resources isolation and strong security policies. With AWS, Appway is able to set-up and manage isolated architecture where every customer has a dedicated AWS account with its own resources like compute and storage for maximum control, and flexibility.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/appway-logo%401x.1af4864fa20a41b230b4d2eaa8dc07df5fd02936.png","displayLocation":"Switzerland","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-02-09","headlineUrl":"https://youtu.be/2f_NYiPJQt4?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Appway: Securing Sensitive Banking Workflows with Isolated Architecture on AWS","customer-name":"Appway (Numcom Software AG)"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#reference-arch-diagram","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Reference Architecture Diagram","description":"Reference Architecture Diagram","dateCreated":"2020-04-29T05:19:31+0000","dateUpdated":"2022-02-03T03:31:09+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#switzerland","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Switzerland","description":"Switzerland","dateCreated":"2020-02-03T05:29:56+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#location#dach","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"DACH","description":"DACH","dateCreated":"2020-02-03T05:29:52+0000","dateUpdated":"2022-02-03T03:31:47+0000"},{"id":"GLOBAL#product#cognito","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Cognito","description":"Amazon Cognito","dateCreated":"2020-03-02T07:02:17+0000","dateUpdated":"2022-02-03T03:32:25+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#control-tower","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Control Tower","description":"AWS Control Tower","dateCreated":"2020-03-02T07:02:23+0000","dateUpdated":"2022-02-03T03:32:26+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#dish01312022lknsgiosfagsd","locale":"en_US","directoryId":"customer-references","name":"dish01312022lknsgiosfagsd","dateCreated":"2022-05-23T21:41:17+0000","dateUpdated":"2022-05-23T21:52:28+0000","additionalFields":{"descriptionSummary":"DISH Network is deploying the first standalone, cloud-based 5G network. To simplify and scale infrastructure delivery on AWS, DISH has built a self-service portal. New AWS account requests are created in an IT Service Management (ITSM) tool by internal users, and approved workflow requests kick off the Account factory service in AWS Control Tower from the root or management account. With Control Tower, new AWS accounts are created and standardized with baselines. After the new vended accounts are created, AWS Service Catalog provisions a new VPC in each vended account with tags and also allows for the deployment of resources such as Amazon EC2, Amazon EKS and Amazon RDS within the new VPC. AWS Serverless Transit Network Orchestrator (STNO) simplifies the Transit Gateway setup by automatically adding the VPCs tagged with configuration details in each vended account to the Transit Gateway setup in the Central Networking Account. AWS Transit Gateway acts as a central hub to connect the new vended accounts to a Central Networking account. With the self-service portal, DISH Network is able to provision several hundreds of accounts in only 6 months.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/dish-network-corporation-logo%401x.0f55e48c6176d1963443a4000c0061c795472eaa.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Telecommunications","sortDate":"2022-01-31","headlineUrl":"https://youtu.be/62E9ggjGS8I?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"DISH Network: Building a Self-Service Portal to Create Multiple Accounts at Scale","customer-name":"Dish Network Corporation"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#content-type#reference-arch-diagram","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Reference Architecture Diagram","description":"Reference Architecture Diagram","dateCreated":"2020-04-29T05:19:31+0000","dateUpdated":"2022-02-03T03:31:09+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#telecommunications","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Telecommunications","description":"Telecommunications","dateCreated":"2020-01-16T17:42:41+0000","dateUpdated":"2022-