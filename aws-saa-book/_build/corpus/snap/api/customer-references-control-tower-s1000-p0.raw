pdated":"2022-02-03T03:32:51+0000"},{"id":"GLOBAL#product#deep-learning-containers","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Deep Learning Containers","description":"AWS Deep Learning Containers","dateCreated":"2020-03-02T07:02:37+0000","dateUpdated":"2022-02-03T03:32:28+0000"},{"id":"GLOBAL#product#xray","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS X-Ray","description":"AWS X-Ray","dateCreated":"2020-03-03T00:18:27+0000","dateUpdated":"2022-02-03T03:33:08+0000"},{"id":"GLOBAL#product#migration-hub","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Migration Hub","description":"AWS Migration Hub","dateCreated":"2020-03-02T07:04:36+0000","dateUpdated":"2022-02-03T03:32:51+0000"},{"id":"GLOBAL#product#mgmt-console","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Management Console","description":"AWS Management Console","dateCreated":"2020-03-02T07:04:33+0000","dateUpdated":"2022-02-03T03:32:50+0000"},{"id":"GLOBAL#product#personalize","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Personalize","description":"Amazon Personalize","dateCreated":"2020-03-02T07:04:50+0000","dateUpdated":"2022-02-03T03:32:54+0000"},{"id":"GLOBAL#product#ivs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Interactive Video Service","description":"Amazon Interactive Video Service","dateCreated":"2020-11-20T00:43:24+0000","dateUpdated":"2022-02-03T03:32:44+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#nexity","locale":"en_US","directoryId":"customer-references","name":"nexity","dateCreated":"2023-07-18T00:09:30+0000","dateUpdated":"2023-08-11T22:26:57+0000","additionalFields":{"videoSrcUrl":"https://youtu.be/50oVXmybLhM","descriptionSummary":"\u003cp\u003ePort\u0026eacute; par une conviction forte que l\u0026#39;IT doit se concentrer sur des activit\u0026eacute;s diff\u0026eacute;renciantes \u0026agrave; forte valeur ajout\u0026eacute;e, Nexity a engag\u0026eacute; depuis 2016 un virage \u0026agrave; 180\u0026deg; vers le cloud. En utilisant les services manag\u0026eacute;s AWS, le groupe a pu r\u0026eacute;aliser des gains significatifs en termes d\u0026#39;agilit\u0026eacute; et de performance, tout en r\u0026eacute;duisant les co\u0026ucirc;ts ainsi que son empreinte carbone.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Nexity%20-%20logo.072051fcd1e2b9b9b77f45e38878c25c3bccf15f.png","displayLocation":"Europe, Moyen-Orient et Afrique","footerInfoText":"Date de publication","industry":"Construction et immobilier","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/nexity/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Nexity","enableShare":"1","publishedDate":"2021","contentType":"Témoignages clients","headline":"Nexity propulse sa Direction des Solutions et Innovations Numériques dans le cloud avec AWS"}},"tags":[{"id":"GLOBAL#product#robomaker","locale":"en_US","t