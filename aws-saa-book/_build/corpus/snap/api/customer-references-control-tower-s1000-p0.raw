T03:31:15+0000"}]},{"item":{"id":"customer-references#grupo-quimmco","locale":"en_US","directoryId":"customer-references","name":"grupo-quimmco","dateCreated":"2023-06-01T23:08:12+0000","dateUpdated":"2023-06-08T04:07:37+0000","additionalFields":{"descriptionSummary":"Grupo Quimmco es un consorcio industrial con negocios establecidos en la industria metal-mecánica en México. Con la visión de crear un ecosistema digital colaborativo inteligente, confiable y seguro, bajo estándares internacionales, que permita evolucionar sus empresas a formatos digitales, Grupo Quimmco eligió a Amazon Web Services para acelerar su proceso de adopción y madurez de nube, de una estrategia on-premises, a una de aplicaciones nativas de nube. De esta manera, se convirtió en una de las primeras empresas Latinoamericanas en su ramo en entrar a este ecosistema de constante innovación.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/quimmco_logo%401x.32966bbe1b48c14c26c0e2daa919efa830731ac8.png","displayLocation":"México","footerInfoText":"Fecha de publicación","industry":"Fabricación","sortDate":"2021-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/grupo-quimmco/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"Historia del cliente","customer-name":"Grupo Quimmco","headline":"Grupo Quimmco estima ahorro del 5% al 10% con migración de sistemas a la nube AWS"}},"tags":[{"id":"GLOBAL#location#central-america","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central America","description":"Central America","dateCreated":"2021-02-19T05:32:25+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-ty