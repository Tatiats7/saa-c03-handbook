,"name":"AWS Control Tower","description":"AWS Control Tower","dateCreated":"2020-03-02T07:02:23+0000","dateUpdated":"2022-02-03T03:32:26+0000"},{"id":"GLOBAL#product#shield","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Shield","description":"AWS Shield","dateCreated":"2020-03-02T07:05:24+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#product#global-accelerator","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Global Accelerator","description":"AWS Global Accelerator","dateCreated":"2020-03-02T07:03:39+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"customer-references#category#gaming","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gaming","description":"Gaming","dateCreated":"2019-07-22T18:31:55+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"GLOBAL#location#nordics","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Nordics","description":"Nordics","dateCreated":"2020-02-03T05:30:04+0000","dateUpdated":"2022-02-03T03:31:50+0000"}]},{"item":{"id":"customer-references#blackboard06132022lorfgpkjl","locale":"en_US","directoryId":"customer-references","name":"blackboard06132022lorfgpkjl","dateCreated":"2023-02-08T01:16:33+0000","dateUpdated":"2023-02-08T01:38:42+0000","additionalFields":{"descriptionSummary":"In this episode, learn how Blackboard, now part of Anthology, operates and governs its 120+ AWS accounts. You\u0027ll see how they use AWS Control Tower to build and govern a multi-account environment that follows best practices. Control Tower helps them leverage AWS Service Catalog to vend accounts into their AWS Organization, AWS Config to control and detect changes to AWS resources, AWS CloudTrail for centralized logging, and AWS Single Sign-on (SSO) for federated login and integration with their 3rd-party identity provider, Okta.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Blackboard_Customer-Reference_Logo.5843214d78364555b7a920bd7e563e05075333a3.png","displayLocation":"United States","customerNameLower":"blackboard inc.","footerInfoText":"Published Date","industry":"Education","sortDate":"2022-06-13","headlineUrl":"https://youtu.be/jzKCg9Z5_8Q?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Blackboard Inc.","publishedDate":"2022","enableShare":"1","headline":"Blackboard/Anthology: Building and Governing an AWS Environment with 120+ Accounts","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#control-tower","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Control Tower","description":"AWS Control Tower","dateCreated":"2020-03-02T07:02:23+0000","dateUpdated":"2022-02-03T03:32:26+0000"},{"id":"GLOBAL#product#sso","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS IAM Identity Center","description":"\u003cp\u003eUpdated from AWS Single Sign-On (SSO) to\u0026nbsp;AWS IAM Identity Center on 8/1/2022 per request of @handans\u003c/p\u003e\n","dateCreated":"2020-03-02T07:05:37+0000","d