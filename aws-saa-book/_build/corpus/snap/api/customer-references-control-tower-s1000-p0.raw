gets","dateCreated":"2020-03-02T07:01:44+0000","dateUpdated":"2022-02-03T03:32:19+0000"},{"id":"GLOBAL#product#sumerian","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Sumerian","description":"Amazon Sumerian","dateCreated":"2020-03-02T07:05:42+0000","dateUpdated":"2022-02-03T03:33:03+0000"},{"id":"GLOBAL#product#elemental-mediatailor","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental MediaTailor","description":"AWS Elemental MediaTailor","dateCreated":"2020-03-02T07:03:20+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#product#resilience-hub","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Resilience Hub","description":"AWS Resilience Hub","dateCreated":"2021-11-17T07:15:55+0000","dateUpdated":"2022-02-03T03:32:57+0000"},{"id":"GLOBAL#product#cloud9","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Cloud9","description":"AWS Cloud9","dateCreated":"2020-03-02T07:01:52+0000","dateUpdated":"2022-02-03T03:32:21+0000"},{"id":"GLOBAL#product#cloudtrail","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudTrail","description":"AWS CloudTrail","dateCreated":"2020-03-02T07:02:05+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#product#elasticache-redis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache for Redis","description":"Amazon ElastiCache for Redis","dateCreated":"2020-03-03T00:16:59+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#behavox-case-study","locale":"en_US","directoryId":"customer-references","name":"behavox-case-study","dateCreated":"2022-04-09T03:07:40+0000","dateUpdated":"2022-04-11T21:32:28+0000","additionalFields":{"descriptionSummary":"Security solution provider Behavox needed a unified, multiaccount strategy to support its growth. The company built a solution using AWS Organizations, enhancing security and facilitating agility.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/behavox-logo%401x.45b1fddfae92ceea7b54611f7f6b299cae8d3661.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-04-08","headlineUrl":"https://aws.amazon.com/solutions/case-studies/behavox-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Behavox Scales to Support Institutions with 100,000 Employees on AWS Organizations and AWS Identity Services","customer-name":"Behavox"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#sso","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS IAM Identity Center","description":"\u003cp\u003eUpdated from AWS Single Sign-On (SSO) to\u0026nbsp;AWS IAM Identity Center on 8/1/2022 per request of @handans\u003c/p\u003e\n","dateCreated":"2020-03-02T07:05:37+0000","dateUpdated":"2022-08-01T21:13:32+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#organizations","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Organizations","description":"AWS Organizations","dateCreated":"2020-03-02T07:04:43+0000","dateUpdated":"2022-02-03T03:32:53+0000"},{"id":"GLOBAL#product#guardduty","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon GuardDuty","description":"Amazon GuardDuty","dateCreated":"2020-03-02T07:03:46+0000","dateUpdated":"2022-02-03T03:32:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:4