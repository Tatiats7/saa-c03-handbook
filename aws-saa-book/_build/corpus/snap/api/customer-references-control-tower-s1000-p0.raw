age is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#bpx-energy","locale":"en_US","directoryId":"customer-references","name":"bpx-energy","dateCreated":"2020-12-22T22:14:57+0000","dateUpdated":"2023-08-11T00:24:48+0000","additionalFields":{"featured":"0","featureImageURL":"https://d1.awsstatic.com/bp_300x205_2022.73d2aa4e7c1aeb23955db8af66f506a3c106c5f7.png","descriptionSummary":"Using AWS services, bpx energy shed its legacy operations technology infrastructure and moved to the cloud, lowering operating expenses, maximizing production, and decreasing methane emissions.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/bpx-logo%401x.9588f229506a47b7b3f994e08877000922def856.png","displayLocation":"United States","customerNameLower":"bpx energy","footerInfoText":"Published Date","description":"\u003cp\u003eMaximizing production and decreasing methane emissions to become a net-zero company\u003c/p\u003e\n","industry":"Oil \u0026 Gas","sortDate":"2020-12-28","headlineUrl":"https://aws.amazon.com/solutions/case-studies/bpx-energy/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"bpx energy","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Maximizing production and decreasing methane emissions to become a net-zero company"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCr