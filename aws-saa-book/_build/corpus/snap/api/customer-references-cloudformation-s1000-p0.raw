T02:01:29+0000"}]},{"item":{"id":"customer-references#the-mill-adventure","locale":"en_US","directoryId":"customer-references","name":"the-mill-adventure","dateCreated":"2023-05-31T23:29:48+0000","dateUpdated":"2024-11-13T19:59:17+0000","additionalFields":{"descriptionSummary":"Based in Malta, The Mill Adventure provides comprehensive and customizable, turnkey iGaming solutions. Its functionality includes everything from licenses and support for meeting compliance demands, to operations and business intelligence. Using AWS, the company built a serverless, business-to-business iGaming platform that can deliver a personalized and responsible experience for players. Since its inception, The Mill Adventure is on track to double its customer base year-on-year and has reduced the time it usually takes to onboard customers from months to weeks. Innovation happens quickly at the company with over 10,000 product updates released in just 3 years.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/the-mill-adventure-logo%401x.8f22709d1e655633f4295f2d29d958a29e399323.png","displayLocation":"Malta","customerNameLower":"the mill adventure","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2023-05-22","headlineUrl":"https://aws.amazon.com/solutions/case-studies/the-mill-adventure/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"The Mill Adventure","publishedDate":"2023","enableShare":"1","headline":"The Mill Adventure Delivers Personalized iGaming Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#location#malta","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Malta","description":"Malta","dateCreated":"2020-04-09T0