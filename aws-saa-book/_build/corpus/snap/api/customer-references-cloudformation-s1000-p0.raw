ated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#bayer-case-study","locale":"en_US","directoryId":"customer-references","name":"bayer-case-study","dateCreated":"2022-07-16T00:00:33+0000","dateUpdated":"2024-03-02T02:48:50+0000","additionalFields":{"descriptionSummary":"To help Brazilian farmers adopt climate–smart agricultural practices and reduce carbon emissions in their activities, Bayer created the Carbon Program, which aims to build carbon neutral agriculture practices. The initiative is part of the company\u0027s commitment to reduce greenhouse gas (GHG) emissions by 30 percent in the agricultural sector by 2030. To centralize and standardize the data received from the different partners involved in the project, Bayer uses Amazon Web Services (AWS) to have the scalability and agility the project needs.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/BayerCropScience_Customer-Reference_Logo.5c397f30902a323a26d59af8d39d8196f059023b.png","displayLocation":"Brazil","customerNameLower":"bayer s/a.","footerInfoText":"Published Date","industry":"General Public Services","sortDate":"2022-07-15","headlineUrl":"https://aws.amazon.com/solutions/case-studies/bayer-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Bayer S/A.","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Bayer Centralizes and Standardizes Data from the Carbon Program Using AWS"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description