000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"}]},{"item":{"id":"customer-references#visma","locale":"en_US","directoryId":"customer-references","name":"visma","dateCreated":"2020-01-23T22:00:47+0000","dateUpdated":"2021-12-22T22:34:45+0000","additionalFields":{"featured":"0","descriptionSummary":"Visma migrates critical Windows workloads to AWS and increases new feature releases from six yearly to more than six monthly, cuts deployment time from 30 minutes to 5 minutes, and increases the customer base for one application by four times. Headquartered in Oslo, Norway, the company is a leading provider of cloud-based business applications. Visma moved many of its .NET applications to AWS, relying on Amazon Aurora MySQL, Amazon EC2, and AWS CloudFormation.","imageSrcUrl":"https://d1.awsstatic.com/events/Nordics/visma.fd0b746d073b0ad4eba5aba526fb78a567065693.png","displayLocation":"Norway","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/visma-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Visma","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Visma Migrates Windows Workloads to AWS to Enable Agility and Spee