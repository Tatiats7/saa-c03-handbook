le":"en_US","directoryId":"customer-references","name":"itom","dateCreated":"2024-08-08T15:00:53+0000","dateUpdated":"2024-08-08T15:23:48+0000","additionalFields":{"descriptionSummary":"iTom is a software development company based in Romania that creates innovative SaaS solutions to help the digitalization efforts of its customers. When it expanded into financial services, it turned to AWS to provide high levels of security and ensure compliance with European and local regulations. Using AWS, iTom can better manage its infrastructure and prevent unauthorized or accidental access to customer data by potential intruders or even its own staff. It has also improved its development processes so its entire team can proactively innovate and update features that improve the customer experience, rather than spending time maintaining infrastructure and reacting to problems.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/itom-logo%401x.df0dbd92571e831c23225ba42d0dc44bde7b3aca.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"i-tom solutions","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-10-06","headlineUrl":"https://aws.amazon.com/solutions/case-studies/itom-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"i-Tom Solutions","publishedDate":"2022","enableShare":"1","headline":"iTom Boosts Business and Scales for Growth Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#documentdb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DocumentDB","description":"Amazon DocumentDB","dateCreated":"2020-03-02T07:02:46+0000","dateUpdated":"2022-02-03T03:32:30+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:4