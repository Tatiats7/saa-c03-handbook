oudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#customer-segment#non-profit","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Non-profit","description":"Non-profit","dateCreated":"2021-06-04T06:35:44+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#zyxel-case-study","locale":"en_US","directoryId":"customer-references","name":"zyxel-case-study","dateCreated":"2019-07-22T19:58:33+0000","dateUpdated":"2022-09-13T22:44:49+0000","additionalFields":{"featured":"0","descriptionSummary":"ZyXEL is a world-class networking company providing innovative and reliable internet solutions to businesses worldwide. Searching for a cost-effective CDN solution, the company turned to AWS and uses Amazon CloudFront to deliver website content to users with high availability and low latency.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Zyxel_Customer-Reference_Logo.9068dd663a5ce7d21113eec9a3944498bc2e73d8.png","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003eZyXEL is a world class networking company providing innovative and reliable Internet solutions to businesses worldwide. Searching for a cost-effective CDN solution, the company turned to AWS and uses Amazon CloudFront to deliver website content to users with high availability and low latency. By moving to AWS, ZyXEL has reduced its CDN costs by 99%.\u003c/p\u003e\r\n","industry":"Electronics","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/zyxel/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ZyXel","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"ZyXel Case Study"}},"tags":[{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#taiwan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Taiwan","description":"Taiwan","dateCreated":"2020-02-03T05:29:38+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale"