2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#lake-formation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lake Formation","description":"AWS Lake Formation","dateCreated":"2020-03-02T07:04:18+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#database-migration-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Database Migration Service (DMS)","description":"AWS Database Migration Service (DMS)","dateCreated":"2020-03-02T07:02:30+0000","dateUpdated":"2022-02-03T03:32:27+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#btobet-case-study","locale":"en_US","directoryId":"customer-references","name":"btobet-case-study","dateCreated":"2022-10-03T18:33:44+0000","dateUpdated":"2022-10-11T21:03:06+0000","additionalFields":{"descriptionSummary":"Betting on sporting events from the Olympics to Premier League soccer matches is a billion-dollar market characterized by surges in customer demand around live events. BtoBet provides betting and gambling businesses with its sportsbook solution, allowing individuals to place bets on sporting events. Since migrating to AWS, BtoBet can scale compute resources to handle spikes in demand and deliver a responsive experience for its partners and their players. It has also launched in new global markets and has the resources to support triple-digit customer growth. Using AWS, the company can manage double the volume of betting transactions without expanding its IT team.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/btobet-logo%401x.4df0a2219e8e635f58051432a3203b73a47807fd.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"btobet","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/BtoBet-Case-Study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"BtoBet","publishedDate":"2022","enableShare":"1","headline":"BtoBet Processes Trillions of Betting Requests, Boosts Customer Loyalty Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#malta","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Malta","description":"Malta","dateCreated":"2020-04-09T03:37:12+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#containers","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Containers","description":"Containers","dateCreated":"2020-02-13T00:27:17+0000","dateUpdated":"2022-02-03T03:35:26+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#cee","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central \u0026 Eastern Europe","description":"Central \u0026 Eastern Europe","dateCreated":"2020-03-10T05:12:39+0000","dateUpdated":"2022-02-03T03:31:41+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category"