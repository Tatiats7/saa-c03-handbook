category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#methodology#devops","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"DevOps","description":"DevOps","dateCreated":"2020-06-05T07:06:27+0000","dateUpdated":"2022-02-03T03:32:10+0000"},{"id":"GLOBAL#location#canada","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Canada","description":"Canada","dateCreated":"2020-02-03T05:29:05+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"customer-references#category#devops","locale":"en_US","tagNamespaceId":"customer-references#category","name":"DevOps","description":"DevOps","dateCreated":"2019-07-22T18:31:49+0000","dateUpdated":"2022-03-05T03:54:11+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#codedeploy","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodeDeploy","description":"AWS CodeDeploy","dateCreated":"2020-03-02T07:02:12+0000","dateUpdated":"2022-02-03T03:32:24+0000"},{"id":"GLOBAL#tech-category#devtools","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Developer Tools","description":"Developer Tools","dateCreated":"2020-01-16T17:43:16+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-brooks-brothers","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-brooks-brothers","dateCreated":"2019-07-22T19:45:53+0000","dateUpdated":"2023-07-14T23:32:46+0000","additionalFields":{"descriptionSummary":"Brooks Brothers is the oldest men\u0027s clothier in the United States, offering stylish modern clothing and fresh takes on heritage designs. Brooks Brothers frequently launches new business initiatives, which helps the company stay competitive in the retail industry. The organization needed a more agile way of quickly testing these new projects. The organization was also seeking a more cost-effective way to manage its SAP HANA in-memory database management system, which would support a new customer relationship management (CRM) application.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/BrooksBrothers_Customer-Reference_Logo.2ab61cc5ece0ef7654f175f9063872b2476ea4e5.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"Brooks Brothers is a leading U.S. retailer of fashion wear and accessories. The company is running key business-critical SAP applications powered by HANA on AWS. Now, the organization can use AWS to launch and test new SAP software based retail projects in hours instead of weeks, save thousands on hardware costs, and focus more on new initiatives that drive revenue.","industry":"Retail","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/brooks-brothers/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Brooks Brothers","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"AWS Case Study: Brooks Brothers"}},"tags":[{"id":"customer-references#category#dev-and-test","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dev \u0026 Test","description":"Dev \u0026 Test","dateCreated":"2019-07-22T18:31:47+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#category#business-applications-sap","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: SAP","descripti