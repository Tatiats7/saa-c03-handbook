tion#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#uk","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United Kingdom","description":"United Kingdom","dateCreated":"2020-02-03T05:30:18+0000","dateUpdated":"2022-02-03T03:31:52+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#ec2-auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Auto Scaling","description":"Amazon EC2 Auto Scaling","dateCreated":"2020-03-02T07:02:53+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#location#ukir","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"UK/IR","description":"UK/IR","dateCreated":"2020-02-19T23:06:44+0000","dateUpdated":"2022-02-03T03:31:51+0000"},{"id":"customer-references#category#network","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2019-07-22T18:32:15+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#buildigo-case-study","locale":"en_US","directoryId":"customer-references","name":"buildigo-case-study","dateCreated":"2022-08-08T21:23:19+0000","dateUpdated":"2022-08-08T21:24:12+0000","additionalFields":{"descriptionSummary":"Buildigo offers an easy way to link homeowners and renters with local craftspeople who can work on their houses and gardens. The Swiss startupneeds to quickly scale its IT systems as customer demand increaseswhile minimizingcosts andmaintenance tasks for its small team. It built its platform on AWS, runningits customer-facing website, databases,data lake, and development pipeline in the AWS cloud.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/buildigo-logo%401x.226ee28f36f6693db35bc3d567e971bb4267d47e.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"buildigo","footerInfoText":"Published Date","industry":"S