:"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#location#nordics","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Nordics","description":"Nordics","dateCreated":"2020-02-03T05:30:04+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#norway","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Norway","description":"Norway","dateCreated":"2020-02-03T05:30:09+0000","dateUpdated":"2022-02-03T03:31:51+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#aws-case-study-worldreader","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-worldreader","dateCreated":"2019-07-22T19:57:23+0000","dateUpdated":"2022-01-21T02:42:47+0000","additionalFields":{"featured":"0","descriptionSummary":"Worldreader, a non-profit organization dedicated to bringing books to children in developing countries, teamed up with soccer team FC Barcelona to send 1 million e-books to kids in Africa. The organization needed a world-class website to accept donations and handle spikes in traffic. Working with AWS and Transcend Computing, Worldreader had its site up and running in only three days.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Worldreader_Customer-Reference_Logo.cd8db6e1914f157bd72a7059d892977feda55995.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eWorldreader, a non-profit organization dedicated to bringing books to children in developing parts of the world, teamed up with internationally acclaimed soccer team FC Barcelona to help raise enough money by December 31, 2012 to send 1 million e-books to boys and girls in Africa. Given the importance of the cause and popularity of FC Barcelona, Worldreader knew that they needed a world-class website to handle the increase in traffic. Working with Amazon Web Services (AWS) and Transcend Computing, Worldreader had its site up and running in only three days without having to sacrifice valuable donations to make a large upfront investment in costly infrastructure.\u003c/p\u003e\r\n","industry":"Government","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/worldreader/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Worldreader","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"AWS Case Study: Worldreader"}},"tags":[{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u00