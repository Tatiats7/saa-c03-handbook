ame":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#product#managed-services","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Managed Services","description":"AWS Managed Services","dateCreated":"2020-03-02T07:04:31+0000","dateUpdated":"2022-02-03T03:32:50+0000"},{"id":"customer-references#category#finserv","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Financial Services","description":"Financial Services","dateCreated":"2019-07-22T18:31:53+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#anz","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia \u0026 New Zealand","description":"Australia \u0026 New Zealand","dateCreated":"2020-04-09T00:26:11+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#picpay","locale":"en_US","directoryId":"customer-references","name":"picpay","dateCreated":"2023-06-01T23:07:58+0000","dateUpdated":"2023-08-11T00:24:47+0000","additionalFields":{"descriptionSummary":"Criado em 2012, o PicPay, pioneiro no mercado de carteiras digitais e no uso do QR Code no país, vem dando saltos de crescimento desde então. Desde sua fundação a companhia utiliza a infraestrutura AWS para suportar seus serviços, que atendiam 400 mil usuários até 2017, chegou a 7 milhões de usuários em 2018 e a 38 milhões de usuários ao longo de 2020. Agora, a companhia ultrapassa os 50 milhões de clientes e prepara-se para se tornar o mais completo e eficiente super-app nacional.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/picpay-logo%402x.fcb5bf3f7c00a07aecde7f58d8ab1ef7088d6b06.png","displayLocation":"Brasil","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/picpay/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Picpay","enableShare":"1","publishedDate":"2021","contentType":"História do cliente","headline":"Tecnologia AWS pavimenta jornada do PicPay para tornar-se um super-app"}},"tags":[{"id":"GLOBAL#product#cloudtrail","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudTrail","description":"AWS CloudTrail","dateCreated":"2020-03-02T07:02:05+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u