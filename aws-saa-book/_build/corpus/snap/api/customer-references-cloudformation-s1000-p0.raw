mer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#chile","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Chile","description":"Chile","dateCreated":"2020-07-02T22:30:55+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#telecomargentina","locale":"en_US","directoryId":"customer-references","name":"telecomargentina","dateCreated":"2023-06-01T23:05:33+0000","dateUpdated":"2023-06-08T04:07:41+0000","additionalFields":{"descriptionSummary":"Telecom Argentina es una empresa líder de soluciones de conectividad y entretenimiento con más de 23.000 colaboradores. Ofrece a más de 29 millones de clientes individuales, empresas e instituciones de todo el país servicio seguro, flexible y dinámico, en todos sus dispositivos, con conexiones fijas y móviles de alta velocidad, y una plataforma de contenidos en vivo y a demanda que integra series, películas, gaming, música y programas de TV. En la actualidad está transitando un camino de profunda transformación digital de sus operaciones y de su cultura, en la que la cloudificación resulta uno de los principales habilitadores tecnológicos.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/telecom_logo%401x.9e357acae61471fdcc122f4a221253c1ca8ba99d.png","displayLocation":"Argentina","customerNameLower":"telecom argentina","footerInfoText":"Fecha de publicación","industry":"Telecomunicaciones","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/telecomargentina/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Telecom Argentina","enableShare":"1","publishedDate":"2020","contentType":"Historia del cliente","headline":"Telecom Argentina inicia su estrategia de cloud hibrida con AWS"}},"tags":[{"id":"GLOBAL#product#elastic-beanstalk","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elastic Beanstalk","description":"AWS Elastic Beanstalk","dateCreated":"2020-03-02T07:03:00+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#product#mgmt-console","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Management Console","description":"AWS Management Console","dateCreated":"2020-03-02T07:04:33+0000","dateUpdated":"2022-02-03T03:32:50+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","n