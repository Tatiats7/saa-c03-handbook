":"GLOBAL#industry","name":"Automotive","description":"Automotive","dateCreated":"2020-01-16T17:42:11+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#product#cloudsearch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudSearch","description":"Amazon CloudSearch","dateCreated":"2020-03-02T07:02:03+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-futbol-club-barcelona","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-futbol-club-barcelona","dateCreated":"2019-07-22T19:55:00+0000","dateUpdated":"2021-12-22T18:48:51+0000","additionalFields":{"featured":"0","descriptionSummary":"Futbol Club Barcelona (FCBarcelona) is a highly popular soccer team based in Barcelona, Spain. In order to maintain the FCBarcelona website—which boasts over 6,000 pages and over 12,000 digitized photos, and is available in six languages—FCBarcelona\u0027s partner, Gnuine, uses a number of Amazon Web Services products to host Ubiquo Sports, a specialized SaaS CMS: Amazon Route 53, Amazon CloudFront, Amazon S3, Amazon EC2, Elastic Load Balancing, Amazon CloudWatch, Amazon SNS, Amazon RDS, and AWS CloudFormation.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/FCBARCELONA_Customer-Reference_Logo.cbaf57e2a559c99f1c7d8adb74a9e948d6be012a.png","displayLocation":"Spain","footerInfoText":"Published Date","description":"\u003cp\u003eFutbol Club Barcelona (FCBarcelona) is a highly popular soccer team based in Barcelona, Spain. In order to maintain the FCBarcelona website\u0014which boasts over 6,000 pages and over 12,000 digitized photos, and is available in six languages\u0014FCBarcelona\u0019s partner, Gnuine, uses a number of Amazon Web Services (AWS) products to host Ubiquo Sports, a specialized SaaS CMS: Amazon Route 53, Amazon CloudFront, Amazon Simple Storage Service (Amazon S3), Amazon Elastic Compute Cloud (Amazon EC2), Amazon Elastic Load Balancing (Amazon ELB), Amazon CloudWatch, Amazon Simple Notification Service (Amazon SNS), Amazon Relational Database Service (Amazon RDS), and Amazon CloudFormation.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/futbol-club-barcelona/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Futbol Club Barcelona","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Futbol Club Barcelona"}},"tags":[{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applicati