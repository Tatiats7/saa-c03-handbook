":"2022-02-03T03:32:32+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"}]},{"item":{"id":"customer-references#itau-contas","locale":"en_US","directoryId":"customer-references","name":"itau-contas","dateCreated":"2023-06-01T23:06:19+0000","dateUpdated":"2023-08-11T00:24:48+0000","additionalFields":{"descriptionSummary":"Ao adotar a estratégia de modernização e migração de aplicações críticas para a nuvem, a área de Engenharia de Cloud do Itaú Unibanco estabeleceu como objetivo prover Cloud AWS como autosserviço para as áreas de Engenharia consumidoras da plataforma. Utilizando a abordagem de micro segmentação de contas, um dos desafios envolvidos era a automação do processo de criação de contas. No início esse processo levava em média 60 horas e, com o apoio da AWS, a instituição financeira conseguiu automatizar 100% do processo de criação de contas, reduzindo seu prazo para 1h20.","featureImageURL":"https://d1.awsstatic.com/industry-images-customer-references/bancolombia-industry-image.1856e5563e1c47a4c8b7ad9fd5337c771e92a7a4.jpg","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/itau-logo%402x.cc96e60df104954c8960737a54830d300847fb5a.png","displayLocation":"Brasil","customerNameLower":"itaú","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/itau-contas/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Itaú","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"Banco Itaú automatiza processo e reduz tempo de criação de contas AWS em mais de 4.000%"}},"tags":[{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)",