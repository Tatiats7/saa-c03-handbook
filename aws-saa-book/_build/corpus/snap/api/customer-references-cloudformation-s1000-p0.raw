:32:02+0000"}]},{"item":{"id":"customer-references#nuix-case-study","locale":"en_US","directoryId":"customer-references","name":"nuix-case-study","dateCreated":"2020-05-21T17:49:13+0000","dateUpdated":"2023-07-14T23:32:42+0000","additionalFields":{"featured":"0","descriptionSummary":"By offering its eDiscovery SaaS platform on the AWS Cloud, Nuix can add new regions in one week or less and reduce patching time from 4 hours to 45 minutes. Nuix, an Australian-based independent software vendor, helps national intelligence agencies, law enforcement bodies, and corporations process complex datasets for litigation.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Nuix_logo%401x.4439f54315c43feb641a812f32f77b6d4e2b4bd7.png","displayLocation":"Australia","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/nuix/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Nuix","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Nuix Sheds New Light on eDiscovery with AWS"}},"tags":[{"id":"customer-references#category#batch-processing","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Batch Processing","description":"Batch Processing","dateCreated":"2019-07-22T18:31:02+0000","dateUpdated":"2022-02-26T01:35:02+0000"},{"id":"GLOBAL#product#mgmt-console","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Management Console","description":"AWS Management Console","dateCreated":"2020-03-02T07:04:33+0000","dateUpdated":"2022-02-03T03:32:50+0000"},{"id":"GLOBAL#product#key-mgmt-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Key Management Service (KMS)","description":"AWS Key Management Service (KMS)","dateCreated":"2020-03-02T07:04:13+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#lan