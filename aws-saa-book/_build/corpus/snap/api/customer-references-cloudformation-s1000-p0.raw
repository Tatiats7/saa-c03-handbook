logos/customers/paygate-logo.a43da1fb749932227e8ab567bd7988c7791dac66.png","displayLocation":"Sub-Saharan Africa","footerInfoText":"Published Date","description":"\u003cp\u003ePayGate is one of the leading payment processing companies in southern Africa, and a pioneer in online payment services in the region. PayGate used Amazon Web Services to set up a secure payment processing gateway based within the European Union for one of its longstanding customers. In doing so, it saved around one million South African Rand (US$75,000) and gained a flexible platform to conduct proofs of concept for future cloud projects.\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/paygate/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"PayGate","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: PayGate"}},"tags":[{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#middle-east-africa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East \u0026 Africa","description":"Middle East \u0026 Africa","dateCreated":"2020-02-03T05:30:19+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"GLOBAL#location#africa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Africa","description":"Africa","dateCreated