-services","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Media Services","description":"Media Services","dateCreated":"2019-07-22T18:32:09+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#nextgennkdc3e09it","locale":"en_US","directoryId":"customer-references","name":"nextgennkdc3e09it","dateCreated":"2022-05-23T21:42:37+0000","dateUpdated":"2023-07-12T01:35:18+0000","additionalFields":{"descriptionSummary":"Owen from NextGen Healthcare, explains how the company developed a series of build and deployment pipelines using native AWS services in the highly regulated healthcare sector. Learn how AWS CodePipeline, AWS CodeCommit, AWS CodeBuild, and AWS CloudFormation can be used to build and deploy infrastructure and application code. Discover how AWS resources can be rapidly created and updated as part of a CI/CD pipeline while ensuring HIPAA compliance through approved/vetted AWS IAM Roles that AWS CloudFormation is permitted to assume.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/nextgen-healthcare-logo%401x.8efb2af711edd50e6cc8fe1bc36ed237444e68e9.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2020-02-03","headlineUrl":"https://youtu.be/BLwskVnHbs4?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","customer-name":"NextGen Healthcare, Inc.","contentType":"Customer Story","headline":"NextGen Healthcare: Build and Deployment Pipelines in the Highly Regulated Healthcare Sector"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#reference-arch-diagram","locale":"en_US","tagNamespaceId