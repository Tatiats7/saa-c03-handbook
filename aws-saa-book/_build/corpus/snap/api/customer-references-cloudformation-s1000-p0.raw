22:33:50+0000","dateUpdated":"2022-08-24T22:33:50+0000"},{"id":"GLOBAL#product#lex","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Lex","description":"Amazon Lex","dateCreated":"2020-03-02T07:04:21+0000","dateUpdated":"2022-02-03T03:32:47+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#innovator#sony","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Sony","description":"Sony","dateCreated":"2022-09-15T00:48:43+0000","dateUpdated":"2022-09-15T00:48:43+0000"}]},{"item":{"id":"customer-references#sonybank-2020","locale":"en_US","directoryId":"customer-references","name":"sonybank-2020","dateCreated":"2021-10-01T01:56:34+0000","dateUpdated":"2023-08-11T00:24:45+0000","additionalFields":{"descriptionSummary":"Sony Bank, a member of the Sony Financial Group, provides high-quality financial services. With an IT strategy focused on the latest technology, the company became one of the first financial institutions in Japan to adopt Amazon Web Services (AWS). The bank began progressively migrating its general in-house business systems and peripheral banking systems at the end of 2013, and by late 2019, about 80% of all systems ran on AWS. The bank is now building a cloud-native core banking system that uses the abundant services of AWS for a full-scale release in fiscal 2022.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/jp/sonybank_logo.b32f6ec06975ab62ba54cad7a29fd7d19af28f7b.png","displayLocation":"Japan","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/sonybank-2020/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"SONY BANK","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Sony Bank is one of the first financial institutions to adopt the cloud that helped it reduce costs by up to 60%"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBA