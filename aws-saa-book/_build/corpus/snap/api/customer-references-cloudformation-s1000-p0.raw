,"dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-brightroll","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-brightroll","dateCreated":"2019-07-22T19:55:04+0000","dateUpdated":"2021-12-22T19:41:38+0000","additionalFields":{"featured":"0","descriptionSummary":"BrightRoll is an independent video ad technology platform for digital video advertising across the web, mobile devices, and connected TV. Using AWS, BrightRoll has created comprehensive digital advertising solutions that deliver petabytes of data to more than 80 of the top 100 U.S. advertisers and 18 of the top 20 advertising technology companies.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/brightroll-logo.b84fa5844f0ffe1e81fb3d6628b40fbcad7ebdda.jpg","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eBrightRoll is an independent video ad technology platform for digital video advertising across the web, mobile devices, and connected TV. Using AWS, BrightRoll has created comprehensive digital advertising solutions that deliver petabytes of data to more than 80 of the top 100 US advertisers and 18 of the top 20 advertising technology companies. BrightRoll stores video ads in Amazon S3 and delivers them using Amazon CloudFront (~1.5PB/month). In addition, BrightRoll collects and analyzes hundreds of billions of data points monthly, enabling realtime decisions that drive ROI for advertisers. This large analytic platform runs entirely in AWS.\u003c/p\u003e\r\n","industry":"Digital Marketing","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/brightroll/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"BrightRoll","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: BrightRoll"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"