Created":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#aws-case-study-canary","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-canary","dateCreated":"2019-07-22T19:52:05+0000","dateUpdated":"2023-09-21T00:18:56+0000","additionalFields":{"featured":"0","descriptionSummary":"Canary designs and manufactures a complete home-security system in a single device that contains an HD video camera and environmental sensors. Using AWS, Canary has the scalability to serve customers in 185 countries and can support more than 150 million incoming videos daily.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Canary_Customer-Reference_Logo.de23c81b0b519301fd661e92e2aedb04dd928783.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eCanary designs and manufactures a complete home security system in a single device that contains an HD video camera and environmental sensors. The company is running its website, platform, and video services on AWS. Using AWS, Canary has the scalability to serve customers in 185 countries and can support more than 150 million incoming videos daily.\u003c/p\u003e\r\n","industry":"Electronics \u0026 Semiconductors","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/canary/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Canary","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Canary"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#electronics","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Electronics","description":"Electronics","dateCreated":"2020-06-25T04:07:00+0000","dateUpdated":"2022-02-03T03:32:02+0000"},{"id":"GLOBAL