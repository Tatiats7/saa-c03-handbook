-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#category#developer-tools","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Developer Tools","description":"\u003cp\u003eHost code, build, test, and deploy your applications quickly and effectively with AWS developer tools. Leverage core tools like software development kits (SDKs), code editors, and continuous integration and delivery (CI/CD) services for DevOps software development. Use machine learning (ML) -guided best practices and abstractions to improve agility, security, velocity, and code quality.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:14:12+0000","dateUpdated":"2023-07-14T01:14:12+0000"}]},{"item":{"id":"customer-references#sniezka","locale":"en_US","directoryId":"customer-references","name":"sniezka","dateCreated":"2020-06-17T17:32:41+0000","dateUpdated":"2021-12-22T23:22:46+0000","additionalFields":{"featured":"0","descriptionSummary":"With AWS, Śnieżka has lowered costs, freed up its IT team, and gained a scalable SAP environment to help it expand internationally. The company is the market leader in paints and varnishes in Poland, Belarus, Ukraine, and Hungary. It worked with AWS APN Partner SE16N to build its AWS environment for SAP using AWS Lambda, Amazon EC2, and Amazon Aurora.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Sniezka_Customer-Reference_Logo.8ee5c87bc63fd62a8c40795fb5e185428a1b7ffb.png","displayLocation":"Europe, Middle East, \u0026 Africa","footerInfoText":"Published Date","industry":"Manufacturing","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/Sniezka-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Śnieżka","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Paint Firm Is Primed for International Growth withSAP on AWS"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId