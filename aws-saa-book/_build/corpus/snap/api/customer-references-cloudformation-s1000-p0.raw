eId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#bayer","locale":"en_US","directoryId":"customer-references","name":"bayer","dateCreated":"2021-09-11T00:50:11+0000","dateUpdated":"2023-06-08T04:07:47+0000","additionalFields":{"descriptionSummary":"Para ajudar agricultores brasileiros a adotar práticas agrícolas inteligentes em relação ao clima e reduzir as emissões de carbono em suas atividades, a Bayer criou o Projeto Carbono, que tem como objetivo construir uma agricultura Carbono neutra. A iniciativa é parte do compromisso da empresa de reduzir em 30% a emissão de Gases de Efeito Estufa (GEE) no setor agrícola até 2030. Para centralizar e padronizar os dados recebidos dos diferentes parceiros envolvidos no projeto, a Bayer utiliza a plataforma e serviços AWS, que também dão ao projeto a escalabilidade e agilidade necessárias.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/bayer_Logo%401x.71922a26881b8d09a263b14e9a7c68cc25b83137.png","displayLocation":"Brasil","customerNameLower":"bayer","footerInfoText":"Data de publicação","industry":"Serviços públicos gerais","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/bayer/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Bayer","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"Com apoio da AWS, Bayer centraliza e padroniza dados do Projeto Carbono"}},"tags":[{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","desc