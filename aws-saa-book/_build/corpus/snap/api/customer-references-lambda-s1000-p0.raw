,"description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#infrastructure","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Infrastructure","description":"Infrastructure","dateCreated":"2019-07-22T18:32:04+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#industry#oil-gas","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Oil \u0026 Gas","description":"Oil \u0026 Gas","dateCreated":"2020-01-16T17:42:36+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#industry#energy","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Energy","description":"Energy","dateCreated":"2020-07-15T21:58:51+0000","dateUpdated":"2022-02-03T03:32:02+0000"}]},{"item":{"id":"customer-references#shimamura-music","locale":"en_US","directoryId":"customer-references","name":"shimamura-music","dateCreated":"2022-05-03T00:28:46+0000","dateUpdated":"2022-05-03T00:36:30+0000","additionalFields":{"descriptionSummary":"To automate its product order operations, Shimamura Music Co., Ltd. (Shimamura Music) migrated its on-premises demand forecasting system to a cloud-based system that could adjust to future changes in the business environment while still providing reliable, high-quality forecasts. To achieve its goals, the company chose Amazon Web Services (AWS) as its cloud services provider.\nA non-engineering team in the logistics department built an in-house demand forecasting and automated ordering system that improves shortage rates and increases business efficiency using Amazon Forecast—a fully managed service that uses machine learning to deliver highly accurate forecasts.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/shimamura-logo%401x.bd85042436390718a28eceb24781443ea6531d00.png","displayLocation":"Japan","footerInfoText":"Published Date","industry":"Retail","sortDate":"2022-04-29","headlineUrl":"https://aws.amazon.com/solutions/case-studies/shimamura-music/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Shimamura Music Improves Business with Demand Forecasting and Automated Ordering Using Amazon Forecast","customer-name":"Shimamura Music"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#forecast","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Forecast","description":"Amazon Forecast","dateCreated":"2020-03-02T07:03:29+0000","dateUpdated":"2022-02-03T03:32:37+0000"},{"id":"GLOBAL#industry#retail","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Retail","description":"Retail","dateCreated":"2020-01-16T17:42:39+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description