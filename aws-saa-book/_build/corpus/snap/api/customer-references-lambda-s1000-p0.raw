ription":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#codedeploy","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodeDeploy","description":"AWS CodeDeploy","dateCreated":"2020-03-02T07:02:12+0000","dateUpdated":"2022-02-03T03:32:24+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Mobile","description":"Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2023-08-22T20:28:38+0000"},{"id":"customer-references#innovator#itau","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"itau","description":"\u003cp\u003eInnovator introduced in 2023.\u003c/p\u003e\n","dateCreated":"2023-08-10T19:03:48+0000","dateUpdated":"2023-08-10T19:03:48+0000"}]},{"item":{"id":"customer-references#miro-case-study","locale":"en_US","directoryId":"customer-references","name":"miro-case-study","dateCreated":"2022-10-03T18:34:01+0000","dateUpdated":"2022-10-11T21:03:06+0000","additionalFields":{"descriptionSummary":"The accelerated adoption of remote and hybrid working over the last 2 years brought about an unprecedented need for businesses to collaborate virtually. Miro was on the front line of this rapid change. It provides an online whiteboarding platform that allows teams to collaborate from wherever they are in the world. \n\nWhen employees were required to work from home during the COVID-19 pandemic, Miro usage surged. Its user base grew by 500 percent to reach 30 million in January 2022. This includes both individual users and employees at its more than 130,000 paying customers, including 99 percent of the Fortune 100. Using Amazon Web Services (AWS), Miro drove this expansion and provided a reliable, speedy, and secure experience for its customers throughout the pandemic and beyond.","imageSrcUrl":"https://d1.awsstatic.com/emea-customer-references/emea-directory-customer-logos/Miro-Customer-References-Logo%401x.ef65b753e8574be7d9f42b97cbfddcc72be728aa.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"miro","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/miro-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Miro","publishedDate":"2022","enableShare":"1","headline":"Miro Drives 500% Growth in Online Whiteboard Customers and Boosts Security Using AWS","contentType":"Customer Story"}},"tags":[{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#cee","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central \u0026 Eastern Europe","description":"Central \u0026 Eastern Europe","dateCreated":"2020-03-10T05:12:39+0000","dateUpdated":"2022-02-03T03:31:41+0000"},{"id":