teUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#devtools","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Developer Tools","description":"Developer Tools","dateCreated":"2020-01-16T17:43:16+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#codecommit","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodeCommit","description":"AWS CodeCommit","dateCreated":"2020-03-02T07:02:10+0000","dateUpdated":"2022-02-03T03:32:24+0000"},{"id":"GLOBAL#industry#oil-gas","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Oil \u0026 Gas","description":"Oil \u0026 Gas","dateCreated":"2020-01-16T17:42:36+0000","dateUpdated":"2022-02-03T03:32:07+0000"}]},{"item":{"id":"customer-references#tui-video","locale":"en_US","directoryId":"customer-references","name":"tui-video","dateCreated":"2020-11-09T18:09:11+0000","dateUpdated":"2023-07-12T01:40:53+0000","additionalFields":{"descriptionSummary":"Tui is one of the world’s largest travel companies, comprising tour operators, travel agencies, online portals, five airlines, over 400 hotels, and 17 cruise liners.The business traces its roots 70 years, but it has never shied away from modernization. During peak booking season, the group’s online operations handle nearly 60 billion searches, serve 400 million product combinations, and update 8 million prices per hour.Tui chose to move to Amazon Web Services (AWS) to improve the customer experience and enhance customer interactions using artificial intelligence (AI).In this video, Elke Reichart, chief digital officer at Tui, explains how the organization handles 18 percent more searches with 35 percent better search performance and saw 31 percent fewer customer complaints using AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/TUI_Customer-Reference_Logo@1x.ca041124ff6784cabbc736869e74ba723fbc6964.png","displayLocation":"Germany","footerInfoText":"Published Date","industry":"Travel \u0026 Hospitality","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/tui-video/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","customer-name":"Tui","contentType":"Customer Story","headline":"Tui Looks to AI for Happier Holidaymakers"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"customer-references#category#database-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Database Migration","description":"Database Migration","dateCreated":"2019-07-22T18:31:40+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#customer-engagement","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2019-07-22T18:31:37+0000","dateUpdated":"2022-03-21T23:37:45+0000"},{"id":"GLOBAL#location#germa