2-03T03:31:40+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#location#germany","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Germany","description":"Germany","dateCreated":"2020-02-03T05:29:55+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"customer-references#category#app-integration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Application Integration","description":"Application Integration","dateCreated":"2019-07-22T18:30:54+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#tech-category#devtools","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Developer Tools","description":"Developer Tools","dateCreated":"2020-01-16T17:43:16+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"customer-references#innovator#bmw","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"bmw","description":"\u003cp\u003eBMW is a customer in the Innovator Program.\u003c/p\u003e\n","dateCreated":"2022-08-12T19:46:58+0000","dateUpdated":"2022-08-12T19:46:58+0000"},{"id":"customer-references#big-rocks#aws-for-data","locale":"en_US","tagNamespaceId":"customer-references#big-rocks","name":"AWS for Data","description":"\u003cp\u003eAWS for Data is a marketing \u0026ldquo;Big Rock\u0026rdquo; initiative that tells the story around how AWS can provide the most comprehensive set of data capabilities spanning databases, analytics, business intelligence, and machine learning for an end-to-end data strategy.\u003c/p\u003e\n","dateCreated":"2024-02-14T22:32:15+0000","dateUpdated":"2024-02-14T22:32:15+0000"}]},{"item":{"id":"customer-references#pix-system-case-study","locale":"en_US","directoryId":"customer-references","name":"pix-system-case-study","dateCreated":"2019-07-22T19:43:15+0000","dateUpdated":"2021-12-22T19:00:54+0000","additionalFields":{"featured":"0","descriptionSummary":"PIX System migrated its data center to the AWS Cloud, improving performance by 30 percent and gaining instant scalability. The company\u0027s remote collaboration and asset-sharing platform enables producers, directors, cast, and crew around the globe to collaborate effectively on TV and film productions.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/US/PIX_LOGO_820x332.c2729e3d20b7e67e96f558503fbf957d869801ae.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003ePIX System migrated its data center to the AWS Cloud, improving performance by 30 percent and gaining instant scalability. The company\u0019s remote collaboration and asset-sharing platform enables producers, directors, cast, and crew around the globe to collaborate effectively on TV and film productions. PIX System uses Amazon EBS to migrate files to Amazon S3 volumes for primary storage, and takes advantage of Amazon EC2 instances for video workflows, including automated media-processing workflows and content collaboration.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/pix-system/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"PIX System","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"PIX System Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Com