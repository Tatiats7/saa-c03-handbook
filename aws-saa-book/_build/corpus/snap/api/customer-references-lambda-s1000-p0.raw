"stokrotka-case-study","dateCreated":"2024-04-16T00:03:51+0000","dateUpdated":"2024-04-16T00:06:38+0000","additionalFields":{"descriptionSummary":"Polish supermarket chain Stokrotka migrated its 15 TB data warehouse to Amazon Web Services (AWS) to improve performance and support its growth plans. Working with AWS Partner Tameshi, the migration helped streamline its operations and reduce downtime. The move to AWS also helped optimize Stokrotka\u0027s data management, doubled the performance of its business intelligence (BI) tool, and gave the chain a scalable, efficient, and cost-effective solution. Tameshi used Amazon Redshift and Amazon S3 to complete the migration in 3 months.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/stokrotka-logo%401x.3e6773225aae979182a2dcfa2ad61145b02a1428.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"stokrotka","footerInfoText":"Published Date","industry":"Retail","sortDate":"2024-01-01","headlineUrl":"https://aws.amazon.com/partners/success/stokrotka-tameshi/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Stokrotka","publishedDate":"2024","enableShare":"1","headline":"Stokrotka Transforms Retail Analytics and Business Intelligence with Tameshi on AWS","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12T02:01:29+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migrati