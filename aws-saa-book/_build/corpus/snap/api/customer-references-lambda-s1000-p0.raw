ning (ML) services to improve fraud detection capabilities globally. The solution has enabled Mastercard to detect three times the amount of fraudulent transactions and reduce false positives tenfold, leading to billions of dollars in merchant savings and providing a better experience for customers around the world.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/mastercard-logo%401x.4a7e00978a4f5f979855fdd48a66a619cc2b84a4.png","displayLocation":"Americas","customerNameLower":"mastercard","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2023-08-29","headlineUrl":"https://aws.amazon.com/solutions/case-studies/mastercard-ai-ml-testimonial/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Mastercard","publishedDate":"2023","enableShare":"1","headline":"Mastercard Detects and Prevents Fraud Using AI/ML on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreat