7T20:19:16+0000","dateUpdated":"2025-05-05T23:31:09+0000","additionalFields":{"featured":"0","featureImageURL":"https://d1.awsstatic.com/aws-key-pages/homepage-key-pages/customer-stories-logo/Amazon.934209dc860398008267c1c712ee41d83a50e451.jpg","descriptionSummary":"Amazon.com migrated 5,000 databases from Oracle to AWS, cutting its annual database operating costs by more than half and reducing the latency of most critical services by 40 percent.","imageSrcUrl":"https://d1.awsstatic.com/amazon-logo-1x.a64c3eedfb84347ecf50e210637c0cf810922e10.png","displayLocation":"North America","customerNameLower":"amazon","footerInfoText":"Published Date","description":"\u003cp\u003eLeveraging machine learning to automate inventory workflows\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u0026nbsp;\u003c/p\u003e\n","industry":"Retail","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/innovators/amazon/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Amazon","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Amazon on AWS"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","descriptio