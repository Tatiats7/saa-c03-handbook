nnovator","name":"Coca-Cola","description":"Coca-Cola","dateCreated":"2022-04-25T19:06:03+0000","dateUpdated":"2022-06-07T17:22:42+0000"}]},{"item":{"id":"customer-references#the-clinician-case-study","locale":"en_US","directoryId":"customer-references","name":"the-clinician-case-study","dateCreated":"2021-12-14T02:50:13+0000","dateUpdated":"2023-07-12T01:35:21+0000","additionalFields":{"descriptionSummary":"With ZEDOC on AWS, The Clinician is enabling healthcare providers to collect accurate data from patients in their homes to provide individualised care. ZEDOC by The Clinician is a cloud-based digital health platform that helps healthcare organisations collect and analyse health data captured directly from patients.  Data collected from the AI-driven ZEDOC platform is stored on Amazon S3 with AWS Lambda scaling to handle peaks, and Amazon EKS running patient-facing applications.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/The_Clinician%401x.5672497da165845d5028247d336c71b5924eafd2.png","displayLocation":"Australia","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/the-clinician-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"The Clinician","contentType":"Customer Story","headline":"The Clinician Helps Hospitals Deliver Personalised Cancer Care with An AI-Driven Digital Health Platform on AWS"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#location#australia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia","description":"Australia","dateCreated":"2020-02-03T05:29:12+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#language#english","locale":"en_US",