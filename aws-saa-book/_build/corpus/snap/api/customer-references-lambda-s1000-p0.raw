ly, improve system performance and provide proactive care notifications.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/resmed-logo%401x.0f86a159bf40902f8d838ff365885c19b966e9ee.png","displayLocation":"United States","customerNameLower":"resmed corp","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2022-07-05","headlineUrl":"https://youtu.be/kszaIJEnKPk?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Resmed Corp","publishedDate":"2022","enableShare":"1","headline":"ResMed: Improving Patient Outcomes with Serverless at Scale","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#kinesis-video","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesi