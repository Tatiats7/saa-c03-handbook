:"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#alameda-county-case-study","locale":"en_US","directoryId":"customer-references","name":"alameda-county-case-study","dateCreated":"2019-07-19T17:08:14+0000","dateUpdated":"2022-01-21T02:40:16+0000","additionalFields":{"featured":"0","descriptionSummary":"Alameda County, California avoided $20,000 in application-development costs and gained the scalability to serve thousands of concurrent users by migrating its election-map viewer application—formerly hosted on premises—to AWS. Alameda County is the seventh-most populous county in California, with 14 incorporated cities and more than 1.5 million people.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/AlamedaCounty_Customer-Reference_Logo.8eeec243adfeee2f8cf142086ec250100f7c4890.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eAlameda County, California avoided $20,000 in application-development costs and gained the scalability to serve thousands of concurrent users by migrating its election-map viewer application\u0014formerly hosted on premises\u0014to AWS. \u0026nbsp;Alameda County is the seventh-most populous county in California, with 14 incorporated cities and more than 1.5 million people. \u0026nbsp;The county uses AWS Lambda serverless compute and Amazon S3 storage to create maps of election results that are provided to users through the Amazon CloudFront content delivery network.\u003c/p\u003e\r\n","industry":"Government","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/alameda-county/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Alameda County","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Alameda County Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:43+0000","dateUpdated":"2022-02-03T03:36:00+0000"},{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#lambda","locale":"