nube, buscando un proveedor que los acompañase en este objetivo digital. Después de elegir AWS para esta evolución, Nubihome ejecutó una migración gradual. Al principio migró su ambiente de testing, luego las máquinas virtuales y bases de datos, y luego el storage, utilizando Amazon Simple Storage Service.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/nubihome_logo%401x.2edd9b1e20fbc6f0a598a56e543fa18ccfae7ad4.png","displayLocation":"Argentina","footerInfoText":"Fecha de publicación","industry":"Software e Internet","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/nubihome/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"Historia del cliente","customer-name":"Nubihome","headline":"NubiHome migra sus operaciones a la nube con AWS"}},"tags":[{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#product#ses","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Email Service (SES)","description":"Amazon Simple Email Service (SES)","dateCreated":"2020-03-02T07:05:22+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"customer-references#category#database-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Database Migration","description":"Database Migration","dateCreated":"2019-07-22T18:31:40+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#location#argentina","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Argentina","description":"Argentina","dateCreated":"2020-06-12T23:30:42+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020