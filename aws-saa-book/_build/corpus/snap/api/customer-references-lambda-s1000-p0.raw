teCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"}]},{"item":{"id":"customer-references#qivos-case-study","locale":"en_US","directoryId":"customer-references","name":"qivos-case-study","dateCreated":"2024-08-16T22:07:01+0000","dateUpdated":"2024-08-16T22:09:17+0000","additionalFields":{"descriptionSummary":"Qivos is a leading marketing technology agency with an international presence, serving customers across eight countries. Established in 2004, Qivos creates brand loyalty through data intelligence and machine learning. Its flagship product Qivos Cloud was launched in the cloud and runs on Amazon Web Services (AWS). Using AWS, the company has been able to rapidly scale and expand its portfolio. It runs core Qivos Cloud workloads on Amazon EC2 instances, with Amazon RDS as its primary database and Amazon Athena for analytics queries.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/Qivos-logo%402x%20.b1ff44ae7a41c72039ecd1e32621af3b07367187.png","displayLocation":"Greece","customerNameLower":"qivos","footerInfoText":"Published Date","industry":"Digital Marketing","headlineUrl":"https://aws.amazon.com/solutions/case-studies/Qivos-Case-Study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","customer-name":"Qivos","head