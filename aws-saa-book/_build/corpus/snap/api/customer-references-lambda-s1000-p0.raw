":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#methodology#devops","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"DevOps","description":"DevOps","dateCreated":"2020-06-05T07:06:27+0000","dateUpdated":"2022-02-03T03:32:10+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#cognito","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Cognito","description":"Amazon Cognito","dateCreated":"2020-03-02T07:02:17+0000","dateUpdated":"2022-02-03T03:32:25+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#key-mgmt-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Key Management Service (KMS)","description":"AWS Key Management Service (KMS)","dateCreated":"2020-03-02T07:04:13+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"}]},{"item":{"id":"customer-references#natura-case-study","locale":"en_US","directoryId":"customer-references","name":"natura-case-study","dateCreated":"2024-08-16T12:46:06+0000","dateUpdated":"2024-08-23T15:50:04+0000","additionalFields":{"descriptionSummary":"A empresa vem inovando com a Amazon Web Services (AWS_ desde 2016 e, desde 2020, conta com um Centro de Excelência em Cloud e DevOps (CCoE), criado com o objetivo de viabilizar a estratégia de negócios definida para o longo prazo e reduzir o lead time de entregas dos times de produtos/engenharia, garantindo sempre qualidade segurança através da adoção de serviços de nuvem. Ao longo dos últimos anos, a busca pela excelência operacional em nuvem trouxe um desafio relacionado à escala e à complexidade das aplicações.","featureImageURL":"https://d1.awsstatic.com/customer-references-case-studies-logos/natura_Logo%402x.18d86a7d43a0801be2e919a15f637a01653d712a.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/natura_Logo%402x.18d86a7d43a0801be2e919a15f637a01653d712a.png","displayLocation":"Brazil","customerNameLower":"natura","footerInfoText":"Published Date","industry":"Manufacturing","sortDate":"2024-08-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/natura-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Natura","publishedDate":"2024","enableShare":"1","headline":"Com IA generativa AWS, Natura \u0026Co reduz em 50% tempo de troubleshooting","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","