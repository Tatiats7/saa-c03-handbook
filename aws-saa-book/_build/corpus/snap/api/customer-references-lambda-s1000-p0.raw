ND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#royal-frieslandcampina-casestudy-2020","locale":"en_US","directoryId":"customer-references","name":"royal-frieslandcampina-casestudy-2020","dateCreated":"2022-03-15T23:58:52+0000","dateUpdated":"2022-03-16T00:00:42+0000","additionalFields":{"descriptionSummary":"Royal FrieslandCampina uses Amazon Redshift to support data-driven decision making across the enterprise as well as AWS Lambda for processing tasks, including big data analysis.","displayLocation":"Benelux","footerInfoText":"Published Date","industry":"Consumer Packaged Goods (CPG)","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/Royal-FrieslandCampina-Casestudy/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Royal FrieslandCampina Builds Global Data Platform on AWS","customer-name":"Royal FrieslandCampina"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#location#netherlands","locale":"en_US","tagNamespaceId"