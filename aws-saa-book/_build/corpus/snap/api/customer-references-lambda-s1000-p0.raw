ferences#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"customer-references#category#developer-tools","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Developer Tools","description":"\u003cp\u003eHost code, build, test, and deploy your applications quickly and effectively with AWS developer tools. Leverage core tools like software development kits (SDKs), code editors, and continuous integration and delivery (CI/CD) services for DevOps software development. Use machine learning (ML) -guided best practices and abstractions to improve agility, security, velocity, and code quality.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:14:12+0000","dateUpdated":"2023-07-14T01:14:12+0000"}]},{"item":{"id":"customer-references#swoop-aero-case-study","locale":"en_US","directoryId":"customer-references","name":"swoop-aero-case-study","dateCreated":"2023-05-19T23:53:46+0000","dateUpdated":"2024-02-20T22:25:53+0000","additionalFields":{"descriptionSummary":"Swoop Aero deploys a fleet of drones into geographic areas and operates them as part of an integrated network. It uses a range of AWS services including AWS IoT Core and Amazon SageMaker, putting the company at the edge of aviation, transport, and automation. With AWS, Swoop Aero offers a scalable and safe service that leverages automation and ML to identify issues before aircraft take off.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/swoop-aero-logo%401x.ae0cecc260a8c04bd5a033dfc170373f1dc5ec9d.png","displayLocation":"Australia","customerNameLower":"swoop  aero","footerInfoText":"Published Date","industry":"Aerospace","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/swoop-aero-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Swoop  Aero","publishedDate":"2023","enableShare":"1","headline":"Swoop Aero Deploys Aircraft Globally Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#australia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia","description":"Australia","dateCreated":"2020-02-03T05:29:12+0000","dateUpdat