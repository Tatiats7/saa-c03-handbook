orage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#cloudsearch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudSearch","description":"Amazon CloudSearch","dateCreated":"2020-03-02T07:02:03+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#driver-and-vehicle-licensing-agency-case-study","locale":"en_US","directoryId":"customer-references","name":"driver-and-vehicle-licensing-agency-case-study","dateCreated":"2019-07-19T15:19:59+0000","dateUpdated":"2021-12-22T18:45:51+0000","additionalFields":{"featured":"0","descriptionSummary":"The UK Driver and Vehicle Licensing Agency (DVLA) is using an API-based approach to empower people and organizations to create innovative applications and services with valuable public data. DVLA maintains the registration and licensing of more than 47 million driver records in Great Britain, as well as the collection and enforcement of Vehicle Excise Duty in the United Kingdom.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/UKDriverAndVehicleLicensingAgency_Customer-Reference_Logo.ce83ca32747b9d87a982a74a3b01cc8e21f4383e.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","description":"\u003cp\u003eThe UK Driver and Vehicle Licensing Agency (DVLA) is using an API-based approach to empower people and organizations to create innovative applications and services with valuable public data. DVLA maintains the registration and licensing of more than 47 million driver records in Great Britain, as well as the collection and enforcement of Vehicle Excise Duty in the United Kingdom. The organization uses Amazon API Gateway to host and manage data APIs with the ability to scale to billions of transactions per month, and AWS Lambda for efficient, cost-effective operational tasks such as report generation.\u003c/p\u003e\r\n","industry":"Government","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/driver-and-vehicle-licensing-agency/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Driver and Vehicle Licensing Agency","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Driver and Vehicle Licensing Agency Case Study"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpd