prise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#category#iot","locale":"en_US","tagNamespaceId":"customer-references#category","name":"IoT","description":"IoT","dateCreated":"2019-07-22T18:32:05+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"IoT","description":"IoT","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2022-02-03T03:35:28+0000"}]},{"item":{"id":"customer-references#creative5","locale":"en_US","directoryId":"customer-references","name":"creative5","dateCreated":"2022-01-29T03:26:27+0000","dateUpdated":"2022-09-09T00:34:16+0000","additionalFields":{"descriptionSummary":"Creative5 built its solar energy management solution on AWS to leverage cloud-native agility in development and limitless scaling for its products. Based in Taiwan, Creative5 provides integrated IoT hardware and software solutions to solar energy providers. The company is using AWS IoT Core to connect legacy solar panels to the internet, AWS Lambda for serverless integrations, and Amazon Lightsail for online monitoring dashboards.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Creative5%20Logo.b48d1f1e70bb048d306f0ad55402e447950e0c71.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","industry":"Professional Services","sortDate":"2022-01-28","headlineUrl":"https://aws.amazon.com/solutions/case-studies/creative5/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Creative5","enableShare":"1","publishedDate":"2022","c