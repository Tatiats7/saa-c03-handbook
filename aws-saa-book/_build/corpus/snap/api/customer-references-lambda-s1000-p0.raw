Created":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"}]},{"item":{"id":"customer-references#vicone","locale":"en_US","directoryId":"customer-references","name":"vicone","dateCreated":"2023-07-29T00:30:40+0000","dateUpdated":"2024-02-20T22:26:12+0000","additionalFields":{"descriptionSummary":"VicOne, a subsidiary of cloud and enterprise cybersecurity company Trend Micro, is driving the adoption of cybersecurity systems across the automotive industry with its xNexus platform, an extended detection and response solution.\n\nLeveraging AWS IoT FleetWise, the platform rapidly integrates vehicle data into Amazon Timestream databases, while VicOne\u0027s Kubernetes-based applications, managed by Amazon EKS, handles analysis and detection. This streamlined process speeds up data integration, cuts proof-of-concept time by up to 50 percent, and reduces costs.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/vicone-logo%401x.a723af1a2cc5aa39730b834f8775bdb32372deb2.png","displayLocation":"Taiwan","customerNameLower":"vicone","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/VicOne/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"VicOne","publishedDate":"2023","enableShare":"1","headline":"VicOne Provides Faster Automotive Cybersecurity Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#industry#automotive","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name"