er going live with the status-monitoring system built with AWS and Brains Technology, the company was able to avoid costs associated with extended downtime when the system detected abnormal conditions.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/aisin-aw-logo@1x.17b9db86b4d01b790c95d1131ab19d0f55d7833a.png","displayLocation":"Japan","footerInfoText":"Published Date","industry":"Manufacturing","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/aisinaw-brainstech/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"AiSIN AW case study","customer-name":"AiSIN AW"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000"