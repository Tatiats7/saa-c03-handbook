beanstalk","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elastic Beanstalk","description":"AWS Elastic Beanstalk","dateCreated":"2020-03-02T07:03:00+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"}]},{"item":{"id":"customer-references#tecban","locale":"en_US","directoryId":"customer-references","name":"tecban","dateCreated":"2023-06-01T23:07:14+0000","dateUpdated":"2023-06-08T04:07:44+0000","additionalFields":{"descriptionSummary":"A TecBan é líder mundial em rede independente de autoatendimento. Há mais de 39 anos a companhia desenvolve diversas soluções tecnológicas e inovadoras que integram o físico e o digital e impulsionam o ecossistema econômico do Brasil. Visionária, a empresa está em constante movimento e, na última década, investiu mais de R$ 4 bilhões em produtos e soluções avançadas que ajudam a garantir a inclusão financeira de todas as classes sociais e perfis de público, em todas as regiões do Brasil. Um dos frutos deste investimento é a plataforma de Open Banking as a Service, lançada no início deste ano nativa na nuvem AWS, o que possibilita que possa crescer junto com a demanda.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/tecban-logo%402x.af5cbb717674af5720d18d34136e7ce028c575b8.png","displayLocation":"Brasil","footerInfoText":"Data de publicação","industry":"Manufatura","sortDate":"2021-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/tecban/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"História do cliente","customer-name":"Tecban Indústria e Comércio Ltda.","headline":"Solução de Open Banking da TecBan utiliza nuvem AWS"}},"tags":[{"id":"GLOBAL#tech-category#app-integration","locale":"en