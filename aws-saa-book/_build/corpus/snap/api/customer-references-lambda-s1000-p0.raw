"description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#batch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Batch","description":"AWS Batch","dateCreated":"2020-03-02T07:01:42+0000","dateUpdated":"2022-02-03T03:32:19+0000"},{"id":"GLOBAL#industry#automotive","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Automotive","description":"Automotive","dateCreated":"2020-01-16T17:42:11+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"IoT","description":"IoT","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2022-02-03T03:35:28+0000"}]},{"item":{"id":"customer-references#sainsburys-video","locale":"en_US","directoryId":"customer-references","name":"sainsburys-video","dateCreated":"2020-11-09T18:07:47+0000","dateUpdated":"2023-08-11T00:24:47+0000","additionalFields":{"descriptionSummary":"Founded in 1861, Sainsbury’s is the UK’s second-largest supermarket chain with nearly 1,750 stores. Around 20 percent of its sales revenue comes from online transactions.In 2017, the group recognized the need to improve its online grocery business. But its traditional IT infrastructure made it difficult for Sainsbury’s to use data science and machine learning to fully understand its customers.By moving to Amazon Web Services (AWS), the group has multiple product releases a day compared to five to six releases a year. Sainsbury’s is also making better use of its customer data, which has improved weekly customer engagement fivefold.In this video, Phil Jordan, group chief information officer, and Clodagh Moriarty, group chief digital officer, explain how and why Sainsbury’s moved to AWS.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Sainsbury_Customer-Reference_Logo@1x.1e4d0d5a731abbc14a6a15b23f72eb987a2ce7f8.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","industry":"Retail","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/sainsburys-video/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Sainsbury\u0027s","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Sainsbury’s Stays Future-Ready with Cloud Transformation"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#customer-engagement","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2019-07-22T18:31:37+0000","dateUpdated":"2022-03-21T23:37:45+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id"