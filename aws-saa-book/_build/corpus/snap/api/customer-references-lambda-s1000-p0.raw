acy is a leading pharmaceutical chain in Malaysia with 150 stores across the country.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(@1x---@2x)/Caring_logo@1x.18c9bb290a20a93f1e111bfc3fa1befbe0a85c94.png","displayLocation":"Malaysia","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/caring-pharmacy/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"Caring Pharmacy","contentType":"Customer Story","headline":"Caring Pharmacy Runs SAP on AWS as the Data Foundation for Rapid Expansion"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#cloudendure-disaster","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"CloudEndure Disaster Recovery","description":"CloudEndure Disaster Recovery","dateCreated":"2020-12-08T20:22:55+0000","dateUpdated":"2022-02-03T03:32:21+0000"},{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12T02:01:29+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","da