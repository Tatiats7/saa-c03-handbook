:"customer-references#aws-is-how-petco-brings-greater-convenience-and-personalization-to-pet-parents","locale":"en_US","directoryId":"customer-references","name":"aws-is-how-petco-brings-greater-convenience-and-personalization-to-pet-parents","dateCreated":"2021-06-05T01:08:54+0000","dateUpdated":"2023-04-05T23:11:27+0000","additionalFields":{"featured":"0","descriptionSummary":"To provide pet parents with convenience and personalization, Petco works with JBS Solutions, to build innovative microservices using AWS. These microservices, like the Right Food Finder, bring new features to the Petco app and website, and Petco continuously invents better ways to help pet parents quickly get the products and services they need.","featureImageURL":"https://d1.awsstatic.com/aws-key-pages/homepage-key-pages/customer-stories-logo/Petco.f2690a600cd5cc4fbf62571ee14762a6d83eff7a.jpg","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/petco_Logo%401x.4fff1d421d0c16fd314f86967f54ce58fad04037.png","displayLocation":"United States","footerInfoText":"Published Date","description":"\u003cp\u003eBringing greater convenience and personalization to pet parents\u003c/p\u003e\n","industry":"Retail","sortDate":"2021-06-04","headlineUrl":"https://aws.amazon.com/blogs/industries/aws-is-how-petco-brings-greater-convenience-and-personalization-to-pet-parents/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Petco","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"AWS is How: Petco Brings Greater Convenience and Personalization to Pet Parents"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u002