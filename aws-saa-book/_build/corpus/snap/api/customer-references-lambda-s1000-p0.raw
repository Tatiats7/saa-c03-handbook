 display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#activecampaign-aurora-case-study","locale":"en_US","directoryId":"customer-references","name":"activecampaign-aurora-case-study","dateCreated":"2021-06-05T00:52:46+0000","dateUpdated":"2021-12-22T20:19:13+0000","additionalFields":{"featured":"0","descriptionSummary":"By migrating to Aurora, cloud-based SaaS company ActiveCampaign increased scalability and security and improved the customer experience.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/activecampaign-logo%401x.88fb7329d22bce0129f68084af27295f137ac7cd.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2021-06-04","headlineUrl":"https://aws.amazon.com/solutions/case-studies/activecampaign-aurora-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ActiveCampaign","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"ActiveCampaign Improves Customer Experience Using Amazon Aurora"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","des