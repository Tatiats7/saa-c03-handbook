ujo los gastos de la nube de alrededor de US$ 20.000 para US$ 5.000 al mes.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/klustera_logo%401x.cf5bb4e9fcf0f1c1f8b1cbd1a44a452e6197d1c0.png","displayLocation":"México","footerInfoText":"Fecha de publicación","industry":"Software e Internet","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/klustera/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"Historia del cliente","customer-name":"Klustera","headline":"Klustera utiliza tecnología AWS para hacer un mundo actualizable"}},"tags":[{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03