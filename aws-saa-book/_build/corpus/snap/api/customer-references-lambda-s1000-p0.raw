-growing company accelerated its customers’ clinical trials and onboarded hundreds of thousands of patients in a short period of time.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/climedo-logo%401x.1ee0caf92910655995395656b4ed2e09dd782347.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"climedo health","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2022-07-26","headlineUrl":"https://aws.amazon.com/solutions/case-studies/climedo-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Climedo Health","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Climedo Health Captures Patient-Centric, Compliant, and Secure Clinical Data Using AWS"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#location#germany","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Germany","description":"Germany","dateCreated":"2020-02-03T05:29:55+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#product#key-mgmt-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Key Management Service (KMS)","description":"AWS Key Management Service (KMS)","dateCreated":"2020-03-02T07:04:13+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespac