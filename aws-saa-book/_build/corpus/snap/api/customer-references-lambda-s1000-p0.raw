":{"id":"customer-references#gus-group-case-study","locale":"en_US","directoryId":"customer-references","name":"gus-group-case-study","dateCreated":"2020-05-12T19:14:24+0000","dateUpdated":"2021-12-22T19:08:08+0000","additionalFields":{"descriptionSummary":"Through its GUS-OS Digital Hub, GUS Group enables customers to access ERP software via the cloud. The firm works with process-based companies in industries such as pharmaceuticals and biotech. The ERP specialist used Amazon API Gateway and AWS Lambda to deliver its SaaS offering.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/gus-group@1x.691ed909251724d86c6d08cf7f69356be6235a80.png","displayLocation":"Germany","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/GUS-group/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"AWS Case Study: GUS Group","customer-name":"GUS Group"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#iot-core","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS IoT Core","description":"AWS IoT Core","dateCreated":"2020-03-02T07:04:00+0000","dateUpdated":"2022-02-03T03:32:42+0000"},{"id":"customer-references#category#hybrid-cloud-architecture","locale":"en_US","tagNamespaceId":"customer-references#category","name":"hybrid-cloud-architecture","description":"Hybrid Cloud Architecture","dateCreated":"2019-07-22T18:32:02+0000","dateUpdated":"2020-11-25T01:38:31+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22