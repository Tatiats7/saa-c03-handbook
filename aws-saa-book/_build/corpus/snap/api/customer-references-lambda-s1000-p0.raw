less architecture. Intercom offers a suite of messaging-first products that integrate seamlessly with other companies\u0027 websites and mobile apps to help them acquire, engage with, and support their own customers.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Intercom_Customer-Reference_Logo.785400be77a04421b6829f869a140448508a7742.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eIntercom designed, prototyped, tested, and deployed a stream-processing service in under two weeks using an AWS serverless architecture.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/intercom/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Intercom","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Intercom Case Study"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#product#kinesis-data-firehose","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis Firehose","description":"Amazon Kinesis Firehose","dateCreated":"2020-05-08T03:42:48+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#larsen-toubro-infotech-lti-case-study","locale":"en_US","directoryId":"customer-references","name":"larsen-toubro-infotech-lti-case-study","dateCreated":"2019-07-19T14:58:33+0000","dateUpdated":"2021-12-22T18:47:51+0000","additionalFields":{"featured":"0","descriptionSummary":"LTI is running SAP S/4HANA on the highly agile AWS Cloud, enabling the company to scale the environment in minutes when it used to take weeks to scale the company\u0027s former on-premises environments. LTI provides IT consulting and digital services to companies in 27 countries.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/LarsenToubroInfotech_Customer-Reference_Logo.1105a2bf84bf68b4a8ee88c10b42b8feb2471b07.png","displayLocation":"Latin America","footerInfoText":"Published Date","description":"\u003cp\u003eLTI is running SAP S/4HANA on the highly agile AWS Cloud, enabling the company to scale the environment in minutes when it used to take weeks to scale the company\u0019s former on-premises environments. LTI provides IT consulting and digital services to companies in 27 countries. It runs SAP S/4HANA on the AWS Cloud using Amazon EC2 instances to support the applications and database, Amazon EBS for storage, Amazon S3 for backups, and AWS Lambda for optimization.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/lti/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Larsen \u0026 Toubro Infotech (LTI)","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Larsen \u0026 Toubro Infotech (LTI) Case Study"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0