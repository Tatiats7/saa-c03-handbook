LOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notification Service (SNS)","dateCreated":"2020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"}]},{"item":{"id":"customer-references#dentro-da-historia-storage","locale":"en_US","directoryId":"customer-references","name":"dentro-da-historia-storage","dateCreated":"2023-06-01T23:04:58+0000","dateUpdated":"2023-06-08T04:07:48+0000","additionalFields":{"descriptionSummary":"A Dentro da História é uma startup de livros personalizados focados em crianças. Com o apoio da AWS, a empresa montou uma estrutura na nuvem que permite fornecer uma experiência fluida de personalização e compra ao cliente.  Felipe Ferracini Paniago, cofundador e CTO da Dentro da História, revela que toda a infraestrutura da empresa está basicamente sobre Amazon Elastic Compute Cloud (Amazon EC2), com mais de 30 máquinas rodando simultaneamente.Além disso, a Dentro da História trabalha com Amazon Relational Database Service (Amazon RDS) e microsserviços no AWS Lambda para a geração dos arquivos PDF. Veja neste vídeo como os serviços AWS viabilizam a produção e entrega de um livro em apenas quatro dias, e como a AWS apoia o desenvolvimento de novos negócios.","imageSrcUrl":"https://d1.awsstatic.com/WWPS/images/folder/dentro.b7fd665d73ee0744c00402b80f9b6901038e09c8.jpg","displayLocation":"Brasil","customerNameLower":"dentro da história","footerInfoText":"Data de publicação","industry":"Mídia e entretenimento","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/dentro-da-historia-storage/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Dentro da História","enableShare":"1","publishedDate":"2023","contentType":"História do cliente","headline":"Dentro da História transforma crianças em personagens de livros com o apoio da AWS"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#custome