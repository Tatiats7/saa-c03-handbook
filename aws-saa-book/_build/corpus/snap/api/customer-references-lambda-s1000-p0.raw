ess Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#hyatt","locale":"en_US","directoryId":"customer-references","name":"hyatt","dateCreated":"2020-05-04T20:25:19+0000","dateUpdated":"2023-07-12T01:40:52+0000","additionalFields":{"descriptionSummary":"Headquartered in Chicago, Hyatt Hotels is a leading global hospitality company, with a portfolio comprised of 19 premier brands spanning more than 850 properties across 60 countries. Srihari Thotapalli, global head of analytics for Hyatt, explains how technology powered by Amazon Web Services (AWS) enables personalized experiences that elevate Hyatt\u0027s hospitality.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20