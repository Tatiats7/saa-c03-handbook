AL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#lex","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Lex","description":"Amazon Lex","dateCreated":"2020-03-02T07:04:21+0000","dateUpdated":"2022-02-03T03:32:47+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#unox-it","locale":"en_US","directoryId":"customer-references","name":"unox-it","dateCreated":"2024-09-18T20:02:45+0000","dateUpdated":"2024-09-18T20:08:11+0000","additionalFields":{"descriptionSummary":"UNOX ha rivoluzionato il proprio servizio clienti su Amazon Web Services (AWS) utilizzando Amazon Connect, un contact center cloud omnicanale semplice da utilizzare. Dopo quel successo, UNOX ha deciso di puntare tutto su AWS, migrando il sistema Enterprise Resource Planning (ERP) SAP On-Premise, l\u0027infrastruttura HANA (high-performance analytics appliance), il sito web aziendale e il configuratore di prodotti nel cloud. Ha anche iniziato a utilizzare i servizi serverless di AWS per creare nuovi progetti all\u0027avanguardia per la cottura dei cibi orientata ai dati e i forni smart. Puntando tutto su AWS, UNOX ha registrato un aumento complessivo dei risparmi sui costi, l\u0027ottimizzazione dei tempi e la soddisfazione del cliente.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/unox_Logo%401x.d22b2c3ef3d7b0850664cb466de2a80f9da162b5.png","displayLocation":"Italia","customerNameLower":"unox","footerInfoText":"Data di pubblicazione","industry":"Settore manifatturiero","sortDate":"2021-03-05","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/unox/?did\u003