,"dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"}]},{"item":{"id":"customer-references#uhb","locale":"en_US","directoryId":"customer-references","name":"uhb","dateCreated":"2024-09-21T00:13:39+0000","dateUpdated":"2024-09-21T00:15:47+0000","additionalFields":{"descriptionSummary":"Hokkaido Cultural Broadcasting airs a variety of news and shows that showcase the nature, food, and tourist attractions of Hokkaido, Japan. Expanding its online streaming services, the station used generative artificial intelligence (AI) and text-to-speech from Amazon Web Services (AWS) to streamline production of news scripts and videos, resulting in a low-cost solution to deliver more news. The broadcaster also made news sources easier to search using Amazon DynamoDB—a serverless, NoSQL database service.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/uhb-logo%401x.66b1f5d10436eac74a8f42556e23afa1e04e9b46.png","displayLocation":"Japan","customerNameLower":"uhb","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2024-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/uhb?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"UHB","publishedDate":"2024","enableShare":"1","headline":"Hokkaido Cultural Broadcasting Streamlines Production of News Scripts and Videos Using Amazon Bedrock to Deliver More News at a Lower Cost","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#methodology#devops","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"DevOps","description":"DevO