019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#location#indonesia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Indonesia","description":"Indonesia","dateCreated":"2020-02-03T05:29:22+0000","dateUpdated":"2022-02-03T03:31:36+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#neumora03302022lknsrglihsef","locale":"en_US","directoryId":"customer-references","name":"neumora03302022lknsrglihsef","dateCreated":"2022-05-23T21:42:35+0000","dateUpdated":"2024-05-07T16:34:53+0000","additionalFields":{"featured":"0","descriptionSummary":"Neumora Therapeutics leverages AWS to pioneer a computational psychiatry platform to advance its pipeline of novel therapeutics designed to restore balance to dysregulated brain circuits. They utilized a fully managed FSx for Lustre eliminated the operational storage overhead with their MRI workloads. The Amazon FSx is integrated with Amazon S3 orchestrated with Amazon Batch to provide an accelerated  end-to-end data processing  as well as seamless auto-scaling access to compute performance using Amazon EC2 instances. Neumora Therapeutics was able to process and visualize magnetic imaging data (MRI) at scale. They have increased their time-to-insight from weeks-to-hours (20x improvement) and Improved scalability and performance by 5x.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/neumora-logo%401x.ad88ac11019a53454f3f7f188f44a43b8b900df1.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2022-03-30","headlineUrl":"https://youtu.be/EiljRL0977M?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Neumora Therapeutics","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Neumora Therapeutics: Advanced MRI Precision Medicine and Brain Data Analysis Visualization at Scale"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#reference-ar