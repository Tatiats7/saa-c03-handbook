LOBAL#location#israel","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Israel","description":"Israel","dateCreated":"2020-02-03T05:30:21+0000","dateUpdated":"2022-02-03T03:31:55+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"IoT","description":"IoT","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2022-02-03T03:35:28+0000"}]},{"item":{"id":"customer-references#mapfre-video","locale":"en_US","directoryId":"customer-references","name":"mapfre-video","dateCreated":"2020-11-09T18:06:14+0000","dateUpdated":"2021-12-22T20:28:17+0000","additionalFields":{"descriptionSummary":"Spain-based Insurance firm MAPFRE employs 36,000 people in 100 countries and serves 30 million customers worldwide. In this video, Mónica García Cristóbal, digital IT director at MAPFRE, explains how the company developed its framework for building mobile apps on Amazon Web Services (AWS) with services such as AWS Lambda. The framework relies on the principles of continuous deployment and infrastructure as code, so MAPFRE can quickly deliver scalable mobile applications to a global customer base.Using AWS, MAPFRE has lowered time to market by 40 percent because it can deploy on various device types with one source of code. The business has also reduced costs by 20 percent by paying for infrastructure only when it needs it, and scaling up and down quickly to match demand.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Mapfre_Customer-Reference_Logo@1x.d9d873fd9021f8a685f440bc1bcf522f10cf820b.png","displayLocation":"Spain","footerInfoText":"Published Date","industry":"Insurance","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/mapfre-video/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"MAPFRE Lowers Time to Market by 40% Using AWS","customer-name":"MAPFRE"}},"tags":[{"id":"GLOBAL#