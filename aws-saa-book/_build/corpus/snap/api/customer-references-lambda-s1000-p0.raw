0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/coca-cola-logo%401x.4c9be67ec52d063bf4c44c482d50900e4bad7129.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Consumer Packaged Goods (CPG)","sortDate":"2021-07-23","headlineUrl":"https://aws.amazon.com/solutions/case-studies/coca-cola-andina-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Coca-Cola Andina","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Coca-Cola Andina increases analytics productivity by 80%, ensuring smart decisions, and maintaining a competitive advantage through AWS services"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#data-lakes-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Data Lakes \u0026 Analytics","description":"Data Lakes \u0026 Analytics","dateCreated":"2019-07-22T18:31:39+0000","dateUpdated":"2022-02-07T13:55:55+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#use-case#data-lakes","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Data Lakes","description"