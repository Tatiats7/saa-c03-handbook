ory","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"}]},{"item":{"id":"customer-references#electronic-caregiver-case-study","locale":"en_US","directoryId":"customer-references","name":"electronic-caregiver-case-study","dateCreated":"2019-07-19T14:56:00+0000","dateUpdated":"2023-07-12T01:35:29+0000","additionalFields":{"featured":"0","descriptionSummary":"Electronic Caregiver is helping seniors age in place longer with Addison Care, a virtual caregiving solution built on AWS. The company is a leader in connected health and safety monitoring devices. Addison Care features an AR host built on Amazon Sumerian and relies on Amazon Lex for language understanding, Amazon Polly for text-to-speech, and Amazon DynamoDB for storing health markers as well as business-logic processes to be executed by AWS Lambda.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/ElectronicCaregiver_Customer-Reference_Logo.e2eec99978bdc90b1f62ce81ade7b9c3a82971a5.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eElectronic Caregiver is helping seniors age in place longer with Addison Care, a virtual caregiving solution built on AWS. The company is a leader in connected health and safety monitoring devices. Addison Care features an AR host built on Amazon Sumerian and relies on Amazon Lex for language understanding, Amazon Polly for text-to-speech, and Amazon DynamoDB for storing health markers as well as business-logic processes to be executed by AWS Lambda.\u003c/p\u003e\r\n","industry":"Healthcare","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/electronic-caregiver/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Electronic Caregiver","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Electronic Caregiver Case Study"}},"tags":[{"id":"GLOBAL#product#polly","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Polly","description":"Amazon Polly","dateCreated":"2020-03-02T07:04:53+0000","dateUpdated":"2022-02-03T03:32:54+0000"},{"id":"GLOBAL#product#sumerian","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Sumerian","description":"Amazon Sumerian","dateCreated":"2020-03-02T07:05:42+0000","dateUpdated":"2022-02-03T03:33:03+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#tech-category#ar-vr","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"AR \u0026 VR","description":"AR \u0026 VR","dateCreated":"2020-01-16T17:43:06+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#lex","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Lex","description":"Amazon Lex","dateCreated":"2020-03-02T07:04:21+0000","dateUpdated":"2022-02-03T03:32:47+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#idorsia","locale":"en_US","directoryId":"customer-references","name":"idorsia","dateCreated":"2020-01-24T23:38:05+0000","dateUpdated":"2023-07-12T01:35:34+0000","additionalFields":{"featured":"0","descriptionSummary":"AWS products allow life sciences startups to compete with Big Pharma by using cloud services. Idorsia is a startup pharmaceutical company that discovers and develops innovative medicines. Idorsia runs 90 percent of its computing needs using AWS products such as Amazon WorkSpaces and AWS Lambda.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Idorsia_Logo@1x.f5eeaaf180918c0b66d07afddbc1c5f5c690be68.png","displayLocation":"Switzerland","footerInfoText":"Published Date","industry":"Life Sciences","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/idorsia-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Idorsia","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"AWS Enables Quick, Low-Cost Launch for Startup Pharma Company Idorsia"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","na