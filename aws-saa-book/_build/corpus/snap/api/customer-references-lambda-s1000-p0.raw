, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#helixleisure-embed","locale":"en_US","directoryId":"customer-references","name":"helixleisure-embed","dateCreated":"2021-12-14T02:50:27+0000","dateUpdated":"2023-07-14T23:32:51+0000","additionalFields":{"descriptionSummary":"Embed provides family entertainment center business owners with an integrated cashless business management platform and solutions. Migrating its data to an Amazon Redshift cloud data warehouse helped the company become a multi-tenant SaaS provider with advanced cross-tenant analytics capabilities.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Embed%20logo%401x.d3ccf1a138dd9f64966a1cc64af742f2734ddc63.png","displayLocation":"Singapore","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/helixleisure-embed/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"Embed","contentType":"Customer Story","