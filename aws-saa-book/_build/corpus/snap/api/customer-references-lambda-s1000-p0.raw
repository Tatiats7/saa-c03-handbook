"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"}]},{"item":{"id":"customer-references#autodesk-big-data-processing","locale":"en_US","directoryId":"customer-references","name":"autodesk-big-data-processing","dateCreated":"2020-11-12T18:43:44+0000","dateUpdated":"2023-07-19T03:04:47+0000","additionalFields":{"featured":"0","descriptionSummary":"Autodesk is a leading software provider in 3D design for architecture, engineering, manufacturing, media, and entertainment industries. The Autodesk Data Platform (ADP) collects and processes product usage data, providing Autodesk\u0027s operating teams with a product analytics platform. By migrating from a Spark-based processing system to AWS Lambda, Autodesk saves up to 90 percent in data processing costs annually. Today, Autodesk is able to process data in near real-time, providing timely analytics for business users to leverage for product improvements and other business opportunities.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/autodesk-logo-2022%401x.c2c78e83fe77cfbe57e586f0465bf8f70e5089ce.png","displayLocation":"Asia Pacific","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2020-11-12","headlineUrl":"https://aws.amazon.com/solutions/case-studies/autodesk-big-data-processing/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Autodesk","enableShare":"1","publishedDate":"2020","