description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notification Service (SNS)","dateCreated":"2020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"}]},{"item":{"id":"customer-references#innovasport","locale":"en_US","directoryId":"customer-references","name":"innovasport","dateCreated":"2023-06-01T23:11:10+0000","dateUpdated":"2023-06-08T04:07:33+0000","additionalFields":{"descriptionSummary":"Innovasport es una empresa que ya tiene cerca de 22 años en el mercado mexicano, 100% enfocada al sport guiter, con dos focos principales: Innovasport que está enfocada al deporte 100%, a lo que son los Sporting Goods, e Innvictus, que tiene un toque un poco más casual conocido como athletic specialty. Migró a Amazon Web Services en 2017, quien le ayudó a superar el reto que representó la pandemia por Covid-19, y le permitió tener un 200% de crecimiento orgánico en su e-commerce, gracias a una infraestructura con alta escalabilidad.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/innovasport-logo%402x.17af3c042c7a9d3abc05d16a3d15c11df88b7747.png","displayLocation":"México","footerInfoText":"Fecha de publicación","industry":"Venta al por menor","sortDate":"2021-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/innovasport/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"Historia del cliente","customer-name":"Innovasport","headline":"Innovasport alcanza crecimiento de 200% en e-commerce, aún en pandemia, utilizando tecnologías AWS"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applicatio