eive results in minutes and only pay for the compute they use, eliminating the need for constantly running servers while enhancing durability across multiple Availability Zones.","featureImageURL":"https://d1.awsstatic.com/vertex-logo.f79b42561d2db9c871aa835467aed7f8f312014f.jpg","imageSrcUrl":"https://d1.awsstatic.com/vertex-logo.f79b42561d2db9c871aa835467aed7f8f312014f.jpg","displayLocation":"Americas","customerNameLower":"vertex pharmaceuticals","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2024-10-29","headlineUrl":"https://aws.amazon.com/solutions/case-studies/vertex-pharmaceuticals-distributed-map/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Vertex Pharmaceuticals","publishedDate":"2024","enableShare":"1","headline":"Reducing Processing Time by 11x and Cost by 90% Using AWS Step Functions at Vertex Pharmaceuticals","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Mobile","description":"Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2023-08-22T20:28:38+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#industry#life-sciences","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Life Sciences","description":"Life Sciences","dateCreated":"2020-01-16T17:42:31+0000","dateU