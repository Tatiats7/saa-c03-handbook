ted":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"customer-references#category#business-applications-ec2-windows-server","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: EC2 Windows Server","description":"Business Applications: EC2 Windows Server","dateCreated":"2019-07-22T18:31:09+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#shield","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Shield","description":"AWS Shield","dateCreated":"2020-03-02T07:05:24+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000","dateUpdated":"2022-02-03T03:32:39+0000"}]},{"item":{"id":"customer-references#copec-case-study-from-es-directory","locale":"en_US","directoryId":"customer-references","name":"copec-case-study-from-es-directory","dateCreated":"2024-02-03T03:46:41+0000","dateUpdated":"2024-02-06T01:35:38+0000","additionalFields":{"descriptionSummary":"En 2022, COPEC, una de las principales distribuidoras de combustible de Chile, adoptó Red Hat OpenShift (ROSA) en Amazon Web Services como su nuevo canal de integraciones. De la mano con Escala 24x7, la compañía logró hacer su transformación tecnológica en tres meses.\nEn este video, Eduardo Diaz, arquitecto de integraciones, y Olaya Medina, jefa de arquitectura de COPEC, explican que la empresa definió que todas sus nuevas plataformas serían construidas con servicios de AWS. La nueva arquitectura los llevó a beneficios de negocio como la reducción de los tiempos de respuesta en un 50%, tener la capacidad de escalar y mejorar su time-to-market.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/copec%20logo%402x.87cf65990d1991c831e3fb316a5ed2a00736303a.png","displayLocation":"Chile","customerNameLower":"copec","footerInfoText":"Fecha de publicación","industry":"Fabricación","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/copec-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Copec","enableShare":"1","publishedDate":"2023","contentType":"Historia del cliente","headline":"COPEC reduce tiempos de respuesta en un 50% con migración a la nube AWS"}},"tags":[{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#location#chile","locale":"en_US