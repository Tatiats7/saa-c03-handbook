ung. Die IT-Organisation hatte Schwierigkeiten, die von der RBI erwartete Agilität und Flexibilität zu bieten. Die Mitarbeiter waren damit beschäftigt, Kapazitätsprobleme zu lösen und den Datenverarbeitungsbedarf zu decken, also beschloss die Bank, alle neuen Initiativen mit Blick auf eine Cloud-Lösung zu entwickeln.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/raiffeisen-informatik%401x.ebfe62a6f14c1132f95611af5f7f55471fa96830.png","displayLocation":"DACH","customerNameLower":"raiffeisen bank international (rbi)","industry":"Finanzdienstleistungen","sortDate":"2022-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/raiffeisen-bank-international-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2022","contentType":"Kundengeschichte","customer-name":"Raiffeisen Bank International (RBI)","headline":"Raiffeisen Bank International startet skalierbare Finanzplattform mit AWS"}},"tags":[{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#language#german","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"German","description":"German","dateCreated":"2020-03-03T06:40:46+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"customer-references#category#app-integration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Application Integration","description":"Application Integration","dateCreated":"2019-07-22T18:30:54+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespac