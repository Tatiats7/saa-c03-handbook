","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#kansas-city-with-xaqt-case-study","locale":"en_US","directoryId":"customer-references","name":"kansas-city-with-xaqt-case-study","dateCreated":"2019-07-22T19:44:35+0000","dateUpdated":"2022-01-21T02:40:36+0000","additionalFields":{"featured":"0","descriptionSummary":"The City of Kansas City connected its smart city infrastructure with Xaqt on AWS, enabling it to create powerful predictive models that improve quality of life and reduce costs. One of the most connected smart cities in the United States, Kansas City takes advantage of a public-private partnership to build out a sophisticated network of sensors and access points for big-data insights.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/600x400%20Kansas_City_Logo.0653eb367abefecce61e82b104d8edb6f6b63fdf.jpg","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eThe City of Kansas City connected its smart city infrastructure with Xaqt on AWS, enabling it to create powerful predictive models that improve quality of life and reduce costs\u003c/p\u003e\r\n","industry":"Government","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/kansas-city/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Kansas City with Xaqt","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Kansas City with Xaqt Case Study"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en