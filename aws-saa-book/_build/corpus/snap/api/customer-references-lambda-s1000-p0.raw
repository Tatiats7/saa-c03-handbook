en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#innovator#siemens","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Siemens","description":"Siemens","dateCreated":"2022-04-25T19:06:51+0000","dateUpdated":"2022-07-16T00:04:48+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"}]},{"item":{"id":"customer-references#cepsa-case-study","locale":"en_US","directoryId":"customer-references","name":"cepsa-case-study","dateCreated":"2021-03-11T23:43:58+0000","dateUpdated":"2023-07-12T01:40:42+0000","additionalFields":{"featured":"0","descriptionSummary":"Cepsa is a 90-year-old energy and petrochemical company headquartered in Spain. The firm employs nearly 10,000 people across a global network of oilfields, refineries, chemical plants, and service stations. Cepsa is undergoing a digital transformation. It recognizes that it can use the data that it produces each day to improve operations, make predictions, and turn data and algorithms into revenue-generating commodities. In this video, Joaqu\u0026iacute;n Abril-Martorell, chief digital officer at Cepsa, describes the company\u0027s journey so far and explains the role of Amazon Web Services (AWS) in helping deliver its digitization program. In the first 18 months, Cepsa completed 48 projects, exceeding income projections and boosting plant performance along the way.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Cepsa_Customer-Reference_Logo@1x.b560ad5931f05d164fa73950a79b785d68d6b7ef.png","displayLocation":"Spain","footerInfoText":"Published Date","industry":"Energy","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/cepsa-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Cepsa","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Cepsa Turns Data into Revenue Opportunities with AWS"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Stor