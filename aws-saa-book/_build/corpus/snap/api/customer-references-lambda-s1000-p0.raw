8:30+0000","dateUpdated":"2023-06-08T04:07:37+0000","additionalFields":{"descriptionSummary":"Expediente Azul es una compañía dedicada a facilitar negocios de sus clientes a través de la automatización del seguimiento, recolección y validación de requisitos y documentos. Con una plataforma sencilla que se adapta a cualquier empresa, Expediente Azul crea orden, velocidad y más cierres de negocios al simplificar y garantizar seguridad a los procesos e integración de expedientes.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/expedienteazul_Logo%401x.a25cdb906d12ed8801eaa703f247df583bcddd4e.png","displayLocation":"México","footerInfoText":"Fecha de publicación","industry":"Servicios financieros","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/expedienteazul/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"Historia del cliente","customer-name":"Expediente Azul","headline":"Expediente Azul acelera el cierre de negocios de sus clientes con AWS"}},"tags":[{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#use-case#datacenter-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2020-08-18T05:17:48+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+00