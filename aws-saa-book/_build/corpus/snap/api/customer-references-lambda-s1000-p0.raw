03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"}]},{"item":{"id":"customer-references#rotoplas","locale":"en_US","directoryId":"customer-references","name":"rotoplas","dateCreated":"2023-06-01T23:06:13+0000","dateUpdated":"2023-06-08T04:07:40+0000","additionalFields":{"descriptionSummary":"Grupo Rotoplas es una empresa mexicana con presencia en 15 países y con 27 líneas de productos, 17 plantas, más de 3,300 colaboradores y 12 mil distribuidores. Posee 29 mil puntos de venta y 50 mil puntos de servicios. La empresa contaba con un data center propio para su operación desde Estados Unidos hasta Argentina, y ante la edad de sus 300 servidores y la demanda por más capacidad, buscaron un proveedor que les ayudara a tener mayor escalabilidad, seguridad y disponibilidad. AWS fue su aliado en la migración de su negocio a la nube, la cual, además, se realizó en tiempo récord.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/rotoplas_Logo%401x.a2e976a6fa99d3e584ef36179ba7da5b9b65af45.png","displayLocation":"México","customerNameLower":"rotoplas","footerInfoText":"Fecha de publicación","industry":"Fabricación","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/rotoplas/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Rotoplas","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"Rotoplas reduce en un 50% los tiempos de downtime de sistemas con migración de su negocio a la nube en tiempo récord"}},"tags":[{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","d