","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#location#mexico","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Mexico","description":"Mexico","dateCreated":"2020-04-09T00:25:53+0000","dateUpdated":"2022-02-03T03:31:31+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#industry#automotive","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Automotive","description":"Automotive","dateCreated":"2020-01-16T17:42:11+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#puraset-case-study","locale":"en_US","directoryId":"customer-references","name":"puraset-case-study","dateCreated":"2022-10-03T18:33:47+0000","dateUpdated":"2023-07-14T23:32:34+0000","additionalFields":{"descriptionSummary":"Puraset aims to create a solution that can deliver safe drinking water for less than a tenth of the cost that people were paying for bottled water in at-risk communities. The Hungary-based company uses AWS to remotely manage its innovative, portable water treatment units from anywhere in the world. Using AWS IoT Core, Puraset can monitor its PurAID portable water purifiers to ensure they are operating effectively in the field with just two operators for up to 100 units. It can also collect and analyze usage data to improve the quality of water treatment over time, and ease infrastructure maintenance so that it can focus on designing long-term solutions for the developing world.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/puraset-logo%401x.dd4227837e6915d569e5de308da48d58b60525e8.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"puraset","footerInfoText":"Published Date","industry":"Manufacturing","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/puraset-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Puraset","publishedDate":"2022","enableShare":"1","headline":"Puraset Provides Safe Drinking Water to At-Risk Communities Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#tech-category#containers","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Containers","description":"Containers","dateCreated":"2020-02-13T00:27:17+0000