me Video is the video-streaming service from Amazon, the world\u0027s leading online retailer.","imageSrcUrl":"https://d1.awsstatic.com/amazon-logo-1x.a64c3eedfb84347ecf50e210637c0cf810922e10.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eAmazon migrated a service that supports Prime Video from Oracle to Amazon DynamoDB to increase scale and resilience while reducing cost. Amazon moved billions of rows of data to Amazon DynamoDB with zero downtime.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/prime_video_dynamoDB/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Amazon Prime Video","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Prime Video - Boosts Scale and Resilience"}},"tags":[{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#amazon","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Amazon","description":"Amazon","dateCreated":"2022-04-25T19:05:23+0000","dateUpdated":"2022-06-27T20:43:38+0000"},{"id":"customer-references#recon#auto-campaign","locale":"en_US","tagNamespaceId":"customer-references#recon","name":"auto-campaign","description":"\u003cp\u003eauto-campaign\u003c/p\u003e\n","dateCreated":"2023-12-04T18:22:48+0000","dateUpdated":"2023-12-04T18:22:48+0000"}]},{"item":{"id":"customer-references#aws-case-study-cyberlink","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-cyberlink","dateCreated":"2019-07-19T15:19:41+0000","dateUpdated":"2021-12-22T19:42:12+0000","additionalFields":{"featured":"0","descriptionSummary":"CyberLink cuts development time for U Webinar in half by using AWS and cuts IT administration by 28 percent. CyberLink is a leading provider of multimedia software and a pioneer in video and audio technologies.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/CyberLink_Customer-Reference_Logo.a048ec5e47e002534c609e53ac7b7c752eaf77b4.png","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003eRead the CyberLink customer case study. CyberLink cuts development time for U Webinar in half by using the AWS Cloud and cuts IT administration by 28 percent. CyberLink is a leading provider of multimedia software and a pioneer in video and audio technologies. The company runs U Webinar from the AWS Cloud, using Amazon EC2 instances for web and streaming services, Amazon RDS as a fully managed database, and AWS Lambda for U Webinar\u0019s Smart Index feature.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/cyberlink/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"CyberLink","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"AWS Case Study - CyberLink"}},"tags":[{"id":"GLOBAL#location#taiwan","locale":"en_US","tagNamespaceId":