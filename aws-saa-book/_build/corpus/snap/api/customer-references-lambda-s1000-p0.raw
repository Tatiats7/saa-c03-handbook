00","dateUpdated":"2022-12-14T23:42:29+0000","additionalFields":{"descriptionSummary":"By building its recruitment platform on AWS, HirePro can reduce the time to hire by about 75 percent and automatically scale its infrastructure to handle hundreds of thousands of concurrent assessments and interviews. HirePro is a recruitment automation company utilizing artificial intelligence (AI) to enable remote hiring.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Hirepro_logo%401x.a9e2cc667aafaf2f025225afe6c0ec21ee1f457b.png","displayLocation":"India","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/hirepro-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"HirePro","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"HirePro Runs Its Artificial Intelligence on AWS to Deliver Frictionless Virtual Hiring"}},"tags":[{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#use-case#remote-work-learning","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Remote Work \u0026 Learning","description":"Remote Work \u0026 Learning","dateCreated":"2020-08-20T04:26:30+0000","dateUpdated":"2022-02-03T03:35:55+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"custo