ory#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#streamamg-case-study","locale":"en_US","directoryId":"customer-references","name":"streamamg-case-study","dateCreated":"2022-12-13T02:08:19+0000","dateUpdated":"2022-12-13T02:15:27+0000","additionalFields":{"descriptionSummary":"StreamAMG enables organisations across sports, media and betting to deliver video content at scale and offer exceptional streaming experiences. In 2020, with COVID-19 disruption growing and matches played behind closed doors, the company began planning for a very different season – one where more users than ever would rely on its over-the-top (OTT) platforms to support their club, and clubs would increasingly rely on streamed matches as a revenue source. By moving AWS, the company delivered 2.9 million streams, watched by hundreds of thousands of fans, and an overall data uplift of 500 percent – all without a hitch and with no updates to the architecture needed.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/streamamg-logo%401x.e6fd697e61e9ae6b7f10148e0d608b914ab084d3.png","displayLocation":"United Kingdom","customerNameLower":"streamamg ltd","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2022-12-02","headlineUrl":"https://aws.amazon.com/solutions/case-studies/StreamAMG-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"StreamAMG Ltd","publishedDate":"2022","enableShare":"1","headline":"StreamAMG Scores Record Viewership and Uninterrupted Delivery","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":