n":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#capital-express-netred-es-2025","locale":"en_US","directoryId":"customer-references","name":"capital-express-netred-es-2025","dateCreated":"2025-02-20T20:30:30+0000","dateUpdated":"2025-03-06T23:48:44+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eLa compa\u0026ntilde;\u0026iacute;a de servicios de factoring Capital Express quer\u0026iacute;a mejorar las evaluaciones de los clientes y hacer crecer su negocio, pero ten\u0026iacute;a un sistema obsoleto que dificultaba el acceso a los datos. La compa\u0026ntilde;\u0026iacute;a recurri\u0026oacute; al socio de AWS, NetRed, para migrar sus datos utilizando los servicios de Amazon Web Services (AWS). Gracias a la migraci\u0026oacute;n, Capital Express pudo crear Advance, una innovadora herramienta de gesti\u0026oacute;n financiera que ofrece un procesamiento de datos en tiempo real. La implementaci\u0026oacute;n de Advance redujo los costos operativos mensuales en un 94 por ciento. Tambi\u0026eacute;n disminuy\u0026oacute; el tiempo necesario para la inscripci\u0026oacute;n de clientes y las consultas de TI a solo cinco minutos. Estas mejoras han agilizado las operaciones y permiten una prestaci\u0026oacute;n de servicios m\u0026aacute;s r\u0026aacute;pida, lo que aumenta dr\u0026aacute;sticamente el potencial de crecimiento de Capital Express y ayuda a satisfacer las necesidades de los clientes con mayor rapidez.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Capital%20Express%20Logo%20200x70px.53db0b44c9b01b2a4966a2e27211ad98a79df25b.png","displayLocation":"Chile","footerInfoText":"2025","industry":"Financial Services","sortDate":"2025-02-20","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/capital-express-netred/","customer-name":"Capital Express","enableShare":"1","publishedDate":"2025","contentType":"Case Study","headline":"Capital Express Reduce los Costos Operativos Mensuales en un 94% con NetRed y AWS"}},"tags":[{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#amplify","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Amplify","description":"AWS Amplify","dateCreated":"2020-03-02T07:01:21+0000","dateUpdated":"2022-02-03T03:32:15+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#database-migration-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Database Migration Service (DMS)","description":"AWS Database Migration Service (DMS)","dateCreated":"2020-03-02T07:02:30+0000","dateUpdated":"2022-02-03T03:32:27+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#location#chile","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Chile","description":"Chile","dateCreated":"2020-07-02T22:30:55+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"}]},{"item":{"id":"customer-references#save-the-children-spain-devoteam-2025","locale":"en_US","directoryId":"customer-references","name":"save-the-children-spain-devoteam-2025","dateCreated":"2025-02-20T21:50:56+0000","dateUpdated":"2025-03-07T01:09:54+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eSave the Children Spain, part of a global NGO protecting children\u0026rsquo;s rights, faced challenges with its on-premises data management system. Unable to effectively integrate and analyze information from multiple sources, it struggled to personalize donor outreach and optimize fundraising. Partnering with AWS Premier Consulting Partner Devoteam, it implemented a cloud-based data-lake solution using Amazon Web Services (AWS). This transformation enabled seamless data integration, enhanced donor insights, and improved campaign effectiveness. The new system streamlined operations, reduced costs, and allowed Save the Children Spain to redirect more resources to humanitarian projects, benefiting children in need worldwide.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Save%20the%20Children%20Logo%20200x70px.491babb980be27c18da5181b4073e5658ef5d2f5.png","displayLocation":"Spain","footerInfoText":"2025","industry":"General Public Services","sortDate":"2025-02-20","headlineUrl":"https://aws.amazon.com/solutions/case-studies/save-the-children-spain-devoteam/","customer-name":"Save the Children Spain","enableShare":"1","publishedDate":"2025","contentType":"Case Study","headline":"Save the Children Spain Cuts Costs and Improves Campaigns with Devoteam’s AWS-Powered Data Solution"}},"tags":[{"id":"GLOBAL#location#spain","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Spain","description":"Spain","dateCreated":"2020-02-03T05:30:16+0000","dateUpdated":"2022-02-03T03:31:49+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#industry#general-public-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"General Public Services","description":"General Public Services","dateCreated":"2020-01-16T17:42:24+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#product#appflow","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon AppFlow","description":"Amazon AppFlow","dateCreated":"2020-06-25T04:09:13+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#database-migration-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Database Migration Service (DMS)","description":"AWS Database Migration Service (DMS)","dateCreated":"2020-03-02T07:02:30+0000","dateUpdated":"2022-02-03T03:32:27+0000"},{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notification Service (SNS)","dateCreated":"2020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#eventbridge","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EventBridge","description":"Amazon EventBridge","dateCreated":"2020-03-02T07:03:23+0000","dateUpdated":"2022-02-03T03:32:36+0000"}]},{"item":{"id":"customer-references#tehanu-adastra-anthropic-2025","locale":"en_US","directoryId":"customer-references","name":"tehanu-adastra-anthropic-2025","dateCreated":"2025-02-20T21:24:35+0000","dateUpdated":"2025-03-06T23:50:49+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eThe Tehanu project in Rwanda\u0026rsquo;s Volcanoes National Park has demonstrated groundbreaking use of generative AI to infer and act on the interests of mountain gorillas. Leveraging technology solutions from Amazon Web Services (AWS), AWS Partner Anthropic, and with the support of AWS Partner Adastra, Tehanu created an automated pipeline to process behavioral data of gorillas, enabling the first-ever digital financial transactions by a non-human species. The AI solution synthesized vast academic and observational data, aligning conservation actions with species-specific preferences while supporting biodiversity efforts. This scalable, innovative approach sets a precedent for using AI to foster coexistence across species worldwide.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Tehanu%20Logo%20200x70px.75aec8fe9a851db7dc6d6caa992f9617670e896d.png","displayLocation":"Rwanda","footerInfoText":"2025","industry":"General Public Services","sortDate":"2025-02-20","headlineUrl":"https://aws.amazon.com/solutions/case-studies/tehanu-adastra-anthropic/","customer-name":"Tehanu","enableShare":"1","publishedDate":"2025","contentType":"Case Study","headline":"Wildlife-Centered AI: How AWS and Tehanu Use Generative AI to Give Wildlife a Voice in Global Conservation"}},"tags":[{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#kenya","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Kenya","description":"Kenya","dateCreated":"2020-04-09T03:55:09+0000","dateUpdated":"2022-02-03T03:31:58+0000"},{"id":"GLOBAL#industry#social-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Social Services","description":"Social Services","dateCreated":"2020-06-25T04:08:10+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#africa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Africa","description":"Africa","dateCreated":"2020-04-09T03:54:59+0000","dateUpdated":"2022-02-03T03:31:56+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#bedrock","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Bedrock","description":"Amazon Bedrock","dateCreated":"2023-04-13T19:06:46+0000","dateUpdated":"2023-04-13T19:06:46+0000"}]},{"item":{"id":"customer-references#onemain-financial-aws-sfn-case-study","locale":"en_US","directoryId":"customer-references","name":"onemain-financial-aws-sfn-case-study","dateCreated":"2025-03-07T23:27:53+0000","dateUpdated":"2025-03-07T23:47:04+0000","additionalFields":{"descriptionSummary":"OneMain Financial used AWS Step Functions and Amazon EC2 to build its own digital forensics solution, OneFor(ensics), saving costs and reducing the time between alert and investigation.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/onemain-financial-logo%401x.9909bae073fded1168b974fb56065617dbd6c0fb.png","displayLocation":"United States","customerNameLower":"onemain financial","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2025-02-19","headlineUrl":"https://aws.amazon.com/solutions/case-studies/onemain-financial-aws-sfn-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"OneMain Financial","publishedDate":"2025","enableShare":"1","headline":"Speeding Up Security Forensics by 97.5% Using AWS Step Functions with OneMain Financial","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#step-functions","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Step Functions","description":"AWS Step Functions","dateCreated":"2020-03-02T07:05:39+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#app-integration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Application Integration","description":"Application Integration","dateCreated":"2019-07-22T18:30:54+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"}]},{"item":{"id":"customer-references#greenn-clouddog-2025","locale":"en_US","directoryId":"customer-references","name":"greenn-clouddog-2025","dateCreated":"2025-02-19T21:55:06+0000","dateUpdated":"2025-03-06T23:49:26+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eA Greenn \u0026eacute; uma plataforma de vendas online de produtos digitais - como livros eletr\u0026ocirc;nicos, cursos, mentorias e produtos f\u0026iacute;sicos - que integra uma s\u0026eacute;rie de solu\u0026ccedil;\u0026otilde;es que facilitam o com\u0026eacute;rcio eletr\u0026ocirc;nico. Criada com foco em empreendedores digitais, a plataforma oferece funcionalidades como gest\u0026atilde;o de assinaturas e antecipa\u0026ccedil;\u0026atilde;o de receitas. Este ano a empresa tornou-se uma subadquirente gra\u0026ccedil;as \u0026agrave; adequa\u0026ccedil;\u0026atilde;o de seu ambiente ao padr\u0026atilde;o PCI. O trabalho foi feito com o suporte da Clouddog, parceira AWS, que remodelou a arquitetura de seguran\u0026ccedil;a da empresa com servi\u0026ccedil;os AWS, permitindo a obten\u0026ccedil;\u0026atilde;o da certifica\u0026ccedil;\u0026atilde;o PCI em menos de seis meses.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Greenn%20Logo%20200x70px.09631ad08394eebbf1c1c6981835ed0d82c7d8b1.png","displayLocation":"Brazil","footerInfoText":"2025","industry":"Software \u0026 Internet","sortDate":"2025-02-19","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/greenn-clouddog/","customer-name":"Greenn","enableShare":"1","publishedDate":"2025","contentType":"Case Study","headline":"Serviços de Segurança AWS Levam Greenn a Obter a Certificação PCI"}},"tags":[{"id":"GLOBAL#tech-category#arch-strategy","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Architecture Strategy","description":"Architecture Strategy","dateCreated":"2020-01-16T17:43:08+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#eventbridge","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EventBridge","description":"Amazon EventBridge","dateCreated":"2020-03-02T07:03:23+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#product#cloudtrail","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudTrail","description":"AWS CloudTrail","dateCreated":"2020-03-02T07:02:05+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#product#waf","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS WAF","description":"AWS WAF","dateCreated":"2020-03-02T07:06:04+0000","dateUpdated":"2022-02-03T03:33:07+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#guardduty","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon GuardDuty","description":"Amazon GuardDuty","dateCreated":"2020-03-02T07:03:46+0000","dateUpdated":"2022-02-03T03:32:40+0000"}]},{"item":{"id":"customer-references#capital-express-netred-2025","locale":"en_US","directoryId":"customer-references","name":"capital-express-netred-2025","dateCreated":"2025-02-19T22:12:07+0000","dateUpdated":"2025-03-06T23:47:05+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eFactoring services company Capital Express wanted to improve client evaluations and grow its business, but it had an outdated system that made accessing data difficult. The company teamed up with AWS Partner NetRed to migrate its data using capabilities from Amazon Web Services (AWS). Migrating helped Capital Express create Advance, an innovative financial management tool that offers real-time data processing. Implementing Advance cut monthly operating costs by 94 percent. It also reduced the time needed for client enrollment and IT consultations to just five minutes. These improvements streamlined operations and enabled faster service delivery, dramatically increasing the growth potential of Capital Express and helping it meet customer needs faster.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Capital%20Express%20Logo%20200x70px.53db0b44c9b01b2a4966a2e27211ad98a79df25b.png","displayLocation":"Chile","footerInfoText":"2025","industry":"Financial Services","sortDate":"2025-02-19","headlineUrl":"https://aws.amazon.com/solutions/case-studies/capital-express-netred/","customer-name":"Capital Express","enableShare":"1","publishedDate":"2025","contentType":"Case Study","headline":"Capital Express Reduces Monthly Operating Costs by 94% with NetRed and AWS"}},"tags":[{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#chile","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Chile","description":"Chile","dateCreated":"2020-07-02T22:30:55+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#database-migration-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Database Migration Service (DMS)","description":"AWS Database Migration Service (DMS)","dateCreated":"2020-03-02T07:02:30+0000","dateUpdated":"2022-02-03T03:32:27+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"}]},{"item":{"id":"customer-references#houpa-darede-2025","locale":"en_US","directoryId":"customer-references","name":"houpa-darede-2025","dateCreated":"2025-02-14T22:33:38+0000","dateUpdated":"2025-03-06T23:43:21+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eFundada em 2018, a startup Houpa, tem como miss\u0026atilde;o levar a moda de todos para todos. Chegou inovando o jeito de comprar e vender roupas no atacado. Seu modelo de neg\u0026oacute;cio foi validado pela quantidade de usu\u0026aacute;rios cadastrados, pelo volume de transa\u0026ccedil;\u0026otilde;es realizadas, pela efici\u0026ecirc;ncia e facilidade de compra e venda que a solu\u0026ccedil;\u0026atilde;o entregava. Chegou a mais de 57 mil usu\u0026aacute;rios cadastrados em sua plataforma entre marcas, multimarcas e consumidores finais. No meio do caminho a startup enfrentou a chamada \u0026ldquo;dor do crescimento\u0026rdquo; e, para adequar sua infraestrutura \u0026agrave; velocidade de seu neg\u0026oacute;cio, contou com o apoio da Parceiro AWS Darede para moderniza\u0026ccedil;\u0026atilde;o de seu ambiente na nuvem AWS para uma arquitetura serverless.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/houpa%20Logo%20200x70px.6c59b7b4276dc971011c017087ad43e546e44f39.png","displayLocation":"Brazil","footerInfoText":"2025","industry":"Retail","sortDate":"2025-02-14","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/houpa-darede/","customer-name":"Houpa","enableShare":"1","publishedDate":"2025","contentType":"Case Study","headline":"Darede revoluciona ofertas do Houpa com arquitetura serverless AWS"}},"tags":[{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#industry#retail","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Retail","description":"Retail","dateCreated":"2020-01-16T17:42:39+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"}]},{"item":{"id":"customer-references#mortgage-advice-bureau-bjss-2025","locale":"en_US","directoryId":"customer-references","name":"mortgage-advice-bureau-bjss-2025","dateCreated":"2025-02-04T23:25:04+0000","dateUpdated":"2025-03-06T23:39:19+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eMortgage Advice Bureau (MAB) is an established, multi-award winning, UK mortgage intermediary that provides advice, both through its own branded brokers and through other brokers. It processes about 12,000 mortgages a month and receives around 400 complaints per year. Those complaints, however, are a serious matter, because MAB is regulated by the UK\u0026rsquo;s Financial Conduct Authority (FCA), whose Financial Ombudsman is the last resort for disputes. MAB wanted to ensure that it could resolve complaints in a timely manner and before they were escalated to the Financial Ombudsman. It engaged AWS Partner BJSS to help build a solution using AI on Amazon Web Services (AWS) to speed up the processing of complaints, reducing initial response times by 75 percent.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/MAB%20Logo%20200x70px.896be7912e01252f4ea23d3fb48d1f3feaea0a8f.png","displayLocation":"United Kingdom","footerInfoText":"2025","industry":"Financial Services","sortDate":"2025-02-04","headlineUrl":"https://aws.amazon.com/partners/success/mortgage-advice-bureau-bjss/","customer-name":"Mortgage Advice Bureau","enableShare":"1","publishedDate":"2025","contentType":"Case Study","headline":"Mortgage Advice Bureau and BJSS Accelerate Complaints Process Using AWS"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#bedrock","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Bedrock","description":"Amazon Bedrock","dateCreated":"2023-04-13T19:06:46+0000","dateUpdated":"2023-04-13T19:06:46+0000"},{