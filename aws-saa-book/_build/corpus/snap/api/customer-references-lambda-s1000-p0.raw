-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#eventbridge","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EventBridge","description":"Amazon EventBridge","dateCreated":"2020-03-02T07:03:23+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#product#batch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Batch","description":"AWS Batch","dateCreated":"2020-03-02T07:01:42+0000","dateUpdated":"2022-02-03T03:32:19+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"customer-references#category#hcls","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Healthcare \u0026 Life Sciences","description":"Healthcare \u0026 Life Sciences","dateCreated":"2019-07-22T18:31:58+0000","dateUpdated":"2022-05-14T20:13:37+0000"}]},{"item":{"id":"customer-references#prosiebensat1-media-se-case-study","locale":"en_US","directoryId":"customer-references","name":"prosiebensat1-media-se-case-study","dateCreated":"2022-03-24T02:45:23+0000","dateUpdated":"2022-03-24T02:46:36+0000","additionalFields":{"descriptionSummary":"By migrating to a serverless infrastructure on AWS, ProSiebenSat.1 Media SE subsidiary Seven.One Entertainment Group reduced costs by 60 percent and increased scalability to handle peaks in traffic.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/prosiebansat.1-media-se-seven.one-entertainment-group-logo%401x.de296510c7de28ceaa3668d4ffbcdf970732f880.png","displayLocation":"Germany","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2022-03-23","headlineUrl":"https://aws.amazon.com/solutions/case-studies/prosiebensat1-media-se-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"ProSiebenSat.1 Media SE Delivers Interactive TV Experiences Using AWS Serverless Solutions","customer-name":"Seven.One Entertainment Group"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Com