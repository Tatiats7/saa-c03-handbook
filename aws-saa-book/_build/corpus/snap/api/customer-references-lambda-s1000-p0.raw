one if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#britvic-case-study","locale":"en_US","directoryId":"customer-references","name":"britvic-case-study","dateCreated":"2022-05-09T21:31:15+0000","dateUpdated":"2022-08-31T21:01:23+0000","additionalFields":{"descriptionSummary":"Britvic has created an innovative digital flavor tap using Amazon Web Services (AWS). Aimed at offices and retail environments, the tap reduces plastic bottle use by dispensing zero calorie flavored water into reusable containers, providing a more sustainable and healthy way to enjoy beverages.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/britvic_customer-reference_logo2x.96f5db8f0a84adeb9cf75773dd640c769997c515.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","industry":"Consumer Packaged Goods (CPG)","sortDate":"2022-05-09","headlineUrl":"https://aws.amazon.com/solutions/case-studies/britvic-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Britvic Soft Drinks","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Britvic Launches Sustainable Digital Flavour Taps Using AWS"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","d