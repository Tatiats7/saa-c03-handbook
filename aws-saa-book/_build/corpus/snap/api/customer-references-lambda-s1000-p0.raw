+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#volkswagen-vr-ar","locale":"en_US","directoryId":"customer-references","name":"volkswagen-vr-ar","dateCreated":"2021-12-23T01:49:11+0000","dateUpdated":"2023-07-19T03:04:54+0000","additionalFields":{"featured":"0","descriptionSummary":"Volkswagen uses Amazon EC2 G4 Instances and software from VR software company Innoactive to optimize 3D data preparation and improve rendering speeds for VR applications while reducing costs.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/volkswagen-group-logo@1x.b28acee85fe276a4231c3680afe59f7a1107bcd3.png","displayLocation":"Germany","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2021-12-22","headlineUrl":"https://aws.amazon.com/solutions/case-studies/volkswagen-vr-ar/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Volkswagen Group","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Volkswagen Group Accelerates 3D Data Preparation and Remote Rendering for VR on AWS"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#dach","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"DACH","description":"DACH","dateCreated":"2020-02-03T05:29:52+0000","dateUpdated":"2022-02-03T03:31:47+0000"},{"id":"customer-references#category#ar-vr","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AR \u0026 VR","description":"AR \u0026 VR","dateCreated":"2019-07-22T18:30:57+0000","dateUpdated":"2022-06-27T20:43:36+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#industry#automotive","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Automotive","description":"Automotive","dateCreated":"2020-01-16T17:42:11+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#tech-category#ar-vr","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"AR \u0026 VR","description":"AR \u0026 VR","dateCreated":"2020-01-16T17:43:06+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#marketplace","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Marketplace","description":"AWS Marketplace","dateCreated":"2020-12-02T20:02:51+0000","dateUpdated":"2022-02-03T03:32:50+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#germany","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Germany","description":"Germany","dateCreated":"2020-02-03T05:29:55+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#vw-group","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Volkswagen","description":"Volkswagen","dateCreated":"2022-04-25T19:07:02+0000","dateUpdated":"2022-09-15T00:48:45+0000"}]},{"item":{"id":"customer-references#propertyfinder12222021kjnaefocihadw","locale":"en_US","directoryId":"customer-references","name":"propertyfinder12222021kjnaefocihadw","dateCreated":"2022-05-23T21:43:01+0000","dateUpdated":"2022-05-23T21:53:10+0000","additionalFields":{"descriptionSummary":"Property Finder Group is the leading real estate digital platform in the Middle East with Property Finder UAE (propertyfinder.ae) being the largest real estate platform in the UAE. They offer a wide range of residential and commercial properties for sale and rent. Property Finder are running their entire set of production applications (around 250+) on Amazon EKS with 100% spot instances. They migrated from On-Demand EC2 instance based monolith deployment to a microservices based architecture on Amazon EKS. YoY, they have seen almost a 15% reduction in costs after migrating to EKS. They use a combination of event based architecture with Rabbit MQ, Lambda, EventBridge and EKS with Spot instances.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/property-finder-logo%401x.efb1597c2724f47efaed744e2e830533c5f87623.png","displayLocation":"Europe, Middle East, \u0026 Africa","footerInfoText":"Published Date","industry":"Consumer Packaged Goods (CPG)","sortDate":"2021-12-22","headlineUrl":"https://youtu.be/cnZeOytEkIM?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Property Finder: Running Production Workloads with Amazon EKS on 100% Amazon EC2 Spot Instances","customer-name":"Property Finder"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#uae","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United Arab Emirates","description":"United Arab Emirates","dateCreated":"2020-02-03T05:30:23+0000","dateUpdated":"2022-02-03T03:31:56+0000"},{"id":"GLOBAL#industry#cpg","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Consumer Packaged Goods (CPG)","description":"Consumer Packaged Goods (CPG)","dateCreated":"2020-06-25T04:03:18+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#location#middle-east-africa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East \u0026 Africa","description":"Middle East \u0026 Africa","dateCreated":"2020-02-03T05:30:19+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#industry#construction-real-estate","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Construction \u0026 Real Estate","description":"Construction \u0026 Real Estate","dateCreated":"2020-06-25T04:03:46+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#reference-arch-diagram","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Reference Architecture Diagram","description":"Reference Architecture Diagram","dateCreated":"2020-04-29T05:19:31+0000","dateUpdated":"2022-02-03T03:31:09+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#eventbridge","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EventBridge","description":"Amazon EventBridge","dateCreated":"2020-03-02T07:03:23+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#location#middle-east","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East","description":"Middle East","dateCreated":"2020-04-09T03:53:16+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"}]},{"item":{"id":"customer-references#volkswagen-vr-ar-de","locale":"en_US","directoryId":"customer-references","name":"volkswagen-vr-ar-de","dateCreated":"2024-09-18T20:03:55+0000","dateUpdated":"2024-09-18T20:08:09+0000","additionalFields":{"descriptionSummary":"Der globale Automobilhersteller Volkswagen Group (Volkswagen) entwickelt Virtual Reality (VR) und Augmented Reality (AR)-Anwendungen, um Zeit und Kosten zu sparen und die Leistung für Anwendungsfälle über den gesamten Produktlebenszyklus hinweg zu verbessern, von der Konstruktionsprüfung über Schulungssimulationen bis hin zur Fernsteuerung in der Fertigung. Bei seinen Anstrengungen, AR/VR zu skalieren, benötigte Volkswagen eine schnellere, einfachere und effizientere Methode zur Vorbereitung und Bereitstellung von 3D-Inhalten im gesamten Unternehmen. Das Unternehmen hat eine Cloud-Architektur entwickelt, mit der es zwei Dinge umsetzen kann: die Automatisierung seiner 3D-Datenvorbereitungspipelines für eine schnellere und einfachere Optimierung von 3D-Modellen und das Testen der Fähigkeit, 3D-Grafiken per Fernzugriff auf AR/VR-Headsets zu rendern und zu streamen, um von Headsets wegzukommen, die durch eine Bindung an teure Workstations eingeschränkt sind.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/volkswagen-group-logo@1x.b28acee85fe276a4231c3680afe59f7a1107bcd3.png","displayLocation":"Deutschland","customerNameLower":"volkswagen group","industry":"Automobilbranche","sortDate":"2021-12-22","enableShare":"1","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/volkswagen-vr-ar/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"Kundengeschichte","customer-name":"Volkswagen Group","headline":"Der Volkswagen-Konzern beschleunigt 3D-Datenaufbereitung und Remote-Rendering für VR auf AWS"}},"tags":[{"id":"GLOBAL#industry#automotive","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Automotive","description":"Automotive","dateCreated":"2020-01-16T17:42:11+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#language#german","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"German","description":"German","dateCreated":"2020-03-03T06:40:46+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35