019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#confeorg","locale":"en_US","directoryId":"customer-references","name":"confeorg","dateCreated":"2023-06-01T23:11:31+0000","dateUpdated":"2023-07-14T23:32:26+0000","additionalFields":{"descriptionSummary":"La Confederación Nacional de Organismos de Apoyo al Tránsito (CONFEORG) es una entidad sin ánimo de lucro que agremia y representa a los organismos de apoyo a las autoridades de tránsito; empresas que prestan servicios relacionados con el tránsito en Colombia como: exámenes de aptitud médica y psicométrica, cursos de enseñanza automovilística para aspirantes a conducir vehículos, revisiones técnico-mecánicas y de emisiones contaminantes de vehículos, y cursos sobre normas de tránsito para infractores. Con la ayuda de AWS y su partner IKTINUS, lograron lanzar la aplicación en tiempo récord y cumplieron con todos los requisitos exigidos por la Superintendencia de Industria y Comercio (SIC), entre ellos, tener una disponibilidad del 98.5%.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/confeorg-logo%402x.479e4b1f2e7e0e6e7b083ea42625f1a5a3b5ff58.png","displayLocation":"Colombia","footerInfoText":"Fecha de publicación","industry":"S