:"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#bedrock","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Bedrock","description":"Amazon Bedrock","dateCreated":"2023-04-13T19:06:46+0000","dateUpdated":"2023-04-13T19:06:46+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#ai","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Artificial Intelligence","description":"\u003cp\u003eArtificial Intelligence\u003c/p\u003e\n","dateCreated":"2023-08-22T20:28:40+0000","dateUpdated":"2024-05-23T20:32:49+0000"},{"id":"customer-references#category#gen-ai","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gen AI","description":"\u003cp\u003eGenerative Artificial Intelligence\u003c/p\u003e\n","dateCreated":"2023-07-10T17:07:31+0000","dateUpdated":"2023-07-10T17:07:31+0000"},{"id":"GLOBAL#tech-category#gen-ai","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Generative AI","description":"\u003cp\u003eGenerative AI\u003c/p\u003e\n","dateCreated":"2023-08-22T20:28:41+0000","dateUpdated":"2024-05-23T20:34:52+0000"}]},{"item":{"id":"customer-references#natura-ia-generativa","locale":"en_US","directoryId":"customer-references","name":"natura-ia-generativa","dateCreated":"2024-08-16T12:46:14+0000","dateUpdated":"2024-08-23T15:50:04+0000","additionalFields":{"descriptionSummary":"A Natura é uma das líderes do setor de beleza e cosméticos na América Latina, com uma presença significativa e impactante na região. Com marcas renomadas como Natura e Avon, o grupo abrange uma ampla gama de produtos e serviços, que vão desde cuidados com a pele e cabelos até fragrâncias e maquiagem. Hoje, a Natura conta com 14,5 mil colaboradores distribuídos em 18 países, além de cinco fábricas e 19 centros de distribuição.","featureImageURL":"https://d1.awsstatic.com/customer-references-case-studies-logos/natura_Logo%402x.18d86a7d43a0801be2e919a15f637a01653d712a.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/natura_Logo%402x.18d86a7d43a0801be2e919a15f637a01653d712a.png","displayLocation":"Brazil","customerNameLower":"natura","footerInfoText":"Published Date","industry":"Manufacturing","sortDate":"2024-08-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/natura-ia-generativa/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Natura","publishedDate":"2024","enableShare":"1","headline":"Com IA generativa AWS, Busca Inteligente da Natura atende 1 milhão de consultoras","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-refe