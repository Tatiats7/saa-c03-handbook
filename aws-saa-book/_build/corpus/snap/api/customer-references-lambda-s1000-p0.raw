"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"}]},{"item":{"id":"customer-references#btobet-case-study","locale":"en_US","directoryId":"customer-references","name":"btobet-case-study","dateCreated":"2022-10-03T18:33:44+0000","dateUpdated":"2022-10-11T21:03:06+0000","additionalFields":{"descriptionSummary":"Betting on sporting events from the Olympics to Premier League soccer matches is a billion-dollar market characterized by surges in customer demand around live events. BtoBet provides betting and gambling businesses with its sportsbook solution, allowing individuals to place bets on sporting events. Since migrating to AWS, BtoBet can scale compute resources to handle spikes in demand and deliver a responsive experience for its partners and their players. It has also launched in new global markets and has the resources to support triple-digit customer growth. Using AWS, the company can manage double the volume of betting transactions without expanding its IT team.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/btobet-logo%401x.4df0a2219e8e635f58051432a3203b73a47807fd.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"btobet","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/BtoBet-Case-Study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"BtoBet","publishedDate":"2022","enableShare":"1","headline":"BtoBet Processes Trillions of Betting Requests, Boosts Customer Loyalty Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T0