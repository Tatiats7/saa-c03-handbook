22-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#workload#microsoft","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"Microsoft","description":"Microsoft","dateCreated":"2021-01-06T00:09:49+0000","dateUpdated":"2022-02-03T03:36:04+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#aws-case-study-coinbase","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-coinbase","dateCreated":"2019-07-22T19:52:37+0000","dateUpdated":"2023-07-14T23:32:43+0000","additionalFields":{"featured":"0","descriptionSummary":"Coinbase is the world\u0027s most popular bitcoin wallet, facilitating bitcoin transactions in 190 countries. The organization runs its global bitcoin exchanges, wallets, and an analytical insight pipeline on AWS. Using AWS, Coinbase has grown to support 3 million global bitcoin users and can analyze 1 TB of data each day for better insight into its business.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Coinbase_Customer-Reference_Logo.21892bc610021b17390aadf95f6958deaf5829ec.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eCoinbase is the world\u0026#39;s most popular bitcoin wallet, facilitating bitcoin transactions in 190 countries. The organization runs its global bitcoin exchanges, wallets, and an analytical insight pipeline on AWS. Using AWS, Coinbase has grown to support 3 million global bitcoin users and can analyze 1 TB of data each day for better insight into its business.\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/coinbase/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Coinbase","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Coinbase"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","