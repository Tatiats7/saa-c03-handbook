S Glue, Amazon Kinesis Analytics, AWS Lambda, Amazon S3, and Amazon SQS to deliver a data driven, event focused fleet management solution tied to better decision making and increased driver safety.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/lease-plan-logo%401x.a56b1246f15a867bcce14e15691f92c1e3a58aef.png","displayLocation":"Netherlands","footerInfoText":"Published Date","industry":"Transport \u0026 Logistics","sortDate":"2021-02-03","headlineUrl":"https://youtu.be/QOtCpD23118?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"LeasePlan: Leverages Serverless to Increase Driver Safety, Reduce Fleet Costs, and Lower Risk","customer-name":"LeasePlan Corporation"}},"tags":[{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#netherlands","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Netherlands","description":"Netherlands","dateCreated":"2020-02-03T05:29:50+0000","dateUpdated":"2022-02-03T03:31:41+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"