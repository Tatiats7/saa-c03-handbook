name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Internet of Things (IoT)","description":"Internet of Things (IoT)","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2023-08-22T20:28:39+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"GLOBAL#product#iot-button","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS IoT Button","description":"AWS IoT Button","dateCreated":"2020-03-02T07:03:58+0000","dateUpdated":"2022-02-03T03:32:42+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"}]},{"item":{"id":"customer-references#aws-case-study-connectwise","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-connectwise","dateCreated":"2019-07-22T19:51:22+0000","dateUpdated":"2023-07-14T23:32:39+0000","additionalFields":{"featured":"0","descriptionSummary":"ConnectWise uses AWS to easily detect and resolve application performance issues, troubleshoot problems in minutes instead of hours, and reduce latency and other challenges for customers. The organization provides an online business-management platform that IT services enterprises use to run their organizations more efficiently.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/ConnectWise_Customer-Reference_Logo.26ae56724cd081efd538c97cb63d61ab89d22228.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eConnectWise uses AWS to easily detect and resolve application performance issues, troubleshoot problems in minutes instead of hours, and reduce latency and other challenges for customers. The organization provides an online business-management platform that IT services enterprises use to run their organizations more efficiently. ConnectWise uses AWS X-Ray to debug and monitor applications, and Amazon CloudWatch to monitor its overall IT environment.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/connectwise/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ConnectWise","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: ConnectWise"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Optimization","de