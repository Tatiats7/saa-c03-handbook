 Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#industry#automotive","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Automotive","description":"Automotive","dateCreated":"2020-01-16T17:42:11+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#transitgateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Transit Gateway","description":"AWS Transit Gateway","dateCreated":"2020-03-02T07:05:54+0000","dateUpdated":"2022-02-03T03:33:05+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"customer-references#category#network","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2019-07-22T18:32:15+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#innovator#vw-group","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Volkswagen","description":"Volkswagen","dateCreated":"2022-04-25T19:07:02+0000","dateUpdated":"2022-09-15T00:48:45+0000"}]},{"item":{"id":"customer-references#tui-aws-is-how","locale":"en_US","directoryId":"customer-references","name":"tui-aws-is-how","dateCreated":"2024-09-18T20:04:22+0000","dateUpdated":"2024-09-18T20:08:08+0000","additionalFields":{"descriptionSummary":"In 2017 begann TUI auf Amazon Web Services (AWS) zu entwickeln, um seine Vertriebsplattform für die nördliche Region von On-Premise zur Cloud zu migrieren mithilfe von Amazon Elastic Compute Cloud (Amazon EC2), AWS Lambda, AWS Config und AWS KMS. Heute ist AWS ist der wichtigste Cloud-Anbieter für TUI. Das Unternehmen entschied sich aufgrund der Größenvorteile, der ausgereiften Produkte und des Supports für AWS. Die Migration zur Cloud half TUI dabei, Updates schneller für die Benutzer bereitzustellen und zugleich die Zeit für die Einführung neuer Funktionen auf der Plattform zu verkürzen, global zu skalieren und den-Teams dabei zu helfen, zu experimentieren und Innovationen zu beschleunigen.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/TUI_Customer-Reference_Logo%401x.ca041124ff6784cabbc736869e74ba723fbc6964.png","displayLocation":"Deutschland","customerNameLower":"tui","industry":"Reise","sortDate":"2023-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/tui-aws-is-how?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2023","contentType":"Kundengeschichte","customer-name":"TUI","headline":"TUI Group migriert mithilfe von AWS zu einer skalierbaren Cloud-Plattform