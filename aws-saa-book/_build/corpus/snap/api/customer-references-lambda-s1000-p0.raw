"dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#ec2-auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Auto Scaling","description":"Amazon EC2 Auto Scaling","dateCreated":"2020-03-02T07:02:53+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"}]},{"item":{"id":"customer-references#bmw-data-protection","locale":"en_US","directoryId":"customer-references","name":"bmw-data-protection","dateCreated":"2024-09-18T20:04:25+0000","dateUpdated":"2024-09-18T20:08:08+0000","additionalFields":{"descriptionSummary":"Die BMW Group und AWS (Amazon Web Services) gaben heute eine strategische Zusammenarbeit bekannt, bei der die Unternehmen gemeinsam innovative Cloud-Technologien entwickeln werden, um das Datenpotenzial künftiger Fahrzeuggenerationen optimal zu nutzen. Die beiden Unternehmen arbeiten auch zusammen, um kommerzielle Standard-Cloud-Lösungen für die sichere Verwaltung von Fahrzeugdaten zu entwickeln. Die Zusammenarbeit ist eine Fortsetzung der 2015 begonnenen Zusammenarbeit der beiden Unternehmen im Bereich vernetzter Fahrzeuge. Wie bei allen bisherigen Kooperationen behält die BMW Group die volle und ausschließliche Kontrolle über die Daten und hält sich an die in den jeweiligen Märkten geltenden Datenschutzbestimmungen.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/BMWGroup_logo_200x70_1X.3445718b3f949f158f9e3cac77d3ee79d4767a7f.jpg","displayLocation":"Deutschland","customerNameLower":"bmw group","industry":"Automobilbranche","sortDa