-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#batch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Batch","description":"AWS Batch","dateCreated":"2020-03-02T07:01:42+0000","dateUpdated":"2022-02-03T03:32:19+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"customer-references#big-rocks#aws-for-data","locale":"en_US","tagNamespaceId":"customer-references#big-rocks","name":"AWS for Data","description":"AWS for Data","dateCreated":"2024-02-14T22:32:15+0000","dateUpdated":"2024-03-05T01:11:26+0000"},{"id":"customer-references#category#hcls","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Healthcare \u0026 Life Sciences","description":"Healthcare \u0026 Life Sciences","dateCreated":"2019-07-22T18:31:58+0000","dateUpdated":"2022-05-14T20:13:37+0000"}]},{"item":{"id":"customer-references#forage","locale":"en_US","directoryId":"customer-references","name":"forage","dateCreated":"2021-04-02T21:36:52+0000","dateUpdated