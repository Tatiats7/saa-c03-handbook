d":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"}]},{"item":{"id":"customer-references#one-biosciences-variation1","locale":"en_US","directoryId":"customer-references","name":"one-biosciences-variation1","dateCreated":"2024-08-10T00:06:41+0000","dateUpdated":"2024-08-10T00:32:51+0000","additionalFields":{"descriptionSummary":"Dans le paysage dynamique de la biotechnologie où se dessine le futur de la recherche médicale, One Biosciences se distingue en poussant le séquençage à un niveau jamais exploité jusqu’alors. L’entreprise a en effet mis au point un protocole capable d’analyser les cellules à l’échelle individuelle et la façon dont elles communiquent entre elles. Un travail d’une précision unique, qui permet d’entrevoir de nouveaux traitements contre le cancer, mais qui génère par ailleurs des volumes de données considérables. C’est la raison pour laquelle One Biosciences a choisi de s’appuyer sur les solutions d\u0027Amazon Web Services (AWS) pour accélérer ses recherches.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/one-biosciences-logo%401x.acc115d57f98298fb90d00a848c93c79fa385a19.png","displayLocation":"France","customerNameLower":"one biosciences","footerInfoText":"Published Date","industry":"Heal