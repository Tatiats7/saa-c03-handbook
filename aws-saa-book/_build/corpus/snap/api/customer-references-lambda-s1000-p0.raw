cial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#anz","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia \u0026 New Zealand","description":"Australia \u0026 New Zealand","dateCreated":"2020-04-09T00:26:11+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#product#elb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Elastic Load Balancing (ELB)","description":"Elastic Load Balancing (ELB)","dateCreated":"2020-03-02T07:03:09+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#workspaces","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon WorkSpaces","description":"Amazon WorkSpaces","dateCreated":"2020-03-02T07:06:12+0000","dateUpdated":"2022-02-03T03:33:08+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#marsmission12012021lkmapsreoenjaf","locale":"en_US","directoryId":"customer-references","name":"marsmission12012021lkmapsreoenjaf","dateCreated":"2022-05-23T21:42:22+0000","dateUpdated":"2022-05-23T21:52:54+0000","additionalFields":{"descriptionSummary":"The Emirates Mars Mission made history as the first Arabic nation to reach Mars in an unprecedented short amount of time. The Hope Probe will now spend two years gathering data from the red planet’s atmosphere, all of which will be ingested into the AWS cloud. Join builder Adrian De Luca on this special episode of This is My Architecture as he learns about the international collaboration between the UAE\u0027s Mohammed Bin Rashid Space Centre and the University of Colorado’s Laboratory for Atmospheric and Space Physics. We explore how the probe\u0027s imaging instruments were built, the challenges of sending signals in space and processing vast amounts of data. We dive deep into the event-driven solutions architecture to understand how they collect images and telemetry data with Amazon S3, AWS Lambda and Amazon Simple Queue Service (SQS). We also learn how they process it all with using serverless services like AWS Step Functions and AWS Batch, and distribute it to the scientific community through a secure web application built using Amazon Cloudfront, Amazon Cognito and Amazon API Gateway.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/mohammed-bin-rashid-space-center-logo%401x.381f3c68f8de7fd61b629246c410cc85d1de755b.png","displayLocation":"Europe, Middle East, \u0026 Africa","footerInfoText":"Published Date","industry":"Telecommunications","sortDate":"2021-12-01","headlineUrl":"https://youtu.be/PrX-JNQTxac?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Emirates Mars Mission: Hope Probe","customer-name":"Mohammed Bin Rashid Space Centre"}},"tags":[{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#uae","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United Arab Emirates","description":"United Arab Emirates","dateCreated":"2020-02-03T05:30:23+0000","dateUpdated":"2022-02-03T03:31:56+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdate