42:31+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#product#pinpoint","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Pinpoint","description":"Amazon Pinpoint","dateCreated":"2020-03-02T07:04:51+0000","dateUpdated":"2022-02-03T03:32:54+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#hbomax01122022oiuhsrefuobnh","locale":"en_US","directoryId":"customer-references","name":"hbomax01122022oiuhsrefuobnh","dateCreated":"2022-05-23T21:41:45+0000","dateUpdated":"2022-05-23T21:52:39+0000","additionalFields":{"descriptionSummary":"The HBO Max security team operates on a “guardrails, not fences” policy. Rather than preventing HBO developers from building, HBO Max built a detection \u0026 remediation workflow to evaluate and modify resources that are configured improperly from a security perspective. Using a combination of AWS monitoring services, Lambda functions, and Cloud Custodian, this automated system ensures resources deployed in HBO Max AWS environments follow HBO’s security best practices.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/hbo-max-logo%401x.c5d769e926896524cd4518edc32a636e162263f6.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2022-01-12","headlineUrl":"https://youtu.be/uOSpWdAyrZo?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"HBO Max: Automating Remediation of AWS Resource Misconfigurations","customer-name":"HBO Inc."}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#config","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Config","description":"AWS Config","dateCreated":"2020-03-02T07:02:20+0000","dateUpdated":"2022-02-03T03:32:26+0000"},