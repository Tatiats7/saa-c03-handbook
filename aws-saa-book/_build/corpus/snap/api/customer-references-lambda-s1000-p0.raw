"name":"AWS Data Pipeline","description":"AWS Data Pipeline","dateCreated":"2020-03-02T07:02:32+0000","dateUpdated":"2022-02-03T03:32:28+0000"},{"id":"GLOBAL#location#iberia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Iberia","description":"Iberia","dateCreated":"2020-04-09T03:37:04+0000","dateUpdated":"2022-02-03T03:31:49+0000"},{"id":"GLOBAL#location#spain","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Spain","description":"Spain","dateCreated":"2020-02-03T05:30:16+0000","dateUpdated":"2022-02-03T03:31:49+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"GLOBAL#industry#energy","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Energy","description":"Energy","dateCreated":"2020-07-15T21:58:51+0000","dateUpdated":"2022-02-03T03:32:02+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"}]},{"item":{"id":"customer-references#compagnie-des-alpes","locale":"en_US","directoryId":"customer-references","name":"compagnie-des-alpes","dateCreated":"2024-04-16T00:04:07+0000","dateUpdated":"2024-04-16T00:06:38+0000","additionalFields":{"descriptionSummary":"Le Groupe Compagnie des Alpes (CDA) est le leader européen des loisirs. Il gère les plus grands domaines skiables des Alpes françaises et des parcs de loisirs en Europe. Leur défi N°1 est d\u0027améliorer l\u0027expérience client en développement des solutions innovantes tels que le cashless et la meilleure gestion possible des files d\u0027attente. Emmanuel Viennot, Directeur des Systèmes d\u0027Information et du Digital, explique qu\u0027il a choisi les solutions serverless d’AWS pour ne plus avoir à se soucier de la partie infrastructure. Grâce à ces technologies, les services de La Compagnie des Alpes se dimensionnent automatiquement lors des pics d’affluence dans leurs parcs ou stations de ski. Un exemple concret : la station Serre Chevalier a accueilli 27 000 skieurs au cours d’une même journée. AWS a facilité et simplifié l\u0027identification de la vente en ligne et des contrôles d\u0027accès grâce à la solution proposée.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/compagnie-des-alpes-logo%401x.d6f28f93d6e8a0a9b33ca1c61d50af90573f0d46.png","displayLocation":"France","customerNameLower":"compagnie des alpes","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2023-09-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/compagnie-des-alpes/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Compagnie des Alpes","publishedDate":"2023","enableShare":"1","headline":"Compagnie des Alpes offre une expérience client toujours plus innovante avec AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description