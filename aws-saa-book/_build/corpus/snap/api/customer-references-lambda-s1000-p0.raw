#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#elb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Elastic Load Balancing (ELB)","description":"Elastic Load Balancing (ELB)","dateCreated":"2020-03-02T07:03:09+0000","dateUpdated":"2022-02-03T03:32:34+0000"}]},{"item":{"id":"customer-references#hema-case-study","locale":"en_US","directoryId":"customer-references","name":"hema-case-study","dateCreated":"2024-06-12T18:24:08+0000","dateUpdated":"2024-06-13T17:19:18+0000","additionalFields":{"descriptionSummary":"For nearly 100 years, European retailer HEMA has been selling household products that make everyday life easier. To bring its traditional ways of working into the digital age, it built its first ecommerce system on Amazon Web Services (AWS) in 2018. According to Alexander Oppel, head of technology at HEMA, having access to tools in the AWS Cloud gives its 250 developers the freedom to innovate and build software fast. HEMA uses AWS across its business—which spans 5 countries and employs 19,000 staff—powering everything from its online cake-customization feature to the analysis of data in different departments to drive insight.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/hema%401x.6e4f58fc5db17b31d86536afef8e888cba8358be.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/hema%401x.6e4f58fc5db17b31d86536afef8e888cba8358be.png","displayLocation":"Europe","customerNameLower":"hema","footerInfoText":"Published Date","industry":"Retail","headlineUrl":"https://aws.amazon.com/solutions/case-studies/hema-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Hema","enableShare":"1","publishedDate":"2023","headline":"HEMA Drives Innovation, Delights Customers with Ecommerce Powered by AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"20