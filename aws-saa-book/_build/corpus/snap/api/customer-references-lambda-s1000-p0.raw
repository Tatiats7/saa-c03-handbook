me":"accor-innovator","dateCreated":"2024-06-28T07:22:45+0000","dateUpdated":"2024-08-07T18:41:50+0000","additionalFields":{"descriptionSummary":"Accor hotels group strives to go above and beyond its customers’ expectations and provide each of them with inspiring and personalized experiences. To achieve this, the hotels group is supported by Amazon Web Services (AWS) technologies and uses scalable cloud solutions, along with smart Internet of Things devices which run on Artificial Intelligence (AI). Accor hosts millions of traveling customers in 5,200 hotels in 110 countries around the world, with the capacity to open one hew hotel every day.","featureImageURL":"https://d1.awsstatic.com/accor_innovator.e42013ce8b1a31327a12eb01c9ca7bb514926e7c.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/accor%20logo%401x.f54daa83d222f1b02f62b4d673ff1107bb2af35b.png","displayLocation":"France","customerNameLower":"accor","footerInfoText":"Published Date","description":"\u003cp\u003eImproving personalized hotel experiences and strengthening customer loyalty.\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u0026nbsp;\u003c/p\u003e\n","industry":"Hospitality","sortDate":"2024-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/innovators/accor/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Accor","publishedDate":"2024","enableShare":"1","headline":"Accor on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-categ