OBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"}]},{"item":{"id":"customer-references#snapshot-blackboard-lambda","locale":"en_US","directoryId":"customer-references","name":"snapshot-blackboard-lambda","dateCreated":"2024-08-15T21:35:13+0000","dateUpdated":"2024-08-15T21:43:38+0000","additionalFields":{"descriptionSummary":"Across the world, in thousands of classrooms, Blackboard (now part of Anthology) educational technology enables instruction, collaboration, and online learning. In 2015, the company started to migrate the software-as-a-service (SaaS) version of its Blackboard Learn application to the Amazon Web Services (AWS) Cloud. Since then, the company has been aggressively adopting AWS technologies to further its innovation agenda.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Blackboard_Customer-Reference_Logo.5843214d78364555b7a920bd7e563e05075333a3.png","displayLocation":"United States","customerNameLower":"blackboard inc.","footerInfoText":"Published Date","industry":"Education","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/snapshot-blackboard-lambda/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Blackboard Inc.","publishedDate":"2019","enableShare":"1","headline":"Blackboard (Now Part of Anthology) Uses AWS Lambda to Speed Experience Testing from Days to Seconds","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North