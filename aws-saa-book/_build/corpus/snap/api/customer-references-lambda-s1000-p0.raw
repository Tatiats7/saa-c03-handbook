overnance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-vidroll","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-vidroll","dateCreated":"2019-07-22T19:49:55+0000","dateUpdated":"2021-12-22T19:46:14+0000","additionalFields":{"featured":"0","descriptionSummary":"VidRoll is a video technology and monetization platform for content publishers. VidRoll uses AWS Lambda to power the business logic for real-time ad bidding.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/vidroll-logo.e7c3dd7297ebd3f9bf0e346d64dda8ffde60dde5.jpg","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eVidRoll is a video technology and monetization platform for content publishers. VidRoll uses AWS Lambda to power the business logic for real-time ad bidding. Using Lambda, VidRoll developers can focus on product innovations, and the company can grow revenue ten times over without needing to hire additional technical resources.\u003c/p\u003e\r\n","industry":"Digital Marketing","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/vidroll/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"VidRoll","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: VidRoll"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"