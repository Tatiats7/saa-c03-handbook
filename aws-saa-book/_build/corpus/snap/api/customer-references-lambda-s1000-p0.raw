5:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#vietnam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Vietnam","description":"Vietnam","dateCreated":"2020-02-03T05:29:42+0000","dateUpdated":"2022-02-03T03:31:37+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#agriculture","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Agriculture","description":"Agriculture","dateCreated":"2020-06-25T04:02:53+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"customer-references#big-rocks#aws-for-data","locale":"en_US","tagNamespaceId":"customer-references#big-rocks","name":"AWS for Data","description":"\u003cp\u003eAWS for Data is a marketing \u0026ldquo;Big Rock\u0026rdquo; initiative that tells the story around how AWS can provide the most comprehensive set of data capabilities spanning databases, analytics, business intelligence, and machine learning for an end-to-end data strategy.\u003c/p\u003e\n","dateCreated":"2024-02-14T22:32:15+0000","dateUpdated":"2024-02-14T22:32:15+0000"}]},{"item":{"id":"customer-references#velliv-case-study","locale":"en_US","directoryId":"customer-references","name":"velliv-case-study-de","dateCreated":"2022-05-14T20:14:10+0000","dateUpdated":"2024-09-20T20:36:23+0000","additionalFields":{"descriptionSummary":"Velliv ist in der stark regulierten Finanzdienstleistungsbranche tätig und mit mehr als 360 000 Kunden eines der größten dänischen Rentenversicherungsunternehmen. Als sich Velliv 2018 von seiner Muttergesellschaft Nordea trennte, bot sich die Chance, eine völlig neue, unabhängige IT-Infrastruktur aufzubauen. \nVelliv entschied sich für AWS, weil das Unternehmen über die nötige Reife verfügte, um die benötigte Cloud-Umgebung bereitzustellen. „Durch die Arbeit mit AWS sind wir ein bisschen klüger geworden“, meint Martin Eggert, Anwendungsarchitekt bei Velliv. „Als ich hörte, dass unsere große monolithische Anwendung auf AWS umgestellt werden würde, rechnete ich mit einer Herausforderung. Die Unternehmensarchitekten von Velliv haben jedoch mit Unterstützung unseres AWS-Partners Cognizant gezeigt, dass die Migration zu AWS machbar ist. Wir haben die Migration in nur 1 Jahr abgeschlossen. Es ist ein großer Erfolg, dass wir es in dieser kurzen Zeit geschafft haben.“","featureImageURL":"https://d1.awsstatic.com/emea-customer-references/emea-directory-customer-logos/Velliv-Customer-References-Logo%401x.52535df6f20a3c441e5d9a55447f591a4bd230c3.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/emea-customer-references/emea-directory-customer-logos/Velliv-Customer-References-Logo%401x.52535df6f20a3c441e5d9a55447f591a4bd230c3.png","displayLocation":"Dänemark","customerNameLower":"velliv, pension \u0026 livsforsikring a/s","industry":"Finanzdienstleistungen","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/velliv-case-study/?nc1\u003dh_ls\u0026did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Velliv, Pension \u0026 Livsforsikring A/S","enableShare":"1","publishedDate":"2022","contentType":"Kundengeschichte","headline":"Velliv schließt sichere, konforme Migration mit AWS ab"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#location#denmark","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Denmark","description":"Denmark","dateCreated":"2020-02-03T05:30:06+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amaz