m 2.0","description":"Amazon AppStream 2.0","dateCreated":"2020-03-02T07:01:30+0000","dateUpdated":"2022-02-03T03:32:17+0000"},{"id":"GLOBAL#product#monitron","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Monitron","description":"Amazon Monitron","dateCreated":"2021-11-17T07:15:42+0000","dateUpdated":"2022-02-03T03:32:51+0000"},{"id":"GLOBAL#product#deep-learning-containers","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Deep Learning Containers","description":"AWS Deep Learning Containers","dateCreated":"2020-03-02T07:02:37+0000","dateUpdated":"2022-02-03T03:32:28+0000"},{"id":"GLOBAL#product#xray","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS X-Ray","description":"AWS X-Ray","dateCreated":"2020-03-03T00:18:27+0000","dateUpdated":"2022-02-03T03:33:08+0000"},{"id":"GLOBAL#product#migration-hub","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Migration Hub","description":"AWS Migration Hub","dateCreated":"2020-03-02T07:04:36+0000","dateUpdated":"2022-02-03T03:32:51+0000"},{"id":"GLOBAL#product#mgmt-console","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Management Console","description":"AWS Management Console","dateCreated":"2020-03-02T07:04:33+0000","dateUpdated":"2022-02-03T03:32:50+0000"},{"id":"GLOBAL#product#personalize","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Personalize","description":"Amazon Personalize","dateCreated":"2020-03-02T07:04:50+0000","dateUpdated":"2022-02-03T03:32:54+0000"},{"id":"GLOBAL#product#ivs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Interactive Video Service","description":"Amazon Interactive Video Service","dateCreated":"2020-11-20T00:43:24+0000","dateUpdated":"2022-02-03T03:32:44+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#hsat","locale":"en_US","directoryId":"customer-references","name":"hsat","dateCreated":"2022-11-09T00:25:07+0000","dateUpdated":"2024-03-02T02:48:48+0000","additionalFields":{"descriptionSummary":"Heimdal Satellite Technologies (HSAT) analyzes satellite and geospatial data to provide clients with valuable insights and predictions about crops and logistics as well as environmental, social, and corporate governance (ESG) on a national and global scale. The company cut compute costs by 70 percent and data processing time by 80 percent by moving its data processes to AWS. This supports its mission to process information at global scale at a fraction of the cost of its previous approach.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/HSAT-logo%401x.f85dfd04b3ef0f86066fa26bccf21ca91a25cf64.png","displayLocation":"Nordics","customerNameLower":"heimdal satellite technologies (hsat)","footerInfoText":"Published Date","industry":"Aerospace","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/hsat/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Heimdal Satellite Technologies (HSAT)","publishedDate":"2021","enableShare":"1","headline":"HSAT Cuts Satellite Data Processing Times by 80% Using AWS","contentType":"Customer Story"}},"tags":[{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#amplify","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Amplify","description":"AWS Amplify","dateCreated":"2020-03-02T07:01:21+0000","dateUpdated":"2022-02-03T03:32:15+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06: