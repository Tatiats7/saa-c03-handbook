rket","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#use-case#high-perform-compute","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"High Performance Compute","description":"High Performance Compute","dateCreated":"2020-06-05T06:37:26+0000","dateUpdated":"2022-02-03T03:35:41+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#askey-case-study","locale":"en_US","directoryId":"customer-references","name":"askey-case-study","dateCreated":"2019-07-19T15:10:57+0000","dateUpdated":"2021-12-22T19:11:00+0000","additionalFields":{"featured":"0","descriptionSummary":"By using AWS, Askey Computer Corporation is ensuring that the growing number of travelers using Taipei Main Station, a railway station and major transportation hub in Taiwan, can move around easily and safely. Askey builds cutting-edge IT solutions that can support smart projects in major cities worldwide.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Askey_Customer-Reference_Logo.a7aff7dd9bfdae8c835025c393796def494ce599.png","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003eBy using AWS, Askey Computer Corporation is ensuring that the growing number of travelers using Taipei Main Station, a railway station and major transportation hub in Taiwan, can move around easily and safely. Askey builds cutting-edge IT solutions that can support smart projects in major cities worldwide. The company runs the IT infrastructure supporting its Taipei Main Station smart project on the AWS Cloud, with Amazon EC2 instances for web applications and services. Askey uses Amazon Kinesis to collate data from thousands of smartphone apps, AWS Lambda to process that data, and Amazon DynamoDB to store it.\u003c/p\u003e\r\n","industry":"Transport \u0026 Logistics","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/askey/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Askey","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Askey Case Study"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#location#taiwan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Taiwan","description":"Taiwan","dateCreated":"2020-02-03T05:29:38+0000","dateUpdated":"