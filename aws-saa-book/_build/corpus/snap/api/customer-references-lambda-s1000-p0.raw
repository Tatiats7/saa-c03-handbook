escription":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#industry#cpg","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Consumer Packaged Goods (CPG)","description":"Consumer Packaged Goods (CPG)","dateCreated":"2020-06-25T04:03:18+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#homepage-industry#cpg","locale":"en_US","tagNamespaceId":"customer-references#homepage-industry","name":"Consumer Packaged Goods (CPG)","description":"Consumer Packaged Goods (CPG)","dateCreated":"2022-08-24T22:33:23+0000","dateUpdated":"2022-08-24T22:33:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#innovator#amazon","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Amazon","description":"Amazon","dateCreated":"2022-04-25T19:05:23+0000","dateUpdated":"2022-06-27T20:43:38+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"}]},{"item":{"id":"customer-references#volkswagen-innovator-de","locale":"en_US","directoryId":"customer-references","name":"volkswagen-innovator-de","dateCreated":"2024-09-18T20:03:42+0000","dateUpdated":"2024-09-18T20:08:09+0000","additionalFields":{"descriptionSummary":"Als Innovator in der Automobilindustrie seit mehr als 80 Jahren ist die Volkswagen Gruppe Europas größter Automobilhersteller und produziert jährlich 11 Millionen Autos. Um seine Automobilfertigungs- und Logistikprozesse zu transformieren, hat der Konzern die Volkswagen Industrial Cloud auf Amazon Web Services (AWS) aufgebaut, die AWS-Internet-of-Things-Services (IoT) nutzt, um Daten von allen Maschinen, Anlagen und Systemen in mehr als 120 Fabriken zu verbinden. Die Volkswagen Industrial Cloud soll eine Produktivitätssteigerung von 30 Prozent, eine Senkung der Fabrikkosten um 30 Prozent und eine Einsparung von 1 Milliarde Euro in den Kosten der Lieferkette ermöglichen. Die Gruppe nutzt AWS auch, um über die Fertigung hinaus in Mitfahrservices, vernetzte Fahrzeuge und immersive, virtuelle Autokauferlebnisse zu expandieren und so die Zukunft der Mobilität zu gestalten.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/volkswagen-group-logo@1x.b28acee85fe276a4231c3680afe59f7a1107bcd3.png","displayLocation":"Nordamerika","customerNameLower":"volkswagen","industry":"Automobilbranche","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/volkswagen-group/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"Kundengeschichte","customer-name":"Volkswagen","headline":"Die Volkswagen Gruppe in AWS"}},"tags":[{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#language#german","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"German","description":"German","dateCreated":"2020-03-03T06:40:46+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"GLOBAL#industry#automotive","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Automotive","description":"Automotive","dateCreated":"2020-01-16T17:42:11+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","t