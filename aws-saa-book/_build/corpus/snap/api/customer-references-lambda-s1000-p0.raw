y","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#iot","locale":"en_US","tagNamespaceId":"customer-references#category","name":"IoT","description":"IoT","dateCreated":"2019-07-22T18:32:05+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"IoT","description":"IoT","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2022-02-03T03:35:28+0000"}]},{"item":{"id":"customer-references#pagseguro","locale":"en_US","directoryId":"customer-references","name":"pagseguro","dateCreated":"2023-06-01T23:08:01+0000","dateUpdated":"2023-06-08T04:07:43+0000","additionalFields":{"descriptionSummary":"Em operação desde 2006, o PagSeguro é a empresa líder no mercado brasileiro de pagamentos online, oferecendo soluções de pagamento para lojas físicas e comércio eletrônico. Em 2019, criou o PagBank, banco digital que conta hoje com mais de 9 milhões de clientes e 1,4 milhão de usuários ativos. Para entregar as obrigatoriedades do projeto OpenBanking, do Banco Central do Brasil, a instituição teve de desenvolver uma nova arquitetura, desenvolvida utilizando serviços AWS.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/pagseguro-logo%402x.c8107f15566d995c578f973d246a233d0f3e5d3c.png","displayLocation":"Brasil","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2021-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/pagseguro/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"História do cliente","customer-name":"Pagseguro Internet S.A.","headline":"AWS apoia PagSeguro PagBank na adequação ao OpenBanking"}},"tags":[{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description"