tomer-references#category","name":"Business Applications: EC2 Windows Server","description":"Business Applications: EC2 Windows Server","dateCreated":"2019-07-22T18:31:09+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#product#organizations","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Organizations","description":"AWS Organizations","dateCreated":"2020-03-02T07:04:43+0000","dateUpdated":"2022-02-03T03:32:53+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"}]},{"item":{"id":"customer-references#arezzo-co","locale":"en_US","directoryId":"customer-references","name":"arezzo-co","dateCreated":"2023-06-01T23:05:21+0000","dateUpdated":"2023-06-08T04:07:47+0000","additionalFields":{"descriptionSummary":"A Arezzo\u0026Co. transformou o relacionamento com os seus mais de 10 milhões de clientes, especialmente como resultado das demandas trazidas com a pandemia. Murilo Jovtei, head de Negócios digitais da Arezzo\u0026Co, conta como a empresa integrou produtos de suas três verticais no app ZZ Mall. E, mais importante, como utilizou serviços AWS para promover essa integração, permitindo que 4.500 vendedores utilizem a solução para fazer mais de 2 milhões de ativações todos os meses, gerando uma receita influenciada de R$ 50 milhões/mês, cifra que representa um rescimento de 70% para a companhia.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/arezzo_logo%401x.af9b1004fce14e4588bc3ade6e59fc400e90e2e1.png","displayLocation":"Brasil","customerNameLower":"arezzo\u0026co","footerInfoText":"Data de publicação","industry":"Manufatura","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/arezzo-co/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Arezzo\u0026Co","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"Arezzo\u0026Co. inova em relacionamento com mais de 10 milhões de clientes"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#sagemaker-ground-truth","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker Ground Truth","description":"Amazon SageMaker Ground Truth","dateCreated":"2020-03-02T07:05:12+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#growy-case-study1","locale":"en_US","directoryId":"customer-references","name":"growy-case-study1","dateCreated":"2023-05-11T00:14:51+0000","dateUpdated":"2023-07-12T01:35:24+0000","additionalFields":{"descriptionSummary":"Growy is a Netherlands-based startup that builds fully automated, circular vertical farms where robots tend to plants instead of humans. Using AWS IoT Events, the company can manage its costs effectively and compete in the low-margin farming business. AWS also provides a reliable and flexible infrastructure to support innovative agricultural methods. Growy uses AWS to replicate this automated approach and quickly launch new farms around the world, which it can control from its Amsterdam headquarters.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/growy-logo%401x.a713981d9f4b11dcc153fe4fdd36587c1baa9544.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"growy","footerInfoText":"Published Date","industry":"Agriculture","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/growy-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Growy","publishedDate":"2022","enableShare":"1","headline":"Growy Builds Circular and Autonomous Vertical Farms with Automated Robotics on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en