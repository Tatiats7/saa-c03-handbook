udy","dateCreated":"2021-09-11T00:49:23+0000","dateUpdated":"2022-12-14T00:59:45+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eBy migrating to AWS from another cloud provider, Arista Group gained costing transparency with responsive support services. Arista Group is a leading automotive dealer and chain of supply and repair shops operating across Indonesia. The company uses a range of Amazon EC2 instances right-sized to each workload, AWS Lambda for backups, and Amazon GuardDuty for intelligent threat protection.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Arista_logo%401x.5d9ed44291bd26b736ed71665fc9ea2328fbdf77.png","displayLocation":"Indonesia","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2021-09-10","headlineUrl":"https://aws.amazon.com/solutions/case-studies/arista-group-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Arista Group","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Arista Group Migrates to AWS To Lower IT Costs"}},"tags":[{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"