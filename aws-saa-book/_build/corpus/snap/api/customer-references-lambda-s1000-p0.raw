stry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#capital-one","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Capital One","description":"Capital One","dateCreated":"2022-04-25T19:05:47+0000","dateUpdated":"2022-07-16T00:04:47+0000"},{"id":"GLOBAL#series#aws-reinvent","locale":"en_US","tagNamespaceId":"GLOBAL#series","name":"AWS re:Invent","description":"AWS re:Invent","dateCreated":"2021-06-04T06:36:32+0000","dateUpdated":"2022-02-03T03:33:29+0000"}]},{"item":{"id":"customer-references#itau-contas","locale":"en_US","directoryId":"customer-references","name":"itau-contas","dateCreated":"2023-06-01T23:06:19+0000","dateUpdated":"2023-08-11T00:24:48+0000","additionalFields":{"descriptionSummary":"Ao adotar a estratégia de modernização e migração de aplicações críticas para a nuvem, a área de Engenharia de Cloud do Itaú Unibanco estabeleceu como objetivo prover Cloud AWS como autosserviço para as áreas de Engenharia consumidoras da plataforma. Utilizando a abordagem de micro segmentação de contas, um dos desafios envolvidos era a automação do processo de criação de contas. No início esse processo levava em média 60 horas e, com o apoio da AWS, a instituição financeira conseguiu automatizar 100% do processo de criação de contas, reduzindo seu prazo para 1h20.","featureImageURL":"https://d1.awsstatic.com/industry-images-customer-references/bancolombia-industry-image.1856e5563e1c47a4c8b7ad9fd5337c771e92a7a4.jpg","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/itau-logo%402x.cc96e60df104954c8960737a54830d300847fb5a.png","displayLocation":"Brasil","customerNameLower":"itaú","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/itau-contas/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Itaú","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"Banco Itaú automatiza processo e reduz tempo de criação de contas AWS em mais de 4.000%"}},"tags":[{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#innovator#itau","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"itau","description":"\u003cp\u003eInnovator introduced in 2023.\u003c/p\u003e\n","dateCreated":"2023-08-10T19:03:48+0000","dateUpdated":"2023-08-10T19:03:48+0000"}]},{"item":{"id":"customer-references#arcos-dorados-from-es-directory","locale":"en_US","directoryId":"customer-references","name":"arcos-dorados-from-es-directory","dateCreated":"2024-02-03T03:45:56+0000","dateUpdated":"2024-02-06T01:35:39+0000","additionalFields":{"descriptionSummary":"A Arcos Dorados é a maior franquia mundial da marca McDonald\u0027s, operando em 20 países ou territórios da América Latina. Há alguns anos, a empresa iniciou um processo de transformação digital com o desafio de oferecer aos clientes um atendimento mais conveniente e com um relacionamento cada vez mais personalizado. Neste vídeo, Magdalena González Victorica, Chief Technology Officer da Arcos Dorados, conta como a empresa utilizou as soluções e serviços profissionais da AWS e do parceiro Econocomdigital. A Arcos Dorados implantou a infraestrutura para ter as informações e poder se conectar com os clientes de forma muito mais próxima e humana, aumentando suas vendas e evoluindo como empresa do ponto de vista digital e de dados.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/arcos_dorados_logo%402x.ee2c34cb96a3b213a1c51d912a70698cd3e0818a.png","displayLocation":"Brasil","customerNameLower":"arcos dorados","footerInfoText":"Data de publicação","industry":"Hotelaria","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/arcos-dorados/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Arcos Dorados","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"Como a Arcos Dorados usa os serviços da AWS para evoluir do ponto de vista digital"}},"tags":[{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)",