#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"customer-references#big-rocks#aws-for-data","locale":"en_US","tagNamespaceId":"customer-references#big-rocks","name":"AWS for Data","description":"\u003cp\u003eAWS for Data is a marketing \u0026ldquo;Big Rock\u0026rdquo; initiative that tells the story around how AWS can provide the most comprehensive set of data capabilities spanning databases, analytics, business intelligence, and machine learning for an end-to-end data strategy.\u003c/p\u003e\n","dateCreated":"2024-02-14T22:32:15+0000","dateUpdated":"2024-02-14T22:32:15+0000"}]},{"item":{"id":"customer-references#sony-interactive-entertainment-reinvent19-case-study","locale":"en_US","directoryId":"customer-references","name":"sony-interactive-entertainment-reinvent19-case-study","dateCreated":"2022-09-01T00:15:57+0000","dateUpdated":"2023-07-19T03:04:50+0000","additionalFields":{"descriptionSummary":"SIE built itds EVE Fraud System as a big data platform to aggregate transactional activity of users, resulting in substantially increased approvals with no increase in declines or chargebacks from banks.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/sony-playstation-logo%401x.0960d0012cfb7f230e4c703786dec7201ae056f6.png","displayLocation":"United States","customerNameLower":"sony interactive entertainment","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2022-08-31","headlineUrl":"https://aws.amazon.com/solutions/case-studies/sony-interactive-entertainment-reinvent19-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Sony Interactive Entertainment","publishedDate":"2022","enableShare":"1","headline":"Sony Interactive Entertainment Enables Fraud Prevention for PlayStation Using Analytics on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#kinesis-data-firehose","locale":"en_US","