,{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"}]},{"item":{"id":"customer-references#tajonaso","locale":"en_US","directoryId":"customer-references","name":"tajonaso","dateCreated":"2023-06-01T23:05:37+0000","dateUpdated":"2023-07-14T23:32:39+0000","additionalFields":{"descriptionSummary":"Super Centro El Tajonaso es una importante cadena de supermercados, con más de 400 empleados en tres sucursales ubicadas en distintos puntos de Panamá Oeste y, más recientemente, en una red de restaurantes. En este video, Jorge Velásquez, administrador de sistemas del Tajonaso, nos cuenta que la compañía tuvo el reto de la implementación de un nuevo sistema financiero contable. El desafío era el costo inicial de infraestructura, por lo que AWS, con la flexibilidad que ofrece en temas de infraestructura fue clave para dar este paso.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/eltajonaso_logo%401x.bdb4e46559c19f79117e5ae46e0d08ceaa670fd2.png","displayLocation":"Panamá","customerNameLower":"el tajonaso","footerInfoText":"Fecha de publicación","industry":"Venta al por menor","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/tajonaso/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"El Tajonaso","enableShare":"1","publishedDate":"2020","contentType":"Historia del cliente","headline":"Caso de Éxito AWS: El Tajonaso"}},"tags":[{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#industry#retail","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Retail","description":"Retail","dateCreated":"2020-01-16T17:42:39+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#use-case#datacenter-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2020-08-18T05:17:48+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000"