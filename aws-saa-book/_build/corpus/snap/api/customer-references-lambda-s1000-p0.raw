hat meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"customer-references#big-rocks#aws-for-data","locale":"en_US","tagNamespaceId":"customer-references#big-rocks","name":"AWS for Data","description":"\u003cp\u003eAWS for Data is a marketing \u0026ldquo;Big Rock\u0026rdquo; initiative that tells the story around how AWS can provide the most comprehensive set of data capabilities spanning databases, analytics, business intelligence, and machine learning for an end-to-end data strategy.\u003c/p\u003e\n","dateCreated":"2024-02-14T22:32:15+0000","dateUpdated":"2024-02-14T22:32:15+0000"}]},{"item":{"id":"customer-references#fox-innovator","locale":"en_US","directoryId":"customer-references","name":"fox-innovator","dateCreated":"2022-05-03T00:28:56+0000","dateUpdated":"2024-08-07T18:41:49+0000","additionalFields":{"featured":"0","featureImageURL":"https://d1.awsstatic.com/aws-key-pages/homepage-key-pages/customer-stories-logo/Fox.b05d6c74c51a22bdb3cc3d34cc51bcead2755166.jpg","descriptionSummary":"\u003cp\u003eMillions of viewers engage with content from FOX through its\u0026nbsp;broadcast and OTT platforms. FOX leverages AWS\u0026nbsp;to pioneer the future of world-class live and on-demand content delivery.\u003c/p\u003e\n","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/fox-logo%401x.c53ed2aa45c6ef9479d33bb6963b1070455b252c.png","displayLocation":"United States","customerNameLower":"fox corporation","footerInfoText":"Published Date","description":"\u003cp\u003eMigrating about 8 PB of content from its on-premises storage to the cloud in only 6 weeks\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u0026nbsp;\u003c/p\u003e\n","industry":"Media \u0026 Entertainment","sortDate":"2022-01-01","headlineUrl":"ht