ted":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#central-america","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central America","description":"Central America","dateCreated":"2021-02-19T05:32:25+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#occmundial","locale":"en_US","directoryId":"customer-references","name":"occmundial","dateCreated":"2023-06-01T23:07:18+0000","dateUpdated":"2023-06-08T04:07:39+0000","additionalFields":{"descriptionSummary":"Online Career Center (OCC) es una empresa mexicana que actúa en la industria del empleo, ocupando la posición de bolsa de trabajo líder en México. Desde hace 22 años, OCC es una empresa en línea, de hecho, una de las primeras startups en línea del país. Cuenta con una cartera de 38 mil clientes que pagan por anunciar sus vacantes y así encontrar los mejores talentos. Por otro lado, OCC ayuda a millones de mexicanos a encontrar un mejor empleo. Desde hace años, la empresa viene evolucionando su cultura y prácticas de desarrollo, inteligencia artificial y operaciones. Para evolucionar en este sentido, OCC necesitaba cambiar los data centers on-premises y utilizar una infraestructura cloud-native. La empresa logró facilitar esta transformación cultural con los servicios y plataforma AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/occ_logo%401x.bb407adebccc14b37f572f384dd0be42c09bbba6.png","displayLocation":"México","footerInfoText":"Fecha de publicación","industry":"Servicios profesionales","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/occmundial/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"Historia del cliente","customer-name":"Online Career Center (OCC)","headline":"OCC utiliza AWS para apoyar la industria de empleos en México"}},"tags":[{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#transfer-family","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Transfer Family","description":"AWS Transfer Family","dateCreated":"2020-08-20T04:00:34+0000","dateUpdated":"2022-02-03T03:33:04+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000"