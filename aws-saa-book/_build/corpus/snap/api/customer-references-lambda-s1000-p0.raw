ted":"2023-02-14T23:52:34+0000","additionalFields":{"descriptionSummary":"Trustpilot director of engineering, Angela Timofte, shares how Trustpilot supports its mission to be the most recognized symbol of trust on the internet—between consumers and businesses—through the use of an event-driven architecture (EDA), powered by Amazon Web Services (AWS).","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/trustpilot-logo%401x.5badf63dd57f5fb5262e900230002f55537329c4.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"trustpilot","footerInfoText":"Published Date","industry":"Digital Marketing","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/trustpilot-2022-aws-reinvent-video/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Trustpilot","publishedDate":"2022","enableShare":"1","headline":"Trustpilot, Building on AWS, Scales to House 190M Reviews That Help Consumers and Businesses to Make Better Decisions","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notification Service (SNS)","dateCreated":"2020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#industry#digital-marketing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Digital Marketing","description":"Digital Marketing","dateCreated":"2020-01-16T17:42:16+0000","dateUpdated":"