ly wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#pureweb07122022lknsefkln","locale":"en_US","directoryId":"customer-references","name":"pureweb07122022lknsefkln","dateCreated":"2023-02-08T01:17:08+0000","dateUpdated":"2023-02-08T01:38:41+0000","additionalFields":{"descriptionSummary":"Learn how PureWeb intelligently routes streaming requests from any device, anywhere on the planet, with decisioning based on network latency, and system preference and load. PureWeb\u0027s architecture leverages both serverless and provisioned compute to deliver 3D streaming for limitless experiences.","displayLocation":"United States","customerNameLower":"pureweb","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2022-07-12","headlineUrl":"https://youtu.be/hrhBOOrR5v0?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2022","enableShare":"1","customer-name":"PureWeb","headline":"PureWeb: Building a Global 3D Streaming Platform For Limitless Experiences","contentType":"Customer Story"}},"tags":[{"id":"customer-references#category#media-services","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Media Services","description":"Media Services","dateCreated":"2019-07-22T18:32:09+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Fr