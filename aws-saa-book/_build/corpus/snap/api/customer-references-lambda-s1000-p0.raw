dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"}]},{"item":{"id":"customer-references#kushki","locale":"en_US","directoryId":"customer-references","name":"kushki","dateCreated":"2023-06-01T23:10:51+0000","dateUpdated":"2023-06-08T04:07:34+0000","additionalFields":{"descriptionSummary":"Kushki es una plataforma de pagos que está orientada a dar servicios a clientes altamente transaccionales. Cuando empezó sus operaciones, la empresa identificó la necesidad de desarrollar servicios que pudieran reemplazar los sistemas obsoletos con los cuales el mercado financiero trabajaba. Asimismo, tenía el desafío de encontrar una plataforma que le permitiera tener lo mejor en tecnología, pero también un amplio catálogo de productos que pudiera ser traducido en servicios eficientes a sus clientes. En este video, José Santacruz, CTO de Kushki, explica que la compañía eligió a AWS porque es la única que tiene el catálogo de componentes maduros y adecuados para la arquitectura serverless que utiliza.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/kushki-logo%402x.bd8d8dbcfaa577462514249d944f9e86b21c006a.png","displayLocation":"Colombia","footerInfoText":"Fecha de publicación","industry":"Software e Internet","sortDate":"2021-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/kushki/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"Historia del cliente","customer-name":"Kushki","headline":"Kushki se transforma en una empresa escalable con AWS"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+000