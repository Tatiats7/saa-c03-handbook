":"customer-references#volkswagen-vr-ar-de-it","locale":"en_US","directoryId":"customer-references","name":"volkswagen-vr-ar-de-it","dateCreated":"2024-11-12T00:53:32+0000","dateUpdated":"2024-11-12T01:13:42+0000","additionalFields":{"descriptionSummary":"La casa automobilistica di livello globale Volkswagen Group (Volkswagen) sta sviluppando applicazioni di realtà virtuale (VR) e realtà aumentata (AR) per risparmiare tempo, ridurre i costi e migliorare le prestazioni per casi d\u0027uso in tutto il ciclo di vita del prodotto, dalle revisioni dei progetti alle simulazioni di formazione, fino alla guida remota in fabbrica.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/volkswagen-group-logo@1x.b28acee85fe276a4231c3680afe59f7a1107bcd3.png","displayLocation":"Germany","customerNameLower":"volkswagen group","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2021-12-22","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/volkswagen-vr-ar/","customer-name":"Volkswagen Group","enableShare":"1","publishedDate":"2021","contentType":"Storia del cliente","headline":"Volkswagen Group accelera la preparazione dei dati 3D e il rendering remoto per la realtà virtuale su AWS"}},"tags":[{"id":"GLOBAL#location#dach","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"DACH","description":"DACH","dateCreated":"2020-02-03T05:29:52+0000","dateUpdated":"2022-02-03T03:31:47+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#ar-vr","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AR \u0026 VR","description":"AR \u0026 VR","dateCreated":"2019-07-22T18:30:57+0000","dateUpdated":"2022-06-27T20:43:36+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","nam