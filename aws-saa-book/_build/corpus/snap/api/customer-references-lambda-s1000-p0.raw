to analyze all the traffic and proactively identify new threats.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/vietjet-aviation-air-logo%401x.7cbe857e3f9252d54c291b020175df052b3379f4.png","displayLocation":"Asia Pacific","footerInfoText":"Published Date","industry":"Transport \u0026 Logistics","sortDate":"2020-03-27","headlineUrl":"https://youtu.be/KQ6Fg206O9U?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"VietJet: Proactively Defending Your Systems from Bad Bots","customer-name":"VietJet Aviation JSC"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#vietnam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Vietnam","description":"Vietnam","dateCreated":"2020-02-03T05:29:42+0000","dateUpdated":"2022-02-03T03:31:37+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceI