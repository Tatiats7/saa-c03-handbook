om two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#flynn","locale":"en_US","directoryId":"customer-references","name":"flynn","dateCreated":"2020-12-29T02:07:13+0000","dateUpdated":"2021-12-22T23:18:13+0000","additionalFields":{"featured":"0","descriptionSummary":"Flynn migrated custom mobile and web applications to AWS to ensure scalability and workload balance, facilitate customer communications, and work more efficiently at job sites.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/flynn-logo%401x.004ec0132593b339c5528a67bd7bbaabe038f881.png","displayLocation":"Canada","footerInfoText":"Published Date","industry":"Construction \u0026 Real Estate","sortDate":"2020-12-28","headlineUrl":"https://aws.amazon.com/solutions/case-studies/flynn/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Flynn Group of Companies","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Flynn Uses AWS to Streamline Construction Operations and Communications"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech