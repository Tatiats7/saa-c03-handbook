 AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#scania-case-study","locale":"en_US","directoryId":"customer-references","name":"scania-case-study","dateCreated":"2023-02-16T18:37:58+0000","dateUpdated":"2025-05-17T00:14:46+0000","additionalFields":{"descriptionSummary":"By migrating its servers to AWS, transportation company Scania increased its load capacity, which was previously restrained by on-premises servers, in addition to increasing its flexibility and security.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Scania-logo-1x.c4a26af42ae361d799aca317a05f6744a5a84fde.png","displayLocation":"United States","customerNameLower":"scania","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/scania-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Scania","publishedDate":"2023","enableShare":"1","headline":"Scania Scales Its Connected-Vehicle Solution Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"20