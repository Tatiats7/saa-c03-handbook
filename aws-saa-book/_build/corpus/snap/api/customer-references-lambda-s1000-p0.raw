ity in a building can cost hundreds of thousands of dollars.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Ventacit_logo.1eaeb88695573a2bdaabd88ac01168b49d2412a0.png","displayLocation":"United States","customerNameLower":"ventacity","footerInfoText":"Published Date","industry":"Construction \u0026 Real Estate","sortDate":"2024-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ventacity-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ventacity","publishedDate":"2024","enableShare":"1","headline":"UBX Systems Delivers a Smart Building System That’s up to 20x More Cost Effective Using AWS IoT","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#iot-core","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS IoT Core","description":"AWS IoT Core","dateCreated":"2020-03-02T07:04:00+0000","dateUpdated":"2022-02-03T03:32:42+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#construction-real-estate","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Construction \u0026 Real Estate","description":"Construction \u0026 Real Estate","dateCreated":"2020-06-25T04:03:46+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Internet of Things (IoT)","description":"Internet of Things (IoT)","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2023-08-22T20:28:39+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","n