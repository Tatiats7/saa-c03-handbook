-study","dateCreated":"2023-03-03T22:13:15+0000","dateUpdated":"2024-08-13T14:59:19+0000","additionalFields":{"descriptionSummary":"TWAICE provides predictive analytics to help electric vehicle makers and renewable energy firms optimize their use of battery technology. To manage growth driven by rising consumer interest in reducing emissions, TWAICE developed a cloud-native platform built on AWS. The company improved the speed and accuracy of its data analytics by 300 percent, helping customers get the most out of their batteries, as well as cutting battery purchasing and maintenance costs by 20 percent. It also boosted IT team efficiency, reducing development time from several months to 2 weeks, and decreased deployment times from 3 days to a few hours. The time required to onboard customers was cut from weeks to hours and TWAICE was able to maintain the size of its DevOps team, reducing internal costs by 60 percent.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/twaice-logo%401x.8c8e60175c008b15a1c69d9155c2d7025695bb22.png","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/twaice-logo%401x.8c8e60175c008b15a1c69d9155c2d7025695bb22.png","displayLocation":"Germany","customerNameLower":"twaice technologies","footerInfoText":"Published Date","industry":"Electronics","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/twaice-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"TWAICE Technologies","publishedDate":"2022","enableShare":"1","headline":"TWAICE Improves Battery Life by 20%, Speeds Customer Onboarding Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#use-case#sustainability","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Sustainability","description":"Sustainability","dateCreated":"2021-07-02T05:53:58+0000","dateUpdated":"2022-02-03T03:35:58+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"customer-references#category#sustainability","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Sustainability","description":"Sustainability","dateCreated":"2022-01-18T21:36:39+0000","dateUpdated":"2022-05-09T21:31:10+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"