OBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#kaufmann","locale":"en_US","directoryId":"customer-references","name":"kaufmann","dateCreated":"2023-06-01T23:05:59+0000","dateUpdated":"2023-07-14T23:32:39+0000","additionalFields":{"descriptionSummary":"Con presencia en Chile, Perú, Costa Rica y Panamá, Grupo Kaufmann tiene más de 2.300 colaboradores. El grupo está en la industria de automóviles y vehículos comerciales, y su área de analítica avanzada tenía el desafío de poder desarrollar soluciones basadas en datos de forma ágil y escalable para llevar los mejores servicios a los clientes. Para lograrlo, eligieron al partner Arkho, que les ayudó a dar vida a su estrategia de datos. En este video, Pablo Ardiles, Chief Data Officer de Kaufmann, detalla como la compañía está utilizando servicios como Amazon S3, Amazon API Gateway, AWS Lambda, Amazon Athena y AWS Glue para desarrollar soluciones internas y externas que aumentaron sus ventas y la satisfacción de los clientes, generando revenue de forma incremental al negocio.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/kauffman%401x.83c26babf302cdf3a3aad2255c14455228151fc1.png","displayLocation":"México","customerNameLower":"kaufmann","footerInfoText":"Fecha de publicación","industry":"Automotriz","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/kaufmann/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Kaufmann","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"Grupo Kaufmann aumenta ventas y la satisfacción de clientes con estrategia de datos basada en AWS"}},"tags":[{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content