7:54:33+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eCom a oferta de solu\u0026ccedil;\u0026otilde;es de ITSM e ESM, a Desk Manager \u0026eacute; hoje uma das maiores empresas nacionais no desenvolvimento e oferta de plataformas de gerenciamento de servi\u0026ccedil;os corporativos. Para ampliar a efici\u0026ecirc;ncia e a agilidade no atendimento aos seus mais de 500 clientes, a companhia integrou em sua plataforma um agente de IA generativa baseado em servi\u0026ccedil;os AWS, implementada com a ajuda da AWS Partner CloudDog.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Desk%20Manager%20Logo%20200x70px.928d206e614ae54cdf722e4dc7086fd9b8114ee3.png","industry":"Software \u0026 Internet","sortDate":"2024-09-03","enableShare":"1","headlineUrl":"https://aws.amazon.com/pt/partners/success/desk-manager-clouddog/","publishedDate":"2024","contentType":"Case Study","headline":"CloudDog aprimora solução da Desk Manager com IA generativa AWS"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#bedrock","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Bedrock","description":"Amazon Bedrock","dateCreated":"2023-04-13T19:06:46+0000","dateUpdated":"2023-04-13T19:06:46+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"}]},{"item":{"id":"customer-references#friboi-darede-2024","locale":"en_US","directoryId":"customer-references","name":"friboi-darede-2024","dateCreated":"2025-01-22T00:17:24+0000","dateUpdated":"2025-03-06T17:54:22+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eParte do grupo JBS, a Friboi \u0026eacute; reconhecida por sua capacidade de inova\u0026ccedil;\u0026atilde;o e lideran\u0026ccedil;a no setor de carne bovina, com presen\u0026ccedil;a em mais de 150 pa\u0026iacute;ses. Com seu foco cada vez maior em sustentabilidade, a companhia contou com o suporte da AWS Partner, Darede, para o desenvolvimento de seu portal de OCR, que utiliza Machine Learning e IA generativa para reunir e analisar os documentos que comprovam o funcionamento de sua Cadeia de Fornecimento Sustent\u0026aacute;vel.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Friboi%20Logo%20200x70px.5def9f478525327a02112b546120052a3826ecaa.png","industry":"Manufacturing","sortDate":"2024-09-03","enableShare":"1","headlineUrl":"https://aws.amazon.com/pt/partners/success/friboi-darede/","publishedDate":"2024","contentType":"Case Study","headline":"Darede desenvolve o Portal OCR para a Friboi utilizando Machine Learning e IA generativa AWS"}},"tags":[{"id":"GLOBAL#product#bedrock","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Bedrock","description":"Amazon Bedrock","dateCreated":"2023-04-13T19:06:46+0000","dateUpdated":"2023-04-13T19:06:46+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#textract","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Textract","description":"Amazon Textract","dateCreated":"2020-03-02T07:05:47+0000","dateUpdated":"2022-02-03T03:33:04+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#brazil","locale":"