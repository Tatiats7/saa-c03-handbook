58:51+0000","dateUpdated":"2022-02-03T03:32:02+0000"}]},{"item":{"id":"customer-references#standard-chartered-cuts-risk-grid-costs-60-on-amazon-ec2-spot-instances","locale":"en_US","directoryId":"customer-references","name":"standard-chartered-cuts-risk-grid-costs-60-on-amazon-ec2-spot-instances","dateCreated":"2019-11-22T21:40:38+0000","dateUpdated":"2021-12-22T20:25:23+0000","additionalFields":{"featured":"0","descriptionSummary":"Standard Chartered reduced costs of its risk-analysis grid computing solution by more than 60% using Amazon EC2 Spot Instances and manages the grid with a solution based on AWS Lambda and Amazon RDS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Case%20Study%20Logos/StandardChartered_Logo_@2x.1eee2c437400fb02ccb3e0d464d081828b474809.png","displayLocation":"Asia Pacific","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/standard-chartered-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Standard Chartered","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Standard Chartered Cuts Risk Grid Costs 60% on Amazon EC2 Spot Instances"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-categor