-directory","dateCreated":"2024-02-03T03:47:43+0000","dateUpdated":"2024-02-06T01:35:37+0000","additionalFields":{"descriptionSummary":"Rackspace modernized its contact center using Amazon Connect, enabling it to easily optimize call flows without specialized engineering skills. Rackspace is one of the world\u0027s largest IT managed-services providers.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Rackspace_Customer-Reference_Logo.ec8ce3017504d07052ac6e99cbc0e90da1016b1e.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"Rackspace modernized its contact center using Amazon Connect, enabling it to easily optimize call flows without specialized engineering skills. Rackspace is one of the world�s largest IT managed services providers. The company uses Amazon Connect as its contact center, Amazon Kinesis and Amazon Redshift for data ingestion and warehousing, and Amazon CloudWatch to monitor call characteristics. ","industry":"Electronics","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/rackspace/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Rackspace","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Rackspace Case Study"}},"tags":[{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{