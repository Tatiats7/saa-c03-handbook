ed":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-cmp-ly","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-cmp-ly","dateCreated":"2019-07-22T19:53:28+0000","dateUpdated":"2023-07-14T23:32:45+0000","additionalFields":{"featured":"0","descriptionSummary":"CMP.LY offers a solution for social-media monitoring, measurement, insight, and compliance called CommandPost, which runs entirely on the AWS Cloud. CMP.LY uses AWS Lambda to process and record inbound traffic from a range of social-media platforms within milliseconds of arrival. Using AWS Lambda, CMP.LY has reduced its server maintenance needs and improved CommandPost\u0027s performance.","imageSrcUrl":"https://d1.awsstatic.com/diagrams/cmp.ly-logo.de360f69c483b1c3776e6639df1c49282b3a8509.JPG","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eCMP.LY offers a social media monitoring, measurement, insight, and compliance solution called CommandPost, which runs entirely on the AWS Cloud. CMP.LY uses AWS Lambda to process and record inbound traffic from a range of social media platforms within milliseconds of arrival. By using AWS Lambda, CMP.LY reduced its server maintenance needs and improved CommandPost?s performance.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/cmp-ly/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"CMP.LY","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: CMP.LY"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","descrip