rless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#checkout-case-study","locale":"en_US","directoryId":"customer-references","name":"checkout-case-study","dateCreated":"2019-07-19T14:55:55+0000","dateUpdated":"2021-12-22T19:18:31+0000","additionalFields":{"featured":"0","descriptionSummary":"Checkout Finland has set a benchmark for cloud excellence within its banking group by reducing payment times, making compliance easier, and improving uptime during peak sales periods using AWS. The company is part of Finland\u0027s largest bank, OP, and provides a range of merchant services for online retailers.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Checkout_Customer-Reference_Logo.96050da7d579b1fd147eb1b2daaf7d99b64c0dd1.png","displayLocation":"Finland","footerInfoText":"Published Date","description":"\u003cp\u003eCheckout Finland has set a benchmark for cloud excellence within its banking group by reducing payment times, making compliance easier, and improving uptime during peak sales periods. The company is part of Finland?s largest bank?OP?and provides a range of merchant services for online retailers. It uses services including AWS Lambda and AWS Fargate to run its infrastructure as code so developers can concentrate on building features that matter to customers instead of managing servers.\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/checkout/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Checkout","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Checkout Case Study"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GL