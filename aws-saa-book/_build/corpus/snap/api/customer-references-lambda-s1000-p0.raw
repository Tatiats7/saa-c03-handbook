ame":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#workload#microsoft","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"Microsoft","description":"Microsoft","dateCreated":"2021-01-06T00:09:49+0000","dateUpdated":"2022-02-03T03:36:04+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#styria-case-study","locale":"en_US","directoryId":"customer-references","name":"styria-case-study","dateCreated":"2020-07-10T17:27:31+0000","dateUpdated":"2023-07-14T23:32:49+0000","additionalFields":{"featured":"0","descriptionSummary":"Dominik Safaric, Head of Engineering and Infrastructure, Styria.AI, Croatian Media News and Marketplace Solution Provider on benefits of using AWS as a platform, and also on why and how serverless and AI/ML solutions are important for their business.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Styria_Customer-Reference_Logo.0e7980df4a8aaec39ed50b1a644618a6dbcf34b2.png","displayLocation":"Central \u0026 Eastern Europe","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/styria-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Styria.AI","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Dominik Safaric, Head of Infrastructure, Styria.AI on Benefits of Using AWS as a Platform"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#lo