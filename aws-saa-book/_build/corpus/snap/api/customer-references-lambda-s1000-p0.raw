OBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"}]},{"item":{"id":"customer-references#innovaccer-case-study","locale":"en_US","directoryId":"customer-references","name":"innovaccer-case-study","dateCreated":"2019-07-19T14:57:49+0000","dateUpdated":"2024-05-07T16:34:54+0000","additionalFields":{"featured":"0","descriptionSummary":"Innovaccer built a scalable, zero-latency data platform using AWS that is 81 percent more cost-effective than an on-premises equivalent. Innovaccer is a leading healthcare data platform company, empowering healthcare organizations in the United States with data-driven insights for faster clinical decision making and efficient care processes.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Innovaccer_Customer-Reference_Logo.5c4a4cc99bdad74c93e636528f40c38949bf53b5.png","displayLocation":"India","footerInfoText":"Published Date","description":"\u003cp\u003eInnovaccer Inc. is a leading healthcare data platform company that helps customers delivering more efficient and effective services through data analytics. Innovaccer\u0019s aim is to simplify complex data from all points of care, streamline the information, and help organizations realize strategic goals based on key insights and predictions from their data. Its products have been deployed across more than 500 locations with over 10,000 providers leveraging it at institutions, governmental organizations, and several corporate enterprises such as Mercy ACO, StratiFi Health, UniNet Healthcare Network, Catalyst Health Network, and Osler Health Network. Innovaccer is based in San Francisco with offices around the United States and Asia.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/innovaccer/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Innovaccer","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Innovaccer Case Study"}},"tags":[{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2023-07-15T01:16:11+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#business