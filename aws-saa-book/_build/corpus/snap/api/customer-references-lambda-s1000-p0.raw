cial intelligence (AI) solutions being built on large language models (LLMs) that are trained on English datasets, startup Faraday Lab created its own generative AI trained on French language datasets to improve accessibility and diversity.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Faraday%20Logo%401x.c768386ccd615424723952f85bbe82e29d755292.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"faraday lab","footerInfoText":"Published Date","industry":"Retail","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/faraday-lab-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Faraday Lab","publishedDate":"2023","enableShare":"1","headline":"Faraday Lab Deploys LLMs Designed for French Accessibility in Days Using Amazon SageMaker","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#retail","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Retail","description":"Retail","dateCreated":"2020-01-16T17:42:39+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"St