n_US","tagNamespaceId":"GLOBAL#use-case","name":"Data Lakes","description":"Data Lakes","dateCreated":"2020-06-05T06:37:09+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Internet of Things (IoT)","description":"Internet of Things (IoT)","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2023-08-22T20:28:39+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#category#devops","locale":"en_US","tagNamespaceId":"customer-references#category","name":"DevOps","description":"DevOps","dateCreated":"2019-07-22T18:31:49+0000","dateUpdated":"2022-03-05T03:54:11+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#use-case#datacenter-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2020-08-18T05:17:48+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#business-applications-ec2-windows-server","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: EC2 Windows Server","description":"Business Applications: EC2 Windows Server","dateCreated":"2019-07-22T18:31:09+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"}]},{"item":{"id":"customer-references#rappi-fin-ops-from-es-directory","locale":"en_US","directoryId":"customer-references","name":"rappi-fin-ops-from-es-directory","dateCreated":"2024-02-03T03:47:48+0000","dateUpdated":"2024-02-06T01:35:37+0000","additionalFields":{"descriptionSummary":"A pandemia colocou à prova a capacidade do Rappi de realizar entregas rapidamente, portanto, foi necessário inovar em infraestrutura. No entanto, a empresa precisava ter bases financeiras para justificar o uso de ferramentas tecnológicas, e isso só poderia ser alcançado pelo monitoramento em tempo real das necessidades e das potenciais soluções tecnológicas para medir a eficiência de custo. Dessa maneira, com a implementação do FinOps e dos serviços da AWS, com os quais já trabalhava há muitos anos, obtiveram uma otimização de 90% do investimento em infraestrutura. A empresa, que atualmente processa 25 milhões de pedidos por mês, adquiriu flexibilidade para executar mais de 10 mil instâncias spot do Amazon Elastic Compute Cloud (Amazon EC2) em horários de pico.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/rappi-logo%401x.e3f6d852f68b6a673150b380f45ac07e0a763a10.png","displayLocation":"Brasil","customerNameLower":"rappi","footerInfoText":"Data de publicação","industry":"Hotelaria","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/rappi-fin-ops/?