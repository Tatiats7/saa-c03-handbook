onfigurations to control costs. Ahamove is an on-demand logistics app connecting truck and van drivers with consumers requiring deliveries in Vietnam. The startup is using Amazon EKS to manage container clusters, Amazon EC2 Spot Instances with AWS Savings Plans to optimize costs, and Amazon Athena for data querying.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Ahamove_logo%401x.903f6ce59fd76d832e67b9885a39cfcfadc16f81.png","displayLocation":"Vietnam","footerInfoText":"Published Date","industry":"Transport \u0026 Logistics","sortDate":"2022-02-18","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ahamove/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Ahamove Migrates 1,000 Containers to Amazon EKS to Improve App Stability","customer-name":"Ahamove"}},"tags":[{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#location#asean","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"ASEAN","description":"ASEAN","dateCreated":"2020-08-20T03:53:05+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04