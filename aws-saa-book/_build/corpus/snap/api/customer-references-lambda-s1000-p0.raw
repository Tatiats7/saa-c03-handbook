os mediante códigos QR interoperables.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/ank-logo%402x.9690ffa6141ab90121f2f968ae1c06e41aad2cf0.png","displayLocation":"Argentina","footerInfoText":"Fecha de publicación","industry":"Servicios financieros","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/ank/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"ank","contentType":"Historia del cliente","headline":"ank entrega mejores servicios a sus clientes con proceso de conciliación basado en AWS"}},"tags":[{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"customer-references#category#batch-processing","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Batch Processing","description":"Batch Processing","dateCreated":"2019-07-22T18:31:02+0000","dateUpdated":"2022-02-26T01:35:02+0000"},{"id":"GLOBAL#tech-category#containers","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Containers","description":"Containers","dateCreated":"2020-02-13T00:27:17+0000","dateUpdated":"2022-02-03T03:35:26+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29