ted":"2022-02-03T03:32:31+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#language#french","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"French","description":"French","dateCreated":"2020-03-03T06:40:44+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"}]},{"item":{"id":"customer-references#siemens-innovator-de-it","locale":"en_US","directoryId":"customer-references","name":"siemens-innovator-de-it","dateCreated":"2024-11-12T00:53:37+0000","dateUpdated":"2024-11-12T01:13:42+0000","additionalFields":{"descriptionSummary":"Siemens AG, leader globale nell\u0027elettrificazione, nell\u0027automazione e nella digitalizzazione, guida l\u0027innovazione in vari settori da oltre 175 anni. Siemens utilizza una gamma di tecnologie Amazon Web Services (AWS) per portare avanti la tradizione della trasformazione, portando l\u0027Internet delle cose industriale (IIoT) a ferrovie e fabbriche, sviluppando infrastrutture intelligenti per edifici e sistemi di energia distribuiti, implementando l\u0027intelligenza artificiale (IA) sulla piattaforma di cybersecurity e molto altro. Dalla modernizzazione dell\u0027infrastruttura di dati e delle funzionalità di analisi con AWS Glue e Amazon Athena all\u0027utilizzo di Amazon Neptune e AWS Lambda per creare Building Twin di Siemens. Ogni passaggio intrapreso dall\u0027organizzazione nel cloud AWS apporta nuova efficienza, valore e informazioni per migliorare le operazioni per Siemens e i suoi clienti.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Siemens_Customer-Reference_Logo%401x.bb038521df5899223d4bd8364182c2fc69ef288d.png","displayLocation":"North America","customerNameLower":"siemens","footerInfoText":"Published Date","industry":"Life Sciences","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/innovators/siemens/","customer-name":"Siemens","enableShare":"1","publishedDate":"2020","contentType":"Storia del cliente","headline":"Siemens su AWS"}},"tags":[{"id"