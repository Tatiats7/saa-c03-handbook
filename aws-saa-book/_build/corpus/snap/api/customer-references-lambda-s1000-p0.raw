9:17+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#prof-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Professional Services","description":"Professional Services","dateCreated":"2020-06-25T04:07:49+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"customer-references#customer-segment#strategic","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Strategic","description":"Strategic","dateCreated":"2019-07-22T18:39:52+0000","dateUpdated":"2022-04-02T00:32:18+0000"},{"id":"GLOBAL#location#hongkong","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Hong Kong","description":"Hong Kong","dateCreated":"2020-02-03T05:29:18+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"IoT","description":"IoT","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#category#iot","locale":"en_US","tagNamespaceId":"customer-references#category","name":"IoT","description":"IoT","dateCreated":"2019-07-22T18:32:05+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#lightsail","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Lightsail","description":"Amazon Lightsail","dateCreated":"2020-03-02T07:04:25+0000","dateUpdated":"2022-02-03T03:32:47+0000"}]},{"item":{"id":"customer-references#san-luis-obispo-county-case-study","locale":"en_US","directoryId":"customer-references","name":"san-luis-obispo-county-case-study","dateCreated":"2022-01-29T03:25:48+0000","dateUpdated":"2022-01-29T03:29:14+0000","additionalFields":{"descriptionSummary":"San Luis Obispo (SLO) County in California formed the SLO Opioid Safety Coalition (SLO OSC) in 2016 to address opioid misuse in the region. To help the community, prevent overdose deaths, and support people struggling with addiction, SLO County decided to build a web application, Naloxone Now, in collaboration with the Cal Poly Digital Transformation Hub (DxHub) powered by Amazon Web Services (AWS) to help connect those in need to the life-saving drug Naloxone. The student developers and designers at the DxHub built SLO County’s application using Amazon Simple Storage Service (Amazon S3) to host web pages with text and videos about how to obtain and administer Naloxone. To support the app’s delivery feature, the developers leveraged Amazon DynamoDB (DynamoDB), AWS Lambda, and Amazon Simple Notification Service (Amazon SNS). Cities, counties, and community members alike who are looking to help save hundreds, even thousands, of lives and prevent fatal opioid overdoses can adopt the app.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/slo-logo%402x.d9c61e6386315853917844509eac5f43f0a93449.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"General Public Services","sortDate":"2022-01-28","headlineUrl":"https://aws.amazon.com/solutions/case-studies/san-luis-obispo-county-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Helping Prevent Opioid Overdoses: Student Developers Build Web App on AWS","customer-name":"SLO Opioid Safety Coalition (SLO OSC)"}},"tags":[{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:43+0000","d