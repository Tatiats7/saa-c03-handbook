ntent-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"IoT","description":"IoT","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Auto Scaling","description":"AWS Auto Scaling","dateCreated":"2020-03-02T07:01:39+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#vtex","locale":"en_US","directoryId":"customer-references","name":"vtex","dateCreated":"2023-06-01T23:05:28+0000","dateUpdated":"2023-06-08T04:07:47+0000","additionalFields":{"descriptionSummary":"A VTEX é uma plataforma comercial global, que trabalha com 2.500 marcas, lojas e empresas, ajudando-as a criar experiencias de e-commerce aos clientes, seja no ambiente B2C ou B2B. Para assegurar que seus clientes entreguem as melhores experiências aos usuários, incluindo ofertas personalizadas, entregas expressas e segurança de dados, a VTEX adota serviços da AWS. Neste vídeo, Amit Shah, diretor de estratégia (CSO) da VTEX, explica os motivos que levaram a empresa à escolha da AWS. Ele detalha a importância de se contar com um provedor com presença global, entre outras características dos serviços AWS. Confira.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/industry/automotive/logos/VTEX.8914cab096469018f9a5cb17157180fe7182d9c5.jpg","displayLocation":"Brasil","customerNameLower":"vtex","footerInfoText":"Data de publicação","industry":"Software e Internet","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/VTEX/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"VTEX","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"VTEX leva serviços de nível global a clientes em todo o mundo com AWS"}},"tags":[{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#product#rekognition","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Rekognition","description":"Amazon Rekognition","