:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#benelux","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Benelux","description":"Benelux","dateCreated":"2020-02-03T05:29:47+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Mobile","description":"Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2023-08-22T20:28:38+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#gen-ai","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gen AI","description":"\u003cp\u003eGenerative Artificial Intelligence\u003c/p\u003e\n","dateCreated":"2023-07-10T17:07:31+0000","dateUpdated":"2023-07-10T17:07:31+0000"}]},{"item":{"id":"customer-references#gitguardian","locale":"en_US","directoryId":"customer-references","name":"gitguardian","dateCreated":"2024-08-31T00:46:24+0000","dateUpdated":"2024-08-31T00:53:52+0000","additionalFields":{"descriptionSummary":"GitGuardian est une startup française de cybersécurité qui aide les développeurs et entreprises à écrire du code sécurisé grâce à sa plateforme SaaS hébergée sur AWS. Lancée en 2017, son objectif est de détecter et remédier aux fuites de secrets de code, comme les clés API et mots de passe exposés.\n\nAvec plus d\u0027un milliard de commits analysés en 2023, GitGuardian a identifié plus de 12 millions de secrets exposés publiquement, touchant 1 développeur sur 10 actif sur GitHub. Au-delà des développeurs individuels, les entreprises technologiques ont adopté la solution pour sécuriser leur cycle de développement logiciel.\n\nConstruite pour être \"cloud-native\" sur AWS, la plateforme GitGuardian couvre les systèmes de contrôle de version, pipelines CI/CD et configurations infrastructure-as-code. Récemment migrée sur Amazon EKS, elle bénéficie d\u0027une meilleure vélocité, observabilité et autoscaling pour s\u0027adapter aux charges, réduisant les coûts de 20%.\n\nGitGuardian étend désormais ses capacités à la cyber déception avec HoneyToken et la gestion des vulnérabilités open source, dans une suite complète pour sécuriser le développement logiciel hébergée sur AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/gitguardian-logo%401x.ea0bd1c3cd5e7340eab865affcbcbdda8b632b3e.png","displayLocation":"France","customerNameLower":"gitguardian","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2024-08-07","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/gitguardian/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"GitGuardian","publishedDate":"2024","enableShare":"1","headline":"GitGuardian aide les développeurs à coder en toute sécurité avec sa plateforme SaaS sur AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#category#devops","locale":"en_US","tagNamespaceId":"customer-references#category","name":"DevOps","description":"DevOps","dateCreated":"2019-07-22T18:31:49+0000","dateUpdated":"2022-03-05T03:54:11+0000"},{"id":"GLOBAL#language#french","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"French","description":"French","dateCreated":"2020-03-03T06:40:44+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"customer-references#category#marketplace","locale":"en_US","