#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#use-case#datacenter-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2020-08-18T05:17:48+0000","dateUpdated":"2022-02-03T03:35:39+0000"}]},{"item":{"id":"customer-references#intraway","locale":"en_US","directoryId":"customer-references","name":"intraway","dateCreated":"2023-05-11T00:15:05+0000","dateUpdated":"2023-06-08T04:07:44+0000","additionalFields":{"descriptionSummary":"Intraway es una empresa que genera sistemas de software OSS de automatización no-code basados en la nube para proveedores de servicios de telecomunicaciones. Apoya los servicios de sobre 40 millones de suscriptores en más de 20 países en tres continentes. Posee oficinas en Argentina, Colombia, México, Perú, Uruguay y Estados Unidos. La compañía implementó para desarrollar un producto multirregión con gran capacidad de recovery y que le permiriera redesplegar las soluciones en la región. Toda la implementación le permite a Intraway tener mayor agilidad y rendimiento, mejor disponibilidad; además de mayor elasticidad e innovación, así como un incremento en la calidad del servicio.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/industry-images-customer-references/Intraway_Logo.fc35f2a90189cd08095af13aeb9a0a352816d130.png","displayLocation":"Argentina","customerNameLower":"intraway","footerInfoText":"Fecha de publicación","industry":"Telecomunicaciones","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/intraway/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Intraway","publishedDate":"2021","enableShare":"1","headline":"Intraway crea un producto de misión crítica multirregión y resiliente en su operación con soluciones AWS","contentType":"Historia del cliente"}},"tags":[{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#industry#telecommunications","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Telecommunications","description":"Telecommunications","dateCreated":"2020-01-16T17:42:41+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#ecr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Registry (ECR)","description":"Amaz