teCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#product#ec2-spot-instances","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Spot Instances","description":"Amazon EC2 Spot Instances","dateCreated":"2022-04-26T06:27:16+0000","dateUpdated":"2022-04-26T06:27:16+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#batch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Batch","description":"AWS Batch","dateCreated":"2020-03-02T07:01:42+0000","dateUpdated":"2022-02-03T03:32:19+0000"},{"id":"GLOBAL#product#ec2-gaviton","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"EC2 Graviton","description":"EC2 Graviton","dateCreated":"2023-10-26T23:11:35+0000","dateUpdated":"2023-10-26T23:11:35+0000"}]},{"item":{"id":"customer-references#case-study-institut-pasteur-fr","locale":"en_US","directoryId":"customer-references","name":"case-study-institut-pasteur-fr","dateCreated":"2024-08-31T00:46:19+0000","dateUpdated":"2024-08-31T00:53:52+0000","additionalFields":{"descriptionSummary":"Moins de 0,01% des virus existants ont été identifiés à ce jour. Et parmi ces innombrables espèces encore méconnues se cache peut-être le responsable d’une pandémie à venir. Au lendemain de la crise de Covid-19, et afin d’identifier plus facilement les prochaines menaces, un projet de recherche « IndexThePlanet » à l’Institut Pasteur a donc entrepris un travail d’analyse et de cartographie de l’ADN de l’ensemble du monde vivant, à partir d’une base de données publique. Mais pour traiter un tel volume de données, le projet a dû mettre sur pied une infrastructure capable de relever le défi représenté par les quelques 20 pétaoctets à traiter. C’est tout l’objet du partenariat noué avec Amazon Web Services (AWS) qui a mis à la disposition des chercheurs un cluster de plus de 2 millions de vCPUs pour mener à bien ce travail de titan.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/institut-pasteur-logo%401x.7bdb4211ae89b77b87d554dd3bba542abb2d1422.png","displayLocation":"France","customerNameLower":"institut pasteur","footerInfoText":"Published Date","industry":"Academic Research","sortDate":"2024-08-06","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/case-study-institut-pasteur/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Institut Pasteur","publishedDate":"2024","enableShare":"1","headline":"L’Institut Pasteur et AWS analysent l\u0027ADN mondial, à partir d’une base de données publique","contentType":"Customer Story"}},"tags":[{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#tech-category#cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-01-16T17:43:13+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#product#batch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Batch","description":"AWS Batch","dateCreated":"2020-03-02T07:01:42+0000","dateUpdated":"2022-02-03T03:32:19+0000"},{"id":"GLOBAL#language#french","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"French","description":"French","dateCreated":"2020-03-03T06:40:44+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#ec2-spot-instances","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Spot Instances","description":"Amazon EC2 Spot Instances","dateCreated":"2022-04-26T06:27:16+0000","dateUpdated":"2022-04-26T06:27:16+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#academic-research","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Academic Research","description":"Academic Research","dateCreated":"2022-04-27T23:31:38+0000","dateUpdated":"2022-04-27T23:31:38+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#ec2-gaviton","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"EC2 Graviton","description":"EC2 Graviton","dateCreated":"2023-10-26T23:11:35+0000","dateUpdated":"2023-10-26T23:11:35+0000"}]},{"item":{"id":"customer-references#fairbrics","locale":"en_US","directoryId":"customer-references","name":"fairbrics","dateCreated":"2024-08-10T00:06:14+0000","dateUpdated":"2024-08-10T00:32:51+0000","additionalFields":{"descriptionSummary":"Fairbics a développé une technologie pour fabriquer des vêtements à partir de CO2, réduisant l\u0027empreinte carbone du textile. Débutée il y a 5 ans, la start-up vise désormais à produire à grande échelle à un prix abordable.\n\nEn 2023, le programme AWS Activate leur a permis d\u0027accéder à des ressources de calcul et un accompagnement bénéfique. Ils ont ainsi pu passer des simulations à un prototype fonctionnel en laboratoire.\n\nLa prochaine étape est l\u0027industrialisation, en montant en échelle grâce au cloud AWS pour permettre une production de masse de leurs vêtements éco-responsables.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Fairbrics-200px.c49e8417b332235d574b809c3e605cde27a27ef1.png","displayLocation":"France","customerNameLower":"fairbrics","footerInfoText":"Published Date","industry":"Energy","sortDate":"2024-07-18","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/fairbrics?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Fairbrics","publishedDate":"2024","enableShare":"1","headline":"Fairbrics: le Cloud AWS au service de la réduction carbone","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#use-case#sustainability","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Sustainability","description":"Sustainability","dateCreated":"2021-07-02T05:53:58+0000","dateUpdated":"2022-02-03T03:35:58+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#energy","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Energy","description":"Energy","dateCreated":"2020-07-15T21:58:51+0000","dateUpdated":"2022-02-03T03:32:02+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#language#french","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"French","description":"French","dateCreated":"2020-03-03T06:40:44+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"customer-references#category#sustainability","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Sustainability","description":"Sustainability","dateCreated":"2022-01-18T21:36:39+0000","dateUpdated":"2022-05-09T21:31:10+0000"},{"id":"GLOBAL#product#ec2-gaviton","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"EC2 Graviton","description":"EC2 Graviton","dateCreated":"2023-10-26T23:11:35+0000","dateUpdated":"2023-10-26T23:11:35+0000"}]},{"item":{"id":"customer-references#ringier-axel-springer","locale":"en_US","directoryId":"customer-references","name":"ringier-axel-springer","dateCreated":"2024-11-05T23:51:07+0000","dateUpdated":"2024-11-05T23:57:27+0000","additionalFields":{"descriptionSummary":"Ringier Axel Springer Polska (RASP) drastically reduced its carbon emissions after migrating to AWS. RASP, a Polish digital media company, committed to reducing carbon emissions by 90 percent. As part of a strategy geared toward compute efficiency and price performance, it migrated to Amazon EC2 Graviton processors, which cut its carbon emissions for IT systems to near zero. It also launched green initiatives to educate entrepreneurs and the public about sustainability. Now, RASP has achieved greater efficiency and continues to make strides toward its sustainability goals.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/RingierAxelSpringer_Customer-Reference_Logo.e7f8ebfdf1de5dc6058f3fff4feb98fbf0668a16.png","displayLocation":"Poland","customerNameLower":"ringier axel springer polska","fo