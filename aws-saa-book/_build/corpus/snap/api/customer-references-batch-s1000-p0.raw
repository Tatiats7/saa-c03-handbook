:"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#industry#electronics","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Electronics","description":"Electronics","dateCreated":"2020-06-25T04:07:00+0000","dateUpdated":"2022-02-03T03:32:02+0000"},{"id":"GLOBAL#location#ukir","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"UK/IR","description":"UK/IR","dateCreated":"2020-02-19T23:06:44+0000","dateUpdated":"2022-02-03T03:31:51+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#product#batch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Batch","description":"AWS Batch","dateCreated":"2020-03-02T07:01:42+0000","dateUpdated":"2022-02-03T03:32:19+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#use-case#high-perform-compute","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"High Performance Compute","description":"High Performance Compute","dateCreated":"2020-06-05T06:37:26+0000","dateUpdated":"2022-02-03T03:35:41+0000"}]},{"item":{"id":"customer-references#neumora03302022lknsrglihsef","locale":"en_US","directoryId":"customer-references","name":"neumora03302022lknsrglihsef","dateCreated":"2022-05-23T21:42:35+0000","dateUpdated":"2024-05-07T16:34:53+0000","additionalFields":{"featured":"0","descriptionSummary":"Neumora Therapeutics leverages AWS to pioneer a computational psychiatry platform to advance its pipeline of novel therapeutics designed to restore balance to dysregulated brain circuits. They utilized a fully managed FSx for Lustre eliminated the operational storage overhead with their MRI workloads. The Amazon FSx is integrated with Amazon S3 orchestrated with Amazon Batch to provide an accelerated  end-to-end data processing  as well as seamless auto-scaling access to compute performance using Amazon EC2 instances. Neumora Therapeutics was able to process and visualize magnetic imaging data (MRI) at scale. They have increased their time-to-insight from weeks-to-hours (20x improvement) and Improved scalability and performance by 5x.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/neumora-logo%401x.ad88ac11019a53454f3f7f188f44a43b8b900df1.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2022-03-30","headlineUrl":"https://youtu.be/EiljRL0977M?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Neumora Therapeutics","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Neumora Therapeutics: Advanced MRI Precision Medicine and Brain Data Analysis Visualization at Scale"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+00