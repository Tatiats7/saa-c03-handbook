description":"AWS Cost Explorer","dateCreated":"2020-03-02T07:02:27+0000","dateUpdated":"2022-02-03T03:32:27+0000"},{"id":"GLOBAL#product#application-migration-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Application Migration Service","description":"AWS Application Migration Service","dateCreated":"2022-08-15T20:58:56+0000","dateUpdated":"2022-09-24T05:36:20+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#cloudsearch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudSearch","description":"Amazon CloudSearch","dateCreated":"2020-03-02T07:02:03+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#ses","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Email Service (SES)","description":"Amazon Simple Email Service (SES)","dateCreated":"2020-03-02T07:05:22+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#certificate-mgr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Certificate Manager","description":"AWS Certificate Manager","dateCreated":"2020-03-02T07:01:45+0000","dateUpdated":"2022-02-03T03:32:20+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"}]},{"item":{"id":"customer-references#gsr-case-study","locale":"en_US","directoryId":"customer-references","name":"gsr-case-study","dateCreated":"2023-03-03T22:13:31+0000","dateUpdated":"2024-02-20T22:25:51+0000","additionalFields":{"descriptionSummary":"When the COVID-19 pandemic disrupted economies around the world and led many governments to respond with large financial stimulus programs, GSR saw a fast-rising demand for cryptocurrency trading. It turned to AWS to increase the speed and scalability of its systems. Using AWS, GSR gained the elasticity it needed to serve its growing customer base, helping it to expand the business and increase the size of its workforce by a factor of 5.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/gsr-logo-2023%401x.1a19d54cdcc6e120928dfcd0456e3652288efa19.png","displayLocation":"Switzerland","customerNameLower":"gsr","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/gsr-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"GSR","publishedDate":"2023","enableShare":"1","headline":"GSR Becomes One of the Largest Crypto Market Makers Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#compute","locale"