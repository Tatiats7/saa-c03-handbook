nces#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#illumina-case-study","locale":"en_US","directoryId":"customer-references","name":"illumina-case-study","dateCreated":"2019-07-22T19:57:22+0000","dateUpdated":"2023-07-12T01:35:42+0000","additionalFields":{"featured":"0","descriptionSummary":"Illumina builds complete genomic sequencing and analysis platforms on AWS, giving researchers across the globe affordable, regulation-compliant access to secure data storage and powerful computational tools to unlock genomic discoveries.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/logo-illumina-blk-200x45.0ba979d6f3e4b9c48d88bb66fb3c0b4b8b43cf11.png","displayLocation":"United States","footerInfoText":"Published Date","description":"\u003cp\u003eIllumina is using AWS to save close to $400,000 monthly, fuel global expansion, and help genomic researchers accelerate time-to-discovery. The company provides hardware and software for genome sequencing and analysis. Illumina runs its BaseSpace Sequence Hub platform on AWS, taking advantage of Amazon EC2 Spot Instances to lower compute and storage costs.\u003c/p\u003e\r\n","industry":"Genomics","sortDate":"2021-11-05","headlineUrl":"https://aws.amazon.com/solutions/case-studies/illumina-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Illumina","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Illumina Brings Genomics from Samples to Answers Using AWS"}},"tags":[{"id":"GLOBAL#use-case#general-database-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"General Database Migration","description":"General Database Migration","dateCreated":"2020-06-05T06:37:24+0000","dateUpdated":"2022-02-03T03:35:41+0000"},{"id":"customer-references#category#high-performance-computing","locale":"en_US","tagNamespaceId":"customer-references#category","name":"High Performance Computing","description":"High Performance Computing","dateCreated":"2019-07-22T18:32:00+0000","dateUpdated":"2022-02-26T01:35:03+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"customer-references#category#batch-processing","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Batch Processing","description":"Batch Processing","dateCreated":"2019-07-22T18:31:02+0000","dateUpdated":"2022-02-26T01:35:02+0000"},{"id":"customer-references#category#database-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Database Migration","description":"Database Migration","dateCreated":"2019-07-22T18:31:40+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12T02:01:29+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{