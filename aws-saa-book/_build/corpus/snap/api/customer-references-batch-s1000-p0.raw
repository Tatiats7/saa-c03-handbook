zon Comprehend","dateCreated":"2020-03-02T07:02:18+0000","dateUpdated":"2022-02-03T03:32:25+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#drs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elastic Disaster Recovery (DRS)","description":"AWS Elastic Disaster Recovery (DRS)","dateCreated":"2022-01-06T00:53:39+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"customer-references#category#business-resilience","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Resilience","description":"\u003cp\u003eIn business, resilience means dealing with adversity and shocks, and continuously adapting for growth.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:01:43+0000","dateUpdated":"2023-07-14T01:01:43+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"customer-references#category#hcls","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Healthcare \u0026 Life Sciences","description":"Healthcare \u0026 Life Sciences","dateCreated":"2019-07-22T18:31:58+0000","dateUpdated":"2022-05-14T20:13:37+0000"},{"id":"customer-references#recon#auto-campaign","locale":"en_US","tagNamespaceId":"customer-references#recon","name":"auto-campaign","description":"\u003cp\u003eauto-campaign\u003c/p\u003e\n","dateCreated":"2023-12-04T18:22:48+0000","dateUpdated":"2023-12-04T18:22:48+0000"}]},{"item":{"id":"customer-references#porto-case-study","locale":"en_US","directoryId":"customer-references","name":"porto-case-study","dateCreated":"2023-06-01T23:04:25+0000","dateUpdated":"2023-06-08T04:07:49+0000","additionalFields":{"descriptionSummary":"Fundada há mais de 75 anos, a Porto se consolidou no mercado de seguros, especialmente de automóveis. Nos últimos anos, vem diversificando sua atuação e, hoje, é um verdadeiro ecossistema de soluções de serviços de proteção com tecnologia embarcada, para melhorar e facilitar a experiência do cliente, atuando com três verticais de negócios: Porto Seguro, Porto Saúde e Porto Bank. Em um movimento de modernizar o seu ambiente tecnológico e dar velocidade aos objetivos estabelecidos, a empresa tem investido em serviços em nuvem. Marcos Sirelli, diretor de tecnologia da Porto, Ivan Barale, superintendente de plataformas, arquitetura e engenharia da Porto, e Claudia Ramos, gerente de cloud e DevSecOps da Porto, contam como as soluções em nuvem da AWS atendem às demandas da Companhia por agilidade, modernização, flexibilidade, disponibilidade e escalabilidade. Como destaque, eles detalham o app desenvolvido em cloud para se tornar um ecossistema de interação com seus clientes. Neste vídeo, os executivos contam mais sobre este e outros casos de aplicação de AWS na Porto.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/porto-logo%402x.36a9d42219b7c7aae2df53ddfc1616c441eea4bb.png","displayLocation":"Brasil","customerNameLower":"porto","footerInfoText":"Data de publicação","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/porto-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Porto","enableShare":"1","publishedDate":"2023","contentType":"História do cliente","headline":"AWS apoia modernização de serviços na Porto"}},"tags":[{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notification Service (SNS)","dateCreated":"2020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#product#eks","lo