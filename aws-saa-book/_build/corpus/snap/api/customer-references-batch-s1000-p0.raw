es","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Spot Instances","description":"Amazon EC2 Spot Instances","dateCreated":"2022-04-26T06:27:16+0000","dateUpdated":"2022-04-26T06:27:16+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#batch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Batch","description":"AWS Batch","dateCreated":"2020-03-02T07:01:42+0000","dateUpdated":"2022-02-03T03:32:19+0000"},{"id":"GLOBAL#product#ec2-gaviton","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"EC2 Graviton","description":"EC2 Graviton","dateCreated":"2023-10-26T23:11:35+0000","dateUpdated":"2023-10-26T23:11:35+0000"}]},{"item":{"id":"customer-references#case-study-institut-pasteur-fr","locale":"en_US","directoryId":"customer-references","name":"case-study-institut-pasteur-fr","dateCreated":"2024-08-31T00:46:19+0000","dateUpdated":"2024-08-31T00:53:52+0000","additionalFields":{"descriptionSummary":"Moins de 0,01% des virus existants ont été identifiés à ce jour. Et parmi ces innombrables espèces encore méconnues se cache peut-être le responsable d’une pandémie à venir. Au lendemain de la crise de Covid-19, et afin d’identifier plus facilement les prochaines menaces, un projet de recherche « IndexThePlanet » à l’Institut Pasteur a donc entrepris un travail d’analyse et de cartographie de l’ADN de l’ensemble du monde vivant, à partir d’une base de données publique. Mais pour traiter un tel volume de données, le projet a dû mettre sur pied une infrastructure capable de relever le défi représenté par les quelques 20 pétaoctets à traiter. C’est tout l’objet du partenariat noué avec Amazon Web Services (AWS) qui a mis à la disposition des chercheurs un cluster de plus de 2 millions de vCPUs pour mener à bien ce travail de titan.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/institut-pasteur-logo%401x.7bdb4211ae89b77b87d554dd3bba542abb2d1422.png","displayLocation":"France","customerNameLower":"institut pasteur","footerInfoText":"Published Date","industry":"Academic Research","sortDate":"2024-08-06","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/case-study-institut-pasteur/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Institut Pasteur","publishedDate":"2024","enableShare":"1","headline":"L’Institut Pasteur et AWS analysent l\u0027ADN mondial, à partir d’une base de données publique","contentType":"Customer Story"}},"tags":[{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","de