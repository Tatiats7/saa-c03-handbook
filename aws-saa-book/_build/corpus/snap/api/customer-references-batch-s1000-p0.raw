{"items":[{"item":{"id":"customer-references#arre-voice-datastax-2025","locale":"en_US","directoryId":"customer-references","name":"arre-voice-datastax-2025","dateCreated":"2025-02-04T23:15:35+0000","dateUpdated":"2025-03-06T23:39:05+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eArr\u0026eacute; Voice wanted to enhance user engagement on its digital media platform with personalized content recommendations. The company needed a scalable solution capable of processing large volumes of user data while supporting artificial intelligence (AI)-driven algorithms for content personalization. By transitioning to a microservices architecture, using Amazon Web Services (AWS), and implementing Astra DB, a vector database from AWS Partner DataStax, Arr\u0026eacute; Voice enabled real-time data handling and improved operational efficiency. Astra DB\u0026rsquo;s query capabilities and developer tools facilitated the rapid development of its recommendation engine, which now generates over 30 million personalized suggestions per month with a 90-percent reduction in latency.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Arre%20Voice%2070x70px.c3c3852c2c4626d9d1a9aee0c45f65f0dc108eb5.png","displayLocation":"India","footerInfoText":"2025","industry":"Media \u0026 Entertainment","sortDate":"2025-02-04","headlineUrl":"https://aws.amazon.com/partners/success/arre-voice-datastax/","customer-name":"Arré Voice","enableShare":"1","publishedDate":"2025","contentType":"Case Study","headline":"Arré Voice Enhances User Engagement and Reduces Latency by 90% with DataStax Astra DB and AWS"}},"tags":[{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"GLOBAL#product#neptune","locale":"en_US","tagNamesp