unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#autodesk-expanding-insights-case-study","locale":"en_US","directoryId":"customer-references","name":"autodesk-expanding-insights-case-study","dateCreated":"2022-06-27T20:44:35+0000","dateUpdated":"2024-03-02T02:48:50+0000","additionalFields":{"descriptionSummary":"Global software company Autodesk used Amazon SageMaker to improve the efficiency insights that it can provide to users of its computer-aided design program AutoCAD, focusing on development rather than operations.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/autodesk-logo-2022%401x.c2c78e83fe77cfbe57e586f0465bf8f70e5089ce.png","displayLocation":"United States","customerNameLower":"autodesk","footerInfoText":"Published Date","industry":"Electronics \u0026 Semiconductors","sortDate":"2022-06-24","headlineUrl":"https://aws.amazon.com/solutions/case-studies/autodesk-expanding-insights-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Autodesk","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Autodesk Rapidly Expands Insights in Software Using Amazon SageMaker and Amazon EMR"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":