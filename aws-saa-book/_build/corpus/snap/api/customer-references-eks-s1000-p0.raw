0","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"}]},{"item":{"id":"customer-references#wynkmusic-eks","locale":"en_US","directoryId":"customer-references","name":"wynkmusic-eks","dateCreated":"2021-09-11T00:48:54+0000","dateUpdated":"2021-12-22T23:24:48+0000","additionalFields":{"descriptionSummary":"By running its music app’s content discovery platform on AWS, Wynk Music grew its monthly active user pool from 50 million to 72 million, and improved user interaction with a 39 percent increase in clickthrough rate to its homepage. Using Amazon Elastic Kubernetes Service (Amazon EKS) and Amazon EMR, the team has 100 microservices live in production at any time and reduced development time from two weeks to four days.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Wynk_logo%401x.3ff1ed171fdd0f3dd986f6e2bb9bdfa2042346fc.png","displayLocation":"India","footerInfoText":"Published Date","industry":"Telecommunications","sortDate":"2021-09-10","headlineUrl":"https://aws.amazon.com/solutions/case-studies/wynkmusic-eks/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Wynk Music App by Airtel Raises the User Experience Bar with Amazon EKS","customer-name":"Wynk Music"}},"tags":[{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#ca