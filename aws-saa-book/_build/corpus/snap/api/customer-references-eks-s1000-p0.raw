e":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#product#cognito","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Cognito","description":"Amazon Cognito","dateCreated":"2020-03-02T07:02:17+0000","dateUpdated":"2022-02-03T03:32:25+0000"},{"id":"customer-references#category#finserv","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Financial Services","description":"Financial Services","dateCreated":"2019-07-22T18:31:53+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#capital-markets","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Capital Markets","description":"Capital Markets","dateCreated":"2021-12-14T00:56:21+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"}]},{"item":{"id":"customer-references#despegar2","locale":"en_US","directoryId":"customer-references","name":"despegar2","dateCreated":"2023-06-01T23:08:47+0000","dateUpdated":"2023-07-12T01:35:41+0000","additionalFields":{"descriptionSummary":"Hace dos años Despegar tenía su arquitectura consolidada y orientada a microservicios, cada uno de ellos con su propia base de datos. Como resultado, la compañía llegó a tener más de 120 Cassandras instaladas, más de 80 MySQL, 70 MongoDBs y más de 40 elasticsearch (Amazon ES). Con esa estructura, los analistas no podían analizar los datos de un solo lugar y racional. Así que Despegar eligió las soluciones de AWS como base para montar su estructura de data lake. Hoy la compañía logra transferir un montón de datos todas las noches de sus máquinas a las máquinas de AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/despegar_logo%401x.f06fcbe7cb92dd6b0c694618b96b151199270f96.png","displayLocation":"Argentina","footerInfoText":"Fecha de publicación","industry":"Viajes","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/despegar2/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","customer-name":"Despegar","contentType":"Historia del cliente","headline":"Despegar cuenta con AWS para construir su data lake"}},"tags":[{"id":"GLOBAL#customer-enablement#business-support","locale":"en_US","tagNamespaceId":"GLOBAL#customer-enablement","name":"AWS Business Support","description":"AWS Business Support","dateCreated":"2020-09-04T04:06:24+0000","dateUpdated":"2022-02-03T03:31:13+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#customer-enabl