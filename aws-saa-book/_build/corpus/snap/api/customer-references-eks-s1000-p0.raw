51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#codebuild","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodeBuild","description":"AWS CodeBuild","dateCreated":"2020-03-02T07:02:08+0000","dateUpdated":"2022-02-03T03:32:24+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#estonia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Estonia","description":"Estonia","dateCreated":"2020-03-10T05:14:10+0000","dateUpdated":"2022-02-03T03:31:42+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"}]},{"item":{"id":"customer-references#snyk","locale":"en_US","directoryId":"customer-references","name":"snyk","dateCreated":"2023-08-10T01:02:28+0000","dateUpdated":"2024-02-20T22:26:14+0000","additionalFields":{"descriptionSummary":"Using AWS Marketplace, cybersecurity startup Snyk rapidly grew sales over 2 years, closing the fourth quarter of 2022 with 81 private offers. Snyk offers a developer-first security solution that scans for vulnerabilities in code and provides actionable solutions. The company recognized that its customer base overlapped with customers of AWS and wanted to offer a security solution that worked seamlessly within AWS workflows. By selling the security solution alongside AWS, Snyk significantly reduces the sales life cycle and achieves 14 times the return on its marketing investment.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/snyk-logo%401x.1e86f81a640f483b24a234eb3074f1a67f4882a8.png","displayLocation":"United Kingdom","customerNameLower":"snyk","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2023-08-08","headlineUrl":"https://aws.amazon.com/solutions/case-studies/snyk/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Snyk","publishedDate":"2023","enableShare":"1","headline":"Snyk Achieves 14x Return on Investment Using AWS Marketplace","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#tech-category#devtools","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Developer Tools","description":"Developer Tools","dateCreated":"2020-01-16T17:43:16+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#uk","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United Kingdom","description":"United Kingdom","dateCreated":"2020-02-03T05:30:18+0000","dateUpdated":"2022-02-03T03:31