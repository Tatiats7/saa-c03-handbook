ic Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#location#indonesia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Indonesia","description":"Indonesia","dateCreated":"2020-02-03T05:29:22+0000","dateUpdated":"2022-02-03T03:31:36+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#bharti-airtel-limited-case-study","locale":"en_US","directoryId":"customer-references","name":"bharti-airtel-limited-case-study","dateCreated":"2022-09-22T02:55:03+0000","dateUpdated":"2022-09-22T07:07:45+0000","additionalFields":{"descriptionSummary":"By adopting Karpenter on Amazon EKS, Airtel has reduced the time to scale by 25–33 percent and is saving 47 percent on infrastructure costs. Airtel is a leading telecommunications company that owns the Wynk Music over-the-top streaming platform.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Airtel_logo%401x.6e220584a57d9f9b7628456521224d4dce542dac.png","displayLocation":"India","customerNameLower":"airtel","footerInfoText":"Published Date","industry":"Telecommunications","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/bharti-airtel-limited-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Airtel","publishedDate":"2022","enableShare":"1","headline":"Airtel Delivers a Smooth Streaming Experience for Wynk Studio by Adopting Karpenter on Amazon EKS","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#ec2-spot-instances","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Spot Instances","description":"Amazon EC2 Spot Instances","dateCreated":"2022-04-26T06:27:16+0000","dateUpdated":"2022-04-26T06:27:16+0000"},{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#networking-content-de