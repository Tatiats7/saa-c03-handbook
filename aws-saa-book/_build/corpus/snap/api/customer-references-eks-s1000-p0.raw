n Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"}]},{"item":{"id":"customer-references#indivumed-case-study","locale":"en_US","directoryId":"customer-references","name":"indivumed-case-study","dateCreated":"2022-05-09T21:31:36+0000","dateUpdated":"2024-05-07T16:34:54+0000","additionalFields":{"descriptionSummary":"Hamburg-based Indivumed specializes in using the highest quality biospecimen and comprehensive clinical data to advance research and development in precision oncology. Its IndivuType discovery solution uses AWS to store data and support analysis to decipher the complexity of cancer. By improving its AWS infrastructure, Indivumed has saved more than 50 percent on total IT costs and ramped up the number of samples it can process from 20 to 500 a week, a 2,400 percent increase.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/indivumed-logo%401x.f0492ec906682b8fac65fc1f3a53debe1878a8fc.png","displayLocation":"Europe, Middle East, \u0026 Africa","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2022-05-09","headlineUrl":"https://aws.amazon.com/solutions/case-studies/indivumed-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","customer-name":"Indivumed","contentType":"Customer Story","headline":"Indivumed Boosts Cancer Research With Powerful Analytics Built on AWS"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#cat