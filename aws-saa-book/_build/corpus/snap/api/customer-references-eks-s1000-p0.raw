"dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#elsa-2021-case-study","locale":"en_US","directoryId":"customer-references","name":"elsa-2021-case-study","dateCreated":"2022-03-24T02:43:26+0000","dateUpdated":"2022-03-24T02:46:33+0000","additionalFields":{"descriptionSummary":"Launched in 2015, ELSA Corp. (ELSA) uses speech technology and artificial intelligence (AI) to help non-native English learners improve speech and pronunciation via short, app-based lessons. Its ELSA Speak app is currently localized in nine languages for English learning. Amazon EKS, Amazon EC2, and Amazon DynamoDB delivered the compute capacity, low latency, and high availability needed for ELSA to stream learning content quickly to its users, and process four million user recordings daily coming through its ELSA Speak app, used in over 100 countries.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/ELSA_logo%401x.8554cc063ca4a2ef9174daf8ff0fdc5437bc6f8b.png","displayLocation":"Vietnam","footerInfoText":"Published Date","industry":"Education","sortDate":"2022-03-23","headlineUrl":"https://aws.amazon.com/solutions/case-studies/elsa-2021-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"ELSA Scales Quickly and Reliably on the AWS Cloud to Support Millions of Users","customer-name":"ELSA Corp. (ELSA)"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#vietnam","locale":"en_US","tagNamespaceId