a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#huuuge-games-case-study","locale":"en_US","directoryId":"customer-references","name":"huuuge-games-case-study","dateCreated":"2020-08-11T19:01:15+0000","dateUpdated":"2021-12-23T00:55:22+0000","additionalFields":{"featured":"0","descriptionSummary":"Huuuge Games stays focused on developing new titles and improving the gaming experience using AWS. The company has built popular massively multiplayer online games, such as Huuuge Casino. Amazon EKS automates management tasks, while game play is analyzed using Amazon EMR and Amazon Neptune.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/HuuugeGames_Customer-Reference_Logo.2878f7a4c70df89220749341c43990dff3029fe0.png","displayLocation":"Poland","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/Huuuge-Games-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Huuuge Games","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Huuuge Games Focuses on New Titles Thanks to the Simplicity of AWS"}},"tags":[{"id":"GLOBAL#location#cee","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central \u0026 Eastern E