y","dateCreated":"2020-02-03T05:29:55+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"}]},{"item":{"id":"customer-references#united-airlines","locale":"en_US","directoryId":"customer-references","name":"united-airlines","dateCreated":"2024-09-26T20:53:39+0000","dateUpdated":"2025-01-13T19:00:55+0000","additionalFields":{"descriptionSummary":"United Airlines is leading modernization in an industry that’s embracing change. The largest airline globally by number of seat miles, its mission is to “Connect People, Uniting the World.” Migrating tens of hundreds of applications to Amazon Web Services (AWS) has helped the business accelerate innovation, even in the midst of challenging market conditions. From supporting its technology team to save $2 billion and boosting developer productivity 40 percent, to using generative artificial intelligence (AI) to streamline passenger record processes and save months of manual effort. With services such as Amazon Bedrock, AWS IoT Core, and Amazon DocumentDB, United Airlines is transforming passenger experiences, increasing efficiency and security, and shaping the intelligent airport of tomorrow.","featureImageURL":"https://d1.awsstatic.com/united-airlines-innovator-card.b02c9f5e0f9d9f22f3d53377da0ebe6e256ce598.jpeg","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/united-airlines-logo.5700166296d2216b5abdb3666484a1866fcf6504.png","displayLocation":"Americas","customerNameLower":"united airlines","footerInfoText":"Published Date","description":"\u003cp\u003eTransforming passenger experiences, increasing efficiency and security, and shaping the intelligent airport of tomorrow.\u003c/p\u003e\n","industry":"Travel","sortDate":"2024-01-01","headlineUrl":"https: