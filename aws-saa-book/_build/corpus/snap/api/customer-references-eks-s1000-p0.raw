d":"customer-references#category#sustainability","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Sustainability","description":"Sustainability","dateCreated":"2022-01-18T21:36:39+0000","dateUpdated":"2022-05-09T21:31:10+0000"}]},{"item":{"id":"customer-references#t-systems-case-study","locale":"en_US","directoryId":"customer-references","name":"t-systems-case-study","dateCreated":"2024-06-12T18:23:19+0000","dateUpdated":"2024-06-13T20:03:07+0000","additionalFields":{"descriptionSummary":"T-Systems is a leading European digital service provider and subsidiary of telecommunications provider Deutsche Telekom. Trust can be a hurdle for its customers as they pursue new use cases that require faster scalability and more powerful processing. Aleksandar Kelečević, technical team lead—data economy, says partnering with Amazon Web Services (AWS) helps T-Systems show its customers how they can discover the true potential of their data in the cloud.","featureImageURL":"https://d1.awsstatic.com/networking/T_systems_logo_rgb_p-0000.d8a40a586da1037e9804d371f1ee4dcd09bc2e51.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/networking/T_systems_logo_rgb_p-0000.d8a40a586da1037e9804d371f1ee4dcd09bc2e51.png","displayLocation":"Europe","customerNameLower":"t-systems","footerInfoText":"Published Date","industry":"Telecommunications","headlineUrl":"https://aws.amazon.com/solutions/case-studies/t-systems-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"T-Systems","enableShare":"1","publishedDate":"2023","headline":"T-Systems Helps Customers Discover Data-Driven Use Cases in Trusted Environment with AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#content-type#cust