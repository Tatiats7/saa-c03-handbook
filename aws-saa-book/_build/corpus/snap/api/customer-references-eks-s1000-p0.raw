ated":"2022-10-03T18:33:39+0000","dateUpdated":"2022-10-11T21:03:06+0000","additionalFields":{"descriptionSummary":"Apify, a Prague-based startup founded in 2015, has developed a web-scraping and automation platform and set of open source tools that help businesses improve their operations by collecting and analyzing large volumes of web data, and automating web processes. Apify has used AWS from day one, taking advantage of credits and training through the AWS Activate program. The company has grown rapidly and currently provides services to 1,000 organizations across 179 countries. It has also scaled to process 1,000 TB of data a month, reduced compute costs by 25 percent, and boosted the efficiency of its development team.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/apify-logo%401x.edd7d2f2c83fba9ad4f6529cad5f55121d2fbbf0.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"apify","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/apify-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Apify","publishedDate":"2022","enableShare":"1","headline":"Apify Powers Web Insights for Businesses, Cuts Cloud Costs by 25% Using AWS","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Star