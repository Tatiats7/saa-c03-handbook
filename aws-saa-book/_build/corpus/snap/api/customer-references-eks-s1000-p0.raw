When alcohol consumption rose due to the pandemic, Daybreak saw a 15 percent increase in number of daily active users and 52 percent more downloads. Building on AWS, HSM can rapidly scale Daybreak to meet surges in user demand.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/hsm-hello-sunday-morning-logo%401x.0f4c2b3cd68bfde7d9e10e12422e45b1d9fe47dc.png","displayLocation":"Australia","footerInfoText":"Published Date","industry":"Social Services","sortDate":"2022-05-09","headlineUrl":"https://aws.amazon.com/solutions/case-studies/hello-sunday-morning/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Hello Sunday Morning Scales Counselling Support by Ten-fold on AWS","customer-name":"Hello Sunday Morning"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#australia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia","description":"Australia","dateCreated":"2020-02-03T05:29:12+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"customer-references#customer-segment#public-sector-nonprofit","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Nonprofit","description":"Nonprofit","dateCreated":"2019-07-22T18:39:49+0000","dateUpdated":"2022-05-09T21:31:14+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#key-mgmt-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Key Management Service (KMS)","description":"AWS Key Management Service (KMS)","dateCreated":"2020-03-02T07:04:13+0000","dateUpdated":"2022-02-03T03:32:45