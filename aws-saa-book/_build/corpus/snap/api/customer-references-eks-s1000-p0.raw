s-use-case","name":"Small \u0026 Medium Business","description":"Small \u0026 Medium Business","dateCreated":"2022-08-23T05:49:46+0000","dateUpdated":"2022-08-23T05:49:46+0000"}]},{"item":{"id":"customer-references#sicredi","locale":"en_US","directoryId":"customer-references","name":"sicredi","dateCreated":"2023-06-01T23:05:10+0000","dateUpdated":"2023-06-08T04:07:48+0000","additionalFields":{"descriptionSummary":"O Sicredi é uma instituição financeira cooperativa que conta hoje com mais de 2,4 mil agências e está presente fisicamente em todos os estados brasileiros e no Distrito Federal, disponibilizando mais de 300 produtos e serviços financeiros. Com o objetivo de ampliar a sua base de associados, levando o cooperativismo de crédito para mais pessoas, desde 2016 o Sistema tem colocado em prática seu plano de transformação digital em um processo que, realizado na nuvem AWS, vem possibilitando a evolução dos sistemas que processas os produtos e serviços da instituição e a transformando sua área de TI em uma das mais desejadas para se trabalhar por profissionais brasileiros da área.","featureImageURL":"https://d1.awsstatic.com/industry-images-customer-references/Sicredi.2170a52ce017c4c59d337befff624a4422e0ad19.jpg","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/sicredi_logo%402x.f4799fa348a347f00408b857d0647a2406c173b9.png","displayLocation":"Brasil","customerNameLower":"sicredi","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/sicredi/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Sicredi","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"Nuvem AWS apoia jornada de transformação digital do Sicredi"}},"tags":[{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated