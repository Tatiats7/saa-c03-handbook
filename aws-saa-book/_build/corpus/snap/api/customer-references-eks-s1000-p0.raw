":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#location#anz","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia \u0026 New Zealand","description":"Australia \u0026 New Zealand","dateCreated":"2020-04-09T00:26:11+0000","dateUpdated":"2022-02-03T03:31:35+0000"}]},{"item":{"id":"customer-references#alp","locale":"en_US","directoryId":"customer-references","name":"alp","dateCreated":"2022-01-29T03:26:17+0000","dateUpdated":"2022-09-09T00:34:15+0000","additionalFields":{"descriptionSummary":"Ally Logistic Property (ALP) implemented SAP S/4HANA on AWS to streamline data processing and reduce the time and manual effort required for financial reporting. ALP is an institutional logistics property developer, operating six multi-warehouse logistics parks in Taiwan. The business is using Amazon EC2 for compute, Amazon EBS for storage, and Amazon VPC to support its SAP implementation.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/ALP-logo.62d80bfe83f9a85e563adeee3e992ac91b16ba9c.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","industry":"Transport \u0026 Logistics","sortDate":"2022-01-28","headlineUrl":"https://aws.amazon.com/solutions/case-studies/alp/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ally Logistic Property","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Ally Logistic Property Gains Timely, Accurate Data to Support Expansion with SAP S/4 HANA on AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US"