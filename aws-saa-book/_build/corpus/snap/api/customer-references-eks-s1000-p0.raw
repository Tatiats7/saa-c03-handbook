id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"}]},{"item":{"id":"customer-references#zeronorth-case-study","locale":"en_US","directoryId":"customer-references","name":"zeronorth-case-study","dateCreated":"2023-11-23T04:15:42+0000","dateUpdated":"2024-02-20T22:27:54+0000","additionalFields":{"descriptionSummary":"In the global fight against climate change, the shipping industry stands out as one of the most energy-intensive sectors, contributing significantly to greenhouse gas emissions. Driven by a mission to champion sustainability, ZeroNorth has taken proactive measures to help shipping companies tackle these challenges. The technology provider offers a centralized solution where shipping companies can track their current data, make informed decisions, and shift toward faster, greener operations.\n\nTo bring this vision to life, ZeroNorth migrated its data and services to Amazon Web Services (AWS). By harnessing the power of AWS, the company has accelerated its speed of innovation, helping its customers drive efficiencies and meet their sustainability targets at a much faster pace.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/zeronorth-logo%401x.141c3e3e680c878c1f476ac01224a6a658471ba3.png","displayLocation":"Denmark","customerNameLower":"zeronorth","footerInfoText":"Published Date","industry":"Transport \u0026 Logistics","sortDate":"2023-11-13","headlineUrl":"https://aws.amazon.com/solutions/case-studies/zeronorth-case-study?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ZeroNorth","publishedDate":"2023","enableShare":"1","headline":"ZeroNorth Accelerates Sustainable Shipping on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#denmark","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Denmark","description":"Denmark","dateCreated":"2020-02-03T05:30:06+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#use-case#data-lakes","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Data Lakes","description":"Data Lakes","dateCreated":"2020-06-05T06:37:09+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"customer-references#category#data-lakes-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Data Lakes \u0026 Analytics","description":"Data Lakes \u0026 Analytics","dateCreated":"2019-07-22T18:31:39+0000","dateUpdated":"2022-02-07T13:55:55+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#industry#transport-logistics","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Transport \u0026 Logistics","description":"Transport \u0026 Logistics","dateCreated":"2020-06-25T04:08:39+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022