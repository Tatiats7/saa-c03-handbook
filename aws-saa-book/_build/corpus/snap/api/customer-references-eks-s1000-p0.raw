GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"}]},{"item":{"id":"customer-references#aramisauto","locale":"en_US","directoryId":"customer-references","name":"aramisauto","dateCreated":"2024-08-15T21:35:06+0000","dateUpdated":"2024-08-15T21:43:39+0000","additionalFields":{"descriptionSummary":"Aramisauto utilise les déclencheurs DynamoDB pour la réconciliation des données de navigation post-sauvegarde, c’est-à-dire pour regrouper les navigations qui concernent la même personne, par exemple quelqu’un qui navigue sur un ordinateur puis sur son mobile, ce qui permet à Aramisauto de mieux la cibler et connaître son parcours.","imageSrcUrl":"https://d1.awsstatic.com/AWS%20Advertising/Curiosity%20Kid/International/France/Aramisauto-01.26b6b678a44160368f5b6fca1ddc0bc715194626.png","displayLocation":"Other","customerNameLower":"aramisauto","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/aramisauto/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"AramisAuto","publishedDate":"2019","enableShare":"1","headline":"Aramisauto : vers un traitement des données en temps réel","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#elastic-beanstalk","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elastic Beanstalk","description":"AWS Elastic Beanstalk","dateCreated":"2020-03-02T07:03:00+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Mobile","description":"Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":