eferences","name":"moonfrog","dateCreated":"2021-12-14T02:49:50+0000","dateUpdated":"2023-07-14T23:32:51+0000","additionalFields":{"descriptionSummary":"Moonfrog Labs, an Indian gaming company, specializes in mass market social games that attracts about 15 million daily active users across India and globally. To build seamless and efficient scalability and optimize costs, it worked with AWS to run its cloud workloads on AWS Graviton processors, realizing 40 percent better price performance to date. Using Amazon Elastic Kubernetes Service, Amazon CloudFront, Amazon Redshift, and Amazon S3, Moonfrog maintains a high-quality gaming experience for all users.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Moonfrog_logo%401x.5a2838cc8e0c3f5908ba6bb7c8b9916bfe46d90f.png","displayLocation":"India","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/moonfrog/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"Moonfrog Labs","contentType":"Customer Story","headline":"Moonfrog Cuts Compute Costs by 40 Percent with AWS Graviton"}},"tags":[{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute