-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#trade-ledger","locale":"en_US","directoryId":"customer-references","name":"trade-ledger","dateCreated":"2022-01-29T03:26:45+0000","dateUpdated":"2022-01-29T03:29:15+0000","additionalFields":{"descriptionSummary":"Trade Ledger’s lending-as-a-service platform on AWS is helping small and medium-sized enterprises (SMEs) gain access to loans in three days versus 120 days. Trade Ledger’s platform streamlines the credit decisioning process for bank and non-bank lenders. The platform uses Amazon EKS on Amazon EC2 instances to run and scale efficiently, with an infrastructure-as-code approach.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/trade_ledger_logo%401x.32b5a4c7662c9d952b48efbdd4ab64cc1e77e661.png","displayLocation":"Australia","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-01-28","headlineUrl":"https://aws.amazon.com/solutions/case-studies/trade-ledger/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Trade Ledger Accelerates Loan Disbursements by 97.5 Percent with Lending Platform on AWS","customer-name":"Trade Ledger"}},"tags":[{"id":"GLOBAL#location#australia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia","description":"Australia","dateCreated":"2020-02-03T05:29:12+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#tech-category#com