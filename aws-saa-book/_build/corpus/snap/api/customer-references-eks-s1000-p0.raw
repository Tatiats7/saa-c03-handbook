business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Business Applications","description":"Business Applications","dateCreated":"2022-10-07T04:56:33+0000","dateUpdated":"2022-10-07T04:56:33+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#industry#travel","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Travel","description":"Travel","dateCreated":"2020-01-16T17:42:42+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#castilla-la-mancha-sustainability","locale":"en_US","directoryId":"customer-references","name":"castilla-la-mancha-sustainability","dateCreated":"2024-06-12T18:24:17+0000","dateUpdated":"2024-06-13T17:14:36+0000","additionalFields":{"descriptionSummary":"The Castilla-La Mancha Regional Government (Castilla-La Mancha), which oversees Spain’s third largest region, wanted to drive economic development for its 2 million-plus residents in an inclusive and sustainable way. To achieve its goal, it built a digital twin of the entire region—which covers roughly 79,000 square kilometers (30,502 square miles)—to predict the outcomes of policies on the economy, tourism, healthcare, wildfires, and other areas.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/AWS_Castilla-La-Mancha_Logo-pos_20_10_2023.f6e7f6acf69e7279173f4691186d15f94e05cd20.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/AWS_Castilla-La-Mancha_Logo-pos_20_10_2023.f6e7f6acf69e7279173f4691186d15f94e05cd20.png","displayLocation":"Europe","customerNameLower":"castilla la mancha","footerInfoText":"Published Date","industry":"General Public Services","headlineUrl":"https://aws.amazon.com/solutions/case-studies/castilla-la-mancha-sustainability/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Castilla la Mancha","enableShare":"1","publishedDate":"2023","headline":"Castilla-La Mancha Drives Spain’s Bid for Sustainable Progress with Digital Twin on AWS","contentType":"Customer Story"}},"tags":[{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description