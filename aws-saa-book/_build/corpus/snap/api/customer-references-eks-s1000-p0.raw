hat point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#midway","locale":"en_US","directoryId":"customer-references","name":"midway","dateCreated":"2023-06-01T23:08:20+0000","dateUpdated":"2023-06-08T04:07:43+0000","additionalFields":{"descriptionSummary":"Em 2018, a Midway iniciou sua jornada para tornar-se um banco digital. Esse processo contou com a infraestrutura da AWS, que hoje hospeda 100% das operações do banco.","imageSrcUrl":"https://d1.awsstatic.com/industry-images-customer-references/Midway_LOGO_v2.05e14dd9920963bf270ee3967b8d9661f89e597a.jpg","displayLocation":"Brasil","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2021-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/midway/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"História do cliente","customer-name":"Midway","headline":"Midway lança banco digital com infraestrutura 100% AWS"}},"tags":[{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business 