Updated":"2023-07-14T01:14:12+0000"}]},{"item":{"id":"customer-references#delivery-hero","locale":"en_US","directoryId":"customer-references","name":"delivery-hero","dateCreated":"2023-09-06T22:56:11+0000","dateUpdated":"2023-09-07T23:50:16+0000","additionalFields":{"descriptionSummary":"Amazon Elastic Kubernetes Service (Amazon EKS) is Delivery Hero’s primary choice for orchestrating its containerized microservices architecture. The company chose Amazon EKS because it is a managed service, so Delivery Hero can delegate infrastructure concerns to AWS and focus instead on development.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/deliveryhero-logo%402x.38caeae76f51b2ee2ec5c5de92b8863fa8ce7be1.png","displayLocation":"DACH","customerNameLower":"delivery hero","footerInfoText":"Published Date","industry":"Hospitality","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/delivery-hero/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Delivery Hero","publishedDate":"2019","enableShare":"1","headline":"Delivery Hero Saves 70% Running Kubernetes on Amazon EC2 Spot Instances","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#containers","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Containers","description":"Containers","dateCreated":"2020-02-13T00:27:17+0000","dateUpdated":"2022-02-03T03:35:26+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"GLOBAL#location#dach","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"DACH","description":"DACH","dateCreated":"2020-02-03T05:29:52+0000","dateUpdated":"2022-02-03T03:31:47+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#product#ec2-spot-instances","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Spot Instances","description":"Amazon EC2 Spot Instances","dateCreated":"2022-04-26T06:27:16+0000","dateUpdated":"2022-04-26T06:27:16+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-01-16T17:43:13+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#innovator#delivery-hero","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Delivery Hero","description":"\u003cp\u003eInnovator introduced in 2023.\u003c/p\u003e\n","dateCreated":"2023-08-10T19:02:56+0000","dateUpdated":"2023-08-10T19:02:56+0000"},{"id":"customer-references#customer-segment#digital-native","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Digital Native Business","description":"\u003cp\u003e.\u003c/p\u003e\n","dateCreated":"2023-08-31T21:29:41+0000","dateUpdated":"2023-08-31T21:29:41+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#aerobotics-case-study","locale":"en_US","directoryId":"customer-references","name":"aerobotics-case-study","dateCreated":"2020-11-09T18:03:24+0000","dateUpdated":"2021-12-23T00:55:33+0000","additionalFields":{"featured":"0","descriptionSummary":"Aerobotics was founded in Cape Town, South Africa, in 2014 to help tree-crop farmers solve their pest and disease problems. The company uses machine learning to analyze imagery from drone and satellite photography, allowing farmers to understand the condition of individual trees. Monitoring every tree for pests and diseases on a 50-hectare farm would previously take a farmer an entire day. Aerobotics has reduced this to 20 minutes with drone technology. In this video, Aerobotics Chief Executive Officer James Paterson explains why the firm chose Amazon Web Services (AWS). Built on the AWS Cloud, its product can process large amounts of data and still work reliably for thousands of farmers in remote rural areas. The company runs an auto-scaling microservices architecture with Amazon Elastic Kubernetes Service (Amazon EKS) and serves data to customers using Amazon CloudFront. Its continuous integration and deployment pipelines allow software developers and data scientists to work independently in containerized environments.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Aerobotics_Customer-References_Logo@1x.160065e8a508988e70b8eac2576a2ea3967757b5.png","displayLocation":"South Africa","footerInfoText":"Published Date","industry":"Agriculture","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/aerobotics-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Aerobotics","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Aerobotics Tackles Tree Pests with Machine Learning"}},"tags":[{"id":"GLOBAL#location#middle-east-africa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East \u0026 Africa","description":"Middle East \u0026 Africa","dateCreated":"2020-02-03T05:30:19+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL