ireless carrier in Japan, NTT DOCOMO provides services to more than 80 million subscribers. NTT DOCOMO builds on Amazon Web Services (AWS) so that it can deliver more value to customers through innovative, feature-rich services. From serverless technology and data solutions to high-performance compute, the company is increasing the speed and quality of analysis, driving efficiency and cost-effectiveness, and continually improving customer experiences.","featureImageURL":"https://d1.awsstatic.com/NTT-DOCOMO-innovator-tile_300x200.2234f7fc738dffc318106e32c709bbffd8648637.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/logos/200x100_logos/200x100_NTT-DOCOMO_Logo.ac7f6c8181316f06771a87e584a04402b558f8f3.png","displayLocation":"Japan","customerNameLower":"ntt docomo","footerInfoText":"Published Date","description":"\u003cp\u003eDriving efficiency, cost-effectiveness, and improving customer experiences in telecommunications\u003c/p\u003e\n","industry":"Telecommunications","sortDate":"2024-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/innovators/ntt-docomo/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"NTT Docomo","publishedDate":"2024","enableShare":"1","headline":"NTT DOCOMO, Inc. on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#customer