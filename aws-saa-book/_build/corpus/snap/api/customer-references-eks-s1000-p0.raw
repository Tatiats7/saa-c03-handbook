ltiple cloud providers and could deploy platform updates to only 10 of its 350 customers at a time. Using Amazon EKS and Fargate, ZIWO can now deliver updates 50 times faster and reduced its infrastructure costs by 30 percent.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/ziwo-logo%401x.044bf03b6bbab4723e5ad1bd167a755b3d4e3f50.png","displayLocation":"India","customerNameLower":"ziwo","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2023-09-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ziwo/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ZIWO","publishedDate":"2023","enableShare":"1","headline":"ZIWO Delivers Product Updates 50x Faster and Cuts Costs Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#systems-mgr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Systems Manager","description":"AWS Systems Manager","dateCreated":"2020-03-02T07:05:44+0000","dateUpdated":"2022-02-03T03:33:03+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2023-07-15T01:16:11+0000"},{"id":"GLOBAL#content-type#