reassurance of meeting data regulations—from Europe to the US to China—using AWS services and resources to protect data and privacy.","featured":"0","featureImageURL":"https://d1.awsstatic.com/customer-references-case-studies-logos/ASSET_Spryker_345x230.30884cc9e5b0f4844d9c8b4ad8859c225a4349f8.jpg","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/spryker-logo%401x.ae275e9934d670eada191dc8784d3f07fe402a64.png","displayLocation":"Germany","customerNameLower":"spryker","footerInfoText":"Published Date","description":"\u003cp\u003eScaling and innovating in the cloud to focus on developing new services for enterprise customers.\u003c/p\u003e\n","industry":"Software \u0026 Internet","sortDate":"2024-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/innovators/spryker/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Spryker","publishedDate":"2024","enableShare":"1","headline":"Spryker on AWS","contentType":"Customer Story"}},"tags":[{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","n