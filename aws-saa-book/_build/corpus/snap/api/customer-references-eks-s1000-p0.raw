"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"customer-references#industry#hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"hospitality","description":"Hospitality","dateCreated":"2020-03-23T20:15:24+0000","dateUpdated":"2021-01-26T00:37:15+0000"},{"id":"customer-references#industry#travel","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel","description":"Travel","dateCreated":"2020-05-29T23:12:09+0000","dateUpdated":"2021-02-09T21:53:22+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#adidas-innovator","locale":"en_US","directoryId":"customer-references","name":"adidas-innovator-de","dateCreated":"2024-06-28T07:22:55+0000","dateUpdated":"2024-09-20T20:36:23+0000","additionalFields":{"descriptionSummary":"Adidas, der größte Sportartikelhersteller Europas und eine milliardenschwere Marke, ist mit seinem Drei-Streifen-Logo auf der ganzen Welt bekannt. Das 1949 gegründete Unternehmen wird von der Überzeugung getragen, dass Sport das Leben verändern kann. Heute möchte das Unternehmen eine digitale Grundlage schaffen, um die Flexibilität zu erhöhen und den Adidas-Kunden erstklassige Produkte und Erlebnisse bieten zu können. Mithilfe von Amazon Web Services (AWS) beschleunigt der Hersteller und Händler von Sportbekleidung die unternehmensweite Transformation. Der Konzern entwickelt und implementiert Anwendungen 40-mal schneller, optimiert die Geschäftsabläufe durch die Automatisierung der Unternehmensressourcenplanung (ERP) mit AWS für SAP und lässt Innovationen bei seiner Fitness-Tracking-Tochter Runtastic zum Alltag werden.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/executive-insights/logo-adidas-200x100.060c98680530efce6a269cd0d3ba7b28ca5035bf.jpg","displayLocation":"Deutschland","customerNameLower":"adidas","footerInfoText":"0","industry":"Fertigung","sortDate":"2024-01-01","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/innovators/adidas/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"adidas","publishedDate":"2024","enableShare":"1","headline":"Adidas in AWS","contentType":"Kundengeschichte"}},"tags":[{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#germany","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Germany","description":"Germany","dateCreated":"2020-02-03T05:29:55+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US",