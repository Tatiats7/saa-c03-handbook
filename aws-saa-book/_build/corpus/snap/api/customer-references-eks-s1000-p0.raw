scription":"Oil \u0026 Gas","dateCreated":"2020-01-16T17:42:36+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"customer-references#big-rocks#aws-for-data","locale":"en_US","tagNamespaceId":"customer-references#big-rocks","name":"AWS for Data","description":"\u003cp\u003eAWS for Data is a marketing \u0026ldquo;Big Rock\u0026rdquo; initiative that tells the story around how AWS can provide the most comprehensive set of data capabilities spanning databases, analytics, business intelligence, and machine learning for an end-to-end data strategy.\u003c/p\u003e\n","dateCreated":"2024-02-14T22:32:15+0000","dateUpdated":"2024-02-14T22:32:15+0000"}]},{"item":{"id":"customer-references#west-java","locale":"en_US","directoryId":"customer-references","name":"west-java","dateCreated":"2022-01-08T04:33:38+0000","dateUpdated":"2022-01-21T02:44:43+0000","additionalFields":{"descriptionSummary":"By building cloud-native apps on AWS, West Java Provincial Government has reduced its development time from 2–3 months to 16 days and benefits from a pay-as-you-go cloud model. West Java is the most populous province in Indonesia, and its government is committed to improving public services through technology. The government is using Amazon EKS to speed up deployment of containers, Amazon CloudFront to deliver content, and Amazon SQS to avoid app bottlenecks.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/West_Java_logo%401x.b346cbf993072d15b5b8832fc5ff633c4ecab431.png","displayLocation":"Indonesia","footerInfoText":"Published Date","industry":"General Public Services","sortDate":"2022-01-07","headlineUrl":"https://aws.amazon.com/solutions/case-studies/west-java/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"West Java Bridges Urban and Rural Digital Gap with Apps Built on AWS","customer-name":"West Java Provincial Government"}},"tags":[{"id":"customer-references#catego