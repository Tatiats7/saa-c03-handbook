ont-office and back-office tools, to help financial institutions digitize their wealth management offerings. Priv\u0026eacute; Technologies uses Amazon Elastic Kubernetes Service to orchestrate containers and Amazon Managed Streaming for Apache Kafka for real-time data streaming.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/prive-logo%401x.4e911d1baa2d47294d0266766f3ac7950317d661.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2021-08-20","headlineUrl":"https://aws.amazon.com/solutions/case-studies/prive/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Privé Technologies","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Privé Technologies Uses AWS to Go Global While Innovating 50% Faster"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T