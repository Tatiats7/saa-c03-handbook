 Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#pinpoint","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Pinpoint","description":"Amazon Pinpoint","dateCreated":"2020-03-02T07:04:51+0000","dateUpdated":"2022-02-03T03:32:54+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"}]},{"item":{"id":"customer-references#thuga-syneco-case-study","locale":"en_US","directoryId":"customer-references","name":"thuga-syneco-case-study","dateCreated":"2024-08-13T14:55:16+0000","dateUpdated":"2024-08-13T14:59:18+0000","additionalFields":{"descriptionSummary":"Syneco Trading GmbH, a subsidiary of the Thüga Group and eins energie in sachsen GmbH \u0026 Co. KG, provides municipal utilities with digital services for every stage of the energy sales and procurement process. Syneco has evolved from an energy-trading house to a software-as-a-service (“SaaS”) provider. Syneco’s customer portal, Synection, is based on a cloud-native application that runs on AWS infrastructure, which further improves Syneco\u0027s ability to innovate. Thanks to the new services offered under Syneco’s customer portal, municipal utilities can offer their customers better energy prices, procure energy efficiently, and manage risks transparently.","featureImageURL":"https://d1.awsstatic.com/emea-customer-references/emea-directory-customer-logos/Syneco-Customer-References-Logo%401x.2a61589bce2f388510c194c80f774e7693f119db.png","imageSrcUrl":"https://d1.awsstatic.com/emea-customer-references/emea-directory-customer-logos/Syneco-Customer-References-Logo%401x.2a61589bce2f388510c194c80f774e7693f119db.png","displayLocation":"Germany","customerNameLower":"thüga ag","footerInfoText":"Published Date","industry":"General Public Services","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/thuga-syneco-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Thüga AG","publishedDate":"2023","enableShare":"1","headline":"Syneco Provides Energy Sales and Procurement Services Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#dach","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"DACH","description":"DACH","dateCreated":"2020-02-03T05:29:52+0000","dateUpdated":"2022-02-03T03:31:47+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Ente