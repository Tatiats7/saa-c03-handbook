2:01:31+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#intraway","locale":"en_US","directoryId":"customer-references","name":"intraway","dateCreated":"2023-05-11T00:15:05+0000","dateUpdated":"2023-06-08T04:07:44+0000","additionalFields":{"descriptionSummary":"Intraway es una empresa que genera sistemas de software OSS de automatización no-code basados en la nube para proveedores de servicios de telecomunicaciones. Apoya los servicios de sobre 40 millones de suscriptores en más de 20 países en tres continentes. Posee oficinas en Argentina, Colombia, México, Perú, Uruguay y Estados Unidos. La compañía implementó para desarrollar un producto multirregión con gran capacidad de recovery y que le permiriera redesplegar las soluciones en la región. Toda la implementación le permite a Intraway tener mayor agilidad y rendimiento, mejor disponibilidad; además de mayor elasticidad e innovación, así como un incremento en la calidad del servicio.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/industry-images-customer-references/Intraway_Logo.fc35f2a90189cd08095af13aeb9a0a352816d130.png","displayLocation":"Argentina","customerNameLower":"intraway","footerInfoText":"Fecha de publicación","industry":"Telecomunicaciones","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/intraway/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Intraway","publishedDate":"2021","enableShare":"1","headline":"Intraway crea un producto de misión crítica multirregión y resiliente en su operación con soluciones AWS","contentType":"Historia del cliente"}},"tags":[{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#industry#telecommunications","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Telecommunications","description":"Telecommunications","dateCreated":"2020-01-16T17:42:41+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#ecr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Registry (ECR)","description":"Amazon Elastic Container Registry (ECR)","dateCreated":"2020-03-02T07:02:55+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#containers","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Containers","description":"Containers","dateCreated":"2020-02-13T00:27:17+0000","dateUpdated":"2022-02-03T03:35:26+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"customer-r