":"customer-references","name":"skyalert-en-from-es-directory","dateCreated":"2024-02-03T03:47:58+0000","dateUpdated":"2024-02-06T01:35:37+0000","additionalFields":{"descriptionSummary":"SkyAlert is an innovative technology company that quickly alerts millions of people living in earthquake-prone areas, promoting a culture of prevention against natural disasters. In order to provide customers—both businesses and individuals—with the right tools to protect them during earthquakes, SkyAlert migrated its infrastructure from Microsoft Azure to Amazon Web Services (AWS). After implementing its Internet of Things (IoT) solution to run on AWS and its efficient alert service, SkyAlert scales quickly and can send millions of messages in a few seconds, helping to save lives in the event of earthquakes.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/skyalert_logo%401x.27b39f5ae8919cd5eac26ac7e8af6df26e3df29d.png","displayLocation":"Mexico","customerNameLower":"skyalert","footerInfoText":"Published Date","industry":"Manufacturing","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/skyalert/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"SkyAlert","enableShare":"1","publishedDate":"2023","contentType":"Customer Story","headline":"SkyAlert Helps Save Lives from Natural Disasters Using AWS Solutions"}},"tags":[{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Internet of Things (IoT)","description":"Internet of Things (IoT)","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2023-08-22T20:28:39+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"