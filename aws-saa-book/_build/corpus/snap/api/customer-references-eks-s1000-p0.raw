0-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#location#middle-east","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East","description":"Middle East","dateCreated":"2020-04-09T03:53:16+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"}]},{"item":{"id":"customer-references#trading-point-group-testimonial-video","locale":"en_US","directoryId":"customer-references","name":"trading-point-group-testimonial-video","dateCreated":"2023-05-11T00:14:57+0000","dateUpdated":"2024-02-20T22:25:52+0000","additionalFields":{"descriptionSummary":"With the majority of their IT infrastructure running on AWS, Trading Point has the flexibility for expansion and scale to handle large amounts of traffic when needed. Trading Point is an award-winning financial services provider offering brokerage products to meet the needs of modern traders. Amazon Elastic Kubernetes Service (Amazon EKS) is the core for deploying services, Amazon Redshift forms part of the data analytics toolset, and Amazon Relational Database Service (Amazon RDS) is the natural choice for storing relational data. In this video Chrysanthos Kattimeris also highlights the benefits of AWS Enterprise Support.","imageSrcUrl":"https://d1.awsstatic.com/emea-customer-references/emea-directory-customer-logos/Trading-Point-Customer-References-Logo%401x.c235e89d873296455147baba3f9d9dbcaeec62ef.png","displayLocation":"Cyprus","customerNameLower":"trading point group","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2023-04-19","headlineUrl":"https://aws.amazon.com/solutions/case-studies/trading-point-group-testimonial-video/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Trading Point Group","publishedDate":"2023","enableShare":"1","headline":"Trading Point Group Scales Rapidly with AWS Enterprise Support","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#containers","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Containers","description":"Containers","dateCreated":"2020-02-13T00:27:17+0000","dateUpdated":"2022-02-03T03:35:26+0000"},{"id":"GLOBAL#location#cyprus","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Cyprus","description":"Cyprus","dateCreated":"2020-04-09T03:36:37+0000","dateUpdated":"2022-02-03T03:31:47+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"}]},{"item":{"id":"customer-references#tiime","locale":"en_US","directoryId":"customer-references","name":"tiime","dateCreated":"2023-06-01T23:05:12+0000","dateUpdated":"2023-07-18T00:18:10+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eLa vie d\u0026rsquo;une soci\u0026eacute;t\u0026eacute; est faite de multiples op\u0026eacute;rations de gestion qui peuvent \u0026ecirc;tre complexes et chronophages \u0026agrave; g\u0026eacute;rer. L\u0026rsquo;\u0026eacute;diteur Tiime propose une suite d\u0026rsquo;outils en mode SaaS \u0026agrave; destination des entrepreneurs et des cabinets d\u0026rsquo;expertise comptable qui simplifient toute la cha\u0026icirc;ne comptable d\u0026rsquo;une entreprise, de la cr\u0026eacute;ation de la soci\u0026eacute;t\u0026eacute; au bilan annuel en passant par la facturation, la gestion des frais professionnels ou du compte professionnel. En s\u0026rsquo;appuyant sur le cloud AWS, Tiime acc\u0026egrave;de \u0026agrave; une infrastructure qui lui permet de garantir la s\u0026eacute;curit\u0026eacute; des donn\u0026eacute;es et la disponibilit\u0026eacute; du service, mais \u0026eacute;galement de d\u0026eacute;velopper pour ses clients des fonctions \u0026agrave; haute valeur ajout\u0026eacute;e gr\u0026acirc;ce \u0026agrave; l\u0026rsquo;utilisation de technologies innovantes comme le machine learning.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/tiime%20-%20logo.9ad780852522b82ee447ebdf24dfd6ac0b4524e1.png","displayLocation":"France","customerNameLower":"tiime","footerInfoText":"Date de publication","industry":"Logiciels et Internet","sortDate":"2023-04-12","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/tiime/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Tiime","enableShare":"1","publishedDate":"2023","contentType":"Témoignages clients","headline":"Comment Tiime veut réinventer la comptabilité des entreprises avec AWS"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#language#french","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"French","description":"French","dateCreated":"2020-03-03T06:40:44+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#france","locale":