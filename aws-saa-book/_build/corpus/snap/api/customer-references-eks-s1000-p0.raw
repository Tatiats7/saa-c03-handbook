022-05-23T21:40:03+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#multicloud","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Multicloud","description":"\u003cp\u003eMulticloud is when an organization uses cloud computing services from at least two cloud providers to run their applications.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:18:31+0000","dateUpdated":"2023-07-14T01:18:31+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"customer-references#category#data-protection","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Data Protection","description":"\u003cp\u003eData protection is the process of protecting sensitive information from damage, loss, or corruption.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:07:32+0000","dateUpdated":"2023-07-14T01:07:32+0000"},{"id":"customer-references#category#cloud-operations","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cloud Operations","description":"\u003cp\u003eAWS Cloud Operations provides a model and tools for a secure and efficient way to operate in the cloud. This is an initiative, not a product.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:05:06+0000","dateUpdated":"2023-07-14T01:05:06+0000"},{"id":"customer-references#category#gen-ai","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gen AI","description":"\u003cp\u003eGenerative Artificial Intelligence\u003c/p\u003e\n","dateCreated":"2023-07-10T17:07:31+0000","dateUpdated":"2023-07-10T17:07:31+0000"}]},{"item":{"id":"customer-references#spryker-innovator","locale":"en_US","directoryId":"customer-references","name":"spryker-innovator-de","dateCreated":"2024-06-28T07:22:51+0000","dateUpdated":"2024-09-20T20:36:23+0000","additionalFields":{"descriptionSummary":"In weniger als einem Jahrzehnt hat sich Spryker vom Tech-Startup zu einem 600 Mitarbeiter starken Unternehmen mit Niederlassungen auf der ganzen Welt entwickelt. Als führendes Unternehmen im Bereich Enterprise-Commerce-Software nutzt das Unternehmen AWS, um seinen über 150 Geschäftskunden zusammensetzbare Lösungen anzubieten, die ihnen helfen, Kundeninteraktionen zu maximieren und den Umsatz zu steigern. Dank der Flexibilität, in der Cloud zu skalieren und innovativ zu sein, kann sich Spryker darauf konzentrieren, neue Services zu entwickeln und mehr Unternehmenskunden an Bord zu holen. Es gibt Kunden die Gewissheit, dass sie die Datenschutzvorschriften – von Europa über die USA bis China – einhalten und die AWS-Services und -Ressourcen zum Datenschutz nutzen.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/spryker-logo%401x.ae275e9934d670eada191dc8784d3f07fe402a64.png","displayLocation":"Deutschland","customerNameLower":"spryker","footerInfoText":"0","industry":"Software und Internet","sortDate":"2024-01-01","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/innovators/spryker/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Spryker","publishedDate":"2024","enableShare":"1","headline":"Spryker in AWS","contentType":"Kundengeschichte"}},"tags":[{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#germany","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Germany","description":"Germany","dateCreated":"2020-02-03T05:29:55+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#dach","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"DACH","description":"DACH","dateCreated":"2020-02-03T05:29:52+0000","dateUpdated":"2022-02-03T03:31:47+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-