nsights gathered from consumers in Southeast Asia, Latin America, and the Middle East. The company uses Amazon OpenSearch Service for querying, Amazon EKS for Kubernetes orchestration, and Amazon S3 for secure data transfers and storage.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/measureable-ai-logo%401x.8ea5880d668f007681f7996446b4be8899e8b9c7.png","displayLocation":"Hong Kong","customerNameLower":"measurable ai","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-08-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/measurable-ai-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Measurable AI","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Measurable AI Empowers Businesses with Faster Insights from Alternative Data on AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000