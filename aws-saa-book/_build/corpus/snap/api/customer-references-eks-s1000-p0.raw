se","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#tech-category#cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-01-16T17:43:13+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"}]},{"item":{"id":"customer-references#broadpeak","locale":"en_US","directoryId":"customer-references","name":"broadpeak","dateCreated":"2024-04-16T00:04:12+0000","dateUpdated":"2024-04-16T00:06:38+0000","additionalFields":{"descriptionSummary":"Broadpeak est un fournisseur de technologie de streaming vidéo qui a développé une offre SaaS pour répondre à deux défis : élargir l\u0027offre à du SaaS et proposer une expérience de streaming individualisée mondialement. Pour cela, broadpeak.io a été crée sur AWS, une plateforme SaaS qui personnalise l\u0027expérience streaming par utilisateur. AWS a été choisi pour sa scalabilité technologique, son programme d\u0027accompagnement AWS SaaS Factory qui a accéléré le déploiement de 6 mois, et son expertise média.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/broadpeak-io-logo%401x.438642081a03526182d0bb5a855df00199949449.png","displayLocation":"France","customerNameLower":"broadpeak","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2024-03-18","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/broadpeak/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Broadpeak","publishedDate":"2024","enableShare":"1","headline":"Témoignage de Broadpeak : Construire son offre SaaS sur AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#containers","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Containers","description":"Containers","dateCr