L#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notification Service (SNS)","dateCreated":"2020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"}]},{"item":{"id":"customer-references#c6-bank","locale":"en_US","directoryId":"customer-references","name":"c6-bank","dateCreated":"2023-06-01T23:09:49+0000","dateUpdated":"2023-06-08T04:07:40+0000","additionalFields":{"descriptionSummary":"Lançado no segundo semestre de 2019, o C6 Bank chegou ao mercado se posicionando como um banco completo de varejo 100% digital. A instituição conta hoje com mais de 10 milhões de clientes e oferece uma série de serviços, que vão de conta corrente internacional a plataforma de investimentos. Acompanhar esse crescimento exigiu uma estrutura de TI ágil e escalável, com estrutura em nuvem na AWS.","imageSrcUrl":"https://d1.awsstatic.com/industry-images-customer-references/C6_Bank_LOGO_NEW.b3400b1f27ed7d0640dfecf777534dd6a3ce9782.png","displayLocation":"Brasil","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2021-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/c6-bank/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"História do cliente","customer-name":"C6 Bank","headline":"Com mais de 10 milhões de clientes, C6 Bank usa AWS como nuvem preferencial"}},"tags":[{"id":"customer-references#category#business-applications-microsoft","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: Microsoft","description":"Business Applications: Microsoft","dateCreated":"2019-07-22T18:31:11+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32: