ry#oil-gas","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Oil \u0026 Gas","description":"Oil \u0026 Gas","dateCreated":"2020-01-16T17:42:36+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#industry#energy","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Energy","description":"Energy","dateCreated":"2020-07-15T21:58:51+0000","dateUpdated":"2022-02-03T03:32:02+0000"}]},{"item":{"id":"customer-references#chainstack-case-study","locale":"en_US","directoryId":"customer-references","name":"chainstack-case-study","dateCreated":"2022-06-07T17:22:51+0000","dateUpdated":"2022-06-07T17:31:06+0000","additionalFields":{"descriptionSummary":"Chainstack relies on AWS to give Web3 developers a reliable and scalable application platform, grow revenue by 50 times within a year, deliver flexibility to support all blockchain protocols, and cut costs. The company offers managed blockchain services designed to ease Web3 development across the globe.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/chainstack_logo%401x.c9aa5351231f404a61e4b64b2e62929c1ea60a96.png","displayLocation":"Singapore","customerNameLower":"chainstack","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-06-07","headlineUrl":"https://aws.amazon.com/solutions/case-studies/chainstack-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Chainstack","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Chainstack Leverages AWS to Help Thousands of Web3 Developers Reliably Scale Blockchain Applications"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","desc