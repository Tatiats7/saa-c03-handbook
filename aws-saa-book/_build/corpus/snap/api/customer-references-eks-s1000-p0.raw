scribers as of March 31, 2022. To improve its response to spikes in customer demand and provide customer-centric experiences, Tata Play modernized its billing, customer portal, and big data applications on AWS.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Tata_play_logo%401x.47a1ba4819a61f0f0d8df1e47a1b6683de4c5764.png","displayLocation":"India","customerNameLower":"tata play ltd","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/tataplay-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Tata Play Ltd","publishedDate":"2023","enableShare":"1","headline":"Tata Play Offers an Omnichannel Customer Experience Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#content-type#customer-story","loca