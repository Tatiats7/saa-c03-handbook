prise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#deutsche-boerse-group","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Deutsche Boerse Group","description":"Deutsche Boerse Group","dateCreated":"2022-09-15T00:48:26+0000","dateUpdated":"2022-09-15T00:48:26+0000"}]},{"item":{"id":"customer-references#naranjax","locale":"en_US","directoryId":"customer-references","name":"naranjax","dateCreated":"2023-06-01T23:04:58+0000","dateUpdated":"2023-06-08T04:07:42+0000","additionalFields":{"descriptionSummary":"Naranja X es una fintech argentina, siendo la tarjeta de crédito más elegida del país. La empresa se convirtió en una plataforma de acceso a productos y servicios financieros, y quiere dar oportunidades a millones de personas que quedan afuera del sistema financiero tradicional. Sus productos digitales son 100% cloud native, con infraestructura full AWS Cloud, con más de 140 cuentas, 100+ contenedores en Amazon EKS, más de 500 instancias de procesamiento en Amazon EC2, aproximadamente 7 mil funciones AWS Lambda y con más de 1500 tablas en Amazon DynamoDB.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/naranja%401x.7cce20e478e90794ffb1b89ea341085e591b9894.jpg","displayLocation":"Argentina","customerNameLower":"naranja x","footerInfoText":"Fecha de publicación","industry":"Servicios financieros","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/naranjax/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Naranja X","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"AWS se convierte en un acelerador del time to market en Naranja X"}},"tags":[{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#argentina","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Argentina","description":"Argentina","dateCreated":"2020-06-12T23:30:42+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"}]},{"item":{"id":"customer-references#banco-inter-awsmarketplace","locale":"en_US","directoryId":"customer-references","name":"banco-inter-awsmarketplace","dateCreated":"2021-11-06T04:55:42+0000","dateUpdated":"2023-06-08T04:07:45+0000","additionalFields":{"descriptionSummary":"A fintech Banco Inter S.A. (Inter) precisava avaliar sua pilha de tecnologia para atender às demandas de consumo após expandir sua base de clientes de 400 mil para 15 milhões de clientes em apenas 3 anos. Para concretizar isso, a empresa precisava agregar e avaliar dados em tempo real para conseguir lançar mais produtos e serviços, além de aprimorar a satisfação do cliente. Com base na solidez dos resultados anteriores, o Inter recorreu à Amazon Web Services (AWS) para ajustar cada detalhe de seu aplicativo e avaliar sua pilha de tecnologia. O Inter conseguiu ampliar sua visibilidade usando o software disponível no AWS Marketplace, um catálogo digital com milhares de ofertas de fornecedores independentes de software que deixam mais simples encontrar, testar, comprar e implantar software executado na AWS.","imageSrcUrl":"https://d1.awsstatic.com/banco%20inter%20600x400.58949e9f03b716448bac1229b382e32534cd700c.png","displayLocation":"Brasil","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/Banco-Inter-AWSMarketplace/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","customer-name":"Banco Inter","contentType":"História do cliente","headline":"Inter expande serviços de fintech e atende a 15 milhões de clientes na AWS"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"202