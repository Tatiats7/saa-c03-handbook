vice (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#use-case#remote-work-learning","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Remote Work \u0026 Learning","description":"Remote Work \u0026 Learning","dateCreated":"2020-08-20T04:26:30+0000","dateUpdated":"2022-02-03T03:35:55+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#cleo-one-case-study","locale":"en_US","directoryId":"customer-references","name":"cleo-one-case-study","dateCreated":"2021-09-18T02:19:42+0000","dateUpdated":"2023-07-14T23:32:36+0000","additionalFields":{"descriptionSummary":"Cleo One reduced developer infrastructure by 66 percent and saved over 40 percent on costs by migrating to Amazon Web Services (AWS). Cleo One is a financial technology provider that makes complex and fragmented trading tools available to everyone.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/cleo-one-logo%401x.9ea0465ac79b575583c7735c13987e07effb4d2e.jpg","displayLocation":"Europe, Middle East, \u0026 Africa","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/cleo-one-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Cleo One","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Cleo One Video Testimonial"}},"tags":[{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#documentdb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DocumentDB","description":"Amazon DocumentDB","dateCreated":"2020-03-02T07:02:46+0000","dateUpdated":"2022-02-03T03:32:30+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#