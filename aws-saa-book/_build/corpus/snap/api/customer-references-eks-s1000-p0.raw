ision-making.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Circle_of_life%401x.2edd90813de8e02bd4726c153185c0c9fcea4318.png","displayLocation":"India","customerNameLower":"circle of life","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2022-09-06","headlineUrl":"https://aws.amazon.com/solutions/case-studies/circle-of-life/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Circle of Life","publishedDate":"2022","enableShare":"1","headline":"Circle of Life Migrates Mission-Critical Healthcare App to AWS to Eliminate Downtime","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"customer-references#category#business-applications-ec2-windows-server","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: EC2 Windows Server","description":"Business Applications: EC2 Windows Server","dateCreated":"2019-07-22T18:31:09+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#business-applications-microsoft","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: Microsoft","description":"Business Applications: Microsoft","dateCreated":"2019-07-22T18:31:11+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US",