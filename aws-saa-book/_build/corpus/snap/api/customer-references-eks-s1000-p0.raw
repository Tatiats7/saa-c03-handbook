aceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#mcredit-case-study","locale":"en_US","directoryId":"customer-references","name":"mcredit-case-study","dateCreated":"2021-09-11T00:48:09+0000","dateUpdated":"2022-12-19T23:24:29+0000","additionalFields":{"descriptionSummary":"Mcredit migrated from an on-premises infrastructure to AWS to gain agility and boost automation as part of a renewed digital strategy, lowering its time to market from four months to three weeks. The FinTech firm is a joint venture between Vietnam-based Military Bank and Japan-based Shinsei Bank. The company is using Amazon EKS to orchestrate its fully containerized infrastructure, Amazon Redshift as a data warehouse, and Amazon Direct Connect for secure networking.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Mcredit_logo%401x.d13bb24e8cc3f8572c54bbed0b92a679966e2fb5.png","displayLocation":"Vietnam","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2021-09-10","headlineUrl":"https://aws.amazon.com/solutions/case-studies/mcredit-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Mcredit","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Mcredit Offers an Omnichannel Banking Experience with Data-Driven Transformation on AWS"}},"tags":[{"id":"customer-references#category#finserv","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Financial Services","description":"Financial Services","dateCreated":"2019-07-22T18:31:53+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated