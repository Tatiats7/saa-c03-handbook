ion to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"customer-references#big-rocks#aws-for-data","locale":"en_US","tagNamespaceId":"customer-references#big-rocks","name":"AWS for Data","description":"\u003cp\u003eAWS for Data is a marketing \u0026ldquo;Big Rock\u0026rdquo; initiative that tells the story around how AWS can provide the most comprehensive set of data capabilities spanning databases, analytics, business intelligence, and machine learning for an end-to-end data strategy.\u003c/p\u003e\n","dateCreated":"2024-02-14T22:32:15+0000","dateUpdated":"2024-02-14T22:32:15+0000"}]},{"item":{"id":"customer-references#meity-gov-india-case-study","locale":"en_US","directoryId":"customer-references","name":"meity-gov-india-case-study","dateCreated":"2022-09-22T02:54:55+0000","dateUpdated":"2022-09-22T07:07:45+0000","additionalFields":{"descriptionSummary":"India’s Ministry of Health and Family Welfare engaged the Ministry of Electronics and Information Technology to launch a countrywide scalable, resilient COVID-19 management portal powered by AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/meity-government-india-logo%401x.a1b914028d57d58aeedcd7fd745389c59bcec4e0.png","displayLocation":"India","customerNameLower":"ministry of electronics and information technology","footerInfoText":"Published Date","industry":"General Public Services","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/meity-gov-india-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ministry of Electronics and Information Technolog