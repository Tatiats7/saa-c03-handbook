scription":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#location#australia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia","description":"Australia","dateCreated":"2020-02-03T05:29:12+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#location#anz","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia \u0026 New Zealand","description":"Australia \u0026 New Zealand","dateCreated":"2020-04-09T00:26:11+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#too-good-to-go-case-study","locale":"en_US","directoryId":"customer-references","name":"too-good-to-go-case-study","dateCreated":"2024-02-17T00:42:31+0000","dateUpdated":"2024-08-13T14:59:19+0000","additionalFields":{"descriptionSummary":"Every year, around $1 trillion worth of edible food gets thrown away, while 828 million people are affected by hunger every day. And by some reports, wasted food represents up to 10 percent of all human-caused greenhouse gas emissions. Too Good To Go seeks to inspire and empower everyone to fight food waste together through a service with which users can save unsold food at their favorite restaurants and stores.","featured":"0","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/too-good-to-go-logo%401x.c3c4e672e354198bc93e7898fe585619d3525831.png","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/too-good-to-go-logo%401x.c3c4e672e354198bc93e7898fe585619d3525831.png","displayLocation":"Denmark","customerNameLower":"too good to go","footerInfoText":"Published Date","industry":"Hospitality","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/too-good-to-go-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Too Good To Go","publishedDate":"2023","enableShare":"1","headline":"Saving 250 Million Meals from Waste Using AWS Managed Services with Too Good To Go","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#location#nordics","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Nordics","description":"Nordics","dateCreated":"2020-02-03T05:30:04+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#location#denmark","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Denmark","description":"Denmark","dateCreated":"2020-02-03T05:30:06+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English",