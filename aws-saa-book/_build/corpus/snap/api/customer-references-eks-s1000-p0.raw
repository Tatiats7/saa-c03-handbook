cale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#games24x7-case-study","locale":"en_US","directoryId":"customer-references","name":"games24x7-case-study","dateCreated":"2021-08-20T23:51:33+0000","dateUpdated":"2023-07-14T23:32:50+0000","additionalFields":{"descriptionSummary":"Games24x7 has saved $1.67 million annually and is able to improve security at scale by working with AWS Enterprise Support as the company expands. Games24x7 is a leading Indian gaming company that offers online skill games such as Rummy. The company has relied on AWS Enterprise Support to help migrate to Amazon EKS, increase adoption of Amazon EC2 Spot Instances, and switch to AWS Graviton2 processors to save costs.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Games24x7_logo%401x.d8802446bd860923f9681cec14db9232ac5e1779.png","displayLocation":"India","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2021-08-20","headlineUrl":"https://aws.amazon.com/solutions/case-studies/games24x7-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"Games24x7","contentType":"Customer Story","headline":"Games24x7 Enhances Security and Scalability Using AWS Enterprise Support"}},"tags":[{"id":"GLOBAL#language#engli