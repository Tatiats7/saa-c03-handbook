ion":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#efs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic File System (EFS)","description":"Amazon Elastic File System (EFS)","dateCreated":"2020-03-02T07:02:57+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#waf","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS WAF","description":"AWS WAF","dateCreated":"2020-03-02T07:06:04+0000","dateUpdated":"2022-02-03T03:33:07+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"}]},{"item":{"id":"customer-references#propertyfinder12222021kjnaefocihadw","locale":"en_US","directoryId":"customer-references","name":"propertyfinder12222021kjnaefocihadw","dateCreated":"2022-05-23T21:43:01+0000","dateUpdated":"2022-05-23T21:53:10+0000","additionalFields":{"descriptionSummary":"Property Finder Group is the leading real estate digital platform in the Middle East with Property Finder UAE (propertyfinder.ae) being the largest real estate platform in the UAE. They offer a wide range of residential and commercial properties for sale and rent. Property Finder are running their entire set of production applications (around 250+) on Amazon EKS with 100% spot instances. They migrated from On-Demand EC2 instance based monolith deployment to a microservices based architecture on Amazon EKS. YoY, they have seen almost a 15% reduction in costs after migrating to EKS. They use a combination of event based architecture with Rabbit MQ, Lambda, EventBridge and EKS with Spot instances.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/property-finder-logo%401x.efb1597c2724f47efaed744e2e830533c5f87623.png","displayLocation":"Europe, Middle East, \u0026 Africa","footerInfoText":"Published Date","industry":"Consumer Packaged Goods (CPG)","sortDate":"2021-12-22","headlineUrl":"https://youtu.be/cnZeOytEkIM?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Property Finder: Running Production Workloads with Amazon EKS on 100% Amazon EC2 Spot Instances","customer-name":"Property Finder"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#uae","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United Arab Emirates","description":"United Arab Emirates","dateCreated":"2020-02-03T05:30:23+0000","dateUpdated":"2022-02-03T03:31:56+0000"},{"id":"GLOBAL#industry#cpg","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Consumer Packaged Goods (CPG)","description":"Consumer Packaged Goods (CPG)","dateCreated":"202