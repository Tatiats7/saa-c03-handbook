S","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#customer-segment#digital-native","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Digital Native Business (DNB)","description":"Digital Native Business (DNB)","dateCreated":"2021-06-04T06:35:39+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#category#business-resilience","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Resilience","description":"\u003cp\u003eIn business, resilience means dealing with adversity and shocks, and continuously adapting for growth.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:01:43+0000","dateUpdated":"2023-07-14T01:01:43+0000"}]},{"item":{"id":"customer-references#kabam-robotics-generative-ai-video","locale":"en_US","directoryId":"customer-references","name":"kabam-robotics-generative-ai-video","dateCreated":"2024-06-07T20:39:57+0000","dateUpdated":"2025-01-24T23:19:14+0000","additionalFields":{"descriptionSummary":"KABAM Robotics created Smart+ – a cloud-based robot management platform which leverages AWS to enhance the intelligence and concierge capabilities of their robots – and REMI – a groundbreaking system equipping their robots with the power of large language models, seamlessly integrated using Amazon Bedrock API, while utilizing services such as Amazon SageMaker, Amazon EKS and Amazon Polly to further enhance the overall functionality of their robots.","featured":"0","featureImageURL":"https://d1.awsstatic.com/customer-references-case-studies-logos/kabam-robotics-innovator-hub.f59843210c0d8ae6aa82325c8c0f2b71f4f26cd3.png","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/kabam-logo%401x.6c3e4a768ca35e8c7650c6b7a8bf3331bbd6ec1d.png","displayLocation":"Singapore","customerNameLower":"kabam robotics","footerInfoText":"Published Date","description":"Kabam Robotics is at the forefront of the service robotics industry, delivering innovative solutions that have a real and positive impact on customers in the commercial security, facility management and hospitality sectors, with their robots deployed across 4 continents. ","industry":"Semiconductors","sortDate":"2024-02-02","headlineUrl":"https://aws.amazon.com/solutions/case-studies/kabam-robotics/","customer-name":"Kabam Robotics","publishedDate":"2024","enableShare":"1","headline":"KABAM Robotics enhances robot intelligence with generative AI on AWS","contentType":"Customer Story"}},"tags":[{"id":"customer-references#category#robotics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Robotics","description":"Robotics","dateCreated":"2019-07-22T18:32:18+0000","dateUpdated":"2022-03-24T02:42:27+0000"},{"id":"GLOBAL#product#bedrock","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Bedrock","description":"Amazon Bedrock","dateCreated":"2023-04-13T19:06:46+0000","dateUpdated":"2023-04-13T19:06:46+0000"},{"id":"GLOBAL#product#polly","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Polly","description":"Amazon Polly","dateCreated":"2020-03-02T07:04:53+0000","dateUpdated":"2022-02-03T03:32:54+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#singapore","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Singapore","description":"Singapore","dateCreated":"2020-02-03T05:29:36+0000","dateUpdated":"2022-02-03T03:31:37+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51