teUpdated":"2022-02-03T03:32:50+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#cloud-operations","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cloud Operations","description":"\u003cp\u003eAWS Cloud Operations provides a model and tools for a secure and efficient way to operate in the cloud. This is an initiative, not a product.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:05:06+0000","dateUpdated":"2023-07-14T01:05:06+0000"}]},{"item":{"id":"customer-references#natura-cit-2025","locale":"en_US","directoryId":"customer-references","name":"natura-cit-2025","dateCreated":"2025-02-19T21:31:59+0000","dateUpdated":"2025-03-06T23:45:47+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eDurante o processo de integra\u0026ccedil;\u0026atilde;o com a Avon, a Natura reconheceu uma oportunidade: evoluir a plataforma de capta\u0026ccedil;\u0026atilde;o de pedidos de forma a beneficiar as consultoras de ambas as marcas. Assim nasceu o Projeto Vitrine. Diferente das vitrines comuns de com\u0026eacute;rcio eletr\u0026ocirc;nico, esta plataforma foi cuidadosamente customizada para atender ao perfil individual de cada consultora, proporcionando uma experi\u0026ecirc;ncia \u0026uacute;nica e personalizada. Com a parceria AWS da CI\u0026amp;T, aliada \u0026agrave; expertise da AWS, a Natura lan\u0026ccedil;ou com sucesso uma nova plataforma que n\u0026atilde;o apenas serve mais de 1 milh\u0026atilde;o de consultoras, mas tamb\u0026eacute;m se integra perfeitamente ao seu sistema legado de capta\u0026ccedil;\u0026atilde;o de pedidos. Este foi mais um passo significativo rumo \u0026agrave; inova\u0026ccedil;\u0026atilde;o e \u0026agrave; excel\u0026ecirc;ncia no atendimento, reafirmando o compromisso da Natura em impulsionar o crescimento e o sucesso de todas as suas consultoras.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Natura%20Logo%2070x70px.24b83b5d34b98cd12323eb743b51ba19f364d57c.png","displayLocation":"Brazil","footerInfoText":"2025","industry":"Retail","sortDate":"2025-02-19","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/natura-cit/","customer-name":"Natura","enableShare":"1","publishedDate":"2025","contentType":"Case Study","headline":"Projeto Vitrine, da Natura, Unifica Plataforma de Pedidos para Cerca de 1 Milhão de Consultoras"}},"tags":[{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#industry#retail","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Retail","description":"Retail","dateCreated":"2020-01-16T17:42:39+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#cloudsearch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudSearch","description":"Amazon CloudSearch","dateCreated":"2020-03-02T07:02:03+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"}]},{"item":{"id":"customer-references#collaboration-ai-second-front-chainguard-2025","locale":"en_US","directoryId":"customer-references","name":"collaboration-ai-second-front-chainguard-2025","dateCreated":"2025-02-17T19:46:43+0000","dateUpdated":"2025-02-19T21:17:52+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eCollaboration.Ai, a leader in AI-driven innovation management software, sought to expand into the US federal government sector, particularly the Department of Defense (DoD), with its end-to-end CrowdVector innovation management platform. Obtaining the required Authority to Operate (ATO) on DoD networks\u0026mdash;a complex, lengthy, and costly process\u0026mdash;posed a significant challenge for the startup. By engaging with AWS Partner Second Front, a member of the AWS Global Security \u0026amp; Compliance Acceleration (GSCA) program and using its Game Warden DevSecOps platform on AWS GovCloud (US), Collaboration.Ai secured a Certificate to Field (CTF) for DoD networks in less than 90 days. The deployment was accelerated further by using a custom registry of secure, minimal container images from AWS Partner Chainguard. This approach saved nearly two years of work and $2 million in compliance costs, swiftly opening access to the US federal government market.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/partner-network/partner_marketing_web_team/directories-logos/Collaboration.Ai_Logo_1__300x50.14548e71e4ebec3d66e21b1a104c6cebe41d8989.png","displayLocation":"United States","footerInfoText":"2025","industry":"Software \u0026 Internet","sortDate":"2025-02-17","headlineUrl":"https://aws.amazon.com/solutions/case-studies/collaboration.ai-second-front-chainguard/","customer-name":"Collaboration.Ai","enableShare":"1","publishedDate":"2025","contentType":"Case Study","headline":"Collaboration.Ai Achieves DoD Authorization in Less Than 90 Days, Saves $2 Million with Second Front, Chainguard, and AWS"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"i