:"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#acv07282021jaedakjbfwd","locale":"en_US","directoryId":"customer-references","name":"acv07282021jaedakjbfwd","dateCreated":"2022-05-23T21:40:16+0000","dateUpdated":"2022-05-23T21:52:04+0000","additionalFields":{"descriptionSummary":"In this episode we discuss how ACV auctions facilitates the entire automobile auction process in only 20 minutes with a containers-based architecture built on AWS. ACV’s architect walks you through how they leverage Amazon EKS, AWS RDS to manage hundreds of millions request per day, and use Kafka as a data transfer layer for monitoring, analytics and as event bus.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/acv-auctions-logo%401x.252ae56928d66711c01f56e73bccc6afe7ec3f63.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2021-07-28","headlineUrl":"https://youtu.be/tBavPTWewvI?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"ACV Auctions: Learn How ACV Scales to Serve Hundreds of Millions of Auction Requests Per Month","customer-name":"ACV Auctions"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNa