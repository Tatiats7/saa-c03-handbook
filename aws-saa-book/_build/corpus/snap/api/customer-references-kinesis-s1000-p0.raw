eCreated":"2020-07-15T21:58:51+0000","dateUpdated":"2022-02-03T03:32:02+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Internet of Things (IoT)","description":"Internet of Things (IoT)","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2023-08-22T20:28:39+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"customer-references#category#sustainability","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Sustainability","description":"Sustainability","dateCreated":"2022-01-18T21:36:39+0000","dateUpdated":"2022-05-09T21:31:10+0000"}]},{"item":{"id":"customer-references#cookpadenglish20201014fyijko","locale":"en_US","directoryId":"customer-references","name":"cookpadenglish20201014fyijko","dateCreated":"2022-05-23T21:41:06+0000","dateUpdated":"2022-12-19T23:25:23+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eOn the next This is my Architecture Video, Masa from Cookpad explains how they built scalable and flexible security architecture to monitor and analyze security log data in a cost-effective manner using AWS services. You learn three parts of architecture: 1) COLLECTION security logs through AWS services such as Amazon Kinesis Data Firehose, AWS CloudTrail, and AWS Lambda. 2) RETENTION of the logs in Amazon S3 to be managed by Amazon S3 lifecycle policies. 3) ANALYSIS of the logs to be inspected by AWS Lambda to raise alert, to be stored in Amazon OpenSearch Service to analyze, and to be searched by Amazon Athena for audit. You also learn how beneficial AWS managed services are to achieve both low latency and data integrity with low cost, and collect diverse log data easily without schema using S3.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/cookpad-logo%401x.8f826fcd2c78a357e870d39de4e0a2425b977a20.png","displayLocation":"Japan","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2020-10-14","headlineUrl":"https://youtu.be/qN5-v4NlKac?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Cookpad Inc.","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Cookpad: Security Architecture to Monitor and Analyze Secure Logs using AWS (English)"}},"tags":[{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#kinesis-data-firehose","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis Firehose","description":"Amazon Kinesis Firehose","dateCreated":"2020-05-08T03:42:48+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US