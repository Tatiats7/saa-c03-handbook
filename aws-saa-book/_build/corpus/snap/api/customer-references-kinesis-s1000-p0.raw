ry#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#cloudsearch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudSearch","description":"Amazon CloudSearch","dateCreated":"2020-03-02T07:02:03+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"customer-references#innovator#mercado-libre","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Mercado Libre","description":"Mercado Libre","dateCreated":"2022-09-15T00:48:36+0000","dateUpdated":"2022-09-15T00:48:36+0000"},{"id":"customer-references#category#mobile","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Mobile","description":"Mobile","dateCreated":"2019-07-22T18:32:14+0000","dateUpdated":"2022-03-24T02:42:27+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#category#developer-tools","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Developer Tools","description":"\u003cp\u003eHost code, build, test, and deploy your applications quickly and effectively with AWS developer tools. Leverage core tools like software development kits (SDKs), code editors, and continuous integration and delivery (CI/CD) services for DevOps software development. Use machine learning (ML) -guided best practices and abstractions to improve agility, security, velocity, and code quality.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:14:12+0000","dateUpdated":"2023-07-14T01:14:12+0000"}]},{"item":{"id":"customer-references#occmundial","locale":"en_US","directoryId":"customer-references","name":"occmundial","dateCreated":"2023-06-01T23:07:18+0000","dateUpdated":"2023-06-08T04:07:39+0000","additionalFields":{"descriptionSummary":"Online Career Center (OCC) es una empresa mexicana que actúa en la industria del empleo, ocupando la posición de bolsa de trabajo líder en México. Desde hace 22 años, OCC es una empresa en línea, de hecho, una de las primeras startups en línea del país. Cuenta con una cartera de 38 mil clientes que pagan por anunciar sus vacantes y así encontrar los mejores talentos. Por otro lado, OCC ayuda a millones de mexicanos a encontrar un mejor empleo. Desde hace años, la empresa viene evolucionando su cultura y prácticas de desarrollo, inteligencia artificial y operaciones. Para evolucionar en este sentido, OCC necesitaba cambiar los data centers on-premises y utilizar una infraestructura cloud-native. La empresa logró facilitar esta transformación cultural con los servicios y plataforma AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/occ_logo%401x.bb407adebccc14b37f572f384dd0be42c09bbba6.png","displayLocation":"México","footerInfoText":"Fecha de publicación","industry":"Servicios profesionales","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/occmundial/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"Historia del cliente","customer-name":"Online Career Center (OCC)","headline":"OCC utiliza AWS para apoyar la industria de empleos en México"}},"tags":[{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tag