:"2022-02-03T03:35:26+0000"},{"id":"GLOBAL#product#lightsail","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Lightsail","description":"Amazon Lightsail","dateCreated":"2020-03-02T07:04:25+0000","dateUpdated":"2022-02-03T03:32:47+0000"}]},{"item":{"id":"customer-references#klustera","locale":"en_US","directoryId":"customer-references","name":"klustera","dateCreated":"2023-06-01T23:07:54+0000","dateUpdated":"2023-06-08T04:07:38+0000","additionalFields":{"descriptionSummary":"Klustera se dedica a digitalizar el comportamiento humano para convertir el mundo en datos y así transformarlo en un mundo actualizable. Con 21 personas en el equipo y presencia en tres países, la empresa coloca tecnología de sensores y reconocimiento de imágenes en espacios comerciales para digitalizar cómo las personas se comportan y conviven en el espacio público. Con AWS redujo los gastos de la nube de alrededor de US$ 20.000 para US$ 5.000 al mes.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/klustera_logo%401x.cf5bb4e9fcf0f1c1f8b1cbd1a44a452e6197d1c0.png","displayLocation":"México","footerInfoText":"Fecha de publicación","industry":"Software e Internet","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/klustera/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"Historia del cliente","customer-name":"Klustera","headline":"Klustera utiliza tecnología AWS para hacer un mundo actualizable"}},"tags":[{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#tech-cate