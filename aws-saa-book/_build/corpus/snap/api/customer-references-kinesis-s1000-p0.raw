0"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#industry#power-utilities","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Power \u0026 Utilities","description":"Power \u0026 Utilities","dateCreated":"2020-01-16T17:42:37+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#product#quicksight","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon QuickSight","description":"Amazon QuickSight","dateCreated":"2020-03-02T07:04:56+0000","dateUpdated":"2022-02-03T03:32:55+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#industry#oil-gas","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Oil \u0026 Gas","description":"Oil \u0026 Gas","dateCreated":"2020-01-16T17:42:36+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#industry#energy","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Energy","description":"Energy","dateCreated":"2020-07-15T21:58:51+0000","dateUpdated":"2022-02-03T03:32:02+0000"},{"id":"customer-references#category#sustainability","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Sustainability","description":"Sustainability","dateCreated":"2022-01-18T21:36:39+0000","dateUpdated":"2022-05-09T21:31:10+0000"}]},{"item":{"id":"customer-references#stoodi","locale":"en_US","directoryId":"customer-references","name":"stoodi","dateCreated":"2023-06-01T23:05:03+0000","dateUpdated":"2024-04-30T13:24:05+0000","additionalFields":{"descriptionSummary":"Criada em 2013, o Stoodi é uma startup de educação, parte do grupo Cogna, que tem o objetivo de ajudar estudantes do ensino médio a ingressarem no ensino superior. Desde sua fundação, os recursos de preparação para o Enem e vestibulares da startup foram utilizados por mais de 8 milhões de alunos. A operação do Stoodi já nasceu na nuvem AWS, mas o crescimento acelerado alavancado pelo período de pandemia exigiu da startup uma operação mais eficiente da nuvem, garantindo estabilidade, disponibilidade e segurança. O Stoodi passou a contar com a área de Professional Services da AWS, obtendo ganhos como redução anual total de 25% dos custos totais de AWS que foram parcialmente investidos para melhorar a estabilidade e postura de segurança dos seus produtos.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/stoodi%402x.464772c8a1590a9693032496b334c3b0d9a31402.png","displayLocation":"Brasil","customerNameLower":"stoodi","footerInfoText":"Data de publicação","industry":"Educação","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/stoodi/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Stoodi","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"Uso de Serviços Profissionais AWS reduz em 25% gastos totais com nuvem do Stoodi"}},"tags":[{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:3