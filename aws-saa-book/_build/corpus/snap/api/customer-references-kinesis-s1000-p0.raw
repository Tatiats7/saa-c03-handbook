Created":"2020-03-03T00:18:27+0000","dateUpdated":"2022-02-03T03:33:08+0000"},{"id":"GLOBAL#product#migration-hub","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Migration Hub","description":"AWS Migration Hub","dateCreated":"2020-03-02T07:04:36+0000","dateUpdated":"2022-02-03T03:32:51+0000"},{"id":"GLOBAL#product#mgmt-console","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Management Console","description":"AWS Management Console","dateCreated":"2020-03-02T07:04:33+0000","dateUpdated":"2022-02-03T03:32:50+0000"},{"id":"GLOBAL#product#personalize","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Personalize","description":"Amazon Personalize","dateCreated":"2020-03-02T07:04:50+0000","dateUpdated":"2022-02-03T03:32:54+0000"},{"id":"GLOBAL#product#ivs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Interactive Video Service","description":"Amazon Interactive Video Service","dateCreated":"2020-11-20T00:43:24+0000","dateUpdated":"2022-02-03T03:32:44+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#capitalone-innovator-it","locale":"en_US","directoryId":"customer-references","name":"capitalone-innovator-it","dateCreated":"2024-11-12T00:54:01+0000","dateUpdated":"2024-11-13T20:07:51+0000","additionalFields":{"descriptionSummary":"Capital One ha rivoluzionato il settore dei servizi finanziari dal 1994, utilizzando la tecnologia per trasformare i servizi bancari e i pagamenti. Oggi la \"banca digitale\" punta tutto su AWS, sfruttando analisi dei dati, microservizi, IA/ML e altre soluzioni per continuare a innovare. ","featureImageURL":"https://d1.awsstatic.com/aws-key-pages/homepage-key-pages/customer-stories-logo/Capital%20One.1062d1ff7bef5fc2845aaf52e2109097d3b2bd87.jpg","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/capital-one-logo-1x.0e2c860505af688847cd525098b3510e556ab395.png","displayLocation":"North America","customerNameLower":"capital one","footerInfoText":"Published Date","description":"\u003cp\u003eEmbracing analytics and machine learning to provide a seamless customer experience\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u0026nbsp;\u003c/p\u003e\n","industry":"Financial Services","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/innovators/capital-one/","customer-name":"Capital One","enableShare":"1","publishedDate":"2021","contentType":"Storia del cliente","headline":"Capital One su AWS"}},"tags":[{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#connect","locale":