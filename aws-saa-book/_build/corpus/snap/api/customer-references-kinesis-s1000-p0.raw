,{"id":"GLOBAL#product#auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Auto Scaling","description":"AWS Auto Scaling","dateCreated":"2020-03-02T07:01:39+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+0000"},{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#siemens-plm-case-study","locale":"en_US","directoryId":"customer-references","name":"siemens-plm-case-study","dateCreated":"2019-07-19T16:58:42+0000","dateUpdated":"2023-07-19T03:05:04+0000","additionalFields":{"featured":"0","descriptionSummary":"\u003cp\u003eSiemens has been able to drive innovation across multiple business units\u0026mdash;including Siemens Mobility, Siemens Power and Gas, and Siemens PLM\u0026mdash;using more than 40 services including Amazon Kinesis, Amazon OpenSearch Service, and Amazon Athena. Siemens PLM provides product-lifecycle management software to thousands of companies and follows an \u0026quot;AWS first\u0026quot; strategy to power its MindSphere industrial IoT platform.\u003c/p\u003e\n","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Siemens_Customer-Reference_Logo%401x.bb038521df5899223d4bd8364182c2fc69ef288d.png","displayLocation":"Germany","footerInfoText":"Published Date","description":"\u003cp\u003eUsing an \u001cAWS-first\u001d strategy, Siemens PLM is driving the digitalization of its core businesses, including customer-facing solutions that require high availability and scalability. The company is headquartered in Germany, with global divisions in industry, energy, healthcare, and infrastructure, and cities. To power its MindSphere industrial IoT platform, Siemens selected AWS and is using more than 40 services including Amazon Kinesis, Amazon OpenSearch Service, and Amazon Athena.\u003c/p\u003e\n","industry":"Power \u0026 Utilities","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/siemens-plm/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Siemens PLM","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Siemens PLM Case Study"}},"tags":[{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#dach","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"DACH","description":"DACH","dateCreated":"2020-02-03T05:29:52+0000","dateUpdated":"2022-02-03T03:31:47+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#