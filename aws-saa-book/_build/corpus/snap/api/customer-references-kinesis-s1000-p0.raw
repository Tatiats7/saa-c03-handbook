nesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#puraset-case-study","locale":"en_US","directoryId":"customer-references","name":"puraset-case-study","dateCreated":"2022-10-03T18:33:47+0000","dateUpdated":"2023-07-14T23:32:34+0000","additionalFields":{"descriptionSummary":"Puraset aims to create a solution that can deliver safe drinking water for less than a tenth of the cost that people were paying for bottled water in at-risk communities. The Hungary-based company uses AWS to remotely manage its innovative, portable water treatment units from anywhere in the world. Using AWS IoT Core, Puraset can monitor its PurAID portable water purifiers to ensure they are operating effectively in the field with just two operators for up to 100 units. It can also collect and analyze usage data to improve the quality of water treatment over time, and ease infrastructure maintenance so that it can focus on designing long-term solutions for the developing world.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/puraset-logo%401x.dd4227837e6915d569e5de308da48d58b60525e8.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"puraset","footerInfoText":"Published Date","industry":"Manufacturing","sortDate":"2022-01-01","headlineUr