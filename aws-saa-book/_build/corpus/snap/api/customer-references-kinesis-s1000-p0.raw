:31+0000"}]},{"item":{"id":"customer-references#pacific-gas-electric-company-case-study","locale":"en_US","directoryId":"customer-references","name":"pacific-gas-electric-company-case-study","dateCreated":"2019-07-22T19:44:55+0000","dateUpdated":"2023-07-12T01:40:46+0000","additionalFields":{"featured":"0","descriptionSummary":"PG\u0026E is using the breadth and depth of AWS services to drive its enterprise migration from legacy IT infrastructure to a cloud-first environment. For more than 150 years, PG\u0026E has provided utility services to millions of customers in Northern and Central California.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/US/pge-mp-logo.08c1ff470743fe860c876d6dabb06e7b670729c1.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003ePG\u0026amp;E is using the breadth and depth of AWS services to drive its enterprise migration from legacy IT infrastructure to a cloud-first environment. For more than 150 years, PG\u0026amp;E has provided utility services to millions of customers in Northern and Central California. In addition to using dozens of AWS services including Amazon Aurora, Amazon Kinesis, and Amazon Glacier, PG\u0026amp;E also uses the AWS Partner Network to speed its journey to the cloud.\u003c/p\u003e\r\n","industry":"Power \u0026 Utilities","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/pacific-gas-electric/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Pacific Gas \u0026 Electric Company","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Pacific Gas \u0026 Electric Company Case Study"}},"tags":[{"id":"GLOBAL#product#glacier","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon S3 Glacier","description":"Amazon S3 Glacier","dateCreated":"2020-03-02T07:03:38+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name"