":"2024-02-14T22:32:15+0000","dateUpdated":"2024-02-14T22:32:15+0000"}]},{"item":{"id":"customer-references#hearst-data-analytics-case-study","locale":"en_US","directoryId":"customer-references","name":"hearst-data-analytics-case-study","dateCreated":"2019-07-19T15:11:47+0000","dateUpdated":"2021-12-22T18:51:45+0000","additionalFields":{"featured":"0","descriptionSummary":"With its data analytics pipeline, the Hearst Corporation processes clickstream data from more than 300 websites and delivers it to website editors within minutes. Hearst is one of the largest diversified media and information organizations in the world, with more than 360 businesses.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/HearstCorporation_Customer-Reference_Logo.c1c56eacfb60146c8b75c813bbeb61c60bbe27b2.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the Hearst Data Analytics customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of companies.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/hearst-data-analytics/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Hearst Data Analytics","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Hearst Data Analytics Case Study"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#kinesis-data-firehose","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis Firehose","description":"Amazon Kinesis Firehose","dateCreated":"2020-05-08T03:42:48+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#t-mobile-case-study","locale":"en_US","directoryId":"customer-references","name":"t-mobile-case-study","dateCreated":"2019-07-19T14:57:36+0000","dateUpdated":"2022-12-22T17:56:35+0000","additionalFields":{"featured":"0","descriptionSummary":"T-Mobile accelerated build and deploy steps on AWS by 90 percent with an internally created serverless development platform called Jazz. T-Mobile is a technology company that offers wireless services over a nationwide 4G LTE network to more than 70 million customers.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/TMobile_Logo_@1x.76dc99cc2ef8916824008e5b33f2c309241e01c7.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eT-Mobile accelerated build and deploy steps on AWS by 90 percent with an internally created serverless development platform called Jazz. T-Mobile is a technology company that offers wireless services over a nationwide 4G LTE network to more than 70 million customers. The company\u0019s Jazz platform uses Amazon Kinesis for data streaming at any scale, AWS Lambda to run code in response to events, and Amazon OpenSearch Service to deploy, secure, operate, and scale OpenSearch.\u003c/p\u003e\n","industry":"Telecommunications","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/tmobile/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"T-Mobile","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"T-Mobile Case Study"}},"tags":[{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#industry#telecommunications","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Telecommunications","description":"Telecommunications","dateCreated":"2020-01-16T17:42:41+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"}]},{"item":{"id":"customer-references#netafim-video","locale":"en_US","directoryId":"customer-references","name":"netafim-video","dateCreated":"2020-11-09T18:06:57+0000","dateUpdated":"2022-01-03T17:48:30+0000","additionalFields":{"featured":"0","descriptionSummary":"\u003cp\u003eHeadquartered in Israel, Netafim is the world\u0026#39;s largest irrigation company by market share, with more than $1 billion in sales and 5,000 employees. Its 17 plants manufacture precision drip irrigation equipment, which is sold in 110 countries. The firm\u0026#39;s guiding principle is to help farmers grow more with less\u0026mdash;a mantra that is becoming increasingly relevant as the global population increases and climate change makes water a scarce resource for billions of people. Netafim\u0026#39;s NETBEAT\u0026mdash;\u0026ldquo;the world\u0026#39;s first irrigation system with a brain\u0026rdquo;\u0026mdash;places sensors in fields to collect data about crops and sends the information to cloud-connected units that control fertilizer and watering systems. The units incorporate data from weather forecasts and Netafim\u0026#39;s algorithms to aid plant growth. In this video, Izhar Gilad, vice president of product and business development for digital farming at Netafim, explains why the company uses AWS to deliver NETBEAT, and how AWS helped it transform from an industrial manufacturer to a firm focused on services and data.\u003c/p\u003e\r\n","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Netafilm_Customer-Reference_Logo@1x.e4d9bc60f02263dd0f6ca9429e149686b0b34001.png","displayLocation":"Israel","footerInfoText":"Published Date","industry":"Agriculture","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/netafim-video/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Netafim","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Netafim Helps Farmers Grow More with Less"}},"tags":[{"id":"GLOBAL#location#middle-east-africa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East \u0026 Africa","description":"Middle East \u0026 Africa","dateCreated":"2020-02-03T05:30:19+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#iot-core","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS IoT Core","description":"AWS IoT Core","dateCreated":"2020-03-02T07:04:00+0000","dateUpdated":"2022-02-03T03:32:42+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#use-case#sustainability","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Sustainability","description":"Sustainability","dateCreated":"2021-07-02T05:53:58+0000","dateUpdated":"2022-02-03T03:35:58+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#middle-east","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East","description":"Middle East","dateCreated":"2020-04-09T03:53:16+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"GLOBAL#industry#agriculture","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Agriculture","description":"Agriculture","dateCreated":"2020-06-25T04:02:53+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#location#israel","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Israel","description":"Israel","dateCreated":"2020-02-03T05:30:21+0000","dateUpdated":"2022-02-03T03:31:55+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"IoT","description":"IoT","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2022-02-03T03:35:28+0000"}]},{"item":{"id":"customer-references#miovision-case-study","locale":"en_US","directoryId":"customer-references","name":"miovision-case-study","dateCreated":"2019-07-19T15:12:39+0000","dateUpdated":"2021-12-22T19:23:14+0000","additionalFields":{"featured":"0","descriptionSummary":"Miovision uses AWS to capture and analyze IoT data from thousands of connected devices at traffic intersections around the world. Through connected sensors and intelligent analytics, Miovision empowers more than 17,000 municipalities in 50 countries to be smarter, improving transportation capacity, safety, cost-effectiveness, and performance.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Miovision_Customer-Reference_Logo.073de87da261a97dbf5eed794d465193cc5d5dd4.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eMiovision uses AWS to capture and analyze IoT data from thousands of connected devices at traffic intersections around the world.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/miovision/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Miovision","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Miovision Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Comp