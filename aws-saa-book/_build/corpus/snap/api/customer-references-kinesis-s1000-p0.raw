ry#cust-engagement","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2020-06-05T07:06:46+0000","dateUpdated":"2022-02-03T03:31:03+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#homepage-industry#financial-services","locale":"en_US","tagNamespaceId":"customer-references#homepage-industry","name":"Financial Services","description":"Financial Services","dateCreated":"2022-08-24T22:33:34+0000","dateUpdated":"2022-08-24T22:33:34+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#innovator#capital-one","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Capital One","description":"Capital One","dateCreated":"2022-04-25T19:05:47+0000","dateUpdated":"2022-07-16T00:04:47+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"}]},{"item":{"id":"customer-references#jooycar","locale":"en_US","directoryId":"customer-references","name":"jooycar","dateCreated":"2023-06-01T23:11:01+0000","dateUpdated":"2023-06-08T04:07:34+0000","additionalFields":{"descriptionSummary":"Jooycar se funda en 2014 con el reto de entregar seguros de auto de una forma distinta y revolucionar la forma a través de la cual las personas se relacionan con un seguro de auto. A partir del 2018, Jooycar experimenta un crecimiento muy acelerado al identificar que los usuarios de su tecnología pagaban un 40% menos por su seguro. La empresa evolucionó sus servicios y multiplicó en promedia cada año en tres veces su volumen con una infraestructura basada en Amazon Web Services. Rodrigo Labbé, CEO de Jooycar, y Gonzalo Vásquez, CTO de la empresa, explican cuáles son los principales servicios utilizados por la compañía y cómo AWS le ha permitido triplicar su cartera de clientes sin problemas de infraestructura y aun reduciendo el costo individual por usuario.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/jooycar-logo%401x.24703b2a40081684bda2fc28615b225847e25