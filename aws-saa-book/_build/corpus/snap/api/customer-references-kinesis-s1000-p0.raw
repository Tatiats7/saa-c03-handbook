add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#sbbcargo04122022ksjhflasf","locale":"en_US","directoryId":"customer-references","name":"sbbcargo04122022ksjhflasf","dateCreated":"2023-02-08T01:17:45+0000","dateUpdated":"2023-02-08T01:38:40+0000","additionalFields":{"descriptionSummary":"Learn how SBB Cargo uses a data ingestion and processing pipeline built with Amazon API Gateway, AWS Lambda, Amazon Kinesis that is completely serverless and extremely flexible.","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"swiss federal railways (sbb cff ffs)","footerInfoText":"Published Date","industry":"General Public Services","sortDate":"2022-04-12","headlineUrl":"https://youtu.be/4-teOQ_dJvY?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2022","enableShare":"1","customer-name":"Swiss Federal Railways (SBB CFF FFS)","headline":"SBB Cargo: Data Collection and Processing with Serverless Analytics Services","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references