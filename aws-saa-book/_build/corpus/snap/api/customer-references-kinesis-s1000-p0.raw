":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"customer-references#category#developer-tools","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Developer Tools","description":"\u003cp\u003eHost code, build, test, and deploy your applications quickly and effectively with AWS developer tools. Leverage core tools like software development kits (SDKs), code editors, and continuous integration and delivery (CI/CD) services for DevOps software development. Use machine learning (ML) -guided best practices and abstractions to improve agility, security, velocity, and code quality.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:14:12+0000","dateUpdated":"2023-07-14T01:14:12+0000"}]},{"item":{"id":"customer-references#repp-health","locale":"en_US","directoryId":"customer-references","name":"repp-health","dateCreated":"2020-01-23T21:28:04+0000","dateUpdated":"2023-07-12T01:35:20+0000","additionalFields":{"featured":"0","descriptionSummary":"In just seven months on AWS, Repp Health developed a portfolio of precise medical-asset location products that solutions enable healthcare providers to improve patient safety and efficacy of care.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/ReppHealth_Logo_@1x.d09b3e5bb00fd97ab1e50119573af90f8227ee17.png","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/repp-health-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Repp Health","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Repp Health Uses AWS to Track Medical Assets to Within 10 Centimeters"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#iot-core","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS IoT Core","description":"AWS IoT Core","dateCreated":"2020-03-02T07:04:00+0000","dateUpdated":"2022-02-03T03:32:42+0000"},{"id":"GLOBAL#product#appsync","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS AppSync","description":"AWS AppSync","dateCreated":"2020-03-02T07:01:32+0000","dateUpdated":"2022-02-03T03:32:17+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"IoT","description":"IoT","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#korean-broadcasting-system-case-study","locale":"en_US","directoryId":"customer-references","name":"korean-broadcasting-system-case-study","dateCreated":"2019-07-19T14:56:37+0000","dateUpdated":"2022-12-22T17:42:25+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, Korean Broadcasting System (KBS) scales to meet surges in demand for media content, completes jobs with just a few clicks, and saves 50 percent on event services. KBS is a public broadcasting station that broadcasts many types of programs in Korea and other parts of the world.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/KBS_Customer-Reference_Logo.7e85766e364eecf951767d92685fbdf0dfda499a.png","displayLocation":"Korea","footerInfoText":"Published Date","description":"\u003cp\u003eKBS is a public broadcasting station that broadcasts many types of programs in Korea and other parts of the world. KBS is the first broadcasting station that successfully migrated all of its customer service to AWS Cloud, and it has closed the previous data center. AWS has migrated the ones that were previously done by the equipment by using AWS Elemental MediaLive and AWS Elemental MediaConvert.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/kbs/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Korean Broadcasting System","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Korean Broadcasting System Case Study"}},"tags":[{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03