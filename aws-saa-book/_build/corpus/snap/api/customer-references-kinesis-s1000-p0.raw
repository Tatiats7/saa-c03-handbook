ateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"}]},{"item":{"id":"customer-references#continental","locale":"en_US","directoryId":"customer-references","name":"continental","dateCreated":"2024-09-26T20:53:41+0000","dateUpdated":"2024-10-14T23:50:47+0000","additionalFields":{"descriptionSummary":"From one of the most recognized tire brands in the world to a connected mobility pioneer, Continental has seen success from 1871 to today thanks to its constant evolution. Using Amazon Web Services (AWS), the company has embraced the cloud and accelerated a software-driven vision. It built modular solution Continental Automotive Edge (CAEdge), which connects vehicles to the cloud and provides a virtual workbench to speed development from weeks to hours. And, by embarking on an organization-wide upskilling program and engaging with AWS Skills Guild, thousands of employees have generated more than 100 innovative business proposals. For Continental, investing in cloud capabilities means investing in its future as a key provider of intelligent connectivity for the automotive industry.","featureImageURL":"https://d1.awsstatic.com/continental-innovator-card.cfbdbc2c8216cc8bf13f9c5dfba701b603c45417.jpg","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/CONTINENTAL-Logo_black_200x70_1X.8a46411b5867d4c9c928c449c5991db64538ffe8.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"continental","footerInfoText":"Published Date","description":"\u003cp\u003eInvesting in its future as a key provider of intelligent connectivity for the automotive industry.\u003c/p\u003e\n","industry":"Automotive","sortDate":"2024-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/innovators/continental/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Continental","publishedDate":"2024","enableShare":"1","headline":"Continental on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","descriptio