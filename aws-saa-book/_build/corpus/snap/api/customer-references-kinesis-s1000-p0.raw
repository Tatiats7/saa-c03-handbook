lytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#telemedik-aws","locale":"en_US","directoryId":"customer-references","name":"telemedik-aws","dateCreated":"2023-06-01T23:10:25+0000","dateUpdated":"2023-07-14T23:32:26+0000","additionalFields":{"descriptionSummary":"Grupo Telemedik, el centro de contacto de telesalud más grande en Puerto Puerto Rico y Latinoamérica, es conformado por cuatro compañías en Puerto Rico y una sucursal en Barcelona (España). Con cerca de 500 asientos y bajo la misión de llevar las más innovadoras soluciones de salud a sus clientes, la compañía tenía una carencia de tecnología que le imposibilitaba alcanzar la innovación para impactar aún más la vida de sus pacientes. En este vídeo, el Dr. Joaquín Fernández, presidente y fundador de TeleMedik; Wanda López, directora de centro de contactos; y José Figeroa, director de sistema de información y tecnología, detallan cómo la empresa implementó soluciones de Amazon Web Services de la mano con el partner Symbee para establecer la plataforma Telemedik Global Cloud Solution, con la cual Telemedik logra desarrollar nuevos servicios de manera segura, rápida y sencilla para sus clientes.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/telemedik-logo%402x.0756e27c02673daf30985791289ba8dba73e3a4c.png","displayLocation":"Puerto Rico","footerInfoText":"Fecha de publicación","industry":"Telecomunicaciones","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/telemedik-aws/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"Telemedik","contentType":"Historia del cliente","headline":"Telemedik desarrolla plataforma cloud de innovación basada en servicios AWS"}},"tags":[{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notification Service (SNS)","dateCreated":"2020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#product#s