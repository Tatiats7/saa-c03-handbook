:"en_US","tagNamespaceId":"customer-references#category","name":"Data Lakes \u0026 Analytics","description":"Data Lakes \u0026 Analytics","dateCreated":"2019-07-22T18:31:39+0000","dateUpdated":"2022-02-07T13:55:55+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"}]},{"item":{"id":"customer-references#arcos-dorados","locale":"en_US","directoryId":"customer-references","name":"arcos-dorados","dateCreated":"2023-06-01T23:05:18+0000","dateUpdated":"2023-07-12T01:35:38+0000","additionalFields":{"descriptionSummary":"Arcos Dorados es la franquicia más grande del mundo de la marca McDonald\u0027s, operando 20 países o territorios en América Latina. Hace unos años, la compañía empezó un proceso de transformación digital con el reto de darle a los clientes un servicio con mayor conveniencia y con relación cada vez más personalizada. En este video, Magdalena González Victorica, Chief Technology Officer de Arcos Dorados, cuenta cómo la empresa utilizó las soluciones y los servicios profesionales de AWS y del partner Econocomdigital. Arcos Dorados implementó la infraestructura para tener la información y poder conectarse con los clientes de manera mucho más cercana y humana, aumentando sus ventas y evolucionando como compañía desde el punto de vista digital y de datos.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/arcos_dorados_logo%402x.ee2c34cb96a3b213a1c51d912a70698cd3e0818a.png","displayLocation":"Argentina","customerNameLower":"arcos dorados","footerInfoText":"Fecha de publicación","industry":"Hostelería","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/arcos-dorados/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Arcos Dorados","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headlin