he page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"}]},{"item":{"id":"customer-references#irobot-iot-case-study","locale":"en_US","directoryId":"customer-references","name":"irobot-iot-case-study","dateCreated":"2020-05-12T19:46:59+0000","dateUpdated":"2023-07-19T03:04:48+0000","additionalFields":{"featured":"0","descriptionSummary":"iRobot handles 20x traffic spikes with no problems by using an IoT backend running on AWS. A leading global consumer robot company, iRobot designs and builds robots that empower people to do more both inside and outside the home.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/iRobot-Logo%401x.8cfaa8a98d0909b31184e1372c1809bbdb07109d.png","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Consumer Packaged Goods (CPG)","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/irobot-iot/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"iRobot","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"The Spikiest Time of the Year Is No Problem for iRobot and AWS IoT"}},"tags":[{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","na