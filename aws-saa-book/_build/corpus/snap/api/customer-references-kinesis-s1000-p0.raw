0References%20Directory%20Logos/Cenique_Customer-Reference_Logo.67fcecfa7d2528f44bf54af670a5bbfdbb52751d.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","description":"\u003cp\u003eCenique?s shopper-insight and digital-signage solutions provide retailers across the globe an easy way to analyze in-store customer behavior and optimize marketing strategies accordingly. The company migrated its analytics platform to AWS after experiencing frequent downtime with on-premises servers. By moving to AWS, Cenique has reduced its operating costs by 60 percent and scaled to support a tenfold increase in customers.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/cenique/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Cenique","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Cenique"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Auto Scaling","description":"AWS Auto Scaling","dateCreated":"2020-03-02T07:01:39+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-0