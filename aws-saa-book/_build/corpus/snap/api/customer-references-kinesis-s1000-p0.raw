lockchain-as-a-service (BaaS) platform to provide blockchain-based digital solutions to customers from a wide range of sectors including finance, business, art, and medical. ViewFin Metaverse is a fintech company focusing on blockchain technologies; its main offerings include Metaverse and Metaverse BaaS. Amazon Web Services used by ViewFin Metaverse include Amazon EC2, Amazon S3, Amazon CloudWatch, Amazon DynamoDB, Amazon RDS, Amazon EMR, Amazon RedShift, Amazon Kinesis, Amazon Kinesis Firehose, Amazon ElastiCache, Amazon Elastic Container Registry (Amazon ECR), AWS IAM, and AWS Developer Support.\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/viewfin/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ViewFin Metaverse","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"ViewFin Metaverse Case Study"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services"