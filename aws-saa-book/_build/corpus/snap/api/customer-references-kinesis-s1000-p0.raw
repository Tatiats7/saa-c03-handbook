tatic.com/Customer%20References%20Directory%20Logos/Woongjin_Customer-Reference_Logo.d22315b7917edc7ba19d770a6a3c92e865c75360.png","displayLocation":"Korea","footerInfoText":"Published Date","description":"\u003cp\u003eWoongjin Thinkbig, a specialized educational service company that develops and provides various digital educational \u0026amp; cultural contents in line with the development of digital technologies, launched an \u001cAI learning coaching service\u001d by building an integrated data analytics platform that provides customized services based on customer data. It analyzes big data through AWS\u0019s Kinesis and EMR and successfully provides meaningful results to customers.\u003c/p\u003e\r\n","industry":"Education","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/woongjin-thinkbig/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Woongjin Thinkbig","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"AWS Case Study: Woongjin Thinkbig"}},"tags":[{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#education",