escription":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#epic-games-case-study","locale":"en_US","directoryId":"customer-references","name":"epic-games-case-study","dateCreated":"2019-07-19T15:15:36+0000","dateUpdated":"2023-07-19T03:04:48+0000","additionalFields":{"featured":"0","descriptionSummary":"Epic Games uses AWS to deliver Fortnite to more than 200 million players around the world, support growth of more than 100 times in just 12 months, and perform analysis that helps it improve the game. Fortnite, one of the world\u0027s most popular video games, runs nearly entirely on AWS, including its worldwide game-server fleet, backend services, databases, websites, and analytics pipeline and processing systems.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/EpicGames_Customer-Reference_Logo.8a439eccad8e4f56fc6f9733371dfecc459b5ba3.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eChris Dyl, director of platform at EPIC Games, discusses how AWS is powering its creation engine Unreal Engine and the last-man-standing game Fortnite. As the engine behind one of the world\u0019s most popular games with millions of concurrent players worldwide, EPIC relies on AWS to help it reach the scale and the elasticity it needs to provide the best player experience.\u003c/p\u003e\r\n","industry":"Gaming","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/EPICGames/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Epic Games","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Epic Games Case Study"}},"tags":[{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#epic-games","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Epic Games","description":"Epic Games","dateCreated":"2022-04-25T19:06:19+0000","dateUpdated":"2022-07-16T00:04:47+0000"}]},{"item":{"id":"customer-references#askey-case-study","locale":"en_US","directoryId":"customer-references","name":"askey-case-study","dateCreated":"2019-07-19T15:10:57+0000","dateUpdated":"2021-12-22T19:11:00+0000","additionalFields":{"featured":"0","descriptionSummary":"By using AWS, Askey Computer Corporation is ensuring that the growing number of travelers using Taipei Main Station, a railway station and major transportation hub in Taiwan, can move around easily and safely. Askey builds cutting-edge IT solutions that can support smart projects in major cities worldwide.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Askey_Customer-Reference_Logo.a7aff7dd9bfdae8c835025c393796def494ce599.png","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003eBy using AWS, Askey Computer Corporation is ensuring that the growing number of travelers using Taipei Main Station, a railway station and major transportation hub in Taiwan, can move around easily and safely. Askey builds cutting-edge IT solutions that can support smart projects in major cities worldwide. The company runs the IT infrastructure supporting its Taipei Main Station smart project on the AWS Cloud, with Amazon EC2 instances for web applications and services. Askey uses Amazon Kinesis to collate data from thousands of smartphone apps, AWS Lambda to process that data, and Amazon DynamoDB to store it.\u003c/p\u003e\r\n","industry":"Transport \u0026 Logistics","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/askey/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Askey","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Askey Case Study"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#location#taiwan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Taiwan","description":"Taiwan","dateCreated":"2020-02-03T05:29:38+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"cu