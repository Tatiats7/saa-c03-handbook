022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#hsbc-wealth-and-personal-banking","locale":"en_US","directoryId":"customer-references","name":"hsbc-wealth-and-personal-banking","dateCreated":"2021-06-05T00:52:01+0000","dateUpdated":"2023-07-19T03:04:48+0000","additionalFields":{"featured":"0","descriptionSummary":"Working in collaboration with Amazon Web Services (AWS), HSBC\u0027s Wealth \u0026 Personal Banking business shares how it is able to innovate faster and provide easier and more secure digital banking to meet their customer\u0027s changing needs. Using AWS serverless technology, HSBC\u0027s message orchestration platform is able to ingest and analyze both internal and external data, providing a personalized digital messaging service to meet customer needs.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/HSBC_Logo%401x.0b3e2bfb1f531f98ff95cec12652d1bc7b35e285.png","displayLocation":"Europe, Middle East, \u0026 Africa","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2021-06-04","headlineUrl":"https://aws.amazon.com/solutions/case-studies/hsbc-wealth-and-personal-banking/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"HSBC","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"HSBC’s Wealth \u0026 Personal Banking Innovates Digital Messaging Strategy Using Serverless on AWS"}},"tags":[{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":