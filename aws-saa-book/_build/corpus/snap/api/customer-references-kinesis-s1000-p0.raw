eCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#innovator#siemens","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Siemens","description":"Siemens","dateCreated":"2022-04-25T19:06:51+0000","dateUpdated":"2022-07-16T00:04:48+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"IoT","description":"IoT","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"}]},{"item":{"id":"customer-references#the-globe-and-mail-case-study","locale":"en_US","directoryId":"customer-references","name":"the-globe-and-mail-case-study","dateCreated":"2019-07-22T19:47:47+0000","dateUpdated":"2021-12-22T18:47:57+0000","additionalFields":{"featured":"0","descriptionSummary":"The Globe and Mail is using AWS to deliver dynamic, personalized content to its readers and has boosted reader engagement by 25 percent. Established more than 170 years ago, Canada\u0027s number-one weekday and weekend newspaper has more than 4.7 million weekly digital readers. The company wanted to offer its online readers a personalized recommendation system, and had help from ClearScale, a Premier Consulting Partner, to build that system on AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/GlobeAndMail_Customer-Reference_Logo.4bdb836f4fb099401bfa0223b31fab99a4b355c7.png","displayLocation":"Canada","footerInfoText":"Published Date","description":"\u003cp\u003eThe Globe and Mail is using Amazon Web Services (AWS) to deliver dynamic, personalized content to its readers and has boosted reader engagement by 25 percent. Established more than 170 years ago, Canada\u0019s number-one weekday and weekend newspaper has more than 4.7 million weekly digital readers. The company wanted to offer its online readers a personalized recommendation system, and had help from ClearScale, a Premier Consulting Partner, to build that system on AWS. The newspaper processes, stores, and analyzes recommendation data using big-data tools including Amazon Kinesis, Amazon DynamoDB, and Amazon Elastic MapReduce.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/the-globe-and-mail-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"The Globe and Mail","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"The Globe and Mail Case Study"}},"tags":[{"id":"customer-references#category#business-applications-microsoft","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: Microsoft","description":"Business Applications: Microsoft","dateCreated":"2019-07-22T18:31:11+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-2