ustry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"}]},{"item":{"id":"customer-references#accor-innovator-it","locale":"en_US","directoryId":"customer-references","name":"accor-innovator-it","dateCreated":"2024-09-18T20:03:17+0000","dateUpdated":"2024-09-18T20:08:10+0000","additionalFields":{"descriptionSummary":"Il gruppo alberghiero Accor si impegna a superare le aspettative dei propri clienti e a fornire a ciascuno esperienze stimolanti e personalizzate. Per raggiungere questo obiettivo, il gruppo alberghiero è supportato dalle tecnologie Amazon Web Services (AWS) e usa soluzioni cloud scalabili, insieme a dispositivi intelligenti di Internet delle cose che funzionano con l\u0027Intelligenza Artificiale (IA). Accor ospita milioni di clienti che viaggiano in 5.200 hotel in 110 Paesi nel mondo ed è in grado di aprire, ogni giorno, un nuovo hotel.","featureImageURL":"https://d1.awsstatic.com/accor_innovator.e42013ce8b1a31327a12eb01c9ca7bb514926e7c.png","featureFlag":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/accor%20logo%401x.f54daa83d222f1b02f62b4d673ff1107bb2af35b.png","displayLocation":"Francia","customerNameLower":"accor","footerInfoText":"Data di pubblicazione","description":"\u003cp\u003eImproving personalized hotel experiences and strengthening customer loyalty.\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u0026nbsp;\u003c/p\u003e\n","industry":"Servizi alberghieri","sortDate":"2024-01-01","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/innovators/accor/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Accor","enableShare":"1","publishedDate":"2024","contentType":"Storia del cliente","headline":"Accor su AWS"}},"tags":[{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Mobile","description":"Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2023-08-22T20:28:38+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#language#italian","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Italian","descr