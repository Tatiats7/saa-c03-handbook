utton","description":"AWS IoT Button","dateCreated":"2020-03-02T07:03:58+0000","dateUpdated":"2022-02-03T03:32:42+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"}]},{"item":{"id":"customer-references#aws-case-study-thron","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-thron","dateCreated":"2019-07-22T19:50:40+0000","dateUpdated":"2023-07-14T23:32:42+0000","additionalFields":{"featured":"0","descriptionSummary":"THRON helps its customers get more out of content through distribution, workflow management, and big data analysis for business insights. The Italian company offers a platform to simplify digital content management and distribution and create actionable recommendations to increase business insights. THRON has been able to cut its development and release cycle time in half by using AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/THRON_Customer-Reference_Logo.5a2d54d23712156b20f60cb3357996725d4bc9e9.png","displayLocation":"Italy","footerInfoText":"Published Date","description":"\u003cp\u003eTHRON helps its customers get more out of content through distribution, workflow management, and big data analysis for business insights. The Milan-based company offers a platform to simplify digital content management and distribution and create actionable recommendations to increase business insights. THRON has been able to cut its development and release cycle time in half by using AWS. It uses a range of AWS services, including Amazon Kinesis, Amazon Redshift, and Amazon EMR to power its intelligence and analysis reporting.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/thron/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"THRON","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: THRON"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#italy","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Italy","description":"Italy","dateCreated":"2020-02-03T05:30:02+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#use-case#data-lakes","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Data Lakes","description":"Data Lakes","dateCreated":"2020-06-05T06:37:09+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#category#data-lakes-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Data Lakes \u0026 Analytics","description":"Data Lakes \u0026 Analytics","dateCreated":"2019-07-22T18:31:39+0000","dateUpdated":"2022-02-07T13:55:55+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-mydress","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-mydress","dateCreated":"2019-07-22T19:52:42+0000","dateUpdated":"2023-07-14T23:32:40+0000","additionalFields":{"featured":"0","descriptionSummary":"MyDress enables fashion labels in Japan, Korea, and Taiwan to sell clothes and accessories to customers in Hong Kong. MyDress runs a Magento e-commerce platform and associated systems on AWS rather than having to invest in a physical data center. Using AWS, the company can support an average growth rate of 70 percent per year and marketing campaigns that can increase traffic by up to 100 percent, while reducing operating expenditure by 20 percent per year over two years.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/mydress-logo.e6494767ba9a66410ea1e528e33e1158de150a72.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","description":"\u003cp\u003eMyDress enables fashion labels in Japan, Korea, and Taiwan to sell clothes and accessories to customers in Hong Kong. MyDress runs a Magento e-commerce platform and associated systems on AWS rather than having to invest in a physical datacenter. Using AWS, the company can support an average growth rate of 70 percent per year and marketing campaigns that can increase traffic by up to 100 percent, while reducing operating expenditure by 20 percent per year over two years.\u003c/p\u003e\r\n","industry":"Retail","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/mydress/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"MyDress","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: MyDress"}},"tags":[{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u00