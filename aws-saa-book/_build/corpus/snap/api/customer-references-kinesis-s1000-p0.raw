arketing","dateCreated":"2020-01-16T17:42:16+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-coinbase","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-coinbase","dateCreated":"2019-07-22T19:52:37+0000","dateUpdated":"2023-07-14T23:32:43+0000","additionalFields":{"featured":"0","descriptionSummary":"Coinbase is the world\u0027s most popular bitcoin wallet, facilitating bitcoin transactions in 190 countries. The organization runs its global bitcoin exchanges, wallets, and an analytical insight pipeline on AWS. Using AWS, Coinbase has grown to support 3 million global bitcoin users and can analyze 1 TB of data each day for better insight into its business.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Coinbase_Customer-Reference_Logo.21892bc610021b17390aadf95f6958deaf5829ec.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eCoinbase is the world\u0026#39;s most popular bitcoin wallet, facilitating bitcoin transactions in 190 countries. The organization runs its global bitcoin exchanges, wallets, and an analytical insight pipeline on AWS. Using AWS, Coinbase has grown to suppo