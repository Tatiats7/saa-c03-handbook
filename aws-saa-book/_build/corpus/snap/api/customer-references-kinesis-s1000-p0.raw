nces daily in real time, enabling it to optimize user experience, reduce costs, and improve application resilience.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Netflix_1x.4ae5e442fea7c25ec27b81891425de0b830cbfcc.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eNetflix is the world\u0026rsquo;s leading internet television network, with more than 100 million members in more than 190 countries enjoying 125 million hours of TV shows and movies each day.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/netflix-kinesis-streams/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Netflix","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Netflix \u0026 Amazon Kinesis Streams Case Study"}},"tags":[{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#netflix","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Netflix","description":"Netflix","dateCreated":"2022-04-25T19:06:40+0000","dateUpdated":"2022-06-10T21:39:50+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise"