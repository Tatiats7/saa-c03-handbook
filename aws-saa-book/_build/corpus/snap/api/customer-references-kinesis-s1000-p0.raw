r","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"}]},{"item":{"id":"customer-references#treemetrics-sustainabiity","locale":"en_US","directoryId":"customer-references","name":"treemetrics-sustainabiity","dateCreated":"2024-06-12T18:24:01+0000","dateUpdated":"2024-09-18T00:53:32+0000","additionalFields":{"descriptionSummary":"Managing forests in a modern, sustainable way requires accurate, real-time measurement data. Treemetrics brings together this data—from satellites, drones, mobile phones, and various field instruments—to give forest industry professionals a smarter way to monitor tree cover, biomass, and other metrics. The result is environmentally driven decisions and greater sustainability. Operations director Garret Mullooly says the software innovator uses Amazon Web Services (AWS) to develop its cutting-edge technology and revolutionize how forests are managed.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Treemetrics-Logo%401x.d2be7d42bbbc2651d905134ac262e3823b1bfe62.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Treemetrics-Logo%401x.d2be7d42bbbc2651d905134ac262e3823b1bfe62.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"treemetrics","footerInfoText":"Published Date","industry":"Agriculture","sortDate":"2024-07-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/treemetrics-sustainabiity/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Treemetrics","enableShare":"1","publishedDate":"2024","headline":"Treemetrics Creates Cutting-Edge Tools to Drive Sustainable Forest Management Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#industry#agriculture","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Agriculture","description":"Agriculture","dateCreated":"2020-06-25T04:02:53+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#glacier","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon S3 Glacier","description":"Amazon S3 Glacier","dateCreated":"2020-03-02T07:03:38+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#tech-category#ai","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Artificial Intelligence","description":"\u003cp\u003eArtificial Intelligence\u003c/p\u003e\n","dateCreated":"2023-08-22T20:28:40+0000","dateUpdated":"2024-05-23T20:32:49+0000"},{"id":"customer-references#category#gen-ai","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gen AI","description":"\u003cp\u003eGenerative Artificial Intelligence\u003c/p\u003e\n","dateCreated":"2023-07-10T17:07:31+0000","dateUpdated":"2023-07-10T17:07:31+0000"}]},{"item":{"id":"customer-references#jimmy-energy-decarbonization","locale":"en_US","directoryId":"customer-references","name":"jimmy-energy-decarbonization","dateCreated":"2024-07-26T11:33:21+0000","dateUpdated":"2024-07-26T11:57:29+0000","additionalFields":{"descriptionSummary":"The team at Jimmy Energy is driven by a shared cause: finding a new way to help the world reduce its carbon footprint. Scientific simulation manager Jeremy Picosson says nuclear is the key. Using Amazon Web Services (AWS) high performance computing (HPC) services, the energy startup can scale fast to run its data-intensive simulation workloads. As a result, it’s on course to launch its nuclear microreactor technology in France—and then the world.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Jimmy%20Energy%20logo%401x.327f22d9410ffe7fef6fb9bff4cedd0ce1c9ac8c.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Jimmy%20Energy%20logo%401x.327f22d9410ffe7fef6fb9bff4cedd0ce1c9ac8c.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"jimmy energy","footerInfoText":"Published Date","industry":"Energy","sortDate":"2024-07-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/jimmy-energy-decarbonization/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Jimmy Energy","publishedDate":"2024","enableShare":"1","headline":"Jimmy Energy Drives Decarbonization, Powered by AWS HPC","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-cate