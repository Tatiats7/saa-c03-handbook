 meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#indusface","locale":"en_US","directoryId":"customer-references","name":"indusface","dateCreated":"2022-05-09T21:31:28+0000","dateUpdated":"2022-12-19T23:25:09+0000","additionalFields":{"descriptionSummary":"Indusface guarantees 99.99 percent uptime for 3,000 customers’ business-critical applications with AppTrana, a software-as-a-service, on AWS. Indusface is a software provider that protects customers’ web applications using behavioral analytics.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/indusface-logo%401x.c07015fcbe4dfd932858c28a5f2c80ab2ec0139b.png","displayLocation":"India","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-05-09","headlineUrl":"https://aws.amazon.com/solutions/case-studies/indusface/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Indusface","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Cybersecurity Provider Indusface Guarantees 99.99% Application Firewall Uptime for Business-Critical Applications on AWS"}},"tags":[{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tag