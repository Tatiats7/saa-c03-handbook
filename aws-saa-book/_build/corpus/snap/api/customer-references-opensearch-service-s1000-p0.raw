{"items":[{"item":{"id":"customer-references#adobe-reinvent2024","locale":"en_US","directoryId":"customer-references","name":"adobe-reinvent2024","dateCreated":"2025-05-07T22:16:08+0000","dateUpdated":"2025-05-07T22:30:08+0000","additionalFields":{"descriptionSummary":"Adobe is transforming the way users interact with documents through Acrobat AI Assistant—built to deliver insights and actionable items quickly and intuitively. Starting with a proof of concept, Adobe rapidly scaled the experience to support hundreds of millions of users by leveraging AWS. Amazon OpenSearch Service powers core attribution citation capabilities, while Amazon Bedrock helps expand multilingual support for Acrobat AI. This has enabled Adobe to reach a broader audience and improve document intelligence for users worldwide.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/adobe-logo%401x1.49c50511f3cb26b1f030088f223169cae853c0e9.png","displayLocation":"United States","customerNameLower":"adobe","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2025-05-01","headlineUrl":"https://www.youtube.com/watch?v\u003dP8O4H_X7_VM\u0026did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Adobe","publishedDate":"2025","enableShare":"1","headline":"Adobe powers AI assistant with Amazon OpenSearch Service and Amazon Bedrock","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#bedrock","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Bedrock","description":"Amazon Bedrock","dateCreated":"2023-04-13T19:06:46+0000","dateUpdated":"2023-04-13T19:06:46+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analy