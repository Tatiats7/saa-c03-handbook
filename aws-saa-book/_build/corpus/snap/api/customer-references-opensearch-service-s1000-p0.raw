"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#lake-formation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lake Formation","description":"AWS Lake Formation","dateCreated":"2020-03-02T07:04:18+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#location#canada","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Canada","description":"Canada","dateCreated":"2020-02-03T05:29:05+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"}]},{"item":{"id":"customer-references#airbnb02242022kjanfejnas","locale":"en_US","directoryId":"customer-references","name":"airbnb02242022kjanfejnas","dateCreated":"2022-05-23T21:40:24+0000","dateUpdated":"2023-07-19T03:05:03+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eAirbnb enables a multi-tenant, fine-grained Security Access Control to their Kubernetes Control Plane architecture. To locks down the security controls, Airbnb runs Kubernetes on Amazon EC2 and leverages AWS Security Token Service (STS) tokens to inject the IAM role into the cluster. Airbnb further refines the access controls with the IAM role to the PODs for least privileged access. For better observatory, Airbnb audits what roles that the pods have by using Amazon CloudTrail that feeds into Amazon OpenSearch Service for visualizations and insights. As a result, Airbnb has a better security posture and operational efficiency.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Data%20Lake/200x100-airbnb.c677af0a005a40c80ec46059554211dfdc90ab98.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Travel","sortDate":"2022-02-24","headlineUrl":"https://youtu.be/WS2Qgx0qgCM?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Airbnb, Inc.","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Airbnb: Securing Multi-Tenant Kubernetes Clusters at Scale"}},"tags":[{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#e