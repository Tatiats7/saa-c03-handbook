uct","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#kafka-managed-streaming","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Managed Streaming for Apache Kafka (MSK)","description":"Amazon Managed Streaming for Apache Kafka (MSK)","dateCreated":"2020-03-02T07:04:11+0000","dateUpdated":"2022-02-03T03:32:44+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"}]},{"item":{"id":"customer-references#iccw","locale":"en_US","directoryId":"customer-references","name":"iccw","dateCreated":"2024-09-05T16:21:28+0000","dateUpdated":"2024-09-05T16:23:37+0000","additionalFields":{"descriptionSummary":"The International Center for Clean Water is driving its mission for sustainable clean water using AWS IoT, monitoring soil and water quality in real time with advanced analytics.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/ICCW_logo%401x.803ce8cb2d6a80a1059d680df5d3a1b4b9360633.png","displayLocation":"Asia Pacific","customerNameLower":"international centre for clean water","footerInfoText":"Published Date","sortDate":"2024-08-27","headlineUrl":"https://aws.amazon.com/solutions/case-studies/iccw/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2024","enableShare":"1","customer-name":"International Centre for Clean Water","headline":"International Centre for Clean Water Improves Water Quality and Public Health in India with AWS IoT","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#kinesis-data-streams","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis Data Streams","description":"Amazon Kinesis Data Streams","dateCreated":"2020-05-08T03:45:11+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Internet of Things (IoT)","description":"Internet of Things (IoT)","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2023-08-22T20:28:39+0000"},{"id":"customer-references#category#iot","locale":"en_US","tagNamespaceId":"customer-references#category","name":"IoT","description":"IoT","dateCreated":"2019-07-22T18:32:05+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#kinesis-data-firehose","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis Firehose","description":"Amazon Kinesis Firehose","dateCreated":"2020-05-08T03:42:48+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#positivo-tecnologia-nextios-2024","locale":"en_US","directoryId":"customer-references","name":"positivo-tecnologia-nextios-2024","dateCreated":"2025-01-21T23:58:19+0000","dateUpdated":"2025-03-06T17:53:43+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eA Positivo Tecnologia, empresa brasileira fundada em 1989, destaca-se no setor educacional desenvolvendo solu\u0026ccedil;\u0026otilde;es tecnol\u0026oacute;gicas. Atrav\u0026eacute;s do Educacional \u0026ndash; Ecossistema de Tecnologia e Inova\u0026ccedil;\u0026atilde;o, a Positivo oferece plataformas de aprendizagem, conte\u0026uacute;dos interativos e ferramentas de gest\u0026atilde;o escolar.\u003c/p\u003e\n\n\u003cp\u003eUm marco significativo foi a integra\u0026ccedil;\u0026atilde;o do assistente de IA generativa, Maria, na plataforma Aprimora em 2023, aprimorando o suporte aos alunos. Em parceria com a Nextios e a AWS, a Positivo lan\u0026ccedil;ou o projeto Professor Digital, um assistente de IA generativa para apoiar professores, alunos e gestores com tarefas diversas, como resumos de aulas e elabora\u0026ccedil;\u0026atilde;o de provas, integrado ao Hub Educacional.\u003c/p\u003e\n\n\u003cp\u003eO projeto foi apresentado com sucesso na Bett Educar 2024, destacando uma arquitetura inovadora baseada em servi\u0026ccedil;os AWS, como Amazon Bedrock, AWS Lambda, e Amazon Transcribe. A solu\u0026ccedil;\u0026atilde;o utiliza uma t\u0026eacute;cnica chamada prompt chain, proporcionando respostas r\u0026aacute;pidas e eficazes, criando uma experi\u0026ecirc;ncia fluida para os usu\u0026aacute;rios.\u003c/p\u003e\n\n\u003cp\u003eA evolu\u0026ccedil;\u0026atilde;o do Professor Digital inclui a integra\u0026ccedil;\u0026atilde;o com edtechs e a capacidade de gerar conte\u0026uacute;dos automaticamente. A Positivo continua a explorar novas funcionalidades e a melhorar a ferramenta, visando implementar solu\u0026ccedil;\u0026otilde;es educacionais mais inteligentes e eficientes.\u003c/p\u003e\n\n\u003cp\u003eO objetivo futuro \u0026eacute; \u0026quot;produtizar\u0026quot; o Professor Digital, tornando-o amplamente dispon\u0026iacute;vel para escolas, e continuar a agregar valor atrav\u0026eacute;s da IA generativa, facilitando a gest\u0026atilde;o educacional e melhorando a experi\u0026ecirc;ncia de aprendizado.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Positivo%20Logo%20200x70px.2eb66ce02db761f3af431d17d9a5572e31a8e4fa.png","footerInfoText":"2024","industry":"Retail","sortDate":"2024-07-02","enableShare":"1","headlineUrl":"https://aws.amazon.com/pt/partners/success/positivo-tecnologia-nextios/","publishedDate":"2024","contentType":"Case Study","headline":"Com IA AWS, Nextios desenvolve Professor Digital para a Positivo Tecnologia"}},"tags":[{"id":"GLOBAL#product#step-functions","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Step Functions","description":"AWS Step Functions","dateCreated":"2020-03-02T07:05:39+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#product#bedrock-knowledge-bases","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Bedrock Knowledge Bases","description":"Bedrock Knowledge Bases","dateCreated":"2023-12-28T17:13:08+0000","dateUpdated":"2024-01-05T17:36:31+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#industry#retail","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Retail","description":"Retail","dateCreated":"2020-01-16T17:42:39+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#bedrock","locale":"en_US","tagNamespaceId":