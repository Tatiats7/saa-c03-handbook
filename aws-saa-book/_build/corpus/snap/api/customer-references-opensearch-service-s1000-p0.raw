, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#onefootball-aws-lake-formation-case-study","locale":"en_US","directoryId":"customer-references","name":"onefootball-aws-lake-formation-case-study","dateCreated":"2021-02-09T21:53:46+0000","dateUpdated":"2024-03-02T02:48:47+0000","additionalFields":{"featured":"0","descriptionSummary":"Soccer media platform OneFootball used AWS Lake Formation to rapidly build a data lake and enable self-service data analytics, increasing data availability to internal staff and end users and reducing technical debt.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/onefootball-logo%401x.9226cea62ec16f3ececbf6c571da4e02120db700.png","displayLocation":"Germany","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2021-02-09","headlineUrl":"https://aws.amazon.com/solutions/case-studies/onefootball-aws-lake-formation-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"OneFootball","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"OneFootball Built a Data Lake in Days Using AWS Lake Formation to Serve 70 Million Fans"}},"tags":[{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCrea