,"dateUpdated":"2022-07-16T00:04:48+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"IoT","description":"IoT","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"}]},{"item":{"id":"customer-references#aws-case-study-scholastic","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-scholastic","dateCreated":"2019-07-22T19:51:15+0000","dateUpdated":"2022-12-19T23:23:28+0000","additionalFields":{"featured":"0","descriptionSummary":"Scholastic cut 40 percent off its IT costs and can deliver new services in minutes instead of weeks using AWS. The New York-based company is the world\u0027s largest publisher of children\u0027s books.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Scholastic_Customer-Reference_Logo.600e77a46481651d91b63e1396d2ad3005a1e36a.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eScholastic cut 40 percent from its IT costs and can deliver new services in minutes instead of weeks using AWS. The New York?based company is the world?s largest publisher of children?s books. It turned to AWS services such as Amazon EC2, Amazon Redshift, and Amazon EMR for greater agility and cost efficiency in running its web hosting and e-commerce operations.\u003c/p\u003e\r\n","industry":"Education","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/scholastic/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Scholastic","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Scholastic"}},"tags":[{"id":"GLOBAL#industry#education","locale":