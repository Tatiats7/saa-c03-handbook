liados que tenían inicialmente a manejar una cartera de 2 millones de afiliados actualmente.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/red-salud-logo%401x.b2d6ba6e411f0b43c9f2272c49263e3896508234.png","displayLocation":"Perú","customerNameLower":"red salud","footerInfoText":"Fecha de publicación","industry":"Atención sanitaria","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/red-salud/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Red Salud","enableShare":"1","publishedDate":"2021","contentType":"Historia del cliente","headline":"AWS apoya el crecimiento de Red Salud durante la pandemia"}},"tags":[{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#use-case#datacenter-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2