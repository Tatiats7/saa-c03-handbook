Id":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#bank-al-etihad-case-study","locale":"en_US","directoryId":"customer-references","name":"bank-al-etihad-case-study","dateCreated":"2020-07-08T16:57:39+0000","dateUpdated":"2023-07-14T23:32:36+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, Bank al Etihad has the agility to deploy new services—including its blockchain-based document authentication platform—10 times faster. The bank provides financial services to consumers and businesses in Jordan. It uses AWS technologies, including AWS KMS, AWS CloudFormation, and Amazon RDS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/BankAlEtihad_Customer-Reference_Logo.9f90b53ac1bf75ffc5023fd5c3963c01cd88359c.png","displayLocation":"Jordan","footerInfoText":"Published Date","industry":"Banking","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/bank-al-etihad-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Bank al Etihad","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Bank al Etihad Deploys Blockchain Service 10x Faster Using AWS"}},"tags":[{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#location#jordan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Jordan","description":"Jordan","dateCreated":"2020-04-09T03:53:34+0000","dateUpdated":"2022-02-03T03:31:54+0000"},{"id":"GLOBAL#tech-category#blockchain","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Blockchain","description":"Blockchain","dateCreated":"2020-01-16T17:43:09+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","descripti