th a mission to improve the backend operations of small and medium enterprises in Indonesia. The company uses AWS Elastic Beanstalk to automatically scale in peak hours, Amazon OpenSearch Service to run queries, and Amazon ElastiCache for search and analytics.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Jurnal_logo@1X.1e8ed8f71b7bab85be11ac7a044df320f9202b9f.png","displayLocation":"Indonesia","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2020-11-05","headlineUrl":"https://aws.amazon.com/solutions/case-studies/jurnal/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Jurnal","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Jurnal by Mekari Helps SMEs Digitalize with SaaS Solutions on AWS"}},"tags":[{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLO