2-02-03T03:31:15+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"}]},{"item":{"id":"customer-references#jdpower20200401xciotywe","locale":"en_US","directoryId":"customer-references","name":"jdpower20200401xciotywe","dateCreated":"2022-05-23T21:42:01+0000","dateUpdated":"2022-12-19T23:25:33+0000","additionalFields":{"descriptionSummary":"Sandeep from JD Power tells us how the company built a data analytics solution on AWS called AI Cloud. JD Power processes terabytes of data performing customer satisfaction research on thousands of product categories producing product insights and rankings in industries such as automotive, healthcare, and electronics. Learn how to build a data lake on Amazon S3 pulling in data from multiple inputs, such as FTP, Amazon S3, and Amazon RDS. Once the data is centrally located, Sandeep shows us how to build catalogs with AWS Glue and custom crawlers running on AWS Fargate. You will also learn how to use Amazon Athena and Amazon Redshift for analytics and machine learning to draw insights from these datasets.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/webteam/category-pages/Analytics/JD-Power_Logo_%401x.3a8391c8e37616e17cdd351d67f1d26cfd3d22ee.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Digital Marketing","sortDate":"2020-04-01","headlineUrl":"https://youtu.be/b93-zn-DtBw?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"JD Power","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"JD Power: Building a Rankings \u0026 Insights Engine with Data Lakes \u0026 Machine Learning on AWS"}},"tags":[{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#digital-marketing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Digital Marketing","description":"Digital Marketing","dateCreated":"2020-01-16T17:42:16+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#cate