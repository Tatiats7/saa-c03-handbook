ale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#innovator#expedia","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Expedia","description":"Expedia","dateCreated":"2022-09-15T00:48:28+0000","dateUpdated":"2022-09-15T00:48:28+0000"},{"id":"GLOBAL#product#service-catalog","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Service Catalog","description":"AWS Service Catalog","dateCreated":"2020-03-02T07:05:20+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"}]},{"item":{"id":"customer-references#measurable-ai-case-study","locale":"en_US","directoryId":"customer-references","name":"measurable-ai-case-study","dateCreated":"2022-08-02T06:39:17+0000","dateUpdated":"2022-08-02T06:40:16+0000","additionalFields":{"descriptionSummary":"Measurable AI leverages managed services from AWS to maintain a lean team while scaling its business internationally, saving 20% of developers’ time. Measurable AI provides businesses with aggregated, anonymized insights gathered from consumers in Southeast Asia, Latin America, and the Middle East. The company uses Amazon OpenSearch Service for querying, Amazon EKS for Kubernetes orchestration, and Amazon S3 for secure data transfers and storage.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/measureable-ai-logo%401x.8ea5880d668f007681f7996446b4be8899e8b9c7.png","displayLocation":"Hong Kong","customerNameLower":"measurable ai","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-08-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/measurable-ai-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Measurable AI","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Measurable AI Empowers Businesses with Faster Insights from Alternative Data on AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#location#china