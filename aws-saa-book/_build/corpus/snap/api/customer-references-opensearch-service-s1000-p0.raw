es. The company delivers its SaaS solutions via the AWS Cloud using a combination of Amazon EC2 instances and Amazon S3.\u003c/p\u003e\r\n","industry":"Professional Services","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/graylink/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"graylink","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"graylink Case Study"}},"tags":[{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#saas","locale":"en_US","tagNamespaceId":"customer-references#category","name":"SaaS","description":"SaaS","dateCreated":"2019-07-22T18:32:20+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#location#middle-east-africa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East \u0026 Africa","description":"Middle East \u0026 Africa","dateCreated":"2020-02-03T05:30:19+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"GLOBAL#location#ssa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Sub-Saharan Africa","description":"Sub-Saharan Africa","dateCreated":"2020-03-10T05:18:06+0000","dateUpdated":"2022-02-03T03:31:58+0000"},{"id":"GLOBAL#industry#prof-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Professional Services","description":"Professional Services","dateCreated":"2020-06-25T04:07:49+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service