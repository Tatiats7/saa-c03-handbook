T07:01:39+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#mobile","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Mobile","description":"Mobile","dateCreated":"2019-07-22T18:32:14+0000","dateUpdated":"2022-03-24T02:42:27+0000"},{"id":"GLOBAL#tech-category#arch-strategy","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Architecture Strategy","description":"Architecture Strategy","dateCreated":"2020-01-16T17:43:08+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"}]},{"item":{"id":"customer-references#bbpos","locale":"en_US","directoryId":"customer-references","name":"bbpos","dateCreated":"2021-08-20T23:52:01+0000","dateUpdated":"2022-12-19T23:24:22+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eWith AWS, BBPOS can support customers in more than 50 countries with single-digit millisecond latency and real-time visibility into its IoT devices. Based in Hong Kong, BBPOS was one of the founders of mobile point-of-sale (mPOS) devices and supporting software. The company uses AWS Global Accelerator for low-latency data transfers, Amazon OpenSearch Service for real-time analytics, and AWS Fargate to automatically scale containers in a serverless fashion.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/bbpos_logo%401X.3c4b30363f43ece328624809abd13124c0ba3bf9.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2021-08-20","headlineUrl":"https://aws.amazon.com/solutions/case-studies/bbpos/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"BBPOS","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"BBPOS Brings Real-Time Visibility to Payment Processing on AWS"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#fargate","local