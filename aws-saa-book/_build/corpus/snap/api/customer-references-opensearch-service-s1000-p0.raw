erprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#innovator#airbnb","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Airbnb","description":"Airbnb","dateCreated":"2022-09-15T00:48:21+0000","dateUpdated":"2022-09-15T00:48:21+0000"},{"id":"GLOBAL#industry#travel","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Travel","description":"Travel","dateCreated":"2020-01-16T17:42:42+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#instaclustr-case-study","locale":"en_US","directoryId":"customer-references","name":"instaclustr-case-study","dateCreated":"2022-01-29T03:27:33+0000","dateUpdated":"2023-07-14T23:32:36+0000","additionalFields":{"descriptionSummary":"By choosing Instaclustr’s managed-service solution for Apache Cassandra, SiteMinder can scale its business in a cost-effective manner and focus on innovating its SaaS. Instaclustr is an Australian software company that manages open-source database technologies for a global customer base. Instaclustr is using Amazon EC2 for core computing and data storage and Amazon S3 for backups.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Instaclustr_logo%401x.fa77e4e165a142cf6d372d8548c2f72865acecca.png","displayLocation":"Australia","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-01-28","headlineUrl":"https://aws.amazon.com/solutions/case-studies/instaclustr-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Instaclustr","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"SiteMinder Partners with Instaclustr to Accelerate its Growth Plans for Hotels Worldwide"}},"tags":[{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_