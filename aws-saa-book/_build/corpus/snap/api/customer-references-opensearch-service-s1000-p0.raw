L#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#waf","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS WAF","description":"AWS WAF","dateCreated":"2020-03-02T07:06:04+0000","dateUpdated":"2022-02-03T03:33:07+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#shield","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Shield","description":"AWS Shield","dateCreated":"2020-03-02T07:05:24+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"customer-references#category#mobile","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Mobile","description":"Mobile","dateCreated":"2019-07-22T18:32:14+0000","dateUpdated":"2022-03-24T02:42:27+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#japan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Japan","description":"Japan","dateCreated":"2020-02-03T05:29:23+0000","dateUpdated":"2022-02-03T03:31:39+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"}]},{"item":{"id":"customer-references#30mhz05262021","locale":"en_US","directoryId":"customer-references","name":"30mhz05262021","dateCreated":"2022-05-23T21:40:07+0000","dateUpdated":"2022-12-19T23:25:13+0000","additionalFields":{"descriptionSummary":"30MHz has built a smart agriculture solution which provides growers with real-time remote crop monitoring solutions to help them optimise irrigation and ventilation, prevent disease or sunscald, improve pest management or predict shelf life. 30MHz and AWS Prototyping team co-developed a prototype to modernise this solution on a serverless architecture with AWS IoT Core and AWS Greengrass to process greenhouse data from the sensors on a local gateway device and continue the operations even offline with intermittent connectivity. In the next step, a machine learning pipeline was built with Amazon SageMaker, to help growers take decisions on climate and irrigation in order to provide optimal growing conditions for their crops. This includes predictive models for each individual grower, based on sensor data collected from each greenhouse, or providing benchmark models for new growers with no data. The prototyped solution is currently being tested by 8 pilot growers with the hopes of scaling up to 100s, even 1000s of growers in the near future.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/30mhz-logo%401x.6698e15a54c1d24b5dc0a9459c37d4d6b965f2e3.png","displayLocation":"Netherlands","footerInfoText":"Published Date","industry":"Agriculture","sortDate":"2021-05-26","headlineUrl":"https://youtu.be/sngtHh1iVaY?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"30MHz","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"30MHz: Building A Smart Agriculture Solution For Indoor Farms And Greenhouses On AWS"}},"tags":[{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#product#greengrass","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS IoT Greengrass","description":"AWS IoT Greengrass","dateCreated":"2020-03-02T07:03:43+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#devtools","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Developer Tools","description":"Developer Tools","dateCreated":"2020-01-16T17:43:16+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","