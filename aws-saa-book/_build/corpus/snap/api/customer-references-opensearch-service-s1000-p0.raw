tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#ec2-auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Auto Scaling","description":"Amazon EC2 Auto Scaling","dateCreated":"2020-03-02T07:02:53+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"}]},{"item":{"id":"customer-references#fresenius05042022oikjsegflkin","locale":"en_US","directoryId":"customer-references","name":"fresenius05042022oikjsegflkin","dateCreated":"2023-02-08T01:16:52+0000","dateUpdated":"2023-07-12T01:35:30+0000","additionalFields":{"descriptionSummary":"Fresenius Medical Care innovates with breakthrough technology using clinic medical information system data from a dialysis machine at the clinic site. The  point of care device embeds the models into the edge with Kafka feeds so that the clinic can react to patients dialysis treatment. The Kafka events feed into Kinesis Data Streams, AWS Lambda, Kinesis Data Analytics, and SageMaker visualized with Elasticsearch Service in Kibana for the near real-time feed of the patient treatment. The machine data set is used to detect the patient\u0027s blood pressure to predicting their dialysis and provide proactive measures of treatment. The data is also streamed into Amazon Kinesis Data Firehose and aggregated with the data warehouse ingested by Glue and into S3 Data Lake for further data analysis and modeling by the data scientist to discover additional predictive models for patient care.","displayLocation":"United States","customerNameLower":"fresenius medical care holdings, inc.","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2022-05-04","headlineUrl":"https://youtu.be/wtl7CrSQnHA?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2022","enableShare":"1","customer-name":"Fresenius Medical Care Holdings, Inc.","headline":"Fresenius Medical Care: Enabling Patient Care Solutions with Near Real-Time Data-Driven Insights","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#kinesis-data-firehose","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis Firehose","description":"Amazon Kinesis Firehose","dateCreated":"2020-05-08T03:42:48+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#kinesis-data-streams","locale":"en_US","tagNamespac