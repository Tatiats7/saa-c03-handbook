page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#canva-professional-services","locale":"en_US","directoryId":"customer-references","name":"canva-professional-services","dateCreated":"2020-12-01T00:31:27+0000","dateUpdated":"2024-03-02T02:48:49+0000","additionalFields":{"featured":"0","descriptionSummary":"Canva strengthened its IT security posture by turning to AWS Professional Services to deploy a security data lake so it can process over 50 million logs a day and improve cyberthreat visibility.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/canva-logo%401x.8aec33e597ba950d92fb30998e4bf287fe1fb746.png","displayLocation":"Australia","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2020-11-30","headlineUrl":"https://aws.amazon.com/solutions/case-studies/canva-professional-services/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Canva","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Canva Works with AWS Professional Services to Augment Security with Data Lake"}},"tags":[{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#kinesis-data-streams","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis Data Streams","description":"Amazon Kinesis Data Streams","dateCreated":"2020-05-08T03:45:11+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"cus