ile System (EFS)","dateCreated":"2020-03-02T07:02:57+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#reference-arch-diagram","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Reference Architecture Diagram","description":"Reference Architecture Diagram","dateCreated":"2020-04-29T05:19:31+0000","dateUpdated":"2022-02-03T03:31:09+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#singapore","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Singapore","description":"Singapore","dateCreated":"2020-02-03T05:29:36+0000","dateUpdated":"2022-02-03T03:31:37+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"}]},{"item":{"id":"customer-references#lexisnexis-analysis-case-study","locale":"en_US","directoryId":"customer-references","name":"lexisnexis-analysis-case-study","dateCreated":"2021-04-10T01:55:23+0000","dateUpdated":"2022-12-22T17:41:31+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eLexisNexis used AWS to build a tool that reduces manual legal research time and facilitates high-quality brief building. A provider of legal research services, LexisNexis discovered that litigators spend 70\u0026ndash;80 percent of their time researching and writing briefs, so it used Amazon OpenSearch Service to launch Brief Analysis, an artificial intelligence\u0026ndash;powered tool that searches a database of 27 million legal documents to provide customized recommendations for legal briefs. The tool canvases the database in 11 seconds, reducing the time and effort litigators take to research and increasing the quality of briefs.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/lexisnexis-logo-1x.73d60c82358ebcf6a52a09163e3f2cdaf81cf795.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2021-04-09","headlineUrl":"https://aws.amazon.com/solutions/case-studies/lexisnexis-analysis-tool-aws-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"LexisNexis","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"LexisNexis Builds AI-Powered Legal Brief Analysis Tool Using AWS"}},"tags":[{"id":"customer-reference