ry","name":"Business Resilience","description":"\u003cp\u003eIn business, resilience means dealing with adversity and shocks, and continuously adapting for growth.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:01:43+0000","dateUpdated":"2023-07-14T01:01:43+0000"},{"id":"customer-references#category#cloud-operations","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cloud Operations","description":"\u003cp\u003eAWS Cloud Operations provides a model and tools for a secure and efficient way to operate in the cloud. This is an initiative, not a product.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:05:06+0000","dateUpdated":"2023-07-14T01:05:06+0000"}]},{"item":{"id":"customer-references#fractal-analytics","locale":"en_US","directoryId":"customer-references","name":"fractal-analytics","dateCreated":"2024-07-01T19:15:26+0000","dateUpdated":"2025-01-23T23:19:10+0000","additionalFields":{"descriptionSummary":"Fractal Analytics used generative AI powered by Amazon Bedrock and Amazon EKS to develop a unified knowledge base for knowledge workers, increasing employee and customer satisfaction while improving call center agent efficiency.","featured":"0","featureImageURL":"https://d1.awsstatic.com/customer-references-case-studies-logos/fractal-analytics-innovator-hub.ee97481696ad09b67b2bcd3f9bb9ad11102e1edb.png","imageSrcUrl":"https://d1.awsstatic.com/partner-network/partner_marketing_web_team/directories-logos/300x50_Fractal.494c92007257631b7298711ccfe63fae756fd7c4.png","displayLocation":"India","customerNameLower":"fractal analytics","footerInfoText":"Published Date","description":"Fractal Analytics used generative AI powered by Amazon Bedrock and Amazon EKS to develop a unified knowledge base for knowledge workers, increasing employee and customer satisfaction while improving call center agent efficiency.","industry":"Software \u0026 Internet","sortDate":"2024-06-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/fractal-analytics-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Fractal Analytics","publishedDate":"2024","enableShare":"1","headline":"Fractal Analytics Reduces Call Handling Time by Up to 15% with Generative AI on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u00