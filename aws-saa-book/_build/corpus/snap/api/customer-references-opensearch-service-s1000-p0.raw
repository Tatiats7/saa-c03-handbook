duct#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#novartis05162022kjlsdnflkafd","locale":"en_US","directoryId":"customer-references","name":"novartis05162022kjlsdnflkafd","dateCreated":"2023-02-08T01:17:33+0000","dateUpdated":"2023-07-12T01:35:19+0000","additionalFields":{"descriptionSummary":"Procuring lab supplies required manual comparison of item prices in several vendor catalogs. Overspending, inventory mismanagement, and delays for R\u0026D and production. Novartis Buying Engine solves this challenge by providing a centralized purchasing platform with search and recommendations. Catalog data is automatically extracted from unstructured vendor catalogs using Machine Learning with Amazon SageMaker. Data is stored in DynamoDB, Neptune, and OpenSearch. The shopping portal itself is fully serverless, being hosted on Lambda and Api Gateway.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/Novartis_Customer-Reference_Logo%402x1.d5822f831bf752cc9cc91350e9a3e893d0052c02.png","displayLocation":"United States","customerNameLower":"novartis ag","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2022-05-16","headlineUrl":"https://youtu.be/vp8oPiHN4cA?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Novartis AG","publishedDate":"2022","enableShare":"1","headline":"Novartis - Buying Engine: AI-powered Procurement Portal","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u