dian fintech company KOHO migrated its data warehouse to AWS to achieve near-real-time data analytics, reduce costs, and improve security. KOHO also developed its Instant Pay solution in 3 months using AWS.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/koho-logo%401x.eb353a2b9dac4c815fa9814008365cffe0e46fd1.png","displayLocation":"Canada","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-03-18","headlineUrl":"https://aws.amazon.com/solutions/case-studies/koho-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"KOHO Financial","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"KOHO Uses AWS to Bring Canadians Lower Personal Finance Costs and Access to Same-Day Pay"}},"tags":[{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"customer-references#category#finserv","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Financial Services","description":"Financial Services","dateCreated":"2019-07-22T18:31:53+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"GLOBAL#product#fraud-detector","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Fraud Detector","description":"Amazon Fraud Detector","dateCreated":"2020-12-08T20:11:57+0000","dateUpdated":"2022-02-03T03:32:37+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"202