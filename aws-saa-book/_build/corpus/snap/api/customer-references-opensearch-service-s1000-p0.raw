ields":{"featured":"0","descriptionSummary":"After deciding on its strategy to pursue a cloud computing–based digital transformation, Swire Coca-Cola made another bold decision to close its three on-premises production and disaster recovery data centers and migrate all of its business systems, including SAP and its CRM, to AWS. Swire Coca-Cola, a division of Swire, has the exclusive right to manufacture, market, and distribute products of the Coca-Cola Company in 11 Chinese provinces, the Shanghai Municipality, Hong Kong, Taiwan, and also an extensive area of the western US—representing a total customer base of 728 million people.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/coca-cola-logo%401x.4c9be67ec52d063bf4c44c482d50900e4bad7129.png","displayLocation":"China","footerInfoText":"Published Date","industry":"Consumer Goods","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/swire-coca-cola/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Swire Coca-Cola","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Swire Coca-Cola Case Study"}},"tags":[{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#t