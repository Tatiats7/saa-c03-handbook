AL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"}]},{"item":{"id":"customer-references#mcredit-case-study","locale":"en_US","directoryId":"customer-references","name":"mcredit-case-study","dateCreated":"2021-09-11T00:48:09+0000","dateUpdated":"2022-12-19T23:24:29+0000","additionalFields":{"descriptionSummary":"Mcredit migrated from an on-premises infrastructure to AWS to gain agility and boost automation as part of a renewed digital strategy, lowering its time to market from four months to three weeks. The FinTech firm is a joint venture between Vietnam-based Military Bank and Japan-based Shinsei Bank. The company is using Amazon EKS to orchestrate its fully containerized infrastructure, Amazon Redshift as a data warehouse, and Amazon Direct Connect for secure networking.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Mcredit_logo%401x.d13bb24e8cc3f8572c54bbed0b92a679966e2fb5.png","displayLocation":"Vietnam","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2021-09-10","headlineUrl":"https://aws.amazon.com/solutions/case-studies/mcredit-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Mcredit","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Mcredit Offers an Omnichannel Banking Experience with Data-Driven Transformation on AWS"}},"tags":[{"id":"customer-references#category#finserv","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Financial Services","description":"Financial Services","dateCreated":"2019-07-22T18:31:53+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#loca