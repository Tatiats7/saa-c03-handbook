"dateCreated":"2020-04-29T05:19:31+0000","dateUpdated":"2022-02-03T03:31:09+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#zixi05022022jpiwejfjwegkm","locale":"en_US","directoryId":"customer-references","name":"zixi05022022jpiwejfjwegkm","dateCreated":"2023-02-08T01:17:36+0000","dateUpdated":"2023-07-14T23:32:37+0000","additionalFields":{"descriptionSummary":"Zixi is the industry leader for enabling dependable, live broadcast-quality video over any IP network, any protocol, any cloud and any edge device. In this episode, Head of Product, Tim Baldwin, and SA Lana Kalashnyk explore the solutions architecture driving Zixi\u0027s Software-Defined Video Platform offers cloud-based technologies for broadcasters, enterprises, over-the-top video providers, and mobile service providers around the world. Services used are Amazon EC2, Amazon DynamoDB, Amazon RDS and AWS Elemental Media Services like Elemental and Elemental Media Connect Live that make up Zixi\u0027s data plane.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/zixi-logo%401x.367e738db7e4e1181baf60b1339283bca54c7d9f.jpg","displayLocation":"United States","customerNameLower":"zixi","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-05-02","headlineUrl":"https://youtu.be/ODRfIikoU9s?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Zixi","publishedDate":"2022","enableShare":"1","headline":"Zixi: Managing In-Field Media Encoders with the Zen Master Control Plane","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#elemental-medialive","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental MediaLive","description":"AWS Elemental MediaLive","dateCreated":"2020-03-02T07:03:15+0000","dateUpdated":"2022-02-03T03:32:35+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#metho