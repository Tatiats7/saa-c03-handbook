ishedDate":"2025","enableShare":"1","headline":"Improving Cost Efficiency by 40% Using Amazon Managed Service for Prometheus with Choice Hotels","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2023-07-15T01:16:11+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#managed-prometheus","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Managed Service for Prometheus","description":"Amazon Managed Service for Prometheus","dateCreated":"2021-11-17T07:15:37+0000","dateUpdated":"2022-02-03T03:32:49+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#business-category#cloud-cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-06-05T07:06:41+0000","dateUpdated":"2022-02-03T03:31:02+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"}]},{"item":{"id":"customer-references#crece-mas-facele-2025","locale":"en_US","directoryId":"customer-references","name":"crece-mas-facele-2025","dateCreated":"2025-02-20T17:07:34+0000","dateUpdated":"2025-03-06T22:14:11+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eCrece M\u0026aacute;s, a company devoted to helping entrepreneurs thrive, wanted to develop a platform to give small businesses tools to automate operations and grow\u0026mdash;but struggled to secure funding. With the help of AWS Partner Facele and Amazon Web Services (AWS) infrastructure, Crece M\u0026aacute;s secured funding to develop a platform to manage inventory, sales, deliveries, and more. With an impressive new application, Crece M\u0026aacute;s has grown its customer base by 45 percent in just six months. The platform allows small businesses to scale, increase sales by up to 45 percent, and reduce operational costs by 25 percent, helping them expand into new markets and contribute to regional economic growth.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Crece%20Mas%20Logo%20200x70px.24bae09527c63c15db17ebc44198b6d8e608051a.png","displayLocation":"Chile","footerInfoText":"2025","industry":"Financial Services","sortDate":"2025-02-20","headlineUrl":"https://aws.amazon.com/solutions/case-studies/crece-mas-facele/","customer-name":"Crece Mas","enableShare":"1","publishedDate":"2025","contentType":"Case Study","headline":"Crece Más Drives 45% Sales Growth for Small Businesses with Facele and AWS"}},"tags":[{"id":"GLOBAL#product#quicksight","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon QuickSight","description":"Amazon QuickSight","dateCreated":"2020-03-02T07:04:56+0000","dateUpdated":"2022-02-03T03:32:55+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#location#chile","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Chile","description":"Chile","dateCreated":"2020-07-02T22:30:55+0000","dateUpdated":"2022-02-03T03:31:32+0000"}]},{"item":{"id":"customer-references#manz-tecracer-consulting-2025","locale":"en_US","directoryId":"customer-references","name":"manz-tecracer-consulting-2025","dateCreated":"2025-02-14T21:53:35+0000","dateUpdated":"2025-03-06T23:43:26+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eMANZ, an Austrian company that provides information services for legal and tax professionals, sought to revolutionize how its registered users searched its vast repository of legal documents. With over 300 million documents in its database, MANZ aimed to implement a cutting-edge solution using vector embeddings to enhance similarity searches and uncover deeper connections between documents. In collaboration with AWS Partner tecRacer Consulting, MANZ developed and successfully deployed a powerful solution, which reduced deployment times and empowered MANZ to independently develop and refine its solution.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/MANZ%20Logo%20200x70px.03a035a7391f8c8c8b804db0b9112579e95df995.png","displayLocation":"Austria","footerInfoText":"2025","industry":"General Public Services","sortDate":"2025-02-14","enableShare":"1","headlineUrl":"https://aws.amazon.com/solutions/case-studies/manz-tecracer-consulting/","publishedDate":"2025","contentType":"Case Study","headline":"Accelerating Semantic and Similar Search Functions for a Leading Legal Publisher"}},"tags":[{"id":"GLOBAL#location#austria","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Austria","description":"Austria","dateCreated":"2020-02-03T05:29:53+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#neptune","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Neptune","description":"Amazon Neptune","dateCreated":"2020-03-02T07:04:40+0000","dateUpdated":"2022-02-03T03:32:52+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"GLOBAL#industry#general-public-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"General Public Services","description":"General Public Services","dateCreated":"2020-01-16T17:42:24+0000","dateUpdated":"2022-02-03T03:32:04+0000"}]},{"item":{"id":"customer-references#arre-voice-datastax-2025","locale":"en_US","directoryId":"customer-references","name":"arre-voice-datastax-2025","dateCreated":"2025-02-04T23:15:35+0000","dateUpdated":"2025-03-06T23:39:05+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eArr\u0026eacute; Voice wanted to enhance user engagement on its digital media platform with personalized content recommendations. The company needed a scalable solution capable of processing large volumes of user data while supporting artificial intelligence (AI)-driven algorithms for content personalization. By transitioning to a microservices architecture, using Amazon Web Services (AWS), and implementing Astra DB, a vector database from AWS Partner DataStax, Arr\u0026eacute; Voice enabled real-time data handling and improved operational efficiency. Astra DB\u0026rsquo;s query capabilities and developer tools facilitated the rapid development of its recommendation engine, which now generates over 30 million personalized suggestions per month with a 90-percent reduction in latency.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Arre%20Voice%2070x70px.c3c3852c2c4626d9d1a9aee0c45f65f0dc108eb5.png","displayLocation":"India","footerInfoText":"2025","industry":"Media \u0026 Entertainment","sortDate":"2025-02-04","headlineUrl":"https://aws.amazon.com/partners/success/arre-voice-datastax/","customer-name":"Arré Voice","enableShare":"1","publishedDate":"2025","contentType":"Case Study","headline":"Arré Voice Enhances User Engagement and Reduces Latency by 90% with DataStax Astra DB and AWS"}},"tags":[{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"GLOBAL#product#neptune","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Neptune","description":"Amazon Neptune","dateCreated":"2020-03-02T07:04:40+0000","dateUpdated":"2022-02-03T03:32:52+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","