category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"}]},{"item":{"id":"customer-references#autodesk-log-analytics-case-study","locale":"en_US","directoryId":"customer-references","name":"autodesk-log-analytics-case-study","dateCreated":"2019-07-19T15:11:08+0000","dateUpdated":"2023-07-19T03:04:59+0000","additionalFields":{"featured":"0","descriptionSummary":"Autodesk uses AWS to detect and fix application problems faster, improve log file analytics, and create an enterprise unified log data solution with a small IT team. The company creates software used by organizations in the architecture, engineering, construction, manufacturing, media, and entertainment industries.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/autodesk-logo-2022%401x.c2c78e83fe77cfbe57e586f0465bf8f70e5089ce.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eAutodesk uses AWS to detect and fix application problems faster, improve log file analytics, and create an enterprise unified log data solution with a small IT team. The company creates software used by organizations in the architecture, engineering, construction, manufacturing, media, and entertainment industries. Autodesk created a unified log data solution on AWS, taking advantage of Amazon OpenSearch Service and other AWS services.\u003c/p\u003e\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/autodesk-log-analytics/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Autodesk Log Analytics","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Autodesk Log Anal