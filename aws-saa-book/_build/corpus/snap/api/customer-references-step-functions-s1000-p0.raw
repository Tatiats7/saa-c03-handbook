-01T23:09:46+0000","dateUpdated":"2023-06-08T04:07:35+0000","additionalFields":{"descriptionSummary":"ADL Digital Lab (ADL) es uno de los mayores laboratorios digitales en América Latina. La empresa nació en 2017 con el objetivo de promover la transformación digital de las más de 200 entidades que forman el holding de Grupo Aval. Uno de los desafíos de ADL Digital Lab se relacionaba a la necesidad de aumentar la cantidad de créditos por cliente del Banco de Occidente, una de las instituciones del conglomerado.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/adl_logo%401x.8fa483c5a03d175abbad40d66f20bad9bbb2d54d.png","displayLocation":"Colombia","footerInfoText":"Fecha de publicación","industry":"Servicios financieros","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/banco-de-occidente/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"Historia del cliente","customer-name":"Banco de Occidente","headline":"Digitalización de servicios para aumentar penetración de productos de Banco de Occidente"}},"tags":[{"id":"GLOBAL#product#step-functions","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Step Functions","description":"AWS Step Functions","dateCreated":"2020-03-02T07:05:39+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#use-case#data-lakes","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Data Lakes","description":"Data Lakes","dateCreated":"2020-06-05T06:37:09+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000","dateUpdated":"2022-02-0