rprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#location#dach","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"DACH","description":"DACH","dateCreated":"2020-02-03T05:29:52+0000","dateUpdated":"2022-02-03T03:31:47+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"}]},{"item":{"id":"customer-references#marathonoil03162022lnkasefliisfsnflk","locale":"en_US","directoryId":"customer-references","name":"marathonoil03162022lnkasefliisfsnflk","dateCreated":"2022-05-23T21:42:19+0000","dateUpdated":"2023-07-12T01:40:45+0000","additionalFields":{"descriptionSummary":"Marathon Oil is an independent energy company engaged in hydrocarbon exploration and performs regular drone flights of well pads as part of its program for emissions monitoring and plant maintenance. To automate the processing of their drone flight imagery, Marathon Oil leverages a serverless architecture on AWS. Marathon Oil runs CloudWatch events on a scheduled basis to trigger a state machine in AWS Step Functions. The event-driven architecture then calls a series of AWS Lambda functions to determine when new images are available for processing, store the images on Amazon S3, and further optimize the images in Amazon S3. \n\nWith the images in Amazon S3, AWS Storage Gateway allows the team to access image files from their on-prem mapping applications to Amazon S3 without re-writing their existing applications. With this architecture, Marathon Oil\u0027s maintenance and operations teams are able to automate the entire workflow process to detect anomalies in their well pads for health checks and preventative maintenance.","displayLocation":"United States","footerInfoText":"Published Date","industry":"Oil \u0026 Gas","sortDate":"2022-03-16","headlineUrl":"https://youtu.be/ww5fiygF6eg?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Marathon Oil: Automating Drone Image Processing to Monitor Equipment Health","customer-name":"Marathon Oil Corporation"}},"tags":[{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"GLOBAL#product#step-functions","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Step Functions","description":"AWS Step Functions","dateCreated":"2020-03-02T07:05:39+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"customer-references#category#business-productivity","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Productivity","description":"Business Productivity","dateCreated":"2019-07-22T18:31:25+0000","dateUpdated":"2022-05-23T21:40:03+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#business-category#cloud-cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-06-05T07:06:41+0000","dateUpdated":"2022-02-03T03:31:02+0000"},{"id":"GLOBAL#content-type#reference-arch-diagram","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Reference Architecture Diagram","description":"Reference Architecture Diagram","dateCreated":"2020-04-29T05:19: