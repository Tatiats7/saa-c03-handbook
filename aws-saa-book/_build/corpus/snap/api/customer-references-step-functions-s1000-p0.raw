{"items":[{"item":{"id":"customer-references#6-lessons-game-developers-can-learn-from-epic-games-cloud-governance-strategy","locale":"en_US","directoryId":"customer-references","name":"6-lessons-game-developers-can-learn-from-epic-games-cloud-governance-strategy","dateCreated":"2025-05-20T22:18:49+0000","dateUpdated":"2025-05-20T22:21:02+0000","additionalFields":{"descriptionSummary":"For game studios large and small, a smart cloud governance strategy can go a long way in reducing costs and increasing security for a live service game. Following are a few key learnings from Epic Games’ work with Amazon Web Services (AWS) that game developers should consider when developing a cloud governance strategy.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/EpicGames_Customer-Reference_Logo.8a439eccad8e4f56fc6f9733371dfecc459b5ba3.png","displayLocation":"United States","customerNameLower":"epic games","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2025-03-12","headlineUrl":"https://aws.amazon.com/blogs/gametech/6-lessons-game-developers-can-learn-from-epic-games-cloud-governance-strategy/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Epic Games","publishedDate":"2025","enableShare":"1","headline":"6 lessons game developers can learn from Epic Games’ cloud governance strategy","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#product#step-functions","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Step Functions","description":"AWS Step Functions","dateCreated":"2020-03-02T07:05:39+0000