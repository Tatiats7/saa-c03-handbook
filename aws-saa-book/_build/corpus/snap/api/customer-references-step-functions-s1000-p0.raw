 Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#tech-category#gen-ai","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Generative AI","description":"\u003cp\u003eGenerative AI\u003c/p\u003e\n","dateCreated":"2023-08-22T20:28:41+0000","dateUpdated":"2024-05-23T20:34:52+0000"},{"id":"customer-references#category#gen-ai","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gen AI","description":"\u003cp\u003eGenerative Artificial Intelligence\u003c/p\u003e\n","dateCreated":"2023-07-10T17:07:31+0000","dateUpdated":"2023-07-10T17:07:31+0000"}]},{"item":{"id":"customer-references#hospital-sirio-libanes-ia-generativa","locale":"en_US","directoryId":"customer-references","name":"hospital-sirio-libanes-ia-generativa","dateCreated":"2024-08-16T12:46:09+0000","dateUpdated":"2024-08-16T12:49:27+0000","additionalFields":{"descriptionSummary":"Com uma área construída de aproximadamente 100 mil m² no bairro da Bela Vista, em São Paulo, além de um hospital de alta complexidade em Brasília, o Hospital Sírio-Libanês (HSL) atende mais de 60 especialidades e conta com mais de 500 leitos. A instituição alia um corpo clínico multidisciplinar a tecnologias de última geração. Ao longo dos anos, acumulou conquistas pioneiras, como a inauguração da primeira Unidade de Terapia Intensiva (UTI) no Brasil, em 1971, e a participação na primeira tele cirurgia guiada por robô realizada no hemisfério Sul, em 2000.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/hospital-sirio-libanes.9f73ab6bce199ddec9a3491f53bd232e7fcd2b7d.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/hospital-sirio-libanes.9f73ab6bce199ddec9a3491f53bd232e7fcd2b7d.png","displayLocation":"Brazil","customerNameLower":"hospital sírio-libanês","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2024-07-15","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/hospital-sirio-libanes-ia-generativa/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Hospital Sírio-Libanês","publishedDate":"2024","enableShare":"1","headline":"Sírio-Libanês usa IA generativa AWS para reduzir em 99% o tempo de geração de relatórios","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateC