ion":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"customer-references#category#customer-engagement","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2019-07-22T18:31:37+0000","dateUpdated":"2022-03-21T23:37:45+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#elastic-beanstalk","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elastic Beanstalk","description":"AWS Elastic Beanstalk","dateCreated":"2020-03-02T07:03:00+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#business-category#cust-engagement","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2020-06-05T07:06:46+0000","dateUpdated":"2022-02-03T03:31:03+0000"}]},{"item":{"id":"customer-references#purple-case-study","locale":"en_US","directoryId":"customer-references","name":"purple-case-study","dateCreated":"2022-10-25T22:40:14+0000","dateUpdated":"2023-07-14T23:32:35+0000","additionalFields":{"descriptionSummary":"FinTech company Purple Technology builds applications and services for brokerage firms to onboard customers efficiently. End users self-manage their accounts and portfolios, which leaves brokerages free to focus on core functions such as client services and risk management. Users creating new trading accounts with brokers need to follow a stringent onboarding process that complies with complex rules and regulations to verify their identities. Using AWS, Purple has simplified the way these rulesets are coded into the app, making it easier for non-technical employees to manage the application and keep on top of changing regulations.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/purple-technology-logo%401x.fbb96daabb3b5b3ace0589eff8a2419ab13749ec.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"purple","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-10-24","headlineUrl":"https://aws.amazon.com/solutions/case-studies/purple-technology-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Purple","publishedDate":"2022","enableShare":"1","headline":"Purple Technology Responds Rapidly to Changing Regulations and Customer Needs Using AWS","contentType":"Customer Story"}},"tags":[{"id":"customer-references#category#mgmt-governance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2019-07-22T18:32:10+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17: