ion":"Israel","dateCreated":"2020-02-03T05:30:21+0000","dateUpdated":"2022-02-03T03:31:55+0000"}]},{"item":{"id":"customer-references#healthfirst20200629sdlkdfhj","locale":"en_US","directoryId":"customer-references","name":"healthfirst20200629sdlkdfhj","dateCreated":"2022-05-23T21:41:50+0000","dateUpdated":"2023-07-14T23:32:28+0000","additionalFields":{"descriptionSummary":"Wrangling data from increasingly more sources can become unwieldy. In this episode of \u0027This is my Architecture\u0027, we revisit Healthfirst\u0027s Secure Analytics Platform (https://youtu.be/ZqFWOQyQaNQ) to see how they have extended their solution with AWS CloudFormation, Amazon SQS, AWS Step Functions and AWS Lambda to improve coordination of data pipelines. We also learn how they leverage Amazon SageMaker to introduce Machine Learning to their data, to better identify risks factors in determinance of health outcomes.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/healthfirst-logo%401x.327da8037f4b8a0110149a4ce0bdd5ae95bc1479.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2020-06-29","headlineUrl":"https://youtu.be/XpFNznmRoQ0?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","customer-name":"Healthfirst","contentType":"Customer Story","headline":"Healthfirst: Wrangling Data the Event Driven Way"}},"tags":[{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video"