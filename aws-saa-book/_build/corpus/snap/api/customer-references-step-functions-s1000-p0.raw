ateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#amplify","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Amplify","description":"AWS Amplify","dateCreated":"2020-03-02T07:01:21+0000","dateUpdated":"2022-02-03T03:32:15+0000"}]},{"item":{"id":"customer-references#denso-corporation","locale":"en_US","directoryId":"customer-references","name":"denso-corporation","dateCreated":"2021-11-06T04:54:02+0000","dateUpdated":"2021-12-22T23:17:28+0000","additionalFields":{"descriptionSummary":"DENSO Corporation used Amazon SageMaker to accelerate the creation of machine learning models for image recognition sensors in automobiles, improving productivity and reducing costs by 20 percent.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/denso-logo%401x.8b710b1c1516236e062d893222dce8cca2c4d4a2.png","displayLocation":"Japan","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2021-11-05","headlineUrl":"https://aws.amazon.com/solutions/case-studies/denso-corporation/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"DENSO Automates ML Model Development for Driving Support Using Amazon SageMaker, Reduces Work Time by 55%–66%","customer-name":"DENSO Corporation"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#fsx-lustre","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon FSx for Lustre","description":"Amazon F