d":"2019-07-22T18:32:05+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#industry#energy","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Energy","description":"Energy","dateCreated":"2020-07-15T21:58:51+0000","dateUpdated":"2022-02-03T03:32:02+0000"},{"id":"GLOBAL#industry#oil-gas","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Oil \u0026 Gas","description":"Oil \u0026 Gas","dateCreated":"2020-01-16T17:42:36+0000","dateUpdated":"2022-02-03T03:32:07+0000"}]},{"item":{"id":"customer-references#wynkmusic-eks","locale":"en_US","directoryId":"customer-references","name":"wynkmusic-eks","dateCreated":"2021-09-11T00:48:54+0000","dateUpdated":"2021-12-22T23:24:48+0000","additionalFields":{"descriptionSummary":"By running its music app’s content discovery platform on AWS, Wynk Music grew its monthly active user pool from 50 million to 72 million, and improved user interaction with a 39 percent increase in clickthrough rate to its homepage. Using Amazon Elastic Kubernetes Service (Amazon EKS) and Amazon EMR, the team has 100 microservices live in production at any time and reduced development time from two weeks to four days.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Wynk_logo%401x.3ff1ed171fdd0f3dd986f6e2bb9bdfa2042346fc.png","displayLocation":"India","footerInfoText":"Published Date","industry":"Telecommunications","sortDate":"2021-09-10","headlineUrl":"https://aws.amazon.com/solutions/case-studies/wynkmusic-eks/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Wynk Music App by Airtel Raises the User Experience Bar with Amazon EKS","customer-name":"Wynk Music"}},"tags":[{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#language#english","locale":"en_US"