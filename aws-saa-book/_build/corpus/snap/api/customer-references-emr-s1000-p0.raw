language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#power-utilities","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Power \u0026 Utilities","description":"Power \u0026 Utilities","dateCreated":"2020-01-16T17:42:37+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#industry#oil-gas","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Oil \u0026 Gas","description":"Oil \u0026 Gas","dateCreated":"2020-01-16T17:42:36+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"customer-references#industry#pu-og-energy","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"pu-og-energy","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/power-and-utilities/case-studies/ and/or aws.amazon.com/energy/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from multiple tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:35:16+0000","dateUpdated":"2023-04-26T20:35:16+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#bandera-electric-cooperative","locale":"en_US","directoryId":"customer-references","name":"bandera-electric-cooperative","dateCreated":"2021-10-27T02:42:31+0000","dateUpdated":"2023-07-12T01:40:42+0000","additionalFields":{"descriptionSummary":"Bandera Electric Cooperative created an energy analytics solution that lets consumers monitor their energy usage in near real time using Amazon KDS and AWS IoT Events.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/bandera-electric-cooperative%401x.8ce689d889a500c2308594ec43ada38b06fce3f5.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Power \u0026 Utilities","sortDate":"2021-10-26","headlineUrl":"https://aws.amazon.com/solutions/case-studies/bandera-electric-cooperative/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","customer-name":"Bandera Electric Cooperative","contentType":"Customer Story","headline":"Bandera Electric Cooperative Develops Smart Energy Analytics Solution Using AWS IoT"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated