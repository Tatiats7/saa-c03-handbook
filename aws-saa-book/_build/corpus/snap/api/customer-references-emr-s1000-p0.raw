Created":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#viewfin-metaverse-case-study","locale":"en_US","directoryId":"customer-references","name":"viewfin-metaverse-case-study","dateCreated":"2019-07-19T15:11:17+0000","dateUpdated":"2023-07-14T23:32:46+0000","additionalFields":{"featured":"0","descriptionSummary":"With AWS, ViewFin Metaverse is able to build a secure, stable, and dependable blockchain-as-a-service (BaaS) platform to provide blockchain-based digital solutions to customers from a wide range of sectors including finance, business, art, and medical. ViewFin Metaverse is a fintech company focusing on blockchain technologies; its main offerings include Metaverse and Metaverse BaaS.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/China/yuanjie-logo.c3892cb3d8701ec8481321e6fdafb35de38e9822.jpg","displayLocation":"China","footerInfoText":"Published Date","description":"\u003cp\u003eWith AWS, ViewFin Metaverse is able to build a secure, stable, and dependable blockchain-as-a-service (BaaS) platform to provide blockchain-based digital solutions to customers from a wide range of sectors including finance, business, art, and medical. ViewFin Metaverse is a fintech company focusing on blockchain technologies; its main offerings include Metaverse and Metaverse BaaS. Amazon Web Services used by ViewFin Metaverse include Amazon EC2, Amazon S3, Amazon CloudWatch, Amazon DynamoDB, Amazon RDS, Amazon EMR, Amazon RedShift, Amazon Kinesis, Amazon Kinesis Firehose, Amazon ElastiCache, Amazon Elastic Container Registry (Amazon ECR), AWS IAM, and AWS Developer Support.\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/viewfin/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ViewFin Metaverse","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"ViewFin Metaverse Case Study"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","date