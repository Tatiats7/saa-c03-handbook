"dateCreated":"2023-04-26T20:35:16+0000","dateUpdated":"2023-04-26T20:35:16+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#industry#electronics","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Electronics","description":"Electronics","dateCreated":"2020-06-25T04:07:00+0000","dateUpdated":"2022-02-03T03:32:02+0000"},{"id":"GLOBAL#industry#semiconductors","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Semiconductors","description":"Semiconductors","dateCreated":"2020-08-31T04:01:50+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"customer-references#category#hcls","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Healthcare \u0026 Life Sciences","description":"Healthcare \u0026 Life Sciences","dateCreated":"2019-07-22T18:31:58+0000","dateUpdated":"2022-05-14T20:13:37+0000"}]},{"item":{"id":"customer-references#aws-case-study-vivaki","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-vivaki","dateCreated":"2019-07-22T20:00:26+0000","dateUpdated":"2021-12-22T19:46:20+0000","additionalFields":{"featured":"0","descriptionSummary":"VivaKi, a subsidiary of the french advertising company Publicis Groupe, needed to process and analyze large amounts of data quickly in order to adjust advertising campaign and maximize return on investment. By using AWS, VivaKi can process more data simultaneously while reducing operating expenses by nearly 75 percent.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Vivaki_Customer-Reference_Logo.2fdfaee3fb381d9b1dd360935a22189d13a16c08.png","displayLocation":"France","footerInfoText":"Published Date","description":"\u003cp\u003eVivaKi, a subsidiary of the french advertising company Publicis Groupe, needed to process and analyze large amounts of data quickly in order to adjust advertising campaign and maximize return on investment. By using AWS, VivaKi can process more data simultaneously while reducing operating expenses by nearly 75%\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/vivaki/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"VivaKi","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: VivaKi"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"G