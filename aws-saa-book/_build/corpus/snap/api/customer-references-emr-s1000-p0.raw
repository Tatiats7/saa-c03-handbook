https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/HGData_Customer-Reference_Logo.817166c3f2bcee734c3aca38f98c406021c2b04b.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eHG Data provides a database of competitive intelligence for the technology industry and measures success by responding quickly to customer demand. By building its competitive intelligence database on AWS, the company can index billions of documents daily, use APIs to automate operations, and respond to customer data requests in hours instead of months. Furthermore, the company estimates reducing CAPEX by at least 50 percent.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/hg-data/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"HG Data","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: HG Data"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"C