-rocks#aws-for-data","locale":"en_US","tagNamespaceId":"customer-references#big-rocks","name":"AWS for Data","description":"\u003cp\u003eAWS for Data is a marketing \u0026ldquo;Big Rock\u0026rdquo; initiative that tells the story around how AWS can provide the most comprehensive set of data capabilities spanning databases, analytics, business intelligence, and machine learning for an end-to-end data strategy.\u003c/p\u003e\n","dateCreated":"2024-02-14T22:32:15+0000","dateUpdated":"2024-02-14T22:32:15+0000"}]},{"item":{"id":"customer-references#choice-hotels-tco-case-study","locale":"en_US","directoryId":"customer-references","name":"choice-hotels-tco-case-study","dateCreated":"2023-01-30T22:40:02+0000","dateUpdated":"2024-02-20T22:26:15+0000","additionalFields":{"descriptionSummary":"Choice Hotels International migrated its Apache Airflow environment to Amazon MWAA and simplified infrastructure management for its engineers, reduced TCO, and improved its security and uptime.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/Choice-Hotels_Customer-Reference_Logo@2x.42fd0de6ab2ff470b0c92e8c41940bb268b6b6f8.png","displayLocation":"United States","customerNameLower":"choice hotels international","footerInfoText":"Published Date","industry":"Hospitality","sortDate":"2023-01-09","headlineUrl":"https://aws.amazon.com/solutions/case-studies/choice-hotels-tco-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Choice Hotels International","publishedDate":"2023","enableShare":"1","headline":"Choice Hotels Decreases Total Cost of Ownership Using Amazon MWAA","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"customer-references#category#app-integration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Application Integration","description":"Application Integration","dateCreated":"2019-07-22T18:30:54+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#mwaa","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Managed Workflows for Apache Airflow (MWAA)","description":"Amazon Managed Workflows for Apache Airflow (MWAA)","dateCreated":"2021-08-28T07:04:25+0000","dateUpdated":"2022-02-03T03:32:52+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"customer-references#business-outcome#cost-optimization","locale":"en_US","tagNamespaceId":"customer-references#business-outcome","name":"cost-optimization","description":"Cost Optimization","dateCreated":"2019-07-22T18:39:02+0000","dateUpdated":"2019-07-22T18:39:02+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2023-07-15T01:16:11+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"}]},{"item":{"id":"customer-references#unimed-case-storage","locale":"en_US","directoryId":"customer-references","name":"unimed-case-storage","dateCreated":"2023-06-01T23:04:44+0000","dateUpdated":"2023-07-12T01:35:23+0000","additionalFields":{"descriptionSummary":"Com mais de 5 mil médicos cooperados e mais de 1,48 milhão de clientes em 34 municípios mineiros, em 2018, a Unimed BH iniciou a construção de um ambiente em nuvem flexível, seguro e capaz de trabalhar com informação em tempo real.Cynthia Araujo, gerente de desenvolvimento de informação para o negócio da Unimed BH, explica que a cooperativa escolheu trabalhar com a AWS não apenas pela inovação dos serviços oferecidos, mas também pela postura de parceria demonstrada pela companhia. A especialista conta que a instituição começou usando Amazon Simple Storage Service (Amazon S3) e depois evoluiu para produtos como Amazon SageMaker, automatizando cerca de 35% das autorizações médicas e ganhando capacidade de trabalhar dados para oferecer cuidado integrado aos clientes e apoiar programas de atenção à saúde do idoso e gestante.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/Latam%20Cases%20Assets/Unimed_BH_LOGO1.f2aa4f715aaf597e713ba3ef1bc9d24f76ca7ab7.jpg","displayLocation":"Brasil","customerNameLower":"unimed bh","footerInfoText":"Data de publicação","industry":"Saúde","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/unimed-case-storage/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Unimed BH","enableShare":"1","publishedDate":"2023","contentType":"História do cliente","headline":"Com AWS, Unimed BH reduz para 1,5 minuto as respostas de autorizações médicas"}},"tags":[{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry"