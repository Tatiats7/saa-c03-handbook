s":{"featured":"0","featureImageURL":"https://d1.awsstatic.com/aws-key-pages/homepage-key-pages/customer-stories-logo/GE.69d638be1bb211236c8d87590e8ee0be001b543c.jpg","descriptionSummary":"\u003cp\u003eGeneral Electric (GE) is migrating more than 9,000 workloads, including 300 disparate ERP systems, to AWS while reducing its datacenter footprint from 34 to four. The company is the world\u0026#39;s Digital Industrial Company, transforming industry with software-defined machines and solutions that are connected, responsive, and predictive.\u003c/p\u003e\r\n","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/GEPower_Customer-Reference_Logo.7100af15f7461bdc2ea9edec4f9b61e536c54f48.png","displayLocation":"Americas","customerNameLower":"ge healthcare","footerInfoText":"Published Date","description":"\u003cp\u003eCombining engineering with analytics to help people work more efficiently and safely\u003c/p\u003e\r\n","industry":"Electronics \u0026 Semiconductors","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/general-electric/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"GE Healthcare","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"General Electric on AWS"}},"tags":[{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:4