orage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#customer-enablement#skills-guild","locale":"en_US","tagNamespaceId":"customer-references#customer-enablement","name":"Skills Guild","description":"\u003cp\u003eTag created in response to this request: https://issues.amazon.com/CSDIR-298\u003c/p\u003e\n\n\u003cp\u003eAWS Skills Guild is a consultative engagement designed to inspire organization-wide cloud adoption and unlock innovation. It accelerates the cultural and technological shifts necessary for transformation by helping develop and launch a bespoke cloud enablement initiative using the AWS Skills Guild framework. Each engagement uses cloud excitement, skills application, and community development to layer formal education with hands-on training activities \u0026ndash; ultimately increasing cloud skill confidence and igniting a culture of continuous learning.\u003c/p\u003e\n","dateCreated":"2023-07-05T23:40:01+0000","dateUpdated":"2023-07-05T23:40:01+0000"}]},{"item":{"id":"customer-references#605-llc-case-study","locale":"en_US","directoryId":"customer-references","name":"605-llc-case-study","dateCreated":"2021-11-13T00:56:42+0000","dateUpdated":"2022-12-14T00:51:28+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eIndependent TV measurement firm 605 LLC uses Amazon FSx for Lustre to efficiently process data from over 21 million households, reducing costs by 50 percent and deployment times from 2 hours to minutes.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/605-LLC_Logo%401x.42ede77484383a235960703bcfb2d26d429241df.png","displayLocatio