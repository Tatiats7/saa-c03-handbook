ame":"Semiconductors","description":"Semiconductors","dateCreated":"2020-08-31T04:01:50+0000","dateUpdated":"2022-02-03T03:32:07+0000"}]},{"item":{"id":"customer-references#aws-case-study-coinbase","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-coinbase","dateCreated":"2019-07-22T19:52:37+0000","dateUpdated":"2023-07-14T23:32:43+0000","additionalFields":{"featured":"0","descriptionSummary":"Coinbase is the world\u0027s most popular bitcoin wallet, facilitating bitcoin transactions in 190 countries. The organization runs its global bitcoin exchanges, wallets, and an analytical insight pipeline on AWS. Using AWS, Coinbase has grown to support 3 million global bitcoin users and can analyze 1 TB of data each day for better insight into its business.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Coinbase_Customer-Reference_Logo.21892bc610021b17390aadf95f6958deaf5829ec.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eCoinbase is the world\u0026#39;s most popular bitcoin wallet, facilitating bitcoin transactions in 190 countries. The organization runs its global bitcoin exchanges, wallets, and an analytical insight pipeline on AWS. Using AWS, Coinbase has grown to support 3 million global bitcoin users and can analyze 1 TB of data each day for better insight into its business.\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/coinbase/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Coinbase","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Coinbase"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","ta