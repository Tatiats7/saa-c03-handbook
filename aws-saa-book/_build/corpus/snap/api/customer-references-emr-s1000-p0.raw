t#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#rovio-machine-learning-variation1","locale":"en_US","directoryId":"customer-references","name":"rovio-machine-learning-variation1","dateCreated":"2020-06-18T18:13:26+0000","dateUpdated":"2023-07-14T23:32:46+0000","additionalFields":{"descriptionSummary":"Rovio Entertainment is a Finland-based entertainment media company and creator of the Angry Birds brand. Its gaming platform, which supports all of the firm\u0027s games, runs on AWS. Using AWS, Rovio delivers a consistent, always-on service for its millions of users around the world, and is able to scale on demand for major events, including the release of its new game, Angry Birds 2.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Rovio_Customer-Reference_Logo.2ce0391bff9b391a65b9110b316422d7f42993c8.png","displayLocation":"Finland","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/rovio-gaming-service-platform/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2015","customer-name":"Rovio","contentType":"Customer Story","headline":"AWS Case Study: Rovio\u0027s Gaming Service Platform"}},"tags":[{"id":"customer-references#category#dev-and-test","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dev \u0026 Test","description":"Dev \u0026 Test","dateCreated":"2019-07-22T18:31:47+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#elastic-transcoder","loc