obiettivi prestazionali anche del 66%; i suoi POS completano 8.600 transazioni al secondo in tutto il mondo.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/McDonalds_Customer-Reference_Logo.8197f6c1344756e2051566dbaa8a463bbc552030.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the McDonalds customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Travel \u0026 Hospitality","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/mcdonalds/","customer-name":"McDonalds","enableShare":"1","publishedDate":"2016","contentType":"Storia del cliente","headline":"McDonald\u0027s promuove la trasformazione digitale basata sul cloud su AWS"}},"tags":[{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Mobile","description":"Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2023-08-22T20:28:38+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#tech-category#devtools","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Developer Tools","description":"Developer Tools","dateCreated":"2020-01-16T17:43:16+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"customer-references#category#web-hosting","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Web Hosting","description":"Web Hosting","dateCreated":"2019-07-22T18:32:28+0000","dateUpdated":"2022-03-30T20:30:49+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u00