:"2020-03-02T07:02:43+0000","dateUpdated":"2022-02-03T03:32:30+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Mobile","description":"Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2023-08-22T20:28:38+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#category#developer-tools","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Developer Tools","description":"\u003cp\u003eHost code, build, test, and deploy your applications quickly and effectively with AWS developer tools. Leverage core tools like software development kits (SDKs), code editors, and continuous integration and delivery (CI/CD) services for DevOps software development. Use machine learning (ML) -guided best practices and abstractions to improve agility, security, velocity, and code quality.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:14:12+0000","dateUpdated":"2023-07-14T01:14:12+0000"}]},{"item":{"id":"customer-references#yanolja","locale":"en_US","directoryId":"customer-references","name":"yanolja","dateCreated":"2020-05-04T20:10:40+0000","dateUpdated":"2023-07-12T01:40:54+0000","additionalFields":{"descriptionSummary":"Yanolja roughly means \"Hey, let\u0027s have fun!\" in Korean and is the fastest-growing online travel agency for accommodation and leisure activities in Korea. Its primary focus is providing accommodation information, a reservation platform, budget hotel franchise offers, and travel content to prospective travelers.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/yanolja-200x70.900141d94ecca0788bde1092b23f95081507a724.png","displayLocation":"Korea","footerInfoText":"Published Date","industry":"Travel \u0026 Hospitality","sortDate":"2020-01-01","hea