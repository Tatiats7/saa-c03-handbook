1:38:41+0000","additionalFields":{"descriptionSummary":"Discover how 1plusX built a real-time data management platform (DMP) that collates, enhances, and optimizes customers\u0027 first-party data in a privacy-safe way. The system is built on top of Amazon ECS, AWS Fargate, Amazon EMR, and Kafka and scales to billions of events daily.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/1plusx-logo%401x.44cfc6dcd2535970f0ba078dccc3f08d7d61e7d2.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"1plusx","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-04-19","headlineUrl":"https://youtu.be/XqsgQxyZ2Tw?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"1plusx","publishedDate":"2022","enableShare":"1","headline":"1plusX: A Real-Time Data Management Platform on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#serverless","loc