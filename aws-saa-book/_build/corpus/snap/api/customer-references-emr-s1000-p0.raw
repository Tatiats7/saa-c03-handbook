fer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12T02:01:29+0000"},{"id":"GLOBAL#tech-category#cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-01-16T17:43:13+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#zappos-case-study","locale":"en_US","directoryId":"customer-references","name":"zappos-case-study","dateCreated":"2020-03-02T20:07:49+0000","dateUpdated":"2021-12-22T22:41:17+0000","additionalFields":{"featured":"0","descriptionSummary":"Zappos uses analytics built on AWS technology to personalize search results for individual users without noticeable latency, achieving higher search-to-clickthrough rates and reducing return rates.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/zappos-logo@1x.beaa428481cd50b53f87832f15543cc16d46e17f.png","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Retail","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/zappos-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Zappos Case Study","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Zappos Creates Breakthrough Customer Experiences Using AWS"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#elasticache-redis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache for Redis","description":"Amazon ElastiCache for Redis","dateCreated":"2020-03-03T00:16:59+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en