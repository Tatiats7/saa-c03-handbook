ies/mtg-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"MTG","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"MTG Cuts Medical Research Times in Half, Secures Patient Data Using AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#snow-family","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Snow Family","description":"AWS Snow Family","dateCreated":"2020-03-02T07:05:31+0000","dateUpdated":"2022-02-03T03:33:01+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000