"dateUpdated":"2022-11-23T06:58:38+0000"},{"id":"GLOBAL#product#connect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Connect","description":"Amazon Connect","dateCreated":"2020-03-02T07:02:22+0000","dateUpdated":"2022-02-03T03:32:26+0000"},{"id":"GLOBAL#use-case#call-center-ops","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Call Center Operations","description":"Call Center Operations","dateCreated":"2020-06-05T06:37:02+0000","dateUpdated":"2022-02-03T03:35:35+0000"},{"id":"GLOBAL#tech-category#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Business Applications","description":"Business Applications","dateCreated":"2022-10-07T04:56:33+0000","dateUpdated":"2022-10-07T04:56:33+0000"},{"id":"customer-references#category#contact-center","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Contact Center","description":"Contact Center","dateCreated":"2019-07-22T18:31:30+0000","dateUpdated":"2022-05-09T21:31:11+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#ascend-money-case-study","locale":"en_US","directoryId":"customer-references","name":"ascend-money-case-study","dateCreated":"2023-01-30T22:40:13+0000","dateUpdated":"2024-02-20T22:25:50+0000","additionalFields":{"descriptionSummary":"Ascend Money created a multi-arch approach to cloud computing using Amazon EC2 Instances, improving performance up to 40 percent while lowering costs and freeing developers to innovate.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/ascend-money-logo%401x.c25a4990d71ab36120918219d8b61c9d35dda0aa.png","displayLocation":"Thailand","customerNameLower":"ascend money","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2023-01-12","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ascend-money-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ascend Money","publishedDate":"2023","enableShare":"1","headline":"Ascend Money Improves Application Performance by 40% Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#thailand","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Thailand","description":"Thailand","dateCreated":"2020-02-03T05:29:40+0000","dateUpdated":"2022-02-03T03:31:37+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19