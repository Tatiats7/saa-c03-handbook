":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"}]},{"item":{"id":"customer-references#kushki","locale":"en_US","directoryId":"customer-references","name":"kushki","dateCreated":"2023-06-01T23:10:51+0000","dateUpdated":"2023-06-08T04:07:34+0000","additionalFields":{"descriptionSummary":"Kushki es una plataforma de pagos que está orientada a dar servicios a clientes altamente transaccionales. Cuando empezó sus operaciones, la empresa identificó la necesidad de desarrollar servicios que pudieran reemplazar los sistemas obsoletos con los cuales el mercado financiero trabajaba. Asimismo, tenía el desafío de encontrar una plataforma que le permitiera tener lo mejor en tecnología, pero también un amplio catálogo de productos que pudiera ser traducido en servicios eficientes a sus clientes. En este video, José Santacruz, CTO de Kushki, explica que la compañía eligió a AWS porque es la única que tiene el catálogo de componentes maduros y adecuados para la arquitectura serverless que utiliza.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/kushki-logo%402x.bd8d8dbcfaa577462514249d944f9e86b21c006a.png","displayLocation":"Colombia","footerInfoText":"Fecha de publicación","industry":"Software e Internet","sortDate":"2021-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/kushki/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"Historia del cliente","customer-name":"Kushki","headline":"Kushki se transforma en una empresa escalable con AWS"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id