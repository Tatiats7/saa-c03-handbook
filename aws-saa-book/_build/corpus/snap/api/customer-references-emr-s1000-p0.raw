paceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#lopes","locale":"en_US","directoryId":"customer-references","name":"lopes","dateCreated":"2023-06-01T23:08:26+0000","dateUpdated":"2023-06-08T04:07:42+0000","additionalFields":{"descriptionSummary":"Com mais de 80 anos de atuação no mercado brasileiro, a Lopes é hoje a maior empresa de soluções de integradas de intermediação, consultoria e promoção de financiamentos de imóveis do Brasil. Em 2019, atendendo ao objetivo de se tornar uma tech company, a Lopes iniciou sua jornada de digitalização  pela reformulação de seu portal e agora incorpora novidades como o desenvolvimento do Lopes Avalia, algoritmo de precificação de imóveis, ambos baseados na infraestrutura e em serviços oferecidos pela AWS, alcançando um crescimento de mais de 1000% nos leads gerados e de quase 850% no volume de sessões orgânicas.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/lopes-logo%402x.23ce1372e5eff7b68c035845f2132113116416e3.png","displayLocation":"Brasil","footerInfoText":"Data de publicação","industry":"Imóveis e construção","sortDate":"2021-01-01","enableShare":"1","headlineUrl":"h