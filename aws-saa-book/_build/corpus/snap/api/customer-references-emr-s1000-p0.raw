"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#iberia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Iberia","description":"Iberia","dateCreated":"2020-04-09T03:37:04+0000","dateUpdated":"2022-02-03T03:31:49+0000"},{"id":"GLOBAL#location#spain","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Spain","description":"Spain","dateCreated":"2020-02-03T05:30:16+0000","dateUpdated":"2022-02-03T03:31:49+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-thron","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-thron","dateCreated":"2019-07-22T19:50:40+0000","dateUpdated":"2023-07-14T23:32:42+0000","additionalFields":{"featured":"0","descriptionSummary":"THRON helps its customers get more out of content through distribution, workflow management, and big data analysis for business insights. The Italian company offers a platform to simplify digital content management and distribution and create actionable recommendations to increase business insights. THRON has been able to cut its development and release cycle time in half by using AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/THRON_Customer-Reference_Logo.5a2d54d23712156b20f60cb3357996725d4bc9e9.png","displayLocation":"Italy","footerInfoText":"Published Date","description":"\u003cp\u003eTHRON helps its customers get more out of content through distribution, workflow management, and big data analysis for business insights. The Milan-based company offers a platform to simplify digital content management and distribution and create actionable recommendations to increase business insights. THRON has been able to cut its development and release cycle time in half by using AWS. It uses a range of AWS services, including Amazon Kinesis, Amazon Redshift, and Amazon EMR to power its intelligence and analysis reporting.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/thron/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"THRON","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: THRON"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#italy","locale":"en_US","tagNamespaceId":"GLOBAL#location"