2:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"GLOBAL#use-case#high-perform-compute","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"High Performance Compute","description":"High Performance Compute","dateCreated":"2020-06-05T06:37:26+0000","dateUpdated":"2022-02-03T03:35:41+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"customer-references#customer-segment#public-sector-edu","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Education","description":"Education","dateCreated":"2019-07-22T18:39:45+0000","dateUpdated":"2022-03-21T23:55:12+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"}]},{"item":{"id":"customer-references#arcos-dorados","locale":"en_US","directoryId":"customer-references","name":"arcos-dorados","dateCreated":"2023-06-01T23:05:18+0000","dateUpdated":"2023-07-12T01:35:38+0000","additionalFields":{"descriptionSummary":"Arcos Dorados es la franquicia más grande del mundo de la marca McDonald\u0027s, operando 20 países o territorios en América Latina. Hace unos años, la compañía empezó un proceso de transformación digital con el reto de darle a los clientes un servicio con mayor conveniencia y con relación cada vez más personalizada. En este video, Magdalena González Victorica, Chief Technology Officer de Arcos Dorados, cuenta cómo la empresa utilizó las soluciones y los servicios profesionales de AWS y del partner Econocomdigital. Arcos Dorados implementó la infraestructura para tener la información y poder conectarse con los clientes de manera mucho más cercana y humana, aumentando sus ventas y evolucionando como compañía desde el punto de vista digital y de datos.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/arcos_dorados_logo%402x.ee2c34cb96a3b213a1c51d912a70698cd3e0818a.png","displayLocation":"Argentina","customerNameLower":"arcos dorados","footerInfoText":"Fecha de publicación","industry":"Hostelería","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/arcos-dorados/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Arcos Dorados","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"Cómo Arcos Dorados utiliza servicios AWS para evolucionar desde el punto de vista digital"}},"tags":[{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#product#em