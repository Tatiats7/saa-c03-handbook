2019-07-22T18:31:55+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#product#shield","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Shield","description":"AWS Shield","dateCreated":"2020-03-02T07:05:24+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#jooycar","locale":"en_US","directoryId":"customer-references","name":"jooycar","dateCreated":"2023-06-01T23:11:01+0000","dateUpdated":"2023-06-08T04:07:34+0000","additionalFields":{"descriptionSummary":"Jooycar se funda en 2014 con el reto de entregar seguros de auto de una forma distinta y revolucionar la forma a través de la cual las personas se relacionan con un seguro de auto. A partir del 2018, Jooycar experimenta un crecimiento muy acelerado al identificar que los usuarios de su tecnología pagaban un 40% menos por su seguro. La empresa evolucionó sus servicios y multiplicó en promedia cada año en tres veces su volumen con una infraestructura basada en Amazon Web Services. Rodrigo Labbé, CEO de Jooycar, y Gonzalo Vásquez, CTO de la empresa, explican cuáles son los principales servicios utilizados por la compañía y cómo AWS le ha permitido triplicar su cartera de clientes sin problemas de infraestructura y aun reduciendo el costo individual por usuario.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/jooycar-logo%401x.24703b2a40081684bda2fc28615b225847e25137.png","displayLocation":"Chile","footerInfoTe