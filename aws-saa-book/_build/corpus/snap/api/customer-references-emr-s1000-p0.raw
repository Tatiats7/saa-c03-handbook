":"2020-01-16T17:42:42+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#cost-explorer","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Cost Explorer","description":"AWS Cost Explorer","dateCreated":"2020-03-02T07:02:27+0000","dateUpdated":"2022-02-03T03:32:27+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#minnesota-data-lakes-video","locale":"en_US","directoryId":"customer-references","name":"minnesota-data-lakes-video","dateCreated":"2022-01-08T04:31:35+0000","dateUpdated":"2023-07-12T01:35:18+0000","additionalFields":{"descriptionSummary":"The Minnesota Department of Health (MDH) is responsible for Minnesotans\u0027 public health, including disease control and prevention, environmental health, public policy, and regulation of health care providers. In partnership with Minnesota IT Services—the state\u0027s information technology agency, which sets IT strategy, direction, policies, and standards—MDH built a unified solution to obtain secure, consistent access to curated health data on Amazon Web Services (AWS). Using data lakes on AWS, MDH is able to group data from subsystems to support the creation of the governor’s COVID-19 report, deliver notifications of exposure to COVID-19, host a staging area between the disease surveillance system and other systems, act as an access point for researchers and epidemiologists, and more.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/mn-minnesota-logo%401x.578d55599bbc00601a55e0a6f8615014c95f82e1.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2022-01-07","headlineUrl":"https://aws.amazon.com/solutions/case-studies/minnesota-data-lakes-video/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","customer-name":"Minnesota Department of Health and IT Services","contentType":"Customer Story","headline":"Minnesota Department of Health and IT Services Improve Data Availability on AWS"}},"tags":[{"id":"GLOBAL#product#security-hub","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Security Hub","description":"AWS Security Hub","dateCreated":"2020-03-02T07:05:15+0000","dateUpdated":"2022-02-03T03:32:59+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+