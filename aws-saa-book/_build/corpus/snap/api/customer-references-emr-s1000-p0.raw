rnet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#content-type#reference-arch-diagram","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Reference Architecture Diagram","description":"Reference Architecture Diagram","dateCreated":"2020-04-29T05:19:31+0000","dateUpdated":"2022-02-03T03:31:09+0000"}]},{"item":{"id":"customer-references#halodoc-analytics","locale":"en_US","directoryId":"customer-references","name":"halodoc-analytics","dateCreated":"2022-03-19T00:19:40+0000","dateUpdated":"2023-07-14T23:32:28+0000","additionalFields":{"descriptionSummary":"By building a data lake on AWS, Halodoc has created data pipelines in 2 hours and saved 70 percent on storage costs while gaining new user behavior insights. Halodoc connects millions of patients to over 22,000 doctors and 1,000 partner pharmacies across Indonesia, making healthcare simple and accessible. The company built a data lake on Amazon S3 with Amazon Athena to analyze data in real time, and Amazon EMR to run big data workloads.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Halodoc_Customer-Reference_Logo.fc6d17259a45918129235e4d4b0c4ff559c757be.png","displayLocation":"Indonesia","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2022-03-18","headlineUrl":"https://aws.amazon.com/solutions/case-studies/halodoc-analytics/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","customer-name":"Halodoc","contentType":"Customer Story","headline":"Halodoc Brings Online Healthcare Services to Millions in Indonesia on AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#asean","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"ASEAN","description":"ASEAN","dateCreated":"2020-08-20T03:53:05+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#use-case#data-lakes","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Data Lakes","description":"Data Lakes","dateCreated":"2020-06-05T06:37:09+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"customer-references#category#data-lakes-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Data Lakes \u0026 Analytics","description":"Data Lakes \u0026 Analytics","dateCreated":"2019-07-22T18:31:39+0000","dateUpdated":"2022-02-07T13:55:55+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#location#indonesia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Indonesia","description":"Indonesia","dateCreated":"2020-02-03T05:29:22+0000","dateUpdated":"2022-02-03T03:31:36+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#maf01192022jkbsefjbadw","locale":"en_US","directoryId":"customer-references","name":"maf01192022jkbsefjbadw","dateCreated":"2022-05-23T21:42:13+0000","dateUpdated":"2022-12-19T23:25:45+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eMajid Al Futtaim built a custom data management solution on AWS platform and adopted a new-age approach to working built on agile methodology and collaboration principles. This strategy allowed transformation to be completed with unprecedented speed, accelerated people adoption, with results apparent in a matter of months instead of years. This architecture created foundation for a single source of truth for data across the business. The solution\u0026rsquo;s data Ingestion Layer built on Kafka running on EKS cluster, connected to Amazon OpenSearch Service, graph database and S3 as a Data lake, in the Consumption layer: Amazon Aurora and a data warehouse on EC2.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/majid-al-futtaim-logo%401x.e15a5b3c7cbba449bb355dd9d5fc75915bfaea5d.png","displayLocation":"Europe, Middle East, \u0026 Africa","footerInfoText":"Published Date","industry":"Retail","sortDate":"2022-01-19","headlineUrl":"https://youtu.be/9qTEHITVeLE?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Majid Al Futtaim","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Majid Al Futtaim: Building a Custom Data Management Solution on AWS"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBA