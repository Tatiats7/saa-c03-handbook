-03T03:35:22+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#kinesis-data-streams","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis Data Streams","description":"Amazon Kinesis Data Streams","dateCreated":"2020-05-08T03:45:11+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#kinesis-data-analytics","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis Data Analytics","description":"Amazon Kinesis Data Analytics","dateCreated":"2020-06-05T04:46:24+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#location#argentina","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Argentina","description":"Argentina","dateCreated":"2020-06-12T23:30:42+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#arcos-dorados-from-es-directory","locale":"en_US","directoryId":"customer-references","name":"arcos-dorados-from-es-directory","dateCreated":"2024-02-03T03:45:56+0000","dateUpdated":"2024-02-06T01:35:39+0000","additionalFields":{"descriptionSummary":"A Arcos Dorados é a maior franquia mundial da marca McDonald\u0027s, operando em 20 países ou territórios da América Latina. Há alguns anos, a empresa iniciou um processo de transformação digital com o desafio de oferecer aos clientes um atendimento mais conveniente e com um relacionamento cada vez mais personalizado. Neste vídeo, Magdalena González Victorica, Chief Technology Officer da Arcos Dorados, conta como a empresa utilizou as soluções e serviços profissionais da AWS e do parceiro Econocomdigital. A Arcos Dorados implantou a infraestrutura para ter as informações e poder se conectar com os clientes de forma muito mais próxima e humana, aumentando suas vendas e evoluindo como empresa do ponto de vista digital e de dados.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/arcos_dorados_logo%402x.ee2c34cb96a3b213a1c51d912a70698cd3e0818a.png","displayLocation":"Brasil","customerNameLower":"arcos dorados","footerInfoText":"Data de publicação","industry":"Hotelaria","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/arcos-dorados/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Arcos Dorados","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"Como a Arcos Dorados usa os serviços da AWS para evoluir do ponto de vista digital"}},"tags":[{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","ta