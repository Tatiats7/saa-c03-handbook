stomer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#aws-is-how-hellofresh-delivers-a-personalized-experience-to-millions-of-customers-around-the-world","locale":"en_US","directoryId":"customer-references","name":"aws-is-how-hellofresh-delivers-a-personalized-experience-to-millions-of-customers-around-the-world","dateCreated":"2021-06-05T01:08:29+0000","dateUpdated":"2021-12-22T20:19:05+0000","additionalFields":{"featured":"0","descriptionSummary":"With the help of AWS consultation and expertise, HelloFresh has modernized its data capabilities, moving from its legacy database to a data lake where it can centralize storage of both structured and unstructured data. Using AWS, HelloFresh maintains a closer connection to changing customer preferences and the flexibility to quickly adapt its meal offerings and delivery services.","displayLocation":"United States","footerInfoText":"Published Date","industry":"Retail","sortDate":"2021-06-04","headlineUrl":"https://aws.amazon.com/blogs/industries/aws-is-how-hellofresh-delivers-a-personalized-experience-to-millions-of-customers-around-the-world/?did\u003dcr_card\u0026trk\u003dcr_card","enabl