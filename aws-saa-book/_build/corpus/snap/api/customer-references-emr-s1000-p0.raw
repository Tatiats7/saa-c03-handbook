t Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#cerner-case-study","locale":"en_US","directoryId":"customer-references","name":"cerner-case-study","dateCreated":"2019-07-19T15:11:34+0000","dateUpdated":"2023-07-12T01:35:28+0000","additionalFields":{"featured":"0","descriptionSummary":"Cerner uses AWS and big data to gain actionable, real-time insights, simplifying healthcare delivery while reducing costs for payers, providers, and patients. Cerner, one of the leading suppliers of health information technology (HIT) solutions, chose AWS for its global reach and breadth of services, including machine learning and artificial intelligence.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Cerner_Customer-Reference_Logo.016d0a06bc96e694ac6495f37910819f3181a24c.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRyan Hamilton, SVP of Population Health at Cerner, describes how Cerner uses AWS and big data to gain actionable, real-time insights, simplifying healthcare delivery while reducing costs for payers, providers, and patients. Cerner, one of the leading suppliers of health information technology (HIT) solutions, chose AWS for its global reach and breadth of services, including machine learning and artificial intelligence.\u003c/p\u003e\r\n","industry":"Healthcare","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/Cerner/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Cerner","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Cerner Case Study"}},"tags":[{"id":"GLOBAL#