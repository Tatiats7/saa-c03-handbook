cription":"Travel","dateCreated":"2020-01-16T17:42:42+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#innovator#expedia","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Expedia","description":"Expedia","dateCreated":"2022-09-15T00:48:28+0000","dateUpdated":"2022-09-15T00:48:28+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#aws-case-study-dolphin-browser-by-mobotap-inc","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-dolphin-browser-by-mobotap-inc","dateCreated":"2019-07-22T19:59:18+0000","dateUpdated":"2023-07-14T23:32:47+0000","additionalFields":{"featured":"0","descriptionSummary":"The Dolphin Browser by MoboTap, Inc. has been downloaded more than 13 million times onto Android, iPhone and iPad mobile devices. The majority of the browser\u0027s services and backend operations are powered by more than eighty instances running Amazon EC2, Amazon S3, Amazon EBS, Amazon EMR, Amazon RDS, and Amazon CloudFront.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/DolphinBrowser_Customer-Reference_Logo.ff95c89cb1e730e050c2a3f296961d5ea5ff69a3.png","displayLocation":"China","footerInfoText":"Published Date","description":"\u003cp\u003eThe Dolphin Browser by MoboTap, Inc. has been downloaded over 13 million times onto Android, iPhone and iPad mobile devices. The majority of the browser\u0019s services and backend operations are powered by more than eighty instances running Amazon EC2, Amazon S3, Amazon EBS, Amazon EMR, Amazon RDS, and Amazon CloudFront.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/dolphin-browser/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"MoboTap Inc.","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: Dolphin Browser by MoboTap Inc."}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-