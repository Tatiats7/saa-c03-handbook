lla sanità e dell\u0027energia rinnovabile.","featureImageURL":"https://d1.awsstatic.com/aws-key-pages/homepage-key-pages/customer-stories-logo/GE.69d638be1bb211236c8d87590e8ee0be001b543c.jpg","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/GEPower_Customer-Reference_Logo.7100af15f7461bdc2ea9edec4f9b61e536c54f48.png","displayLocation":"Americas","customerNameLower":"ge healthcare","footerInfoText":"Published Date","description":"\u003cp\u003eCombining engineering with analytics to help people work more efficiently and safely\u003c/p\u003e\r\n","industry":"Electronics \u0026 Semiconductors","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/general-electric/","customer-name":"GE Healthcare","enableShare":"1","publishedDate":"2015","contentType":"Storia del cliente","headline":"General Electric su AWS"}},"tags":[{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#life-sciences","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Life Sciences","description":"Life Sciences","dateCreated":"2020-01-16T17:42:31+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#industry#aerospace","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Aerospace","description":"Aerospace","dateCreated":"2020-06-25T04:02:36+0000","dateUpdated":"2022-02-03