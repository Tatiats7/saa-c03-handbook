GLOBAL#product#translate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Translate","description":"Amazon Translate","dateCreated":"2020-03-02T07:05:56+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#product#private-5g","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Private 5G","description":"AWS Private 5G","dateCreated":"2021-12-16T04:57:42+0000","dateUpdated":"2022-02-03T03:32:55+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#paytm-personalize-case-study","locale":"en_US","directoryId":"customer-references","name":"paytm-personalize-case-study","dateCreated":"2022-06-27T20:44:23+0000","dateUpdated":"2022-06-27T20:55:58+0000","additionalFields":{"descriptionSummary":"Financial services company Paytm increased the sales and conversion rates of its retail site by implementing personalized recommendations using Amazon Personalize.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logo