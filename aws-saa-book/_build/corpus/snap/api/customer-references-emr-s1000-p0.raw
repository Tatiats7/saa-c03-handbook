"id":"GLOBAL#business-category#cust-engagement","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2020-06-05T07:06:46+0000","dateUpdated":"2022-02-03T03:31:03+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"}]},{"item":{"id":"customer-references#surf-research-cloud-projects-case-study","locale":"en_US","directoryId":"customer-references","name":"surf-research-cloud-projects-case-study","dateCreated":"2022-07-02T00:19:40+0000","dateUpdated":"2022-07-02T00:21:17+0000","additionalFields":{"descriptionSummary":"SURF, the National Research and Education Network (NREN), has a publicly funded mission to bring the latest IT capabilities to education and research communities. In 2020, SURF called for proposals to support research projects using Amazon Web Services (AWS) across the Netherlands. It has since used AWS for projects focused on motor neurone disease, machine learning, and geodata for ecological insights. Bringing research loads to the cloud is shortening the journey from research to scientific discovery and making data more shareable and accessible.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/SURF-logo-1x.066a910af8c3c48d1de739abef039f677f8f3d8b.png","displayLocation":"Europe, Middl