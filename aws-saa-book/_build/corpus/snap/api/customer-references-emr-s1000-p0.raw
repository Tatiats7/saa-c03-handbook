8:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#salesforce-san-francisco-summit-case-study","locale":"en_US","directoryId":"customer-references","name":"salesforce-san-francisco-summit-case-study","dateCreated":"2022-08-22T23:23:51+0000","dateUpdated":"2024-03-02T02:48:47+0000","additionalFields":{"descriptionSummary":"Salesforce is a cloud-based software company that provides customer relationship management services and a complementary suite of enterprise applications focused on customer service, marketing automation, analytics, and application development. In this video, Muralidhar Krishnaprasad, executive vice president (EVP) of engineering for Salesforce, describes how the company creates a single source of truth for customer data in the company\u0027s Customer Data Platform (CDP), utilizing AWS services such as Amazon Relational Database Service (Amazon RDS), Amazon DynamoDB, and Amazon EMR to provide marketers with a detailed view of their consumers and improve business outcomes.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/salesforce_Logo%401x.e3ea487b7f4ec96d760a1240c5b36f93823d1c54.png","displayLocation":"United States","customerNameLower":"salesforce","footerInfoText":"Published Date","industry":"Digital Marketing","sortDate":"2022-08-22","headlineUrl":"https://aws.amazon.com/solutions/case-studies/salesforce-san-francisco-summit-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Salesforce","publishedDate":"2022","enableShare":"1","headline":"Salesforce Creates a Single Source of Data Truth for Its Customer Data Platform Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#industry#digital-marketing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Digital Marketing","description":"Digital Marketing","dateCreated":"2020-01-16T17:42:16+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"customer-references#customer-se