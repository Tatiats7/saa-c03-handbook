eId":"customer-references#big-rocks","name":"AWS for Data","description":"\u003cp\u003eAWS for Data is a marketing \u0026ldquo;Big Rock\u0026rdquo; initiative that tells the story around how AWS can provide the most comprehensive set of data capabilities spanning databases, analytics, business intelligence, and machine learning for an end-to-end data strategy.\u003c/p\u003e\n","dateCreated":"2024-02-14T22:32:15+0000","dateUpdated":"2024-02-14T22:32:15+0000"}]},{"item":{"id":"customer-references#bookmyshow","locale":"en_US","directoryId":"customer-references","name":"bookmyshow","dateCreated":"2021-12-14T02:51:12+0000","dateUpdated":"2022-10-31T22:41:40+0000","additionalFields":{"descriptionSummary":"BookMyShow provides an online ticketing platform and movie streaming service within the universe of its entertainment offerings. Migrating its applications and databases to the AWS Cloud helped the company to cut TCO by 70 percent including compute costs cut by 30 percent, using AWS Graviton2 instances to run workloads on Amazon EC2.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/BookMyShow_logo%401x.4570b7710028a640a31a4d11135134662ae95a29.png","displayLocation":"India","customerNameLower":"bookmyshow","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2021-12-09","headlineUrl":"https://aws.amazon.com/solutions/case-studies/bookmyshow/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"BookMyShow","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"BookMyShow Improves TCO by 70 Percent on the AWS Cloud"}},"tags":[{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#locatio