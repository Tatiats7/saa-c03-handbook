erless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#workload#microsoft","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"Microsoft","description":"Microsoft","dateCreated":"2021-01-06T00:09:49+0000","dateUpdated":"2022-02-03T03:36:04+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#location#canada","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Canada","description":"Canada","dateCreated":"2020-02-03T05:29:05+0000","dateUpdated":"2022-02-03T03:31:34+0000"}]},{"item":{"id":"customer-references#aws-case-study-mcdonalds-home-delivery","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-mcdonalds-home-delivery","dateCreated":"2019-07-19T14:58:00+0000","dateUpdated":"2023-07-12T01:40:50+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, McDonald\u0027s Corporation transformed into a digital technology company, beat performance targets by up to 66 percent, and completes 8,600 transactions per second via its point-of-sale (POS) system. McDonald\u0027s Corporation is an American hamburger and fast food restaurant chain that serves 69 million customers each day. McDonald\u0027s uses a number of AWS services including Amazon EC2, Elastic Load Balancing, Amazon EBS, and Amazon ElastiCache to support its global POS system, including 200,000 registers and 300,000 POS devices.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/McDonalds_Customer-Reference_Logo.8197f6c1344756e2051566dbaa8a463bbc552030.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the McDonalds customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Travel \u0026 Hospitality","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/mcdonalds/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"McDonalds","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"McDonalds Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#produ