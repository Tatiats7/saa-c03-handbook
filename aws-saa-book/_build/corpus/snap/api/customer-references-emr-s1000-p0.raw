#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"customer-references#category#gen-ai","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gen AI","description":"\u003cp\u003eGenerative Artificial Intelligence\u003c/p\u003e\n","dateCreated":"2023-07-10T17:07:31+0000","dateUpdated":"2023-07-10T17:07:31+0000"},{"id":"customer-references#recon#auto-campaign","locale":"en_US","tagNamespaceId":"customer-references#recon","name":"auto-campaign","description":"\u003cp\u003eauto-campaign\u003c/p\u003e\n","dateCreated":"2023-12-04T18:22:48+0000","dateUpdated":"2023-12-04T18:22:48+0000"},{"id":"GLOBAL#industry#all","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"All","description":"All","dateCreated":"2020-02-24T21:27:19+0000","dateUpdated":"2022-02-03T03:31:59+0000"}]},{"item":{"id":"customer-references#agibank-autoscaling","locale":"en_US","directoryId":"customer-references","name":"agibank-autoscaling","dateCreated":"2023-06-01T23:04:36+0000","dateUpdated":"2023-06-08T04:07:48+0000","additionalFields":{"descriptionSummary":"Determinada a oferecer sempre a melhor experiência para o cliente, a instituição tem ampliado o uso da nuvem para tornar as jornadas cada vez mais digitais e sem atrito, independente do canal que o cliente acesse. Este crescimento trouxe a necessidade de reavaliar a infraestrutura e os serviços utilizados, buscando adequá-los aos novos cenários, processo que vem sendo colocado em prática com o suporte do time da AWS.\n\nDesde 2017 o Agibank segue em pleno processo de crescimento e transformação – de financeira especializada em crédito para um banco de relacionamento completo – baseado fortemente em digitalização, inovação e implementando recursos cada vez mais ágeis. Portanto, a companhia definiu que a única forma de fazer entregas rápidas e acompanhar a demanda seria utilizando cloud computing e microsserviços, para garantir a escala necessária no tempo preciso.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/agi_logo%402x.9155292d65ae17ddf0851e625ebfeee92de47bec.png","displayLocation":"Brasil","customerNameLower":"agibank","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/agibank-autoscaling/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Agibank","enableShare":"1","publishedDate":"2023","contentType":"História do cliente","headline":"Agibank reduz custos de nuvem em 32% com suporte da AWS"}},"tags":[{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u00