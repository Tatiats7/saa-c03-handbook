Id":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#aws-case-study-pixnet","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-pixnet","dateCreated":"2019-07-22T19:54:33+0000","dateUpdated":"2023-07-14T23:32:40+0000","additionalFields":{"featured":"0","descriptionSummary":"PIXNET Digital Media Corporation is a Taiwan-based company that provides a social network website, online photo gallery, and blogging service for China. PIXNET uses Amazon S3 for basic backups and log files and Amazon EC2 to process images using facial recognition software.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/pixnet-logo.4533a385457ee8d9052252d743c089ee0602cb4a.png","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003ePIXNET Digital Media Corporation is a Taiwan-based company that provides a social network Website, online photo gallery, and blogging service for the Greater China region. PIXNET first began using Amazon Web Services (AWS) with Amazon Simple Storage Service (Amazon S3) for basic backups and log files. The company then integrated Amazon Elastic Compute Cloud (Amazon EC2) to process images using the face detection and recognition feature it recently added to its online photo gallery. PIXNET reports that it is able to bring its services to market quickly and more cost-effectively since incorporating AWS.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2014-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/pixnet/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"PIXNET","enableShare":"1","publishedDate":"2014","contentType":"Customer Story","headline":"AWS Case Study: PIXNET"}},"tags":[{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:43+0000","dateUpdated":"2022-02-03T03:36:00+0000"},{"id":"GLOBAL#location#taiwan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Taiwan","description":"Taiwan","dateCreated":"2020-02-03T05:29:38+0000","dateUpdated":"2022-02-03T03:31:40+0000"}