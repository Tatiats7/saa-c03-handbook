s/hc1-logo%401x.798c8155f7dd341008c3687d790b620a3817ac08.png","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2021-01-27","headlineUrl":"https://aws.amazon.com/solutions/case-studies/hc1-quest/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"hc1","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"hc1 Uses AWS to Turn Billions of Quest Lab Tests into Healthcare Insights"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#choice-hotels-aws-training-and-certification-case-study","locale":"en_US","directoryId":"customer-references","name":"choice-hotels-aws-training-and-certification-case-study","dateCreated":"2021-06-29T20:36:23+0000","dateUpdated":"2023-07-12T01:40:54+0000","additionalFields":{"descriptionSummary":"Choice Hotels opted to go all in on AWS and used AWS Training and Certification to upskill its employees, boosting staff engagement and speed to market, cutting costs, and simplifying its cloud migration.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/choice-hotels-logo%401x.08dbf8fecc6ffe771a5bb62d8d1b77b88fdc1ca9.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Hospitality","sortDate":"2021-01-12","headlineUrl":"https://aws.amazon.com/solutions/case-studies/choice-hotels-aws-training-and-certification-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Choice Hotels","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Choice Hotels Speeds Deployment, Supports Cloud Migration Using AWS Training and Certification"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#customer-enablement#tra