-03T03:35:33+0000"},{"id":"GLOBAL#product#sagemaker-ground-truth","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker Ground Truth","description":"Amazon SageMaker Ground Truth","dateCreated":"2020-03-02T07:05:12+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#indmoney","locale":"en_US","directoryId":"customer-references","name":"indmoney","dateCreated":"2020-12-03T00:05:42+0000","dateUpdated":"2021-12-22T22:34:10+0000","additionalFields":{"descriptionSummary":"By containerizing its architecture and deploying Amazon EC2 Spot Instances on AWS, INDmoney has automated scaling and reduced computing costs by 50–70 percent. INDmoney is a super app that offers users in India a platform to track, save, and grow their money. The startup is using Amazon ECS for container orchestration, Amazon EC2 Spot Instances for low-cost computing, and Amazon Redshift for building a data warehouse solution.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/INDmoney_logo%401x.d4fd286c0c33c177ba04e26705909a68ca3af551.png","displayLocation":"India","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2020-12-02","headlineUrl":"https://aws.amazon.com/solutions/case-studies/indmoney/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"INDmoney Reduces Computing Costs by 50–70% with Amazon ECS on Spot Instances","customer-name":"INDmoney"}},"tags":[{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-