mespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#use-case#data-lakes","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Data Lakes","description":"Data Lakes","dateCreated":"2020-06-05T06:37:09+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#dishtv-case-study","locale":"en_US","directoryId":"customer-references","name":"dishtv-case-study","dateCreated":"2020-01-30T05:19:14+0000","dateUpdated":"2021-12-22T19:19:12+0000","additionalFields":{"descriptionSummary":"By building its end-to-end OTT solution on AWS, DishTV was able to launch it in seven months compared to the industry average of 12 to 14 months. DishTV is an Indian satellite TV provider with 25 million active subscribers. The company uses AWS Elemental to process video content, Amazon ECS for container orchestration, and Amazon Rekognition to flag inappropriate content on user-driven channels.","imageSrcUrl":"https://d1.awsstatic.com/events/aws-hosted-events/2019/APAC/case-studies/dishtv-case-studies.70d18f7753622ea89fe84e37239b2f3274901a80.png","displayLocation":"India","footerInfoText":"Published Date","description":"By building its end-to-end OTT solution on AWS, DishTV was able to launch it in seven months compared to the industry average of 12 to 14 months. DishTV is an Indian satellite TV provider with 25 million active subscribers. The company uses AWS Elemental to process video content, Amazon ECS for container orchestration, and Amazon Rekognition to flag inappropriate content on user-driven channels.","industry":"Media \u0026 Entertainment","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/dishtv/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Dishtv","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Dishtv Case Study"}},"tags":[{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#elemental-mediaconnect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental MediaConnect","description":"AWS Elemental MediaConnect","dateCreated":"2020-03-02T07:03:12+0000","dateUpdated":"2022-02-03T03:32:35+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","