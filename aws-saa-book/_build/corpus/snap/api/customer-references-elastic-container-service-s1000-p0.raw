cale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#amazon","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Amazon","description":"Amazon","dateCreated":"2022-04-25T19:05:23+0000","dateUpdated":"2022-06-27T20:43:38+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#inferentia","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Inferentia","description":"AWS Inferentia","dateCreated":"2020-03-02T07:03:49+0000","dateUpdated":"2022-02-03T03:32:41+0000"}]},{"item":{"id":"customer-references#amazon-robotics-case-study-de","locale":"en_US","directoryId":"customer-references","name":"amazon-robotics-case-study-de","dateCreated":"2024-09-18T20:03:44+0000","dateUpdated":"2024-09-18T20:08:09+0000","additionalFields":{"descriptionSummary":"Amazon Robotics entwickelt mit Amazon SageMaker ein komplexes Machine-Learning-Modell, das manuelles Scannen in Logistikzentren von Amazon ersetzt. Amazon Robotics hat sich zum Ziel gesetzt, mithilfe von Machine Learning einen Engpass in seinem Lagerhaltungsprozess zu beseitigen. Das Unternehmen meisterte Herausforderungen im Bereich Computing und Hosting mit Amazon SageMaker und konnte so die Inferenzkosten um fast 50 Prozent senken.","imageSrcUrl":"https://d1.awsstatic.com/amazon-logo-1x.a64c3eedfb84347ecf50e210637c0cf810922e10.png","displayLocation":"USA","customerNameLower":"amazon robotics","industry":"Einzelhandel","sortDate":"2021-04-23","enableShare":"1","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/amazon-robotics-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"Kundengeschichte","customer-name":"Amazon Robotics","headline":"Amazon Robotics nutzt Amazon SageMaker und AWS Inferentia, um ML-Inferenzierung in großem Maßstab zu ermöglichen"}},"tags":[{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#industry#retail","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Retail","description":"Retail","dateCreated":"2020-01-16T17:42:39+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#german","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"German","description":"German","dateCreated":"2020-03-03T06:40:46+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"i