artup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#location#china","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"China","description":"China","dateCreated":"2020-02-03T05:29:17+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#hongkong","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Hong Kong","description":"Hong Kong","dateCreated":"2020-02-03T05:29:18+0000","dateUpdated":"2022-02-03T03:31:38+0000"}]},{"item":{"id":"customer-references#west-java","locale":"en_US","directoryId":"customer-references","name":"west-java","dateCreated":"2022-01-08T04:33:38+0000","dateUpdated":"2022-01-21T02:44:43+0000","additionalFields":{"descriptionSummary":"By building cloud-native apps on AWS, West Java Provincial Government has reduced its development time from 2–3 months to 16 days and benefits from a pay-as-you-go cloud model. West Java is the most populous province in Indonesia, and its government is committed to improving public services through technology. The government is using Amazon EKS to speed up deployment of containers, Amazon CloudFront to deliver content, and Amazon SQS to avoid app bottlenecks.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/West_Java_logo%401x.b346cbf993072d15b5b8832fc5ff633c4ecab431.png","displayLocation":"Indonesia","footerInfoText":"Published Date","industry":"General Public Services","sortDate":"2022-01-07","headlineUrl":"https://aws.amazon.com/solutions/case-studies/west-java/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"West Java Bridges Urban and Rural Digital Gap with Apps Built on AWS","customer-name":"West Java Provincial Government"}},"tags":[{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#customer-engagement","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2019-07-22T18:31:37+0000","dateUpdated":"2022-03-21T23:37:45+0000"},{"id":"GLOBAL#location#asean","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"ASEAN","description":"ASEAN","dateCreated":"2020-08-20T03:53:05+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#containers","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Containers","description":"Containers","dateCreated":"2020-02-13T00:27:17+0000","dateUpdated":"2022-02-03T03:35:26+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US",