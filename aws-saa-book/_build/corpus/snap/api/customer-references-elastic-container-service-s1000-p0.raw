4-09T00:26:11+0000","dateUpdated":"2022-02-03T03:31:35+0000"}]},{"item":{"id":"customer-references#quodd-case-study","locale":"en_US","directoryId":"customer-references","name":"quodd-case-study","dateCreated":"2024-04-12T16:53:24+0000","dateUpdated":"2024-04-16T13:43:33+0000","additionalFields":{"descriptionSummary":"Learn how QUODD in market and financial services data modernized its infrastructure, eliminated Microsoft licensing dependencies, and upskilled engineers on AWS.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/QUODD-LOGO%401x.cd59a1d0b82298e7d9d420d02d62868a7e19cc3e.png","displayLocation":"United States","customerNameLower":"quodd","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/quodd-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"QUODD","publishedDate":"2023","enableShare":"1","headline":"Scaling 5x Faster While Reducing Costs by Up to 80% Using AWS with QUODD","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":