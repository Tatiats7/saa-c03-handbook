00"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#euler-hermes-video","locale":"en_US","directoryId":"customer-references","name":"euler-hermes-video","dateCreated":"2020-11-09T18:04:33+0000","dateUpdated":"2021-12-22T20:20:47+0000","additionalFields":{"descriptionSummary":"Headquartered in Paris, France, Euler Hermes provides trade credit insurance, protecting more than 66,000 clients against bad debt. In 2019, the company covered more than €950 billion of transactions, resulting in a turnover of €2.9 billion.Protecting clients at this scale requires a high-performing infrastructure. Euler Hermes receives 600,000 credit limit requests each month relating to 30 million businesses, 82 percent of which must be dealt with in real time.Recently, new platforms and marketplaces have been launched that threaten to disrupt the credit insurance industry. To maintain its position and drive innovation, Euler Hermes moved to Amazon Web Services (AWS) and saw faster time to market for new services, more control over costs, and greater ability to integrate with new market entrants’ services via APIs.In this video, Antoine Larmanjat, chief information officer at Euler Hermes, shares the story of the company’s journey to the cloud and explains why it decided on a serverless-first policy.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Euler-Hermes_Customer-Reference_Logo@1x.ce571f3ae2a50cd5ae7a2cf0d9033786a63828ee.png","displayLocation":"France","footerInfoText":"Published Date","industry":"Insurance","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/euler-hermes-video/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Euler Hermes Rides Out Market Disruption Using AWS","customer-name":"Euler Hermes"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":