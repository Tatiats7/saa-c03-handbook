 microservices et qui s\u0026rsquo;appuie sur les multiples services cloud pr\u0026eacute;sents au sein du catalogue Amazon Web Services.\u003c/p\u003e\r\n","featured":"0","featureImageURL":"https://d1.awsstatic.com/Jaji%20-%20logo.b75a4d242919fcd32c1135cfa4e6e8536484a4ac.png","imageSrcUrl":"https://d1.awsstatic.com/Jaji%20-%20logo.b75a4d242919fcd32c1135cfa4e6e8536484a4ac.png","displayLocation":"France","customerNameLower":"jaji","footerInfoText":"Date de publication","industry":"Insurance","sortDate":"2023-03-23","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/jaji/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Jaji","enableShare":"1","publishedDate":"2023","contentType":"Témoignages clients","headline":"Jaji crée une nouvelle mutuelle 100 % digitale en 18 mois avec le Cloud AWS"}},"tags":[{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#language#french","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"French","description":"French","dateCreated":"2020-03-03T06:40:44+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"GLOBAL#industry#general-public-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"General Public Services","description":"General Public Services","dateCreated":"2020-01-16T17:42:24+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":