es#amanotes-case-study","locale":"en_US","directoryId":"customer-references","name":"amanotes-case-study","dateCreated":"2023-02-21T00:04:23+0000","dateUpdated":"2024-02-21T00:20:55+0000","additionalFields":{"descriptionSummary":"Amanotes is a Vietnam-headquartered music game developer that publishes games to a global audience. To provide game downloads to global users reliably, securely, and with low latency, Amanotes chose to launch on AWS.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Amanotes_logo%401x.a21a91a5d2ff54e300a219849ea3d31184057755.png","displayLocation":"Vietnam","customerNameLower":"amanotes","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/amanotes-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Amanotes","publishedDate":"2023","enableShare":"1","headline":"Amanotes Delivers ‘Simple Music Games’ Worldwide on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#location#vietnam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Vietnam","description":"Vietnam","dateCreated":"2020-02-03T05:29:42+0000","dateUpdated":"2022-02-03T03:31:37+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#category#gaming","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gaming","description":"Gaming","dateCreated":"2019-07-22T18:31:55+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#sintad-case-study-from-es-directory","locale":"en_US","directoryId":"customer-references","name":"sintad-case-study-from-es-directory","dateCreated":"2024-02-03T03:47:55+0000","dateUpdated":"2024-02-06T01:35:37+0000","additionalFields":{"descriptionSummary":"Sintad desarrolla productos y software de negocios para empresas que están involucradas en el comercio exterior. Con el objetivo de salir de Perú y convertirse en potencia de software en Latinoamérica, la empresa decidió volverse un proveedor de Software as a Service (SaaS). Para eso, buscó a AWS.\nMario Castro Montenegro, Chief Product Officer de Sintad, recuerda que la empresa tenía un gran problema de soporte con los desarrollos previos. Según cuenta el ejecutivo, Sintad dedicaba 80% del tiempo en soporte y 20% en desarrollos de innovación y nuevos requerimientos. Con AWS, la compañía logró \"voltear la torta\", pasando la métrica para 30% a soporte y 70% a nuevos desarrollos. Al migrar para SaaS con el apoyo de servicios como Amazon Elastic Container Service, Amazon Relational Database Service y AWS Lambda, implementados de la mano con el partner Applying.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/Logo%20sintad%402x1.5f848f3f1868da888de291dd0f7c9ab5899a0ebd.png","displayLocation":"Perú","customerNameLower":"sintad","footerInfoText":"Fecha de publicación","industry":"Software e Internet","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/sintad-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Sintad","enableShare":"1","publishedDate":"2023","contentType":"Historia del cliente","headline":"Sintad pasa del 20% al 70% la métrica de tiempo dedicado a innovación"}},"tags":[{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#containers","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Containers","description":"Containers","dateCreated":"2020-02-13T00:27:17+0000","dateUpdated":"2022-02-03T03:35:26+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#location#peru","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Peru","description":"Peru","dateCreated":"2021-02-19T05:32:36+0000","dateUpdated":"2022-02-03T03:31:33+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"}]},{"item":{"id":"customer-references#rappi-fin-ops","locale":"en_US","directoryId":"customer-references","name":"rappi-fin-ops","dateCreated":"2023-04-19T23:11:19+0000","dateUpdated":"2023-07-12T01:35:38+0000","additionalFields":{"descriptionSummary":"La pandemia puso a prueba la capacidad de entregas rápidas de Rappi, por lo que tuvieron que innovar en su infraestructura. Sin embargo, debían tener bases financieras para justificar el uso de herramientas tecnológicas, y eso solo se lograría teniendo un monitoreo en tiempo real de las necesidades y la tecnología para resolverlas, para medir la relación costo-eficiencia de esto. Así, con la implementación de FinOps y los servicios de AWS, con quien llevan trabajando muchos años, pueden presumir un 90% de la optimización de su inversión en infraestructura. La empresa, que actualmente procesa 25 millones de órdenes al mes, logró la flexibilidad para correr más de 10 mil Instancias de Spot de Amazon Elastic Compute Cloud (Amazon EC2) en momentos de pico.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/rappi-logo%401x.e3f6d852f68b6a673150b380f45ac07e0a763a10.png","displayLocation":"Colombia","customerNameLower":"rappi","footerInfoText":"Fecha de publicación","industry":"Hostelería","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/rappi-fin-ops/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Rappi","publishedDate":"2023","enableShare":"1","headline":"Rappi optimiza un 90% su costo-beneficio en la nube de AWS gracias a FinOps","contentType":"Historia del cliente"}},"tags":[{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUp