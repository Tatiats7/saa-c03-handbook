:"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodeDeploy","description":"AWS CodeDeploy","dateCreated":"2020-03-02T07:02:12+0000","dateUpdated":"2022-02-03T03:32:24+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#category#infrastructure","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Infrastructure","description":"Infrastructure","dateCreated":"2019-07-22T18:32:04+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#tech-category#devtools","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Developer Tools","description":"Developer Tools","dateCreated":"2020-01-16T17:43:16+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#location#canada","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Canada","description":"Canada","dateCreated":"2020-02-03T05:29:05+0000","dateUpdated":"2022-02-03T03:31:34+0000"}]},{"item":{"id":"customer-references#aws-case-study-connectwise","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-connectwise","dateCreated":"2019-07-22T19:51:22+0000","dateUpdated":"2023-07-14T23:32:39+0000","additionalFields":{"featured":"0","descriptionSummary":"ConnectWise uses AWS to easily detect and resolve application performance issues, troubleshoot problems in minutes instead of hours, and reduce latency and other challenges for customers. The organization provides an online business-management platform that IT services enterprises use to run their organizations more efficiently.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/ConnectWise_Customer-Reference_Logo.26ae56724cd081efd538c97cb63d61ab89d22228.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eConnectWise uses AWS to easily detect and resolve application performance issues, troubleshoot problems in minutes instead of hours, and reduce latency and other challenges for customers. The organization provides an online business-management platform that IT services enterprises use to run their organizations more efficiently. ConnectWise uses AWS X-Ray to debug and monitor applications, and Amazon CloudWatch to monitor its overall IT environment.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/connectwise/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ConnectWise","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: ConnectWise"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Optimization","description":"\u003cp\u003eCost Optimization\u003c/p\u003e\n","dateCreated":"2019-07-2