dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#devops","locale":"en_US","tagNamespaceId":"customer-references#category","name":"DevOps","description":"DevOps","dateCreated":"2019-07-22T18:31:49+0000","dateUpdated":"2022-03-05T03:54:11+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#methodology#devops","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"DevOps","description":"DevOps","dateCreated":"2020-06-05T07:06:27+0000","dateUpdated":"2022-02-03T03:32:10+0000"}]},{"item":{"id":"customer-references#kiusys","locale":"en_US","directoryId":"customer-references","name":"kiusys","dateCreated":"2023-06-01T23:07:58+0000","dateUpdated":"2023-07-14T23:32:40+0000","additionalFields":{"descriptionSummary":"Kiu System Solutions nace en 2003 brindando soluciones tecnológicas para líneas aéreas, entre ellas sistemas de reservas y emisión, soluciones de e-commerce, de control de carga para aviones y puntaje para pasajeros frecuentes. Actualmente, la compañía cuenta con 52 clientes a nivel global, transportando 25 millones de pasajeros, y su sistema está presente en 18 mil agencias de viaje. Con AWS, Kiu logró reducir los tiempos de respuesta de sus servicios, creando una infraestructura de red intolerante a fallas, basada en una arquitectura de microservicios. Procesar 250 mil mensajes de tarifación interlineal le tomaba a Kiusys entre 17 y 22 horas. Gracias a las soluciones en la nube de AWS, la empresa redujo ese tiempo a entre 6 y 7 minutos.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/kiusys_logo%401x.235d4d3e7a8fba9df13ffad9ae6b1df681f2b310.png","displayLocation":"Uruguay","footerInfoText":"Fecha de publicación","industry":"Software e Internet","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/kiusys/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","customer-name":"Kiu System Solutions","contentType":"Historia del cliente","headline":"Kiu System Solutions reduce drásticamente sus tiempos de respuesta con la agilidad de la nube AWS"}},"tags":[{"id":"GLOBAL#location#uruguay","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Uruguay","description":"Uruguay","dateCreated":"2020-06-26T01:46:23+0000","dateUpdated":"2022-02-03T03:31:33+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#tech-category#containers","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Containers","description":"Containers","dateCreated":"2020-02-13T00:27:17+0000","dateUpdated":"2022-02-03T03:35:26+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-