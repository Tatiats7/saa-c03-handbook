ed":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#pageindustries","locale":"en_US","directoryId":"customer-references","name":"pageindustries","dateCreated":"2022-02-19T05:01:52+0000","dateUpdated":"2022-02-21T16:34:20+0000","additionalFields":{"descriptionSummary":"Page Industries implemented Vinculum’s suite of solutions on AWS to automate integrations for its 15,000 SKUs across 10 online marketplaces. Page Industries is the franchisee of the Jockey and Speedo retail brands in India and six surrounding countries. Among other Vinculum solutions, it’s using eRetail Suite, built using Amazon RDS to manage databases, Amazon ECS for container orchestration, and AWS Security Hub to automate security alerts.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/jockey-page-industries-logo%401x.c0ea8e82ef330f1d579d3ad80f34ad3ba3022a69.png","displayLocation":"India","footerInfoText":"Published Date","industry":"Manufacturing","sortDate":"2022-02-18","headlineUrl":"https://aws.amazon.com/solutions/case-studies/pageindustries/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Page Industries Scales Apparel Order Volume by 6X with Vinculum Retail Solution on AWS","customer-name":"Page Industries"}},"tags":[{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","d