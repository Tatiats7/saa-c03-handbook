{"items":[{"item":{"id":"customer-references#bedrock-streaming","locale":"en_US","directoryId":"customer-references","name":"bedrock-streaming","dateCreated":"2025-02-07T22:39:12+0000","dateUpdated":"2025-02-18T23:14:19+0000","additionalFields":{"descriptionSummary":"Bedrock Streaming est une entreprise française qui développe une plateforme de streaming vidéo en marque blanche pour plusieurs diffuseurs européens ; elle propulse notamment des services tels que M6+. Implantées principalement à Lyon, ses équipes techniques sont régulièrement confrontées à des défis complexes liés à la résilience et à la scalabilité des systèmes.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/bedrock-streaming-logo%401x.8e1eb1ade43b87f6bc51bcd6ce623e96580be09f.png","displayLocation":"France","customerNameLower":"bedrock streaming","footerInfoText":"Published Date","industry":"Retail","sortDate":"2025-02-05","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/bedrock-streaming/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Bedrock Streaming","publishedDate":"2025","enableShare":"1","headline":"Bedrock optimise la résilience et la scalabilité de sa plateforme vidéo avec AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#language#french","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"French","description":"French","dateCreated":"2020-03-03T06:40:44+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T0