rectoryId":"customer-references","name":"futuready-case-study","dateCreated":"2022-04-09T03:08:12+0000","dateUpdated":"2023-07-14T23:32:43+0000","additionalFields":{"descriptionSummary":"Futuready migrated to AWS to gain agility and modernize its architecture, reducing deployment and onboarding time by at least 65 percent. An online insurance broker, Futuready allows customers in Indonesia and Thailand to compare over 500 insurance policies and products.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Futuready_logo%401x.4106803f6d65cacdb822dd389ca3cf654790a530.png","displayLocation":"Indonesia","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-04-08","headlineUrl":"https://aws.amazon.com/solutions/case-studies/futuready-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","customer-name":"Futuready","contentType":"Customer Story","headline":"Futuready Offers Personalized Insurance and Less Fuss with an Intuitive, Agile Platform on AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#asean","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"ASEAN","description":"ASEAN","dateCreated":"2020-08-20T03:53:05+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagName