nt","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#location#hongkong","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Hong Kong","description":"Hong Kong","dateCreated":"2020-02-03T05:29:18+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"}]},{"item":{"id":"customer-references#renault-video","locale":"en_US","directoryId":"customer-references","name":"renault-video","dateCreated":"2020-11-09T18:05:48+0000","dateUpdated":"2021-12-22T23:25:59+0000","additionalFields":{"descriptionSummary":"Founded in 1899, Groupe Renault manufactures and sells 3.75 million cars and light commercial vehicles each year under five main brands.The automotive industry is changing. People are using more mobility services like ride-sharing apps, and those that own cars are buying more used vehicles. This represents a challenge to the business models of long-established automakers like Renault.The group has responded with a wide-ranging digital transformation, focusing more on services. Central to this transformation has been the use of Amazon Web Services, specifically Amazon Elastic Container Service (Amazon ECS), AWS Lambda, and Amazon Relational Database Service (Amazon RDS).In this video, Pierre Houlès, chief information officer for sales and marketing at Renault, explains how the group handled the challenge of decades of legacy technology and how a shift to DevOps changed the way the business operates. Plus, see how the success of Renault’s first project on the new platform increased sales conversion rates by 15X and customer contacts by 25X, giving the business the confidence to continue its cloud journey.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Renault_Customer-Reference_Logo@1x.8da9e1844df45c643420f8d49bc7ab4fdf5d4a93.png","displayLocation":"France","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/renault-video/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Renault Transforms IT for a New Automotive Sector","customer-name":"Groupe Renault"}},"tags":[{"id":"customer-references#category#customer-engagement","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2019-07-22T18:31:37+0000","dateUpdated":"2022-03-21T23:37:45+0000"},{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpda