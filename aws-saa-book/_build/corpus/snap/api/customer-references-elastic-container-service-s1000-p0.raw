:"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#tech-category#containers","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Containers","description":"Containers","dateCreated":"2020-02-13T00:27:17+0000","dateUpdated":"2022-02-03T03:35:26+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"}]},{"item":{"id":"customer-references#skyalert","locale":"en_US","directoryId":"customer-references","name":"skyalert","dateCreated":"2023-04-19T23:27:16+0000","dateUpdated":"2023-06-08T04:07:41+0000","additionalFields":{"descriptionSummary":"SkyAlert es una empresa de tecnología innovadora que contribuye a alertar oportunamente a millones de personas que viven en zonas vulnerables, promoviendo una cultura de prevención ante riesgos naturales. Con el objetivo de brindar a los clientes, tanto empresas y negocios como particulares, las herramientas adecuadas para que puedan estar prevenidos ante un evento sísmico, SkyAlert migró recientemente su infraestructura de Azure a la nube de Amazon Web Services. Bajo la nueva tecnología, la empresa logró integrar una operación del Internet de las Cosas (IoT) a los servicios y servidores AWS, además de implantar un servicio eficiente de envío de alertas que le permite escalar y enviar millones de mensajes en pocos segundos, ayudando a salvar vidas en casos de sismos.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/skyalert_logo%401x.27b39f5ae8919cd5eac26ac7e8af6df26e3df29d.png","displayLocation":"México","customerNameLower":"skyalert","footerInfoText":"Fecha de publicación","industry":"Software e Internet","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/skyalert/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"SkyAlert","publishedDate":"2020","enableShare":"1","headline":"SkyAlert utiliza servicios AWS para ayudar a salvar vidas ante riesgos naturales","contentType":"Historia del cliente"}},"tags":[{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"IoT","description":"IoT","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#location#mexico","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Mexico","description":"Mexico","dateCreated":"2020-04-09T00:25:53+0000","dateUpdated":"2022-02-03T03:31:31+0000"},{"id":"GLOBAL#location#central-america","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central America","description":"Central America","dateCreated":"2021-02-19T05:32:25+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","