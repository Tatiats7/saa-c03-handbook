#location#nordics","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Nordics","description":"Nordics","dateCreated":"2020-02-03T05:30:04+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#mytona10132021lijaefijaadfe","locale":"en_US","directoryId":"customer-references","name":"mytona10132021lijaefijaadfe","dateCreated":"2022-05-23T21:42:32+0000","dateUpdated":"2022-05-23T21:52:58+0000","additionalFields":{"descriptionSummary":"In this session, Vasilisa Rudykh, Lead ML engineer in Mytona walks us through the Machine learning solution for recommendation system in production. The architecture allows for complex experiment scenarios by leveraging multiarmed bandit pattern. We will dive into the key features such as model training, inference, model weights and tech behind it.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/mytona-logo%401x.585f9171fcf29ad50a3e6c92a981c3e2b6408f0f.png","displayLocation":"Russia","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2021-10-13","headlineUrl":"https://youtu.be/XUCGMzLx8wY?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Mytona: How a ML Recommendation System was Built for Gaming","customer-name":"MYTONA LLC"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#cis","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Commonwealth of Independent States","description":"Commonwealth of Independent States","dateCreated":"2020-04-09T03:33:53+0000","dateUpdated":"2022-02-03T03:31:45+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"i