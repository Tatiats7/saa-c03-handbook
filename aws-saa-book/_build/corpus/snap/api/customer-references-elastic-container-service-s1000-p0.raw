ement","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2020-06-05T07:06:46+0000","dateUpdated":"2022-02-03T03:31:03+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#product#codebuild","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodeBuild","description":"AWS CodeBuild","dateCreated":"2020-03-02T07:02:08+0000","dateUpdated":"2022-02-03T03:32:24+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#canva-case-study","locale":"en_US","directoryId":"customer-references","name":"canva-case-study","dateCreated":"2019-07-22T19:51:19+0000","dateUpdated":"2023-07-19T03:05:05+0000","additionalFields":{"featured":"0","descriptionSummary":"By launching its Canva for Enterprise platform on AWS, Canva ensures reliability, performance, and enhanced security for enterprises globally. Canva is an Australian company that provides an online visual communications and design solution for global customers. The company runs its platform on Amazon ECS, with Amazon S3 and AWS KMS to store and encrypt data.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/canva-logo%401x.8aec33e597ba950d92fb30998e4bf287fe1fb746.png","displayLocation":"Australia","footerInfoText":"Published Date","description":"\u003cp\u003eCanva is an innovative design company that provides online design tools to create flyers, blog posts, websites and other marketing materials. The company is using AWS to host its graphic design platform, process more than 22 million image requests a day, and scale its infrastructure to handle graphics created by millions of users. By using AWS, Canva\u0019s IT infrastructure costs are more than 40% under its forecasted budget.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/canva-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Canva","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Canva Helps Enterprises Redefine Brand Management and Collaboration with Design Tools Powered by AWS"}},"tags":[{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#personalize","l