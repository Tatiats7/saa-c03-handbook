2019-07-22T18:31:49+0000","dateUpdated":"2022-03-05T03:54:11+0000"}]},{"item":{"id":"customer-references#moderna-global-summit-case-study","locale":"en_US","directoryId":"customer-references","name":"moderna-global-summit-case-study","dateCreated":"2023-09-06T22:57:05+0000","dateUpdated":"2023-09-07T23:50:15+0000","additionalFields":{"descriptionSummary":"Moderna began using Amazon Web Services (AWS) ten years ago and currently uses AWS services to run its research algorithms, support its digital manufacturing execution system, conduct data analytics in its clinical operations, build full integration of its digital systems, automate processes, and improve decision making with machine learning (ML) and artificial intelligence (AI).","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/moderna-innovator-logo.602bfdd3c41b0e7033e762c3557a5ff0633637d0.png","displayLocation":"United States","customerNameLower":"moderna","footerInfoText":"Published Date","industry":"Life Sciences","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/moderna-global-summit-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Moderna","publishedDate":"2021","enableShare":"1","headline":"Moderna Uses AWS to Develop Next-Gen Drugs","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#directconnect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Direct Connect","description":"AWS Direct Connect","dateCreated":"2020-03-02T07:02:43+0000","dateUpdated":"2022-02-03T03:32:30+0000"},{"id":"GLOBAL#product#efs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic File System (EFS)","description":"Amazon Elastic File System (EFS)","dateCreated":"2020-03-02T07:02:5