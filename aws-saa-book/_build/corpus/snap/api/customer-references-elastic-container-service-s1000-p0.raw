n":"Energy","dateCreated":"2020-07-15T21:58:51+0000","dateUpdated":"2022-02-03T03:32:02+0000"}]},{"item":{"id":"customer-references#nexity","locale":"en_US","directoryId":"customer-references","name":"nexity","dateCreated":"2023-07-18T00:09:30+0000","dateUpdated":"2023-08-11T22:26:57+0000","additionalFields":{"videoSrcUrl":"https://youtu.be/50oVXmybLhM","descriptionSummary":"\u003cp\u003ePort\u0026eacute; par une conviction forte que l\u0026#39;IT doit se concentrer sur des activit\u0026eacute;s diff\u0026eacute;renciantes \u0026agrave; forte valeur ajout\u0026eacute;e, Nexity a engag\u0026eacute; depuis 2016 un virage \u0026agrave; 180\u0026deg; vers le cloud. En utilisant les services manag\u0026eacute;s AWS, le groupe a pu r\u0026eacute;aliser des gains significatifs en termes d\u0026#39;agilit\u0026eacute; et de performance, tout en r\u0026eacute;duisant les co\u0026ucirc;ts ainsi que son empreinte carbone.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Nexity%20-%20logo.072051fcd1e2b9b9b77f45e38878c25c3bccf15f.png","displayLocation":"Europe, Moyen-Orient et Afrique","footerInfoText":"Date de publication","industry":"Construction et immobilier","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/nexity/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Nexity","enableShare":"1","publishedDate":"2021","contentType":"Témoignages clients","headline":"Nexity propulse sa Direction des Solutions et Innovations Numériques dans le cloud avec AWS"}},"tags":[{"id":"GLOBAL#product#robomaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS RoboMaker","description":"AWS RoboMaker","dateCreated":"2020-03-02T07:05:05+0000","dateUpdated":"2022-02-03T03:32:57+0000"},{"id":"GLOBAL#product#mwaa","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Managed Workflows for Apache Airflow (MWAA)","description":"Amazon Managed Workflows for Apache Airflow (MWAA)","dateCreated":"2021-08-28T0