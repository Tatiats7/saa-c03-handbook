LOBAL#product#auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Auto Scaling","description":"AWS Auto Scaling","dateCreated":"2020-03-02T07:01:39+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"customer-references#category#developer-tools","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Developer Tools","description":"\u003cp\u003eHost code, build, test, and deploy your applications quickly and effectively with AWS developer tools. Leverage core tools like software development kits (SDKs), code editors, and continuous integration and delivery (CI/CD) services for DevOps software development. Use machine learning (ML) -guided best practices and abstractions to improve agility, security, velocity, and code quality.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:14:12+0000","dateUpdated":"2023-07-14T01:14:12+0000"}]},{"item":{"id":"customer-references#elevenia-case-study","locale":"en_US","directoryId":"customer-references","name":"elevenia-case-study","dateCreated":"2019-07-19T14:56:53+0000","dateUpdated":"2023-05-31T23:04:23+0000","additionalFields":{"featured":"0","descriptionSummary":"By building its business intelligence platform on the AWS Cloud, Elevenia has gained the agility required to run real-time analytics and saved nearly $20,000 in monthly fees. Elevenia is a leading customer-to-customer e-commerce site based in Indonesia.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Elevenia_Customer-Reference_Logo.931fd79a05a7aac1d9e63fb27cbdcf997d97df86.png","displayLocation":"Indonesia","footerInfoText":"Published Date","description":"\u003cp\u003eBy building its business intelligence (BI) platform on the AWS Cloud, Elevenia has gained the agility required to run real-time analytics and saved nearly $20,000 in monthly fees. Elevenia is a leading customer-to-customer (C2C) e-commerce site based in Indonesia. The company is using Amazon Elastic Container Service and AWS Fargate to automate deployment of containerized applications and Amazon Rekognition to improve image quality on its website.\u003c/p\u003e\r\n","industry":"Retail","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/elevenia/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Elevenia","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Elevenia Case Study"}},"tags":[{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#asean","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"ASEAN","description":"ASEAN","dateCreated":"2020-08-20T03:53:05+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"G