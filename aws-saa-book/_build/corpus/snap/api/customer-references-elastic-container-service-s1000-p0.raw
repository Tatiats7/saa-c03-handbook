reated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#language#french","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"French","description":"French","dateCreated":"2020-03-03T06:40:44+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12T02:01:29+0000"}]},{"item":{"id":"customer-references#rs2-smart-processing","locale":"en_US","directoryId":"customer-references","name":"rs2-smart-processing","dateCreated":"2024-02-27T00:36:13+0000","dateUpdated":"2024-02-27T00:48:17+0000","additionalFields":{"descriptionSummary":"Payment technology company RS2 moved its BankWORKS payment processing platform to Amazon Web Services (AWS) to support growth. BankWORKS helps over 250 banks and financial services businesses to execute 80 million transactions an hour. Created by RS2, BankWORKS struggled to maintain growth because of lengthy customer onboarding times. Using AWS, BankWORKS has reduced customer onboarding to 1 month from as much as 1 year and can quickly scale compute resources to accommodate increased demand for its platform. The IT team has also reduced maintenance tasks so it can focus on improving its core products.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/RS2_Logo%401x.7283fa9814ab533e390b401bff6fba11d72ab0fc.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"rs2","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/rs2-smart-processing/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"RS2","publishedDate":"2022","enableShare":"1","headline":"RS2 Speeds Up Customer Onboarding for BankWORKS Payment Platform Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#category#backup-restore","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Backup \u0026 Restore","description":"Backup \u0026 Restore","dateCreated":"2019-07-22T18:31:01+0000","dateUpdated":"2022-04-09T03:06:56+0000"},{"id":"customer-references#customer-segment#managed","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Managed","description":"Managed","dateCreated":"2019-07-22T18:39:42+0000","dateUpdated":"2022-06-27T20:43:38+0000"},{"id":"GLOBAL#industry#financial-ser