irectory%20Logos/Cimri_Customer-Reference_Logo.538765810c4d0f1b75d63fc9e620de5d36b4a1b4.png","displayLocation":"Turkey","footerInfoText":"Published Date","description":"\u003cp\u003eBy using Amazon Web Services (AWS), Cimri can easily scale to meet traffic demands, avoid downtime, and improve user experience. The Turkey-based firm operates a price and product comparison website. It chose to move to AWS to run the entire infrastructure supporting its comparison engine, and currently uses Amazon Kinesis, the Amazon OpenSearch Service, and Amazon Relational Database Service.\u003c/p\u003e\n","industry":"Software \u0026 Internet","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/cimri/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Cimri","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Cimri Case Study"}},"tags":[{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#web-hosting","locale":"en_US","tagNamespaceId":"customer-references#ca