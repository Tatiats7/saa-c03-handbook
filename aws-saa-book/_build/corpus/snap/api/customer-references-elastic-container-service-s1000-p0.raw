Updated":"2022-10-31T22:41:42+0000","additionalFields":{"descriptionSummary":"Technology company Bazaarvoice reduced machine learning inference costs by 82 percent and accelerated content delivery by using the ML capabilities of Amazon SageMaker Serverless Inference.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Bazaarvoice-logo%401x.8e189c697b0bf584629485e0f8493349cf733570.jpeg","displayLocation":"United States","customerNameLower":"bazaarvoice","footerInfoText":"Published Date","industry":"Digital Marketing","sortDate":"2022-10-31","headlineUrl":"https://aws.amazon.com/solutions/case-studies/bazaarvoice-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Bazaarvoice","publishedDate":"2022","enableShare":"1","headline":"Bazaarvoice Reduces Machine Learning Inference Costs by 82% Using Amazon SageMaker Serverless Inference","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07