cription":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"customer-references#category#finserv","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Financial Services","description":"Financial Services","dateCreated":"2019-07-22T18:31:53+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"}]},{"item":{"id":"customer-references#punchh1","locale":"en_US","directoryId":"customer-references","name":"punchh1","dateCreated":"2020-12-02T23:21:53+0000","dateUpdated":"2021-12-22T19:51:13+0000","additionalFields":{"descriptionSummary":"Punchh, Inc is a leading digital marketing company that offers software-as-a-service solutions to brick-and-mortar retailers and restaurants. Using the Punchh Platform, the company supports its customers in maximizing their customer lifetime value and achieving organic growth by driving loyalty engagement programs. To keep pace with the growth in the number of customers on its platform, Punchh migrated its database to Amazon DocumentDB as its core database service. With Amazon DocumentDB, the platform now handles twice the workload than before, with a 20 percent cost reduction. Today, multiple brands can run concurrent campaigns on the Punchh platform with no downtime or compromises to the customer experience.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Punchh_logo%401x.c42c7ea44b37440872fb7f36ecd43054a808c0e1.png","displayLocation":"United States","footerInfoTex