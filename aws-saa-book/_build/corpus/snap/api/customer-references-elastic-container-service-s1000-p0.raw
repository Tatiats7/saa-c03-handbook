itionalFields":{"featured":"0","descriptionSummary":"MPAC runs its core property-valuation engine 5,000 percent faster at one-tenth the cost using AWS instead of its older IT architecture. MPAC, the Municipal Property Assessment Corporation, is a public-sector organization responsible for providing valuations for more than five million properties across Ontario, Canada\u0027s largest province.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/MPAC_Customer-Reference_Logo.2b16fc13378a8ec303643bbb652c87ba8c27bcc5.png","displayLocation":"Canada","footerInfoText":"Published Date","description":"\u003cp\u003eMPAC runs its core property valuation engine 5,000 percent faster at one-tenth the cost using AWS instead of its older IT architecture. MPAC?the Municipal Property Assessment Corporation?is a public sector organization responsible for providing valuations for more than 5 million properties across Canada. The company moved from its traditional IT architecture to be more responsive and agile in serving its customers.\u003c/p\u003e\r\n","industry":"Government","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/mpac/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"MPAC","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: MPAC"}},"tags":[{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"customer-references#category#dev-and-test","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dev \u0026 Test","description":"Dev \u0026 Test","dateCreated":"2019-07-22T18:31:47+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","n