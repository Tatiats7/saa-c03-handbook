"locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Control Tower","description":"AWS Control Tower","dateCreated":"2020-03-02T07:02:23+0000","dateUpdated":"2022-02-03T03:32:26+0000"}]},{"item":{"id":"customer-references#currenxie","locale":"en_US","directoryId":"customer-references","name":"currenxie","dateCreated":"2022-01-08T04:33:12+0000","dateUpdated":"2022-09-09T00:34:16+0000","additionalFields":{"descriptionSummary":"Currenxie accelerates the innovation of its Global Account platform while achieving compliance and improving cost efficiencies and performance. The FinTech provides companies of all sizes with a one-stop financial app to grow their business and conduct transactions globally without high cross-border transaction fees. Currenxie uses Amazon GuardDuty and AWS Security Hub to maintain a strong security posture, AWS CDK for infrastructure as code, and AWS Graviton2 processors for better price performance.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/currenxie-logo%401x.68c993ac1e555f525a34ecf5545c05f1cd9d4e79.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-01-07","headlineUrl":"https://aws.amazon.com/solutions/case-studies/currenxie/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Currenxie","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Currenxie Helps Its Clients Move Billions Across Borders with a One-Stop Financial Platform on AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-0