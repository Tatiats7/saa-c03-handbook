,"dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"}]},{"item":{"id":"customer-references#washingtonpost20200601etoivdkn","locale":"en_US","directoryId":"customer-references","name":"washingtonpost20200601etoivdkn","dateCreated":"2022-05-23T21:43:56+0000","dateUpdated":"2022-05-23T21:53:32+0000","additionalFields":{"descriptionSummary":"Arc Publishing is The Washington Post’s state-of-the-art digital publishing platform for media companies, broadcasters, and brands. In this video, Zach showcases how webpages are delivered in Arc’s PageBuilder website development platform. Learn about building a scalable microservices architecture for static and dynamic content rendering used by thousands of websites such as The Washington Post with AWS Lambda, Amazon S3, Amazon ElastiCache, Amazon DymamoDB, and other AWS Services.","imageSrcUrl":"https://d1.awsstatic.com/serverless/Serverless%20Migration/Washington%20Post%20logo.b7c786faa396defa3abd0432a5373575875544fc.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2020-06-01","headlineUrl":"https://youtu.be/0JxJpNjI9Y0?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"The Washington Post: Building a Content Management Platform with Speed at its Core","customer-name":"The Washington Post"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated