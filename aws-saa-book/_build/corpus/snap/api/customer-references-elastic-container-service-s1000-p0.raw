06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#banco-bari","locale":"en_US","directoryId":"customer-references","name":"banco-bari","dateCreated":"2023-06-01T23:04:20+0000","dateUpdated":"2023-07-14T23:32:38+0000","additionalFields":{"descriptionSummary":"O Banco Bari passou a operar como banco múltiplo, atuando com a oferta de serviços de investimento, crédito e empréstimos, entre outros. Ao deixar de ser uma financeira para se tornar um banco full, o Bari desenvolveu sua própria infraestrutura de TI dentro do ambiente AWS.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/banco-bari-logo%402x.87961fdadd8676ecf901fdaf93b2d5eb70f5aa61.png","displayLocation":"Brasil","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/banco-bari/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Banco Bari","enableShare":"1","publishedDate":"2020","contentType":"História do cliente","headline":"Digitalização do Banco Bari com AWS traz ganho de 60% no processamento de operações"}},"tags":[{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Braz