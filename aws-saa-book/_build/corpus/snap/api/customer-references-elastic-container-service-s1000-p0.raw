OBAL#product","name":"Amazon Translate","description":"Amazon Translate","dateCreated":"2020-03-02T07:05:56+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#product#private-5g","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Private 5G","description":"AWS Private 5G","dateCreated":"2021-12-16T04:57:42+0000","dateUpdated":"2022-02-03T03:32:55+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#shikshalokam-case-study","locale":"en_US","directoryId":"customer-references","name":"shikshalokam-case-study","dateCreated":"2022-06-07T17:22:54+0000","dateUpdated":"2022-06-07T17:31:13+0000","additionalFields":{"descriptionSummary":"By hosting its microservices platform on AWS, ShikshaLokam ensures 99.5% uptime and scalability to support more than 150,000 end users. ShikshaLokam is an NGO in India providing open-source education leadership development programs to K-12 institutions.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/ShikshaLokam_Logo%401x.e23255f081abbd3b90c95c028bbe2e4506a8cfa1.png","displayLocation":"India","customerNameLower":"shikshalokam","footerInfoText":"Published Date","industry":"Education","sortDate":"2022-06-07","headlineUrl":"https://aws.amazon.com/solutions/case-studies/shikshalokam-case-study?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ShikshaLokam","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"ShikshaLokam Empowers 150,000 Public Education Leaders in India with Training Platform on AWS"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:43+0000","dateUpdated":"2022-02-03T03:36:00+0000"},{"id":"customer-references#customer-segment#public-sector-nonprofit","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Nonprofit","description":"Nonprofit","dateCreated":"2019-07-22T18:39:49+0000","dateUpdated":"2022-05-09T21:31:14+0000"},{"id":"customer-references#cate