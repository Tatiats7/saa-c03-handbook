e","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"}]},{"item":{"id":"customer-references#habitalia","locale":"en_US","directoryId":"customer-references","name":"habitalia","dateCreated":"2023-06-01T23:11:18+0000","dateUpdated":"2023-06-08T04:07:33+0000","additionalFields":{"descriptionSummary":"Habitalia nació como brazo de consultoría de una Organización No Gubernamental (ONG) llamada Observatorio del Derecho a la Vivienda. La empresa era responsable de desarrollar herramientas para análisis de datos y predicción de riesgos para las comunidades, siempre con la finalidad de sustentar recomendaciones de política pública en la materia del derecho a la vivienda. Actualmente, Habitalia gestiona 15 proyectos de virtualización en la infraestructura AWS para sus clientes, y puede entregar herramientas analíticas eficientes, capaces de contribuir con las comunidades y las organizaciones en la sociedad civil.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/Latam%20Cases%20Assets/Habitalia_LOGO.b461f725c285399739a3c133cc26b292bdec86bb.png","displayLocation":"Latinoamérica","footerInfoText":"Fecha de publicación","industry":"Servicios públicos generales","sortDate":"2019-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/habitalia/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2019","contentType":"Historia del cliente","customer-name":"Habitalia","headline":"Tecnologia AWS ayuda Habitalia a hacer decisiones inteligentes y políticas públicas basadas en datos"}},"tags":[{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#customer-segment#non-profit","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Non-profit","description":"Non-profit","dateCreated":"2021-06-04T06:35:44+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#elastic-container-service","