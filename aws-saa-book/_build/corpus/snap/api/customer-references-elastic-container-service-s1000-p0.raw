","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"}]},{"item":{"id":"customer-references#puy-du-fou","locale":"en_US","directoryId":"customer-references","name":"puy-du-fou","dateCreated":"2024-02-21T00:56:11+0000","dateUpdated":"2024-03-16T00:54:52+0000","additionalFields":{"descriptionSummary":"Created in 1977, the Puy du Fou leisure complex welcomes more than 2.2 million visitors every year. This success is now being exported internationally with the opening of a park in Spain in 2021 and the ambition to expand in the United States in the coming years. To support this impressive growth and ensure that its many visitors always enjoy a controlled experience, the IT department has decided to implement a “full cloud” strategy based on the AWS Cloud.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/puy-du-fou-logo%401x.13479847bb270152d65f90b6dbd704e47dfc56aa.png","displayLocation":"France","customerNameLower":"le puy du fou","footerInfoText":"Published Date","industry":"Hospitality","sortDate":"2023-12-12","headlineUrl":"https://aws.amazon.com/solutions/case-studies/puy-du-fou/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Le Puy du Fou","publishedDate":"2023","enableShare":"1","headline":"Puy du Fou is growing their dream internationally thanks to Amazon Web Services","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","