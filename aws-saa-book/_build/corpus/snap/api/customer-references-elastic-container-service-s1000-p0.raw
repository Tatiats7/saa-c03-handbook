e-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#location#indonesia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Indonesia","description":"Indonesia","dateCreated":"2020-02-03T05:29:22+0000","dateUpdated":"2022-02-03T03:31:36+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#btobet-case-study","locale":"en_US","directoryId":"customer-references","name":"btobet-case-study","dateCreated":"2022-10-03T18:33:44+0000","dateUpdated":"2022-10-11T21:03:06+0000","additionalFields":{"descriptionSummary":"Betting on sporting events from the Olympics to Premier League soccer matches is a billion-dollar market characterized by surges in customer demand around live events. BtoBet provides betting and gambling businesses with its sportsbook solution, allowing individuals to place bets on sporting events. Since migrating to AWS, BtoBet can scale compute resources to handle spikes in demand and deliver a responsive experience for its partners and their players. It has also launched in new global markets and has the resources to support triple-digit customer growth. Using AWS, the company can manage double the volume of betting transactions without expanding its IT team.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/btobet-logo%401x.4df0a2219e8e635f58051432a3203b73a47807fd.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"btobet","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/BtoBet-Case-Study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"BtoBet","publishedDate":"2022","enableShare":"1","headline":"BtoBet Processes Trillions of Betting Requests, Boosts Customer Loyalty Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#malta","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Malta","description":"Malta","dateCreated":"2020-04-09T03:37:12+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#containers","locale":"en_US","tagNamespaceI