7-22T18:31:58+0000","dateUpdated":"2022-05-14T20:13:37+0000"}]},{"item":{"id":"customer-references#squla","locale":"en_US","directoryId":"customer-references","name":"squla","dateCreated":"2023-09-01T00:10:03+0000","dateUpdated":"2024-02-20T22:26:25+0000","additionalFields":{"descriptionSummary":"Founded in 2009, Squla is an online platform that provides online learning tools, quizzes, and games for pre-school toddlers to 11- and 12-year-old school children across the Netherlands, Germany, and Poland. Based in the Netherlands, Squla is available to both schools and individual parents looking to help children practice and expand their knowledge across many topic areas. When schools locked down due to the COVID-19 pandemic, Squla saw a sudden 20 times increase in online traffic that threatened to crash its platform.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/squla-logo%401x.e51811dc4cc797a6b6e5f597d3c0a4dcc1085a5f.png","displayLocation":"Netherlands","customerNameLower":"squla","footerInfoText":"Published Date","industry":"Education","sortDate":"2023-08-10","headlineUrl":"https://aws.amazon.com/solutions/case-studies/Squla/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Squla","publishedDate":"2023","enableShare":"1","headline":"Squla Modernizes Online Education Platform, Saves Costs Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#benelux","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Benelux","description":"Benelux","dateCreated":"2020-02-03T05:29:47+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#category#archiving","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Archiving","description":"Archiving","dateCreated":"2019-07-22T18:30:59+0000","dateUpdated":"2022-04-09T03:06:56+0000"},{"id":"GLOBAL#use-case#sustainability","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Sustainability","description":"Sustainability","