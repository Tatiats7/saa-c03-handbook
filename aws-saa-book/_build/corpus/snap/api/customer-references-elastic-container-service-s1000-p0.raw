:01+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#hongkong","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Hong Kong","description":"Hong Kong","dateCreated":"2020-02-03T05:29:18+0000","dateUpdated":"2022-02-03T03:31:38+0000"}]},{"item":{"id":"customer-references#sonarsource05112022lknseglkjsaf","locale":"en_US","directoryId":"customer-references","name":"sonarsource05112022lknseglkjsaf","dateCreated":"2023-02-08T01:16:44+0000","dateUpdated":"2023-02-08T01:38:42+0000","additionalFields":{"descriptionSummary":"SonarCloud, part of SonarSource, automatically analyzes your code by simply reading it from your repository without the need for CI-based configuration. Learn how they do this on AWS with Amazon ECS, AWS Fargate, AWS Lambda, and Amazon Aurora.","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"sonarsource","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-05-11","headlineUrl":"https://youtu.be/u3ZwnulzLnU?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2022","enableShare":