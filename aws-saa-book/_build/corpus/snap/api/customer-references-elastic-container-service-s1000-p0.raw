T17:43:16+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#canada","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Canada","description":"Canada","dateCreated":"2020-02-03T05:29:05+0000","dateUpdated":"2022-02-03T03:31:34+0000"}]},{"item":{"id":"customer-references#noggin","locale":"en_US","directoryId":"customer-references","name":"noggin","dateCreated":"2022-02-19T05:01:22+0000","dateUpdated":"2023-07-14T23:32:43+0000","additionalFields":{"descriptionSummary":"Noggin is using AWS to scale on demand to help customers manage crisis-related web traffic, meet customers’ security and compliance needs, focus more on innovation, and drive global expansion. Noggin is an Australian software-as-a-service provider that helps companies worldwide manage crises and business disruption with ease. The company runs its safety and security platform on Amazon ECS and Amazon EC2 and uses Amazon DynamoDB to store customer data.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Noggin_logo%401x.e9641b5db450b2cbd3a8f835eefd58678c5c1e48.png","displayLocation":"Australia","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-02-18","headlineUrl":"https://aws.amazon.com/solutions/case-studies/noggin/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","customer-name":"Noggin","contentType":"Customer Story","headline":"Noggin Speeds Up and Simplifies Crisis Management on AWS"}},"tags":[{"id":"GLOBAL#location#australia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia","description":"Australia","dateCreated":"2020-02-03T05:29:12+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#key-mgmt-service","locale":"en_US