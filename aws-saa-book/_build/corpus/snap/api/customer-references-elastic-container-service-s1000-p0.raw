t","name":"AWS WAF","description":"AWS WAF","dateCreated":"2020-03-02T07:06:04+0000","dateUpdated":"2022-02-03T03:33:07+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#shield","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Shield","description":"AWS Shield","dateCreated":"2020-03-02T07:05:24+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#category#gaming","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gaming","description":"Gaming","dateCreated":"2019-07-22T18:31:55+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#jooycar","locale":"en_US","directoryId":"customer-references","name":"jooycar","dateCreated":"2023-06-01T23:11:01+0000","dateUpdated":"2023-06-08T04:07:34+0000","additionalFields":{"descriptionSummary":"Jooycar se funda en 2014 con el reto de entregar seguros de auto de una forma distinta y revolucionar la forma a través de la cual las personas se relacionan con un seguro de auto. A partir del 2018, Jooycar experimenta un crecimiento muy acelerado al identificar que los usuarios de su tecnología pagaban un 40% menos por su seguro. La empresa evolucionó sus servicios y multiplicó en promedia cada año en tres veces su volumen con una infraestructura basada en Amazon Web Services. Rodrigo Labbé, CEO de Jooycar, y Gonzalo Vásquez, CTO de la empresa, explican cuáles son los principales servicios utilizados por la compañía y cómo AWS le ha permitido triplicar su cartera de clientes sin problemas de infraestructura y aun reduciendo el costo individual por usuario.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/jooycar-logo%401x.24703b2a40081684bda2fc28615b225847e25137.png","displayLocation":"Chile","footerInfoText":"Fecha de publicación","industry":"Semiconductors","sortDate":"2021-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/jooycar/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2021","contentType":"Historia del cliente","customer-name":"Jooycar","headline":"Jooycar triplica negocios a la vez de lograr reducir costos con AWS"}},"tags":[{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"customer-references#category#batch-processi