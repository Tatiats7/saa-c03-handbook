03+0000"},{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#location#kazakhstan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Kazakhstan","description":"Kazakhstan","dateCreated":"2020-04-09T03:35:37+0000","dateUpdated":"2022-02-03T03:31:46+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#mcredit-case-study","locale":"en_US","directoryId":"customer-references","name":"mcredit-case-study","dateCreated":"2021-09-11T00:48:09+0000","dateUpdated":"2022-12-19T23:24:29+0000","additionalFields":{"descriptionSummary":"Mcredit migrated from an on-premises infrastructure to AWS to gain agility and boost automation as part of a renewed digital strategy, lowering its time to market from four months to three weeks. The FinTech firm is a joint venture between Vietnam-based Military Bank and Japan-based Shinsei Bank. The company is using Amazon EKS to orchestrate its fully containerized infrastructure, Amazon Redshift as a data warehouse, and Amazon Direct Connect for secure networking.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Mcredit_logo%401x.d13bb24e8cc3f8572c54bbed0b92a679966e2fb5.png","displayLocation":"Vietnam","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2021-09-10","headlineUrl":"https://aws.amazon.com/solutions/case-studies/mcredit-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Mcredit","enableShare":"1","publishedDate":"2021","contentType":"Customer Story","headline":"Mcredit Offers an Omnichannel Banking Experience with Data-Driven Transformation on AWS"}},"tags":[{"id":"customer-references#category#finserv","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Financial Services","description":"Financial Services","dateCreated":"2019-07-22T18:31:53+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+00