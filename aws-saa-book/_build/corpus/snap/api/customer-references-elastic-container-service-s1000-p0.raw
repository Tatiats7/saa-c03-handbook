03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#content-type#reference-arch-diagram","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Reference Architecture Diagram","description":"Reference Architecture Diagram","dateCreated":"2020-04-29T05:19:31+0000","dateUpdated":"2022-02-03T03:31:09+0000"}]},{"item":{"id":"customer-references#zixi05022022jpiwejfjwegkm","locale":"en_US","directoryId":"customer-references","name":"zixi05022022jpiwejfjwegkm","dateCreated":"2023-02-08T01:17:36+0000","dateUpdated":"2023-07-14T23:32:37+0000","additionalFields":{"descriptionSummary":"Zixi is the industry leader for enabling dependable, live broadcast-quality video over any IP network, any protocol, any cloud and any edge device. In this episode, Head of Product, Tim Baldwin, and SA Lana Kalashnyk explore the solutions architecture driving Zixi\u0027s Software-Defined Video Platform offers cloud-based technologies for broadcasters, enterprises, over-the-top video providers, and mobile service providers around the world. Services used are Amazon EC2, Amazon DynamoDB, Amazon RDS and AWS Elemental Media Services like Elemental and Elemental Media Connect Live that make up Zixi\u0027s data plane.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/zixi-logo%401x.367e738db7e4e1181baf60b1339283bca54c7d9f.jpg","displayLocation":"United States","customerNameLower":"zixi","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-05-02","headlineUrl":"https://youtu.be/ODRfIikoU9s?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Zixi","publishedDate":"2022","enableShare":"1","headline":"Zixi: Managing In-Field Media Encoders with the Zen Master Control Plane","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#elemental-medialive","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental MediaLive","description":"AWS Elemental MediaLive","dateCreated":"2020-03-02T07:03:15+0000","dateUpdated":"2022-02-03T03:32:35+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUp