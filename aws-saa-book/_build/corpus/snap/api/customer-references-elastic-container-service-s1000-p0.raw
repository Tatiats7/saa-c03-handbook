T03:35:33+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#methodology#devops","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"DevOps","description":"DevOps","dateCreated":"2020-06-05T07:06:27+0000","dateUpdated":"2022-02-03T03:32:10+0000"},{"id":"customer-references#category#devops","locale":"en_US","tagNamespaceId":"customer-references#category","name":"DevOps","description":"DevOps","dateCreated":"2019-07-22T18:31:49+0000","dateUpdated":"2022-03-05T03:54:11+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#industry#insurance","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Insurance","description":"Insurance","dateCreated":"2021-12-14T00:56:22+0000","dateUpdated":"2022-02-03T03:32:03+0000"}]},{"item":{"id":"customer-references#ministry-of-justice-video","locale":"en_US","directoryId":"customer-references","name":"ministry-of-justice-video","dateCreated":"2020-11-09T18:06:26+0000","dateUpdated":"2022-01-21T02:44:03+0000","additionalFields":{"descriptionSummary":"The Ministry of Justice in the United Kingdom can trace its history back to 1178. It runs 500 courts and tribunals across England and Wales and employs around 70,000 staff.The ministry also provides legal aid services for those who can’t obtain legal representation. To improve the accessibility of these services, the ministry wanted to make its digital tools more user-friendly—including on mobile devices—and boost service levels. This required an update of the underlying technology infrastructure.In this video, Tom Read, chief digital and information officer at the Ministry of Justice, explains how the ministry moved 10 major on-premises, Oracle-based systems to Amazon Web Services (AWS). It uses services including Amazon Relational Database Service (Amazon RDS) and Amazon Elastic Container Service (Amazon ECS).The move has saved the ministry money, increased infrastructure stability with automated patching and monitoring, and boosted the reliability of critical services.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Ministry-of-justice_Customer-Reference_Logo@1x.745eb781440f6a4778721eff473fb564337b274e.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","industry":"Government","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ministry-of-justice-video/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Ministry of Justice Improves Access to Justice for Society’s Most Vulnerable","customer-name":"Ministry of Justice"}},"tags":[{"id":"GLOBAL#use-case#general-database-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"General Database Migration","description":"General Database Migration","dateCreated":"2020-06-0