 content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#dataprophet-case-study","locale":"en_US","directoryId":"customer-references","name":"dataprophet-case-study","dateCreated":"2020-05-27T16:21:17+0000","dateUpdated":"2023-07-14T23:32:42+0000","additionalFields":{"featured":"0","descriptionSummary":"\u003cp\u003eDataProphet uses AWS to develop machine learning software that enables manufacturers to step towards autonomous manufacturing and reduce defects.\u003c/p\u003e\r\n","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/DataProphet_Customer-Reference_Logo.f71d5994067e10169f7ec0f3a8a5559dd5c18b7e.png","displayLocation":"South Africa","footerInfoText":"Published Date","industry":"Manufacturing","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/dataprophet/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"DataProphet","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"DataProphet Cuts Manufacturing Defects to Zero Using AWS"}},"tags":[{"id":"GLOBAL#location#middle-east-africa","locale":"en_US","tagNamespaceId":"