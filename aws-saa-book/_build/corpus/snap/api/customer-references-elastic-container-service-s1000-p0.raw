category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#business-category#cust-engagement","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2020-06-05T07:06:46+0000","dateUpdated":"2022-02-03T03:31:03+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#totalenergies","locale":"en_US","directoryId":"customer-references","name":"totalenergies","dateCreated":"2024-08-31T00:46:26+0000","dateUpdated":"2024-08-31T00:53:52+0000","additionalFields":{"descriptionSummary":"TotalEnergies Trading \u0026 Shipping achète et vend des cargaisons de pétrole et de produits pétroliers partout dans le monde, assurant ainsi l’approvisionnement en carburants et matières premières. Chaque jour, ses traders réalisent des transactions avec leurs partenaires sur les différentes places de marché de l’énergie. Des transactions totalement dématérialisées qui génèrent des volumes considérables de données non structurées, parfois difficiles à réconcilier au sein des systèmes. Avec l’appui d’Amazon Web Services (AWS), TotalEnergies T\u0026S a mis en place un système basé sur l’IA générative capable d’associer les données structurées et non structurées au sein des flux de transactions. À la clé, une meilleure traçabilité des opérations et une bien meilleure détection des erreurs de saisie.","featured":"0","imageSrcUrl":"https://