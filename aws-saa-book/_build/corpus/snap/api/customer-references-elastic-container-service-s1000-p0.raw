ency about what other people paid for their cars while enabling consumers to engage with TrueCar Certified Dealers who are committed to providing a superior purchase experience.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Truecar_Customer-Reference_Logo.cf845a1b28bb7cacd19f9e7b66c0ea9e96f09c67.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the TrueCar customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of companies.\u003c/p\u003e\r\n","industry":"Automotive","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/TrueCar/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"TrueCar","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"TrueCar Case Study"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#product#directconnect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Direct Connect","description":"AWS Direct Connect","dateCreated":"2020-03-02T07:02:43+0000","dateUpdated":"2022-02-03T03