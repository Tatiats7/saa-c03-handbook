e autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"}]},{"item":{"id":"customer-references#fox-innovator","locale":"en_US","directoryId":"customer-references","name":"fox-innovator","dateCreated":"2022-05-03T00:28:56+0000","dateUpdated":"2024-08-07T18:41:49+0000","additionalFields":{"featured":"0","featureImageURL":"https://d1.awsstatic.com/aws-key-pages/homepage-key-pages/customer-stories-logo/Fox.b05d6c74c51a22bdb3cc3d34cc51bcead2755166.jpg","descriptionSummary":"\u003cp\u003eMillions of viewers engage with content from FOX through its\u0026nbsp;broadcast and OTT platforms. FOX leverages AWS\u0026nbsp;to pioneer the future of world-class live and on-demand content delivery.\u003c/p\u003e\n","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/fox-logo%401x.c53ed2aa45c6ef9479d33bb6963b1070455b252c.png","displayLocation":"United States","customerNameLower":"fox corporation","footerInfoText":"Published Date","description":"\u003cp\u003eMigrating about 8 PB of content from its on-premises storage to the cloud in only 6 weeks\u003cbr /\u003e\n\u003cbr /\u003e\n\u0