022-02-03T03:35:55+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#fox-reinvent-media-services-case-study","locale":"en_US","directoryId":"customer-references","name":"fox-reinvent-media-services-case-study","dateCreated":"2023-09-06T22:56:40+0000","dateUpdated":"2023-09-06T23:23:15+0000","additionalFields":{"descriptionSummary":"FOX uses Amazon Web Services (AWS) to innovate the way live television is created and distributed. Now a year into their strategic collaboration agreement with AWS, FOX is using AWS Media Services to create adaptable, elastic, and efficient workflows to move the television technology industry forward.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Dir