d":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#category#gen-ai","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gen AI","description":"\u003cp\u003eGenerative Artificial Intelligence\u003c/p\u003e\n","dateCreated":"2023-07-10T17:07:31+0000","dateUpdated":"2023-07-10T17:07:31+0000"}]},{"item":{"id":"customer-references#b42-storage-from-es-directory","locale":"en_US","directoryId":"customer-references","name":"b42-storage-from-es-directory","dateCreated":"2024-02-03T03:46:19+0000","dateUpdated":"2024-02-06T01:35:39+0000","additionalFields":{"descriptionSummary":"A B42, startup da área de educação, nasceu na nuvem AWS com a proposta de levar soluções criativas e entregar experiências de capacitação diferenciadas aos professores.\nInicialmente, a edtech adotou serviços AWS para solucionar problemas de armazenamento de dados. Depois, evoluiu para soluções como Amazon Route 53, Amazon API Gateway, Amazon Relational Database Service (Amazon RDS) e Amazon Polly, entre outras.\nNeste vídeo, Rafael Ambrosio, cofundador e diretor de TI da B42, conta detalhes dessa trajetória, detalha aplicativos de aprendizagem criados sobre a nuvem e explica como a companhia conseguiu saltar de aproximadamente 15 para 400 audiobooks produzidos mensalmente com os serviços AWS.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/b42-logo%402x.6e20122bd9f6afed55687d0d168933ba9afd0d5f.png","displayLocation":"Brasil","customerNameLower":"b42","footerInfoText":"Data de publicação","industry":"Mídia e entretenimento","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/b42-storage/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"B42","enableShare":"1","publishedDate":"2023","contentType":"História do cliente","headline":"EdTech B42 aumenta capacidade de produção e entrega de conteúdo educacional com AWS"}},"tags":[{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Stor