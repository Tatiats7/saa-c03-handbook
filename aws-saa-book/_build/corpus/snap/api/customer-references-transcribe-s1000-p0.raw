vi\u0026ccedil;os como o Aamazon Web Services (AWS) que aumentou em 60% o volume de informa\u0026ccedil;\u0026otilde;es coletadas no Central de Relacionamento com Cliente da companhia e reduziu em 20% o tempo de sua an\u0026aacute;lise, agilizando o atendimento e aprimorando a experi\u0026ecirc;ncia do cliente.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Direcional%20Logo%20200x70px.f63e46d56590508bc81e13aa2767a9971947e6a5.png","footerInfoText":"2024","industry":"Construction \u0026 Real Estate","sortDate":"2024-11-05","enableShare":"1","headlineUrl":"https://aws.amazon.com/pt/partners/success/direcional-mytech/","publishedDate":"2024","contentType":"Case Study","headline":"Com IA generativa AWS, Direcional reduz em 20% o tempo de análise de chamadas do relacionamento com o cliente"}},"tags":[{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#indu