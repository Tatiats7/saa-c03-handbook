condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"customer-references#innovator#salesforce","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Salesforce","description":"Salesforce","dateCreated":"2022-09-15T00:48:41+0000","dateUpdated":"2022-09-15T00:48:41+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"customer-references#category#modern-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Modern Applications","description":"\u003cp\u003eModern applications are built with a combination of modular architecture patterns, serverless operational models, and agile developer processes.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:15:46+0000","dateUpdated":"2023-07-14T01:15:46+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"