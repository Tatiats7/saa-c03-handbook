ateUpdated":"2025-02-17T23:55:29+0000","additionalFields":{"descriptionSummary":"Learn how NASA’s Jet Propulsion Laboratory processes satellite data to create unique maps of Earth’s surface using Amazon EC2 Spot Instances.","displayLocation":"United States","customerNameLower":"nasa jet propulsion laboratory","footerInfoText":"Published Date","industry":"Aerospace","sortDate":"2025-01-29","headlineUrl":"https://aws.amazon.com/solutions/case-studies/nasa-jpl-spot-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2025","enableShare":"1","customer-name":"NASA Jet Propulsion Laboratory","headline":"How NASA JPL Processes 70 TB of Satellite Data Products a Day Using Amazon EC2 Auto Scaling with Spot Instances","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#ec2-spot-instances","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Spot Instances","description":"Amazon EC2 Spot Instances","dateCreated":"2022-04-26T06:27:16+0000","dateUpdated":"2022-04-26T06:27:16+0000"},{"id":"GLOBAL#tech-category#cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-01-16T17:43:13+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"customer-references#category#high-performance-computing","locale":"en_US","tagNamespaceId":"customer-references#category","name":"High Performance Computing","description":"High Performance Computing","dateCreated":"2019-07-22T18:32:00+0000","dateUpdated":"2022-02-26T01:35:03+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03: