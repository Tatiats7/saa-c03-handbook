00"},{"id":"GLOBAL#product#elemental-mediatailor","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental MediaTailor","description":"AWS Elemental MediaTailor","dateCreated":"2020-03-02T07:03:20+0000","dateUpdated":"2022-02-03T03:32:36+0000"}]},{"item":{"id":"customer-references#vizor-games-prepares-for-battle","locale":"en_US","directoryId":"customer-references","name":"vizor-games-prepares-for-battle","dateCreated":"2022-10-11T20:30:20+0000","dateUpdated":"2023-07-14T23:32:34+0000","additionalFields":{"descriptionSummary":"Vizor Games wanted to grow beyond its traditional market for mobile and web browser games. It decided to enter the PC and console space with a competitive multi-player game called Blood of Heroes. For its international launch, the company knew it would need a complete change in the company’s technical infrastructure. Vizor Games used AWS to develop the architecture for Blood of Heroes, refine the quality of the game, and launch open and closed beta testing to thousands of users worldwide, ahead of its launch.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/vizor-logo%401x.c116a83078ec9411b17e3cab379d979d1e087d61.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"vizor","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2021-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/vizor-games-prepares-for-battle/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Vizor","publishedDate":"2021","enableShare":"1","headline":"Vizor Games Launches into PC and Console Market using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#belarus","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Belarus","description":"Belarus","dateCreated":"2020-04-09T03:35:24+0000","dateUpdated":"2022-02-03T03:31:46+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category