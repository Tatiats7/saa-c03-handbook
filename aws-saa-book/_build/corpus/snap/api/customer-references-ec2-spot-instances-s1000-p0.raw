locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notification Service (SNS)","dateCreated":"2020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"}]},{"item":{"id":"customer-references#grupo-boticario-case-study-from-pt-directory","locale":"en_US","directoryId":"customer-references","name":"grupo-boticario-case-study-from-pt-directory","dateCreated":"2024-02-03T03:48:28+0000","dateUpdated":"2024-02-06T01:35:36+0000","additionalFields":{"descriptionSummary":"Fundado há 45 anos, o Grupo Boticário é formado por diferentes negócios que atuam em sinergia para criar produtos, serviços e soluções capazes de entregar boas experiências e sentimentos positivos aos clientes.\n\nNos últimos dez anos, o grupo cresceu em ritmo acelerado – hoje é dono de mais de dez marcas, mantém cerca de 4.000 lojas distribuídas pelo Brasil e atua em mais de 50 países no mundo. Para garantir a continuidade e a saúde das operações, o grupo passou também pela modernização e expansão da sua área de tecnologia.\n\nDaniel Knopfholz, vice-presidente de gente e tecnologia do Grupo Boticário, e Renato Pedigoni, diretor de tecnologia do Grupo Boticário, contam como a adoção de serviços AWS ajudou a potencializar a integração de ativos, incluindo produtos e serviços digitais. Eles destacam o uso da arquitetura em nuvem para integrar operações de e-commerce a lojas físicas, bem como para acelerar a inovação e viabilizar o trabalho descentralizado de mais de 2.500 profissionais de TI do grupo.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/grupo-boticario%402x.1ece276b2d751776085648a557807913f902ff56.png","displayLocation":"Brasil","customerNameLower":"grupo boticário","footerInfoText":"Data de publicação","industry":"Varejo","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/grupo-boticario-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Grupo Boticário","enableShare":"1","publishedDate":"2023","contentType":"História do cliente","headline":"Com AWS, Grupo Boticário integra operações do e-commerce e de suas 4.000 lojas"}},"tags":[{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateU