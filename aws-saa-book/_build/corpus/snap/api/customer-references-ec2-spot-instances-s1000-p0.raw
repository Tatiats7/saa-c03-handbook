,"dateUpdated":"2022-02-03T03:31:07+0000"}]},{"item":{"id":"customer-references#city-of-torino-case-study","locale":"en_US","directoryId":"customer-references","name":"city-of-torino-case-study","dateCreated":"2023-09-01T00:10:12+0000","dateUpdated":"2024-02-20T22:26:25+0000","additionalFields":{"descriptionSummary":"Working with satellite and artificial intelligence (AI) technology firm Latitudo 40 and in collaboration with Amazon Web Services (AWS), the team at Torino used an innovative approach to understand how it could make its city, and the communities within it, more sustainable. Together, they created an application to give Torino data-driven insight into where to deploy nature-based solutions.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/citta-di-torino-logo%401x.fe74ba8949a843e36ded17eb348b5ed0ee1ba7b5.png","displayLocation":"Italy","customerNameLower":"city of torino","footerInfoText":"Published Date","industry":"Municipal Government","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/city-of-torino-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"City of Torino","publishedDate":"2023","enableShare":"1","headline":"Torino Is Using Satellites and AWS AI to Improve Quality of Life","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#italy","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Italy","description":"Italy","dateCreated":"2020-02-03T05:30:02+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","date