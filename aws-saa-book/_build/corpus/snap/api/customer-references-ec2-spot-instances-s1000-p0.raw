:31:15+0000"},{"id":"GLOBAL#product#ec2-spot-instances","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Spot Instances","description":"Amazon EC2 Spot Instances","dateCreated":"2022-04-26T06:27:16+0000","dateUpdated":"2022-04-26T06:27:16+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#industry#general-public-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"General Public Services","description":"General Public Services","dateCreated":"2020-01-16T17:42:24+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#use-case#sustainability","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Sustainability","description":"Sustainability","dateCreated":"2021-07-02T05:53:58+0000","dateUpdated":"2022-02-03T03:35:58+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#itau-data-mesh-from-pt-directory","locale":"en_US","directoryId":"customer-references","name":"itau-data-mesh-from-pt-directory","dateCreated":"2024-02-03T03:48:35+0000","dateUpdated":"2024-04-19T23:19:31+0000","additionalFields":{"descriptionSummary":"O Itaú Unibanco está entre os maiores bancos da América Latina. A instituição oferece múltiplos serviços, como plataformas de investimentos, atacado, seguros e contas correntes, entre outros.\n\nO banco tem a missão de se tornar cada vez mais digital, em uma estratégia que envolve mudanças na forma com que seus times trabalham, a modernização de suas tecnologias e uma transformação em sua cultura, com foco em fortalecer a centralidade no cliente e o uso de dados em escala para o desenvolvimento de soluções.\n\nCom essa ambição, a instituição estruturou uma arquitetura de dados no modelo de data mesh com o suporte da AWS, e contou com o suporte da companhia para criar processos que viabilizassem o projeto. A partir da nova estrutura, o Itaú Unibanco obteve benefícios como uma redução de 95% no tempo de processamento de análise do cliente.\n\nNeste vídeo, Moisés Nascimento, chief data officer do Itaú Unibanco, e Roberto Figueira, superintendente de engenharia e plataforma de dados da instituição, contam como o banco reestruturou sua estratégia de dados e implementou a arquitetura data mesh para que eles pudessem ser distribuídos pelas comunidades que desenvolvem seus produtos. Moisés afirma que esses dados foram disponibilizados através da nova arquitetura e, em menos de seis meses, centenas de usuários já estavam criando contas dentro do data mesh.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/itau_logo%401x.387d8a15132c385d83aa638d391b8802b2f31fc6.png","displayLocation":"Brasil","customerNameLower":"itaú","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/itau-data-mesh/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Itaú","enableShare":"1","publishedDate":"2023","contentType":"História do cliente","headline":"Itaú Unibanco adota a arquitetura data mesh e conta com o suporte da AWS"}},"tags":[{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","descripti