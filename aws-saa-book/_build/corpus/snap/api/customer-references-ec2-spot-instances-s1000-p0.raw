GLOBAL#product","name":"AWS App2Container","description":"AWS App2Container","dateCreated":"2021-09-27T07:49:42+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#product#codepipeline","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodePipeline","description":"AWS CodePipeline","dateCreated":"2020-03-02T07:02:13+0000","dateUpdated":"2022-02-03T03:32:25+0000"},{"id":"GLOBAL#product#gamelift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon GameLift","description":"Amazon GameLift","dateCreated":"2020-03-02T07:03:36+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#product#cost-explorer","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Cost Explorer","description":"AWS Cost Explorer","dateCreated":"2020-03-02T07:02:27+0000","dateUpdated":"2022-02-03T03:32:27+0000"},{"id":"GLOBAL#product#freertos","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon FreeRTOS","description":"Amazon FreeRTOS","dateCreated":"2020-03-02T07:03:31+0000","dateUpdated":"2022-02-03T03:32:38+0000"},{"id":"GLOBAL#product#ec2-auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Auto Scaling","description":"Amazon EC2 Auto Scaling","dateCreated":"2020-03-02T07:02:53+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#product#elasticsearch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elasticsearch Service (ES)","description":"Amazon Elasticsearch Service (ES)","dateCreated":"2020-03-02T07:03:05+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#tech-category#satellite","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Satellite","description":"Satellite","dateCreated":"2020-01-16T17:43:32+0000","dateUpdated":"2022-02-03T03:35:32+0000"},{"id":"GLOBAL#product#xray","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS X-Ray","description":"AWS X-Ray","dateCreated":"2020-03-03T00:18:27+0000","dateUpdated":"2022-02-03T03:33:08+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#apache-mxnet","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Apache MXNet on AWS","description":"Apache MXNet on AWS","dateCreated":"2020-03-02T07:01:23+0000","dateUpdated":"2022-02-03T03:32:15+0000"},{"id":"GLOBAL#product#iot-things-graph","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS IoT Things Graph","description":"AWS IoT Things Graph","dateCreated":"2020-03-02T07:04:10+0000","dateUpdated":"2022-02-03T03:32:44+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#treezor","locale":"en_US","directoryId":"customer-references","name":"treezor","dateCreated":"2023-07-17T23:40:19+0000","dateUpdated":"2023-08-11T22:26:57+0000","additionalFields":{"videoSrcUrl":"https://www.youtube.com/watch?v\u003dq9w36629ii8","descriptionSummary":"\u003cp\u003eTreezor, leader europ\u0026eacute;en du Banking-as-a-Service, permet \u0026agrave; des entreprises (Fintechs \u0026amp; corporates) d\u0026rsquo;int\u0026eacute;grer des services bancaires dans leur exp\u0026eacute;rience client. Treezor est un \u0026eacute;tablissement de monnaie \u0026eacute;lectronique et de paiement r\u0026eacute;gul\u0026eacute; autoris\u0026eacute; \u0026agrave; op\u0026eacute;rer des flux dans 25 pays. Avec plus de 100 clients entreprises, le principal d\u0026eacute;fi de Treezor est de pouvoir accompagner la croissance de ses clients, avec de vrais enjeux de scalabilit\u0026eacute; et de s\u0026eacute;curit\u0026eacute;. Julien MORTUAIRE et Nicolas BORDES, respectivement CTO de Treezor et Architecte Cloud chez Treezor, expliquent \u0026ecirc;tre pass\u0026eacute;s sur le cloud pour pouvoir se concentrer sur leur c\u0026oelig;ur de m\u0026eacute;tier : le d\u0026eacute;veloppement de leur logiciel gr\u0026acirc;ce \u0026agrave; une technologie serverless. La r\u0026eacute;silience, la garantie de diff\u0026eacute;rentes zones de disponibilit\u0026eacute; dans plusieurs r\u0026eacute;gions, la s\u0026eacute;curit\u0026eacute; de l\u0026rsquo;infrastructure et des donn\u0026eacute;es, mais aussi la scalabilit\u0026eacute; et les services disponibles pour exploiter au mieux leur architecture, ont fait basculer leur choix vers le Cloud AWS. Un des r\u0026eacute;sultats probants : l\u0026rsquo;\u0026eacute;lasticit\u0026eacute; du cloud afin d\u0026rsquo;absorber les pics de trafic ainsi que les 3 millions d\u0026rsquo;\u0026eacute;v\u0026eacute;nements journaliers.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/treezor_Logo.71674f4ef7a3af6e8d92566e249af9a81abcaf31.png","displayLocation":"France","customerNameLower":"treezor","footerInfoText":"Date de publication","industry":"Banking","sortDate":"2022-