customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"}]},{"item":{"id":"customer-references#ada-support-eks-case-study","locale":"en_US","directoryId":"customer-references","name":"ada-support-eks-case-study","dateCreated":"2025-02-17T23:52:07+0000","dateUpdated":"2025-02-17T23:55:29+0000","additionalFields":{"descriptionSummary":"As its self-managed clusters grew in size and complexity, software company Ada Support Inc. (Ada) significantly increased operational efficiency by migrating to Amazon EKS. Ada helps organizations resolve more customer inquiries with less effort using its customer-service-automation solution that is powered by artificial intelligence (AI). The company sought fully managed services to off-load the heavy lifting and reduce downtime for customers during upgrades. Using Amazon EKS, Ada empowers its engineers to focus less on maintenance and more on company improvements, such as increasing the deployment velocity by 70 percent and developing agents that are powered by generative AI.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/mp-solutions-aim/ada-logo-162x40.e8b06a79fee7a4f75704c648defa92a47a6d24b3.png","displayLocation":"Americas","customerNameLower":"ada