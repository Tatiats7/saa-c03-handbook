000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#mgmt-governance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2019-07-22T18:32:10+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"customer-references#innovator#deliveroo","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Deliveroo","description":"Deliveroo","dateCreated":"2022-09-15T00:48:25+0000","dateUpdated":"2022-09-15T00:48:25+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#prime-video-boosts-scale-and-resilience","locale":"en_US","directoryId":"customer-references","name":"prime-video-boosts-scale-and-resilience","dateCreated":"2019-07-19T15:15:46+0000","dateUpdated":"2024-03-07T01:19:33+0000","additionalFields":{"featured":"0","descriptionSummary":"Amazon.com migrated a service that supports Prime Video from Oracle to Amazon Web Services to increase elasticity and reliability while reducing cost. Prime Video is the video-streaming service from Amazon, the world\u0027s leading online retailer.","imageSrcUrl":"https://d1.awsstatic.com/amazon-logo-1x.a64c3eedfb84347ecf50e210637c0cf810922e10.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eAmazon migrated a service that supports Prime Video from Oracle to Amazon DynamoDB to increase scale and resilience while reducing cost. Amazon moved billions of rows of data to Amazon DynamoDB with zero downtime.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/prime_video_dynamoDB/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Amazon Prime Video","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Prime Video - Boosts Scale and Resilience"}},"tags":[{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverle