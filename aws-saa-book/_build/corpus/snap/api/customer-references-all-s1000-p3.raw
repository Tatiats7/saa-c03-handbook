ateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#growmark-case-study","locale":"en_US","directoryId":"customer-references","name":"growmark-case-study","dateCreated":"2020-05-12T19:18:55+0000","dateUpdated":"2021-12-22T22:35:16+0000","additionalFields":{"descriptionSummary":"With the help of APN Partner Lemongrass Consulting, GROWMARK rapidly transitioned mission-critical SAP applications to the AWS Cloud. GROWMARK is an agricultural cooperative that provides agronomy, energy, grain marketing, and risk management services.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/growmark-logo@1x.4fc9587b9b52198c3a6b46fdbee6417f189f6185.jpg","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Agriculture","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/growmark/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"GROWMARK Migrates Mission-Critical SAP Apps to AWS Cloud in Record Time","customer-name":"Growmark"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCrea