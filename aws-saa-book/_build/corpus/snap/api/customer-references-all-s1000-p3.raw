d":"GLOBAL#tech-category#cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-01-16T17:43:13+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#comprehend","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Comprehend","description":"Amazon Comprehend","dateCreated":"2020-03-02T07:02:18+0000","dateUpdated":"2022-02-03T03:32:25+0000"},{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12T02:01:29+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"}]},{"item":{"id":"customer-references#pabisretail","locale":"en_US","directoryId":"customer-references","name":"pabisretail","dateCreated":"2023-06-01T23:07:15+0000","dateUpdated":"2023-06-08T04:07:39+0000","additionalFields":{"descriptionSummary":"Pabis Retail es una plataforma de inteligencia que combina las mejores tecnologías para que sus usuarios tomen decisiones que pueden ser fácilmente transformadas en dinero o que resulten en la detección de oportunidades, ahorro en recursos y mejores tomas de decisiones. Pabis Retail implementó AWS para consolidar y analizar las millones de transacciones diarias que se producen en las tiendas y cadenas comerciales y ponerlas a disposición del cliente. Al adoptar el cómputo en la nube, Pabis Retail logró incorporar clientes más grandes, con mayor seguridad y con mayor alcance en el mercado.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/pabis_logo%401x.0b48ac6b214c60d0db73357a3a1f6cdf3d0ecc91.png","displayLocation":"México","footerInfo