oduct#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#3m-his","locale":"en_US","directoryId":"customer-references","name":"3m-his","dateCreated":"2020-03-26T20:50:31+0000","dateUpdated":"2023-07-12T01:35:39+0000","additionalFields":{"descriptionSummary":"Implementing a complete DevOps pipeline, from code commit to production, can be challenging enough but the project becomes daunting when faced with accomplishing this across hundreds of apps while maintaining consistency, governance, and security. At 3M HIS, the pipelines now manage the building and deploying of software to different environments on different AWS accounts. Additionally, the pipelines utilize automated, end-to-end testing to ensure software readiness for deployment into production. The pipelines and all the code to support the pipelines are deployed in an automated manner and are owned by the individual delivery teams.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/3m_health_logo@1x.ca24e4479fa33621d0e463f6cdcc8c54aae5881e.png","displayLocation":"Americas","f