eated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#mimoco","locale":"en_US","directoryId":"customer-references","name":"mimoco","dateCreated":"2023-06-01T23:07:29+0000","dateUpdated":"2023-07-14T23:32:39+0000","additionalFields":{"descriptionSummary":"Mimo \u0026 Co es una compañía que opera en la industria textil en Argentina, que ofrece todo lo relacionado con ropa, calzado, accesorios y perfumes para chicos de 0 a 12 años. Hoy cuenta con 35 tiendas y gestiona aproximadamente 120 franquicias. Tiene un segmento en canales de venta que tiene que ver con multimarca y tiene aproximadamente 1.000 empleados en todas las áreas. Vea el testimonio de Martin Romero, CIO de Mimo \u0026 Co, y descubra cómo AWS y BGH Tech Partner han logrado que la compañía sea un líder tecnológico en la industria textil latinoamericana, tradicionalmente conocida por tener poca modernidad en Tecnologías de la Información.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/mimo_logo%401x.d72872fdfbddca61639ea0ee046cd3fab7fb0bde.png","displayLocation":"Argentina","footerInfoText":"Fecha de publicación","industry":"Medios y entretenimiento",