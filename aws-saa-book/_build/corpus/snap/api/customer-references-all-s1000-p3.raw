0"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"}]},{"item":{"id":"customer-references#jdpower20200401xciotywe","locale":"en_US","directoryId":"customer-references","name":"jdpower20200401xciotywe","dateCreated":"2022-05-23T21:42:01+0000","dateUpdated":"2022-12-19T23:25:33+0000","additionalFields":{"descriptionSummary":"Sandeep from JD Power tells us how the company built a data analytics solution on AWS called AI Cloud. JD Power processes terabytes of data performing customer satisfaction research on thousands of product categories producing product insights and rankings in industries such as automotive, healthcare, and electronics. Learn how to build a data lake on Amazon S3 pulling in data from multiple inputs, such as FTP, Amazon S3, and Amazon RDS. Once the data is centrally located, Sandeep shows us how to build catalogs with AWS Glue and custom crawlers running on AWS Fargate. You will also learn how to use Amazon Athena and Amazon Redshift for analytics and machine learning to draw insights from these datasets.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/webteam/category-pages/Analytics/JD-Power_Logo_%401x.3a8391c8e37616e17cdd351d67f1d26cfd3d22ee.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Digital Marketing","sortDate":"2020-04-01","headlineUrl":"https://youtu.be/b93-zn-DtBw?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"JD Power","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"JD Power: Building a Rankings \u0026 Insights Engine with Data Lakes \u0026 Machine Learning on AWS"}},"tags":[{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Complianc