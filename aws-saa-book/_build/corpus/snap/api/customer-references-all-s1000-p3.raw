reated":"2020-03-02T07:06:11+0000","dateUpdated":"2022-02-03T03:33:08+0000"},{"id":"customer-references#category#web-hosting","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Web Hosting","description":"Web Hosting","dateCreated":"2019-07-22T18:32:28+0000","dateUpdated":"2022-03-30T20:30:49+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#location#canada","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Canada","description":"Canada","dateCreated":"2020-02-03T05:29:05+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#british-columbia-institute-of-technology-case-study","locale":"en_US","directoryId":"customer-references","name":"british-columbia-institute-of-technology-case-study","dateCreated":"2019-07-22T19:43:26+0000","dateUpdated":"2022-01-21T02:40:31+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS and AWS Educate, the British Columbia Institute of Technology (BCIT), equips students with cloud-computing resources and skills to help them succeed after they finish school. BCIT is one of Canada\u0027s largest post-secondary polytechnic schools.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/BCIT.76e98b2246a156469d11603e8dbe3b5494a5854e.png","displayLocation":"Canada","footerInfoText":"Published Date","description":"\u003cp\u003eUsing AWS and AWS Educate, the British Columbia Institute of Technology (BCIT), equips students with cloud-computing resources and skills to help them succeed after they finish school. BCIT is one of Canada\u0026#39;s largest post-secondary polytechnic schools. Students at BCIT use their AWS Educate credits for compute resources used in labs, including Amazon Elastic Compute Cloud, Amazon Simple Storage Service, and Amazon Route 53. These exercises move from theory into practice, helping students get the skills they need to secure a job after graduation.\u003c/p\u003e\r\n","industry":"Education","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/british-columbia-institute-of-technology/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"British Columbia Institute of Technology","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"British Columbia Institute of Technology  Case Study"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNa