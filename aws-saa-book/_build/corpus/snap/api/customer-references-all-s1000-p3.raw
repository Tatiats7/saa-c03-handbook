22T18:31:49+0000","dateUpdated":"2022-03-05T03:54:11+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#digitalglobe-machine-learning-case-study","locale":"en_US","directoryId":"customer-references","name":"digitalglobe-machine-learning-case-study","dateCreated":"2019-07-22T17:10:06+0000","dateUpdated":"2021-12-22T18:52:20+0000","additionalFields":{"featured":"0","descriptionSummary":"DigitalGlobe went all in on AWS to meet the growing demand for commercial geo-intelligence, migrating its entire 17-year imagery archive to the cloud. DigitalGlobe is one of the world\u0027s leading providers of high-resolution earth imagery, data, and analysis.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/DigitalGlobe_Customer-Reference_Logo.de0f855e8cdca7569facf78f5dd98b9ced56bc22.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eDigitalGlobe went all in on AWS to meet the growing demand for commercial geo-intelligence, migrating its entire 17-year imagery archive to the cloud. DigitalGlobe is one of the world\u0019s leading providers of high-resolution earth imagery, data, and analysis. The company used AWS Snowmobile to move 100 petabytes of data to the cloud, allowing it to move away from large file-transfer protocols and delivery workflows. DigitalGlobe also uses Amazon SageMaker to handle machine learning at scale. Dr. Walter Scott, CTO and founder at DigitalGlobe, spoke at re:Invent 2017.\u003c/p\u003e\r\n","industry":"Telecommunications","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/digitalglobe-machine-learning/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"DigitalGlobe Machine Learning","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"DigitalGlobe Machine Learning Case Study"}},"tags":[{"id":"GLOBAL#industry#enviro-protection","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Environmental Protection","description":"Environmental Protection","dateCreated":"2020-06-25T04:06:38+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#industry#telecommunications","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Telecommunications","description":"Telecommunications","dateCreated":"2020-01-16T17:42:41+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#product#snowmobile","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Snowmobile","description":"AWS Snowmobile","dateCreated":"2020-03-02T07:05:32+0000","dateUpdated":"2022-02-03T03:33:01+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#driver-and-vehicle-licensing-agency-case-study","locale":"en_US","directoryId":"customer-references","name":"driver-and-vehicle-licensing-agency-case-study","dateCreated":"2019-07-19T15:19:59+0000","dateUpdated":"2021-12-22T18:45:51+0000","additionalFields":{"featured":"0","descriptionSummary":"The UK Driver and Vehicle Licensing Agency (DVLA) is using an API-based approach to empower people and organizations to create innovative applications and services with valuable public data. DVLA maintains the registration and licensing of more than 47 million driver records in Great Britain, as well as the collection and enforcement of Vehicle Excise Duty in the United Kingdom.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/UKDriverAndVehicleLicensingAgency_Customer-Reference_Logo.ce83ca32747b9d87a982a74a3b01cc8e21f4383e.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","description":"\u003cp\u003eThe UK Driver and Vehicle Licensing Agency (DVLA) is using an API-based approach to empower people and organizations to create innovative applications and services with valuable public data. DVLA maintains the registration and licensing of more than 47 million driver records in Great Britain, as well as the collection and enforcement of Vehicle Excise Duty in the United Kingdom. The organization uses Amazon API Gateway to host and manage data APIs with the ability to scale to billions of transactions per month, and AWS Lambda for efficient, cost-effective operational tasks such as report generation.\u003c/p\u003e\r\n","industry":"Government","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/driver-and-vehicle-licensing-agency/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Driver and Vehicle Licensing Agency","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Driver and Vehicle Licensing Agency Case Study"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#tech-categ