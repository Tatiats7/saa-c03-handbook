 Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#apposphere","locale":"en_US","directoryId":"customer-references","name":"apposphere","dateCreated":"2020-03-26T20:49:58+0000","dateUpdated":"2021-12-22T22:36:20+0000","additionalFields":{"descriptionSummary":"Using AWS and bitfusion.io from the AWS Marketplace, Apposphere can scale 50 to 60 percent month-over-month while keeping customer satisfaction high. Based in Austin, Texas, the Apposphere mobile app delivers real-time leads from social media channels. AWS supports Apposphere’s complete technology stack—including Amazon Elastic Compute Cloud (EC2) instances, AWS Elastic Beanstalk, mobile services that support the company’s mobile app, as well as deep-learning solutions. Watch the video to learn more.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/apposphere_logo@1x.5418fc38a4ca6b22f48c65a78d328ec53c93bcfc.png","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/apposphere/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"Apposphere Uses AWS and Bitfusion Deep Learning to Quickly Deploy Intelligent Mobile Solutions","customer-name":"Apposphere"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#category#marketplace","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Marketplace","description":"Marketplace","dateCreated":"2019-07-22T18:32:07+0000","dateUpdated":"2022-04-09T03:06:57+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#marketplace","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Marketplace","description":"AWS Marketplace","dateCreated":"2020-12-02T20:02:51+0000","dateUpdated":"2022-02-03T03:32:50+0000"},{"id":"customer-references#category#mobile","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Mobile","description":"Mobile","dateCreated":"2019-07-22T18:32:14+0000","dateUpdated":"2022-03-24T02:42:27+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#oregon-state-university-s-hatfield-marine-science-center-case-study","locale":"en_US","directoryId":"customer-references","name":"oregon-state-university-s-hatfield-marine-science-center-case-study","dateCreated":"2019-07-22T19:47:38+0000","dateUpdated":"2022-01-21T02:41:05+0000","additionalFields":{"descriptionSummary":"Using AWS Snowball Edge, the Hatfield Marine Science Center (HMSC) at Oregon State University can collect and analyze 100 TB of real-time oceanic and coastal data with no intermediate steps, giving the organization the ability to analyze images immediately using onboard compute capabilities. HMSC is a leading marine laboratory and the campus for Oregon State University’s research, education, and outreach in marine and coastal sciences. AWS Snowball Edge gives HMSC a portable, high-capacity device that it uses remotely to capture and pre-process collected data.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/OSU.4b3a78afd5d1f51081ee1c484410c6638aae0a1a.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"Read the Oregon State University\u0027s Hatfield Marine Science Center customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of customers","industry":"Education","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/oregon-state-university-hatfield-marine-science-center/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Oregon State University\u0027s Hatfield Marine Science Center","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"Oregon State University\u0027s Hatfield Marine Science Center Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"}]},{"item":{"id":"customer-references#ellucian-case-study","locale":"en_US","directoryId":"customer-references","name":"ellucian-case-study","dateCreated":"2019-07-22T19:48:38+0000","dateUpdated":"2022-01-21T02:41:13+0000","additionalFields":{"featured":"0","descriptionSummary":"Ellucian uses AWS for a global, scalable, highly secure, and innovative platform to host its applications to better serve higher-education customers in more than 20 countries around the world. Ellucian provides applications for higher-education institutions.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/ellucian_logo.6719952e43858cce98530f911c5c90607ef0deac.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the Ellucian customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ellucian/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ellucian","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"Ellucian Case Study"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35: