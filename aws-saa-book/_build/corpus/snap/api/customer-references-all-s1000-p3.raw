e":"en_US","tagNamespaceId":"GLOBAL#customer-enablement","name":"AWS Support","description":"AWS Support","dateCreated":"2020-09-04T04:06:22+0000","dateUpdated":"2022-02-03T03:31:12+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#trusted-advisor","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Trusted Advisor","description":"AWS Trusted Advisor","dateCreated":"2020-03-02T07:05:57+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#customer-enablement#enterprise-support","locale":"en_US","tagNamespaceId":"GLOBAL#customer-enablement","name":"AWS Enterprise Support","description":"AWS Enterprise Support","dateCreated":"2020-09-04T04:06:27+0000","dateUpdated":"2022-02-03T03:31:13+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#etermax","locale":"en_US","directoryId":"customer-references","name":"etermax","dateCreated":"2023-06-01T23:08:33+0000","dateUpdated":"2023-06-08T04:07:37+0000","additionalFields":{"descriptionSummary":"Para Etermax el mayor valor agregado que han obtenido con AWS es la velocidad que pueden lograr, además de la alta capacidad de escalamiento en su infraestructura y la posibilidad de innovar constantemente por las facilidades que brinda el cloud de AWS. Con AWS maximizaron su cantidad de usuarios, en un mes pasaron de tener 2 millones a 25 millones de usuarios, sin presentar caídas en la plataforma y con un alto nivel de flexibilidad y agilidad.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/etermax_logo%401x.b49e8b4c334934101d49304628d50a1a7760eeed.png","displayLocation":"Argentina","footerInfoText":"Fecha de publicación","industry":"Videojuegos","sortDate":"2019-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/etermax/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2019","contentType":"Historia del cliente","customer-name":"ETERMAX","headline":"Caso Práctico de Etermax"}},"tags":[{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name