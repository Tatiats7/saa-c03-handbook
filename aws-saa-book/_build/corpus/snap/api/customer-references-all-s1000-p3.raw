to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#ascension-and-pokitdok-case-study","locale":"en_US","directoryId":"customer-references","name":"ascension-and-pokitdok-case-study","dateCreated":"2019-07-19T17:08:19+0000","dateUpdated":"2023-07-12T01:35:26+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, Ascension and partner PokitDok provide customers with real-time cost estimates for their healthcare needs, and were able to create and deploy the application within a matter of weeks. Ascension is a nonprofit healthcare organization in the United States, providing more than $1.8 billion for care of persons living in poverty and other community-benefit programs.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/US/Ascension_Pokitdok.bb927704f4398754ffce0126094be957a2310f92.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eUsing AWS, Ascension and partner PokitDok provide customers with real-time cost estimates for their healthcare needs, and were able to create and deploy the application within a matter of weeks.\u003c/p\u003e\r\n","industry":"Healthcare","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ascension-pokitdok/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ascension and PokitDok","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Ascension and PokitDok Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#public-sector-nonprofit","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Nonprofit","description":"Nonprofit","dateCreated":"2019-07-22T18:39:49+0000","dateUpdated":"2022-05-09T21:31:14+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#customer-segment#non-profit","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Non-profit","description":"Non-profit","dateCreated":"2021-06-04T06:35:44+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNa