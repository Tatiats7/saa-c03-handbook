:"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#dataxu","locale":"en_US","directoryId":"customer-references","name":"dataxu","dateCreated":"2020-05-20T18:29:09+0000","dateUpdated":"2023-07-14T23:32:42+0000","additionalFields":{"descriptionSummary":"DataXu provides programmatic software that helps advertisers save money and increase sales by analyzing and acting on massive amounts of data. An on-premises IT infrastructure created cost and scale issues, so it turned to AWS to run its big data processing platform. The result is cost savings of up to 72 percent a month, a greater reach into a customer base that spans 50 countries, and the ability to process 86 billion messages daily using Amazon Kinesis.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/DataXu_Customer-Reference_Logo.d308a4adfda2210214627d000aebfe1899cc8102.png","displayLocation":"North America","footerInfoText":"Published Date","industry":"Digital Marketing","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/dataxu/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2015","customer-name":"DataXu","contentType":"Customer Story","headline":"AWS Case Study: DataXu"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Optimization","description":"\u003cp\u003eCost Optimization\u003c/p\u003e\n","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2023-07-13T00:08:24+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#business-category#cloud-cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-06-05T07:06:41+0000","dateUpdated":"2022-02-03T03:31:02+0000"},{"id":"GLOBAL#industry#digital-marketing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Digital Marketing","description":"Digital Marketing","dateCreated":"2020-01-16T17:42:16+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-next-media","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-next-media","dateCreated":"2019-07-22T19:53:56+0000","dateUpdated":"2023-07-14T23:32:47+0000","additionalFields":{"featured":"0","descriptionSummary":"Next Media is a media, entertainment, and gaming services business with annual revenues of HK$3 billion. The company runs its Hong Kong news and entertainment websites and mobile applications on AWS. Using AWS enables Next Media to launch new applications in half the time without increasing operating costs while eliminating the need to purchase up to 50 new servers.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/next-media-logo.1fa0c209a07c67dff121b23140f481eebe342aa2.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","description":"\u003cp\u003eNext Media is a media, entertainment, and gaming services business with annual revenues of HK$3 billion. The company is running its Hong Kong news and entertainment websites and mobile applications in AWS. Moving to AWS has enabled Next Media to launch new applications in half the time at existing operating cost levels while eliminating the need to purchase up to 50 new servers.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/next-media/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Next Media","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Next Media"}},"tags":[{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case