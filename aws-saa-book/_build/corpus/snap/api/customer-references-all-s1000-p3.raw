-02-03T03:35:23+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"}]},{"item":{"id":"customer-references#bidmotion","locale":"en_US","directoryId":"customer-references","name":"bidmotion","dateCreated":"2024-08-15T21:35:18+0000","dateUpdated":"2024-08-15T21:43:39+0000","additionalFields":{"descriptionSummary":"Dés son lancement, BidMotion s\u0027est distinguée sur le marché ad-tech comme une plateforme optimisant les diffusions publicitaires mobiles par machine learning. Or le machine learning, qui enrichit toute nouvelle analyse de données avec celles réalisées précédemment, implique de conserver un volume de données exponentiel. La société recherchait donc une solution d\u0027infrastructure hautement évolutive avec des capacités de stockage adaptées à ces volume de données à la stature de big data.","imageSrcUrl":"https://d1.awsstatic.com/FR%20Marketing/2017/Case%20studies/Logo%20BidMotion.4539085863cd7493aa16a765bc535037afc7d8d4.png","displayLocation":"France","customerNameLower":"bidmotion","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/bidmotion/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"BidMotion","publishedDate":"2019","enableShare":"1","headline":"Etude de cas AWS : BidMotion","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-c