7T20:28:40+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#location#china","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"China","description":"China","dateCreated":"2020-02-03T05:29:17+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#brooks-brothers-case-study-amazon-chime","locale":"en_US","directoryId":"customer-references","name":"brooks-brothers-case-study-amazon-chime","dateCreated":"2019-07-19T15:19:46+0000","dateUpdated":"2023-07-14T23:32:44+0000","additionalFields":{"featured":"0","descriptionSummary":"Using Amazon Chime, Brooks Brothers provides its users with a single application for online meetings, calls, and chat, available on all their devices. Brooks Brothers is the oldest men\u0027s clothier in the United States, offering stylish modern clothing and fresh takes on heritage designs.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/BrooksBrothers_Customer-Reference_Logo.2ab61cc5ece0ef7654f175f9063872b2476ea4e5.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eUsing Amazon Chime, Brooks Brothers provides its users with a single application for online meetings, calls, and chat, available on all their devices. Brooks Brothers is the oldest men\u0026#39;s clothier in the United States, offering stylish modern clothing and fresh takes on heritage designs. By using Amazon Chime as its communications platform, Brooks Brothers was able to retire multiple legacy applications.\u003c/p\u003e\r\n","industry":"Retail","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/brooks-brothers-amazon-chime/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Brooks Brothers","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"AWS Case Study: Brooks Brothers"}},"tags":[{"id":"GLOBAL#language#engl