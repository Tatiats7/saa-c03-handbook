eUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#industry#oil-gas","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Oil \u0026 Gas","description":"Oil \u0026 Gas","dateCreated":"2020-01-16T17:42:36+0000","dateUpdated":"2022-02-03T03:32:07+0000"}]},{"item":{"id":"customer-references#ebc","locale":"en_US","directoryId":"customer-references","name":"ebc","dateCreated":"2023-06-01T23:11:25+0000","dateUpdated":"2023-07-14T23:32:26+0000","additionalFields":{"descriptionSummary":"La Escuela Bancaria y Comercial (EBC) migró 95 de sus herramientas y aplicaciones internas a Amazon Web Services (AWS), lo que permitió a la institución construir sistemas de información robustos para respaldar su aumento en la inscripción. Fundada en 1929, EBC es una institución privada de educación superior centrada en la educación empresarial ubicada en México. Usando Amazon Elastic Compute Cloud (Amazon EC2), Amazon Simple Storage Service (Amazon S3) y rds (Amazon RDS), EBC aumentó la disponibilidad de sus bases de datos y ahora puede acceder a los datos más rápido que antes.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/Latam%20Cases%20Assets/EBC_LOGOv1.7f98ea1d0aaf39a3b922dd3cdbb365ea27d3768f.png","displayLocation":"México","footerInfoText":"Fecha de publicación","industry":"Educación","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/ebc/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","customer-name":"Escuela Bancaria y Comercial (EBC)","contentType":"Historia del cliente","headline":"EBC apoya su crecimiento con AWS"}},"tags":[{"id":"GLOBAL#location#central-america","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central America","description":"Central America","dateCreated":"2021-02-19T05:32:25+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-