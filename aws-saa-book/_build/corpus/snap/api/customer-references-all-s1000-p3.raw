ed":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-zynga","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-zynga","dateCreated":"2019-07-22T19:47:06+0000","dateUpdated":"2023-07-14T23:32:41+0000","additionalFields":{"descriptionSummary":"By returning to AWS, Zynga is gaining greater agility, lower costs, and the freedom to experiment with new solutions to deliver world-class game experiences. Zynga is one of the world’s leading developers of social games. The company started using AWS again in 2015 for certain computing services after several years of operating its own private cloud. With changes to their business over the years—particularly a transition to mobile games—and an ever increasing focus on analytics, Zynga determined that it would stop running its own infrastructure and migrate certain workloads back to AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Zynga_Customer-Reference_Logo.c0a938388ac4c6b57b930163af55888cf57c9730.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"By returning to AWS, Zynga is gaining greater agility, lower costs, and the freedom to experiment with new solutions to deliver world-class game experiences. Zynga is one of the world?s leading developers of social games. The company started using AWS again in 2015 for certain computing services after several years of operating its own private cloud. With changes to their business over the years?particularly a transition to mobile games?and an ever increasing focus on analytics, Zynga determined that it would stop running its own infrastructure and migrate certain workloads back to AWS.","industry":"Gaming","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/zynga/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Zynga","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"AWS Case Study: Zynga"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+0000"},{"id":"customer-references#category#mobile","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Mobile","description":"Mobile","dateCreated":"2019-07-22T18:32:14+0000","dateUpdated":"2022-03-24T02:42:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"C