":"Web Hosting","description":"Web Hosting","dateCreated":"2019-07-22T18:32:28+0000","dateUpdated":"2022-03-30T20:30:49+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"}]},{"item":{"id":"customer-references#nextcloud","locale":"en_US","directoryId":"customer-references","name":"nextcloud","dateCreated":"2023-06-01T23:07:24+0000","dateUpdated":"2023-06-08T04:07:39+0000","additionalFields":{"descriptionSummary":"Next Cloud es una empresa mexicana de tecnología enfocada en desarrollar software para agilizar y potencializar los procesos operativos de las pequeñas y medianas empresas. La compañía empezó utilizando AWS en la modalidad de self-service. Las ventajas que los servicios de AWS le dan a Next Cloud permite ofrecer alta disponibilidad y ser una mejor opción en el mercado. Además, la reducción de costos que le genera tener servidores elásticos permite que el capital que tenía invertido para infraestructura ahora lo pueda invertir en tecnología. Hoy en día, Next Cloud pasa por una completa transformación de sus plataformas.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/nextcloud_logo%401x.42735edcef5dc2f68aa3c6409c1eeaa2be9a46bc.png","displayLocation":"México","footerInfoText":"Fecha de publicación","industry":"Fabricación","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/nextcloud/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"Historia del cliente","customer-name":"Next Cloud","headline":"Next Cloud invierte en IA para acercarse más a sus clientes"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#mexico","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Mexico","description":"Mexico","dateCreated":"2020-04-09T00:25:53+0000","dateUpdated":"2022-02-03T03:31:31+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#connect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Connect","description":"Amazon Connect","dateCreated":"2020-03-02T07:02:22+0000","dateUpdated":"2022-02-03T03:32:26+0000"},{"id":"GLOBAL#location#central-america","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central America","description":"Central America","dateCreated":"2021-02-19T05:32:25+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#product#polly","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Polly","description":"Amazon Polly","dateCreated":"2020-03-02T07:04:53+0000","dateUpdated":"2022-02-03T03:32:54+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#business-category#cust-engagement","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2020-06-05T07:06:46+0000","dateUpdated":"2022-02-03T03:31:03+0000"}]},{"item":{"id":"customer-references#snapfinance","locale":"en_US","directoryId":"customer-references","name":"snapfinance","dateCreated":"2023-06-01T23:05:49+0000","dateUpdated":"2023-06-08T04:07:41+0000","additionalFields":{"descriptionSummary":"Snap Finance, empresa que otorga crédito a consumidores, con clientes en Estados Unidos y UK, cuenta con una oficina de back office operacional y soporte de tecnología en Costa Rica. La compañía tiene en ese momento el 100% de su infraestructura en AWS. Con el soporte del partner Escala 24/7, Snap Finance migró la infraestructura sin ningún problema y sin la necesidad de hacer inversiones en hardware adicional.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/snaptech_logo%401x.623529cdddf34c37d3c66a85976c9de6f5ccf3f0.png","customerNameLower":"snap technology","footerInfoText":"Fecha de publicación","industry":"Servicios financieros","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/snapfinance/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"Historia del cliente","customer-name":"Snap Technology","headline":"Snap Finance acelera procesos de innovación con AWS"}},"tags":[{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Gove