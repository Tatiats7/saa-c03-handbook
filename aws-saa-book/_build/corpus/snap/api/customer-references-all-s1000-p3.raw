03T03:32:26+0000"}]},{"item":{"id":"customer-references#iteraps","locale":"en_US","directoryId":"customer-references","name":"iteraps","dateCreated":"2023-06-01T23:03:39+0000","dateUpdated":"2023-06-08T04:07:44+0000","additionalFields":{"descriptionSummary":"Con Amazon Web Services (AWS), Itera, un socio de APN con especialización en gobierno, educación, ayuda a impulsar la transformación digital en el sector público. Desde 2001, Itera se ha especializado en proporcionar las mejores prácticas de TI, servicios de migración y gestión de la nube, y capacitación avanzada para clientes. Al crear una solución con cognito, Itera ayudó a conectar más de 50,000 dispositivos dispares para que el Instituto Nacional Electoral (INE).","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/case-studies/Latam%20Cases%20Assets/Itera_LOGO.c8c76cad62fde7e15a16f809f714db62e6d8c094.jpg","displayLocation":"México","customerNameLower":"itera","footerInfoText":"Fecha de publicación","industry":"Software e Internet","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/iteraps/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Itera","enableShare":"1","publishedDate":"2020","contentType":"Historia del cliente","headline":"Itera ayuda a los clientes a transformarse digitalmente en México"}},"tags":[{"id":"GLOBAL#product#managed-services","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Managed Services","description":"AWS Managed Services","dateCreated":"2020-03-02T07:04:31+0000","dateUpdated":"2022-02-03T03:32:50+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#location#central-america","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central America","description":"Central America","dateCreated":"2021-02-19T05:32:25+0000","dateUpdated":"