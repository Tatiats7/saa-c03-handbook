{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-ferrara-candy","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-ferrara-candy","dateCreated":"2019-07-22T19:52:51+0000","dateUpdated":"2023-07-14T23:32:45+0000","additionalFields":{"featured":"0","descriptionSummary":"Ferrara Candy Company, founded in 1908, is the third largest confectionery company in the United States. The company runs its reporting and analytics environment on AWS. By using AWS, insight delivery times have been reduced from weeks to minutes, and the company has access to full data sets and the ability to analyze on demand.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/ferrara-candy-logo.e9c3e38eba70ed70d1a49638c3e3f76e8c28bb39.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eFerrara Candy Company, founded in 1908, is the third largest confectionery company in the United States. The company is running its reporting and analytics environment (using SAP BusinessObjects on HANA) in an AWS production environment. By using AWS, insight delivery times have been reduced from weeks to minutes, and the company has access to full data sets and the ability to analyze on demand.\u003c/p\u003e\r\n","industry":"Consumer Packaged Goods (CPG)","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ferrara-candy/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ferrara Candy","ena