2019-07-22T18:32:04+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#kit-check-case-study","locale":"en_US","directoryId":"customer-references","name":"kit-check-case-study","dateCreated":"2019-07-22T19:50:35+0000","dateUpdated":"2023-07-14T23:32:27+0000","additionalFields":{"featured":"0","descriptionSummary":"Kit Check provides an automation solution that combines cloud software with IoT technology to help hospitals track medications more effectively, improve compliance and safety in the operating room, and dramatically reduce the time required to restock commonly used drugs. By using AWS, the startup company launched and quickly expanded a profitable niche service across the U.S. healthcare industry while avoiding the expense and overhead of traditional IT systems.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/KitCheck_Customer-Reference_Logo.f3122dd86183363567a11183f59ac0c3eaa7123c.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eKit Check provides an automation solution that combines cloud software with Internet of things (IoT) technology to help hospitals track medications more effectively, improve compliance and safety in the operating room, and dramatically reduce the time required to restock commonly used drugs.\u003c/p\u003e\r\n","industry":"Healthcare","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/kit-check/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Kit Check","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"Kit Check Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#locatio