0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#custos-media-technology-case-study","locale":"en_US","directoryId":"customer-references","name":"custos-media-technology-case-study","dateCreated":"2019-07-19T15:19:32+0000","dateUpdated":"2021-12-22T19:01:27+0000","additionalFields":{"featured":"0","descriptionSummary":"South Africa\u0027s Custos Media Technologies provides services that combat media piracy by tracing a leak to its source in a decentralised way using cryptocurrency. The company grew its business internationally using AWS\u0027s global infrastructure.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/CustosMediaTechnologies_Customer-Reference_Logo.5fbb02611e731359cbe4a556c102dd7c991f9adc.png","displayLocation":"Sub-Saharan Africa","footerInfoText":"Published Date","description":"\u003cp\u003eSouth Africa\u0026#39;s Custos Media Technologies provides services that combat media piracy by tracing a leak to its source in a decentralised way using cryptocurrency. The company grew its business internationally using AWS\u0026#39;s global infrastructure, and a range of services including Amazon EC2 and AWS Auto Scaling.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/custosmediatechnology/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Custos Media Technology","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Custos Media Technol