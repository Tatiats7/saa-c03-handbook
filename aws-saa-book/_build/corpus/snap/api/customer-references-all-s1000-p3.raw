6+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-import-io","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-import-io","dateCreated":"2019-07-22T19:53:33+0000","dateUpdated":"2023-07-14T23:32:46+0000","additionalFields":{"featured":"0","descriptionSummary":"London-based startup import.io provides an online tool that can be used for scraping data from any website, enabling users to turn website information into structured data and APIs. The company turned to AWS to run its web-data analytics service. Using AWS, the 25-person company can focus on developing products instead of maintaining IT infrastructure, enabling it to deliver feature improvements while scaling to handle billions of transactions annually.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Import.io_Customer-Reference_Logo.e4fb0893c597450a4d032e39bcc5928259873287.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","description":"\u003cp\u003eLondon-based startup import.io provides an online tool that can be used for scraping data from any website, enabling users to turn website information into structured data and APIs. The company turned to AWS to run its web-data analytics service. By using AWS, the 25-person company can focus on developing the product instead of buying and maintaining IT infrastructure, enabling it to deliver continuous feature improvements while easily scaling to handle billions of transactions annually.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/import-io/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Import.io","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Import.io"}},"tags":[{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#ca