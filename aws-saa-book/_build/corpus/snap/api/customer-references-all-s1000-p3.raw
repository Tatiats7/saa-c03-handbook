"name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"customer-references#category#infrastructure","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Infrastructure","description":"Infrastructure","dateCreated":"2019-07-22T18:32:04+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#methodology#devops","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"DevOps","description":"DevOps","dateCreated":"2020-06-05T07:06:27+0000","dateUpdated":"2022-02-03T03:32:10+0000"},{"id":"customer-references#category#devops","locale":"en_US","tagNamespaceId":"customer-references#category","name":"DevOps","description":"DevOps","dateCreated":"2019-07-22T18:31:49+0000","dateUpdated":"2022-03-05T03:54:11+0000"}]},{"item":{"id":"customer-references#riot-games-skillpoint-variation1","locale":"en_US","directoryId":"customer-references","name":"riot-games-skillpoint-variation1","dateCreated":"2020-06-18T18:13:57+0000","dateUpdated":"2021-12-22T20:25:25+0000","additionalFields":{"descriptionSummary":"Riot Games is a video game developer and publisher, renowned for creating one of the world’s most-played PC games: League of Legends. To provide players with global availability and secure, low latency access, Riot Games migrated hundreds of millions of player accounts into a consolidated, globally-replicated composite database cluster on Amazon Web Services (AWS).","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/riot-games-logo@1x.74c6d8e881d506fd9de192b255958c06d4db50de.png","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/riot-games-skillpoint/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Riot Games Globalizes Player Accounts and Maintains Availability on AWS","customer-name":"Riot Games"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#gaming","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gaming","description":"Gaming","dateCreated":"2019-07-22T18:31:55+0000","dateUpdated":"2022-03-05T03:54:12+0000"}]},{"item":{"id":"customer-references#euler-hermes-video","locale":"en_US","directoryId":"customer-references","name":"euler-hermes-video","dateCreated":"2020-11-09T18:04:33+0000","dateUpdated":"2021-12-22T20:20:47+0000","additionalFields":{"descriptionSummary":"Headquartered in Paris, France, Euler Hermes provides trade credit insurance, protecting more than 66,000 clients against bad debt. In 2019, the company covered more than €950 billion of transactions, resulting in a turnover of €2.9 billion.Protecting clients at this scale requires a high-performing infrastructure. Euler Hermes receives 600,000 credit limit requests each month relating to 30 million businesses, 82 percent of which must be dealt with in real time.Recently, new platforms and marketplaces have been launched that threaten to disrupt the credit insurance industry. To maintain its position and drive innovation, Euler Hermes moved to Amazon Web Services (AWS) and saw faster time to market for new services, more control over costs, and greater ability to integrate with new market entrants’ services via APIs.In this video, Antoine Larmanjat, chief information officer at Euler Hermes, shares the story of the company’s journey to the cloud and explains why it decided on a serverless-first policy.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Euler-Hermes_Customer-Reference_Logo@1x.ce571f3ae2a50cd5ae7a2cf0d9033786a63828ee.png","displayLocation":"France","footerInfoText":"Published Date","industry":"Insurance","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/euler-hermes-video/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Euler Hermes Rides Out Market Disruption Using AWS","customer-name":"Euler Hermes"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNames