T03:32:46+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"}]},{"item":{"id":"customer-references#solutionshtech","locale":"en_US","directoryId":"customer-references","name":"solutionshtech","dateCreated":"2023-06-01T23:05:46+0000","dateUpdated":"2023-06-08T04:07:41+0000","additionalFields":{"descriptionSummary":"Solutions HTech, una empresa 100% mexicana prestadora de servicios de tecnología de información, tales como aplicaciones web, telefonía móvil y plataformas de conexión para medianas y grandes empresas en las áreas de comunicación y entretenimiento. La compañía también ofrece servicios de desarrollo de software a través de los cuales entrega desde sistemas a la medida acorde a las necesidades específicas de sus clientes, hasta innovadoras y eficientes aplicaciones que se adaptan a los dispositivos móviles más utilizados en el mundo. El portafolio de HTech incluye outsourcing y soporte técnico para tareas de TI, garantizando a los clientes optimización de costos de infraestructura y una mayor capacidad de respuesta con soluciones tecnológicas avanzadas.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/htech_logo%401x.c161f0f630905ef0bb30de88b73b6ea55077a148.png","displayLocation":"México","customerNameLower":"solutions htech","footerInfoText":"Fecha de publicación","industry":"Software e Internet","sortDate":"2020-