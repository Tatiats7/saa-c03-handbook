tion":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#africa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Africa","description":"Africa","dateCreated":"2020-04-09T03:54:59+0000","dateUpdated":"2022-02-03T03:31:56+0000"},{"id":"customer-references#category#business-applications-sap","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: SAP","description":"Business Applications: SAP","dateCreated":"2019-07-22T18:31:24+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#industry#retail","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Retail","description":"Retail","dateCreated":"2020-01-16T17:42:39+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#location#south-africa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"South Africa","description":"South Africa","dateCreated":"2020-03-10T05:18:30+0000","dateUpdated":"2022-02-03T03:31:59+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#workload#sap","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"SAP","description":"SAP","dateCreated":"2021-01-06T00:09:56+0000","dateUpdated":"2022-02-03T03:36:05+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#ssa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Sub-Saharan Africa","description":"Sub-Saharan Africa","dateCreated":"2020-03-10T05:18:06+0000","dateUpdated":"2022-02-03T03:31:58+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"}]},{"item":{"id":"customer-references#askey-case-study","locale":"en_US","directoryId":"customer-references","name":"askey-case-study","dateCreated":"2019-07-19T15:10:57+0000","dateUpdated":"2021-12-22T19:11:00+0000","additionalFields":{"featured":"0","descriptionSummary":"By using AWS, Askey Computer Corporation is ensuring that the growing number of travelers using Taipei Main Station, a railway station and major transportation hub in Taiwan, can move around easily and safely. Askey builds cutting-edge IT solutions that can support smart projects in major cities worldwide.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Askey_Customer-Reference_Logo.a7aff7dd9bfdae8c835025c393796def494ce599.png","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003eBy using AWS, Askey Computer Corporation is ensuring that the growing number of travelers using Taipei Main Station, a railway station and major transportation hub in Taiwan, can move around easily and safely. Askey builds cutting-edge IT solutions that can support smart projects in major cities worldwide. The company runs the IT infrastructure supporting its Taipei Main Station smart project on the AWS Cloud, with Amazon EC2 instances for web applications and services. Askey uses Amazon Kinesis to collate data from thousands of smartphone apps, AWS Lambda to process that data, and Amazon DynamoDB to store it.\u003c/p\u003e\r\n","industry":"Transport \u0026 Logistics","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/askey/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Askey","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Askey Case Study"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#location#taiwan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Taiwan","description":"Taiwan","dateCreated":"2020-02-03T05:29:38+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+