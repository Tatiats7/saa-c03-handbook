tworking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#truffle20200320cwnovemp","locale":"en_US","directoryId":"customer-references","name":"truffle20200320cwnovemp","dateCreated":"2022-05-23T21:43:33+0000","dateUpdated":"2022-05-23T21:53:22+0000","additionalFields":{"descriptionSummary":"Tim from Truffle shows us how to build a Decentralized Application (dApp) with Truffle Suite on AWS. Blockchain developers will learn how to write an Ethereum smart contract, configure a project using the Truffle Framework, create a local instance of their Ethereum test network with Ganache, and leverage the collection of front-end libraries that make writing dApp user interfaces easier and more predictable with Drizzle, all from the Cloud9 console.","displayLocation":"United States","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2020-03-20","headlineUrl":"https://youtu.be/wA2ltwauvRw?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Truffle: Build and Deploy Ethereum Smart Contracts with Truffle and AWS Cloud9","customer-name":"Truffle Blockchain Group"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNam