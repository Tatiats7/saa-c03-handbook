{"id":"customer-references#category#data-lakes-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Data Lakes \u0026 Analytics","description":"Data Lakes \u0026 Analytics","dateCreated":"2019-07-22T18:31:39+0000","dateUpdated":"2022-02-07T13:55:55+0000"},{"id":"GLOBAL#industry#life-sciences","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Life Sciences","description":"Life Sciences","dateCreated":"2020-01-16T17:42:31+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#ewater-case-study","locale":"en_US","directoryId":"customer-references","name":"ewater-case-study","dateCreated":"2019-07-22T19:44:41+0000","dateUpdated":"2023-07-12T01:40:44+0000","additionalFields":{"featured":"0","descriptionSummary":"\u003cp\u003eeWATER, a London-based startup organization, needed help to implement a solution for delivering clean water to impoverished communities in developing nations. It turned to Eseye, an Advanced Technology Partner in the AWS Partner Network, for an IoT-based solution running in the AWS Cloud that includes a simple payment system for tap water and continuous monitoring of water systems in rural villages, which gives residents easy, affordable access to clean water.\u003c/p\u003e\r\n","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/eWater_logo.986a008ea23ee1f71f0afe9c427b97d5d29f2ab3.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","description":"\u003cp\u003eRead the eWATER customer case study, powered by the AWS cloud with the help of AWS Partner Eseye. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Power \u0026 Utilities","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ewater/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"eWATER","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"eWATER Case Study"}},"tags":[{"id":"GLOBAL#product#iot-device-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS IoT Device Management","description":"AWS IoT Device Management","dateCreated":