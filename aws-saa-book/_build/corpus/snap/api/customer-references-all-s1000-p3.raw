43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#waf","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS WAF","description":"AWS WAF","dateCreated":"2020-03-02T07:06:04+0000","dateUpdated":"2022-02-03T03:33:07+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#verizon","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Verizon","description":"Verizon","dateCreated":"2022-09-15T00:48:44+0000","dateUpdated":"2022-09-15T00:48:44+0000"}]},{"item":{"id":"customer-references#verizon-media-case-study-aws-support","locale":"en_US","directoryId":"customer-references","name":"verizon-media-case-study-aws-support","dateCreated":"2019-07-19T14:55:34+0000","dateUpdated":"2023-07-19T03:05:05+0000","additionalFields":{"featured":"0","descriptionSummary":"With brands including Yahoo, HuffPost and TechCrunch, Verizon Media transforms they way people communicate, transact, and stay informed and entertained. Verizon Media saves time, improves agility, and lowers costs thanks to the fast response times, strategic planning programs, and helpful account managers from AWS Support.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Verizon_Customer-Reference_Logo.623aef17cae3b9e799e8055d7e1998ce4684b8be.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eWith brands including Yahoo, HuffPost and TechCrunch, Verizon Media transforms they way people communicate, transact, and stay informed and entertained. Verizon Media saves time, improves agility, and lowers costs thanks to the fast response times, strategic planning programs, and helpful account managers from AWS Support.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/verizon-support/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Verizon","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Verizon Media Case Study - AWS Support"}},"tags":[{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#innovator#verizon","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Verizon","description":"Verizon","dateCreated":"2022-09-15T00:48:44+0000","dateUpdated":"2022-09-15T00:48:44+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#amazon-gameon-case-study","locale":"en_US","directoryId":"customer-references","name":"amazon-gameon-case-study","dateCreated":"2019-07-19T14:56:40+0000","dateUpdated":"2023-07-19T03:04:55+0000","additionalFields":{"featured":"0","descriptionSummary":"Amazon GameOn used off-the-shelf AWS tools and technologies to build a microservices architecture that scales effortlessly and delivers P90 response times of about 47 milliseconds. Amazon GameOn enables external game developers to offer leaderboards, multiplayer play, and tournaments with real-world prizes, fulfilled by Amazon.","imageSrcUrl":"https://d1.awsstatic.com/amazon-logo-1x.a64c3eedfb84347ecf50e210637c0cf810922e10.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eAmazon GameOn used off-the-shelf AWS tools and technologies to build a microservices architecture that scales effortlessly and delivers P90 response times of about 47 milliseconds. Amazon GameOn enables external game developers to offer leaderboards, multiplayer play, and tournaments with real-world prizes, fulfilled by Amazon. Amazon GameOn is using Amazon DynamoDB to store data, Amazon ElastiCache and Amazon DynamoDB Accelerator for caching, and AWS Lambda to orchestrate background jobs, data collection, fraud detection, and billing processes.\u003c/p\u003e\r\n","industry":"Gaming","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/amazon-gameon/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Amazon GameOn","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Amazon GameOn Case Study"}},"tags":[{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#quicksight","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon QuickSight","description":"Amazon QuickSight","dateCreated":"2020-03-02T07:04:56+0000","dateUpdated":"2022-02-03T03:32:55+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#innovator#amazon","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Amazon","description":"Amazon","dateCreated":"2022-04-25T19:05:23+0000","dateUpdated":"2022-06-27T20:43:38+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"}]},{"item":{"id":"customer-references#sainsburys-video","locale":"en_US","directoryId":"customer-references","name":"sainsburys-video","dateCreated":"2020-11-09T18:07:47+0000","dateUpdated":"2023-08-11T00:24:47+0000","additionalFields":{"descriptionSummary":"Founded in 1861, Sainsbury’s is the UK’s second-largest supermarket chain with nearly 1,750 stores. Around 20 percent of its sales revenue comes from online transactions.In 2017, the group recognized the need to improve its online grocery business. But its traditional IT infrastructure made it difficult for Sainsbury’s to use data science and machine learning to fully understand its customers.By moving to Amazon Web Services (AWS), the group has multiple product releases a day compared to five to six releases a year. Sainsbury’s is also making better use of its customer data, which has improved weekly customer engagement fivefold.In this video, Phil Jordan, group chief information officer, and Clodagh Moriarty, group chief digital officer, explain how and why Sainsbury’s moved to AWS.","featured":"0","imageSrcUrl"