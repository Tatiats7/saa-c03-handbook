 ecofit is connecting fitness equipment to the cloud to improve maintenance and make better purchasing decisions. Using AWS IoT Core we explore how sensor data is collected and streamed into AWS Lambda-based microservices to process at scale. We also explore large scale distributed data aggregate using services like Amazon API Gateway and Amazon SQS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/ecofit-logo%401x.69076f0d2f2ebff0b3fe39ea1c2fd6d616ec8432.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Retail","sortDate":"2020-01-21","headlineUrl":"https://youtu.be/DnTQ3matqts?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"ecofit: Responsive Lambda-based Microservices at Scale (LIVE)","customer-name":"Ecofit Networks"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL