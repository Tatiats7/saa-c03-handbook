e":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#decathlon","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Decathlon","description":"\u003cp\u003eNew Innovator for 2023.\u003c/p\u003e\n","dateCreated":"2023-08-10T19:02:07+0000","dateUpdated":"2023-08-10T19:02:07+0000"}]},{"item":{"id":"customer-references#gopro-containers-case-study","locale":"en_US","directoryId":"customer-references","name":"gopro-containers-case-study","dateCreated":"2019-07-19T17:08:45+0000","dateUpdated":"2023-09-21T00:18:56+0000","additionalFields":{"featured":"0","descriptionSummary":"GoPro containerized its microservices architecture for GoPro Plus using Amazon Elastic Container Service and Docker to increase server utilization, accelerate innovation, and improve scalability. GoPro Plus helps people share photos and videos of meaningful experiences with rugged, user-friendly cameras and related products and services.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/GoPro_Customer-Reference_Logo.8c65a70bd9fc5ffd646ffca43b3dd6362330d37f.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eGoPro containerized its microservices architecture for GoPro Plus using Amazon EC2 Container Service and Docker to increase server utilization, accelerate innovation, and improve scalability. GoPro Plus helps people share photos and videos of meaningful experiences with rugged, user-friendly cameras and related products and services. GoPro\u0019s engineering team replaced a third-party process-management solution with Docker containers running on Amazon ECS, which simplified cluster management, ensured deployment consistency, and enabled the team to deliver features to customers faster.\u003c/p\u003e\r\n","industry":"Electronics \u0026 Semiconductors","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/gopro-containers/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"GoPro Containers","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"GoPro Containers Case Study"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#industry#cpg","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Consumer Packaged Goods (CPG)","description":"Consumer Packaged Goods (CPG)","dateCreated":"2020-06-25T04:03:18+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#dev-and-test","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dev \u0026 Test","description":"Dev \u0026 Test","dateCreated":"2019-07-22T18:31:47+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"custo