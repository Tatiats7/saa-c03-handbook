om/Customer%20References%20Directory%20Logos/Elevenia_Customer-Reference_Logo.931fd79a05a7aac1d9e63fb27cbdcf997d97df86.png","displayLocation":"Indonesia","footerInfoText":"Published Date","description":"\u003cp\u003eBy building its business intelligence (BI) platform on the AWS Cloud, Elevenia has gained the agility required to run real-time analytics and saved nearly $20,000 in monthly fees. Elevenia is a leading customer-to-customer (C2C) e-commerce site based in Indonesia. The company is using Amazon Elastic Container Service and AWS Fargate to automate deployment of containerized applications and Amazon Rekognition to improve image quality on its website.\u003c/p\u003e\r\n","industry":"Retail","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/elevenia/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Elevenia","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Elevenia Case Study"}},"tags":[{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#asean","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"ASEAN","description":"ASEAN","dateCreated":"2020-08-20T03:53:05+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","date