e, favorisant le respect des bonnes pratiques, sans lock-in car implémentant de l’Open Source et complètement interopérable avec tout ce qui se fait en API.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/FR%20Marketing/Summit/Summit%20Paris/Logos/Bronze/cycloid-sponsor.7452eec6f0feb8cb362774e7d23266f6950b73ac.png","displayLocation":"France","customerNameLower":"cycloid","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2020-06-04","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/Cycloid/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Cycloid","publishedDate":"2020","enableShare":"1","headline":"Etude de cas AWS : Cycloid","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#language#french","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"French","des