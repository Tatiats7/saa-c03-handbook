page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#orsted-obviux-case-study","locale":"en_US","directoryId":"customer-references","name":"orsted-obviux-case-study","dateCreated":"2020-05-12T19:50:01+0000","dateUpdated":"2023-07-12T01:40:46+0000","additionalFields":{"featured":"0","descriptionSummary":"\u003cp\u003eGreen energy company \u0026Oslash;rsted created its own software startup, Obviux, built entirely in the cloud. Obviux builds streamlined billing software for the energy sector. The company relies on Amazon RDS for MySQL to manage the Amazon Aurora database it uses to store data from more than 1 million customers and 1.2 million smart meters.\u003c/p\u003e\r\n","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/obviux@1x.3c3508b80027d39ad34d3ca74806595171a3df72.png","displayLocation":"Denmark","footerInfoText":"Published Date","industry":"Power \u0026 Utilities","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/orsted-obviux/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ørsted","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Green Energy Company Ørsted Builds Software Startup Obviux on AWS"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Af