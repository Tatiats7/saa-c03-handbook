category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#globe-telecom","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Globe Telecom","description":"Globe Telecom","dateCreated":"2022-09-15T00:48:31+0000","dateUpdated":"2022-09-15T00:48:31+0000"}]},{"item":{"id":"customer-references#ge-power-case-study","locale":"en_US","directoryId":"customer-references","name":"ge-power-case-study","dateCreated":"2019-07-19T14:58:22+0000","dateUpdated":"2023-07-19T03:05:04+0000","additionalFields":{"featured":"0","descriptionSummary":"GE Power uses data analytics on AWS to help power plant customers save millions of dollars, stream 500,000 data records per second, and scale to support the ingestion of 20 billion sensor-data tags. The company provides utilities and power companies throughout the world with solutions for power generation.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/GEPower_Customer-Reference_Logo.7100af15f7461bdc2ea9edec4f9b61e536c54f48.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eGE Power uses data analytics on AWS to help power plant customers save millions of dollars, stream 500,000 data records per second, and scale to support the ingestion of 20 billion sensor-data tags. The company provides utilities and power companies throughout the world with solutions for power generation. GE Power runs its key data-analytics application on AWS, using Amazon Kinesis Data Streams and Amazon Elastic MapReduce.\u003c/p\u003e\r\n","industry":"Power \u0026 Utilities","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/general-electric-power/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"GE Power","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"GE Power Case Study"}},"t