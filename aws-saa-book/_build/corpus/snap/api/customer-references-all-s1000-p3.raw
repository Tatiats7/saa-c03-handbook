"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#innovator#capella-space","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Capella Space","description":"Capella Space","dateCreated":"2022-09-15T00:48:24+0000","dateUpdated":"2022-09-15T00:48:24+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"}]},{"item":{"id":"customer-references#volkswagen-innovator-it","locale":"en_US","directoryId":"customer-references","name":"volkswagen-innovator-it","dateCreated":"2024-09-18T20:02:37+0000","dateUpdated":"2024-09-18T20:08:11+0000","additionalFields":{"descriptionSummary":"Innovatore del settore automobilistico da oltre 80 anni, il Gruppo Volkswagen è il più grande costruttore di automobili in Europa e produce 11 milioni di auto all\u0027anno. Per trasformare i processi produttivi e logistici del settore automobilistico, il Gruppo ha creato il Volkswagen Industrial Cloud su Amazon Web Services (AWS), che utilizza i servizi AWS Internet delle cose (IoT) per collegare i dati di tutte le macchine, gli impianti e i sistemi di oltre 120 siti produttivi. Il Volkswagen Industrial Cloud mira a ottenere un aumento del 30% della produttività, una riduzione del 30% dei costi di fabbrica e un miliardo di euro di risparmi nella catena di distribuzione.","featureImageURL":"https://d1.awsstatic.com/aws-key-pages/homepage-key-pages/customer-stories-logo/Volkswagen.43ca6438cfa96731c97d228d147d47fd76b32fb6.jpg","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/volkswagen-group-logo@1x.b28acee85fe276a4231c3680afe59f7a1107bcd3.png","displayLocation":"Nord America","customerNameLower":"volkswagen","footerInfoText":"Data di pubblicazione","industry":"Settore automobilistico","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/volkswagen-group/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Volkswagen","enableShare":"1","publishedDate":"2020","contentType":"Storia del cliente","headline":"Il Gruppo Volkswagen in AWS"}},"tags":[{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Internet of Things (IoT)","description":"Internet of Things (IoT)","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2023-08-22T20:28:39+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#iot","locale":"en_US","tagNamespaceId":"customer-references#category","name":"IoT","description":"IoT","dateCreated":"2019-07-22T18:32:05+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#industry#automotive","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Automotive","description":"Automotive","dateCreated":"2020-01-16T17:42:11+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"GLOBAL#language#italian","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Italian","description":"Italian","dateCreated":"2020-03-03T06:40:49+0000","dateUpdated":"2022-02-03T03:31:25+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#greengrass","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS IoT Greengrass","description":"AWS IoT Greengrass","dateCreated":"2020-03-02T07:03:43+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"}]},{"item":{"id":"customer-references#siemens-innovator-de","locale":"en_US","directoryId":"customer-references","name":"siemens-innovator-de","dateCreated":"2024-09-18T20:04:16+0000","dateUpdated":"2024-09-18T20:08:09+0000","additionalFields":{"descriptionSummary":"Die Siemens AG ist ein weltweit führendes Unternehmen in den Bereichen Elektrifizierung, Automatisierung und Digitalisierung. Seit fast 175 Jahren treibt Siemens Innovationen in verschiedenen Branchen voran. Das Unternehmen setzt zahlreiche AWS-Services ein, um diese Tradition des Wandels fortzuführen: Beispielsweise bringt es das industrielle Internet der Dinge (Industrial Internet of Things, IIoT) in Eisenbahnen und Fabriken, entwickelt intelligente Infrastruktur für Gebäude sowie verteilte Energiesysteme und implementiert AI in seine Cybersicherheit-Plattform.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Siemens_Customer-Reference_Logo%401x.bb038521df5899223d4bd8364182c2fc69ef288d.png","displayLocation":"Nordamerika","customerNameLower":"siemens","industry":"Biowissenschaften","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/siemens/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"Kundengeschichte","customer-name":"Siemens","headline":"Siemens on AWS"}},"tags":[{"id":"customer-references#category#app-integration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Application Integration","description":"Application Integration","dateCreated":"2019-07-22T18:30:54+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#industry#life-sciences","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Life Sciences","description":"Life Sciences","dateCreated":"2020-01-16T17:42:31+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon