nal Instruments is a global company that provides advanced technology to engineers and scientists, with systems-design software that accelerates productivity and innovation in cutting-edge fields such as healthcare technology, mobile computing, and space research. NI is using Amazon Elastic Compute Cloud Spot Instances to save time and money while improving the quality of products it offers to customers. ","industry":"Electronics \u0026 Semiconductors","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/national-instruments/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"National Instruments","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"National Instruments Case Study"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#category#dev-and-test","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dev \u0026 Test","description":"Dev \u0026 Test","dateCreated":"2019-07-22T18:31:47+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#conte