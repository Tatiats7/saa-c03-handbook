harmacists-association-case-study","locale":"en_US","directoryId":"customer-references","name":"canadian-pharmacists-association-case-study","dateCreated":"2019-07-19T14:58:42+0000","dateUpdated":"2023-07-12T01:35:28+0000","additionalFields":{"featured":"0","descriptionSummary":"The Canadian Pharmacists Association (CPhA) uses AWS to provide healthcare practitioners and patients with accurate information about medications. Services driving CPhA\u0027s digital transformation include Amazon S3, Amazon DynamoDB, Amazon SES, and Elastic Load Balancing.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/CanadianPharmacistsAssocation_Customer-Reference_Logo.dcfd07bb4abc5c5f77bcddaa8240e36adc40548d.png","displayLocation":"Canada","footerInfoText":"Published Date","description":"\u003cp\u003eThe Canadian Pharmacists Association (CPhA) uses AWS to provide healthcare practitioners and patients with accurate information about medications. Services driving CPhA\u0019s digital transformation include Amazon S3, Amazon DynamoDB, Amazon SES, and Elastic Load Balancing products to distribute incoming application traffic across multiple targets.\u003c/p\u003e\r\n","industry":"Healthcare","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/canadian-pharmacists-association/?did\u003dcr_card\u0026trk\u003dcr_card-cr_card","customer-name":"canadian pharmacists association","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Canadian Pharmacists Association Case Study"}},"tags":[{"id":"customer-references#category#database-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Database Migration","description":"Database Migration","dateCreated":"2019-07-22T18:31:40+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:4