tion":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#joongonara-case-study","locale":"en_US","directoryId":"customer-references","name":"joongonara-case-study","dateCreated":"2020-05-21T17:47:44+0000","dateUpdated":"2022-12-22T17:41:31+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eJoonggonara\u0026nbsp;improved time-to-market by 4x and enhanced its customer experience. Joonggonara is Korea\u0026rsquo;s largest online used goods commerce platform. It runs Amazon RDS on Amazon EC2 to improve availability and uses Amazon Elastic MapReduce with Amazon OpenSearch Service to improve searches.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/joongonara@1x.6246bf65b75cc32c0471e7fda0db51a000332ef2.jpg","displayLocation":"Korea","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/joonggonara/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Joonggonara","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Joonggonara Accelerates Time-to-Market Using AWS"}},"tags":[{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-c