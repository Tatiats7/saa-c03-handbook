 prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#q2solutions","locale":"en_US","directoryId":"customer-references","name":"q2solutions","dateCreated":"2020-05-04T20:11:39+0000","dateUpdated":"2023-07-12T01:35:31+0000","additionalFields":{"descriptionSummary":"Q2  Solutions, a leading global clinical laboratory services organization that helps customers achieve better clinical trial outcomes, migrated to the Amazon Web Services (AWS) Cloud to keep pace with new advances in the clinical trials space. According to Steven Lucovsky, corporate lead for cloud operations at Q2 Solutions, “The new advances in sequencing required ten times more compute and ten times more storage, and it just wasn’t going to work in an on-premises environment.” Considering the costs of owning and maintaining equipment, Lucovsky proposed instead moving to the cloud.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/q2-solutions-200x70.af42a8eae6c1e9ee7f52841cba7355453a7a5f69.png","displayLocation":"North America","footerInfoText":"Published Date","industry":"Life Sciences","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/q2-solutions-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","customer-name":"Q2 Solutions","contentType":"Customer Story","headline":"Q2 Solutions Migrates to AWS to Enhance Capabilities"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","date