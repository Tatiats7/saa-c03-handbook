ategory#finserv","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Financial Services","description":"Financial Services","dateCreated":"2019-07-22T18:31:53+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#product#elastic-beanstalk","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elastic Beanstalk","description":"AWS Elastic Beanstalk","dateCreated":"2020-03-02T07:03:00+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#location#middle-east","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East","description":"Middle East","dateCreated":"2020-04-09T03:53:16+0000","dateUpdated":"2022-02-03T03:31:53+0000"}]},{"item":{"id":"customer-references#t-mobile-humanizes-customer-service-using-aws","locale":"en_US","directoryId":"customer-references","name":"t-mobile-humanizes-customer-service-using-aws","dateCreated":"2019-12-12T17:34:26+0000","dateUpdated":"2021-12-22T19:51:16+0000","additionalFields":{"featured":"0","descriptionSummary":"Using the predictive capabilities of machine learning to improve customer service is a great example of AI augmenting human abilities. T-Mobile sees it as an opportunity to serve customers better and faster, benefiting not just the company and its service agents but also enriching the customer experience and creating stronger human-to-human connections.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Case%20Study%20Logos/TMobile_Logo_@2x.87de747939ba39f668c4d0e9d6975af061f3217c.png","displayLocation":"United States","footerInfoText":"Published Date","description":"\u003cp\u003eUsing the predictive capabilities of machine learning to improve customer service is a great example of AI augmenting human abilities. T-Mobile sees it as an opportunity to serve customers better and faster, benefiting not just the company and its service agents but also enriching the customer experience and creating stronger human-to-human connections.\u003c/p\u003e\r\n","industry":"Telecommunications","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/machine-learning/customers/innovators/t_mobile/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"T-Mobile","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"T-Mobile Humanizes Customer Service Using AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#telecommunications","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Telecommunications","description":"Telecommunications","dateCreated":"2020-01-16T17:42:41+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#annalect","locale":"en_US","directoryId":"customer-references","name":"annalect","dateCreated":"2020-05-04T20:11:47+0000","dateUpdated":"2021-12-22T22:38:10+0000","additionalFields":{"descriptionSummary":"Annalect, a subsidiary of Omnicom Media Group, unifies and integrates data into Omnicom’s people-based marketing platform, Omni. The company analyzes consumer attributes and event-level data including demographic data, purchase data, television viewership, location data, clickstream web events, and CRM data to form a 360-degree view of customer behavior. In this re:Invent 2019 session, Eric Whitney, global CTO at Annalect, dives into how the company cost-effectively processes more than 3 trillion events and analyzes petabytes of data using containers, Amazon Athena, and Amazon Redshift Spectrum.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/annalect-logo@1x.5a38c2aac614df3e9758f16d19006293016a91d2.png","displayLocation":"North America","footerInfoText":"Published Date","industry":"Digital Marketing","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/annalect-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Annalect Uses Containers and Amazon Redshift Spectrum to Cost-Effectively Process Trillions of Events","customer-name":"Annalect"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tag