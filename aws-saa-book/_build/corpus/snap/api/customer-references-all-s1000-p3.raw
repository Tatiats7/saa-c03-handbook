dd a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-mydress","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-mydress","dateCreated":"2019-07-22T19:52:42+0000","dateUpdated":"2023-07-14T23:32:40+0000","additionalFields":{"featured":"0","descriptionSummary":"MyDress enables fashion labels in Japan, Korea, and Taiwan to sell clothes and accessories to customers in Hong Kong. MyDress runs a Magento e-commerce platform and associated systems on AWS rather than having to invest in a physical data center. Using AWS, the company can support an average growth rate of 70 percent per year and marketing campaigns that can increase traffic by up to 100 percent, while reducing operating expenditure by 20 percent per year over two years.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/mydress-logo.e6494767ba9a66410ea1e528e33e1158de150a72.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","description":"\u003cp\u003eMyDress enables fashion labels in Japan, Korea, and Taiwan to sell clothes and accessories to customers in Hong Kong. MyDress runs a Magento e-commerce platform and associated systems on AWS rather than having to invest in a physical datacenter. Using AWS, the company can support an average growth rate of 70 percent per year and marketing campaigns that can increase traffic by up to 100 percent, while reducing operating expenditure by 20 percent per year over two years.\u003c/p\u003e\r\n","industry":"Retail","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/mydress/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"MyDress","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: MyDress"}},"tags":[{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:43+0000","dateUpdated":"2022-02-03T03:36:00+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2