-08T18:40:09+0000","dateUpdated":"2023-07-14T23:32:50+0000","additionalFields":{"descriptionSummary":"Midea Group is a leading technology company that sells electrical appliances, HVACs, robotics and automation systems, and smart supply chains, and provides one of the most diversified and comprehensive product and service portfolio. It took Midea only half a month to choose AWS and complete the deployment of Midea Smart Cloud using Amazon EC2, Elastic Load Balancing, Amazon RDS, Amazon Route53, Amazon VPC and AWS Security Groups.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/midea-logo@1x.459686f1a81fd7c9696ba51e08ef2ac1b52fb43a.png","displayLocation":"Asia Pacific","footerInfoText":"Published Date","industry":"Manufacturing","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/midea/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","customer-name":"Midea Group","contentType":"Customer Story","headline":"Midea case study"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#con