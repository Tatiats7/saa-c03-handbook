oryId":"customer-references","name":"ge-appliances-case-study","dateCreated":"2019-07-19T14:57:11+0000","dateUpdated":"2023-07-19T03:04:54+0000","additionalFields":{"featured":"0","descriptionSummary":"In just two years, GE Appliances shifted to a DevOps approach, adopted a cloud-only policy, and achieved total visibility into its hybrid infrastructure by using AWS Management Tools and other AWS solutions. The company has been making appliances for more than 125 years.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/GEPower_Customer-Reference_Logo.7100af15f7461bdc2ea9edec4f9b61e536c54f48.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eIn just two years, GE Appliances shifted to a DevOps approach, adopted a cloud-only policy, and achieved total visibility into its hybrid infrastructure by using AWS Management Tools and other AWS solutions.\u003c/p\u003e\r\n","industry":"Manufacturing","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ge-appliances/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"GE Appliances","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"GE Appliances Case Study"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#cloudtrail","locale":"en_US","t