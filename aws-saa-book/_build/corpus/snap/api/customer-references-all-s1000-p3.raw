ory","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"}]},{"item":{"id":"customer-references#netflix-aws-reinvent2020-video","locale":"en_US","directoryId":"customer-references","name":"netflix-aws-reinvent2020-video","dateCreated":"2022-10-18T21:00:06+0000","dateUpdated":"2023-07-19T03:04:57+0000","additionalFields":{"descriptionSummary":"In this AWS re:Invent 2020 session, explore a Netflix tool, ConsoleMe, developed to address this issue securely, reduce inconsistencies and delays experienced by end users, and lower the multi-account management burden.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Netflix_1x.4ae5e442fea7c25ec27b81891425de0b830cbfcc.png","displayLocation":"United States","customerNameLower":"netflix","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/netflix-aws-reinvent2020-video/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Netflix","publishedDate":"2020","enableShare":"1","headline":"Untangling multi-account management with ConsoleMe","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#netflix","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Netflix","description":"Netflix","dateCreated":"2022-04-25T19:06:40+0000","dateUpdated":"2022-06-10T21:39:50+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#kiusys","locale":"en_US","directoryId":"customer-references","name":"kiusys","dateCreated":"2023-06-01T23:07:58+0000","dateUpdated":"2023-07-14T23:32:40+0000","additionalFields":{"descriptionSummary":"Kiu System Solutions nace en 2003 brindando soluciones tecnológicas para líneas aéreas, entre ellas sistemas de reservas y emisión, soluciones de e-commerce, de control de carga para aviones y puntaje para pasajeros frecuentes. Actualmente, la compañía cuenta con 52 clientes a nivel global, transportando 25 millones de pasajeros, y su sistema está presente en 18 mil agencias de viaje. Con AWS, Kiu logró reducir los tiempos de respuesta de sus servicios, creando una infraestructura de red intolerante a fallas, basada en una arquitectura de microservicios. Procesar 250 mil mensajes de tarifación interlineal le tomaba a Kiusys entre 17 y 22 horas. Gracias a las soluciones en la nube de AWS, la empresa redujo ese tiempo a entre 6 y 7 minutos.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/kiusys_logo%401x.235d4d3e7a8fba9df13ffad9ae6b1df681f2b310.png","displayLocation":"Uruguay","footerInfoText":"Fecha de publicación","industry":"Software e Internet","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/kiusys/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","customer-name":"Kiu System Solutions","contentType":"Historia del cliente","headline":"Kiu System Solutions reduce drásticamente sus tiempos de respuesta con la agilidad de la nube AWS"}},"tags":[{"id":"GLOBAL#location#uruguay","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Uruguay","description":"Uruguay","dateCreated":"2020-06-26T01:46:23+0000","dateUpdated":"2022-02-03T03:31:33+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#tech-category#containers","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Containers","description":"Containers","dateCreated":"2020-02-13T00:27:17+0000","dateUpdated":"2022-02-03T03:35:26+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceI