nt#non-profit","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Non-profit","description":"Non-profit","dateCreated":"2021-06-04T06:35:44+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#ravensbourne-univeristy","locale":"en_US","directoryId":"customer-references","name":"ravensbourne-univeristy","dateCreated":"2024-08-16T22:07:04+0000","dateUpdated":"2024-08-16T22:09:17+0000","additionalFields":{"descriptionSummary":"By using AWS Elemental for its video streaming services, Ravensbourne University has been able to reach a higher number of students with higher satisfaction. Ravensbourne is an innovative, industry-focused university located in the heart of London that specializes in the cross-section between creativity and technology. The university uses AWS as a way to educate their broadcast and television students by streaming both live and recorded content.","imageSrcUrl":"https://d1.awsstatic.com/WWPS/images/Ravensbourne_Logo_Special_Use_RGB.fbd06b84d2b58ced2333a32748cd0f78457b89e0.png","displayLocation":"United Kingdom","customerNameLower":"ravensbourne university london","footerInfoText":"Published Date","industry":"Education","sortDate":"2019-09-07","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ravensbourne-univeristy/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ravensbourne University London","publishedDate":"2019","enableShare":"1","headline":"Ravensbourne University Case Study","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#ukir","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"UK/IR","description":"UK/IR","dateCreated":"2020-02-19T23:06:44+0000","dateUpdated":"2022-02-03T03:31:51+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#uk","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United Kingdom","description":"United Kingdom","dateCreated":"2020-02-03T05:30:18+0000","dateUpdated":"2022-02-03T03:31:52+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"}]},{"item":{"id":"customer-references#secureappbox","locale":"en_US","directoryId":"customer-references","name":"secureappbox","dateCreated":"2024-08-16T21:59:43+0000","dateUpdated":"2024-08-16T22:08:05+0000","additionalFields":{"descriptionSummary":"SecureAppbox helps organisations manage sensitive data and comply with General Data Protection Regulation (GDPR). In 2018, the number of child refugees entering Sweden without parents almost tripled. The Swedish Association of Local Authorities and Regions, SKL (Sveriges Kommuner och Landsting), turned to SecureAppbox with the mission to build and launch a secure national platform in just eight weeks in an effort to find these 60,000 child refugees homes. SecureAppBox turned to AWS for the security and scalability of the AWS Cloud.","imageSrcUrl":"https://d1.awsstatic.com/WWPS/images/secureappbox.d170254412ce29c05f9c2fcc93222114f8575946.jpg","displayLocation":"Sweden","customerNameLower":"swedish association of local authorities and regions (adda inköpscentral - formerly skr)","footerInfoText":"Published Date","industry":"State and Local Government","sortDate":"2019-09-07","headlineUrl":"https://aws.amazon.com/solutions/case-studies/secureappbox/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Swedish Association of Local Authorities and Regions (Adda Inköpscentral - formerly SKR)","publishedDate":"2019","enableShare":"1","headline":"SecureAppbox Case Study","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#industry#general-public-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"General Public Services","description":"General Public Services","dateCreated":"2020-01-16T17:42:24+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#nordics","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Nordics","description":"Nordics","dateCreated":"2020-02-03T05:30:04+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#sweden","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Sweden","description":"Sweden","dateCreated":"2020-02-03T05:30:11+0000","dateUpdated":"2022-02-03T03:31:51+0000"},{"id":"GLOBAL#industry#govt-state-local","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"State and Local Government","description":"State and Local Government","dateCreated":"2021-12-15T23:38:31+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"}]},{"item":{"id":"customer-references#pumpkin","locale":"en_US","directoryId":"customer-references","name":"pumpkin","dateCreated":"2024-08-16T22:07:26+0000","dateUpdated":"2024-08-16T22:09:17+0000","additionalFields":{"descriptionSummary":"Pumpkin est une application mobile née en 2014 dans l’optique de simplifier les échanges d’argent entre particuliers. Elle comprend également un service de billetterie dédié aux associations. Avec sa base utilisateurs qui double tous les 6 mois et ses 3 millions de transactions effectuées depuis la création, Pumpkin avait besoin d’une infrastructure et de services souples, capables de s’adapter à sa croissance.","imageSrcUrl":"https://d1.awsstatic.com/FR%20Marketing/2018/Case%20studies/Logo%20Pumpkin.3cc49d225cfbfb90ff5f1660099ad7b8ce36a88e.png","displayLocation":"France","customerNameLower":"pumpkin","footerInfoText":"Published Date","industry":"Retail","sortDate":"2019-09-07","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/pumpkin/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Pumpkin","publishedDate":"2019","enableShare":"1","headline":"Pumpkin et les défis d’une croissance exponentielle","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#elb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Elastic Load Balancing (ELB)","description":"Elastic Load Balancing (ELB)","dateCreated":"2020-03-02T07:03:09+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#language#french","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"French","description":"French","dateCreated":"2020-03-03T06:40:44+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamesp