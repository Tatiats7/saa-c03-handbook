Created":"2020-03-02T07:03:09+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-jobvite","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-jobvite","dateCreated":"2019-07-22T19:51:07+0000","dateUpdated":"2023-07-14T23:32:40+0000","additionalFields":{"featured":"0","descriptionSummary":"Jobvite is a recruiting platform for the social web that integrates applicant tracking, employee referrals, recruitment marketing, and video interviews under one cloud-based platform. After experiencing unexpected service interruptions, the company migrated its entire platform—including its databases, application servers, reporting framework, and email notification services—to AWS. Using AWS, Jobvite has decreased its operational costs by 35 percent and increased the availability of its application to better than 99.98 percent.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Jobvite_Customer-Reference_Logo.7878882552c01fd4edbe8be89636822d7a057181.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eJobvite is a recruiting platform for the social web that integrates applicant tracking, employee referrals, recruitment marketing, and video interviews under one cloud-based platform. After experiencing unexpected service interruptions, the company decided to migrate its entire platform?including its databases, application servers, reporting framework, and email notification services?to AWS. By using AWS, Jobvite has decreased its operational costs by 35 percent and increased the availability of its application to better than 99.98 percent.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/jobvite/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Jobvite","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Jobvite"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"customer-references#category#business-applications-microsoft","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: Microsoft","description":"Business Applications: Microsoft","dateCreated":"2019-07-22T18:31:11+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"En