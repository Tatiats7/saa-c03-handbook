r\n","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/saildrone-Logo%401x.112d27ba21f6cbb3d5298d694f3945dedabc7263.png","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Environmental","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/saildrone-video-case-study?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Saildrone Video","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Saildrone Explore the Oceans Using AWS Machine Learning"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#enviro-protection","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Environmental Protection","description":"Environmental Protection","dateCreated":"2020-06-25T04:06:38+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#use-case#sustainability","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Sustainability","description":"Sustainability","dateCreated":"2021-07-02T05:53:58+0000","dateUpdated":"2022-02-03T03:35:58+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US",