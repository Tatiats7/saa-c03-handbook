iption":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#business-applications-microsoft-sql","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: Microsoft SQL","description":"Business Applications: Microsoft SQL","dateCreated":"2019-07-22T18:31:19+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#workload#microsoft","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"Microsoft","description":"Microsoft","dateCreated":"2021-01-06T00:09:49+0000","dateUpdated":"2022-02-03T03:36:04+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#kellogg-company-case-study-sap-erp-migration","locale":"en_US","directoryId":"customer-references","name":"kellogg-company-case-study-sap-erp-migration","dateCreated":"2019-07-22T19:49:27+0000","dateUpdated":"2021-12-22T20:17:30+0000","additionalFields":{"featured":"0","descriptionSummary":"Kellogg\u0027s is using AWS to increase reliability, improve performance, and conduct faster replication of its mission-critical SAP environments. Kellogg\u0027s is a renowned, 100-year-old consumer foods company that selected AWS to help reduce the costs and overhead associated with managing its traditional IT infrastructure. A key step in Kellogg\u0027s cloud journey was migrating its Asia Pacific SAP environment running on Oracle to AWS with zero unplanned downtime across five countries and leveraging multiple availability zones.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Kellogg_Customer-Reference_Logo.302a14cf161872f1a6d1f60e17ac59d65fb30210.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the Kellogg Company customer case study, highlighting how the company used AWS to migrate its mission-critical SAP ERP platform. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Consumer Packaged Goods (CPG)","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/kellogg-company-case-study-sap-erp-migration/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Kellogg Company","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"Kellogg Company Case Study-SAP ERP Migration"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-0