d":"GLOBAL#product","name":"AWS X-Ray","description":"AWS X-Ray","dateCreated":"2020-03-03T00:18:27+0000","dateUpdated":"2022-02-03T03:33:08+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"}]},{"item":{"id":"customer-references#aws-case-study-woongjin-thinkbig","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-woongjin-thinkbig","dateCreated":"2019-07-19T14:56:47+0000","dateUpdated":"2022-12-22T17:42:21+0000","additionalFields":{"featured":"0","descriptionSummary":"Woongjin Thinkbig is a specialized educational service company that provides digital educational and cultural content. The organization recently launched a customized learning service on AWS, built using artificial intelligence and an integrated data-analytics platform.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Woongjin_Customer-Reference_Logo.d22315b7917edc7ba19d770a6a3c92e865c75360.png","displayLocation":"Korea","footerInfoText":"Published Date","description":"\u003cp\u003eWoongjin Thinkbig, a specialized educational service company that develops and provides various digital educational \u0026amp; cultural contents in line with the development of digital technologies, launched an \u001cAI learning coaching service\u001d by building an integrated data analytics platform that provides customized services based on customer data. It analyzes big data through AWS\u0019s Kinesis and EMR and successfully provides meaningful results to customers.\u003c/p\u003e\r\n","industry":"Education","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/woongjin-thinkbig/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Woongjin Thinkbig","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"AWS Case Study: Woongjin Thinkbig"}},"tags":[{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#korea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Korea","description":"Korea","dateCreated":"2020-02-03T05:29:25+0000","dateUpdated":"2022-02-03T03:31:39+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","descrip