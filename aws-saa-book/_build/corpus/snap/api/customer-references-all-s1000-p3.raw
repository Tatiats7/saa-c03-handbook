industry","name":"Energy","description":"Energy","dateCreated":"2020-07-15T21:58:51+0000","dateUpdated":"2022-02-03T03:32:02+0000"}]},{"item":{"id":"customer-references#edf-energy-case-study","locale":"en_US","directoryId":"customer-references","name":"edf-energy-case-study","dateCreated":"2019-07-19T14:55:49+0000","dateUpdated":"2023-07-12T01:40:43+0000","additionalFields":{"featured":"0","descriptionSummary":"\u003cp\u003eEDF Energy, the UK\u0026#39;s largest producer of low-carbon electricity, uses AWS to build and scale its PowerShift platform, which enables customers to manage and monetize their energy assets. Using AWS, the company reduced deployment time from days to 14 minutes.\u003c/p\u003e\r\n","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/EDFEnergy_Customer-Reference_Logo.b34b30ac5ec2801b6c7c7ada62b2fd63f6182a29.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","description":"\u003cp\u003eEDF Energy is the UK\u0019s largest producer of low-carbon electricity and the biggest supplier of electricity by volume in Great Britain. AWS enables EDF to build and scale its PowerShift platform, which enables customers to reduce or shift energy consumption when needed and monetize their excess energy through EDF Energy\u0026#39;s trading services. Using AWS, the company delivers a scalable solution for its customers and reduced deployment time from days to 14 minutes.\u003c/p\u003e\r\n","industry":"Power \u0026 Utilities","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/edf/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"EDF Energy","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"EDF Energy Case Study"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"G