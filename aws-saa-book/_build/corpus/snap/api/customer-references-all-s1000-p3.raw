01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#elb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Elastic Load Balancing (ELB)","description":"Elastic Load Balancing (ELB)","dateCreated":"2020-03-02T07:03:09+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"}]},{"item":{"id":"customer-references#euronext-video","locale":"en_US","directoryId":"customer-references","name":"euronext-video","dateCreated":"2020-11-09T18:04:55+0000","dateUpdated":"2021-12-22T20:22:07+0000","additionalFields":{"descriptionSummary":"Euronext operates stock exchanges in several major European capitals. It is home to more than 1,300 corporate stock issuers with a market capitalization of over €3.7 trillion, making it the largest exchange in continental Europe. The company handles millions of transactions a day comprising 1.5 billion digital messages.Euronext wanted to make better use of its data and start using artificial intelligence. But with data processing taking 6 hours after trading each day—12 hours on the busiest days—clients and business units struggled to analyze data in time for the next day’s trading.Using Amazon Web Services (AWS), analytics now happen in near real time, Euronext can scale up at short notice on high-volume days, and it can provide data scientists with analytics consoles in 1 day instead of 45 days.In this video, Nicolas Rivard, chief innovation officer at Euronext, outlines the decision-making process behind the organization’s move to AWS in 2017.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Euronext_Customer-Reference_Logo@1x.ad2526700defb7fa1f93b9060ae3509c4ff41858.png","displayLocation":"France","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/euronext-video/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Euronext Gets More Agile with AWS","customer-name":"Euronext"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"customer-references#category#finserv","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Financial Services","description":"Financial Services","dateCreated":"2019-07-22T18:31:53+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"}]},{"item":{"id":"customer-references#national-australia-bank-digital-transformation-case-study","locale":"en_US","directoryId":"customer-references","name":"national-australia-bank-digital-transformation-case-study","dateCreated":"2020-01-30T01:08:00+0000","dateUpdated":"2021-12-22T18:51:58+0000","additionalFields":{"descriptionSummary":"National Australia Bank (NAB), Australia\u0027s largest business bank, started to accelerate its cloud journey with AWS in 2017. For NAB\u0027s initial migration of 30 applications, AMS oversaw all infrastructure operations tasks needed to run AWS at scale, reducing the operational overhead and risk for NAB. This allowed the bank to direct its time and resources to up-leveling their staff and developing business strategy.","imageSrcUrl":"https://d1.awsstatic.com/logos/National_Australia_Bank.14cd8e7dd08807868ecabc17ade14ea0dddccf0a.png","displayLocation":"Australia","footerInfoText":"Published Date","description":"National Australia Bank (NAB) worked with AWS to accelerate its digital transformation. NAB is one of the four largest financial institutions in Australia and serves nine million customers across 900 locations worldwide. NAB has migrated over 400 services to the cloud and achieved 100 percent availability for the cloud services supporting these applications. This allows the bank to deliver better outcomes for its customers who get access to an always-on banking service. Additionally, in two years, more than more than 4,200 bank staff have been trained on cloud services, over 550 earning certified credentials.","industry":"Financial Services","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/national-australia-bank-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"National Australia Bank","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"National Australia Bank Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#australia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia","description":"Australia","dateCreated":"2020-02-03T05:29:12+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#location#anz","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia \u0026 New Zealand","description":"Australia \u0026 New Zealand","dateCreated":"2020-04-09T00:26:11+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#managed-services","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Managed Services","description":"AWS Managed Services","dateCreated":"2020-03-02T07:04:31+0000","dateUpdated":"2022-02-03T03:32:50+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#custora-case-study","locale":"en_US","directoryId":"customer-references","name":"custora-case-study","dateCreated":"2019-07-19T15:19:12+0000","dateUpdated":"2021-12-22T18:45:11+0000","additionalFields":{"featured":"0","descriptionSummary":"Custora reduced its operational burden, eliminated downtime, and increased the speed of onboarding new customers by shifting client data to Amazon EFS. Custora is an advanced customer-segmentation platform built for retail, enabling marketing and CRM teams to easily create targeted customer lists to improve ROI for email, display ads, Facebook, and direct-mail campaigns.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/600x400_Custora_Logo.9ce599348c7793b282108d3e1d619062c63acbac.jpg","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eCustora reduced its operational burden, eliminated downtime, and increased the speed of onboarding new customers by shifting client data to Amazon EFS.\u003c/p\u003e\r\n","industry":"Digital Marketing","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/custora/?did\u003dcr_card\u0026trk\u003dcr_card-cr_card","customer-name":"custora","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Custora Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"customer-references#category#batch-processing","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Batch Processing","description":"Batch Processing","dateCreated":"2019-07-22T18:31:02+0000","dateUpdated":"2022-02-26T01:35:02+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#digital-marketing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Digital Marketing","description":"Digital Marketing","dateCreated":"2020-01-16T17:42:16+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"}]},{"item":{"id":"customer-references#skf-case-study","locale":"en_US","directoryId":"customer-references","name":"skf-case-study","dateCreated":"2019-07-19T15:11:05+0000","dateUpdated":"2021-12-22T19:28:40+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, SKF is optimizing its production processes, reducing costs, and providing a better experience to its customers. SKF is a bearing manufacturer founded in Sweden in 1907.","imageSrcUrl":"https://d1.awsstatic.com/Industries/Manufacturing/600x400_SKF_Transp_noTM.7b6dff8d085cc8534ef7ea96888f6e46071c128c.png","displayLocation":"Germany","footerInfoText":"Published Date","description":"\u003cp\u003eUsing AWS, SKF is optimizing its production processes, reducing costs, and providing a better experience to its customers. SKF is a bearing manufacturer founded in Sweden in 1907. SKF uses AWS machine learning, data lakes, databases, and more to help it speed innovation.\u003c/p\u003e\r\n","industry":"Manufacturing","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/skf/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"SKF","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"SKF Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#germany","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Germany","description":"Germany","dateCreated":"2020-02-03T05:29:55+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#dach","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"DACH","description":"DACH","dateCreated":"2020-02-03T05:29:52+0000","dateUpdated":"2022-02-03T03:31:47+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#aws-case-study-finfabrik","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-finfabrik","dateCreated":"2019-07-19T15:11:02+0000","dateUpdated":"2021-12-22T19:42:36+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, FinFabrik can easily make changes and deploy new systems in just 10 minutes, ensuring data privacy and latency targets are met. The fintech uses Amazon Virtual Private Cloud to segregate client networks, Amazon Elastic Container Service to run serverless computing, and AWS Identity and Access Management for account authentication.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/FinFabrik_Logo.f2e380005f93255e90383baf1db73b196ef39fff.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","description":"\u003cp\u003eRead the FinFabrik customer case study. FinFabrik is a Hong Kong\u0013based fintech company that creates software-as-a-service applications to facilitate trading multiple assets such as equities and cryptoassets. Its mission is to empower capital markets businesses and individuals to access more investment opportunity.\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/finfabrik/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"FinFabrik","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"AWS Case Study - FinFabrik"}},"tags":[{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#ses","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Email Service (SES)","description":"Amazon Simple Email Service (SES)","dateCreated":"2020-03-02T07:05:22+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"customer-references#category#finserv","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Financial Services","description":"Financial Services","dateCreated":"2019-07-22T18:31:53+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#location#china","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"China","description":"China","dateCreated":"2020-02-03T05:29:17+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#location#hongkong","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Hong Kong","description":"Hong Kong","dateCreated":"2020-02-03T05:29:18+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"}]},{"item":{"id":"customer-references#aws-case-study-cyberlink","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-cyberlink","dateCreated":"2019-07-19T15:19:41+0000","dateUpdated":"2021-12-22T19:42:12+0000","additionalFields":{"featured":"0","descriptionSummary":"CyberLink cuts development time for U Webinar in half by using AWS and cuts IT administration by 28 percent. CyberLink is a leading provider of multimedia software and a pioneer in video and audio technologies.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/CyberLink_Customer-Reference_Logo.a048ec5e47e002534c609e53ac7b7c752eaf77b4.png","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003eRead the CyberLink customer case study. CyberLink cuts development time for U Webinar in half by using the AWS Cloud and cuts IT administration by 28 percent. CyberLink is a leading provider of multimedia software and a pioneer in video and audio technologies. The company runs U Webinar from the AWS Cloud, using Amazon EC2 instances for web and streaming services, Amazon RDS as a fully managed database, and AWS Lambda for U Webinar\u0019s Smart Index feature.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/cyberlink/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"CyberLink","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"AWS Case Study - CyberLink"}},"tags":[{"id":"GLOBAL#location#taiwan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Taiwan","description":"Taiwan","dateCreated":"2020-02-03T05:29:38+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"customer-references#category#business-productivity","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Productivity","description":"Business Productivity","dateCreated":"2019-07-22T18:31:25+0000","dateUpdated":"2022-05-23T21:40:03+0000"},{"id":"GLOBAL#product#auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Auto Scaling","description":"AWS Auto Scaling","dateCreated":"2020-03-02T07:01:39+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#location#china","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"China","description":"China","dateCreated":"2020-02-03T05:29:17+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"customer-references#category#infrastructure","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Infrastructure","description":"Infrastructure","dateCreated":"2019-07-22T18:32:04+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#sunday-insurance-case-study","locale":"en_US","directoryId":"customer-references","name":"sunday-insurance-case-study","dateCreated":"2019-07-19T15:12:14+0000","dateUpdated":"2021-12-22T18:54:17+0000","additionalFields":{"featured":"0","descriptionSummary":"Sunday brings InsurTech to Thailand with the support of AWS and giving customers lower-cost premiums for a wide range of insurance policies. Sunday applies machine learning to determine risks and delivers highly customized insurance policies.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/logo-sunday-600.edea9c0de7e4b8003d89949e4e636fc80376dcb6.jpg","displayLocation":"Thailand","footerInfoText":"Published Date","description":"\u003cp\u003eSunday is a leading InsurTech company in Thailand. The business uses machine-learning algorithms to provide customers with highly customized insurance policies for properties and possessions.\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/sunday_insurance/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Sunday Insurance","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Sunday Insurance Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#category#finserv","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Financial Services","description":"Financial Services","dateCreated":"2019-07-22T18:31:53+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#location#thailand","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Thailand","description":"Thailand","dateCreated":"2020-02-03T05:29:40+0000","dateUpdated":"2022-02-03T03:31:37+0000"}]},{"item":{"id":"customer-references#liulishuo-case-study","locale":"en_US","directoryId":"customer-references","name":"liulishuo-case-study","dateCreated":"2019-07-19T15:15:32+0000","dateUpdated":"2021-12-22T19:22:36+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, Liulishuo has created a stable and reliable online learning platform, which provides tens of millions of users with personalized English language learning services. Liulishuo is a leading AI-driven education technology company dedicated to providing each and every user with personalized and adaptive online learning courses.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Liulishuo_Customer-Reference_Logo.a85adbb2e808aae5e6ef5208795ac1b894e2be97.png","displayLocation":"China","footerInfoText":"Published Date","description":"\u003cp\u003eRead the Liulishuo customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/liulishuo/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Liulishuo","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Liulishuo Case Study"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#category#business-productivity","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Productivity","description":"Business Productivity","dateCreated":"2019-07-22T18:31:25+0000","dateUpdated":"2022-05-23T21:40:03+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#china","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"China","description":"China","dateCreated":"2020-02-03T05:29:17+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#storage-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Storage Gateway","description":"AWS Storage Gateway","dateCreated":"2020-03-02T07:05:41+0000","dateUpdated":"2022-02-03T03:33:03+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#zendesk-case-study","locale":"en_US","directoryId":"customer-references","name":"zendesk-case-study","dateCreated":"2019-07-19T15:12:00+0000","dateUpdated":"2021-12-22T19:01:19+0000","additionalFields":{"featured":"0","descriptionSummary":"Zendesk develops and trains deep-learning applications on AWS to deliver new capabilities to customer-service organizations and scale to support for current and future application demand. The company provides an online customer support platform used by more than 114,000 companies across the globe.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Zendesk_Customer-Reference_Logo.97cfc1193f8d3f6bc53cdc5337fcb43abe479b3f.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eBuilding New Deep-Learning Customer Applications Zendesk, which provides software-as-a-service (SaaS) customer-support platforms, is always working to create new and better solutions for its customers. Zendesk needed to respond to a growing trend: customers wanting to quickly find answers to questions on their own, without having to talk to a support agent. ?We wanted to give customers more relevant answers as fast as possible, and we wanted to drive a self-service customer support model,? says Soon-Ee Cheah, a data scientist at Zendesk. Companies such as online retailers and other large enterprises use Zendesk to deliver great customer support. Zendesk met this challenge by using deep learning?an increasingly popular branch of artificial intelligence (AI). Deep-learning frameworks use neural networks modeled on the human brain to enable computers to learn independently, based on the data they are fed, and perform tasks with little supervision. Zendesk?s most recent deep-learning project is Answer Bot?a virtual customer assistant that automatically answers customer questions using content from the Zendesk Guide knowledge base. For example, if a customer sends an email to a shoe retailer asking for help finding sizes, Answer Bot sends the customer relevant articles about available sizes. ?For Answer Bot, we liked the idea that a deep-learning model could help the application continually fine-tune itself to give customers the best possible answers,? Cheah says. Answer Bot has helped lead the charge to provide a member-centric experience for hundreds of companies, including Dollar Shave Club. ?Answer Bot has been great for us to offer a simple way for our members to find the answers they need,? says Brian Crumpley, analytics manager of member services at Dollar Shave Club. ?It?s never about stopping a member from contacting us, but rather equipping the member with the right knowledge and giving them a faster response?it?s a win-win.? Using TensorFlow on AWS to Get Better Answers Zendesk relies on TensorFlow?an open-source software library for machine learning?to develop its deep-learning applications. As Zendesk prepared to create Answer Bot, it needed an underlying technology that would enable fast development and easy scalability. ?Training algorithms takes a lot of time, and we really wanted to accelerate that process to get a new solution to customers faster,? says Cheah. ?We knew the cloud would help us do that.? The company had already been running its primary platform and an internal data-logging application on the Amazon Web Services (AWS) Cloud, and it knew AWS would also be the right choice for deep learning. Developers using TensorFlow can run the environment on AWS by launching AWS GPU instances. ?We already had an AWS foundation throughout the company, and the fact that TensorFlow is bundled in AWS GPU instances was perfect for our needs,? says Arwen Griffioen, a data scientist at Zendesk. Zendesk uses Amazon Simple Storage Service (Amazon S3) to store initialization files for training models. The company also takes advantage of Amazon Elastic Compute Cloud (Amazon EC2) P2 instances for GPU-based parallel compute capabilities. ?The Amazon EC2 P2 instances are very powerful, and using them really helped speed our research capabilities,? says Cheah. Zendesk also uses the Amazon Aurora relational database engine to capture changes made to knowledge-center articles, which are fed back to the Answer Bot training model in near-real time. ?We used deep-learning algorithms to perform the process of matching customer queries with articles,? says Cheah. The company is also excited to make use of newly released Amazon Sagemaker, a fully managed service that enables developers and data scientists to quickly and easily build, train, and deploy machine-learning models at any scale. \u0026quot;We are excited about the recent announcement of Amazon SageMaker,\u0026quot; says David Bernstein, director of strategic technology at Zendesk. \u0026quot;Amazon SageMaker will lower our costs and increase velocity for our use of machine learning. With Amazon SageMaker, we can transition from our existing self-managed TensorFlow deployment to a fully-managed service. Amazon SageMaker also gives us easier access to other popular deep-learning frameworks, while managing the infrastructure for authoring, training and serving our models.\u0026quot; Speeding Development through Faster Deep-Learning Modeling Zendesk utilizes AWS to easily ingest large datasets used to train deep-learning algorithms. As a result, Zendesk built Answer Bot in a significantly shorter time frame than would have been possible using an on-premises solution. ?Our existing predictive-modeling stack was already on the AWS Cloud, which made it faster to develop Answer Bot on AWS,? says Wai Chee Yau, a data engineer for Zendesk. ?Instead of purchasing and installing our own hardware, we used the flexibility of AWS to quickly add the GPUs and CPUs we needed.? Zendesk data scientists can improve the speed of research by relying on AWS. ?AWS enables us to try a lot of ideas at once, and that helps us do our research much faster,? says Griffioen. ?We can spin up Amazon EC2 instances very quickly as we need them and perform different permutations of our models on those instances without having to wait. We wouldn?t have been able to develop Answer Bot without this capability.? The company is now exceeding its customers? expectations for new and innovative customer-service solutions. ?AWS enables us to develop and deliver capabilities our customers didn?t have before,? says Cheah. ?With Answer Bot, for example, our customers can automatically provide more targeted and accurate answers to their customers? questions. And because Answer Bot can reply directly to customers with answers in a few seconds, it can resolve support tickets before they reach agents. That can really transform the customer-service experience.? Zendesk can now scale its deep-learning development environment on demand to meet developers? requirements for more compute or storage resources. ?We can scale our deep-learning models very efficiently using GPU-processing power on AWS, and that will benefit us while we grow our applications to accommodate more customers,? says Cheah. ?AWS is a powerful deep-learning ideation platform which we use to conduct the majority of our research,? adds Griffioen. ?The flexibility and power we get from AWS have helped Zendesk push past the cutting edge of deep-learning technology in the customer service space. We?re not just creating different approaches?we?re inventing new algorithmic approaches, thanks to AWS.?\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/zendesk-deep-learning/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Zendesk","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Zendesk Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","descripti