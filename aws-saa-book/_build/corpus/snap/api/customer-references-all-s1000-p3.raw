base by 25 times to 5 million. The global media group caters to an international audience of 73 million people and already operates six TV channels and four radio stations.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Atresmedia_Customer-Reference_Logo.d0c6df5d377a09537731844720f07dae7c6b8e9d.png","displayLocation":"Spain","footerInfoText":"Published Date","description":"\u003cp\u003eBy using AWS, Atresmedia has created two new platforms that have grown its digital user base by 25 times to 5 million. The global media group caters to an international audience of 73 million people and already operates six TV channels and four radio stations. To attract younger, more digitally savvy users, it launched its AtresPlayer and Flooxer channels by using Amazon EC2 and Amazon CloudFront to deliver faster television-streaming experiences.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/atresmedia/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Atresmedia","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Atresmedia Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":