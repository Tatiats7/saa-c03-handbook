00+0000","dateUpdated":"2022-02-03T03:32:56+0000"}]},{"item":{"id":"customer-references#equifax","locale":"en_US","directoryId":"customer-references","name":"equifax","dateCreated":"2020-01-24T23:44:49+0000","dateUpdated":"2021-12-22T22:37:05+0000","additionalFields":{"featured":"0","descriptionSummary":"Equifax uses AWS to boost application performance by 300 percent, scale to support global growth, and improve reporting and monitoring. The organization provides data analytics and technology solutions that help organizations and individuals make informed business and personal decisions. Equifax migrated its mission-critical business applications to the AWS Cloud, using services including Amazon EC2 and Amazon EBS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/equifax_logo@1x.ffc6c2aad423857539564280c8ecfe5384c5c7e7.png","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/equifax-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Equifax","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Equifax Uses AWS to Achieve Higher Scalability and Performance for Mission-Critical Financial Applications"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBA