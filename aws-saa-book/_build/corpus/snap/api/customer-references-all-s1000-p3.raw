"dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"}]},{"item":{"id":"customer-references#flytrex-video","locale":"en_US","directoryId":"customer-references","name":"flytrex-video","dateCreated":"2020-11-09T18:05:24+0000","dateUpdated":"2021-12-22T20:21:43+0000","additionalFields":{"descriptionSummary":"Flytrex was founded in Israel in 2013 with the goal of building the world’s largest on-demand food delivery service using drones.The company is currently trialing its service in Reykjavik, Iceland, where it has replaced 25-minute car deliveries with 4-minute drone drops and reduced the cost of delivery by 60 percent.For this, Flytrex needs a highly available underlying system to pilot the vehicles while managing air traffic and complying with aviation regulations. Flytrex also provides APIs so restaurants can integrate its service into their own food ordering apps.In this video, Yariv Bash, cofounder and chief executive officer at Flytrex, explains why the company was built on Amazon Web Services (AWS) from day one.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Flytrex_Customer-Reference_Logo@1x.ab3d3f07cb3552b77832658f1140fb2a6b1c8dd9.png","displayLocation":"Israel","footerInfoText":"Published Date","industry":"Transport \u0026 Logistics","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/flytrex-video/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Flytrex Delivers Food Fast Using AWS","customer-name":"Flytrex"}},"tags":[{"id":"GLOBAL#location#middle-east-africa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East \u0026 Africa","description":"Middle East \u0026 Africa","dateCreated":"2020-02-03T05:30:19+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#customer-segment#startup","local