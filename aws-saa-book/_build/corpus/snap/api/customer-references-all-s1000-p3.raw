d":"2019-07-22T18:31:37+0000","dateUpdated":"2022-03-21T23:37:45+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#business-category#cust-engagement","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2020-06-05T07:06:46+0000","dateUpdated":"2022-02-03T03:31:03+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#industry#travel","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Travel","description":"Travel","dateCreated":"2020-01-16T17:42:42+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"customer-references#innovator#united-airlines","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"United Airlines","description":"\u003cp\u003eInnovator introduced in 2023.\u003c/p\u003e\n","dateCreated":"2023-08-10T19:05:26+0000","dateUpdated":"2023-08-10T19:05:26+0000"}]},{"item":{"id":"customer-references#delivery-hero-case-study","locale":"en_US","directoryId":"customer-references","name":"delivery-hero-case-study","dateCreated":"2020-05-12T19:44:39+0000","dateUpdated":"2023-08-11T00:24:48+0000","additionalFields":{"descriptionSummary":"Delivery Hero wanted to establish a global, centralized solution for processing orders and generating invoices. To support its growing order volume, Delivery Hero migrated its S/4HANA environment to Amazon Web Services (AWS).","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/deliveryhero-logo%402x.38caeae76f51b2ee2ec5c5de92b8863fa8ce7be1.png","displayLocation":"DACH","footerInfoText":"Published Date","industry":"Hospitality","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/delivery-hero-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Delivery Hero","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Delivery Hero Supports One Million Orders Daily with SAP Environment on AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#location#germany","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Germany","description":"Germany","dateCreated":"2020-02-03T05:29:55+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#tech-cate