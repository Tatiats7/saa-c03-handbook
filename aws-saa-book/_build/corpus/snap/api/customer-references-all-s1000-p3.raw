"tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#product#codepipeline","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CodePipeline","description":"AWS CodePipeline","dateCreated":"2020-03-02T07:02:13+0000","dateUpdated":"2022-02-03T03:32:25+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"}]},{"item":{"id":"customer-references#pix-system-case-study","locale":"en_US","directoryId":"customer-references","name":"pix-system-case-study","dateCreated":"2019-07-22T19:43:15+0000","dateUpdated":"2021-12-22T19:00:54+0000","additionalFields":{"featured":"0","descriptionSummary":"PIX System migrated its data center to the AWS Cloud, improving performance by 30 percent and gaining instant scalability. The company\u0027s remote collaboration and asset-sharing platform enables producers, directors, cast, and crew around the globe to collaborate effectively on TV and film productions.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/US/PIX_LOGO_820x332.c2729e3d20b7e67e96f558503fbf957d869801ae.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003ePIX System migrated its data center to the AWS Cloud, improving performance by 30 percent and gaining instant scalability. The company\u0019s remote collaboration and asset-sharing platform enables producers, directors, cast, and crew around the globe to collaborate effectively on TV and film productions. PIX System uses Amazon EBS to migrate files to Amazon S3 volumes for primary storage, and takes advantage of Amazon EC2 instances for video workflows, including automated media-processing workflows and content collaboration.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/pix-system/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"PIX System","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"PIX System Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#lamb