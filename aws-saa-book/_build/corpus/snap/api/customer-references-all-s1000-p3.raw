BAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#ukir","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"UK/IR","description":"UK/IR","dateCreated":"2020-02-19T23:06:44+0000","dateUpdated":"2022-02-03T03:31:51+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#biblioteca-de-catalunya-case-study","locale":"en_US","directoryId":"customer-references","name":"biblioteca-de-catalunya-case-study","dateCreated":"2019-07-19T17:07:57+0000","dateUpdated":"2022-01-21T02:40:11+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, Biblioteca de Catalunya reduced costs by four times compared to storing its 26 TB of data on premises. Biblioteca de Catalunya is a national library located in Barcelona, Spain.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/BibliotecaDeCatalunya_Customer-Reference_Logo.d810efc792314dc4cb6645862a941f31b2111765.png","displayLocation":"Spain","footerInfoText":"Published Date","description":"\u003cp\u003eUsing AWS, Biblioteca de Catalunya reduced costs by four times compared to storing its 26 TB of data on premises. Biblioteca de Catalunya is a national library located in Barcelona, Spain. As part of its multi-year digitization project, the organization migrated to AWS using a hybrid approach, integrating its on-premises resources with cloud resources. Biblioteca de Catalunya chose Amazon Glacier as a reliable, secure, and inexpensive service for data archiving and long-term backup of the library\u0019s more than four million items.\u003c/p\u003e\r\n","industry":"Government","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/catalunya/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Biblioteca de Catalunya","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Biblioteca de Catalunya Case Study"}},"tags":[{"id":"GLOBAL#product#glacier","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon S3 Glacier","description":"Amazon S3 Glacier","dateCreated":"2020-03-02T07:03:38+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#use-case#archiving","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Archiving","description":"Archiving","dateCreated":"2020-06-05T06:36:56+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#con