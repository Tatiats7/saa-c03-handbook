paceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#product#neptune","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Neptune","description":"Amazon Neptune","dateCreated":"2020-03-02T07:04:40+0000","dateUpdated":"2022-02-03T03:32:52+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#xylem","locale":"en_US","directoryId":"customer-references","name":"xylem","dateCreated":"2020-05-04T20:11:57+0000","dateUpdated":"2023-07-12T01:40:48+0000","additionalFields":{"featured":"0","descriptionSummary":"\u003cp\u003eXylem is a leading water technology company committed to \u0026quot;solving water\u0026quot; by creating innovative and smart technologies to meet the world\u0026#39;s water, wastewater, and energy needs. According to Grant Muller, vice president of software at Xylem, the company chose Amazon Web Services (AWS) as its cloud service provider in large part due to its data lake capabilities.\u003c/p\u003e\r\n","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/xylem-200x70.4eee7410580bac2f6a95d3d79995f49cf767aa5e.png","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Power \u0026 Utilities","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/xylem-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Xylem","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Xylem Accelerates Solution Innovation with Data Lakes on AWS"}},"tags":[{"id":"GLOBAL#product#forecast","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Forecast","description":"Amazon Forecast","dateCreated":"2020-03-02T07:03:29