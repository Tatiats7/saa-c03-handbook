03T03:36:04+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#industry#agriculture","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Agriculture","description":"Agriculture","dateCreated":"2020-06-25T04:02:53+0000","dateUpdated":"2022-02-03T03:32:00+0000"}]},{"item":{"id":"customer-references#lightsource-labs","locale":"en_US","directoryId":"customer-references","name":"lightsource-labs","dateCreated":"2020-02-14T19:59:52+0000","dateUpdated":"2023-08-11T00:24:48+0000","additionalFields":{"featured":"0","descriptionSummary":"\u003cp\u003eLightsource Labs used AWS to develop and release Tribe\u0026mdash;an AI-powered, smart-home energy management solution\u0026mdash;at twice the speed and one-third the cost of developing it in a traditional data center. Lightsource Labs, the innovation arm of Lightsource BP, delivers products and innovations to help customers optimize behind-the-meter energy loads. Tribe uses Amazon Aurora to store energy usage data, Amazon EC2 for resizable cloud compute capacity, and AWS Lambda to orchestrate processes and test new algorithms.\u003c/p\u003e\r\n","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/LightsourceBP_Logo@1x.384bf045eb56f9eb1f94a19d5a91e48f770f82b8.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","industry":"Energy","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/lightsource-bp-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Lightsource Labs","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Lightsource BP Releases Smart-Home Energy Management App Twice as Fast on AWS"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","desc