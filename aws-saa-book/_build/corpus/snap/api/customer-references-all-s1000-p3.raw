ase-study-from-es-directory","dateCreated":"2024-02-03T03:47:14+0000","dateUpdated":"2024-02-06T01:35:38+0000","additionalFields":{"descriptionSummary":"Lockheed Martin quickly migrated its SAP Suite on HANA to the AWS Cloud, gaining business agility and cost savings and ensuring compliance with key industry data-protection regulations. The organization is a developer of aerospace and defense systems for the U.S. military and global U.S. allies.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/LockheedMartin_Customer-Reference_Logo.5cfeaff438e15cab398cc58ce839be0b11be8f26.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the Lockheed Martin customer case study, powered by the AWS Cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Manufacturing","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/Lockheed-martin/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Lockheed Martin","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Lockheed Martin Case Study"}},"tags":[{"id":"customer-references#category#web-hosting","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Web Hosting","description":"Web Hosting","dateCreated":"2019-07-22T18:32:28+0000","dateUpdated":"2022-03-30T20:30:49+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"customer-references#category#government-public-sector","locale":"en_US","tagNamespaceId":"customer-references#category","name":"government-public-sector","description":"Government \u0026 Public Sector","dateCreated":"2019-07-22T18:31:57+0000","dateUpdated":"2020-11-25T01:38:26+0000"},{"i