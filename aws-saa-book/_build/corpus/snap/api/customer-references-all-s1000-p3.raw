eCreated":"2020-06-05T07:06:46+0000","dateUpdated":"2022-02-03T03:31:03+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#devops","locale":"en_US","tagNamespaceId":"customer-references#category","name":"DevOps","description":"DevOps","dateCreated":"2019-07-22T18:31:49+0000","dateUpdated":"2022-03-05T03:54:11+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#methodology#devops","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"DevOps","description":"DevOps","dateCreated":"2020-06-05T07:06:27+0000","dateUpdated":"2022-02-03T03:32:10+0000"}]},{"item":{"id":"customer-references#dnb-case-study","locale":"en_US","directoryId":"customer-references","name":"dnb-case-study","dateCreated":"2020-11-09T18:04:13+0000","dateUpdated":"2021-12-23T00:24:27+0000","additionalFields":{"descriptionSummary":"DNB is the largest financial services group in Norway, offering loans, savings, insurance, and pension products. It has 2 million retail customers, 226,000 corporate clients, and around 9,000 employees.In this video, Nicolai Rygh, chief information officer and executive vice president for personal banking at DNB, explains how and why the company used Amazon Web Services (AWS) to build its new mobile banking app.The bank wanted to move away from its monolithic application, so it built more than 40 serverless AWS Lambda functions running in Amazon Virtual Private Cloud subnets to segregate data. APIs connect the app to core banking services in on-premises datacenters. The app uses Amazon Route 53, Amazon CloudFront, and AWS Shield Advanced for security and networking. The bank has also taken the opportunity to rehost its chatbot and small-business app on AWS and is currently working on a project to migrate its website.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/DNB_Customer-Reference_Logo_@1x.93efbb59d75a60adf48384baae771a352d07238b.png","displayLocation":"Norway","footerInfoText":"Published Date","industry":"Banking","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/c