l Group serves more than 6.5 million customers in Great Britain, Italy, Spain, and France. The company uses a wide range of AWS services, including compute, storage, database, analytics, artificial intelligence, security, and networks and CDNs.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Admiral_Customer-Reference_Logo@1x.eaaddf9936021eb8d21695bb328dea057a74c394.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/admiral-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Admiral Group","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Admiral Group Goes All-in on AWS"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12T02:01:29+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022