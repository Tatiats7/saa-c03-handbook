Professional Services","description":"Professional Services","dateCreated":"2020-06-25T04:07:49+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-jobandtalent","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-jobandtalent","dateCreated":"2019-07-22T19:51:27+0000","dateUpdated":"2023-07-14T23:32:42+0000","additionalFields":{"featured":"0","descriptionSummary":"Europe-based jobandtalent is a job-matching platform that uses proprietary algorithms to connect job candidates with openings. The company uses AWS to run all of its operations, including its web application, a business-intelligence platform, and a real-time recommendation engine that helps customers quickly find job openings that fit their profile. Using AWS, jobandtalent can scale to handle an influx of more than 500,000 users per month, and can manage up to 60,000 requests per minute during peak traffic periods.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/JobAndTalent_Customer-Reference_Logo.4061c56b56884ba79bce8ace2d923ad19e8c3caf.png","displayLocation":"Spain","footerInfoText":"Published Date","description":"\u003cp\u003eEurope-based jobandtalent is a job-matching platform that uses proprietary algorithms to connect job candidates with openings. The company uses AWS to run all of its operations, including its web application, a business-intelligence platform, and a real-time recommendation engine that helps customers quickly find job openings that fit their profile. By using AWS, jobandtalent can scale to handle an influx of more than 500,000 users per month, and can manage up to 60,000 requests per minute during peak traffic periods.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/jobandtalent/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"jobandtalent","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: jobandtalent"}},"tags":[{"id":"customer-references#category#dev-and-test","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dev \u0026 Test","description":"Dev \u0026 Test","dateCreated":"2019-07-22T18:31:47+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"