BAL#industry#oil-gas","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Oil \u0026 Gas","description":"Oil \u0026 Gas","dateCreated":"2020-01-16T17:42:36+0000","dateUpdated":"2022-02-03T03:32:07+0000"}]},{"item":{"id":"customer-references#technipfmc","locale":"en_US","directoryId":"customer-references","name":"technipfmc","dateCreated":"2020-03-26T20:49:23+0000","dateUpdated":"2023-07-12T01:40:47+0000","additionalFields":{"featured":"0","descriptionSummary":"Because the AWS Service Catalog enables repeatable, consistent deployments, TechnipFMC has created a foundation for future migrations that meet the company\u0027s security and standardization goals. \u0026quot;Due to a recent merger, we inherited 30 new global locations, many with their own DMZ solutions,\u0026quot; says Hutchinson. \u0026quot;Because of the foundation we\u0027ve put in place through the AWS Service Catalog, we know what to expect, and we\u0027re confident we\u0027ll be able to quickly consolidate those sites.\u0026quot;","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/TechnipFMC_Customer-Reference_Logo.5192bcc6a0e94cf909290a1c6f79445350618ad7.png","displayLocation":"France","footerInfoText":"Published Date","industry":"Energy","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/technip/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"TechnipFMC","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"TechnipFMC ensures security and compliance of deployments with AWS Service Catalog"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T