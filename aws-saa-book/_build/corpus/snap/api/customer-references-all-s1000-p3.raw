:"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#location#korea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Korea","description":"Korea","dateCreated":"2020-02-03T05:29:25+0000","dateUpdated":"2022-02-03T03:31:39+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#aws-case-study-worldreader","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-worldreader","dateCreated":"2019-07-22T19:57:23+0000","dateUpdated":"2022-01-21T02:42:47+0000","additionalFields":{"featured":"0","descriptionSummary":"Worldreader, a non-profit organization dedicated to bringing books to children in developing countries, teamed up with soccer team FC Barcelona to send 1 million e-books to kids in Africa. The organization needed a world-class website to accept donations and handle spikes in traffic. Working with AWS and Transcend Computing, Worldreader had its site up and running in only three days.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Worldreader_Customer-Reference_Logo.cd8db6e1914f157bd72a7059d892977feda55995.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eWorldreader, a non-profit organization dedicated to bringing books to children in developing parts of the world, teamed up with internationally acclaimed soccer team FC Barcelona to help raise enough money by December 31, 2012 to send 1 million e-books to boys and girls in Africa. Given the importance of the cause and popularity of FC Barcelona, Worldreader knew that they needed a world-class website to handle the increase in traffic. Working with Amazon Web Services (AWS) and Transcend Computing, Worldreader had its site up and running in only three days without having to sacrifice valuable donations to make a large upfront investment in costly infrastructure.\u003c/p\u003e\r\n","industry":"Government","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/worldreader/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Worldreader","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"AWS Case Study: Worldreader"}},"tags":[{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:43+0000","dateUpdated":"2022-02-03T03:36:00+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#categor