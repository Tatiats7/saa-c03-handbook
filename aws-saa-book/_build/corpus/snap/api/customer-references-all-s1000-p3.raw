ted":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"customer-references#customer-segment#strategic","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Strategic","description":"Strategic","dateCreated":"2019-07-22T18:39:52+0000","dateUpdated":"2022-04-02T00:32:18+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"}]},{"item":{"id":"customer-references#securitas-direct-video","locale":"en_US","directoryId":"customer-references","name":"securitas-direct-video","dateCreated":"2020-11-09T18:08:15+0000","dateUpdated":"2021-12-22T20:22:36+0000","additionalFields":{"featured":"0","descriptionSummary":"Securitas Direct is part of Verisure Group—a global supplier and installer of alarm systems for homes and businesses. It employs 10,000 people worldwide and serves 1.8 million customers, making it the most widely installed home alarm provider in Europe. Meeting the security needs of its large customer base means that the business must monitor 8 million connected devices around the clock, processing 300 million events a day, and responding to alarms or intrusion alerts in 60 seconds or less. Today, it credits its ability to handle such a vast network of devices to AWS. In this video, Bernardino Beotas, chief information officer at Securitas Direct, explains why the company uses AWS IoT Core as the heart of its platform. He also describes how his teams use Amazon SageMaker to predict alarm battery life based on customer behavior and how AWS helps Securitas Direct scale to add half of a petabyte of security video each day.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Securitas-Direct_Customer-Reference_Logo@1x.376bce5a80c9971d7a2ff14dcb1649185407af5a.png","displayLocation":"Spain","footerInfoText":"Published Date","industry":"Justice \u0026 Public Safety","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/securitas-direct-video/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Securitas Direct","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Securitas Direct Protects Millions of Homes in the Cloud"}},"tags":[{"id":"GLOBAL#use-case#archiving","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Archiving","description":"Archiving","dateCreated":"2020-06-05T06:36:56+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description"