sales overheads by 50 percent. BiiLabs is a startup focused on blockchain and distributed ledger technology (DLT) and how to use DLTs to support Internet of Things and artificial intelligence applications.","industry":"Software \u0026 Internet","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/BiiLabs/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"BiiLabs","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"AWS Case Study - BiiLabs"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#location#italy","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Italy","description":"Italy","dateCreated":"2020-02-03T05:30:02+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#marketplace","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Marketplace","description":"AWS Marketplace","dateCreated":"2020-12-02T20:02:51+0000","dateUpdated":"2022-02-03T03:32:50+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#category#marketplace","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Marketplace","description":"Marketplace","dateCreated":"2019-07-22T18:32:07+0000","dateUpdated":"2022-04-09T03:06:57+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#tech-category#blockchain","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Blockchain","description":"Blockchain","dateCreated":"2020-01-16T17:43:09+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#china","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"China","description":"China","dateCreated":"2020-02-03T05:29:17+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"customer-references#category#blockchain","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Blockchain","description":"Blockchain","dateCreated":"2019-07-22T18:31:06+0000","dateUpdated":"2022-06-07T17:22:39+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#siemens-video","locale":"en_US","directoryId":"customer-references","name":"siemens-video","dateCreated":"2020-11-09T18:08:30+0000","dateUpdated":"2023-07-19T03:04:53+0000","additionalFields":{"featured":"0","descriptionSummary":"Siemens is the largest industrial manufacturer in Europe, producing technology and software for the transport, medical, and energy sectors, among many others. The business has an annual revenue of €87 billion and employs around 385,000 people worldwide. In this video, Yvonne Quacken, head of digital services research and development at Siemens, explains why the company uses Amazon Web Services (AWS) to deliver its Railigent application to rail operators. The application collects data from live trains and helps operators make data-driven decisions to ensure the safety and efficiency of their rail networks. To enable this, Siemens developers needed to access and manage data efficiently across multiple business silos. Because data was not stored consistently across the organization, preparing datasets could take months, and costs were unacceptably high. Siemens built an environment for Railigent using AWS services such as Amazon Athena, AWS IoT, and Amazon Simple Storage Service (Amazon S3). This gives data scientists a self-service platform to manage data ingestion, integration, and preparation. The result is shorter development times and lower complexity, which means faster and more efficient business insights for Siemens.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Siemens_Customer-Reference_Logo%401x.bb038521df5899223d4bd8364182c2fc69ef288d.png","displayLocation":"Germany","footerInfoText":"Published Date","industry":"Manufacturing","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/siemens-video/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Siemens","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Safer Railways Through Better Data Analytics"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#dach","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"DACH","description":"DACH","dateCreated":"2020-02-03T05:29:52+0000","dateUpdated":"2022-02-03T03:31:47+0000"},{"id":"customer-references#category#iot","locale":"en_US","tagNamespaceId":"customer-references#category","name":"IoT","description":"IoT","dateCreated":"2019-07-22T18:32:05+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#product#iot-core","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS IoT Core","description":"AWS IoT Core","dateCreated":"2020-03-02T07:04:00+0000","dateUpdated":"2022-02-03T03:32:42+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Ana