T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#sinch-case-study","locale":"en_US","directoryId":"customer-references","name":"sinch-case-study","dateCreated":"2019-07-22T19:49:45+0000","dateUpdated":"2023-07-14T23:32:38+0000","additionalFields":{"featured":"0","descriptionSummary":"Sinch—a spinoff of Swedish telecommunications firm Rebtel—provides developers with tools to integrate communications functionality into their applications. The company\u0027s business-intelligence solution runs on AWS. Moving to AWS enables Sinch to handle big data cost-effectively in a highly available environment while gaining access to critical business insights quickly.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/sinch-logo.cfeb7a6013b7bc5526e2db74e4df31a4aa40dd69.png","displayLocation":"Sweden","footerInfoText":"Published Date","description":"\u003cp\u003eRead the Sinch customer case study, powered by the AWS cloud. AWS provides cloud computing services to thousands of companies.\u003c/p\u003e\r\n","industry":"Telecommunications","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/sinch/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Sinch","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"Sinch Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019