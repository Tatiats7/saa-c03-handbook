on.com/solutions/case-studies/airbnb-expanding-online-marketplace-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Airbnb","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Airbnb Uses Amazon EFS to Scale CI/CD Pipeline for Expanding Online Marketplace"}},"tags":[{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#customer-segment#strategic","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Strategic","description":"Strategic","dateCreated":"2019-07-22T18:39:52+0000","dateUpdated":"2022-04-02T00:32:18+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#innovator#airbnb","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Airbnb","description":"Airbnb","dateCreated":"2022-09-15T00:48:21+0000","dateUpdated":"2022-09-15T00:48:21+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#efs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic File System (EFS)","description":"Amazon Elastic File System (EFS)","dateCreated":"2020-03-02T07:02:57+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#vidsy","locale":"en_US","directoryId":"customer-references","name":"vidsy","dateCreated":"2024-08-13T14:54:45+0000","dateUpdated":"2024-08-13T14:59:19+0000","additionalFields":{"descriptionSummary":"Vidsy migrated from Docker Cloud to Amazon Elastic Container Service (Amazon ECS) in just 10 days and has reduced its costs by 60 percent. Vidsy helps brands develop mobile-first video campaigns using the talents of Vidsy\u0027s community of 3,000 young creatives. The company now uses Amazon ECS to orchestrate its containerized applications, which run in the AWS Cloud.","featureImageU