","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#efs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic File System (EFS)","description":"Amazon Elastic File System (EFS)","dateCreated":"2020-03-02T07:02:57+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#despegar","locale":"en_US","directoryId":"customer-references","name":"despegar","dateCreated":"2023-06-01T23:08:51+0000","dateUpdated":"2023-07-12T01:35:41+0000","additionalFields":{"descriptionSummary":"Despegar.com es una OTA (agencia de viajes en línea), que vende turismo en línea en toda América Latina. Hoy en día, cuenta con más de 4.000 empleados y es una de las principales empresas de turismo en la región. La compañía creó un optimizador automático de inversiones, para mejor utilizar su presupuesto en keywords y motores de búsqueda, clave para sus esfuerzos de ventas. Con la migración a AWS, utilizando servicios como Amazon Simple Storage Service y Amazon EMR, Despegar.com pudo crear clústeres dimensionados, en cuanto al número y tipos de instancias, para el procesamiento puntual que necesitaron, lo que implicó un ahorro significativo de costos. Vea el testimonio de Martin Rosenfeld, líder de proyectos de TI en Despegar.com, y obtenga más información.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/despegar_logo%401x.f06fcbe7cb92dd6b0c694618b96b151199270f96.png","displayLocation":"Argentina","footerInfoText":"Fecha de publicación","industry":"Viajes","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/despegar/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","customer-name":"Despegar","contentType":"Historia del cliente","headline":"Despegar.com optimiza sus inversiones de marketing utilizando tecnología AWS"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#location#argentina","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Argentina","description":"Argentina","dateCreated":"2020-06-12T23:30:42+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#product#cost-usage-report","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Cost and Usage Report","description":"AWS Cost and Usage Report","dateCreated":"2020-03-02T07:02:28+0000","dateUpdated":"2022-02-03T03:32:27+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#elasticsearch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elasticsearch Service (ES)","description":"Amazon Elasticsearch Service (ES)","dateCreated":"2020