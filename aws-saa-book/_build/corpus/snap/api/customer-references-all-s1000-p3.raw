ganization provides IT solutions and services to thousands of enterprises across the globe.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/DXCTechnology_Customer-Reference_Logo.c5e9c1f0f5aba377a5f2e637d7eb309fb2f9ead1.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eDXC Technology uses AWS to cut provisioning time from three months to one week, automate software patching, reduce costs by two-thirds, and ensure high availability and reliability.\u003c/p\u003e\r\n","industry":"Professional Services","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/dxc-technology/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"DXC Technology","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"DXC Technology Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#dev-and-test","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dev \u0026 Test","description":"Dev \u0026 Test","dateCreated":"2019-07-22T18:31:47+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31: