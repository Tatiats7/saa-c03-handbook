sus lugares preferidos de compras. La empresa está en proceso de expansión de Puerto Rico a México, donde espera un aumento considerable de usuarios y de su infraestructura de 2 a 3 veces. Los servicios y las herramientas de AWS le dieron a Burea la capacidad y escalabilidad que necesitaba como empresa.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/burea_logo%401x.9c81b6c73d83292634ae70f8f788ac21c66b0572.png","displayLocation":"Puerto Rico","footerInfoText":"Fecha de publicación","industry":"Medios y entretenimiento","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/burea/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"Historia del cliente","customer-name":"Burea","headline":"Burea optimiza costos en un 60% con tecnología AWS"}},"tags":[{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"customer-references#category#mobile","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Mobile","description":"Mobile","dateCreated":"2019-07-22T18:32:14+0000","dateUpdated":"2022-03-24T02:42:27+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdate