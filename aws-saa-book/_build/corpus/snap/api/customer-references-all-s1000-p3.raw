eCreated":"2023-06-01T23:08:15+0000","dateUpdated":"2023-06-08T04:07:37+0000","additionalFields":{"descriptionSummary":"Hortifrut es una empresa chilena con presencia mundial y alrededor de 1,200 empleados, exportando frutas a Estados Unidos, Asia y Europa. La compañía empezó su camino tecnológico al migrar en tiempo récord el SAP, que estaba en una arquitectura on-premises, a cloud. La empresa trabajó con el partner APN Novis, que le ayudó a definir un sizing correcto de las máquinas, permitiendo habilitar la infraestructura 100% funcional en un par de semanas y con un costo menor.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/hortifrut_logo%401x.d2f63e92b1bb820ed7ef9dcec94886dfde03f871.png","displayLocation":"Chile","footerInfoText":"Fecha de publicación","industry":"Agricultura","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/hortifrut/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"Historia del cliente","customer-name":"Hortifrut","headline":"Hortifrut migra su SAP a la nube AWS"}},"tags":[{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","