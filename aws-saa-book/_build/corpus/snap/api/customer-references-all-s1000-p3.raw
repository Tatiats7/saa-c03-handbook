s":{"featured":"0","descriptionSummary":"Pacific Magazines shifted to AWS from another cloud provider to improve stability, lower costs, and enable engineers to focus on innovation. The company publishes \u0026quot;New Idea,\u0026quot; \u0026quot;InStyle,\u0026quot; \u0026quot;Family Circle,\u0026quot; and other popular Australian magazine brands. Pacific Magazines deployed on an AWS infrastructure that includes Amazon ECS for container orchestration and Amazon CloudFront for worldwide content delivery.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/pacific_Logo_@1x.eec49753b52ab6f174dea36f978d1a6d80466516.png","displayLocation":"Australia","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/pacific-magazines-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Pacific Magazines","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Pacific Magazines Moves to AWS for Stability and Scalability"}},"tags":[{"id":"GLOBAL#location#australia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia","description":"Australia","dateCreated":"2020-02-03T05:29:12+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:43+0000",