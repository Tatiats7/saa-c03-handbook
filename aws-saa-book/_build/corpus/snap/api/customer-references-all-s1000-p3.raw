"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#modjoul-case-study","locale":"en_US","directoryId":"customer-references","name":"modjoul-case-study","dateCreated":"2019-07-19T14:56:45+0000","dateUpdated":"2021-12-22T19:28:19+0000","additionalFields":{"descriptionSummary":"Modjoul uses AWS to provide safety data to customers five times faster, process data from thousands of safety belts in near-real time, and help customers ensure their employees are safe. The organization seeks to improve companies\u0027 safety records by providing data and actionable insights to eliminate employee injuries.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/ModjoulU_Customer-Reference_Logo.35c0bbb1a2575a2217fa49a6272449a918cd70bb.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eModjoul uses AWS to provide safety data to customers five times faster, process data from thousands of safety belts in near real-time, and help customers ensure their employees are safe. The organization seeks to improve companies\u0019 safety records by providing data and actionable insights to eliminate employee injuries. Modjoul uses the AWS IoT Platform to transmit data from thousands of its SmartBelt devices to the AWS Cloud.\u003c/p\u003e\r\n","industry":"Manufacturing","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/modjoul/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Modjoul","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Modjoul Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"}]},{"item":{"id":"customer-references#woot-case-study","locale":"en_US","directoryId":"customer-references","name":"woot-case-study","dateCreated":"2019-07-19T14:56:57+0000","dateUpdated":"2021-12-22T19:26:41+0000","additionalFields":{"featured":"0","descriptionSummary":"Woot cut its data warehouse operating costs by 90 percent, shifted to a model of shared responsibility for data between developer and data teams, and reduced operations overhead by migrating to a serverless data warehouse on AWS. Woot, the original daily deals website, offers other short-term sales across seven product categories.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Woot_Customer-Reference_Logo.655d006e422fbd8c2b724c432feb195254f31f1a.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eWoot cut its data warehouse operating costs by 90 percent, shifted to a model of shared responsibility for data between developer and data teams, and reduced operations overhead by migrating to a serverless data warehouse on AWS. Woot, the original daily deals website, offers other short-term sales across seven product categories. The company is using Amazon Kinesis Data Firehose and Amazon S3 for data ingestion and storage, and it relies on Amazon Athena and Amazon QuickSight for user-friendly querying and data visualization.\u003c/p\u003e\r\n","industry":"Retail","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/woot/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Woot","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Woot Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#retail","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Retail","description":"Retail","dateCreated":"2020-01-16T17:42:39+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#quicksight","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon QuickSight","description":"Amazon QuickSight","dateCreated":"2020-03-02T07:04:56+0000","dateUpdated":"2022-02-03T03:32:55+0000"},{"id":"GLOBAL#product#kinesis-data-firehose","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis Firehose","description":"Amazon Kinesis Firehose","dateCreated":"2020-05-08T03:42:48+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#glue","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Glue","description":"AWS Glue","dateCreated":"2020-03-02T07:03:41+0000","dateUpdated":"2022-02-03T03:32:39+0000"}]},{"item":{"id":"customer-references#visma","locale":"en_US","directoryId":"customer-references","name":"visma","dateCreated":"2020-01-23T22:00:47+0000","dateUpdated":"2021-12-22T22:34:45+0000","additionalFields":{"featured":"0","descriptionSummary":"Visma migrates critical Windows workloads to AWS and increases new feature releases from six yearly to more than six monthly, cuts deployment time from 30 minutes to 5 minutes, and increases the customer base for one application by four times. Headquartered in Oslo, Norway, the company is a leading provider of cloud-based business applications. Visma moved many of its .NET applications to AWS, relying on Amazon Aurora MySQL, Amazon EC2, and AWS CloudFormation.","imageSrcUrl":"https://d1.awsstatic.com/events/Nordics/visma.fd0b746d073b0ad4eba5aba526fb78a567065693.png","displayLocation":"Norway","foot