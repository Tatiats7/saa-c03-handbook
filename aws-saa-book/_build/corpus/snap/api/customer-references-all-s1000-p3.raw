ss","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#location#canada","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Canada","description":"Canada","dateCreated":"2020-02-03T05:29:05+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"}]},{"item":{"id":"customer-references#aws-case-study-burda-studios","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-burda-studios","dateCreated":"2019-07-19T17:08:25+0000","dateUpdated":"2021-12-22T19:50:43+0000","additionalFields":{"featured":"0","descriptionSummary":"BurdaStudios delivers news 75 percent faster by using AWS technologies, supporting its leading celebrity website. Bunte.de is the most popular gossip portal in German-speaking Europe, attracting up to 35 million visits a month.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/BurdaStudios_Customer-Reference_Logo.bbc146c9ffea7898cba0a9a5513d095bb68a02b5.png","displayLocation":"Germany","footerInfoText":"Published Date","description":"\u003cp\u003eBurdaStudios is a division of global media group Hubert Burda Media, which has about 10,000 employees and more than 500 brands, including home and lifestyle magazines and business-to-business publications. BurdaStudios specializes in TV production and digital publishing. The company?s flagship website is Bunte.de, the leading celebrity gossip portal across Europe?s German-speaking countries?Germany, Switzerland, and Austria. The site is a go-to website for up-to-the-minute news about Hollywood actors, sports stars, and members of royalty. It attracts six million unique users and 30-35 million visits a month?about 20 percent more uniques than its nearest competitor?and gains its revenue from display, video, and native advertising.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/burda-studio/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Burda Studios","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"AWS Case Study: Burda Studios"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":