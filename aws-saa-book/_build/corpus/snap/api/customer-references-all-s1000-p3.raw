:32:22+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#wabco-video","locale":"en_US","directoryId":"customer-references","name":"wabco-video","dateCreated":"2020-11-09T18:09:29+0000","dateUpdated":"2021-12-23T01:00:27+0000","additionalFields":{"featured":"0","descriptionSummary":"WABCO has been providing commercial vehicle technology for more than 150 years. Its systems for braking, suspension, stability, and more, can be found on most commercial vehicles. For 25 years, the company has been helping fleet operators reduce inefficiencies in road transportation with telematics devices that collect data for better business decisions. Today, much of that decision-making is automated—a trend that will continue as vehicles and systems become more sophisticated and autonomous. The backend that supports this comprises 700 servers that monitor 160,000 connected vehicles, making 1 million data inserts a minute. As the autonomous and connected vehicle ecosystem grows, WABCO is moving to a more scalable infrastructure in the cloud that will support innovation in areas such as artificial intelligence and machine learning. In this video, Philippe Colpron, vice president and global leader, fleet solutions at WABCO, explains how Amazon Web Services (AWS) technologies—such as AWS IoT Core and Amazon DynamoDB—helped the company halve its time to market and expand its portfolio with new products.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/WABCO_Customer-Reference_Logo@1x.46344843969bd9036c8059d4e549e238588fe388.png","displayLocation":"Switzerland","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/wabco-video/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"WABCO","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"WABCO Grows Its Smart Vehicle Ecosystem on AWS"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#iot-core","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS IoT Core","description":"AWS IoT Core","dateCreated":"2020-03-02T07:04:00+0000","dateUpdated":"2022-02-03T03:32:42+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#switzerland","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Switzerland","description":"Switzerland","dateCreated":"2020-02-03T05:29:56+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#location#dach","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"DACH","description":"DACH","dateCreated":"2020-02-03T05:29:52+0000","dateUpdated":"2022-02-03T03:31:47+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#iot","locale":"en_US","tagNamespaceId":"customer-references#category","name":"IoT","description":"IoT","dateCreated":"2019-07-22T18:32:05+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#industry#automotive","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Automotive","description":"Automotive","dateCreated":"2020-01-16T17:42:11+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"IoT","description":"IoT","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2022-02-03T03:35:28+0000"}]},{"item":{"id":"customer-references#gameloft-video","locale":"en_US","directoryId":"customer-references","name":"gameloft-video","dateCreated":"2020-11-09T18:05:39+0000","dateUpdated":"2021-12-23T00:22:48+0000","additionalFields":{"descriptionSummary":"Mobile gaming company Gameloft was founded in France in 2000 and now employs 4,600 people across 19 studios worldwide. Its 190-game portfolio includes the critically acclaimed Asphalt racing series and Despicable Me: Minion Rush, which has been downloaded more than 100 million times.Most of Gameloft’s titles run online, which requires a sizable infrastructure. Gameloft was continually adding physical servers and data centers to support hundreds of millions of players a month. The goal was to have as little downtime as possible and to handle traffic spikes of up to 50X the normal load during game launches. However, costs soon became unmanageable, and teams were spending too much time on routine maintenance rather than developing great gaming experiences.In this video, Gilles Chervy, head of infrastructure at Gameloft, explains how the company moved its gaming servers to Amazon Web Services (AWS), improving the player experience, simplifying management, optimizing costs, and reducing time to market for new games.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Gameloft_Customer-Reference_Logo@1x.146b996c536d973b02606f4c1dc47db4bc93e5b8.png","displayLocation":"France","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/gameloft-video/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Gameloft Improves Experience for Hundreds of Millions of Gamers with AWS","customer-name":"Gameloft"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#location#euro