me":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#industry#power-utilities","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Power \u0026 Utilities","description":"Power \u0026 Utilities","dateCreated":"2020-01-16T17:42:37+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#industry#energy","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Energy","description":"Energy","dateCreated":"2020-07-15T21:58:51+0000","dateUpdated":"2022-02-03T03:32:02+0000"}]},{"item":{"id":"customer-references#copaairlines","locale":"en_US","directoryId":"customer-references","name":"copaairlines","dateCreated":"2020-05-04T20:11:08+0000","dateUpdated":"2023-07-12T01:35:41+0000","additionalFields":{"descriptionSummary":"Copa Airlines es una aerolínea panameña fundada en 1947. Actualmente con una flota de 100 aeronaves, una operación de 350 vuelos al día, la compañía trabaja con un movimiento de 16 millones de viajes al año. Copa Airlines necesitaba escalar su infraestructura on premises a Amazon Web Services, buscando obtener baja latencia y escalabilidad en cuanto al manejo de la infraestructura, tornándose una empresa mucho más digital en sus sistemas de reservas e interacciones con clientes. Vea el testimonio de Hugo Aquino, director de Servicios de Infraestructura y Operaciones de Tecnología en Copa Airlines, y conozca más.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/copaairlines_Logo%401x.d8d24e26f32bb8494f7ddff23fc3a6e35b56784c.png","displayLocation":"Panamá","footerInfoText":"Fecha de publicación","industry":"Viajes","sortDate":"2019-01-01","headlin