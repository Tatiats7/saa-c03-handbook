5:00:36+0000"}]},{"item":{"id":"customer-references#tradedesk","locale":"en_US","directoryId":"customer-references","name":"tradedesk","dateCreated":"2020-04-01T23:54:39+0000","dateUpdated":"2021-12-22T20:22:21+0000","additionalFields":{"descriptionSummary":"The Trade Desk is an advertising technology company that provides a self-service platform through which media buyers can purchase digital advertising. The company recently began shifting its real-time bidding workload—which receives 10 million queries per second, 800 billion queries per day, and requires an average response-time of less than 15 milliseconds—to the Amazon Web Services (AWS) Cloud, building four new sites in 2019.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/trade-desk-logo@1x.8474a41120e1bacda743346446b9d7de792ca9da.png","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Digital Marketing","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/the-trade-desk-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"The Trade Desk Transforms its Real-time Bidding Strategy with AWS","customer-name":"The Trade Desk"}},"tags":[{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"