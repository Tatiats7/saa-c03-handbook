english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#checkout-case-study","locale":"en_US","directoryId":"customer-references","name":"checkout-case-study","dateCreated":"2019-07-19T14:55:55+0000","dateUpdated":"2021-12-22T19:18:31+0000","additionalFields":{"featured":"0","descriptionSummary":"Checkout Finland has set a benchmark for cloud excellence within its banking group by reducing payment times, making compliance easier, and improving uptime during peak sales periods using AWS. The company is part of Finland\u0027s largest bank, OP, and provides a range of merchant services for online retailers.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Checkout_Customer-Reference_Logo.96050da7d579b1fd147eb1b2daaf7d99b64c0dd1.png","displayLocation":"Finland","footerInfoText":"Published Date","description":"\u003cp\u003eCheckout Finland has set a benchmark for cloud excellence within its banking group by reducing payment times, making compliance easier, and improving uptime during peak sales periods. The company is part of Finland?s largest bank?OP?and provides a range of merchant services for online retailers. It uses services including AWS Lambda and AWS Fargate to run its infrastructure as code so developers can concentrate on building features that matter to customers instead of managing servers.\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/checkout/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Checkout","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Checkout Case Study"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#