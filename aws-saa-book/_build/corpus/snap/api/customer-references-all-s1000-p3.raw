eCreated":"2019-07-19T17:08:40+0000","dateUpdated":"2022-01-21T02:40:18+0000","additionalFields":{"featured":"0","descriptionSummary":"\u003cp\u003eBy using AWS to host its website and essential software, Jour de la Terre has increased employee efficiency by 15 percent and cut IT infrastructure costs by 20 percent. The environmental nonprofit designs and implements programs and systems that support adoption of small environmental-impact reductions across individuals, businesses, schools, and other organizations.\u003c/p\u003e\r\n","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/JourDeLaTerre_Customer-Reference_Logo.473e3483a4339de333d1330602723ee3ff555ddb.png","displayLocation":"Canada","footerInfoText":"Published Date","description":"\u003cp\u003eBy using AWS to host its website and essential software, Jour de la Terre has increased employee efficiency by 15 percent and cut IT infrastructure costs by 20 percent.\u003c/p\u003e\r\n","industry":"Environmental","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/jour-de-la-terre/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Jour De La Terre","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Jour De La Terre Case Study"}},"tags":[{"id":"GLOBAL#industry#enviro-protection","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Environmental Protection","description":"Environmental Protection","dateCreated":"2020-06-25T04:06:38+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000