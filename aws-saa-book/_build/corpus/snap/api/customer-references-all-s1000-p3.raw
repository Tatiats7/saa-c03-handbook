0000","dateUpdated":"2023-05-26T18:28:16+0000","additionalFields":{"featured":"0","descriptionSummary":"Scripps Networks Interactive reduced its CGI render time by 95 percent using a solution based on AWS Thinkbox Deadline. Scripps Networks Interactive is a mass-media company specializing in factual and lifestyle television brands such as HGTV, DIY Network, and Food Network.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/ScrippsNetworksInteractive_Customer-Reference_Logo.0a067725db9ca30f2e2b3d938c8ccd897d1c4362.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eScripps Networks Interactive reduced its CGI render time by 95 percent with a solution based on AWS Thinkbox Deadline. Scripps Networks Interactive is a mass-media company specializing in factual and lifestyle television brands such as HGTV, DIY Network, and Food Network. The company is using the AWS Portal in Thinkbox Deadline to manage and administer Amazon EC2 Spot Instances as CGI render nodes.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/scripps/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Scripps","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Scripps Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"