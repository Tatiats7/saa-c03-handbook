e_Logo.02133b83791dda50f8f474d6de87b08d4e945dea.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"Lyft is a San Francisco-based ridesharing company operating in more than 190 cities. The company uses Amazon EC2 Spot instances for testing code before it goes into production. By using Spot, the startup saves up to 75 percent monthly versus on-demand instances for routine testing processes that do not require the most current or most powerful compute resources.","industry":"Transport \u0026 Logistics","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/lyft-spot/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Lyft-Spot","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"Lyft Case Study-Spot"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Auto Scaling","description":"AWS Auto Scaling","dateCreated":"2020-03-02T07:01:39+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespa