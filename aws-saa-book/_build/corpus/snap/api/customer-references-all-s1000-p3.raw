#category","name":"Data Lakes \u0026 Analytics","description":"Data Lakes \u0026 Analytics","dateCreated":"2019-07-22T18:31:39+0000","dateUpdated":"2022-02-07T13:55:55+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#workspaces","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon WorkSpaces","description":"Amazon WorkSpaces","dateCreated":"2020-03-02T07:06:12+0000","dateUpdated":"2022-02-03T03:33:08+0000"},{"id":"GLOBAL#industry#agriculture","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Agriculture","description":"Agriculture","dateCreated":"2020-06-25T04:02:53+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#homepage-industry#agriculture","locale":"en_US","tagNamespaceId":"customer-references#homepage-industry","name":"Agriculture","description":"Agriculture","dateCreated":"2022-08-24T22:33:21+0000","dateUpdated":"2022-08-24T22:33:21+0000"}]},{"item":{"id":"customer-references#ministry-of-justice-video","locale":"en_US","directoryId":"customer-references","name":"ministry-of-justice-video","dateCreated":"2020-11-09T18:06:26+0000","dateUpdated":"2022-01-21T02:44:03+0000","additionalFields":{"descriptionSummary":"The Ministry of Justice in the United Kingdom can trace its history back to 1178. It runs 500 courts and tribunals across England and Wales and employs around 70,000 staff.The ministry also provides legal aid services for those who can’t obtain legal representation. To improve the accessibility of these services, the ministry wanted to make its digital tools more user-friendly—including on mobile devices—and boost service levels. This required an update of the underlying technology infrastructure.In this video, Tom Read, chief digital and information officer at the Ministry of Justice, explains how the ministry moved 10 major on-premises, Oracle-based systems to Amazon Web Services (AWS). It uses services including Amazon Relational Database Service (Amazon RDS) and Amazon Elastic Container Service (Amazon ECS).The move has saved the ministry money, increased infrastructure stability with automated patching and monitoring, and boosted the reliability of critical services.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Ministry-of-justice_Customer-Reference_Logo@1x.745eb781440f6a4778721eff473fb564337b274e.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","industry":"Government","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ministry-of-justice-video/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Ministry of Justice Improves Access to Justice for Society’s Most Vulnerable","customer-name":"Ministry of Justice"}},"tags":[{"id":"GLOBAL#use-case#general-database-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"General Database Migration","description":"General Database Migration","dateCreated":"2020-06-05T06:37:24+0000","dateUpdated":"2022-02-03T03:35:41+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"customer-references#category#database-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Database Migration","description":"Database Migration","dateCreated":"2019-07-22T18:31:40+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#customer-engagement","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2019-07-22T18:31:37+0000","dateUpdated":"2022-03-21T23:37:45+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"