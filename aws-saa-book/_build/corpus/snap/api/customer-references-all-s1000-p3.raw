or to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#porter-airlines-case-study","locale":"en_US","directoryId":"customer-references","name":"porter-airlines-case-study","dateCreated":"2019-07-22T19:43:31+0000","dateUpdated":"2023-07-14T23:32:32+0000","additionalFields":{"featured":"0","descriptionSummary":"Porter Airlines relies on AWS to ensure high availability and reliability for millions of monthly website visitors, to scale to support a fourfold spike in site traffic, and to improve its data analytics and disaster-recovery capabilities. The company, a growing Canadian regional airline based in Ontario, runs its customer-facing website and other critical business applications on the AWS Cloud.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/PorterAirlines_Customer-Reference_Logo.7aa89701ec883b7f384201f2d40670cf1549da4c.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003ePorter Airlines relies on AWS to ensure high availability and reliability for millions of monthly website visitors, to scale to support a fourfold spike in site traffic, and to improve its data analytics and disaster-recovery capabilities.\u003c/p\u003e\r\n","industry":"Travel \u0026 Hospitality","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/porter-airlines/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Porter Airlines","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Porter Airlines Case Study"}},"tags":[{"id":"customer-re