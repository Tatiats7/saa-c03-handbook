d":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#loanlogics-case-study","locale":"en_US","directoryId":"customer-references","name":"loanlogics-case-study","dateCreated":"2019-07-19T15:11:41+0000","dateUpdated":"2023-07-14T23:32:46+0000","additionalFields":{"featured":"0","descriptionSummary":"LoanLogics is able to scale to meet its storage demands in days instead of weeks using AWS Storage Gateway and Amazon EFS. LoanLogics is a software company that helps its customers validate compliance and manage risk during the manufacture and acquisition of loan assets.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/loanlogics-logo.ea9ecc988dabdf0db0e5b270311cb74c63cce348.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eLoanLogics scales to storage demands in days instead of weeks using AWS Storage Gateway and Amazon Elastic File Storage (Amazon EFS).\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/loan-logics/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"LoanLogics","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"LoanLogics Case Study"}},"tags":[{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#use-case#datacenter-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2020-08-18T05:17:48+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#storage-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Storage Gateway","description":"AWS Storage Gateway","dateCreated":"2020-03-02T07:05:41+0000","dateUpdated":"2022-02-03T03:33:03+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#efs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic File System (EFS)","description":"Amazon Elastic File System (EFS)","dateCreated":"2020-03-02T07:02:57+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#customer-snapshot-weever-apps-docker-containers","locale":"en_US","directoryId":"customer-references","name":"customer-snapshot-weever-apps-docker-containers","dateCreated":"2019-07-19T14:57:52+0000","dateUpdated":"2023-07-14T23:32:46+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, Weever Apps can focus on software development rather than infrastructure management, and AWS Partner Network partner base2Services adds another layer of support by handling upgrades, changes, and service health. Weever Apps creates enterprise-class software products to help customer initiate, execute, and complete work more efficiently.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/WeeverApps_Customer-Reference_Logo.f2bae41b7fc4b88a6bcd6ac539d4f046e815266a.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eWeever Apps Enables Development Flexibility Using Amazon VPC and Docker Containers Weever Apps migrated to Amazon Web Services (AWS) to achieve greater reliability, helping it serve enterprise customers that expect 24/7 access to the company?s digital-forms-management solution. At the same time, the company used AWS to implement an agile and flexible development process to maximize developer productivity. ?Our developers need to be able to write code in a local environment?for example, on a laptop?with the ability to deploy that same code to production seamlessly,? says Garth Gutenberg, senior DevOps manager at Weever Apps. ?We enable that capability using Docker containers to replicate the same functionality between the development tools and the production solution that runs in AWS.? For example, Weever Apps uses Amazon ElastiCache in production, but when developing locally, developers use standard Redis. To enable a smooth transition, they use Redis inside of Docker containers for extended local development sessions. At deployment time, the application can use Amazon ElastiCache in the cloud without code changes. Weever Apps also uses Amazon Virtual Private Cloud (Amazon VPC) to logically isolate multiple development and testing environments from production services, while maintaining the flexibility to quickly and easily deploy code once it is ready. ?We have environments for development, staging, production, and continuous integration,? says Gutenberg. This environment supports flexible development scenarios, such as when developers are writing code locally and connecting to a development database on AWS. ?Using AWS and Docker, it?s easy to enable developers to be productive anywhere without having to manage the full production database,? concludes Gutenberg. ?It?s a true hybrid scenario that helps us get features to market faster.?\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/snapshot-weever-apps-devops/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Weever Apps","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Customer Snapshot: Weever Apps \u0026 Partner DevOps"}},"tags":[{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"