:"0","descriptionSummary":"The Ottawa Hospital Research Institute uses AWS to enable Canadian citizens to manage immunization records on mobile devices. The application uses Amazon EC2, Amazon Cognito, and Amazon RDS.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/The_Ottawa_Hospital_Logo.7f0350e1fb4a5b9dd88eca22fde4c01c98dd6ec1.jpg","displayLocation":"Canada","footerInfoText":"Published Date","description":"\u003cp\u003eThe Ottawa Hospital Research Institute uses AWS to enable Canadian citizens to manage immunization records on mobile devices. The application uses Amazon EC2, Amazon Cognito, and Amazon RDS.\u003c/p\u003e\r\n","industry":"Healthcare","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ottawa-hospital-research-institute/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ottawa Hospital Research Institute","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Ottawa Hospital Research Institute Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tec