n":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#t-mobile-case-study","locale":"en_US","directoryId":"customer-references","name":"t-mobile-case-study","dateCreated":"2019-07-19T14:57:36+0000","dateUpdated":"2022-12-22T17:56:35+0000","additionalFields":{"featured":"0","descriptionSummary":"T-Mobile accelerated build and deploy steps on AWS by 90 percent with an internally created serverless development platform called Jazz. T-Mobile is a technology company that offers wireless services over a nationwide 4G LTE network to more than 70 million customers.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/TMobile_Logo_@1x.76dc99cc2ef8916824008e5b33f2c309241e01c7.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eT-Mobile accelerated build and deploy steps on AWS by 90 percent with an internally created serverless development platform called Jazz. T-Mobile is a technology company that offers wireless services over a nationwide 4G LTE network to more than 70 million customers. The company\u0019s Jazz platform uses Amazon Kinesis for data streaming at any scale, AWS Lambda to run code in response to events, and Amazon OpenSearch Service to deploy, secure, operate, and scale OpenSearch.\u003c/p\u003e\n","industry":"Telecommunications","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/tmobile/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"T-Mobile","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"T-Mobile Case Study"}},"tags":[{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#industry#telecommunications","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Telecommunications","description":"Telecommunications","dateCreated":"2020-01-16T17:42:41+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"20