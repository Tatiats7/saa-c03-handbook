"id":"customer-references#satguatemala","locale":"en_US","directoryId":"customer-references","name":"satguatemala","dateCreated":"2023-06-01T23:06:52+0000","dateUpdated":"2023-06-08T04:07:39+0000","additionalFields":{"descriptionSummary":"La Superintendencia de Administración Tributaria (SAT), la Autoridad Tributaria de Guatemala, se dedica a modernizar la administración tributaria, crear eficiencias y minimizar los costos. Mauricio Romero, Consultor de Sistemas de Información y TI de SAT Guatemala, habló sobre la importancia de encontrar el proveedor adecuado de servicios en la nube, la importancia de los microservicios y cómo se enfocan en la contratación de expertos y la capacitación para el futuro.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/sat_logo%401x.e37e9b50773c7b2d9dd61b7530d7cb20f9a34fe6.png","displayLocation":"Latinoamérica","footerInfoText":"Fecha de publicación","industry":"Servicios financieros","sortDate":"2019-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/satguatemala/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2019","contentType":"Historia del cliente","customer-name":"Superintendencia de Administración Tributaria","headline":"Caso práctico de la Superintendencia de Administración Tributaria (SAT) de Guatemala"}},"tags":[{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"