teCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#location#central-america","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central America","description":"Central America","dateCreated":"2021-02-19T05:32:25+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"customer-references#customer-segment#public-sector-edu","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Education","description":"Education","dateCreated":"2019-07-22T18:39:45+0000","dateUpdated":"2022-03-21T23:55:12+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"}]},{"item":{"id":"customer-references#ifood61","locale":"en_US","directoryId":"customer-references","name":"ifood61","dateCreated":"2023-06-01T23:08:37+0000","dateUpdated":"2023-06-08T04:07:42+0000","additionalFields":{"descriptionSummary":"O iFood, um dos marketplaces de maior destaque na América Latina atuando no segmento de entrega de alimentos, conta com a elasticidade dos serviços da AWS para o sucesso de suas operações","imageSrcUrl":"https://d1.awsstatic.com/case-studies/Latam%20Cases%20Assets/iFOOD.bb8c8eb5f958e4a3c0ad8ead5f920bb66a337055.png","displayLocation":"Brasil","footerInfoText":"Data de publicação","industry":"Software e Internet","sortDate":"2018-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/pt/solutions/ca