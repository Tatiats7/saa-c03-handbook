0"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#innovator#general-electric","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"General Electric","description":"General Electric","dateCreated":"2022-09-15T00:48:30+0000","dateUpdated":"2022-09-15T00:48:30+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"}]},{"item":{"id":"customer-references#miovision-case-study-it","locale":"en_US","directoryId":"customer-references","name":"miovision-case-study-it","dateCreated":"2024-11-12T00:55:05+0000","dateUpdated":"2024-11-12T01:13:39+0000","additionalFields":{"descriptionSummary":"Attraverso sensori collegati e analisi intelligenti, Miovision consente a più di 17.000 comuni in 50 paesi di essere più intelligenti, migliorando la capacità di trasporto, la sicurezza, la convenienza e le prestazioni. Distribuite agli incroci e lungo le strade, le soluzioni Spectrum e Scout, l\u0027hardware, l\u0027analisi e i servizi dell\u0027azienda trasformano l\u0027infrastruttura fisica in asset di dati.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Miovision_Customer-Reference_Logo.073de87da261a97dbf5eed794d465193cc5d5dd4.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eMiovision uses AWS to capture and analyze IoT data from thousands of connected devices at traffic intersections around the world.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/miovision/","customer-name":"Miovision","enableShare":"1","publishedDate":"2018","contentType":"Storia del cliente","headline":"Miovision trasforma i trasporti tramite AWS IoT e dispositivi intelligenti"}},"tags":[{"id":"customer-references#category#web-hosting","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Web Hosting","description":"Web Hosting","dateCreated":"2019-07-22T18:32:28+0000","dateUpdated":"2022-03-30T20:30:49+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#language#italian","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Italian","description":"Italian","dateCreated":"2020-03-03T06:40:49+0000","dateUpdated":"2022-02-03T03:31:25+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"}]},{"item":{"id":"customer-references#innovaccer-case-study","locale":"en_US","directoryId":"customer-references","name":"innovaccer-case-study","dateCreated":"2019-07-19T14:57:49+0000","dateUpdated":"2024-05-07T16:34:54+0000","additionalFields":{"featured":"0","descriptionSummary":"Innovaccer built a scalable, zero-latency data platform using AWS that is 81 percent more cost-effective than an on-premises equivalent. Innovaccer is a leading healthcare data platform company, empowering healthcare organizations in the United States with data-driven insights for faster clinical decision making and efficient care processes.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Innovaccer_Customer-Reference_Logo.5c4a4cc99bdad74c93e636528f40c38949bf53b5.png","displayLocation":"India","footerInfoText":"Published Date","description":"\u003cp\u003eInnovaccer Inc. is a leading healthcare data platform company that helps customers delivering more efficient and effective services through data analytics. Innovaccer\u0019s aim is to simplify complex data from all points of care, streamline the information, and help organizations realize strategic goals based on key insights and predictions from their data. Its products have been deployed across more than 500 locations with over 10,000 providers leveraging it at institutions, governmental organizations, and several corporate enterprises such as Mercy ACO, StratiFi Health, UniNet Healthcare Network, Catalyst Health Network, and Osler Health Network. Innovaccer is based in San Francisco with offices around the United States and Asia.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/innovaccer/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Innovaccer","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Innovaccer Case Study"}},"tags":[{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Englis