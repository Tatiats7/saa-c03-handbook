"GLOBAL#product#marketplace","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Marketplace","description":"AWS Marketplace","dateCreated":"2020-12-02T20:02:51+0000","dateUpdated":"2022-02-03T03:32:50+0000"},{"id":"customer-references#category#web-hosting","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Web Hosting","description":"Web Hosting","dateCreated":"2019-07-22T18:32:28+0000","dateUpdated":"2022-03-30T20:30:49+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#omada-health-case-study","locale":"en_US","directoryId":"customer-references","name":"omada-health-case-study","dateCreated":"2019-07-22T19:43:01+0000","dateUpdated":"2023-07-14T23:32:29+0000","additionalFields":{"featured":"0","descriptionSummary":"Omada Health built a digital version of a proven diabetes-prevention program on AWS, enabling it to scale cost-effectively and achieve clinically significant results. Omada Health helps people change their habits, improve their health, and reduce their risk of chronic disease through intensive behavioral-change programs that are clinically supported and evidence-based.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/OmadaHealth_Customer-Reference_Logo.60676e43a1fdd61ab48138bb1d43b31253378fc7.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eOmada Health built a digital version of a proven diabetes-prevention program on AWS, enabling it to scale cost-effectively and achieve clinically significant results. Omada Health helps people change their habits, improve their health, and reduce their risk of chronic disease through intensive behavioral-change programs that are clinically supported and evidence-based. The company runs its services on AWS\u0014including Amazon EC2, Amazon RDS, and Amazon S3\u0014and improves outcomes with advanced data science using Amazon Redshift and AWS Elastic Beanstalk.\u003c/p\u003e\r\n","industry":"Life Sciences","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/omada-health/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Omada Health","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Omada Health Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":