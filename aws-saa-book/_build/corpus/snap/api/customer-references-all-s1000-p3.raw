n_US","tagNamespaceId":"customer-references#category","name":"DevOps","description":"DevOps","dateCreated":"2019-07-22T18:31:49+0000","dateUpdated":"2022-03-05T03:54:11+0000"}]},{"item":{"id":"customer-references#tibco-codebuild-case-study","locale":"en_US","directoryId":"customer-references","name":"tibco-codebuild-case-study","dateCreated":"2019-07-22T19:43:41+0000","dateUpdated":"2021-12-22T20:18:46+0000","additionalFields":{"featured":"0","descriptionSummary":"TIBCO Simplr streamlined DevOps workflows, cut its server footprint by 40 percent, and decreased system response time to seconds by containerizing its suite of SaaS connectors using Amazon ECS. TIBCO Simplr makes it easy for nontechnical users to connect cloud applications, build online forms, and automate application workflows with an intuitive, cloud-based service.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/TIBCO_Customer-Reference_Logo.b44ddf7e966255ba359f3bb8bbdda0ae83d5f84d.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eTIBCO Simplr streamlined DevOps workflows, cut its server footprint by 40 percent, and decreased system response time to seconds by containerizing its suite of SaaS connectors using Amazon ECS.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/tibco/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"TIBCO","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"TIBCO CodeBuild Case Study"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","date