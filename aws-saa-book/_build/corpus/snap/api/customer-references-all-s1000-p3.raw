2022-02-03T03:32:31+0000"},{"id":"customer-references#category#archiving","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Archiving","description":"Archiving","dateCreated":"2019-07-22T18:30:59+0000","dateUpdated":"2022-04-09T03:06:56+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-thron","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-thron","dateCreated":"2019-07-22T19:50:40+0000","dateUpdated":"2023-07-14T23:32:42+0000","additionalFields":{"featured":"0","descriptionSummary":"THRON helps its customers get more out of content through distribution, workflow management, and big data analysis for business insights. The Italian company offers a platform to simplify digital content management and distribution and create actionable recommendations to increase business insights. THRON has been able to cut its development and release cycle time in half by using AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/THRON_Customer-Reference_Logo.5a2d54d23712156b20f60cb3357996725d4bc9e9.png","displayLocation":"Italy","footerInfoText":"Published Date","description":"\u003cp\u003eTHRON helps its customers get more out of content through distribution, workflow management, and big data analysis for business insights. The Milan-based company offers a platform to simplify digital content management and distribution and create actionable recommendations to increase business insights. THRON has been able to cut its development and release cycle time in half by using AWS. It uses a range of AWS services, including Amazon Kinesis, Amazon Redshift, and Amazon EMR to power its intelligence and analysis reporting.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/thron/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"THRON","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: THRON"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03