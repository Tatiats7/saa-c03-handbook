23:44+0000"}]},{"item":{"id":"customer-references#uc-santa-cruz-genomics-institute-case-study","locale":"en_US","directoryId":"customer-references","name":"uc-santa-cruz-genomics-institute-case-study","dateCreated":"2019-07-19T15:20:14+0000","dateUpdated":"2023-07-12T01:35:24+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, the UC Santa Cruz Genomics Institute processed 20,000 cancer samples in days instead of months, saving hundreds of thousands of dollars and powering innovative new research. The Institute—which was founded to lead UC Santa Cruz\u0027s efforts to unlock the world\u0027s genomic data—analyzes computational genomics, cancer genomics, and other genomic data.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/UC-Santa-Cruz-Genomics-Institute_Logo.25da0f799038a6d4f0a7e1cdcc67d05bcb87283a.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the UC Santa Cruz Genomics Institute customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Education","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/uc-santa-cruz-genomics-institute/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"UC Santa Cruz Genomics Institute","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"UC Santa Cruz Genomics Institute Case Study"}},"tags":[{"id":"customer-references#category#high-performance-computing","locale":"en_US","tagNamespaceId":"customer-references#category","name":"High Performance Computing","description":"High Performance Computing","dateCreated":"2019-07-22T18:32:00+0000","dateUpdated":"2022-02-26T01:35:03+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"