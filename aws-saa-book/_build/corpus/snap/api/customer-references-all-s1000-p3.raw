k-case-study","locale":"en_US","directoryId":"customer-references","name":"university-of-maryland-college-park-case-study","dateCreated":"2019-07-22T19:48:55+0000","dateUpdated":"2022-01-21T02:41:18+0000","additionalFields":{"featured":"0","descriptionSummary":"University of Maryland, College Park uses the AWS Cloud to create a stable, secure and modern technical environment for its students and staff while ensuring compliance. The University of Maryland is a public research university located in the city of College Park, Maryland, and is the flagship institution of the University System of Maryland.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/UniversityofMarylandUniversityCollege_Customer-Reference_Logo.69b324e56ad79b9af9cc0d2a72ba767fbd0ad1d4.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the University of Maryland, College Park customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of customers. \u0026nbsp;\u003c/p\u003e\r\n","industry":"Education","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/university-of-maryland-college-park/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"University of Maryland, College Park","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"University of Maryland, College Park Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#euc","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"End-User Computing (EUC)","description":"End-User Computing (EUC)","dateCreated":"2020-01-16T17:43:18+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#category#web-hosting","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Web Hosting","description":"Web Hosting","dateCreated":"2019-07-22T18:32:28+0000","dateUpdated":"2022-03-30T20:30:49+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#product#workspaces","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon WorkSpaces","description":"Amazon WorkSpaces","dateCreated":"2020-03-02T07:06:12+0000","dateUpdated":"2022-02-03T03:33:08+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"}]},{"item":{"id":"customer-references#change-healthcare","locale":"en_US","directoryId":"customer-references","name":"change-healthcare","dateCreated":"2020-06-08T18:37:14+0000","dateUpdated":"2023-07-12T01:35:41+0000","additionalFields":{"descriptionSummary":"By using AWS, Change Healthcare can develop and test new services for its customers quickly, and it can scale to meet large demand while minimizing IT costs and complexity. Change HealthcareÄpreviously known as EmdeonÄis the largest health administrative network in the United States, processing claims, pharmacy requests, and performing other functions for more than 340,000 physicians and 60,000 pharmacies. Change Healthcare uses AWS services like Amazon EC2, Amazon S3, Amazon SQS, and Amazon SNS to handle millions of confidential transactions daily from its clients while staying in full compliance with healthcare industry regulations, including HIPAA.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/change-healthcare-logo@1x.560b3ef9660ca805e399527b1b54e9ffc383d30e.png","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/change-healthcare/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2016","customer-name":"Change Healthcare","contentType":"Customer Story","headline":"Change Healthcare case study"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#dev-and-test","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dev \u0026 Test","description":"Dev \u0026 Test","dateCreated":"2019-07-22T18:31:47+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#sns","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Notification Service (SNS)","description":"Amazon Simple Notification Service (SNS)","dateCreated":"2020-03-02T07:05:34+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#category#hcls","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Healthcare \u0026 Life Sciences","description":"Healthcare \u0026 Life Sciences","dateCreated":"2019-07-22T18:31:58+0000","dateUpdated":"2022-05-14T20:13:37+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#industry#life-sciences","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Life Sciences","description":"Life Sciences","dateCreated":"2020-01-16T17:42:31+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#radica-case-study","locale":"en_US","directoryId":"customer-references","name":"radica-case-study","dateCreated":"2019-07-22T19:48:20+0000","dateUpdated":"2023-07-14T23:32:38+0000","additionalFields":{"featured":"0","descriptionSummary":"RADICA can launch campaigns much faster for global brands targeting Chinese consumers now that its multichannel electronic direct-mail platform, RiMANGGIS, runs on AWS. Headquartered in Hong Kong, RADICA provides digital marketing solutions to around 300 businesses.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/RADICA-logo.f7c68295a00d2366d54ea329ed508f0401cee0c2.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","description":"\u003cp\u003eHeadquartered in Hong Kong, RADICA provides digital marketing solutions to around 300 businesses. The company also has offices in Shenzhen, Guangzhou, and Shanghai, and specializes in helping companies target consumers in Asia. Its client base covers Fortune 500 businesses such as Marriott International as well as leading brands including Steelcase and Ermenegildo Zegna. RADICA helps its clients boost the value of their customer data and customer relationship management (CRM) systems for email, mobile, and social media messaging campaigns. Customers integrate their data with the RADICA RiMANGGIS platform, which automates campaign activity and sends out as many as one million marketing messages a day. The platform also provides detailed analysis of campaign performance to help optimize spend.?\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/RADICA/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"RADICA","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"RADICA Case Study"}},"tags":[{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#