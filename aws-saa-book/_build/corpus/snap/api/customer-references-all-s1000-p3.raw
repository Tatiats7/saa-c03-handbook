:"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#pakwheels-case-study","locale":"en_US","directoryId":"customer-references","name":"pakwheels-case-study","dateCreated":"2019-07-19T15:11:53+0000","dateUpdated":"2023-07-14T23:32:39+0000","additionalFields":{"featured":"0","descriptionSummary":"Since migrating to AWS, Pakwheels has been able to reduce its image processing time from 15 mins to 60 seconds, and also enjoys a 99.9 percent uptime. Pakwheels is the largest online marketplace for car shoppers and sellers in Pakistan, providing users with automotive reviews, shopping advice, and comparison tools for car financing and insurance information.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Pakwheels_Customer-Reference_Logo.f651ecddcdc8881602b7db24c48455a6486f3174.png","displayLocation":"Pakistan","footerInfoText":"Published Date","description":"\u003cp\u003ePakwheels is the largest online marketplace for car shoppers and sellers in Pakistan, providing users with automotive reviews, shopping advice, and comparison tools for car financing and insurance information. It aggregates thousands of new, used, and certified second-hand cars from thousands of dealers and private sellers. Since migrating to AWS, Pakwheels has been able to improved its image processing time from 15 mins to 60 seconds, and also enjoys a 99.9% uptime.\u003c/p\u003e\r\n","industry":"Retail","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/pakwheels/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Pakwheels","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Pakwheels Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#auto-scaling","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Auto Scaling","description":"AWS Auto Scaling","dateCreated":"2020-03-02T07:01:39+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","da