d":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#capital-one","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Capital One","description":"Capital One","dateCreated":"2022-04-25T19:05:47+0000","dateUpdated":"2022-07-16T00:04:47+0000"}]},{"item":{"id":"customer-references#aws-case-study-settour","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-settour","dateCreated":"2019-07-19T14:58:48+0000","dateUpdated":"2023-07-14T23:32:32+0000","additionalFields":{"featured":"0","descriptionSummary":"SETTour reduces its IT costs by 20 percent and cuts IT management expense in half by migrating to AWS. The company is a leading travel and tourism operator in Taiwan.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/SETTour_Customer-Reference_Logo.fdf4fdce6092221aca2cd881a77247e6d1479100.png","displayLocation":"Taiwan","footerInfoText":"Published Date","description":"\u003cp\u003eRead the SETTour customer case study. Southeast Travel Agency (SETTour), headquartered in Taiwan, is one of the country\u0019s top-five tourism companies. Launched in 1961, the company has branch offices in Taiwan, China, Japan, and the United States. In 2013, SETTour launched its website for customers to review travel destinations and make online travel bookings. Over the last five years, the website has become an increasingly important sales channel for SETTour, generating TWD$30 billion (US$974 million) in annual revenue.\u003c/p\u003e\r\n","industry":"Travel \u0026 Hospitality","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/settour/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"SETTour","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"AWS Case Study - SETTour"}},"tags":[{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Optimization","description":"\u003cp\u003eCost Optimization\u003c/p\u003e\n","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2023-07-13T00:08:24+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","desc