nce Platform collects data from various sources and distills it down into a single view of a given customer, scores and evaluates where that customer is in the customer journey, and then groups them into audiences that marketers use for personalization across channels.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/zeta-logo@1x.476f90bbac0b836ca70fbe570e66cbbdf77abeb6.png","displayLocation":"North America","footerInfoText":"Published Date","industry":"Digital Marketing","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/zeta-global-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Zeta Global","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Zeta Global Powers Identity Resolution at Scale with Amazon Neptune"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#neptune","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Neptune","description":"Amazon Neptune","dateCreated":"2020-03-02T07:04:40+0000","dateUpdated":"2022-02-03T03:32:52+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#te