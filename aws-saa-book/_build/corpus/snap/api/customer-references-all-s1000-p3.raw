mer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"}]},{"item":{"id":"customer-references#tycsports","locale":"en_US","directoryId":"customer-references","name":"tycsports","dateCreated":"2023-06-01T23:05:28+0000","dateUpdated":"2023-06-08T04:07:41+0000","additionalFields":{"descriptionSummary":"TyC Sports es uno de los principales canales deportivos en Argentina. Su forma principal de transmisión es por cable, pero la compañía está comenzando a explorar las alternativas Over the Top (OTT). El beneficio principal que se obtuvo al trabajar con AWS y el socio APN, CloudHesive, fue la gestión del tráfico de alta demanda, como se vio en la última Copa América, donde algunos juegos tenían más de 15.000 usuarios simultáneos, sin ningún tipo de problema. Esta iniciativa ayudó a TyC a lograr su mayor audiencia desde el establecimiento de su plataforma end-to-end. Con AWS, TyC aumenta su audiencia y se prepara para el futuro, dado que su base de datos administra aproximadamente 800.000 cuentas. Vea el testimonio de Martin Rubino, coordinador de OTT de TyC, y obtenga más información.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/tycsports_logo%401x.274032bd641e9407c22ef994710fd00b9d21352b.png","displayLocation":"Argentina","customerNameLower":"tyc sports","footerInfoText":"Fecha de publicación","industry":"Medios y entretenimiento","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/tyc_sports/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"TyC Sports","enableShare":"1","publishedDate":"2019","contentType":"Historia del cliente","headline":"TyC Sport aumenta su audiencia y se prepara para el futuro con tecnologías AWS"}},"tags":[{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12T02:01:29+0000"},{"id":"customer-references#category#mobile","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Mobile","description":"Mobile","dateCreated":"2019-07-22T18:32:14+0000","dateUpdated":"2022-03-24T02:42:27+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","