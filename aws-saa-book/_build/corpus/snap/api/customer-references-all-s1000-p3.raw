 only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#zappos20200413soemvyzi","locale":"en_US","directoryId":"customer-references","name":"zappos20200413soemvyzi","dateCreated":"2022-05-23T21:44:09+0000","dateUpdated":"2022-05-23T21:53:37+0000","additionalFields":{"descriptionSummary":"Learn how Zappos updated its back office systems by using Amazon ECS for consistent deployments and how the company migrated off of Oracle onto Amazon Aurora MySQL.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/zappos-logo%401x.beaa428481cd50b53f87832f15543cc16d46e17f.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Retail","sortDate":"2020-04-13","headlineUrl":"https://youtu.be/mZxF1IJEsaY?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Zappos: Back Office Migration, starring Amazon ECS and Amazon Aurora","customer-name":"Zappos"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:1