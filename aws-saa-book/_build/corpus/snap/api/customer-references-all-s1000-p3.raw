, California, the private research university focuses on natural science and engineering research. Caltech uses Amazon EFS and Amazon ECS to store files and run containerized applications on AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Caltech_Logo@1x.40de4b72f00091dec01eb6bfd48f727fc8e6914d.png","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Education","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/caltech-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Caltech","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Caltech Uses Amazon EFS to Automate File Management for HPC Environments"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"