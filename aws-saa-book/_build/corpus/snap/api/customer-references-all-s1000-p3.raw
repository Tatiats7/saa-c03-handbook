,"contentType":"Customer Story","headline":"AWS Case Study: Freshdesk"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#opsworks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS OpsWorks","description":"AWS OpsWorks","dateCreated":"2020-03-02T07:04:41+0000","dateUpdated":"2022-02-03T03:32:52+0000"},{"id":"customer-references#category#web-hosting","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Web Hosting","description":"Web Hosting","dateCreated":"2019-07-22T18:32:28+0000","dateUpdated":"2022-03-30T20:30:49+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aws-case-study-daily-voice","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-daily-voice","dateCreated":"2019-07-22T19:53:38+0000","dateUpdated":"2023-07-14T23:32:47+0000","additionalFields":{"featured":"0","descriptionSummary":"Daily Voice provides online news coverage specific to communities throughout Connecticut and New York. The company runs its website infrastructure on AWS. By using AWS, Daily Voice scaled its website to support a 40 percent increase in web traffic and send about 200,000 emails per day to its users.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/daily_voice-logo.43b7dba88dc3b8d7545a62d870ea7edb502d18e2.jpg","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eDaily Voice delivers online news to local communities in Connecticut and New York. The company engaged APN Partner, Apparatus to manage its website infrastructure on AWS, including its web servers, content delivery, and email services. By using AWS, Daily Voice has scaled to support increases in web traffic of up to 40% and send around 200,000 emails per day to its users.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/cas