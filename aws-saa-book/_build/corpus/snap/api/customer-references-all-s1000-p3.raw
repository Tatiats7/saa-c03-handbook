"GLOBAL#industry","name":"Digital Marketing","description":"Digital Marketing","dateCreated":"2020-01-16T17:42:16+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"}]},{"item":{"id":"customer-references#siemens-innovator-de-it","locale":"en_US","directoryId":"customer-references","name":"siemens-innovator-de-it","dateCreated":"2024-11-12T00:53:37+0000","dateUpdated":"2024-11-12T01:13:42+0000","additionalFields":{"descriptionSummary":"Siemens AG, leader globale nell\u0027elettrificazione, nell\u0027automazione e nella digitalizzazione, guida l\u0027innovazione in vari settori da oltre 175 anni. Siemens utilizza una gamma di tecnologie Amazon Web Services (AWS) per portare avanti la tradizione della trasformazione, portando l\u0027Internet delle cose industriale (IIoT) a ferrovie e fabbriche, sviluppando infrastrutture intelligenti per edifici e sistemi di energia distribuiti, implementando l\u0027intelligenza artificiale (IA) sulla piattaforma di cybersecurity e molto altro. Dalla modernizzazione dell\u0027infrastruttura di dati e delle funzionalità di analisi con AWS Glue e Amazon Athena all\u0027utilizzo di Amazon Neptune e AWS Lambda per creare Building Twin di Siemens. Ogni passaggio intrapreso dall\u0027organizzazione nel cloud AWS apporta nuova efficienza, valore e informazioni per migliorare le operazioni per Siemens e i suoi clienti.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Siemens_Customer-Reference_Logo%401x.bb038521df5899223d4bd8364182c2fc69ef288d.png","displayLocation":"North America","customerNameLower":"siemens","footerInfoText":"Published Date","industry":"Life Sciences","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/innovators/siemens/","customer-name":"Siemens","enableShare":"1","publishedDate":"2020","contentType":"Storia del cliente","headline":"Siemens su AWS"}},"tags":[{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#product#translate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Translate","description":"Amazon Translate","dateCreated":"2020-03-02T07:05:56+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"