ish.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#doordash-case-study","locale":"en_US","directoryId":"customer-references","name":"doordash-case-study","dateCreated":"2020-05-15T21:15:19+0000","dateUpdated":"2023-07-12T01:40:51+0000","additionalFields":{"descriptionSummary":"DoorDash is the largest third-party delivery service in the world, supporting on-demand delivery for more than 340,000 local businesses and restaurants in 4,400 cities across the United States and Canada.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/doordash-logo@1x.f1c44f55f24707072a9b78b0860905e05d65d875.png","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Travel \u0026 Hospitality","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/doordash-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","customer-name":"Doordash","contentType":"Customer Story","headline":"AWS Global Summit New York 2019 Keynote – Andy Fang, DoorDash"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03: