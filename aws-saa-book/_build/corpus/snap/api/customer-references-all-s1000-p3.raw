},{"item":{"id":"customer-references#iac-publishing-case-study","locale":"en_US","directoryId":"customer-references","name":"iac-publishing-case-study","dateCreated":"2019-07-22T19:43:30+0000","dateUpdated":"2021-12-22T18:53:39+0000","additionalFields":{"featured":"0","descriptionSummary":"IAC Publishing competes more effectively, deploys code four to six times per day instead of every four to six weeks, and saves $15 million annually by moving more than 50 websites to AWS. The company manages and maintains popular websites such as The Daily Beast, Dotdash, and Dictionary.com.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/US/600x400_IAC_Logo.5522d89e4c8c1fe2c32efea156681183c54ac9ac.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the IAC customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/iac-publishing/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"IAC Publishing","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"IAC Publishing Case Study"}},"tags":[{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdate