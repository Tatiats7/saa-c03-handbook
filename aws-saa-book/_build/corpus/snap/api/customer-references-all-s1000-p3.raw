3+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#location#mexico","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Mexico","description":"Mexico","dateCreated":"2020-04-09T00:25:53+0000","dateUpdated":"2022-02-03T03:31:31+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#aws-case-study-all-nippon-airways","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-all-nippon-airways","dateCreated":"2019-07-19T14:57:29+0000","dateUpdated":"2023-07-12T01:40:49+0000","additionalFields":{"featured":"0","descriptionSummary":"All Nippon Airways (ANA) is Japan\u0027s largest airline, operating domestic and international routes. Seeking a data-analysis platform with flexibility and extensibility, ANA decided to migrate its data warehouse to AWS.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/jp/ana_logo.07ccb05ea8c7dfcda6c68bc9fd2501379d1f33f8.jpg","displayLocation":"Japan","footerInfoText":"Published Date","description":"\u003cp\u003eJapanese airline All Nippon Airways migrated a data warehouse storing international and domestic ticket reservation, issuing and embarkation information, aircraft operation records, and cargo transportation records to Amazon Redshift. Utilizing the AWS Database Migration Service, ANA made the terabyte-class data transfer safely and in a short period of time. The move resulted in server-procurement lead time shortened from 5 months for on-premises to 1.5 months. Batch-processing performance also improved by a factor of up to 100. With improvements in the performance of analysis platforms, an increase in both efficiency and sophistication in analytical operations has been observed.\u003c/p\u003e\r\n","industry":"Transport \u0026 Logistics","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ana/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"All Nippon Airways","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"AWS Case Study: All Nippon Airways"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLO