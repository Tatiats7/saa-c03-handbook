n":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"}]},{"item":{"id":"customer-references#sura","locale":"en_US","directoryId":"customer-references","name":"sura","dateCreated":"2023-06-01T23:05:42+0000","dateUpdated":"2023-06-08T04:07:41+0000","additionalFields":{"descriptionSummary":"Seguros Sura se dedica a los seguros y a la gestión de tendencias y riesgos. Es una compañía que opera en Argentina y en otros 9 países de Latinoamérica. Puntualmente en Argentina tiene aproximadamente un millón de clientes y un millón y medio de ítems asegurados. En Latinoamérica Sura tiene acerca de 17 millones de clientes. Buscando obtener más flexibilidad en sus operaciones diarias, Sura identificó en AWS las tecnologías necesarias para trabajar de manera más eficiente y enfocada en sus clientes. Con la implementación de Amazon Connect junto con lambda, Sura puede predecir lo que el cliente quiere hacer y dárselo de una manera más rápida y sencilla. Sura ha trabajado en este proyecto con el socio de negocios APN Edrans para la creación de la arquitectura.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/sura_logo%401x.1a26ed16c4a38588e7fc5e5b88b0391c24dd32ab.png","displayLocation":"Argentina","customerNameLower":"sura argentina","footerInfoText":"Fecha de publicación","industry":"Servicios financieros","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/sura/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Sura Argentina","enableShare":"1","publishedDate":"2020","contentType":"Historia del cliente","headline":"Seguros Sura obtiene flexibilidad en sus negocios con tecnologías AWS"}},"tags":[{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#product#connect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Connect","description":"Amazon Connect","dateCreated":"2020-03-02T07:02:22+0000","dateUpdated":"2022-02-03T03:32:26+0000"},{"id":"customer-references#category#customer-engagement","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2019-07-22T18:31:37+0000","dateUpdated":"2022-03-21T23:37:45+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05: