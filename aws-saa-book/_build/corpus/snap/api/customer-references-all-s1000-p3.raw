5e57ed8a697caf0141889f862a285a61418e5f0.png","displayLocation":"Germany","footerInfoText":"Published Date","description":"\u003cp\u003eThe Berlin Philharmonic, together with the Digital Concert Hall, provides a virtual concert hall for its listeners all over the world. Through the use of AWS, the Berlin Philharmonic lets its listeners enjoy recorded concerts uninterrupted, no matter where in the world these classical music fans are found.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/bph/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Berlin Philharmonic","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Berlin Philharmonic Case Study"}},"tags":[{"id":"GLOBAL#location#germany","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Germany","description":"Germany","dateCreated":"2020-02-03T05:29:55+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#content-type#customer-story","locale"