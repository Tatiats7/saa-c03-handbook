-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#snowball","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Snowball","description":"AWS Snowball","dateCreated":"2020-03-02T07:05:27+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#customer-segment#public-sector-edu","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Education","description":"Education","dateCreated":"2019-07-22T18:39:45+0000","dateUpdated":"2022-03-21T23:55:12+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"}]},{"item":{"id":"customer-references#trax-video","locale":"en_US","directoryId":"customer-references","name":"trax-video","dateCreated":"2020-11-09T18:09:00+0000","dateUpdated":"2021-12-23T01:02:13+0000","additionalFields":{"descriptionSummary":"Trax helps retailers better manage their stores through digital insights. Its technology analyzes digital images of products and store layouts and provides recommendations—on product selection, placement, pricing, and promotions, for example—based on the images it analyzes. The company was founded in Singapore in 2010 and maintains a research and development base in Israel. It operates in more than 45 markets worldwide and has a database of 10 billion products that it recognizes with its image recognition and machine learning technology.Since 2012, Trax has used Amazon Web Services (AWS) to power its business. As well as handling image recognition, Trax’s environment includes a repository that ingests more than 10 TB of images a month.In this video, Yair Adato, vice president of research and development at Trax, explains how the company reduced the cost of image processing by 60 percent with a multi-tenant AWS architecture. He also previews a new application that creates store maps in real time using augmented reality.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Trax_Customer-Reference_Logo@1x.6d3edd59beda9a8d8796dd5e13f7e7dfb2521eac.png","displayLocation":"Israel","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/trax-video/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Trax Brings Online Intelligence to Offline Retail","customer-name":"Trax"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#location#middle-east-africa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East \u0026 Africa","description":"Middle East \u0026 Africa","dateCreated":"2020-02-03T05:30:19+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#location#middle-east","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East","description":"Middle East","dateCreated":"2020-04-09T03:53:16+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"GLOBAL#location#israel","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Israel","description":"Israel","dateCreated":"2020-02-03T05:30:21+0000","dateUpdated":"2022-02-03T03:31:55+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#n26-video","locale":"en_US","directoryId":"customer-references","name":"n26-video","dateCreated":"2020-11-09T18:06:42+0000","dateUpdated":"2021-12-23T00:54:23+0000","additionalFields":{"descriptionSummary":"Germany-based N26 is a bank built in the cloud. Focusing on easy-to-use digital services and low costs, N26 has attracted more than 2.3 million customers across Europe and handles around $1.5 billion transactions each month.As the bank grew beyond the startup phase, its twin challenges were to combine the speed and flexibility of a small organization with the security and compliance of a licensed bank.In this video, N26’s Chief Technology Officer Patrick Kua explains how the bank achieves this by using Amazon Web Services (AWS) to implement continuous delivery and infrastructure as code. Combined, these help N26 to scale rapidly, reduce human error, and respond quickly to security threats like Spectre.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/N26_Customer-Reference_Logo@1x.490daf23409efad4207cb5acd62fe71df1afc043.png","displayLocation":"Germany","footerInfoText":"Published Date","industry":"Banking","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/N26-video/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"N26 Thrives Past Startup Phase Using AWS","customer-name":"N26"}},"tags":[{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0