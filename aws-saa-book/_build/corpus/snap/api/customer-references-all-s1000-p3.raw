03T03:32:07+0000"}]},{"item":{"id":"customer-references#capella-space-innovator","locale":"en_US","directoryId":"customer-references","name":"capella-space-innovator","dateCreated":"2022-07-16T00:05:10+0000","dateUpdated":"2024-06-26T18:56:28+0000","additionalFields":{"featureImageURL":"https://d1.awsstatic.com/aws-key-pages/homepage-key-pages/customer-stories-logo/Capella.44044384929de9877e739168baf7e0a6d464d37f.jpg","descriptionSummary":"\u003cp\u003eSince 2020, Capella has been leveraging Amazon Web Services (AWS) to automate and scale its operations, including satellite command and control. By building on AWS, Capella reliably delivers data to customers and helps them quickly analyze and extract value from the data.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/capella-space-logo%401x.3a27b01c52c988f3105ea158561ed7d5845c6ced.png","displayLocation":"United States","customerNameLower":"capella space","footerInfoText":"Published Date","description":"\u003cp\u003eAccessing satellite data within minutes to solve global problems\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u0026nbsp;\u003c/p\u003e\n","industry":"Aerospace","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/innovators/capella-space/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Capella Space","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Capella Space on AWS"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#batch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Batch","description":"AWS Batch","dateCreated":"2020-03-02T07:01:42+0000","dateUpdated":"2022-02-03T03:32:19+0000"