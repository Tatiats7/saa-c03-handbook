22-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#southern-oregon-university-case-study","locale":"en_US","directoryId":"customer-references","name":"southern-oregon-university-case-study","dateCreated":"2019-07-22T19:44:56+0000","dateUpdated":"2022-01-21T02:40:40+0000","additionalFields":{"featured":"0","descriptionSummary":"Southern Oregon University used AWS to eliminate its reliance on difficult-to-manage physical tape backups, fully migrating to a disaster-ready, cloud-based solution in just five months—all without changing its backup software or workflows. Southern Oregon University provides career-focused, comprehensive educational experiences to more than 6,200 students from its campus in Ashland, Oregon.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/SouthernOregonUniversity_Customer-Reference_Logo.ec69a42f05b407822b8e54695ccbb325aed611cd.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eSouthern Oregon University used AWS to eliminate its reliance on difficult-to-manage physical tape backups, fully migrating to a disaster-ready, cloud-based solution in just five months\u0014all without changing its backup software or workflows. Southern Oregon University provides career-focused, comprehensive educational experiences to more than 6,200 students from its campus in Ashland, Oregon. The university relies on AWS Storage Gateway for a seamless connection from its backup-management platform to Amazon S3 cloud-based storage, using the AWS US East (N. Virginia) Region to ensure the ability to recover data after a site-level disaster.\u003c/p\u003e\r\n","industry":"Education","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/southern-oregon-university/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Southern Oregon University","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Southern Oregon University Case Study"}},"tags":[{"id":"GLOBAL#use-case#archiving","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Archiving","description":"Archiving","dateCreated":"2020-06-05T06:36:56+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#product#glacier","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon S3 Glacier","description":"Amazon S3 Glacier","dateCreated":"2020-03-02T07:03:38+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":