","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Podcast","description":"Podcast","dateCreated":"2020-04-29T05:19:29+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"GLOBAL#industry#general-public-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"General Public Services","description":"General Public Services","dateCreated":"2020-01-16T17:42:24+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#location#ukir","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"UK/IR","description":"UK/IR","dateCreated":"2020-02-19T23:06:44+0000","dateUpdated":"2022-02-03T03:31:51+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#customer-segment#non-profit","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Non-profit","description":"Non-profit","dateCreated":"2021-06-04T06:35:44+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#pasonsfhkpiew846","locale":"en_US","directoryId":"customer-references","name":"pasonsfhkpiew846","dateCreated":"2022-05-23T21:42:59+0000","dateUpdated":"2022-05-23T21:53:08+0000","additionalFields":{"descriptionSummary":"Learn how Pason built a petabyte scalable customer-facing drilling datamart using AWS services. Ed Quan from Pason describes how Amazon EMR, along with Presto, can be used to provide a secure and seamless SQL interface to data that is stored in Amazon RDS and Hive. Hive is used to periodically ETL billions of sensor data points from microservices into S3 and EMRFS. You will also learn how multiple EMR clusters were used to provide high availability and distribute workloads across this solution.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/pason-systems-corp-logo%401x.b704d7d350369b695666907d247573b4918af5c7.png","displayLocation":"Canada","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2020-01-22","headlineUrl":"https://youtu.be/tVjrkpjWG5o?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Pason Systems: Petabyte Scale Drilling Datamart on AWS (LIVE)","customer-name":"Pason Systems Corp"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#tech-category#ana