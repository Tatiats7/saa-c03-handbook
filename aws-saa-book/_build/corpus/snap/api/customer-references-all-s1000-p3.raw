aming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#category#web-hosting","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Web Hosting","description":"Web Hosting","dateCreated":"2019-07-22T18:32:28+0000","dateUpdated":"2022-03-30T20:30:49+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#duolingo-case-study-dynamodb","locale":"en_US","directoryId":"customer-references","name":"duolingo-case-study-dynamodb","dateCreated":"2019-07-22T19:45:38+0000","dateUpdated":"2023-07-14T23:32:44+0000","additionalFields":{"descriptionSummary":"Duolingo uses AWS to run an online language-learning platform that stores 31 billion items and includes six billion exercises performed each month. The company reaches more than 18 million monthly users around the world with its free online language learning site. It relies heavily on Amazon DynamoDB for a highly scalable database along with a range of other AWS services, including Amazon EC2 for compute, Amazon ElastiCache to increase performance, Amazon S3 for storing image-related data, and Amazon RDS for permanent data storage.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Duolingo_Customer-Reference_Logo.0f8bac243ce6d4a1ffacb802ff5a9d8729f3ae15.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"Duolingo uses AWS to run an online language-learning platform that stores 31 billion items and includes six billion exercises performed each month. The company reaches more than 18 million monthly users around the world with its free online language learning site. It relies heavily on Amazon DynamoDB for a highly scalable database along with a range of other AWS services, including Amazon EC2 for compute, Amazon ElastiCache to increase performance, Amazon S3 for storing image-related data, and Amazon Relational Database Service (Amazon RDS) for permanent data storage.","industry":"Education","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/duolingo-case-study-dynamodb/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Duolingo-DynamoDB","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"Duolingo Case Study-DynamoDB"}},"tags":[{"id":"customer-references#category#dev-and-test","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dev \u0026 Test","description":"Dev \u0026 Test","dateCreated":"2019-07-22T18:31:47+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+000