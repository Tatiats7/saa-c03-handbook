21-12-22T22:42:24+0000","additionalFields":{"featured":"0","descriptionSummary":"The ALDO Group uses AWS to provide a better in-store experience for footwear shoppers, integrate real-time capabilities into mobile apps, and deliver new applications in less than half the time. The company is a leading retailer of footwear and accessories to global customers. ALDO uses AWS AppSync, including the GraphQL API query language, to ease application development.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/600x400_ALDOGroup_Logo.cc8229aecdbe9694229fbe7b43cd2e0dbefd8e5b.png","displayLocation":"Canada","footerInfoText":"Published Date","industry":"Retail","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/aldo-group-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ALDO Group","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"ALDO Uses AWS AppSync to Improve Shopping Experience of Footwear Customers"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#appsync","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS AppSync","description":"AWS AppSync","dateCreated":"2020-03-02T07:01:32+0000","dateUpdated":"2022-02-03T03:32:17+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#industry#retail","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name