03T03:31:15+0000"}]},{"item":{"id":"customer-references#intuit-mint-case-study","locale":"en_US","directoryId":"customer-references","name":"intuit-mint-case-study","dateCreated":"2019-07-22T19:44:13+0000","dateUpdated":"2023-07-19T03:04:49+0000","additionalFields":{"featured":"0","descriptionSummary":"Intuit Mint uses AWS to automatically scale to support a 200 percent increase in website traffic, reduce operating costs by 25 percent, and boost website availability and developers\u0027 speed and efficiency. Mint is a free online service that consumers can use to manage personal finances and track and pay bills in a single location.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/intuit-logo%401x.abf7c40ea61ce4d0953ca761007c94e44fb36e58.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eIntuit Mint uses AWS to automatically scale to support a 200 percent increase in website traffic, reduce operating costs by 25 percent, and boost website availability and developers\u0019 speed and efficiency.\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/intuit-mint/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Intuit Mint","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Intuit Mint Case Study"}},"tags":[{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#intuit","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Intuit","description":"Intuit","dateCreated":"2022-09-15T00:48:33+0000","dateUpdated":"2022-09-15T00:48:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-re