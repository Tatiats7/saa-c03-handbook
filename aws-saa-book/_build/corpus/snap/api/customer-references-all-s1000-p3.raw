":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"}]},{"item":{"id":"customer-references#flatiron-health","locale":"en_US","directoryId":"customer-references","name":"flatiron-health","dateCreated":"2019-07-19T17:07:49+0000","dateUpdated":"2023-07-12T01:35:42+0000","additionalFields":{"featured":"0","descriptionSummary":"Flatiron Health delivers software faster, organizes and improves the quality of oncology data, and ensures regulatory compliance by running its applications on AWS. The company provides software to clinicians to manage their practice, workflow, and patient health information.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/FlatironHealth_Customer-Reference_Logo.198a3c1c17afc9305dfcde5a6ca0176b8aff9c24.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eFlatiron Health delivers software faster, organizes and improves the quality of oncology data, and ensures regulatory compliance by running its applications on AWS. The company provides software to clinicians to manage their practice, workflow, and patient health information. Flatiron runs its critical data-management and research applications on AWS.\u003c/p\u003e\r\n","industry":"Life Sciences","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/flatiron-health/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Flatiron Health","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Flatiron Health"}},"tags":[{"id":"GLOBAL#customer-enablement#business-support","locale":"en_US","tagNamespaceId":"GLOBAL#customer-enablement","name":"AWS Business Support","description":"AWS Business Support","dateCreated":"2020-09-04T04:06:24+0000","dateUpdated":"2022-02-03T03:31:13+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dat