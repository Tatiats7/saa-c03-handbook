":{"featured":"0","descriptionSummary":"Amazon Web Services and Cloud Protection Manager by N2WS from AWS Marketplace allows Goodwill Industries of Southern New Jersey and Philadelphia to quickly recover from outages using regularly scheduled, incremental, snapshot-based backups.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/goodwill_logo%401x.3622b85dd00b17b682c3702908948a2ca8650435.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Government","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/goodwill/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Goodwill","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"Goodwill Stays Up and Running with AWS Marketplace and N2WS"}},"tags":[{"id":"GLOBAL#industry#social-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Social Services","description":"Social Services","dateCreated":"2020-06-25T04:08:10+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#backup-restore","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Backup \u0026 Restore","description":"Backup \u0026 Restore","dateCreated":"2019-07-22T18:31:01+0000","dateUpdated":"2022-04-09T03:06:56+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-