ts e-learning courses and learning management system.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/invision/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"InVision","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"InVision Case Study"}},"tags":[{"id":"GLOBAL#location#germany","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Germany","description":"Germany","dateCreated":"2020-02-03T05:29:55+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022