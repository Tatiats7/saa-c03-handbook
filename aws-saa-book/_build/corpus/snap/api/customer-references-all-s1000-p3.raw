#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#workload#sap","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"SAP","description":"SAP","dateCreated":"2021-01-06T00:09:56+0000","dateUpdated":"2022-02-03T03:36:05+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#agriculture","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Agriculture","description":"Agriculture","dateCreated":"2020-06-25T04:02:53+0000","dateUpdated":"2022-02-03T03:32:00+0000"}]},{"item":{"id":"customer-references#aws-case-study-dayta-ai","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-dayta-ai","dateCreated":"2020-01-30T05:18:19+0000","dateUpdated":"2021-12-22T19:07:25+0000","additionalFields":{"descriptionSummary":"With AWS, Dayta AI is able to avoid upfront hardware costs and offload routine infrastructure management tasks. This has allowed Dayta AI to gain up to 20 percent greater computing price-performance and stay focused on machine learning modelling. Hong Kong–based startup Dayta AI has developed Cyclops, a machine-vision software that retailers use to learn more about their customers’ retail experiences.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Case%20Study%20Logos/Dayta%20AI_logo.7adea89d1cf31f2ff57617a4bf234694d096e8ea.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","des