":"dentsu20200316wexcotrv","dateCreated":"2022-05-23T21:41:12+0000","dateUpdated":"2022-05-23T21:52:26+0000","additionalFields":{"descriptionSummary":"Hear how Dentsu Tracking, an AWS Advanced Consulting Partner, is powering one of the world’s largest traceability platforms using serverless technologies. The platform is a government supply-chain control system, used by the European Commission to protect citizen health and combat illicit trade. Hear how Dentsu Tracking addresses the immense scalability challenges, tracking and tracing 150 billion products in near real-time from production to retail. The system is based on AWS serverless technologies and combines the use of multiple Lambda Functions, an API Gateway, SQS queues, DynamoDB tables, ElasticCache, Amazon S3, and Redshift.","displayLocation":"United States","footerInfoText":"Published Date","industry":"Retail","sortDate":"2020-03-16","headlineUrl":"https://youtu.be/rRvy5Fbei1s?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Dentsu Tracking: Using Serverless to Power an EU Government Supply-Chain Control System","customer-name":"Dentsu Aegis Network"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"202