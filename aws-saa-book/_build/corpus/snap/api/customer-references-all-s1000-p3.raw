 to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#milesweb-case-study","locale":"en_US","directoryId":"customer-references","name":"milesweb-case-study","dateCreated":"2020-01-30T05:20:27+0000","dateUpdated":"2023-07-14T23:32:37+0000","additionalFields":{"descriptionSummary":"MilesWeb migrated its websites to AWS—reducing latency by 30 percent and management costs by 30 percent.","imageSrcUrl":"https://d1.awsstatic.com/events/aws-hosted-events/2019/APAC/case-studies/miles-web-casestudy-logo.6c3a63f11f35a6afa1df2179ff06ea6e4f9d1714.png","displayLocation":"India","footerInfoText":"Published Date","description":"MilesWeb migrated its websites to AWS—reducing latency by 30 percent and management costs by 30 percent.","industry":"Software \u0026 Internet","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/milesweb/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"MilesWeb","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"MilesWeb Case Study"}},"tags":[{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#languag