anguage","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#indonesia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Indonesia","description":"Indonesia","dateCreated":"2020-02-03T05:29:22+0000","dateUpdated":"2022-02-03T03:31:36+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"}]},{"item":{"id":"customer-references#swissmedical","locale":"en_US","directoryId":"customer-references","name":"swissmedical","dateCreated":"2023-06-01T23:05:39+0000","dateUpdated":"2023-07-12T01:35:23+0000","additionalFields":{"descriptionSummary":"Swiss Medical es un grupo de capitales argentinos, con más de 12,500 empleados y empresas en múltiples divisiones de la salud, incluyendo clínicas, centros médicos, centros de ortodoncia y grupos de financiación. Los negocios de Swiss Medical estaban creciendo mucho más que su departamento de TI, lo que llevó la empresa a buscar soluciones AWS que pudieran generar agilidad e innovación. En este momento, la empresa está trabajando en la migración de su ERP SAP con la nube. Y en el lado de la innovación, Swiss Medical está desarrollando un asistente virtual para los pacientes, sus clínicas, utilizando las plataformas AWS Cloud9 y lambda.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/swissmedical_logo%401x.f6879820ad65d7db91d98b9a3c1883753d5c0d03.png","displayLocation":"Argentina","customerNameLower":"swiss medical group","footerInfoText":"Fecha de publicación","industry":"Atención sanitaria","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/swissmedical/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Swiss Medical Group","enableShare":"1",