ocale":"en_US","directoryId":"customer-references","name":"engie-case-study-sap-it","dateCreated":"2024-11-12T00:54:45+0000","dateUpdated":"2024-11-12T01:13:40+0000","additionalFields":{"descriptionSummary":"ENGIE è un gruppo energetico globale che lavora per accelerare la transizione verso un mondo a zero emissioni, offrendo energia e servizi a basse emissioni di carbonio. Il gruppo si affida ad Amazon Web Services (AWS) per innovare e raggiungere la sostenibilità per l\u0027azienda e i clienti. Basandosi su AWS, ENGIE promuove la trasformazione digitale con il Common Data Hub, aiuta a proteggere le aziende con una soluzione scalabile e alimenta più di 1.000 modelli di manutenzione predittiva di machine learning nelle sue centrali elettriche.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Engie_Logo@1x.0c113ddc2f31b59cf84d5b3d7dfdfef6570f1331.png","displayLocation":"France","footerInfoText":"Published Date","industry":"Power \u0026 Utilities","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/it/solutions/case-studies/innovators/engie/","customer-name":"Engie","enableShare":"1","publishedDate":"2019","contentType":"Storia del cliente","headline":"ENGIE su AWS"}},"tags":[{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#workload#sap","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"SAP","description":"SAP","dateCreated":"2021-01-06T00:09:56+0000","dateUpdated":"2022-02-03T03:36:05+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business App