Directory%20Logos/gardens-libraries-and-museums-oxford-university@1x.129104c4a39dfdb012140b53c7ace409cc89b3bb.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","industry":"Education","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/glam/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Safeguarding Oxford University’s Global Heritage Collections with AWS","customer-name":"GLAM"}},"tags":[{"id":"GLOBAL#product#glacier","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon S3 Glacier","description":"Amazon S3 Glacier","dateCreated":"2020-03-02T07:03:38+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#uk","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United Kingdom","description":"United Kingdom","dateCreated":"2020-02-03T05:30:18+0000","dateUpdated":"2022-02-03T03:31:52+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#snow-family","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Snow Family","descriptio