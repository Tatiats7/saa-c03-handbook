0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#nextdoor-containers-case-study","locale":"en_US","directoryId":"customer-references","name":"nextdoor-containers-case-study","dateCreated":"2019-07-22T19:45:00+0000","dateUpdated":"2021-12-22T19:47:14+0000","additionalFields":{"featured":"0","descriptionSummary":"Nextdoor is a private social network that connects people with their neighbors. The company runs the Nextdoor website and a data analytics solution on AWS, powering more than 69,000 neighborhoods across the United States. Using AWS, Nextdoor delivers fast website performance for members, launched 50,000 servers in four years, and rolls back new code releases in less than a minute.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Nextdoor_Customer-Reference_Logo.5c5678d79c3f4bd1c4870bb9d4307f8c2aec6e18.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the Nextdoor containers customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/nextdoor/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Nextdoor","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Nextdoor"}},"tags":[{"id":"customer-references#category#dev-and-test","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dev \u0026 Test","description":"Dev \u0026 Test","dateCreated":"2019-07-22T18:31:47+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-0