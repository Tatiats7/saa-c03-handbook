3T03:31:32+0000"}]},{"item":{"id":"customer-references#zocdoc-machine-learning-case-study","locale":"en_US","directoryId":"customer-references","name":"zocdoc-machine-learning-case-study","dateCreated":"2020-02-03T23:42:12+0000","dateUpdated":"2023-07-12T01:35:22+0000","additionalFields":{"featured":"0","descriptionSummary":"Zocdoc uses TensorFlow to create machine learning algorithms that match patients to doctors, reducing the wait time for appointments.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/zocdoc_logo.f47763c7a8d31f4dc6b31f2870b91e7154e065fd.png","displayLocation":"Americas","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/blogs/machine-learning/zocdoc-builds-patient-confidence-using-tensorflow-on-aws/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Zocdoc","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Zocdoc Builds Patient Confidence Using TensorFlow on AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#university-of-arizona-case-study","locale":"en_US","directoryId":"customer-references","name":"university-of-arizona-case-study","dateCreated":"2019-07-19T15:10:41+0000","dateUpdated":"2022-01-21T02:45:00+0000","additionalFields":{"featured":"0","descriptionSummary":"The University of Arizona (UA) addressed the challenge of creating a more efficient and agile IT operation by migrating to the cloud. After initial success in migrating its Research Administration system, UA became the first major university to migrate its PeopleSoft application environments—Learning (EL), Human Resources (HR), and Student (SA)—to AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/UniversityofArizona_Customer-Reference_Logo.e14949e4e91febc9d6171c4858bcf20e21efae1a.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the University of Arizona customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Education","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/university-of-arizona/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"University of Arizona","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"University of Arizona Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#customer-segment#public-sector-edu","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Education","description":"Education","dateCreated":"2019-07-22T18:39:45+0000","dateUpdated":"2022-03-21T23:55:12+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"}]},{"item":{"id":"customer-references#state-of-minnesota","locale":"en_US","directoryId":"customer-references","name":"state-of-minnesota","dateCreated":"2019-07-19T15:12:36+0000","dateUpdated":"2022-01-21T02:39:46+0000","additionalFields":{"featured":"0","descriptionSummary":"Using the cloud, Minnesota IT Services (MNIT) gained the agility and automation it needs to quickly and efficiently deliver innovative services to the state\u0027s citizens. MNIT is the information-technology agency for the State of Minnesota\u0027s executive branch, serving 70 agencies, boards, and commissions within the state.","imageSrcUrl":"https://d1.awsstatic.com/WWPS/images/MN-Logo.050338707ce6cdd63dfcc516763070c8e5a19aad.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eUsing the cloud, Minnesota IT Services (MNIT) gained the agility and automation it needs to quickly and efficiently deliver innovative services to the state\u0026#39;s citizens. MNIT is the information-technology agency for the State of Minnesota?s executive branch, serving 70 agencies, boards, and commissions within the state. MNIT uses a variety of AWS services, including storage, compute, and automation to deliver its services as efficiently as possible.\u003c/p\u003e\r\n","industry":"Government","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/minnesota/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"State of Minnesota","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"State of Minnesota"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#industry#general-public-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"General Public Services","description":"General Public Services","dateCreated":"2020-01-16T17:42:24+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#pinsight-case-study","locale":"en_US","directoryId":"customer-references","name":"pinsight-case-study","dateCreated":"2019-07-19T15:12:29+0000","dateUpdated":"2021-12-22T19:24:16+0000","additionalFields":{"featured":"0","descriptionSummary":"Pinsight Media analyzed six months of mobile-carrier signal data—a process requiring 100,000 compute hours—in just eight days using AWS. Pinsight is a leading mobile data and insights company that offers customer modeling, analysis of brand affinity, competitive benchmarking, and market analysis.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/PinsightMedia_Customer-Reference_Logo.b7170c225478ec9638e9708af48a94afc728d5a4.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003ePinsight Media analyzed six months of mobile-carrier signal data\u0014a process requiring 100,000 compute hours\u0014in just eight days. Pinsight is a leading mobile data and insights company that offers customer modeling, analysis of brand affinity, competitive benchmarking, and market analysis. The company used Amazon EBS persistent block storage, Amazon EC2 Spot Instances, and Amazon EMR pipelines to ingest, analyze, and obtain insights from its customer\u0019s 900 TB dataset.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/pinsight/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Pinsight","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Pinsight Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"}]},{"item":{"id":"customer-references#intercom-case-study","locale":"en_US","directoryId":"customer-references","name":"intercom-case-study","dateCreated":"2019-07-19T15:15:42+0000","dateUpdated":"2021-12-22T19:21:51+0000","additionalFields":{"featured":"0","descriptionSummary":"Intercom designed, prototyped, tested, and deployed a stream-processing service in less than two weeks using an AWS serverless architecture. Intercom offers a suite of messaging-first products that integrate seamlessly with other companies\u0027 websites and mobile apps to help them acquire, engage with, and support their own customers.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Intercom_Customer-Reference_Logo.785400be77a04421b6829f869a140448508a7742.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eIntercom designed, prototyped, tested, and deployed a stream-processing service in under two weeks using an AWS serverless architecture.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/intercom/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Intercom","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Intercom Case Study"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US",