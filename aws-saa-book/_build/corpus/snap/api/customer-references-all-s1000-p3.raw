0000","dateUpdated":"2022-02-03T03:36:05+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#hongkong","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Hong Kong","description":"Hong Kong","dateCreated":"2020-02-03T05:29:18+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#aws-case-study-river-island","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-river-island","dateCreated":"2019-07-19T15:10:42+0000","dateUpdated":"2023-07-14T23:32:47+0000","additionalFields":{"featured":"0","descriptionSummary":"Founded in 1948, River Island is a leading U.K. high street fashion brand with 300 stores and a thriving digital business. Using AWS allows the company to innovate at speed and scale its systems to handle major demand peaks on Black Friday.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/RiverIsland_Customer-Reference_Logo.0f7dc8827f96f128565ba2aaf6695c78c36b99b2.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","description":"\u003cp\u003eWatch the River Island customer video case study, powered by the AWS Cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Retail","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/riverisland/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"River Island","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"AWS Case Study: River Island"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#uk","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United Kingdom","description":"United Kingdom","dateCreated":"2020-02-03T05:30:18+0000","dateUpdated":"2022-02-03T03:31:52+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"GLOBAL#industry#retail","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Retail","description":"Retail","dateCreated":"2020-01-16T17:42:39+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#location#ukir","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"UK/IR","description":"UK/IR","dateCreated":"2020-02-19T23:06:44+0000","dateUpdated":"2022-02-03T03:31:51+0000"},{"id":"GLOBAL#product#lex","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Lex","description":"Amazon Lex","dateCreated":"2020-03-02T07:04:21+0000","dateUpdated":"2022-02-03T03:32:47+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#viewfin-metaverse-case-study","locale":"en_US","directoryId":"customer-references","name":"viewfin-metaverse-case-study","dateCreated":"2019-07-19T15:11:17+0000","dateUpdated":"2023-07-14T23:32:46+0000","additionalFields":{"featured":"0","descriptionSummary":"With AWS, ViewFin Metaverse is able to build a secure, stable, and dependable blockchain-as-a-service (BaaS) platform to provide blockchain-based digital solutions to customers from a wide range of sectors including finance, business, art, and medical. ViewFin Metaverse is a fintech company focusing on blockchain technologies; its main offerings include Metaverse and Metaverse BaaS.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/China/yuanjie-logo.c3892cb3d8701ec8481321e6fdafb35de38e9822.jpg","displayLocation":"China","footerInfoText":"Published Date","description":"\u003cp\u003eWith AWS, ViewFin Metaverse is able to build a secure, stable, and dependable blockchain-as-a-service (BaaS) platform to provide blockchain-based digital solutions to customers from a wide range of sectors including finance, business, art, and medical. ViewFin Metaverse is a fintech company focusing on blockchain technologies; its main offerings include Metaverse and Metaverse BaaS. Amazon Web Services used by ViewFin Metaverse include Amazon EC2, Amazon S3, Amazon CloudWatch, Amazon DynamoDB, Amazon RDS, Amazon EMR, Amazon RedShift, Amazon Kinesis, Amazon Kinesis Firehose, Amazon ElastiCache, Amazon Elastic Container Registry (Amazon ECR), AWS IAM, and AWS Developer Support.\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/viewfin/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ViewFin Metaverse","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"ViewFin Metaverse Case Study"}},"tags":[{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+00