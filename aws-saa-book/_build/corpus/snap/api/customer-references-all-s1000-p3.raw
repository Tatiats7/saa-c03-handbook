egory#gaming","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Gaming","description":"Gaming","dateCreated":"2019-07-22T18:31:55+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#product#shield","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Shield","description":"AWS Shield","dateCreated":"2020-03-02T07:05:24+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#nikeqwedfg098543","locale":"en_US","directoryId":"customer-references","name":"nikeqwedfg098543","dateCreated":"2022-05-23T21:42:42+0000","dateUpdated":"2022-09-21T21:51:23+0000","additionalFields":{"featured":"0","descriptionSummary":"\u003cp\u003eGetting a graph database to be performant and easy to use is very different from making a NoSQL (non-relational) database high-performing. Listen in as Todd Escalona of AWS talks with Marc Wangenheim, Senior Engineering Manager at \u003ca href\u003d\"https://www.nike.com/\"\u003eNike\u003c/a\u003e, about how the company powers a number of applications via a social graph, built on \u003ca href\u003d\"https://aws.amazon.com/neptune/\"\u003eAmazon Neptune\u003c/a\u003e, which effectively maps millions of relationships among its users.\u003c/p\u003e\n","imageSrcUrl":"https://d1.awsstatic.com/industry/cpg/marketing/Nike.d080ad40d133c11543c66ceea664b0d7d254e4cd.png","displayLocation":"United States","customerNameLower":"nike","footerInfoText":"Published Date","industry":"Retail","sortDate":"2020-01-27","headlineUrl":"https://aws.amazon.com/blogs/architecture/nike-a-social-graph-at-scale-with-amazon-neptune/","customer-name":"Nike","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"Nike: A Social Graph at Scale with Amazon Neptune"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T1