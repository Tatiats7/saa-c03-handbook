nic-caregiver-case-study","locale":"en_US","directoryId":"customer-references","name":"electronic-caregiver-case-study","dateCreated":"2019-07-19T14:56:00+0000","dateUpdated":"2023-07-12T01:35:29+0000","additionalFields":{"featured":"0","descriptionSummary":"Electronic Caregiver is helping seniors age in place longer with Addison Care, a virtual caregiving solution built on AWS. The company is a leader in connected health and safety monitoring devices. Addison Care features an AR host built on Amazon Sumerian and relies on Amazon Lex for language understanding, Amazon Polly for text-to-speech, and Amazon DynamoDB for storing health markers as well as business-logic processes to be executed by AWS Lambda.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/ElectronicCaregiver_Customer-Reference_Logo.e2eec99978bdc90b1f62ce81ade7b9c3a82971a5.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eElectronic Caregiver is helping seniors age in place longer with Addison Care, a virtual caregiving solution built on AWS. The company is a leader in connected health and safety monitoring devices. Addison Care features an AR host built on Amazon Sumerian and relies on Amazon Lex for language understanding, Amazon Polly for text-to-speech, and Amazon DynamoDB for storing health markers as well as business-logic processes to be executed by AWS Lambda.\u003c/p\u003e\r\n","industry":"Healthcare","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/electronic-caregiver/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Electronic Caregiver","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Electronic Caregiver Case Study"}},"tags":[{"id":"GLOBAL#product#polly","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Polly","description":"Amazon Polly","dateCreated":"2020-03-02T07:04:53+0000","dateUpdated":"2022-02-03T03:32:54+0000