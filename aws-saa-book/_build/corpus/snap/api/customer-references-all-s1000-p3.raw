ublic-case-study","locale":"en_US","directoryId":"customer-references","name":"rwe-czech-republic-case-study","dateCreated":"2019-07-22T19:49:01+0000","dateUpdated":"2023-07-12T01:40:46+0000","additionalFields":{"featured":"0","descriptionSummary":"By using Amazon Web Services, RWE Czech Republic is enabling growth, improving IT services to the business, and reducing operational expenses by 12 percent compared to its previous data center environment. As part of Europe-wide RWE Group, the firm operates gas and electricity services across the Czech Republic.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/rwe-logo.49fa1b73d5b62d9ac17d037e79784c0c4a148a7b.png","displayLocation":"Central \u0026 Eastern Europe","footerInfoText":"Published Date","description":"\u003cp\u003eRead the RWE Czech Republic customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Power \u0026 Utilities","sortDate":"2016-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/rwe/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"RWE Czech Republic","enableShare":"1","publishedDate":"2016","contentType":"Customer Story","headline":"RWE Czech Republic Case Study"}},"tags":[{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#cee","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central \u0026 Eastern Europe","description":"Central \u0026 Eastern Europe","dateCreated":"2020-03-10T05:12:39+0000","dateUpdated":"2022-02-03T0