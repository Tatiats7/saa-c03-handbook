ated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"}]},{"item":{"id":"customer-references#siemens-power-gas","locale":"en_US","directoryId":"customer-references","name":"siemens-power-gas","dateCreated":"2020-03-26T20:47:54+0000","dateUpdated":"2023-07-19T03:05:04+0000","additionalFields":{"featured":"0","descriptionSummary":"Siemens Power and Gas division was looking for ways to accelerate its data-analytics and customer-digitalization projects. After choosing Amazon Redshift, it wanted to build out the solution with best-in-class software. A search through AWS Marketplace led Siemens to run a free trial of Matillion ETL for Amazon Redshift, which took less than one hour to try, buy and implement within their existing AWS environments.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Siemens_Customer-Reference_Logo%401x.bb038521df5899223d4bd8364182c2fc69ef288d.png","displayLocation":"Germany","footerInfoText":"Published Date","industry":"Power \u0026 Utilities","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/siemens-marketplace-casestudy/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Siemens Power \u0026 Gas","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Siemens Uses Matillion ETL for Amazon Redshift to Build Out Its Software Quickly"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#custo