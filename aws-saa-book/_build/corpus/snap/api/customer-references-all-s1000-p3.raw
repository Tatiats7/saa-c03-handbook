2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#efs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic File System (EFS)","description":"Amazon Elastic File System (EFS)","dateCreated":"2020-03-02T07:02:57+0000","dateUpdated":"2022-02-03T03:32:32+0000"}]},{"item":{"id":"customer-references#aws-case-study-the-washington-post-arc-publishing","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-the-washington-post-arc-publishing","dateCreated":"2019-07-19T14:58:53+0000","dateUpdated":"2021-12-22T18:46:53+0000","additionalFields":{"featured":"0","descriptionSummary":"Arc Publishing (Arc) is a software-as-a-service (SaaS) platform built by the Washington Post that lets any media company take advantage of the scalable, flexible publishing platform The Washington Post built for its own newsroom. Arc is built as containerized microservices running on AWS. Docker containers and Amazon Elastic Container Service were critical in enabling the Washington Post to expand Arc into a multi-tenant architecture, scale rapidly, and increase the speed of development.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/TheWashingtonPost_Customer-Reference_Logo.2ddd9267bea94c883dbd0ee263f9a74bc368c31c.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eLearn how The Washington Post built the Arc Publishing Platform, powered by AWS.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/washington-post-arc/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"The Washington Post (Arc Publishing)","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"AWS Case Study: The Washington Post Arc Publishing"}},"tags":[{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"customer-references#category#dev-and-test","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dev \u0026 Test","description":"Dev \u0026 Test","dateCreated":"2019-07-22T18:31:47+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#containers","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Containers","description":"Containers","dateCreated":"2020-02-13T00:27:17+0000","dateUpdated":"2022-02-03T03:35:26+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#category#saas","locale":"en_US","tagNamespaceId":"customer-references#category","name":"SaaS","description":"SaaS","dateCreated":"2019-07-22T18:32:20+0000","dateUpdated":"2022-02-19T05:00:37+0000"}]},{"item":{"id":"customer-references#peloton-case-study","locale":"en_US","directoryId":"customer-references","name":"peloton-case-study","dateCreated":"2019-07-19T15:11:51+0000","dateUpdated":"2021-12-22T18:45:14+0000","additionalFields":{"videoSrcUrl":"https://youtu.be/HvFPL4XsCZ8","featured":"0","descriptionSummary":"In-home fitness company Peloton relies on AWS to power its on-demand, live leaderboard. Peloton\u0027s leaderboard requires high elasticity, low latency, and real-time processing to deliver customizable rider data for the community of users riding together virtually from the comfort of their homes.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Peloton_Customer-Reference_Logo.1000edd039ca06eed43df1331413d9a61f2dda83.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eYony Feng, CTO of Peloton, describes how the in-home fitness company relies on AWS to power its on-demand, live leaderboard. Peloton\u0019s leaderboard requires high elasticity, low latency, and real-time processing to deliver customizable rider data for the community of users riding together virtually from the comfort of their home.\u003c/p\u003e\r\n","industry":"Healthcare","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/Peloton/?did\u003dcr_card\u0026trk\u003dcr_card-cr_card","customer-name":"peloton","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Peloton Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"customer-references#category#infrastructure","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Infrastructure","description":"Infrastructure","dateCreated":"2019-07-22T18:32:04+0000","dateUpdated":"2022-02-19T04:21:23+0000"}]},{"item":{"id":"customer-references#supercell-video","locale":"en_US","directoryId":"customer-references","name":"supercell-video","dateCreated":"2020-11-09T18:08:45+0000","dateUpdated":"2021-12-23T00:08:51+0000","additionalFields":{"descriptionSummary":"Supercell is a mobile games company founded in 2010 in Helsinki, Finland. It has offices in the United States, China, Japan, Korea, and Denmark. Supercell has 100 million daily active users with 4 million concurrent players at peak times, producing 500 TB of data a day.In this video, Heikki Verta, head of engineering at Supercell, explains how its 20-person game teams run some of the world’s most popular titles, including Clash of Clans and Boom Beach. The teams have a high degree of autonomy over the games they build and maintain. On the Clash of Clans team, 3 server developers maintain more than 2,000 Amazon Elastic Compute Cloud (Amazon EC2) instances and 300 MySQL databases, as well as developing the game. They achieve this with loosely coupled, well-architected microservices, using infrastructure as code to automate scaling and recovery. The company also makes use of managed services like Amazon DynamoDB where possible, so teams spend less time on infrastructure administration.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Supercell_Customer-Reference_Logo@1x.d4c21872cf2d746f7d9257325c0c220c294d904e.png","displayLocation":"Finland","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/supercell-video/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"How Supercell Runs Giant Games with Tiny Teams on AWS","customer-name":"Supercell"}},"tags":[{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#dev-and-test","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dev \u0026 Test","description":"Dev \u0026 Test","dateCreated":"2019-07-22T18:31:47+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","descriptio