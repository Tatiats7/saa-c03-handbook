cale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Email Service (SES)","description":"Amazon Simple Email Service (SES)","dateCreated":"2020-03-02T07:05:22+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#methodology#devops","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"DevOps","description":"DevOps","dateCreated":"2020-06-05T07:06:27+0000","dateUpdated":"2022-02-03T03:32:10+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#saas","locale":"en_US","tagNamespaceId":"customer-references#category","name":"SaaS","description":"SaaS","dateCreated":"2019-07-22T18:32:20+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#devops","locale":"en_US","tagNamespaceId":"customer-references#category","name":"DevOps","description":"DevOps","dateCreated":"2019-07-22T18:31:49+0000","dateUpdated":"2022-03-05T03:54:11+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#customer-snapshot-blackboard-aws-lambda","locale":"en_US","directoryId":"customer-references","name":"customer-snapshot-blackboard-aws-lambda","dateCreated":"2019-07-19T15:15:37+0000","dateUpdated":"2022-12-19T23:23:19+0000","additionalFields":{"featured":"0","descriptionSummary":"Blackboard will easily scale its applications worldwide and put new learning tools into educators\u0026#39; hands faster than before by going all in on AWS. The company\u0026#39;s focus is on technologies and services that enable student and institutional success across the globe.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Blackboard_Customer-Reference_Logo.5843214d78364555b7a920bd7e563e05075333a3.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eAcross the world, in thousands of classrooms, Blackboard educational technology enables instruction, collaboration, and online learning. In 2015, the company started to migrate the software-as-a-service (SaaS) version of its Blackboard Learn application to the Amazon Web Services (AWS) Cloud. Since then, the company has been aggressively adopting AWS technologies to further its innovation agenda. ?As we architect and develop new offerings, standardizing on the AWS environment enables us to improve developer efficiency, reduce time-to-market, and speed innovations to our customers,? says Tim Tomlinson, chief product officer at Blackboard. Testing is a critical part of this value chain. To help students learn and teachers teach, Blackboard must deliver an integrated, intuitive, consistent user experience. That means experiential testing that mimics how a user would progress through an application from any given web browser. At first, the company performed these tests manually, which could mean days for each testing run. In 2007, the company began using Selenium WebDriver to perform automated cross-browser UI testing, which greatly accelerated the process. Since that time, Blackboard has moved to a continuous-delivery approach, meaning that each time a change is committed to a code branch, it triggers the test suite. The company needed to improve testing speeds even further. It started by implementing Selenium Grid to enable parallel execution of test suites packaged in Docker containers, which got test execution down to 16 minutes. However, this configuration could not easily scale beyond eight concurrent threads. Then the team decided to package the testing suite into an AWS Lambda serverless compute function, enabling it to execute tests in parallel at any scale required. A custom JUnit test runner triggers testing and aggregates results. ?This is not just automated unit testing?we are automating user experience testing end-to-end,? says Jason Kagel, vice president of productivity at Blackboard. ?Using AWS Lambda, we can deliver value to our customers at a quicker pace, and with a high degree of confidence that the application will work seamlessly for users.? The solution not only enables more in-depth testing, but it has also greatly reduced testing times. ?It was previously taking us hours to execute end-to-end test suites,? says Kagel. ?With the solution we built on AWS, that?s down to 30 seconds. We have rolled out this capability to our flagship applications and are deploying it across the organization. It?s a fundamental shift toward a DevOps culture of continuous integration.?\u003c/p\u003e\r\n","industry":"Education","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/blackboard/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Blackboard","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Blackboard Case Study"}},"tags":[{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#use-case#datacenter-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2020-08-18T05:17:48+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#electronics","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Electronics","description":"Electronics","dateCreated":"2020-06-25T04:07:00+0000","dateUpdated":"2022-02-03T03:32:02+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"}]},{"item":{"id":"customer-references#smithsonian-institution-case-study","locale":"en_US","directoryId":"customer-references","name":"smithsonian-institution-case-study","dateCreated":"2019-07-22T19:43:18+0000","dateUpdated":"2023-07-12T01:35:37+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, the Smithsonian Institution Data Science Team can scale instances up and down as needed, allowing the team to annotate genomes in parallel while also managing costs. The Smithsonian Data Science Team\u0027s mission is to implement solutions that will accelerate science and lower the bar for entry to genomics research, not only for Smithsonian scientists but for biodiversity researchers in general.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/SmithsonianInstitution_Customer-Reference_Logo.8adc257cd1db7d19b7e00f5b2d6c16e4a39df08f.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eThe cloud has enabled the Smithsonian Institution to share their research and increase knowledge through open data science.\u003c/p\u003e\r\n","industry":"Life Sciences","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/smithsonian-institution/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Smithsonian Institution","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Smithsonian Institution Case Study"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#dev-and-test","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dev \u0026 Test","description":"Dev \u0026 Test","dateCreated":"2019-07-22T18:31:47+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name