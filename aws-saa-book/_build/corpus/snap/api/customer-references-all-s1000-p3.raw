Updated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#spain","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Spain","description":"Spain","dateCreated":"2020-02-03T05:30:16+0000","dateUpdated":"2022-02-03T03:31:49+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#use-case#high-perform-compute","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"High Performance Compute","description":"High Performance Compute","dateCreated":"2020-06-05T06:37:26+0000","dateUpdated":"2022-02-03T03:35:41+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#efs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic File System (EFS)","description":"Amazon Elastic File System (EFS)","dateCreated":"2020-03-02T07:02:57+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#veolia-water-case-study","locale":"en_US","directoryId":"customer-references","name":"veolia-water-case-study","dateCreated":"2019-07-19T17:08:41+0000","dateUpdated":"2023-07-12T01:40:48+0000","additionalFields":{"featured":"0","descriptionSummary":"Veolia Water Technologies reduces operating costs by 90 percent and accesses new opportunities for innovation using AWS. Veolia offers its eight million customers a full range of technologies and services in the design and construction, operation, maintenance, modernization, and management of water-treatment and sanitation systems.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/VeoliaWaterTech_Customer-Reference_Logo.8009e181bbbe0b8dda36a09ab0b7e42d820ed4ee.png","displayLocation":"France","footerInfoText":"Published Date","description":"\u003cp\u003eVeolia Water Technologies reduces operating costs by 90 percent and accesses new opportunities for innovation using AWS. Veolia offers its eight million customers a full range of technologies and services in the design and construction, operation, maintenance, modernization, and management of water-treatment and sanitation systems. After searching for private cloud solutions and faced with the rigidity of this type of structure, Veolia Water France turned to AWS and the public cloud, allowing it to set up virtual data centers and operate its systems without any constraints.\u003c/p\u003e\r\n","industry":"Power \u0026 Utilities","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/veolia-water/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Veolia Water","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Veolia Water Case Study"}},"tags":[{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#industry#power-utilities","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Power \u0026 Utilities","description":"Power \u0026 Utilities","dateCreated":"2020-01-16T17:42:37+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#use-case#website-hosting","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Website Hosting","description":"Website Hosting","dateCreated":"2020-06-05T07:07:19+0000","dateUpdated":"2022-02-03T03:36:03+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#use-case#datacenter-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2020-08-18T05:17:48+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#category#web-hosting","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Web Hosting","description":"Web Hosting","dateCreated":"2019-07-22T18:32:28+0000","dateUpdated":"2022-03-30T20:30:49+0000"},{"id":"GLOBAL#industry#energy","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Energy","description":"Energy","dateCreated":"2020-07-15T21:58:51+0000","dateUpdated":"2022-02-03T03:32:02+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#industry#oil-gas","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Oil \u0026 Gas","description":"Oil \u0026 Gas","dateCreated":"2020-01-16T17:42:36+0000","dateUpdated":"2022-02-03T03:32:07+0000"}]},{"item":{"id":"customer-references#cimri-case-study","locale":"en_US","directoryId":"customer-references","name":"cimri-case-study","dateCreated":"2019-07-22T17:10:00+0000","dateUpdated":"2023-07-14T23:32:36+0000","additionalFields":{"featured":"0","descriptionSummary":"By using AWS, Cimri can easily scale to meet traffic demands, avoid downtime, and improve user experience. The Turkey-based firm operates a price and product comparison website.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Cimri_Customer-Reference_Logo.538765810c4d0f1b75d63fc9e620de5d36b4a1b4.png","displayLocation":"Turkey","footerInfoText":"Published Date","description":"\u003cp\u003eBy using Amazon Web Services (AWS), Cimri can easily scale to meet traffic demands, avoid downtime, and improve user experience. The Turkey-based firm operates a price and product comparison website. It chose to move to AWS to run the entire infrastructure supporting its comparison engine, and currently uses Amazon Kinesis, the Amazon OpenSearch Service, and Amazon Relational Database Service.\u003c/p\u003e\n","industry":"Software \u0026 Internet","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/cimri/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Cimri","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Cimri Case Study"}},"tags":[{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name