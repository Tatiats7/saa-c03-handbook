,"tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#aws-case-study-weintek","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-weintek","dateCreated":"2019-07-19T14:56:10+0000","dateUpdated":"2022-09-13T22:44:50+0000","additionalFields":{"featured":"0","descriptionSummary":"Weintek integrates Internet of Things capabilities into its HMI service to help customers optimize machine performance. Weintek manufactures human-machine interfaces (HMIs), which allow people to control machine processes and monitor performance through a touchscreen interface.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Weintek_Customer-Reference_Logo.34977121d2ff079f0d9c1e77aff5e2bc8754d893.png","displayLocation":"Italy","footerInfoText":"Published Date","description":"\u003cp\u003eWeintek integrates Internet of Things (IoT) capabilities into its HMI service to help customers optimize machine performance. Weintek manufactures human-machine interfaces (HMIs), which allow people to control machine processes and monitor performance through a touchscreen interface. Weintek uses AWS IoT Core to enable the IoT capabilities of HMI and EasyAccess 2.0, with Amazon EC2 instances supporting web and authentication services.\u003c/p\u003e\r\n","industry":"Manufacturing","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/weintek/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Weintek","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"AWS Case Study - Weintek"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_U