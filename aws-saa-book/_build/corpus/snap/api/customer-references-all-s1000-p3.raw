to-end digital business platform—based on open standards, with integration, process management, adaptive application development, real-time analytics and enterprise architecture management as core building blocks—to help customers build digital futures today.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Software_Customer-Reference_Logo.3d9a63c8722fd84f12577c04b6676ad678d6e5b6.png","displayLocation":"Germany","footerInfoText":"Published Date","description":"\u003cp\u003eWatch the Software AG customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2017-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/software-ag/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Software AG","enableShare":"1","publishedDate":"2017","contentType":"Customer Story","headline":"Software AG Case Study"}},"tags":[{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#location#germany","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Germany","description":"Germany","dateCreated":"2020-02-03T05:29:55+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u