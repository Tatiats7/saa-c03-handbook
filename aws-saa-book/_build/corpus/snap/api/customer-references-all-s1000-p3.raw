rise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"IoT","description":"IoT","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2022-02-03T03:35:28+0000"}]},{"item":{"id":"customer-references#maryland-dhs-case-study","locale":"en_US","directoryId":"customer-references","name":"maryland-dhs-case-study","dateCreated":"2020-05-12T19:10:30+0000","dateUpdated":"2022-08-30T01:47:07+0000","additionalFields":{"featured":"0","featureImageURL":"https://d1.awsstatic.com/aws-key-pages/homepage-key-pages/customer-stories-logo/Maryland%20Department%20of%20Human%20Services.8b024b9d1540a6701a93de9bc259fede8576af28.jpg","descriptionSummary":"The Maryland Department of Human Services (DHS) uses AWS to host a new social services delivery platform that drives cross-agency collaboration, improves service delivery to state residents, ensures data integrity, and reduces costs. The organization, through its 24 local departments of social services, provides critical services to more than 2 million residents annually. DHS uses services including Amazon EC2 and Amazon ECS to build and host MD THINK, a secure human services platform.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/dhs@1x.a39dd88832e51b5b376aa99ba084a2dc9654c30e.jpg","displayLocation":"Americas","customerNameLower":"maryland department of human services","footerInfoText":"Published Date","description":"\u003cp\u003eDelivering integrated health and human services programs to vulnerable residents\u003c/p\u003e\n","industry":"General Public Services","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/maryland-dhs/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Maryland Department of Human Services","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"State of Maryland Transforms Social Services Using AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCreated":"2020-08-20T04:28:43+0000","dateUpdated":"2022-02-03T03:36:00+0000"},{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Websites \u0026 Apps","description":"Websites \u0026 Apps","dateCreated":"2019-07-22T18:32:30+0000","dateUpdated":"2022-03-05T03:54:13+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#homepage-industry#general-public-services","locale":"en_US","tagNamespaceId":"customer-references#homepage-industry","name":"General Public Services","description":"General Public Services","dateCreated":"2022-08-24T22:33:39+0000","dateUpdated":"2022-08-24T22:33:39+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance",