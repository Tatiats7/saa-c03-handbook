"GLOBAL#workload","name":"SAP","description":"SAP","dateCreated":"2021-01-06T00:09:56+0000","dateUpdated":"2022-02-03T03:36:05+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#elb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Elastic Load Balancing (ELB)","description":"Elastic Load Balancing (ELB)","dateCreated":"2020-03-02T07:03:09+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#prof-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Professional Services","description":"Professional Services","dateCreated":"2020-06-25T04:07:49+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#efs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic File System (EFS)","description":"Amazon Elastic File System (EFS)","dateCreated":"2020-03-02T07:02:57+0000","dateUpdated":"2022-02-03T03:32:32+0000"}]},{"item":{"id":"customer-references#aws-case-study-pacific-life-insurance","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-pacific-life-insurance","dateCreated":"2019-07-22T19:53:07+0000","dateUpdated":"2021-12-22T18:53:03+0000","additionalFields":{"featured":"0","descriptionSummary":"Pacific Life Insurance provides financial services and products to individuals, businesses, and pension plans. The company turned to AWS for its hybrid IT strategy, using the AWS Cloud in combination with data centers in California and Nebraska to run actuarial workloads used to set insurance pricing and create new product offerings. Using AWS, Pacific Life can quickly scale its compute capacity with less cost and IT overhead compared to adding new hardware to its own data centers.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/PacificLifeInsurance_Customer-Reference_Logo.8463fb821cfceaa9776b1e9dcac3be7522ecb21f.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003ePacific Life Insurance provides financial services and products to individuals, businesses, and pension plans. The company turned to AWS for its hybrid IT strategy, using the AWS cloud in combination with data centers in California and Nebraska to run actuarial workloads used to set insurance pricing and create new product offerings. Using AWS, Pacific Life can quickly scale its compute capacity with less cost and IT overhead compared to adding new hardware to its own data centers.\u003c/p\u003e\r\n","industry":"Financial Services","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/pacific-life-insurance/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Pacific Life Insurance","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Pacific Life Insurance"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#aws-case-study-itv","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-itv","dateCreated":"2019-07-22T19:50:44+0000","dateUpdated":"2021-12-22T19:49:51+0000","additionalFields":{"featured":"0","descriptionSummary":"ITV is a commercial television network in the United Kingdom that operates regional TV services and provides programming that is shared across its network of channels. The company\u0027s digital services division moved from a legacy IT infrastructure to AWS to run its test and production environments. By using AWS, ITV can experiment with new services using a cloud infrastructure it designed and deployed in about four weeks.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/ITV_Customer-Reference_Logo.16479658693855d31b692e2c21205cbcffb867f3.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","description":"\u003cp\u003eITV is a commercial television network in the UK that operates regional TV services and provides programming that is shared across its network of channels. The company?s digital services division moved from a legacy IT infrastructure to AWS to run its test and production environments. By using AWS, ITV has the agility to experiment with new services using a cloud infrastructure it designed and deployed in about four weeks.\u003c/p\u003e\r\n","industry":"Media \u0026 Entertainment","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/itv/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ITV","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: ITV"}},"tags":[{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12T02:01:29+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"E