 AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#bicevida","locale":"en_US","directoryId":"customer-references","name":"bicevida","dateCreated":"2023-06-01T23:09:43+0000","dateUpdated":"2023-06-08T04:07:35+0000","additionalFields":{"descriptionSummary":"Con casi 30 años de operación en Chile, Bice Vida es una compañía de seguros y servicios financieros personales y empresariales caracterizada por ofrecer tecnología de punta a sus clientes. Para esto, desarrolla aplicaciones dirigidas a optimizar permanentemente el servicio y la atención a sus asegurados.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/bicevida_logo%401x.f441eaeca02419ca8e3dad165309935db6d46606.png","displayLocation":"Chile","footerInfoText":"Fecha de publicación","industry":"Servicios financieros","sortDate":"2018-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/bicevida/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2018","contentType":"Historia del cliente","customer-name":"Bicevida","headline":"Caso práctico de Bice Vida"}},"tags":[{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId