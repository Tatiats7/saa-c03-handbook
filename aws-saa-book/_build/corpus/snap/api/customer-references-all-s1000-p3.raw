07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#copaairlines-en-from-es-directory","locale":"en_US","directoryId":"customer-references","name":"copaairlines-en-from-es-directory","dateCreated":"2024-02-03T03:46:38+0000","dateUpdated":"2024-02-06T01:35:39+0000","additionalFields":{"descriptionSummary":"Founded in 1947, Copa Airlines is a Panamanian airline, headquartered in Panama City. With a current fleet of 100 aircraft, the company runs 350 flights each day, carrying 16 million passengers annually. Copa Airlines chose to migrate its on-premises infrastructure to Amazon Web Services (AWS) to gain scalability and reduce latency. As a result, the airline has digitally transformed to deliver easier mobile booking and improve customer interactions.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/copaairlines-logo@1x.0e0cf0f2498e0a8a509352a31167e0293f8c3a78.png","displayLocation":"Latin America","footerInfoText":"Published Date","industry":"Travel \u0026 Hospitality","sortDate":"2020-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/solutions/case-studies/copa-airlines-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2020","contentType":"Customer Story","customer-name":"Copa Airlines","headline":"Copa Airlines Accelerates Its Operations on AWS"}},"tags":[{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"customer-references#category#websites-apps","locale":"en_US","tagNamespaceId":"customer-references#category","n