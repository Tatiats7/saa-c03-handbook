"description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#aws-case-study-ivy-tech-community-college-of-indiana","locale":"en_US","directoryId":"customer-references","name":"aws-case-study-ivy-tech-community-college-of-indiana","dateCreated":"2019-07-22T19:51:32+0000","dateUpdated":"2022-01-21T02:41:45+0000","additionalFields":{"featured":"0","descriptionSummary":"Ivy Tech Community College of Indiana is the largest community college in the United States. The college uses Amazon Redshift and Amazon S3 to run analytics tools to glean insights from more than 1.7 million student records, and then archives data in Amazon Glacier.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/IvyTechCommunityCollegeofIndiana_Customer-Reference_Logo.1d81c9990ecda1dee150189f01cfd2ca5fd4b388.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eIvy Tech Community College of Indiana is the largest community college in the United States. The college uses Amazon Redshift and Amazon Simple Storage Service to run analytics tools to glean insights from more than 1.7 million student records, and then archives data in Amazon Glacier. With the AWS solution, Ivy Tech can meet its petabyte-scale data needs while avoiding unnecessary IT expenses.\u003c/p\u003e\r\n","industry":"Education","sortDate":"2015-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ivy-tech-community-college-of-indiana/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ivy Tech Community College of Indiana","enableShare":"1","publishedDate":"2015","contentType":"Customer Story","headline":"AWS Case Study: Ivy Tech Community College of Indiana"}},"tags":[{"id":"GLOBAL#product#glacier","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon S3 Glacier","description":"Amazon S3 Glacier","dateCreated":"2020-03-02T07:03:38+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"customer-references#category#dev-and-test","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Dev \u0026 Test","description":"Dev \u0026 Test","dateCreated":"2019-07-22T18:31:47+0000","dateUpdated":"2022-03-17T20:28:41+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagName