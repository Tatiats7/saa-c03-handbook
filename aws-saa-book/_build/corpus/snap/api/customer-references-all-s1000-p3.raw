16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#australia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia","description":"Australia","dateCreated":"2020-02-03T05:29:12+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#innovator#canva","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Canva","description":"Canva","dateCreated":"2022-09-15T00:48:23+0000","dateUpdated":"2022-09-15T00:48:23+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#swire-coca-cola-case-study","locale":"en_US","directoryId":"customer-references","name":"swire-coca-cola-case-study","dateCreated":"2020-05-12T19:17:47+0000","dateUpdated":"2023-07-19T03:04:58+0000","additionalFields":{"featured":"0","descriptionSummary":"After deciding on its strategy to pursue a cloud computing–based digital transformation, Swire Coca-Cola made another bold decision to close its three on-premises production and disaster recovery data centers and migrate all of its business systems, including SAP and its CRM, to AWS. Swire Coca-Cola, a division of Swire, has the exclusive right to manufacture, market, and distribute products of the Coca-Cola Company in 11 Chinese provinces, the Shanghai Municipality, Hong Kong, Taiwan, and also an extensive area of the western US—representing a total customer base of 728 million people.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/coca-cola-logo%401x.4c9be67ec52d063bf4c44c482d50900e4bad7129.png","displayLocation":"China","footerInfoText":"Published Date","industry":"Consumer Goods","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/swire-coca-cola/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Swire Coca-Cola","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Swire Coca-Cola Case Study"}},"tags":[{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39: