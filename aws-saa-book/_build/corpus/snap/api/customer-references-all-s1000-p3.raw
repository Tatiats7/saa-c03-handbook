as al día y en épocas de alta concurrencia.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/uvm_logo%401x.ba996c1c96faafbe1f8ff9210494afbc6ce26d7c.png","displayLocation":"México","customerNameLower":"uvm - universidad del valle de mexico","footerInfoText":"Fecha de publicación","industry":"Educación","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/uvm/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"UVM - Universidad del Valle de Mexico","enableShare":"1","publishedDate":"2018","contentType":"Historia del cliente","headline":"Caso de Éxito: UVM"}},"tags":[{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":