0","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#fatture-in-cloud-case-study","locale":"en_US","directoryId":"customer-references","name":"fatture-in-cloud-case-study","dateCreated":"2019-07-19T14:59:00+0000","dateUpdated":"2023-07-14T23:32:44+0000","additionalFields":{"featured":"0","descriptionSummary":"Fatture in Cloud migrated from its existing cloud provider to AWS to improve performance by 100 percent, deliver a highly reliable service to customers, and reduce costs by 50 percent. Based in Italy, the company provides customers with invoicing and billing services 24/7 from any device—disrupting a largely traditional market by offering features such as real-time access to data.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/FattureInCloud_Customer-Reference_Logo.b24e41ce3224de95876559d30ebb1f4f1eaf7c14.png","displayLocation":"Italy","footerInfoText":"Published Date","description":"\u003cp\u003eRead the Fatture in Cloud customer case study, powered by the AWS Cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/fatture-in-cloud/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Fatture in Cloud","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Fatture in Cloud Case Study"}},"tags":[{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","da