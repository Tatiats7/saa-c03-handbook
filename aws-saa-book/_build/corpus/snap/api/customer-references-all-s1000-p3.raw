-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"}]},{"item":{"id":"customer-references#habitalia","locale":"en_US","directoryId":"customer-references","name":"habitalia","dateCreated":"2023-06-01T23:11:18+0000","dateUpdated":"2023-06-08T04:07:33+0000","additionalFields":{"descriptionSummary":"Habitalia nació como brazo de consultoría de una Organización No Gubernamental (ONG) llamada Observatorio del Derecho a la Vivienda. La empresa era responsable de desarrollar herramientas para análisis de datos y predicción de riesgos para las comunidades, siempre con la finalidad de sustentar recomendaciones de política pública en la materia del derecho a la vivienda. Actualmente, Habitalia gestiona 15 proyectos de virtualización en la infraestructura AWS para sus clientes, y puede entregar herramientas analíticas eficientes, capaces de contribuir con las comunidades y las organizaciones en la sociedad civil.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/Latam%20Cases%20Assets/Habitalia_LOGO.b461f725c285399739a3c133cc26b292bdec86bb.png","displayLocation":"Latinoamérica","footerInfoText":"Fecha de publicación","industry":"Servicios públicos generales","sortDate":"2019-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/