n":"Data Lakes","dateCreated":"2020-06-05T06:37:09+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#location#belarus","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Belarus","description":"Belarus","dateCreated":"2020-04-09T03:35:24+0000","dateUpdated":"2022-02-03T03:31:46+0000"},{"id":"customer-references#category#data-lakes-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Data Lakes \u0026 Analytics","description":"Data Lakes \u0026 Analytics","dateCreated":"2019-07-22T18:31:39+0000","dateUpdated":"2022-02-07T13:55:55+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#northmill-bank-case-study","locale":"en_US","directoryId":"customer-references","name":"northmill-bank-case-study","dateCreated":"2020-09-25T16:51:09+0000","dateUpdated":"2023-07-14T23:32:47+0000","additionalFields":{"descriptionSummary":"Northmill Bank uses AWS to launch online banking services three times faster than in an on-premises environment. Based in Sweden, Northmill is a fast-growing neobank dedicated to improving people’s finances through innovation. The organization runs its financial applications and website on AWS, using AWS Lambda for serverless compute capabilities.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Northmill_Bank_Customer-Reference_Logo@x1.c673dee9ec8e206035ab3a4da00d4749d95ef3d4.png","displayLocation":"Sweden","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/northmill-bank-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","customer-name":"Northmill Bank","contentType":"Customer Story","headline":"Northmill Bank Goes Live Three Times Faster Using AWS"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOB