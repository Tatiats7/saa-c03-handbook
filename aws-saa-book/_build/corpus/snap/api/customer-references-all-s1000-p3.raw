erences","name":"california-polytechnic-state-university-case-study","dateCreated":"2019-07-19T14:57:18+0000","dateUpdated":"2021-12-22T18:48:03+0000","additionalFields":{"featured":"0","descriptionSummary":"California Polytechnic State University (Cal Poly) is one of the top engineering schools in the nation, but the university was struggling with legacy technology that put data at risk. The university invested in cloud-based training for its IT staff and decided to go all in on the AWS Cloud, breaking free from a lift-and-shift mentality, and found success in adopting a people-first, technology-second strategy.","imageSrcUrl":"https://d1.awsstatic.com/logos/customers/Cal%20Poly.a84c69e5634de7ecbf9ef51919e5fbe571e523a1.jpg","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eRead the Cal Poly customer case study, powered by the AWS cloud. AWS provides cloud computing services to hundreds of thousands of customers.\u003c/p\u003e\r\n","industry":"Education","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/cal-poly/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"California Polytechnic State University","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"California Polytechnic State University Case Study"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12T02:01:29+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"}]},{"item":{"id":"customer-references#photobox-case-study","locale":"en_US","directoryId":"customer-references","name":"photobox-case-study","dateCreated":"2019-07-19T15:12:21+0000","dateUpdated":"2021-12-22T19:28:29+0000","additionalFields":{"featured":"0","descriptionSummary":"By migrating from its EMC Isilon and IBM Cleversafe on-premises storage arrays to Amazon S3 using AWS Snowball Edge, Photobox saved a significant amount on costs on storage for its 10 PB of photo storage. Photobox is an online, personalized photo-products company that serves millions of customers each year in over ten markets.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Photobox_Customer-Reference_Logo.96cdd4c471daaaaece0dc41d4e01833223631554.png","displayLocation":"United Kingdom","footerInfoText":"Published Date","description":"\u003cp\u003ePhotobox wanted to get out of the business of owning and maintaining its own IT infrastructure so it could redeploy resources toward innovation in artificial intelligence and other areas to create a better customer experience. Photobox is an online, personalized photo-products company that serves millions of customers each year in over ten markets. By migrating from its EMC Isilon and IBM Cleversafe on-premises storage arrays to Amazon S3 using AWS Snowball Edge, Photobox saved a signficant amount on costs on storage for its 10 PB of photo storage. Photobox can now focus its resources on developing technology that helps customers build better photobooks more quickly, instead of maintaining legacy IT infrastructure.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/photobox/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Photobox","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Photobox Case Study"}},"tags":[{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#uk","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United Kingdom","description":"United Kingdom","dateCreated":"2020-02-03T05:30:18+0000","dateUpdated":"2022-02-03T03:31:52+0000"},{"id":"GLOBAL#use-case#datacenter-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2020-08-18T05:17:48+0000","dateUpdated":"2022-02-03T0