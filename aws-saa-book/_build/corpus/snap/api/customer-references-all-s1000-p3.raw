mbda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"customer-references#category#web-hosting","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Web Hosting","description":"Web Hosting","dateCreated":"2019-07-22T18:32:28+0000","dateUpdated":"2022-03-30T20:30:49+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#deutsche-borse-case-study","locale":"en_US","directoryId":"customer-references","name":"deutsche-borse-case-study","dateCreated":"2020-11-09T18:04:04+0000","dateUpdated":"2023-07-19T03:04:47+0000","additionalFields":{"descriptionSummary":"Deutsche Börse Group is an international exchange organization and market infrastructure provider. Its exchange handles 150 million deals each month and the group manages assets worth 11 trillion Euros.In 2015, the company saw that it needed faster, more agile ways to develop software features and products. It restructured teams around products and, with help from Amazon Web Services (AWS), upskilled 700 people for the cloud within a year.The move to AWS has allowed developers to access previously unavailable resources so they can experiment with technologies like serverless computing and big data to develop better software. The group also benefits from the scale and transparency of AWS.In this video, Thomas Aidan Curran, innovation and technology advisor at Deutsche Börse Group, explains how the group transformed its organization and technology using AWS.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/emea-customer-references/emea-directory-customer-logos/Deutsche-Boerse-Customer-References-Logo%401x.de942a6af16db005d5977f3851ed141829f1f052.png","displayLocation":"Germany","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2018-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/deutsche-borse-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Deutsche Boerse Group","enableShare":"1","publishedDate":"2018","contentType":"Customer Story","headline":"Cloud Migration Means Transformation at Deutsche Börse Group"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#dach","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"DACH","description":"DACH","dateCreated":"2020-02-03T05:29:52+0000","dateUpdated":"2022-02-03T03:31:47+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+