000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"}]},{"item":{"id":"customer-references#vietjet20200327wrlovdnh","locale":"en_US","directoryId":"customer-references","name":"vietjet20200327wrlovdnh","dateCreated":"2022-05-23T21:43:45+0000","dateUpdated":"2022-05-23T21:53:27+0000","additionalFields":{"descriptionSummary":"Servicing 25M requests from their website per day, VietJet needed a clever solution to mitigate bot traffic to its airline booking system preventing denial of inventory to its customers. In this episode of This is my Architecture we look at how they extended Amazon CloudFront and AWS WAF by incorporating additional pattern matching logic with Lambda at edge. We also learn how to use Kinesis Firehose, S3, Lambda and Athena to analyze all the traffic and proactively identify new threats.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/vietjet-aviation-air-logo%401x.7cbe857e3f9252d54c291b020175df052b3379f4.png","displayLocation":"Asia Pacific","footerInfoText":"Published Date","industry":"Transport \u0026 Logistics","sortDate":"2020-03-27","headlineUrl":"https://youtu.be/KQ6Fg206O9U?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","contentType":"Customer Story","headline":"VietJet: Proactively Defending Your Systems from Bad Bots","customer-name":"VietJet Aviation JSC"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-