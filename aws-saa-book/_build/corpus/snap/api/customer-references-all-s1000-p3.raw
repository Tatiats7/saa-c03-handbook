p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#propellerhealth","locale":"en_US","directoryId":"customer-references","name":"propellerhealth","dateCreated":"2020-05-04T20:11:29+0000","dateUpdated":"2023-07-12T01:35:31+0000","additionalFields":{"descriptionSummary":"Propeller Health is a leading digital health company dedicated to the management of chronic respiratory disease. Propeller Health develops a digital health platform, Propeller, that improves outcomes for people with asthma and chronic obstructive pulmonary disease (COPD) and allows providers to monitor their patients remotely, stratify patients based on risk, and make data-driven decisions on treatment.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/propeller-health-200x70.a3848f7cc13b292d48c6499f01105344274c1aee.png","displayLocation":"North America","footerInfoText":"Published Date","industry":"Life Sciences","sortDate":"2020-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/propeller-health-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2020","customer-name":"Propeller Health","contentType":"Customer Story","headline":"Propeller Health Leverages AWS to Help Patients Manage Respiratory Disease"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T0