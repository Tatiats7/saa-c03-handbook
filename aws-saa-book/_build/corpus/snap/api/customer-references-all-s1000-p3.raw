erless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#batch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Batch","description":"AWS Batch","dateCreated":"2020-03-02T07:01:42+0000","dateUpdated":"2022-02-03T03:32:19+0000"},{"id":"GLOBAL#use-case#high-perform-compute","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"High Performance Compute","description":"High Performance Compute","dateCreated":"2020-06-05T06:37:26+0000","dateUpdated":"2022-02-03T03:35:41+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#sysco-case-study","locale":"en_US","directoryId":"customer-references","name":"sysco-case-study","dateCreated":"2019-07-19T14:56:02+0000","dateUpdated":"2023-07-12T01:40:53+0000","additionalFields":{"featured":"0","descriptionSummary":"Sysco used Amazon S3 and Amazon S3 Glacier to reduce storage costs by 40 percent increase agility and security, and make time to focus on creating new business applications. Sysco is a global foodservice distribution company that sells, markets, and distributes to restaurants, healthcare and educational facilities, lodging establishments, and other customers in more than 90 countries.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Sysco_Customer-Reference_Logo.271d4a28c65246dc42b96447a4a3a7c6e79a64cd.png","displayLocation":"Americas","footerInfoText":"Published Date","description":"\u003cp\u003eSysco Reduces Storage Costs by 40 Percent Using Amazon S3 and Amazon S3 Glacier\u003c/p\u003e\r\n","industry":"Consumer Packaged Goods (CPG)","sortDate":"2019-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/sysco/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Sysco","enableShare":"1","publishedDate":"2019","contentType":"Customer Story","headline":"Sysco Case Study"}},"tags":[{"id":"GLOBAL#industry#cpg","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Consumer Packaged Goods (CPG)","description":"Consumer Packaged Goods (CPG)","dateCreated":"2020-06-25T04:03:18+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","date