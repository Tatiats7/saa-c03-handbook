alFields":{"descriptionSummary":"Geopagos es la infraestructura de aceptación de pagos de Latinoamérica. La empresa opera en más de 15 países y procesa más de 150 millones de transacciones al año con un volumen de aproximadamente US$ 4 billones anuales. Geopagos adoptó los servicios de AWS, evitando así la carga operativa que significa gestionar y mantener su infraestructura. Esto permite que sus desarrolladores puedan enfocarse en la creación de nuevos productos. Actualmente utilizan servicios como Amazon Elastic compute Cloud (Amazon EC2), Amazon ElasticCache, Amazon Route 53 y Amazon Simple Storage Service (Amazon S3).","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/geopagos_logo%401x.2088a532999ab39e798be2c2919d1216a70f2589.png","displayLocation":"Argentina","customerNameLower":"geopagos","footerInfoText":"Fecha de publicación","industry":"Servicios financieros","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/geopagos/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Geopagos","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"Geopagos logra más productividad y velocidad de desarrollo con servicios AWS"}},"tags":[{"id":"customer-references#category#saas","locale":"en_US","tagNamespaceId":"customer-references#category","name":"SaaS","description":"SaaS","dateCreated":"2019-07-22T18:32:20+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#e