a","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#language#italian","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Italian","description":"Italian","dateCreated":"2020-03-03T06:40:49+0000","dateUpdated":"2022-02-03T03:31:25+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"}]},{"item":{"id":"customer-references#razer-restorify-case-study","locale":"en_US","directoryId":"customer-references","name":"razer-restorify-case-study","dateCreated":"2023-03-03T22:13:29+0000","dateUpdated":"2025-05-23T20:10:40+0000","additionalFields":{"descriptionSummary":"While it may seem odd that a brand best known for its gaming peripherals is developing a carbon-neutral checkout solution for its customers, this is just one of the ways that Razer Inc. (Razer) is contributing toward a carbon-neutral world.\nAs part of its Environmental, Social, and Governance (ESG) initiative in November 2022, the dual-headquartered (US and Singapore) technology company launched Restorify. The solution provides Razer’s customers with up-to-date estimates of their carbon footprints and, with each purchase, empowers its customers to make direct contributions toward carbon-offsetting programs.","featured":"0","featureImageURL":"https://d1.awsstatic.com/customer-references-case-studies-logos/razer%20thumb.c1b63dc277b804f5e3158359fbf0c3b265f3b42d.png","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/razer%20thumb.c1b63dc277b804f5e3158359fbf0c3b265f3b42d.png","displayLocation":"Singapore","customerNameLower":"razer","footerInfoText":"Published Date","industry":"Electronics","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/razer-restorify-case-study/?did\u003dcr_card\u0026trk\u00