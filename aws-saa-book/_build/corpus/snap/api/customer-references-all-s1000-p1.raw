ences#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#press-release","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Press Release","description":"Press Release","dateCreated":"2020-08-20T03:36:30+0000","dateUpdated":"2022-02-03T03:31:09+0000"},{"id":"customer-references#innovator#united-airlines","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"United Airlines","description":"\u003cp\u003eInnovator introduced in 2023.\u003c/p\u003e\n","dateCreated":"2023-08-10T19:05:26+0000","dateUpdated":"2023-08-10T19:05:26+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"GLOBAL#series#aws-reinvent","locale":"en_US","tagNamespaceId":"GLOBAL#series","name":"AWS re:Invent","description":"AWS re:Invent","dateCreated":"2021-06-04T06:36:32+0000","dateUpdated":"2022-02-03T03:33:29+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#siemens-2022-aws-reinvent-video","locale":"en_US","directoryId":"customer-references","name":"siemens-2022-aws-reinvent-video","dateCreated":"2023-02-14T23:47:14+0000","dateUpdated":"2023-09-21T00:18:57+0000","additionalFields":{"descriptionSummary":"Siemens is a global leader in software and automation for industry, infrastructure, and healthcare. 24 out of the 25 largest car manufacturers in the world use Siemens software—as do 92 percent of all Fortune 500 companies.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Siemens_Customer-Reference_Logo%401x.bb038521df5899223d4bd8364182c2fc69ef288d.png","displayLocation":"United States","customerNameLower":"siemens","footerInfoText":"Published Date","industry":"Electronics \u0026 Semiconductors","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/siemens-2022-aws-reinvent-video/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Siemens","publishedDate":"2022","enableShare":"1","headline":"Siemens Helps Shape the \"Fourth Industrial Revolution\" by Combining Its Software and AWS Cloud Capabilities","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"