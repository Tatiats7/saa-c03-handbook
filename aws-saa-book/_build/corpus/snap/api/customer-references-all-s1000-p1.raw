"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12T02:01:29+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#industry#life-sciences","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Life Sciences","description":"Life Sciences","dateCreated":"2020-01-16T17:42:31+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"customer-references#category#modern-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Modern Applications","description":"\u003cp\u003eModern applications are built with a combination of modular architecture patterns, serverless operational models, and agile developer processes.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:15:46+0000","dateUpdated":"2023-07-14T01:15:46+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"customer-references#category#business-resilience","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Resilience","description":"\u003cp\u003eIn business, resilience means dealing with adversity and shocks, and continuously adapting for growth.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:01:43+0000","dateUpdated":"2023-07-14T01:01:43+0000"}]},{"item":{"id":"customer-references#ticketek-case-study","locale":"en_US","directoryId":"customer-references","name":"ticketek-case-study","dateCreated":"2023-05-11T00:15:02+0000","dateUpdated":"2024-02-21T00:20:53+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eTicketek is owned by TEG and is a global leader in ticketing and technology with more than 40 years of experience ticketing major international events and partnering with the world\u0026rsquo;s premier venues. Based in Australia, TEG operates more than 30 brands in 40 countries on six continents. Prior to building on Amazon Web Services (AWS), newsletters were sent based on \u0026quot;state\u0026quot; parameters only with no other personalization. Using Amazon Personalize, the company can now provide customers with a greater diversity of shows and events that suit their unique interests. Purchase rates improved by more than 200 percent with volume of tickets sold per newsletter open increasing by 49 percent.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/ticketek-logo%401x.42ce52b45d6f19560420cbaf998df42f1c1361a9.png","displayLocation":"Australia","customerNameLower":"ticketek","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2023-04-04","headlineUrl":"https://aws.amazon.com/solutions/case-studies/ticketek-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ticketek","publishedDate":"2023","enableShare":"1","headline":"TEG Uses Amazon Personalize to Boost Sales and User Engagement","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#location#anz","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia \u0026 New Zealand","description":"Australi