description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#iberia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Iberia","description":"Iberia","dateCreated":"2020-04-09T03:37:04+0000","dateUpdated":"2022-02-03T03:31:49+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#sixthforcesolutions","locale":"en_US","directoryId":"customer-references","name":"sixthforcesolutions","dateCreated":"2022-08-02T06:39:27+0000","dateUpdated":"2023-07-14T23:32:45+0000","additionalFields":{"descriptionSummary":"Sixth Force Solutions uses AWS to increase revenue by 150 percent in one and a half years, grow cloud-hosted and SaaS solutions from zero to more than 60 in less than a year, help employees collaborate reliably across the globe, and cut deployment time from months to weeks. The company provides Enterprise Architecture consulting for customers in a range of industries.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/6th-force-solutions-logo%401x.7c0aba9c61651a612df1f8f4ee54699f6b5298e8.png","displayLocation":"India","customerNameLower":"sixth force solutions","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-08-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/sixthforcesolutions/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Sixth Force Solutions","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Sixth Force Solutions Delivers Cloud Version of Enterprise Architect Software to Meet Customer Demand for Rapid Tool Deployment"}},"tags":[{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#appstream2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon AppStream 2.0","description":"Amazon AppStream 2.0","dateCreated":"2020-03-02T07:01:30+0000","dateUpdated":"2022-02-03T03:32:17+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16