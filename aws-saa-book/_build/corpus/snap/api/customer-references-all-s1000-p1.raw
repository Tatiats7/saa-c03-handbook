,"tagNamespaceId":"GLOBAL#location","name":"Scotland","description":"Scotland","dateCreated":"2020-04-09T03:37:51+0000","dateUpdated":"2022-02-03T03:31:52+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#prima-group","locale":"en_US","directoryId":"customer-references","name":"prima-group","dateCreated":"2023-05-31T23:29:53+0000","dateUpdated":"2024-02-20T22:25:53+0000","additionalFields":{"descriptionSummary":"Television company Prima Group, based in the Czech Republic, has migrated its iPrima streaming service platform to AWS to boost its ability to scale, and support the growth of its subscriber base. Using AWS, it has improved scaling by a factor of 10, compared to its previous hosting company, and reduced the size of its IT staff by 50 percent. To support platform stability, it uses Amazon Elastic Kubernetes Service (Amazon EKS). After the migration, it was able to develop Kubernetes clusters in just 14 days, compared to the 2 years it took previously.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/prima-logo%401x.ea97cd42a6073b907f75e3e750e89d8a20177abe.png","displayLocation":"Czech Republic","customerNameLower":"prima group","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2023-05-24","headlineUrl":"https://aws.amazon.com/solutions/case-studies/prima-group/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Prima Group","publishedDate":"2023","enableShare":"1","headline":"Prima Group Boosts Streaming Uptime on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#location#czech-rep","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Czech Republic","description":"Czech Republic","dateCreated":"2020-03-10T05:13:38+0000"