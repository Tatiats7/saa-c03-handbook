0+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#b89","locale":"en_US","directoryId":"customer-references","name":"b89","dateCreated":"2023-06-01T23:11:59+0000","dateUpdated":"2023-06-08T04:07:32+0000","additionalFields":{"descriptionSummary":"La B89 es una techfin que tiene como objetivo crear nuevas oportunidades en el sistema financiero de Perú y también para los demás países hispánicos. La opción por cloud se dio por su necesidad de alta disponibilidad, escalabilidad y seguridad, y con AWS pudieron evolucionar su plataforma sin preocuparse de los costes. La empresa utiliza servicios cómo Amazon Managed Streaming for Apache Kafka (Amazon MSK), Amazon Elastic Kubernetes Service (Amazon EKS) y Amazon EMR, contribuyendo para la creación de una plataforma accesible desde cualquier parte del mundo.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/b89-logo%402x.8fca38f3eabc6cf809b2c28b63630b9d943de160.png","displayLocation":"Perú","footerInfoText":"Fecha de publicación","industry":"Servicios financieros","sortDate":"2022-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/b89/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2022","contentType":"Historia del cliente","customer-name":"B89","headline":"B89 cuenta con AWS para ser un referente tecnológico para Fintechs en Latinoamérica"}},"tags":[{"id":"GLOBAL#location#peru","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Peru","description":"Peru","dateCreated":"2021-02-19T05:32:36+0000","dateUpdated":"2022-02-03T03:31:33+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#sso","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Single Sign-On (SSO)","description":"AWS Single Sign-On (SSO)","dateCreated":"2020-03-02T07:05:37+0000","dateUpdated":"2023-06-01T00:45:24+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"}]},{"item":{"id":"customer-references#gerencianet","locale":"en_US","directoryId":"customer-references","name":"gerencianet","dateCreated":"2023-06-01T23:06:35+0000","dateUpdated":"2023-06-08T04:07:45+0000","additionalFields":{"descriptionSummary":"Com quase 300 mil clientes cadastrados em todo o Brasil, a Gerencianet é uma conta digital focada em negócios para que empreendedores possam emitir e gerenciar recebimentos. Ela realizou, somente em 2021, mais de 60 milhões de cobranças, atendendo pessoas físicas e jurídicas que desejam receber suas cobranças de forma facilitada, agilizando processos operacionais. Para disponibilizar o Pix aos seus clientes dentro do prazo determinado pelo Banco Central, a Gerencianet utilizou uma série de serviços AWS, que possibilitaram a construção de uma nova infraestrutura adequada às demandas do novo serviço.","featureImageURL":"https://d1.awsstatic.com/industry-images-customer-references/man_entrepreneur_phone.0e06f0f901aec6961a51b756e2ffdaa33a82dea1.jpg","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/gerencianet-1%402x.badb2e64e34b14cb1f8b15b362126fa50c1f4a87.png","displayLocation":"Brasil","customerNameLower":"gerencianet","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/gerencianet/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Gerencianet","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"Com serviços AWS, Gerencianet desenvolve nova infraestrutura para oferta do Pix a mais de 290 mil clientes"}},"tags":[{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#use-case#general-database-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"General Database Migration","description":"General Database Migration","dateCreated":"2020-06-05T06:37:24+0000","dateUpdated":"2022-02-03T03:35:41+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#category#database-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Database Migration","description":"Database Migration","dateCreated":"2019-07-22T18:31:40+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"}]},{"item":{"id":"customer-references#bancopan","locale":"en_US","directoryId":"customer-references","name":"bancopan","dateCreated":"2023-06-01T23:06:09+0000","dateUpdated":"2023-06-08T04:07:46+0000","additionalFields":{"descriptionSummary":"O Banco Pan oferece serviços financeiros voltados às classes C, D e E. A instituição vem experimentando crescimento e, para continuar entregando boas experiências aos clientes, decidiu substituir a sua infraestrutura on-premises por um ambiente de dados 100% cloud até o final de 2022. Neste vídeo, Leandro Marçal, CTO do Banco Pan, e Samir Migliani, head de dados da instituição, falam sobre a decisão de adotar uma plataforma totalmente baseada na nuvem AWS. O Banco Pan adotou, com o suporte da AWS Professional Services, soluções como AWS DMS, AWS Lambda, AWS Glue, Amazon DynamoDB e Amazon SageMaker, entre outras, e atualmente já ultrapassou a marca de 1 milhão de contratos totalmente digitais, originados no novo aplicativo.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/BancoPan_logo%402x.435f531016bf410c52da683f0e351a96d9adfffb.png","displayLocation":"Brasil","customerNameLower":"banco pan","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/bancopan/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Banco Pan","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"Em ambiente AWS, Banco Pan já ultrapassa 1 milhão de contratos digitais"}},"tags":[{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#product#athena","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Athena","description":"Amazon Athena","dateCreated":"2020-03-02T07:01:35+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"}]},{"item":{"id":"customer-references#jps-variation1","locale":"en_US","directoryId":"customer-references","name":"jps-variation1","dateCreated":"2023-06-01T23:06:39+0000","dateUpdated":"2023-06-08T04:07:40+0000","additionalFields":{"videoSrcUrl":"https://www.youtube.com/watch?v\u003dAFNW_LsOKw0","descriptionSummary":"Jamaica Public Service (JPS) es el único distribuidor de electricidad en Jamaica. Hace aproximadamente tres años, la empresa tenía el desafío de poner una gran cantidad de información disponible para todos sus clientes. Con el apoyo de AWS, la compañía comenzó su camino hacia la transformación digital, moviendo su servicio al cliente de una manera rápida y eficiente, así como mejorando su rentabilidad a través de la nube AWS. Garry Barrow, director de operaciones en JPS, y Phillip Hamilton, especialista en TI para Infraestructura de la compañía, explican cómo lograron la capacidad de brindar soluciones en cuestión de minutos en lugar de semanas y ahorrar en almacenamiento al menos un 40%.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/JPS-logo%401x.3478528beeb40acda015c33b78052ade26565ed5.png","customerNameLower":"jps","footerInfoText":"Fecha de publicación","industry":"Energía","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/jps/?did\u003dcr_card\u0026trk\u003dcr_card",