eId":"GLOBAL#location","name":"Iberia","description":"Iberia","dateCreated":"2020-04-09T03:37:04+0000","dateUpdated":"2022-02-03T03:31:49+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#vtex","locale":"en_US","directoryId":"customer-references","name":"vtex","dateCreated":"2023-06-01T23:05:28+0000","dateUpdated":"2023-06-08T04:07:47+0000","additionalFields":{"descriptionSummary":"A VTEX é uma plataforma comercial global, que trabalha com 2.500 marcas, lojas e empresas, ajudando-as a criar experiencias de e-commerce aos clientes, seja no ambiente B2C ou B2B. Para assegurar que seus clientes entreguem as melhores experiências aos usuários, incluindo ofertas personalizadas, entregas expressas e segurança de dados, a VTEX adota serviços da AWS. Neste vídeo, Amit Shah, diretor de estratégia (CSO) da VTEX, explica os motivos que levaram a empresa à escolha da AWS. Ele detalha a importância de se contar com um provedor com presença global, entre outras características dos serviços AWS. Confira.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/industry/automotive/logos/VTEX.8914cab096469018f9a5cb17157180fe7182d9c5.jpg","displayLocation":"Brasil","customerNameLower":"vtex","footerInfoText":"Data de publicação","industry":"Software e Internet","