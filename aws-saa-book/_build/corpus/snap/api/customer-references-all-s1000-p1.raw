 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"}]},{"item":{"id":"customer-references#weetrust-case-study","locale":"en_US","directoryId":"customer-references","name":"weetrust-case-study","dateCreated":"2023-10-04T05:41:51+0000","dateUpdated":"2024-02-21T00:20:55+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eWith AWS, weetrust has taken advantage of the intuitive console and automatic scaling capabilities to build a comprehensive security framework to support the future of its business\u0026mdash;no matter the size of its IT team.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/weetrust-logo%401x.25741ad233587d5f7501355424af301475c0f2cf.png","displayLocation":"Mexico","customerNameLower":"weetrust","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/weetrust-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"weetrust","publishedDate":"2023","enableShare":"1","headline":"Legal Tech Company weetrust Strengthens Security Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#central-america","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central America","description":"Central America","dateCreated":"2021-02-19T05:32:25+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#product#security-hub","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Security Hub","description":"AWS Security Hub","dateCreated":"2020-03-02T07:05:15+0000","dateUpdated":"2022-02-03T03:32:59+0000"},{"id":"GLOBAL#location#mexico","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Mexico","description":"Mexico","dateCreated":"2020-04-09T00:25:53+0000","dateUpdated":"2022-02-03T03:31:31+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#itau-data-mesh-from-pt-directory","locale":"en_US","directoryId":"customer-references","name":"itau-data-mesh-from-pt-directory","dateCreated":"2024-02-03T03:48:35+0000","dateUpdated":"2024-04-19T23:19:31+0000","additionalFields":{"descriptionSummary":"O Itaú Unibanco está entre os maiores bancos da América Latina. A instituição oferece múltiplos serviços, como plataformas de investimentos, atacado, seguros e contas correntes, entre outros.\n\nO banco tem a missão de se tornar cada vez mais digital, em uma estratégia que envolve mudanças na forma com que seus times trabalham, a modernização de suas tecnologias e uma transformação em sua cultura, com foco em fortalecer a centralidade no cliente e o uso de dados em escala para o desenvolvimento de soluções.\n\nCom essa ambição, a instituição estruturou uma arquitetura de dados no modelo de data mesh com o suporte da AWS, e contou com o suporte da companhia para criar processos que viabilizassem o projeto. A partir da nova estrutura, o Itaú Unibanco obteve benefícios como uma redução de 95% no tempo de processamento de análise do cliente.\n\nNeste vídeo, Moisés Nascimento, chief data officer do Itaú Unibanco, e Roberto Figueira, superintendente de engenharia e plataforma de dados da instituição, contam como o banco reestruturou sua estratégia de dados e implementou a arquitetura data mesh para que eles pudessem ser distribuídos pelas comunidades que desenvolvem seus produtos. Moisés afirma que esses dados foram disponibilizados através da nova arquitetura e, em menos de seis meses, centenas de usuários já estavam criando contas dentro do data mesh.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/itau_logo%401x.387d8a15132c385d83aa638d391b8802b2f31fc6.png","displayLocation":"Brasil","customerNameLower":"itaú","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/itau-data-mesh/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Itaú","enableShare":"1","publishedDate":"2023","contentType":"História do cliente","headline":"Itaú Unibanco adota a arquitetura data mesh e conta com o suporte da AWS"}},"tags":[{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId"