ion":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#podcast","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Podcast","description":"Podcast","dateCreated":"2020-04-29T05:19:29+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#industry#life-sciences","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Life Sciences","description":"Life Sciences","dateCreated":"2020-01-16T17:42:31+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#technologyone-case-study","locale":"en_US","directoryId":"customer-references","name":"technologyone-case-study","dateCreated":"2019-07-22T17:10:17+0000","dateUpdated":"2022-03-24T02:43:49+0000","additionalFields":{"featured":"0","descriptionSummary":"Using AWS, TechnologyOne simplified its business model and is now able to move faster with more focus on the customer. TechnologyOne is an enterprise software company based in Australia.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/TechnologyOne_Customer-Reference_Logo.18ca9e93e7e853086d65088ecd1bd818eacf48cb.png","displayLocation":"Australia","footerInfoText":"Published Date","description":"\u003cp\u003eUsing AWS, TechnologyOne simplified its business model and is now able to move faster with more focus on the customer. TechnologyOne is an enterprise software company based in Australia. The company removed its IT environment from physical data centers and into the AWS cloud, eliminating the need to manage infrastructure.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2022-03-23","headlineUrl":"https://aws.amazon.com/solutions/case-studies/technologyone-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"TechnologyOne","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"TechnologyOne Improves Security and Agility Using Fully Managed Storage Solution Built on AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#use-case#general-database-migratio