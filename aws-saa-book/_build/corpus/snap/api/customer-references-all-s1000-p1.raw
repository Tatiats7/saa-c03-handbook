{"items":[{"item":{"id":"customer-references#skyscanner-case-study","locale":"en_US","directoryId":"customer-references","name":"skyscanner-case-study","dateCreated":"2023-06-06T17:27:43+0000","dateUpdated":"2024-02-20T22:25:54+0000","additionalFields":{"descriptionSummary":"Travel marketplace Skyscanner migrated to Amazon CloudFront, helping its scale to three billion monthly API requests, maintain a 99.99 percent cache-hit rate, and unlock 50 percent cost savings.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/skyscanner-logo%401x.b0c500dca7270bc6f00db226ae83c2c8394c1120.png","displayLocation":"Scotland","customerNameLower":"skyscanner","footerInfoText":"Published Date","industry":"Travel","sortDate":"2023-05-25","headlineUrl":"https://aws.amazon.com/solutions/case-studies/skyscanner-cloudfront-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Skyscanner","publishedDate":"2023","enableShare":"1","headline":"Skyscanner Delivers Travel Deals Using Amazon CloudFront","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#shield","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Shield","description":"AWS Shield","dateCreated":"2020-03-02T07:05:24+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#devtools","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Developer Tools","description":"Deve