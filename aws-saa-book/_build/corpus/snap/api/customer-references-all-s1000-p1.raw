6adf802990e109ddd3b0e8db841639db19031c6.png","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Ubisoft_Customer-Reference_Logo.96adf802990e109ddd3b0e8db841639db19031c6.png","displayLocation":"Canada","customerNameLower":"ubisoft, inc.","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/ubisoft-aws-is-how/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ubisoft, Inc.","publishedDate":"2023","enableShare":"1","headline":"Ubisoft propose aux joueurs du monde entier des expériences de jeu immersives","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#gamelift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon GameLift","description":"Amazon GameLift","dateCreated":"2020-03-02T07:03:36+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#tech-category#game-tech","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Games","description":"Games","dateCreated":"2022-10-07T04:56:34+0000","dateUpdated":"2023-08-22T20:28:39+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"20