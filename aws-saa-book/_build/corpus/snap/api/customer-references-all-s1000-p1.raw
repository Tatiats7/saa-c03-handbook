stomer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#genentech1","locale":"en_US","directoryId":"customer-references","name":"genentech1","dateCreated":"2022-05-27T21:47:58+0000","dateUpdated":"2023-07-12T01:35:42+0000","additionalFields":{"descriptionSummary":"Genentech created a biomarker data repository built on AWS to house petabytes of exploratory biomarker data and provide an interface where scientists can easily find the clinical data they needed for a specific study. As a result, clinical data analyses that used to take weeks now only require a few hours for researchers.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/genentech-logo%401x.805f1ae0199f65286cb7c84f9020eaa30f54133d.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Life Sciences","sortDate":"2022-05-27","headlineUrl":"https://aws.amazon.com/solutions/case-studies/genentech1/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Genentech","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Genentech Maximizes the Value of Clinical Biomarker Data Using AWS"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022