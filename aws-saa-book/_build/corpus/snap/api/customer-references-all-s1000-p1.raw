skill gaps, increasing IT productivity and employee satisfaction by working with AWS Training and Certification. Paytm is one of India’s largest digital payments, commerce, and financial services platforms.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Paytm_logo%401x.fe999fd5d0e5da9e07a45e1c3a1011bc1f791de5.png","displayLocation":"India","customerNameLower":"paytm","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-07-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/training-and-certification-paytm/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Paytm","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Paytm Enhances Innovation Potential of its Technology Team with AWS Training and Certification"}},"tags":[{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#customer-enablement#training-cert","locale":"en_US","tagNamespaceId":"GLOBAL#customer-enablement","name":"Training \u0026 Certification","description":"Training \u0026 Certification","dateCreated":"2020-09-04T04:06:29+0000","dateUpdated":"2022-02-03T03:31:13+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-