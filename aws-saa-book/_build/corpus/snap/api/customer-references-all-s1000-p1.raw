 \u0026 Hybrid","description":"Enterprise \u0026 Hybrid","dateCreated":"2019-07-22T18:31:50+0000","dateUpdated":"2022-05-09T21:31:12+0000"},{"id":"customer-references#business-outcome#cost-optimization","locale":"en_US","tagNamespaceId":"customer-references#business-outcome","name":"cost-optimization","description":"Cost Optimization","dateCreated":"2019-07-22T18:39:02+0000","dateUpdated":"2019-07-22T18:39:02+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2023-07-15T01:16:11+0000"},{"id":"customer-references#category#hybrid-cloud-architecture","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Hybrid Cloud Architecture","description":"Hybrid Cloud Architecture","dateCreated":"2019-07-22T18:32:02+0000","dateUpdated":"2023-10-28T22:02:50+0000"}]},{"item":{"id":"customer-references#highpoint-service-network-case-study","locale":"en_US","directoryId":"customer-references","name":"highpoint-service-network-case-study","dateCreated":"2023-05-19T23:53:41+0000","dateUpdated":"2024-02-20T22:26:16+0000","additionalFields":{"descriptionSummary":"Highpoint Service Network (HSN) provides business processing outsourcing (BPO) services to companies in the Asia Pacific region. The company recently migrated its on-premises call-handling system to Engage for Amazon Connect, an omnichannel cloud contact center service from AWS Partner Local Measure.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/highpoint-service-network-logo%401x.90a1b38d43bb55ff1adfc88a4fd08057177ab17c.png","displayLocation":"Philippines","customerNameLower":"highpoint services network (hsn)","footerInfoText":"Published Date","industry":"Professional Services","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/highpoint-service-n