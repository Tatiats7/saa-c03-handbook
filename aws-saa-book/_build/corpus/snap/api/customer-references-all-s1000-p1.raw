","description":"Call Center Operations","dateCreated":"2020-06-05T06:37:02+0000","dateUpdated":"2022-02-03T03:35:35+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#business-category#cust-engagement","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2020-06-05T07:06:46+0000","dateUpdated":"2022-02-03T03:31:03+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#ukir","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"UK/IR","description":"UK/IR","dateCreated":"2020-02-19T23:06:44+0000","dateUpdated":"2022-02-03T03:31:51+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#swimming-australia-video-2022","locale":"en_US","directoryId":"customer-references","name":"swimming-australia-video-2022","dateCreated":"2024-03-06T03:15:13+0000","dateUpdated":"2024-03-06T03:20:01+0000","additionalFields":{"descriptionSummary":"Swimming Australia was sitting on a treasure trove of information on the performance of its athletes and was looking for world-leading ways to optimize this data in training and competition, so it came to Amazon’s Machine Learning Solutions Lab. The solution we built with them brought together a wholistic view of athlete performance to support coaches’ decision-making in competition, predict possible and probable outcomes, and influence tactical racing strategies.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/swimming-australia-logo%401x.116d6fce066e744ffc6ba885a1b612087a86679b.png","displayLocation":"Australia","customerNameLower":"swimming australia","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2022-05-13","headlineUrl":"https://www.youtube.com/watch?v\u003ddM5kJ-9MGbk\u0026did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Swimming Australia","publishedDate":"2022","enableShare":"1","headline":"Swimming Australia Dives Deep into Data and Machine Learning to Win Gold in Tokyo","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#anz","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia \u0026 New Zealand","description":"Australia \u0026 New Zealand","dateCreated":"2020-04-09T00:26:11+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#ai-ml","loca