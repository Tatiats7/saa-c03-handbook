Created":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#reference-arch-diagram","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Reference Architecture Diagram","description":"Reference Architecture Diagram","dateCreated":"2020-04-29T05:19:31+0000","dateUpdated":"2022-02-03T03:31:09+0000"}]},{"item":{"id":"customer-references#d-orbit-case-study","locale":"en_US","directoryId":"customer-references","name":"d-orbit-case-study","dateCreated":"2022-05-27T21:47:50+0000","dateUpdated":"2022-05-27T21:55:40+0000","additionalFields":{"descriptionSummary":"D-Orbit used AWS Ground Station to improve its space logistics services, thereby controlling costs and improving satellite visibility. The company offers last-mile satellite delivery and other space logistics services. Working alongside AWS Professional Services, D-Orbit achieved compatibility between its own mission control software and AWS Ground Station. As a result, it can communicate with satellites quicky and efficiently. D-Orbit’s plans to increase to as many as 12 launches by 2023 means customers will be able to select from numerous launch windows.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/d-orbit-logo%401x.5ac0ddda02427333edcaa862c557d981702ed8a1.png","displayLocation":"Italy","footerInfoText":"Published Date","industry":"Aerospace","sortDate":"2022-05-27","headlineUrl":"https://aws.amazon.com/solutions/case-studies/d-orbit-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"D-Orbit Reduces Space Logistics Costs and Improves Visibility Using AWS Ground Station","customer-name":"D-Orbit"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#italy","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Italy","description":"Italy","dateCreated":"2020-02-03T05:30:02+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#kinesis-data-streams","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis Data Streams","description":"Amazon Kinesis Data Streams","dateCreated":"2020-05-08T03:45:11+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T