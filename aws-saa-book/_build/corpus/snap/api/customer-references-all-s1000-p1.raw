mer-references","name":"zadig-voltaire","dateCreated":"2023-06-01T23:05:28+0000","dateUpdated":"2023-07-18T00:18:11+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eL\u0026rsquo;enseigne Zadig\u0026amp;Voltaire, qui r\u0026eacute;alise plus de 20 % de son chiffre d\u0026rsquo;affaires en ligne, souhaite am\u0026eacute;liorer l\u0026rsquo;exp\u0026eacute;rience digitale de ses clients tout en augmentant sa pr\u0026eacute;sence internationale. Pour y parvenir, elle a d\u0026eacute;cid\u0026eacute; de changer de fournisseur de cloud public pour migrer l\u0026rsquo;ensemble de sa plateforme e-commerce vers Amazon Web Services. Elle acc\u0026egrave;de ainsi \u0026agrave; un large catalogue de services innovants qui lui permettent d\u0026rsquo;offrir aux visiteurs une navigation plus fluide et \u0026agrave; des infrastructures mondiales qui lui ouvrent la porte de nouveaux march\u0026eacute;s.\u003c/p\u003e\r\n","featured":"0","featureImageURL":"https://d1.awsstatic.com/CS%20-%20Zadig-Voltaire%20-%20Logo.413497f85e6668261e8783fd2b2bb73913e54ff4.jpg","imageSrcUrl":"https://d1.awsstatic.com/CS%20-%20Zadig-Voltaire%20-%20Logo.413497f85e6668261e8783fd2b2bb73913e54ff4.jpg","displayLocation":"France","customerNameLower":"zadig\u0026voltaire","footerInfoText":"Date de publication","industry":"Vente au détail","sortDate":"2023-02-22","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/zadig-voltaire/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Zadig\u0026Voltaire","enableShare":"1","publishedDate":"2022","contentType":"Témoignages clients","headline":"L’innovation défile chez Zadig\u0026Voltaire avec le cloud AWS"}},"tags":[{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","