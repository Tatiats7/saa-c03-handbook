ds":{"descriptionSummary":"Operating in the highly regulated financial services industry, Velliv is one of Denmark’s largest pension companies, with more than 360,000 customers. When it separated from its parent company, Nordea, in 2018, Velliv had a chance to build a completely new, independent IT infrastructure. ","featureImageURL":"https://d1.awsstatic.com/emea-customer-references/emea-directory-customer-logos/Velliv-Customer-References-Logo%401x.52535df6f20a3c441e5d9a55447f591a4bd230c3.png","imageSrcUrl":"https://d1.awsstatic.com/emea-customer-references/emea-directory-customer-logos/Velliv-Customer-References-Logo%401x.52535df6f20a3c441e5d9a55447f591a4bd230c3.png","displayLocation":"Denmark","customerNameLower":"velliv, pension \u0026 livsforsikring a/s","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/velliv-case-study/?nc1\u003dh_ls\u0026did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Velliv, Pension \u0026 Livsforsikring A/S","publishedDate":"2022","enableShare":"1","headline":"Velliv Completes Secure, Compliant Migration Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#use-case#datacenter-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2020-08-18T05:17:48+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespa