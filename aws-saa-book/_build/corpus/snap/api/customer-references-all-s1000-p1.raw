iversidad-siglo-21/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Universidad Siglo 21","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"La Universidad Siglo 21 sigue transformándose para poner al estudiante en el centro de sus propuestas"}},"tags":[{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"customer-references#customer-segment#public-sector-edu","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Education","description":"Education","dateCreated":"2019-07-22T18:39:45+0000","dateUpdated":"2022-03-21T23:55:12+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#argentina","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Argentina","description":"Argentina","dateCreated":"2020-06-12T23:30:42+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"}]},{"item":{"id":"customer-references#sicredi","locale":"en_US","directoryId":"customer-references","name":"sicredi","dateCreated":"2023-06-01T23:05:10+0000","dateUpdated":"2023-06-08T04:07:48+0000","additionalFields":{"descriptionSummary":"O Sicredi é uma instituição financeira cooperativa que conta hoje com mais de 2,4 mil agências e está presente fisicamente em todos os estados brasileiros e no Distrito Federal, disponibilizando mais de 300 produtos e serviços financeiros. Com o objetivo de ampliar a sua base de associados, levando o cooperativismo de crédito para mais pessoas, desde 2016 o Sistema tem colocado em prática seu plano de transformação digital em um processo que, realizado na nuvem AWS, vem possibilitando a evolução dos sistemas que processas os produtos e serviços da instituição e a transformando sua área de TI em uma das mais desejadas para se trabalhar por profissionais brasileiros da área.","featureImageURL":"https://d1.awsstatic.com/industry-images-customer-references/Sicredi.2170a52ce017c4c59d337befff624a4422e0ad19.jpg","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/sicredi_logo%402x.f4799fa348a347f00408b857d0647a2406c173b9.png","displayLocation":"Brasil","customerNameLower":"sicredi","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/sicredi/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Sicredi","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"Nuvem AWS apoia jornada de transformação digital do Sicredi"}},"tags":[{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"}]},{"item":{"id":"customer-references#gobierno-ciudad-buenos-aires","locale":"en_US","directoryId":"customer-references","name":"gobierno-ciudad-buenos-aires","dateCreated":"2023-06-01T23:04:41+0000","dateUpdated":"2023-07-14T23:32:38+0000","additionalFields":{"descriptionSummary":"El Gobierno de la Ciudad de Buenos Aires es uno de los más importantes de Argentina. Uno de sus principales intereses es poner a los ciudadanos en el centro de las diversas decisiones políticas. Para ello resulta importante tener consolidada la información que el GCABA genera y recolecta para llevar adelante la operación que está en cabeza de las diferentes dependencias con el fin de posibilitar un re-diseño más efectivo de las políticas públicas en base a datos. Dichos datos están siendo consolidados en PIBA (Plataforma Inteligente de Buenos Aires), desarrollada en la nube de AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/buenosairesciudad%401x.7b6f1445a271ceb344bc9983d823cb601cec37b2.png","displayLocation":"Argentina","customerNameLower":"ar - buenos aires government (gcba) / same","footerInfoText":"Fecha de publicación","industry":"State and Local Government","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/gobierno-ciudad-buenos-aires/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"AR - Buenos Aires Government (GCBA) / SAME","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"AWS ayuda a reducir la burocracia y acelerar la transformación digital en Buenos Aires"}},"tags":[{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03