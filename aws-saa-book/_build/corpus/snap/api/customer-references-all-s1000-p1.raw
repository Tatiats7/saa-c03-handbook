LOBAL#location","name":"DACH","description":"DACH","dateCreated":"2020-02-03T05:29:52+0000","dateUpdated":"2022-02-03T03:31:47+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#industry#life-sciences","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Life Sciences","description":"Life Sciences","dateCreated":"2020-01-16T17:42:31+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"customer-references#category#hcls","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Healthcare \u0026 Life Sciences","description":"Healthcare \u0026 Life Sciences","dateCreated":"2019-07-22T18:31:58+0000","dateUpdated":"2022-05-14T20:13:37+0000"}]},{"item":{"id":"customer-references#mobileye07192022lskdjfpoasjef","locale":"en_US","directoryId":"customer-references","name":"mobileye07192022lskdjfpoasjef","dateCreated":"2023-02-08T01:17:01+0000","dateUpdated":"2023-02-08T01:38:41+0000","additionalFields":{"descriptionSummary":"Mobileye provides camera based driving assistance solution and data services, based on data collected from 70 million vehicles, driving all over the world. In this episode of This is My Architecture, Ido from Mobileye will walk us through their data collection and analytics system, the evolution of it and how they provide important insights to their customers, based on this data.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/mobileye-logo-2022%401x.81921a199fea9eee1b6dc7d5051f0a9e1e0c19f0.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"mobileye vision technologies ltd.","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2022-07-19","headlineUrl":"https://youtu.be/5hjkSczrke4?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Mobileye Vision Technologies Ltd.","publishedDate":"2022","enableShare":"1","headline":"Mobileye: How to Process Data from 70 Million Cars Driving Around the World","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#sqs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Queue Service (SQS)","description":"Amazon Simple Queue Service (SQS)","dateCreated":"2020-03-02T07:05:36+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#category#iot","locale":"en_US","tagNamespaceId":"customer-references#category","name":"IoT","description":"IoT","dateCreated":"2019-07-22T18:32:05+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#app-integration","locale"