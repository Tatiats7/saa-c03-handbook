er-references#pureweb07122022lknsefkln","locale":"en_US","directoryId":"customer-references","name":"pureweb07122022lknsefkln","dateCreated":"2023-02-08T01:17:08+0000","dateUpdated":"2023-02-08T01:38:41+0000","additionalFields":{"descriptionSummary":"Learn how PureWeb intelligently routes streaming requests from any device, anywhere on the planet, with decisioning based on network latency, and system preference and load. PureWeb\u0027s architecture leverages both serverless and provisioned compute to deliver 3D streaming for limitless experiences.","displayLocation":"United States","customerNameLower":"pureweb","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2022-07-12","headlineUrl":"https://youtu.be/hrhBOOrR5v0?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2022","enableShare":"1","customer-name":"PureWeb","headline":"PureWeb: Building a Global 3D Streaming Platform For Limitless Experiences","contentType":"Customer Story"}},"tags":[{"id":"customer-references#category#media-services","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Media Services","description":"Media Services","dateCreated":"2019-07-22T18:32:09+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022