0-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#reference-arch-diagram","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Reference Architecture Diagram","description":"Reference Architecture Diagram","dateCreated":"2020-04-29T05:19:31+0000","dateUpdated":"2022-02-03T03:31:09+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#resmed07052022ushdfoij","locale":"en_US","directoryId":"customer-references","name":"resmed07052022ushdfoij","dateCreated":"2023-02-08T01:17:13+0000","dateUpdated":"2023-07-12T01:35:20+0000","additionalFields":{"descriptionSummary":"Learn how ResMed built ‘myAir\u0027, a patient engagement platform, that helps patients track and engage with their sleep therapy for conditions like sleep apnea. ResMed moved from an on-premises environment to a fully serverless architecture on AWS to power myAir.\nThe solution uses services such as AWS AppSync to manage data flow from the patient mobile and website experience, Amazon Kinesis Video Streams for IOT data, AWS Lambda, Amazon SNS, Amazon Dynamo DB, Amazon S3 and CloudFront to scale globally, improve system performance and provide proactive care notifications.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/resmed-logo%401x.0f86a159bf40902f8d838ff365885c19b966e9ee.png","displayLocation":"United States","customerNameLower":"resmed corp","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2022-07-05","headlineUrl":"https://youtu.be/kszaIJEnKPk?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Resmed Corp","publishedDate":"2022","enableShare":"1","headline":"ResMed: Improving Patient Outcomes with Serverless at Scale","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35: