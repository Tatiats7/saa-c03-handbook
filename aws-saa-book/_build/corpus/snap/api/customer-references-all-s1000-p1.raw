22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"GLOBAL#product#iam","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Identity and Access Management","description":"AWS Identity and Access Management","dateCreated":"2020-03-02T07:03:48+0000","dateUpdated":"2022-02-03T03:32:41+0000"}]},{"item":{"id":"customer-references#hello-sunday-morning","locale":"en_US","directoryId":"customer-references","name":"hello-sunday-morning","dateCreated":"2022-05-09T21:31:34+0000","dateUpdated":"2022-05-09T21:58:48+0000","additionalFields":{"descriptionSummary":"The Australian nonprofit, Hello Sunday Morning, helps people change their relationship with alcohol. In 2016, it introduced the Daybreak app, which gives users access to professional health support, an interactive online community, and health coaches. When alcohol consumption rose due to the pandemic, Daybreak saw a 15 percent increase in number of daily active users and 52 percent more downloads. Building on AWS, HSM can rapidly scale Daybreak to meet surges in user demand.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/hsm-hello-sunday-morning-logo%401x.0f4c2b3cd68bfde7d9e10e12422e45b1d9fe47dc.png","displayLocation":"Australia","footerInfoText":"Published Date","industry":"Social Services","sortDate":"2022-05-09","headlineUrl":"https://aws.amazon.com/solutions/case-studies/hello-sunday-morning/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Hello Sunday Morning Scales Counselling Support by Ten-fold on AWS","customer-name":"Hello Sunday Morning"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#australia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia","description":"Australia","da