2-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#content-type#podcast","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Podcast","description":"Podcast","dateCreated":"2020-04-29T05:19:29+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"GLOBAL#industry#general-public-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"General Public Services","description":"General Public Services","dateCreated":"2020-01-16T17:42:24+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"}]},{"item":{"id":"customer-references#discover01032022slijflsknglgidn","locale":"en_US","directoryId":"customer-references","name":"discover01032022slijflsknglgidn","dateCreated":"2022-05-23T21:41:14+0000","dateUpdated":"2022-05-23T21:52:27+0000","additionalFields":{"descriptionSummary":"Discover Financial Services empowers their Data Scientists to build rapid data models on their Advanced Analytics Framework. For separation of concerns, the raw PCI data is placed in a tightly controlled Amazon S3 bucket, then is tokenized into another S3 in a different account. This enables data scientists from different business units to perform machine learning and data science work in a single platform without having data silos across the organization. Data Scientists can confidently build financial data models in a secured and compliant manner. By leveraging Kubernetes on Amazon EC2 compute and storage with Amazon EFS and Amazon S3, the data scientists can rapidly build data models on demand with significant reduction in storage costs and complexity.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/Discover_Customer-Reference_Logo%402x.fe39ea592aa8462e20f86231248644154eeedf2d.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-01-03","headlineUrl":"https://youtu.be/aQFztbu0BG0?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Discover Financial Services: Enabling a PCI Compliant Data Science Platform","customer-name":"Discover Financial Services"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#tech-category#