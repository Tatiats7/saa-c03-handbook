product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#elastic-beanstalk","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elastic Beanstalk","description":"AWS Elastic Beanstalk","dateCreated":"2020-03-02T07:03:00+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#location#middle-east","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East","description":"Middle East","dateCreated":"2020-04-09T03:53:16+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"customer-references#innovator#delivery-hero","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Delivery Hero","description":"\u003cp\u003eInnovator introduced in 2023.\u003c/p\u003e\n","dateCreated":"2023-08-10T19:02:56+0000","dateUpdated":"2023-08-10T19:02:56+0000"}]},{"item":{"id":"customer-references#state-farm-video","locale":"en_US","directoryId":"customer-references","name":"state-farm-video","dateCreated":"2022-05-14T20:13:41+0000","dateUpdated":"2022-05-14T20:15:17+0000","additionalFields":{"descriptionSummary":"For State Farm, the largest Property \u0026 Casualty insurer in the United States, approving deployments for production was a manual, opinion-based, and time-consuming process that frustrated developers, security teams, and executive leadership alike. They sought to streamline the process to minimize the approval timeline while also reducing the number of issues and maintaining compliance. To accomplish this, they built an automated, data-driven risk management process for all use cases leveraging a serverless-first approach. Key AWS services used include AWS Lambda, AWS Fargate, AWS Artifact, AWS Audit Manager, AWS CloudTrail, Amazon Virtual Private Cloud, and Amazon Elastic Compute Cloud.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/state-farm-logo%401x.4856003e4d40ce3d1e4e5e280fd48b055dfcd980.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-05-13","headlineUrl":"https://aws.amazon.com/solutions/case-studies/state-farm-video/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"State Farm automates risk management for all use cases leveraging a serverless-first approach","customer-name":"State Farm"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#artifact","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Artifact","description":"AWS Artifact","dateCreated":"2020-03-02T07:01:33+0000","dateUpdated":"2022-02-03T03:32:17+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","nam