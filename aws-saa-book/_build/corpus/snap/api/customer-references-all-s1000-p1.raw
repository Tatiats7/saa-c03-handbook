+0000","dateUpdated":"2023-07-15T01:16:11+0000"},{"id":"GLOBAL#use-case#general-database-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"General Database Migration","description":"General Database Migration","dateCreated":"2020-06-05T06:37:24+0000","dateUpdated":"2022-02-03T03:35:41+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"customer-references#category#database-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Database Migration","description":"Database Migration","dateCreated":"2019-07-22T18:31:40+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#innovator#snap","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Snap","description":"Snap","dateCreated":"2022-09-15T00:48:42+0000","dateUpdated":"2022-09-15T00:48:42+0000"}]},{"item":{"id":"customer-references#lingopass-elasticity","locale":"en_US","directoryId":"customer-references","name":"lingopass-elasticity","dateCreated":"2023-06-01T23:04:56+0000","dateUpdated":"2023-06-08T04:07:48+0000","additionalFields":{"descriptionSummary":"A plataforma de capacitação multi-idiomas Lingopass ensina inglês, espanhol, francês e português para estrangeiros, com foco no mercado corporativo no Brasil e América Latina.A empresa tem hoje 95% de sua infraestrutura rodando na nuvem da AWS e, com o suporte que recebeu, a Lingopass deu estabilidade à sua plataforma e reduziu sua indisponibilidade de 2 horas semanais para 2 horas ao ano.Neste vídeo, os cofundadores da startup, Alexandrine Brami, Eduardo Sato e Suzana Lordelo, contam como a Lingopass saiu de 250 alunos na fase de testes para 20.000 na base – 3.600 alunos ativos – sem um aumento expressivo de custo.\nSato, que também é CTO da empresa, revela ainda que a empresa praticamente zerou seu custo com manutenção de sistemas ao ir para a AWS e explica como ela utiliza serviços em nuvem para acelerar testes de novas funções. Conheça essa história e os planos futuros da empresa!","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/lingopass-logo%402x.de8c8a5c2391a21cbc727a010f225e2be630f7e4.png","displayLocation":"Brasil","customerNameLower":"lingopass","footerInfoText":"Data de publicação","industry":"Educação","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/lingopass-elasticity/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Lingopass","enableShare":"1","publishedDate":"2023","contentType":"História do cliente","headline":"Lingopass ajuda a democratizar o ensino de idiomas com apoio da AWS"}},"tags":[{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"