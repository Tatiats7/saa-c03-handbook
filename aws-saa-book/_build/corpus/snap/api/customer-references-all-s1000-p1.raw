escription":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#uae","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United Arab Emirates","description":"United Arab Emirates","dateCreated":"2020-02-03T05:30:23+0000","dateUpdated":"2022-02-03T03:31:56+0000"},{"id":"GLOBAL#product#opensearch-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon OpenSearch Service (OSS)","description":"Amazon OpenSearch Service (OSS)","dateCreated":"2022-07-14T21:40:49+0000","dateUpdated":"2022-07-22T00:15:52+0000"}]},{"item":{"id":"customer-references#lalamove-ml","locale":"en_US","directoryId":"customer-references","name":"lalamove-ml","dateCreated":"2022-01-15T01:07:55+0000","dateUpdated":"2022-09-09T00:34:16+0000","additionalFields":{"descriptionSummary":"Lalamove implemented optical character recognition (OCR) on AWS to automate validation of drivers’ licenses, reducing the time taken for onboarding from 1 week or more to 1 hour. The Lalamove mobile and web apps provide on-demand logistics services with a network of more than 700,000 delivery partners across the globe.  The company is using Amazon Textract for OCR, Amazon SageMaker for machine learning experimentation, and Amazon Rekognition for market share analysis.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/lalamove%20logo.56a54d9851910b16aaf447705e1e048cf2f2d359.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","industry":"Transport \u0026 Logistics","sortDate":"2022-01-14","headlineUrl":"https://aws.amazon.com/ar/solutions/case-studies/lalamove-ml/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Lalamove","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Lalamove Speeds Up Driver Onboarding with Optical Character Recognition Automation on AWS"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","de