s","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#tangent-case-study","locale":"en_US","directoryId":"customer-references","name":"tangent-case-study","dateCreated":"2022-07-26T21:37:33+0000","dateUpdated":"2022-07-26T21:43:21+0000","additionalFields":{"descriptionSummary":"Tangent Works helps companies get more value from their time-series data by automating the machine learning modeling process. Its Tangent Information Modeler (TIM) technology makes artificial intelligence technology accessible and affordable to businesses that don’t have dedicated data science teams. Tangent Works used AWS to launch its services, manage customers’ compute and storage needs, and support its rapid growth.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/tangent-works-logo%401x.4491f04bdff5bdd07f3117400edb4de4d5ceec53.jpg","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"tangent works","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-07-26","headlineUrl":"https://aws.amazon.com/solutions/case-studies/tangent-works-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Tangent Works","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Tangent Works Puts Machine Learning Modeling into Business Users’ Hands Using AWS"}},"tags":[{"id":"GLOBAL#location#belgium","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Belgium","description":"Belgium","dateCreated":"2020-02-03T05:29:48+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagName