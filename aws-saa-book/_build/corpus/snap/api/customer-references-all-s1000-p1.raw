very","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"}]},{"item":{"id":"customer-references#medtronic-case-study","locale":"en_US","directoryId":"customer-references","name":"medtronic-case-study","dateCreated":"2022-08-08T21:23:24+0000","dateUpdated":"2023-07-12T01:35:43+0000","additionalFields":{"descriptionSummary":"Colon cancer is the second-deadliest cancer worldwide but treatable 90 percent of the time if doctors catch it early. Yet tens of millions of individuals either don’t have access to a colonoscopy or choose not to be screened because they don’t want to undergo the unpleasant procedure. Medtronic wanted to use technology to develop a more appealing, patient-friendly screening that people can do at home and to improve access to screenings for underserved or hard-to-reach patient populations.","imageSrcUrl":"https://d1.awsstatic.com/industry/healthcare/medical-devices/2022/Medtronic_200x50.883518ff637b060b542a320d22c958f51189297c.png","displayLocation":"United States","customerNameLower":"medtronic","footerInfoText":"Published Date","industry":"Life Sciences","sortDate":"2022-08-08","headlineUrl":"https://aws.amazon.com/solutions/case-studies/medtronic-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Medtronic","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Medtronic Improves Patient Access to Colorectal Cancer Screening with an Artificial Intelligence–Assisted “Colonoscopy Pill” Built on AWS"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#category#hcls","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Healthcare \u0026 Life Sciences","description":"Healthcare \u0026 Life Sciences","dateCreated":"2019-07-22T18:31:58+0000","dateUpdated":"2022-05-14T20:13:37+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#industry#life-sciences","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Life Sciences","description":"Life Sciences","dateCreated":"2020-01-16T17:42:31+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#spryker-case-study","locale":"en_US","directoryId":"customer-references","name":"spryker-case-study","dateCreated":"2022-08-08T21:23:16+0000","dateUpdated":"2022-08-08T21:24:16+0000","additionalFields":{"descriptionSummary":"Spryker provides a cloud-based platform that global businesses rely on to run their B2B, marketplace, and direct-to-consumer (D2C) commerce businesses. When Spryker noticed customers were running complex backends to support its software, it turned to AWS. Using AWS, it improved the customer experience and shortened customer onboarding from months to days. Spryker has also expanded its operations worldwide, including launching in APAC, and improved its ability to innovate.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/spryker-logo%401x.ae275e9934d670eada191dc8784d3f07fe402a64.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"spryker","footerInfoText":"Published Date","industry":"Retail","sortDate":"2022-08-08","headlineUrl":"https://aws.amazon.com/solutions/case-studies/spryker-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Spryker","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Spryker Brings Composable Commerce to Global Businesses in Days Using AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"customer-references#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","nam