oc has created data pipelines in 2 hours and saved 70 percent on storage costs while gaining new user behavior insights. Halodoc connects millions of patients to over 22,000 doctors and 1,000 partner pharmacies across Indonesia, making healthcare simple and accessible. The company built a data lake on Amazon S3 with Amazon Athena to analyze data in real time, and Amazon EMR to run big data workloads.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Halodoc_Customer-Reference_Logo.fc6d17259a45918129235e4d4b0c4ff559c757be.png","displayLocation":"Indonesia","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2022-03-18","headlineUrl":"https://aws.amazon.com/solutions/case-studies/halodoc-analytics/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","customer-name":"Halodoc","contentType":"Customer Story","headline":"Halodoc Brings Online Healthcare Services to Millions in Indonesia on AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#asean","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"ASEAN","description":"ASEAN","dateCreated":"2020-08-20T03:53:05+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T