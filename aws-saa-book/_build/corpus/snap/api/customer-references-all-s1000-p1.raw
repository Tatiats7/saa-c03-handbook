LOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"}]},{"item":{"id":"customer-references#aeon","locale":"en_US","directoryId":"customer-references","name":"aeon","dateCreated":"2023-05-31T23:29:51+0000","dateUpdated":"2024-02-20T22:25:53+0000","additionalFields":{"descriptionSummary":"AEON scales to handle credit card usage peaks and support 40 percent growth. Using Amazon Web Services, it can comply with data laws and security protocols to support market entry in Europe and Africa.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/aeon-logo%401x.ae902a04ccdcf9bc5096069f82ad46670d621cf3.png","displayLocation":"Cyprus","customerNameLower":"aeon","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2023-05-24","headlineUrl":"https://aws.amazon.com/solutions/case-studies/aeon/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"AEON","publishedDate":"2023","enableShare":"1","headline":"AEON Achieves 40% Market Growth Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#cyprus","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Cyprus","description":"Cyprus","dateCreated":"2020-04-09T03:36:37+0000","dateUpdated":"2022-02-03T03:31:47+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T0