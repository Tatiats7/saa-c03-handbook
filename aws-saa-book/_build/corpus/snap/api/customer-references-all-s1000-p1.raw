ame":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#korean-air-innovator","locale":"en_US","directoryId":"customer-references","name":"korean-air-innovator","dateCreated":"2022-11-08T04:15:07+0000","dateUpdated":"2025-02-07T00:06:13+0000","additionalFields":{"descriptionSummary":"In 2018, Korean Air began migrating its entire IT infrastructure to the cloud. Then in 2021, it became the first global, full-service carrier to complete an all-in migration to Amazon Web Services (AWS). As an innovator in the aviation industry, Korean Air chose to build on AWS, and it launched its new website and mobile app 90 percent faster than possible with its former on-premises infrastructure. Continuing to innovate on behalf of its customers and workforce, the airline is developing an online one-step buying option and AWS-powered machine learning tools to create predictive, pre-emptive maintenance for its aircraft fleet.","featureImageURL":"https://d1.awsstatic.com/gcrp_KoreanAirInnovator_300x204_05312022.2f3ffa1fa1e83afcdcd732aaf4f796227ff74e00.png","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/KoreanAir_Customer-Reference_Logo@2x.1383b78b95bdc42ec45442d9aca675299b515486.png","displayLocation":"Asia Pacific","customerNameLower":"korean airlines","footerInfoText":"Published Date","description":"\u003cp\u003ePredicting and preempting maintenance for its fleet of aircraft\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u0026nbsp;\u003c/p\u003e\n","industry":"Travel \u0026 Hospitality","sortDate":"2022-10-31","headlineUrl":"https://aws.amazon.com/solutions/case-studies/innovators/korean-airlines/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Korean Airlines","publishedDate":"2022","enableShare":"1","headline":"Korean Airlines on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#korea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Korea","description":"Korea","dateCreated":"2020-02-03T05:29:25+0000","dateUpdated":"2022-02-03T03:31:39+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#industry#hospitality","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Hospitality","description":"Hospitality","dateCreated":"2020-01-16T17:42:27+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#industry#travel","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Travel","description":"Travel","dateCreated":"2020-01-16T17:42:42+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"customer-references#innovator#apj-innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"APJ Innovator Page or APJ Video Roadshow Page","description":"\u003cp\u003eItems with this tag are featured in the pre-filtered Directory on https://aws.amazon.com/solutions/case-studies/innovators/innovators-apj/. At time of creation, the APJ Customer References lead (@felees) intends to display both APJ Innovator pages and APJ video roadshow pages in this Directory. Thus, items with this tag cannot assumed to be Innovators, as they may have just been part of the video roadshow. Check items for \u003cstrong\u003ecustomer-references#innovator#innovator-hub\u003c/strong\u003e or \u003cstrong\u003ecustomer-references#category#innovator\u003c/strong\u003e to confirm their Innovator status.\u003c/p\u003e\n","dateCreated":"2025-02-06T21:12:38+0000","dateUpdated":"2025-02-06T21:13:04+0000"}]},{"item":{"id":"customer-references#isha-foundation-case-study","locale":"en_US","directoryId":"customer-references","name":"isha-foundation-case-study","dateCreated":"2022-10-31T22:34:06+0000","dateUpdated":"2022-10-31T22:41:41+0000","additionalFields":{"descriptionSummary":"Isha Foundation is a non-profit organization offering in-person and online courses and events to a growing number of users globally. To support this growth and securely deliver content with low latency, Isha Foundation migrated its customer relationship management (CRM), content management system (CMS), and website application to AWS.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Isha_foundation_logo%401x.0ae13a1aea1076cc36e57e458904db9d416c4862.png","displayLocation":"India","customerNameLower":"isha foundation","footerInfoText":"Published Date","industry":"Social Services","sortDate":"2022-10-31","headlineUrl":"https://aws.amazon.com/solutions/case-studies/isha-foundation-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ISHA Foundation","publishedDate":"2022","enableShare":"1","headline":"Isha Foundation Delivers on its Mission for Millions by Transforming Content Delivery on AWS","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#public-sector-nonprofit","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Nonprofit","description":"Nonprofit","dateCreated":"2019-07-22T18: