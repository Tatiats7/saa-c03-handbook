GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#category#saas","locale":"en_US","tagNamespaceId":"customer-references#category","name":"SaaS","description":"SaaS","dateCreated":"2019-07-22T18:32:20+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#payu-case-study","locale":"en_US","directoryId":"customer-references","name":"payu-case-study","dateCreated":"2022-10-11T20:29:37+0000","dateUpdated":"2023-07-14T23:32:33+0000","additionalFields":{"descriptionSummary":"PayU improves application performance by 50 percent, increases intrusion protection, and cuts audit time from days to minutes. The company provides payment gateway solutions to online businesses worldwide, serving more than 4.5 million merchants across India.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/PayU_logo%401x.34831f8b5445aacb3360d5f1866a4953913cc249.png","displayLocation":"India","customerNameLower":"payu","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/payu-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"PayU","publishedDate":"2022","enableShare":"1","headline":"PayU Helps Customers Make Secure Online Payments Faster by Streamlining Firewall Management on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#network-firewall","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Network Firewall","description":"AWS Network Firewall","dateCreated":"2021-11-17T07:15:44+0000","dateUpdated":"2022-02-03T03:32:52+0000"},{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#category#finserv","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Financial Services","description":"Financial Services","dateCreated":"2019-07-22T18:31:53+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"GLOBAL#product#global-accelerator","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Global Accelerator","description":"AWS Global Accelerator","dateCreated":"2020-03-02T07:03:39+0000","dateUpdated":"2022-02-03T03:32:39+0000"},{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#4bill-case-study","locale":"en_US","directoryId":"customer-references","name":"4bill-case-study","dateCreated":"2022-10-03T18:33:49+0000","dateUpdated":"2023-07-14T23:32:34+0000","additionalFields":{"descriptionSummary":"Payment service provider 4bill had trouble dealing with spikes in traffic as demand for its services grew. As a result its retail customers frequently encountered delays in processing payments due to poor latency. Using AWS, 4bill built a cloud solution that quickly adapts to variable demand and ensures customers can reliably receive payments. It has tripled its total customer base, and 98 percent of all online payment transactions complete successfully on the first attempt. Prior to using AWS, this conversion rate was 87 percent.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/4bill-logo%401x.c4231468c772b754092fc3b5396daf074882d5c2.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"4bill","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/4bill-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"4bill","publishedDate":"2022","enableShare":"1","headline":"4bill Scales Up Payment Processing and Triples Customer Base Using AWS","contentType":"Customer Story"}},"tags":[{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#location#ukraine","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Ukraine","description":"Ukraine","dateCreated":"2020-04-09T03:38:21+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#cee","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central \u0026 Eastern Europe","description":"Central \u0026 Eastern Europe","dateCreated":"2020-03-10T05:12:39+0000","dateUpdated":"2022-02-03T03:31:41+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#eu