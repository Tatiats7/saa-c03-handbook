tagNamespaceId":"GLOBAL#industry","name":"Transport \u0026 Logistics","description":"Transport \u0026 Logistics","dateCreated":"2020-06-25T04:08:39+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"}]},{"item":{"id":"customer-references#datadog-graviton-testimonial","locale":"en_US","directoryId":"customer-references","name":"datadog-graviton-testimonial","dateCreated":"2023-09-19T03:20:10+0000","dateUpdated":"2025-05-23T20:10:38+0000","additionalFields":{"descriptionSummary":"Datadog, a cloud monitoring and analytics platform company, needed to offer more product features and serve more customers. They were looking for new innovation that they can adopt to deliver more value for our customers. Datadog adopted AWS Graviton-based Amazon Elastic Compute Cloud (Amazon EC2) instances to pass savings to their customers by delivering more features per compute cycles and serving more customers with an identical number of cores.","featured":"0","featureImageURL":"https://d1.awsstatic.com/customer-references-case-studies-logos/datadog-partner-thumb.60e198fb473a4d49b69c5c00945fc006e0a781df.png","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/datadog-partner-thumb.60e198fb473a4d49b69c5c00945fc006e0a781df.png","displayLocation":"Americas","customerNameLower":"datadog","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/datadog-graviton-testimonial/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Datadog","publishedDate":"2023","enableShare":"1","headline":"Datadog Used AWS Graviton to Deliver More Value While Keeping Costs Constant","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"customer-references#category#compute","locale":"en