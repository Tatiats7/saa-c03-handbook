rth America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"customer-references#innovator#pinterest","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Pinterest","description":"Pinterest","dateCreated":"2022-09-15T00:48:40+0000","dateUpdated":"2022-09-15T00:48:40+0000"},{"id":"customer-references#big-rocks#aws-for-data","locale":"en_US","tagNamespaceId":"customer-references#big-rocks","name":"AWS for Data","description":"\u003cp\u003eAWS for Data is a marketing \u0026ldquo;Big Rock\u0026rdquo; initiative that tells the story around how AWS can provide the most comprehensive set of data capabilities spanning databases, analytics, business intelligence, and machine learning for an end-to-end data strategy.\u003c/p\u003e\n","dateCreated":"2024-02-14T22:32:15+0000","dateUpdated":"2024-02-14T22:32:15+0000"}]},{"item":{"id":"customer-references#itau-keynote","locale":"en_US","directoryId":"customer-references","name":"itau-keynote","dateCreated":"2023-04-19T23:11:12+0000","dateUpdated":"2024-04-19T02:49:41+0000","additionalFields":{"descriptionSummary":"Ricardo Guerra, CIO do Itaú Unibanco, divide um pouco da história de transformação digital da instituição. Ele explica que, na visão do banco, transformar-se tecnologicamente significa olhar para os pilares de tecnologia, o uso de dados em escala e a capacidade de inovar, tudo para entender o comportamento e as necessidades dos seus cerca de 65 milhões de clientes. Para contar com a modernização e flexibilidade necessárias para promover essa transformação, a instituição fechou um contrato de longo prazo com a AWS. Veja como o banco realizou, a partir do uso de tecnologias AWS, mais de 100 mil implantações em 2021, reduziu em 75% os incidentes que impactam o cliente e criou o Pix 100% na nuvem AWS, sendo responsável hoje por 20% de todo o volume de PIX no Brasil.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/itau_logo%401x.387d8a15132c385d83aa638d391b8802b2f31fc6.png","displayLocation":"Brasil","customerNameLower":"itaú","footerInfoText":"Data de publicação","industry":"Serviços financeiros","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/itau-keynote/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Itaú","publishedDate":"2022","enableShare":"1","headline":"Itaú Unibanco entende perfil de 65 milhões de clientes com serviços AWS","contentType":"História do cliente"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#devtools","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Developer Tools","description":"Developer Tools","dateCreated":"2020-01-16T17:43:16+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{