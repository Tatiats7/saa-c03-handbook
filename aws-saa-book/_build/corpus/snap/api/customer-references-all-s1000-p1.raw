 tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#coople04252022klnsefoinawf","locale":"en_US","directoryId":"customer-references","name":"coople04252022klnsefoinawf","dateCreated":"2023-02-08T01:17:40+0000","dateUpdated":"2023-02-08T01:38:40+0000","additionalFields":{"descriptionSummary":"Learn how Coople built a CQRS and event sourced system on AWS, processing nearly a million events per day, using serverless technologies including Amazon DynamoDB, AWS Lambda, Amazon SNS, and Amazon SQS. This architecture integrates the existing monolith with new and extracted domain services.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/coople-logo%401x.1ffce27e061395f7b05b5ea8129275fb0849388b.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"coople","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-04-25","headlineUrl":"https://youtu.be/WtCfHP6rUAY?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Coople","publishedDate":"2022","enableShare":"1","headline":"Coople: Serverless CQRS and Event Sourcing","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#customer-segment#