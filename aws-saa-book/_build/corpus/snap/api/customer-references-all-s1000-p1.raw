-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"}]},{"item":{"id":"customer-references#nkidgroup","locale":"en_US","directoryId":"customer-references","name":"nkidgroup","dateCreated":"2022-12-13T02:08:22+0000","dateUpdated":"2022-12-13T02:15:35+0000","additionalFields":{"descriptionSummary":"N KID Group was founded in 2009 in Vietnam with a vision to become a leader in children’s entertainment. The group operates 60 tiNiWorld play centers and 42 tiNiStore and provides digital engagement platforms for kids and parents. In 2016, the group introduced a mobile app and began a digital transformation to enrich its offline experience with online touchpoints. By migrating to AWS, the company cut operational costs by 30% and doubled the number of play centers and retail outlets in 2 years.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/n-kid-group-logo%401x.6643a4f6fa09d9d57d124660cc2ddf8fb365f87b.png","displayLocation":"Vietnam","customerNameLower":"n kid group","footerInfoText":"Published Date","industry":"Professional Services","sortDate":"2022-12-02","headlineUrl":"https://aws.amazon.com/solutions/case-studies/nkidgroup/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"N KID Group","publishedDate":"2022","enableShare":"1","headline":"N KID Group Modernizes Child’s Play on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00