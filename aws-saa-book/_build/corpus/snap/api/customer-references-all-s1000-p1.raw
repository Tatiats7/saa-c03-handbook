+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#chile","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Chile","description":"Chile","dateCreated":"2020-07-02T22:30:55+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"}]},{"item":{"id":"customer-references#skyangel","locale":"en_US","directoryId":"customer-references","name":"skyangel","dateCreated":"2023-06-01T23:04:09+0000","dateUpdated":"2023-06-08T04:07:43+0000","additionalFields":{"descriptionSummary":"Skyangel es una compañía que se especializa en proveer servicios de rastreo, geolocalización y seguridad de activos en México, Estados Unidos y Centroamérica, y realiza más de 200 mil entregas exitosas al año. Hoy cuenta con más de 650 clientes y el más amplio conocimiento e innovación tecnológica. Desde 2016 trabajan con AWS, con quien lograron una flexibilidad que les permitió ajustar la operación a sus demandas, crecimiento y nuevos servicios; asimismo, obtuvieron una continuidad operativa que les permite brindar un servicio continuo las 24 horas de los 365 días del año.","featured":"0","featureImageURL":"https://d1.awsstatic.com/industry-images-customer-references/autonomous%20Electric%20Van%20semi%20truck%20car%20driving%20on%20a%20highway%20with%20technology%20assistant.8c147d76c8f31abc337f897f4303d845a52225b7.jpg","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/skyangel%402x.598f64602fb191fe288ffe2e3127ce8ded9d3353.png","displayLocation":"México","customerNameLower":"skyangel","footerInfoText":"Fecha de publicac