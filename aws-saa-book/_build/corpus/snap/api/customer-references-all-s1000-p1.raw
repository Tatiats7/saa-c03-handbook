+0000","dateUpdated":"2022-06-27T20:44:45+0000","additionalFields":{"featured":"0","descriptionSummary":"Veracode has achieved scalability and improved the speed and quality of its vulnerability detection products by beginning its migration to a microservices architecture on AWS.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/veracode_Customer-Reference_Logo.8c2aeada0a092432679ab7f75173a465cac62a3b.png","displayLocation":"United States","customerNameLower":"veracode","footerInfoText":"Published Date","description":"\u003cp\u003eVeracode gives developers fast feedback on security risks, scales to support tens of thousands of vulnerability scans, and gets new features to market faster using Amazon Web Services. Veracode offers cloud-based application-security services. The company runs its Greenlight security-scan application on AWS Lambda and Amazon API Gateway.\u003c/p\u003e\r\n","industry":"Software \u0026 Internet","sortDate":"2022-06-24","headlineUrl":"https://aws.amazon.com/solutions/case-studies/veracode-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Veracode","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Veracode Strengthens Its Software Security Platform Using Scalable AWS Services"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#elasticache",