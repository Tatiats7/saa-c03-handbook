an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#amazonmusic-amplify-appsync-case-study","locale":"en_US","directoryId":"customer-references","name":"amazonmusic-amplify-appsync-case-study","dateCreated":"2022-09-07T02:30:38+0000","dateUpdated":"2023-07-19T03:04:55+0000","additionalFields":{"descriptionSummary":"Amazon Music used AWS AppSync and AWS Amplify to develop a centralized cloud-queuing solution that scales efficiently to support customer growth and facilitates new feature development and innovation.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/amazon-logo-1x.a64c3eedfb84347ecf50e210637c0cf810922e10.png","displayLocation":"United States","customerNameLower":"amazon music","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2022-09-06","headlineUrl":"https://aws.amazon.com/solutions/case-studies/amazonmusic-amplify-appsync-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Amazon Music","publishedDate":"2022","enableShare":"1","headline":"Amazon Music Unifies Music Queuing at Scale Using AWS AppSync and AWS Amplify","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Dynam