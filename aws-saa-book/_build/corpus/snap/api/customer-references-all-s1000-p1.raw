lytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#innovator#toyota","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Toyota","description":"Toyota","dateCreated":"2022-09-15T00:48:43+0000","dateUpdated":"2022-09-15T00:48:44+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"}]},{"item":{"id":"customer-references#city-of-charles-sturt","locale":"en_US","directoryId":"customer-references","name":"city-of-charles-sturt","dateCreated":"2022-03-24T02:43:36+0000","dateUpdated":"2022-03-24T02:46:29+0000","additionalFields":{"descriptionSummary":"The City of Charles Sturt (CCS) is a council in Adelaide that provides public services, facilities, and initiatives to serve 120,000 constituents. By migrating to the AWS Cloud, CCS improved service delivery by using Amazon VPC, Amazon EC2, and Amazon S3 to reduce the time required to provision servers from 4 weeks to 8 hours.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Charles_Sturt_logo%401x.7f5bb24851cf80