LOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#innovator#capital-one","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Capital One","description":"Capital One","dateCreated":"2022-04-25T19:05:47+0000","dateUpdated":"2022-07-16T00:04:47+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#product#iam","locale":"en_US","tagNamespaceId":"customer-references#product","name":"iam","description":"IAM","dateCreated":"2019-07-22T18:35:23+0000","dateUpdated":"2021-02-17T20:17:25+0000"},{"id":"GLOBAL#series#aws-reinvent","locale":"en_US","tagNamespaceId":"GLOBAL#series","name":"AWS re:Invent","description":"AWS re:Invent","dateCreated":"2021-06-04T06:36:32+0000","dateUpdated":"2022-02-03T03:33:29+0000"}]},{"item":{"id":"customer-references#zooparc-beauval-video","locale":"en_US","directoryId":"customer-references","name":"zooparc-beauval-video","dateCreated":"2023-07-18T00:09:27+0000","dateUpdated":"2023-09-07T23:50:16+0000","additionalFields":{"videoSrcUrl":"https://youtu.be/1jbMc6lLGeQ","descriptionSummary":"\u003cp\u003eFond\u0026eacute; en 1980, le ZooParc de Beauval est le premier zoo de France et le 4\u0026egrave;me plus beau zoo du monde. Il abrite plus de 35,000 animaux et plus de 800 esp\u0026egrave;ces diff\u0026eacute;rentes, au premier rang desquelles les fameux pandas g\u0026eacute;ants. Au global, ce sont 1,6 millions de visiteurs qui profitent du parc chaque ann\u0026eacute;e. Comprenant \u0026eacute;galement 4 \u0026eacute;tablissements h\u0026ocirc;teliers, des points de restauration et des boutiques, le zoo permet \u0026agrave; ses visiteurs de r\u0026eacute;server leur s\u0026eacute;jour int\u0026eacute;gralement en ligne. Amen\u0026eacute; \u0026agrave; accueillir un nombre important et variable de connexions, le site Internet du ZooParc de Beauval tire parti de la scalabilit\u0026eacute; et de l\u0026rsquo;\u0026eacute;lasticit\u0026eacute; du cloud AWS pour adapter son infrastructure \u0026agrave; la demande et garantir \u0026agrave; ses utilisateurs une disponibilit\u0026eacute; constante. Dans cette vid\u0026eacute;o, Sylvain Spodar, Directeur des Syst\u0026egrave;mes Informatiques du ZooParc de Beauval, nous explique comment le cloud permet \u0026agrave; l\u0026rsquo;entreprise de coordonner l\u0026#39;ensemble de son syst\u0026egrave;me informatique et plus sp\u0026eacute;cifiquement comment ses \u0026eacute;quipes utilisent les services de la plateforme pour stocker, extraire, traiter et analyser des quantit\u0026eacute;s de donn\u0026eacute;es tr\u0026egrave;s utiles au pilotage et \u0026agrave; la planification de leur activit\u0026eacute;.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/logo-zooparc-beauval.28bbaf4fb2d2cfdda4075a7088f1b515cbb85242.png","displayLocation":"Europe, Moyen-Orient et Afrique","footerInfoText":"Date de publication","industry":"Tourism","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/zooparc-beauval-video/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ZooParc de Beauval","enableShare":"1","publishedDate":"2022","contentType":"Témoignages clients","headline":"ZooParc de Beauval : le défi de la saisonnalité et du nombre exponentiel de visiteurs et de données"}},"tags":[{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#language#french","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"French","description":"French","dateCreated":"2020-03-03T06:40:44+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#ca