#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#reference-arch-diagram","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Reference Architecture Diagram","description":"Reference Architecture Diagram","dateCreated":"2020-04-29T05:19:31+0000","dateUpdated":"2022-02-03T03:31:09+0000"}]},{"item":{"id":"customer-references#bayes-esports-case-study","locale":"en_US","directoryId":"customer-references","name":"bayes-esports-case-study","dateCreated":"2022-06-27T20:43:43+0000","dateUpdated":"2022-06-27T20:55:42+0000","additionalFields":{"descriptionSummary":"Competitive, organized gaming—known as esports—is a billion-dollar market with millions of viewers. Video game players take part in global tournaments and win million-dollar sponsorship deals, while fans place bets on match outcomes. Germany’s Bayes Esports built a data platform on Amazon Web Services (AWS) that uses machine learning algorithms to generate accurate, reliable, real-time gaming odds to support betting for 10,000 global tournaments each year. Using AWS, the company can scale its compute resources to handle spikes in demand for data and deliver the best experience for esports bettors.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/bayes-esports-logo%401x.06450c3ae3b2e0ccbad32f04047f6b2bc431f789.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"bayes esports","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2022-06-24","headlineUrl":"https://aws.amazon.com/solutions/case-studies/bayes-esports-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Bayes Esports","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Bayes Esports Generates Real-Time Betting Odds for Global Video Game Competitions Using AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated"