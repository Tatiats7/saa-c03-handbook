ustomer-references","name":"verato-case-study","dateCreated":"2022-03-05T03:54:50+0000","dateUpdated":"2023-07-14T23:32:27+0000","additionalFields":{"descriptionSummary":"Verato uses Lyniate Rhapsody as a Service (RaaS) on AWS to quickly integrate data from millions of patient records while maintaining 99.999% uptime. Verato is a software provider that specializes in master person indexing, a service that empowers a 360-degree view of patients within healthcare organizations. The RaaS data integration engine uses Amazon EC2 instances, and Amazon S3 with Amazon EBS for data storage.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Verato_logo%401x.cd33f3123335b7290670ab27764ea0704c658f3c.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2022-03-04","headlineUrl":"https://aws.amazon.com/solutions/case-studies/verato-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","customer-name":"Verato","contentType":"Customer Story","headline":"Verato Creates More Connected Care with Lyniate Rhapsody on AWS"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T0