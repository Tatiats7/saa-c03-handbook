general-database-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"General Database Migration","description":"General Database Migration","dateCreated":"2020-06-05T06:37:24+0000","dateUpdated":"2022-02-03T03:35:41+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#location#central-america","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Central America","description":"Central America","dateCreated":"2021-02-19T05:32:25+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#industry#general-public-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"General Public Services","description":"General Public Services","dateCreated":"2020-01-16T17:42:24+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#product#elb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Elastic Load Balancing (ELB)","description":"Elastic Load Balancing (ELB)","dateCreated":"2020-03-02T07:03:09+0000","dateUpdated":"2022-02-03T03:32:34+0000"}]},{"item":{"id":"customer-references#cleber-amazon-connect","locale":"en_US","directoryId":"customer-references","name":"cleber-amazon-connect","dateCreated":"2023-06-01T23:04:28+0000","dateUpdated":"2023-06-08T04:07:42+0000","additionalFields":{"descriptionSummary":"Cleber es una empresa automotriz, que se dedica a la venta y servicios de autos. Funciona bajo un modelo de agencias de autos nuevos, que maneja marcas como Toyota, Honda, Nissan, entre otras. Son un total de 17 marcas diferentes en 50 puntos distribuidos en distintas regiones de la República Mexicana. Uno de los retos a los que se enfrentaba era poder unificar la información de cada agencia. Lo prioritario era crear un departamento corporativo de TI que diera servicio a toda la empresa; para ello fue necesario crear la infraestructura y los servicios de manera rápida y eficiente. Así fue como llegaron a Amazon Web Services, donde les ayudaron a generar lo necesario para que se cumpliera con dicha meta.","featured":"0","featureImageURL":"https://d1.awsstatic.com/industry-images-customer-references/cleber-car-seller.65d88be27b28fbb3c7be945fd998bf39402181e7.jpg","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/cleber-logo%402x.715310971815da29f08afb16d6f0b8480a77c779.png","displayLocation":"México","customerNameLower":"cleber","footerInfoText":"Fecha de publicación","industry":"Servicios profesionales","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/cleber-amazon-connect/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Cleber","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"Cleber ofrece un servicio unificado y de alta calidad gracias a Amazon Connect"}},"tags":[{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#location#mexico","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Mexico","description":"Mexico","dateCreated":"2020-04-09T00:25:53+0000","dateUpdated":"2022-02-03T03:31:31+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#industry#prof-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Professional Service