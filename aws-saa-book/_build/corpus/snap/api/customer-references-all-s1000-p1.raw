g and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#savana-natural-language-case-study","locale":"en_US","directoryId":"customer-references","name":"savana-natural-language-case-study","dateCreated":"2022-07-16T00:00:54+0000","dateUpdated":"2023-07-14T23:32:45+0000","additionalFields":{"descriptionSummary":"Madrid-based Savana helps healthcare providers to unlock the value of their electronic medical records (EMRs) for research purposes. It combines research-grade methodology with natural language processing (NLP) and predictive analytics to obtain relevant results for healthcare and life science providers investigating disease prevention and treatment.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-customer-content/Savana_Logo.946df5cadbb50c86ebd7245cd69442ee47c86a8c.png","displayLocation":"Spain","customerNameLower":"savana","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-07-15","headlineUrl":"https://aws.amazon.com/solutions/case-studies/savana-natural-language-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Savana","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Savana Builds World’s Only Natural Language Processing Clinical Research Network on AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated"