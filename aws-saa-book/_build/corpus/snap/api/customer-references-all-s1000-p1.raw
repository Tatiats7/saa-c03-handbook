sempre não possuem recursos tecnológicos para hospedar e dar suporte às aplicações. Há cerca de três anos, a empresa ofereceu ao mercado a versão em nuvem de sua plataforma e, somente no estado de São Paulo, o número de clientes saltou de 4 para 70.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/govbr-logo%402x.9d80d0be7ffd8c482d435c4b9eb360db71bc8121.png","displayLocation":"Brasil","customerNameLower":"governança brasil","footerInfoText":"Data de publicação","industry":"Software e Internet","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/govbr/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Governança Brasil","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"Governança Brasil amplia em 40% o número de clientes em nuvem"}},"tags":[{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#euc","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"End-User Computing (EUC)","description":"End-User Computing (EUC)","dateCreated":"2020-01-16T17:43:18+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#use-case#general-database-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"General Database Migration","description":"General Database Migration","dateCreated":"2020-06-05T06:37:24+0000","dateUpdated":"2022-02-03T03:35:41+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCr