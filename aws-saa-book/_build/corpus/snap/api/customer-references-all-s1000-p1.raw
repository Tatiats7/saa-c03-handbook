0"},{"id":"customer-references#big-rocks#aws-for-data","locale":"en_US","tagNamespaceId":"customer-references#big-rocks","name":"AWS for Data","description":"\u003cp\u003eAWS for Data is a marketing \u0026ldquo;Big Rock\u0026rdquo; initiative that tells the story around how AWS can provide the most comprehensive set of data capabilities spanning databases, analytics, business intelligence, and machine learning for an end-to-end data strategy.\u003c/p\u003e\n","dateCreated":"2024-02-14T22:32:15+0000","dateUpdated":"2024-02-14T22:32:15+0000"}]},{"item":{"id":"customer-references#tapestry-case-study","locale":"en_US","directoryId":"customer-references","name":"tapestry-case-study","dateCreated":"2022-09-22T02:55:35+0000","dateUpdated":"2024-03-02T02:48:46+0000","additionalFields":{"descriptionSummary":"Fashion house Tapestry has broken down data silos and expanded its ML capabilities by using Amazon API Gateway, helping it fulfill half a million API calls daily and personalized customer service.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/tapestry-logo%401x.44ef7345ddcd0ebafdf978c9f5efc8de5f6ccbdc.png","displayLocation":"United States","customerNameLower":"tapestry","footerInfoText":"Published Date","industry":"Retail","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/tapestry-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Tapestry","publishedDate":"2022","enableShare":"1","headline":"Tapestry Gains 360-Degree View of Customers by Powering Data and Analytics on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","descript