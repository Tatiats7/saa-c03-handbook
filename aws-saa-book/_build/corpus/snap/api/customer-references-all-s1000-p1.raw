applied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#dynata-case-study","locale":"en_US","directoryId":"customer-references","name":"dynata-case-study","dateCreated":"2023-01-30T22:40:05+0000","dateUpdated":"2024-02-20T22:25:50+0000","additionalFields":{"descriptionSummary":"Dynata uses Amazon Pinpoint to centrally manage communications, automate campaign management, and drive better customer engagement through improved visibility.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/dynata-logo%401x.3dbd3272bf93802fbccd8b68750acb2f1ed1fb43.png","displayLocation":"United States","customerNameLower":"dynata","footerInfoText":"Published Date","industry":"Digital Marketing","sortDate":"2023-01-11","headlineUrl":"https://aws.amazon.com/solutions/case-studies/dynata-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Dynata","publishedDate":"2023","enableShare":"1","headline":"Dynata Automates Marketing Communications Using Amazon Pinpoint","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#pinpoint","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Pinpoint","description":"Amazon Pinpoint","dateCreated":"2020-03-02T07:04:51+0000","dateUpdated":"2022-02-03T03:32:54+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T0