07:15:42+0000","dateUpdated":"2022-02-03T03:32:51+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"customer-references#category#business-resilience","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Resilience","description":"\u003cp\u003eIn business, resilience means dealing with adversity and shocks, and continuously adapting for growth.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:01:43+0000","dateUpdated":"2023-07-14T01:01:43+0000"}]},{"item":{"id":"customer-references#yelloh-case-study","locale":"en_US","directoryId":"customer-references","name":"yelloh-case-study","dateCreated":"2023-05-11T00:15:18+0000","dateUpdated":"2024-02-21T00:20:53+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eYelloh (formerly Schwan\u0026rsquo;s Home Delivery) wanted to transform into a modern mobile retailer. They wanted to become more effective in how they connect with customers and employees to ultimately enhance their food delivery operational model. Using Amazon Personalize, Yelloh is able to generate personalized product recommendations. They can now suggest new food items customers might like, based on previous orders and like-buyer baskets. This case study explains how this increased brand loyalty and purchase orders for the company.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/yelloh-logo%401x.057670cea933500618a605535e89622349adb531.png","displayLocation":"United States","customerNameLower":"yelloh","footerInfoText":"Published Date","industry":"Consumer Packaged Goods (CPG)","sortDate":"2023-05-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/yelloh-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Yelloh","publishedDate":"2023","enableShare":"1","headline":"Schwan Home Delivery Makes Connections Using Amazon Personalize","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#pinpoint","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Pinpoint","description":"Amazon Pinpoint","dateCreated":"2020-03-02T07:04:51+0000","dateUpdated":"2022-02-03T03:32:54+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"America