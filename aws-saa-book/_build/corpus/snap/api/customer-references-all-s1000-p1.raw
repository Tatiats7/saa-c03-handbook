"Fox","dateCreated":"2022-09-15T00:48:29+0000","dateUpdated":"2022-09-15T00:48:29+0000"},{"id":"GLOBAL#series#aws-reinvent","locale":"en_US","tagNamespaceId":"GLOBAL#series","name":"AWS re:Invent","description":"AWS re:Invent","dateCreated":"2021-06-04T06:36:32+0000","dateUpdated":"2022-02-03T03:33:29+0000"},{"id":"customer-references#innovator#engie","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"ENGIE","description":"ENGIE","dateCreated":"2022-09-15T00:48:27+0000","dateUpdated":"2022-09-15T00:48:27+0000"},{"id":"customer-references#innovator#itau","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"itau","description":"\u003cp\u003eInnovator introduced in 2023.\u003c/p\u003e\n","dateCreated":"2023-08-10T19:03:48+0000","dateUpdated":"2023-08-10T19:03:48+0000"}]},{"item":{"id":"customer-references#stoodi","locale":"en_US","directoryId":"customer-references","name":"stoodi","dateCreated":"2023-06-01T23:05:03+0000","dateUpdated":"2024-04-30T13:24:05+0000","additionalFields":{"descriptionSummary":"Criada em 2013, o Stoodi é uma startup de educação, parte do grupo Cogna, que tem o objetivo de ajudar estudantes do ensino médio a ingressarem no ensino superior. Desde sua fundação, os recursos de preparação para o Enem e vestibulares da startup foram utilizados por mais de 8 milhões de alunos. A operação do Stoodi já nasceu na nuvem AWS, mas o crescimento acelerado alavancado pelo período de pandemia exigiu da startup uma operação mais eficiente da nuvem, garantindo estabilidade, disponibilidade e segurança. O Stoodi passou a contar com a área de Professional Services da AWS, obtendo ganhos como redução anual total de 25% dos custos totais de AWS que foram parcialmente investidos para melhorar a estabilidade e postura de segurança dos seus produtos.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/stoodi%402x.464772c8a1590a9693032496b334c3b0d9a31402.png","displayLocation":"Brasil","customerNameLower":"stoodi","footerInfoText":"Data de publicação","industry":"Educação","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/stoodi/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Stoodi","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"Uso de Serviços Profissionais AWS reduz em 25% gastos totais com nuvem do Stoodi"}},"tags":[{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#kinesis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis","description":"Amazon Kinesis","dateCreated":"2020-03-02T07:04:15+0000","dateUpdated":"2022-02-03T03:32:45+0000"},{"id":"GLOBAL#business-category#cloud-cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-06-05T07:06:41+0000","dateUpdated":"2022-02-03T03:31:02+0000"},{"id":"GLOBAL#product#ses","locale":"en_US","tagName