k\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Vietnam National University Delivers Engaging and Seamless Language Learning on AWS Cloud","customer-name":"University of Languages and International Studies of Vietnam National University"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#vietnam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Vietnam","description":"Vietnam","dateCreated":"2020-02-03T05:29:42+0000","dateUpdated":"2022-02-03T03:31:37+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#asean","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"ASEAN","description":"ASEAN","dateCreated":"2020-08-20T03:53:05+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"GLOBAL#use-case#datacenter-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2020-08-18T05:17:48+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","descr