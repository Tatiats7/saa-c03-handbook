udFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"}]},{"item":{"id":"customer-references#11st","locale":"en_US","directoryId":"customer-references","name":"11st","dateCreated":"2022-03-05T03:54:39+0000","dateUpdated":"2022-03-05T03:56:33+0000","additionalFields":{"descriptionSummary":"11Street built its in-house live commerce solution, LIVE11, on AWS to improve scalability and enrich two-way communication with viewers. 11Street is South Korea’s leading ecommerce marketplace, with 47 million members. The LIVE11 solution uses Amazon IVS for low-latency live streaming, Amazon MSK for real-time messaging, and Amazon ElastiCache as an in-memory data store and caching service.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/SK_Group_11st_logo%401x.5304cddf0087dfbd1c48a131e94678d6aaadf13b.png","displayLocation":"Korea","footerInfoText":"Published Date","industry":"Retail","sortDate":"2022-03-04","headlineUrl":"https://aws.amazon.com/solutions/case-studies/11st/?nc1\u003dh_ls\u0026did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"11Street Builds Low-Latency, Live Commerce Interactive Shopping Solution on AWS","customer-name":"11Street"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#elasticache","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache","description":"Amazon ElastiCache","dateCreated":"2020-03-03T00:13:21+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#industry#retail","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Retail","description":"Retail","dateCreated":"2020-01-16T17:42:39+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asi