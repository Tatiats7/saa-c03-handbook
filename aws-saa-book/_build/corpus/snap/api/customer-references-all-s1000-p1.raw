toryId":"customer-references","name":"creative5","dateCreated":"2022-01-29T03:26:27+0000","dateUpdated":"2022-09-09T00:34:16+0000","additionalFields":{"descriptionSummary":"Creative5 built its solar energy management solution on AWS to leverage cloud-native agility in development and limitless scaling for its products. Based in Taiwan, Creative5 provides integrated IoT hardware and software solutions to solar energy providers. The company is using AWS IoT Core to connect legacy solar panels to the internet, AWS Lambda for serverless integrations, and Amazon Lightsail for online monitoring dashboards.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Creative5%20Logo.b48d1f1e70bb048d306f0ad55402e447950e0c71.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","industry":"Professional Services","sortDate":"2022-01-28","headlineUrl":"https://aws.amazon.com/solutions/case-studies/creative5/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Creative5","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Creative5 Enhances Traditional Solar Panel Monitoring on AWS"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#iot-core","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS IoT Core","description":"AWS IoT Core","dateCreated":"2020-03-02T07:04:00+0000","dateUpdated":"2022-02-03T03:32:42+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},