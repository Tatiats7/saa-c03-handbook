00"}]},{"item":{"id":"customer-references#8percent-women-in-tech-video","locale":"en_US","directoryId":"customer-references","name":"8percent-women-in-tech-video","dateCreated":"2022-10-20T21:26:56+0000","dateUpdated":"2022-10-20T22:22:58+0000","additionalFields":{"descriptionSummary":"Hyojin Lee, founder \u0026 CEO, 8PERCENT, believes that an online mid-interest rate, loan-based business was needed to bridge the lending gap when she first started the company in 2014. This is the philosophy behind the peer-to-peer lending platform, where she aims to help grow the wealth of ordinary folks investing via the app.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/8percent-logo%401x.1280839b110251d627a90aca24761fafc56fd77d.png","displayLocation":"Korea","customerNameLower":"8percent","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2022-01-19","headlineUrl":"https://www.youtube.com/watch?v\u003dZQK58D870f8\u0026did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"8PERCENT","publishedDate":"2022","enableShare":"1","headline":"AWS Women in Tech Series - 8PERCENT | Amazon Web Services","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"customer-references#category#diversity","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Diversity, Equity, and Inclusion","description":"Diversity, Equity, and Inclusion","dateCreated":"2022-04-06T14:31:56+0000","dateUpdated":"2022-10-20T21:26:49+0000"},{"id":"GLOBAL#location#korea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Korea","description":"Korea","dateCreated":"2020-02-03T05:29:25+0000","dateUpdated":"2022-02-03T03:31:39+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#language#korean","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Korean","description":"Korean","dateCreated":"2020-03-03T06:40:52+0000","dateUpdated":"2022-02-03T03:31:25+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"}]},{"item":{"id":"customer-references#maf01192022jkbsefjbadw","locale":"en_US","directoryId":"customer-references","name":"maf01192022jkbsefjbadw","dateCreated":"2022-05-23T21:42:13+0000","dateUpdated":"2022-12-19T23:25:45+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eMajid Al Futtaim built a custom data management solution on AWS platform and adopted a new-age approach to working built on agile methodology and collaboration principles. This strategy allowed transformation to be completed with unprecedented speed, accelerated people adoption, with results apparent in a matter of months instead of years. This architecture created foundation for a single source of truth for data across the business. The solution\u0026rsquo;s data Ingestion Layer built on Kafka running on EKS cluster, connected to Amazon OpenSearch Service, graph database and S3 as a Data lake, in the Consumption layer: Amazon Aurora and a data warehouse on EC2.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/majid-al-futtaim-logo%401x.e15a5b3c7cbba449bb355dd9d5fc75915bfaea5d.png","displayLocation":"Europe, Middle East, \u0026 Africa","footerInfoText":"Published Date","industry":"Retail","sortDate":"2022-01-19","headlineUrl":"https://youtu.be/9qTEHITVeLE?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Majid Al Futtaim","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Majid Al Futtaim: Building a Custom Data Management Solution on AWS"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"G