ateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#media-services","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Media Services","description":"Media Services","dateCreated":"2020-07-17T03:06:10+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#content-type#reference-arch-diagram","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Reference Architecture Diagram","description":"Reference Architecture Diagram","dateCreated":"2020-04-29T05:19:31+0000","dateUpdated":"2022-02-03T03:31:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#nissan-europe-case-study","locale":"en_US","directoryId":"customer-references","name":"nissan-europe-case-study","dateCreated":"2022-05-03T00:28:36+0000","dateUpdated":"2022-05-03T00:36:27+0000","additionalFields":{"descriptionSummary":"After migrating its SAP infrastructure to AWS, the company additionally reduced and compressed its database by using Amazon Elastic Compute Cloud (Amazon EC2), a web service that provides secure, resizable compute capacity in the cloud. Nissan in Europe achieved 63 percent faster processing times and reduced database recovery times significantly using snapshots from Amazon Elastic Block Store (Amazon EBS), an easy-to-use, scalable, high-performance block storage service designed for Amazon EC2.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/nissan-logo-2020-black-1x-200x164.bbd595445c3a024e78e65a06a42fee35c94df350.png","displayLocation":"Europe","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2022-04-29","headlineUrl":"https://aws.amazon.com/solutions/case-studies/nissan-europe-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Nissan in Europe Achieves Faster Processing, Lowers Recovery Time for SAP System Using Amazon EC2","customer-name":"Nissan in Europe"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#category#business-applications-sap","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: SAP","description":"Business Applications: SAP","dateCreated":"2019-07-22T18:31:24+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","des