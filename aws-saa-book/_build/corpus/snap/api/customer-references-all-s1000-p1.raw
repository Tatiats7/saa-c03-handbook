01:40+0000","dateUpdated":"2022-02-03T03:32:19+0000"},{"id":"GLOBAL#workload#microsoft","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"Microsoft","description":"Microsoft","dateCreated":"2021-01-06T00:09:49+0000","dateUpdated":"2022-02-03T03:36:04+0000"},{"id":"GLOBAL#product#control-tower","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Control Tower","description":"AWS Control Tower","dateCreated":"2020-03-02T07:02:23+0000","dateUpdated":"2022-02-03T03:32:26+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"customer-references#category#mgmt-governance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2019-07-22T18:32:10+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"GLOBAL#product#ec2-spot-instances","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Spot Instances","description":"Amazon EC2 Spot Instances","dateCreated":"2022-04-26T06:27:16+0000","dateUpdated":"2022-04-26T06:27:16+0000"},{"id":"GLOBAL#product#elb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Elastic Load Balancing (ELB)","description":"Elastic Load Balancing (ELB)","dateCreated":"2020-03-02T07:03:09+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"}]},{"item":{"id":"customer-references#uala-case-study","locale":"en_US","directoryId":"customer-references","name":"uala-case-study","dateCreated":"2023-06-01T23:04:36+0000","dateUpdated":"2023-07-14T23:32:38+0000","additionalFields":{"descriptionSummary":"Ualá es una empresa de servicios financieros que trabaja constantemente en brindar nuevas soluciones para mejorar la vida financiera de las personas y de comercios. Con operaciones en México, Colombia y Argentina, la compañía fue lanzada en 2017.\nHoy con más de 5 millones de usuarios, Ualá quiere alcanzar los 25 millones en la región en no más que cinco años. Ezequiel Mina, director de tecnología de Ualá, explica cómo la empresa se preparó para el éxito del negocio: apuntó hacia servicios escalables; construyó una arquitectura utilizando Amazon API Gateway, AWS Lambda y Amazon DynamoDB. \"Pasados cinco años, tenemos exactamente la misma arquitectura que el primer día\", dice Mina.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/uala-logo%402x.3a78f8fb13fd0a634b4b9fab034d91a0e10b2557.png","displayLocation":"Argentina","customerNameLower":"ualá","footerInfoText":"Fecha de publicación","industry":"Servicios financieros","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/uala-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ualá","enableShare":"1","publishedDate":"2023","contentType":"Historia del cliente","headline":"Ualá Quiere Llegar a 25 Millones de Usuarios Utilizando AWS"}},"tags":[{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#api-gateway","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon API Gateway","description":"Amazon API Gateway","dateCreated":"2020-03-02T07:01:25+0000","dateUpdated":"2022-02-03T03:32:16+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#location#argentina","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Argentina","description":"Argentina","dateCreated":"2020-06-12T23:30:42+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#skyalert-en-from-es-directory","locale":"en_US","directoryId":"customer-references","name":"skyalert-en-from-es-directory","dateCreated":"2024-02-03T03:47:58+0000","dateUpdated":"2024-02-06T01:35:37+0000","additionalFields":{"descriptionSummary":"SkyAlert is an innovative technology company that quickly alerts millions of people living in earthquake-prone areas, promoting a culture of prevention against natural disasters. In order to provide customers—both businesses and individuals—with the right tools to protect them during earthquakes, SkyAlert migrated its infrastructure from Microsoft Azure to Amazon Web Services (AWS). After implementing its Internet of Things (IoT) solution to run on AWS and its efficient alert service, SkyAlert scales quickly and can send millions of messages in a few seconds, helping to save lives in the event of earthquakes.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/skyalert_logo%401x.27b39f5ae8919cd5eac26ac7e8af6df26e3df29d.png","displayLocation":"Mexico","customerNameLower":"skyalert","footerInfoText":"Published Date","industry":"Manufacturing","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/skyalert/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"SkyAlert","enableShare":"1","publishedDate":"2023","contentType":"Customer Story","headline":"SkyAlert Helps Save Lives from Natural Disasters Using AWS Solutions"}},"tags":[{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Internet of Things (IoT)","description