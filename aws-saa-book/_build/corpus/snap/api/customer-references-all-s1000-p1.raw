der mondial des solutions tubulaires offre \u0026agrave; ses clients industriels une nouvelle exp\u0026eacute;rience digitale r\u0026eacute;invent\u0026eacute;e gr\u0026acirc;ce au d\u0026eacute;ploiement de nouveaux services web qui tirent toute la puissance du cloud AWS.\u003c/p\u003e\r\n","featured":"0","featureImageURL":"https://d1.awsstatic.com/%c3%89tude%20de%20cas%20AWS%20%20Vallourec%20-%20Image.1d7aa6412363b4547d4a1e598e78399f931167bc.jpg","imageSrcUrl":"https://d1.awsstatic.com/%c3%89tude%20de%20cas%20AWS%20%20Vallourec%20-%20Logo.a814ae55f42815820f06172793f0d719e08ea1ad.jpg","displayLocation":"France","customerNameLower":"vallourec","footerInfoText":"Date de publication","industry":"Industrie manufacturière","sortDate":"2022-06-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/vallourec/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Vallourec","enableShare":"1","publishedDate":"2022","contentType":"Témoignages clients","headline":"E-commerce, marketplace, dématérialisation : Vallourec disrupte son modèle avec AWS"}},"tags":[{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:3