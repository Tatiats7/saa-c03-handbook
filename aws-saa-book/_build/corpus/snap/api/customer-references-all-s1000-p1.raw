000"},{"id":"customer-references#category#remote-work-learning","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Remote Work \u0026 Learning","description":"Remote Work \u0026 Learning","dateCreated":"2020-08-31T22:04:33+0000","dateUpdated":"2022-03-24T02:42:25+0000"},{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2019-09-23T21:02:31+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#use-case#remote-work-learning","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Remote Work \u0026 Learning","description":"Remote Work \u0026 Learning","dateCreated":"2020-08-20T04:26:30+0000","dateUpdated":"2022-02-03T03:35:55+0000"}]},{"item":{"id":"customer-references#university-of-newcastle-case-study","locale":"en_US","directoryId":"customer-references","name":"university-of-newcastle-case-study","dateCreated":"2022-03-24T02:44:08+0000","dateUpdated":"2022-03-24T02:46:39+0000","additionalFields":{"descriptionSummary":"With the knowledge that technology and digital capability are key enablers of innovation, the University of Newcastle began migrating the majority of its application portfolio to the AWS Cloud in 2019. The University planned a phased journey to the cloud the year prior, with an initial migration timeline of 18–24 months for target workloads. However, its leaders then learned that its physical data centre was scheduled for demolition and they had to exit the facility by September 2020. This prompted the decision in late 2018 to fully migrate to AWS. The University believed a cloud-first strategy would further help it compete and differentiate itself in the higher education sector. Exiting the data centre also aligned with their Environmental Sustainability commitment.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/university-of-newcastle-logo%401x.5e62d489df3d57d21475502686978eb218facc6e.png","displayLocation":"Australia","footerInfoText":"Published Date","industry":"Education","sortDate":"2022-03-23","headlineUrl":"https://aws.amazon.com/solutions/case-studies/university-of-newcastle-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"University of Newcastle Digitises Its Student and Researcher Experience on AWS","customer-name":"University of Newcastle"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#australia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia","description":"Australia","dateCreated":"2020-02-03T05:29:12+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"customer-references#category#datacenter-migration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2019-07-22T18:31:44+0000","dateUpdated":"2022-02-19T04:21:23+0000"},{"id":"customer-references#category#migration-transfer","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Migration \u0026 Transfer","description":"Migration \u0026 Transfer","dateCreated":"2019-07-22T18:32:12+0000","dateUpdated":"2022-02-12T02:01:29+0000"},{"id":"GLOBAL#use-case#datacenter-migration","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Datacenter Migration","description":"Datacenter Migration","dateCreated":"2020-08-18T05:17:48+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#guardduty","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon GuardDuty","description":"Amazon GuardDuty","dateCreated":"2020-03-02T07:03:46+0000","dateUpdated":"2022-02-03T03:32:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateC