ustry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"customer-references#customer-enablement#skills-guild","locale":"en_US","tagNamespaceId":"customer-references#customer-enablement","name":"Skills Guild","description":"\u003cp\u003eTag created in response to this request: https://issues.amazon.com/CSDIR-298\u003c/p\u003e\n\n\u003cp\u003eAWS Skills Guild is a consultative engagement designed to inspire organization-wide cloud adoption and unlock innovation. It accelerates the cultural and technological shifts necessary for transformation by helping develop and launch a bespoke cloud enablement initiative using the AWS Skills Guild framework. Each engagement uses cloud excitement, skills application, and community development to layer formal education with hands-on training activities \u0026ndash; ultimately increasing cloud skill confidence and igniting a culture of continuous learning.\u003c/p\u003e\n","dateCreated":"2023-07-05T23:40:01+0000","dateUpdated":"2023-07-05T23:40:01+0000"}]},{"item":{"id":"customer-references#toyota-ecs-case-study","locale":"en_US","directoryId":"customer-references","name":"toyota-ecs-case-study","dateCreated":"2023-01-26T19:52:45+0000","dateUpdated":"2025-05-17T00:14:47+0000","additionalFields":{"descriptionSummary":"TMNA built the internal development platform Chofer using Backstage and AWS to simplify application development, reduce costs, and help its teams securely deploy new applications faster than before.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/toyota-logo%401x.c83b34d7e548358fef55603b0869cee53cc6a4b0.png","displayLocation":"United States","customerNameLower":"toyota motor north america","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2022-12-05","headlineUrl":"https://aws.amazon.com/solutions/case-studies/toyota-ecs-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Toyota Motor North America","publishedDate":"2022","enableShare":"1","headline":"Building a Development Platform to Support Secure Application Deployment Using Backstage and AWS with Toyota Motor North America","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"