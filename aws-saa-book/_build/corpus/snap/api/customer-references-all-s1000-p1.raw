ces","name":"flagship-group-case-study","dateCreated":"2022-05-14T20:13:59+0000","dateUpdated":"2023-07-14T23:32:44+0000","additionalFields":{"descriptionSummary":"Flagship Group owns more than 32,000 homes that house approximately 75,000 tenants across the East of England. Flagship had already planned a migration to AWS to improve the quality and reliability of its services. Due to a cyberattack in November 2020, that plan was accelerated. Flagship migrated its contact center to Amazon Connect in only 3 days, and delivered the rest of a cloud migration—which was originally scheduled to take place over 6 months—in just 4 weeks.","imageSrcUrl":"https://d1.awsstatic.com/emea-customer-references/emea-directory-customer-logos/FlagshipGroup-Customer-References-Logo%401x.6c21346a85edbbdffc2a23a53cbf96edaf49ea54.png","displayLocation":"Europe, Middle East, \u0026 Africa","footerInfoText":"Published Date","industry":"Social Services","sortDate":"2022-05-13","headlineUrl":"https://aws.amazon.com/solutions/case-studies/flagship-group-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","customer-name":"Flagship Group","contentType":"Customer Story","headline":"Flagship Group Quickly Solves Contact Center Challenge Using Amazon Connect"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#connect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Connect","description":"Amazon Connect","dateCreated":"2020-03-02T07:02:22+0000","dateUpdated":"2022-02-03T03:32:26+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"customer-references#categor