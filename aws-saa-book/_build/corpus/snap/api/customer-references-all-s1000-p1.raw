ket","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#location#argentina","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Argentina","description":"Argentina","dateCreated":"2020-06-12T23:30:42+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"}]},{"item":{"id":"customer-references#elmarques-variation1","locale":"en_US","directoryId":"customer-references","name":"elmarques-variation1","dateCreated":"2023-06-01T23:06:30+0000","dateUpdated":"2023-06-08T04:07:40+0000","additionalFields":{"descriptionSummary":"El Marqués es un importante municipio del estado de Querétaro, en México. Se caracteriza por las inversiones nacionales y transnacionales que recibe, tanto el sector industrial como comercial. Además de ser líder mundial en el sector aeronáutico y aeroespacial, tiene un desarrollo exponencial en proyectos habitacionales, centros comerciales, fábricas y bodegas logísticas. El trabajo en conjunto con AWS se encaminó hacia la mejora de los servicios digitales para la ciudadanía, lo cual redundó en mayor recaudación para el municipio y en más eficiencia para los procesos de cobro.","featureImageURL":"https://d1.awsstatic.com/industry-images-customer-references/Hacienda_Atongo_Oct_24_JVQ_1-1200x800.108d7f01526216833072fdc1833f440e15087e8e.jpg","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/elmarques%402x.4bbc069bd4eec158558cc0840c72a2726ff4d4f6.png","displayLocation":"México","customerNameLower":"él marques","footerInfoText":"Fecha de publicación","industry":"Servicios públicos generales","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/elmarques/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Él Marques","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"El Marqués digitaliza servicios para beneficio de la población, con AWS"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#connect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Connect","description":"Amazon Connect","dateCreated":"2020-03-02T07:02:22+0000","dateUpdated":"2022-02-