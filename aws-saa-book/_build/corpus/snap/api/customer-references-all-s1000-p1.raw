"customer-references","name":"pageindustries","dateCreated":"2022-02-19T05:01:52+0000","dateUpdated":"2022-02-21T16:34:20+0000","additionalFields":{"descriptionSummary":"Page Industries implemented Vinculum’s suite of solutions on AWS to automate integrations for its 15,000 SKUs across 10 online marketplaces. Page Industries is the franchisee of the Jockey and Speedo retail brands in India and six surrounding countries. Among other Vinculum solutions, it’s using eRetail Suite, built using Amazon RDS to manage databases, Amazon ECS for container orchestration, and AWS Security Hub to automate security alerts.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/jockey-page-industries-logo%401x.c0ea8e82ef330f1d579d3ad80f34ad3ba3022a69.png","displayLocation":"India","footerInfoText":"Published Date","industry":"Manufacturing","sortDate":"2022-02-18","headlineUrl":"https://aws.amazon.com/solutions/case-studies/pageindustries/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Page Industries Scales Apparel Order Volume by 6X with Vinculum Retail Solution on AWS","customer-name":"Page Industries"}},"tags":[{"id":"GLOBAL#location#india","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"India","description":"India","dateCreated":"2020-02-03T05:29:20+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#product#security-hub","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Security Hub","description":"AWS Security Hub","dateCreated":"2020-03-02T07:05:15+0000","dateUpdated":"2022-02-03T03:32:59+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dat