0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#use-case#data-lakes","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Data Lakes","description":"Data Lakes","dateCreated":"2020-06-05T06:37:09+0000","dateUpdated":"2022-02-03T03:35:39+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#language#italian","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Italian","description":"Italian","dateCreated":"2020-03-03T06:40:49+0000","dateUpdated":"2022-02-03T03:31:25+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#kendra","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kendra","description":"Amazon Kendra","dateCreated":"2020-12-08T20:12:42+0000","dateUpdated":"2022-02-03T03:32:44+0000"},{"id":"GLOBAL#product#sagemaker","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon SageMaker","description":"Amazon SageMaker","dateCreated":"2020-03-02T07:05:10+0000","dateUpdated":"2022-02-03T03:32:58+0000"}]},{"item":{"id":"customer-references#careem06062022lknseflijwef","locale":"en_US","directoryId":"customer-references","name":"careem06062022lknseflijwef","dateCreated":"2023-02-08T01:16:35+0000","dateUpdated":"2023-02-08T01:38:42+0000","additionalFields":{"descriptionSummary":"Dubai-based Careem became the Middle East’s first unicorn when it was acquired by Uber for $3.1 billion in 2019. A pioneer of the region’s ride-hailing economy, Careem is now expanding its services to include mass transportation, delivery, and payments as an everyday super app. But its size and popularity—it has around 50 million customer accounts—have also made it a prime target for fraudsters constantly looking for new loopholes to exploit and different ways to hijack genuine accounts. Fighting fraudsters is a never-ending game of cat-and-mouse. Careem turned to AWS when it needed a smarter way to detect and stop losses from fraud that could damage both its revenue and its brand. The analytics and machine learning capabilities of Amazon Neptune allow Careem to automatically detect potentially fraudulent patterns in real time.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/careem-logo%401x.f38f6d1227341b8a128db4ed6abd16ea14b7c468.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"careem","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-06-06","headlineUrl":"https://youtu.be/acm-HWJhEOA?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Careem","publishedDate":"2022","enableShare":"1","headline":"Careem: Identity Based Fraud Detection Using Neptune and Neptune ML","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#elastic-beanstalk","locale":"en_US","tagNames