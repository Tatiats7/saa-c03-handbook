1:38:42+0000","additionalFields":{"descriptionSummary":"Aramex, located in the Middle East, is a leader in the global logistics and transportation industry. Through their new digital strategy and by leveraging big data and advanced analytics, Aramex has delivered massive improvement for its customers by increasing by 74% the accuracy in predicting the transit time using machine learning, and lowered the average processing time for its transit time application to under 200ms from 2.5sec.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Aramex_logo%401x.1fabac9f35a67c6bb1c65e10f3aeb192be05d506.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"aramex ltd","footerInfoText":"Published Date","industry":"Transport \u0026 Logistics","sortDate":"2022-06-20","headlineUrl":"https://youtu.be/JVcKidzqpYY?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ARAMEX LTD","publishedDate":"2022","enableShare":"1","headline":"Aramex: Leveraging AI/ML to Enhance Customer Experience","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Afric