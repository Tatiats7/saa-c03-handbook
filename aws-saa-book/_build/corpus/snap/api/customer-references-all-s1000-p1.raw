 point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"customer-references#category#data-protection","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Data Protection","description":"\u003cp\u003eData protection is the process of protecting sensitive information from damage, loss, or corruption.\u003c/p\u003e\n","dateCreated":"2023-07-14T01:07:32+0000","dateUpdated":"2023-07-14T01:07:32+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"}]},{"item":{"id":"customer-references#finra-documentdb-case-study","locale":"en_US","directoryId":"customer-references","name":"finra-documentdb-case-study","dateCreated":"2023-05-08T16:19:30+0000","dateUpdated":"2024-02-20T22:26:15+0000","additionalFields":{"descriptionSummary":"Using Amazon DocumentDB for data collection, FINRA has reduced costs month over month by over 50 percent and decreased development times for collecting regulatory filings.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/FINRA_Logo%401x.c671813e3b8aa8510bda098ed024417a9016e825.png","displayLocation":"United States","customerNameLower":"finra","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2023-04-26","headlineUrl":"https://aws.amazon.com/solutions/case-studies/finra-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"FINRA","publishedDate":"2023","enableShare":"1","headline":"Modernizing FINRA Data Collection Using Amazon DocumentDB","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#documentdb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DocumentDB","desc