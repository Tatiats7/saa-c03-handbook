 the scientists at Vertex can get their search results and itineration on their research more quickly.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Vertex_Logo%401x.409b3b5522c7002f8ba51cf9df3d35ead2cb7356.png","displayLocation":"Americas","customerNameLower":"vertex","footerInfoText":"Published Date","industry":"Life Sciences","sortDate":"2022-06-24","headlineUrl":"https://aws.amazon.com/solutions/case-studies/vertex-case-study-video/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Vertex","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Vertex Pharmaceuticals Builds a Molecule Search Platform on AWS to Accelerate Its Research"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T1