day, delivering full year academia curricula online for 116,861 students and 7,396 lecturers across 36 polytechnics.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/MOHE_logo%401x.b4b264c0a34132d70aa028ca88c2e86c26d8c5b2.png","displayLocation":"Malaysia","footerInfoText":"Published Date","industry":"Education","sortDate":"2022-03-23","headlineUrl":"https://aws.amazon.com/solutions/case-studies/mohe/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Malaysia’s DPCCE Pioneers Full Cloud-Based Higher Education Delivery on AWS","customer-name":"Department of Polytechnic and Community College Education (DPCCE)"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#asean","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"ASEAN","description":"ASEAN","dateCreated":"2020-08-20T03:53:05+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#location#malaysia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Malaysia","description":"Malaysia","dateCreated":"2020-02-03T05:29:27+0000","dateUpdated":"2022-02-03T03:31:36+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T