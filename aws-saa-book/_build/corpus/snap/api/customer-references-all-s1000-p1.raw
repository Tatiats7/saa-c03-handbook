03T03:35:28+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#database-migration-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Database Migration Service (DMS)","description":"AWS Database Migration Service (DMS)","dateCreated":"2020-03-02T07:02:30+0000","dateUpdated":"2022-02-03T03:32:27+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#wesurance","locale":"en_US","directoryId":"customer-references","name":"wesurance","dateCreated":"2022-01-08T04:33:24+0000","dateUpdated":"2023-07-14T23:32:42+0000","additionalFields":{"descriptionSummary":"The Minnesota Department of Health (MDH) is responsible for Minnesotans\u0027 public health, including disease control and prevention, environmental health, public policy, and regulation of health care providers. In partnership with Minnesota IT Services—the state\u0027s information technology agency, which sets IT strategy, direction, policies, and standards—MDH built a unified solution to obtain secure, consistent access to curated health data on Amazon Web Services (AWS). Using data lakes on AWS, MDH is able to group data from subsystems to support the creation of the governor’s COVID-19 report, deliver notifications of exposure to COVID-19, host a staging area between the disease surveillance system and other systems, act as an access point for researchers and epidemiologists, and more.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/wesurance-logo%401x.fc508164daa26a8a881e9f153352267c4bc7b29f.png","displayLocation":"Hong Kong","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-01-07","headlineUrl":"https://aws.amazon.com/solutions/case-studies/wesurance/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","customer-name":"Wesurance","contentType":"Customer Story","headline":"Wesurance Drives Transformation for Insurers with Innovative Digital Solutions on AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","