base solutions on AWS helped Expedia Group enhance travelers’ booking experiences, speed up vendor payment transactions from 1 day to seconds, save millions of dollars, and scale to handle hundreds of million website visits each month.","featureImageURL":"https://d1.awsstatic.com/aws-key-pages/homepage-key-pages/customer-stories-logo/Expedia-Group.cab2620fa3c9b987886bc63518bbccfa2e53f3ef.jpg","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Expedia_Customer-Reference_Logo.27045ad031c48bd983a26a5befaf0f39e63ff619.png","displayLocation":"United States","customerNameLower":"expedia group","footerInfoText":"Published Date","description":"\u003cp\u003eEnhancing booking experiences and scaling to over 600 million monthly website visits\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u0026nbsp;\u003c/p\u003e\n","industry":"Travel","sortDate":"2022-08-31","headlineUrl":"https://aws.amazon.com/solutions/case-studies/innovators/expedia/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Expedia Group","publishedDate":"2022","enableShare":"1","headline":"Expedia Group on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#product#cloudwatch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudWatch","description":"Amazon CloudWatch","dateCreated":"2020-03-02T07:02:07+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Net