es","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Mobile","description":"Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2023-08-22T20:28:38+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#coca-cola","locale":"en_US","directoryId":"customer-references","name":"coca-cola","dateCreated":"2024-09-18T20:03:31+0000","dateUpdated":"2024-09-18T20:08:10+0000","additionalFields":{"descriptionSummary":"Nachdem Coca-Cola 20 Jahre lang seine eigenen On-Premises-Rechenzentren betrieben hatte, migrierte das Unternehmen 2013 zu Amazon Web Services (AWS). Zu Beginn des Jahres führte der Super Bowl-Werbespot des Unternehmens zu einem sprunghaften Anstieg des Website-Verkehrs, der die Server von Coca-Cola überlastete und den Ausschlag für den Wechsel in die Cloud gab. Seit der Umstellung hat Coca-Cola seine Betriebskosten um 40 Prozent und das IT-Ticketvolumen um 80 Prozent reduziert. Darüber hinaus beschleunigen viele einzelne Abfüller im globalen Vertriebsnetz des Unternehmens, wie Coca-Cola Andina und Coca-Cola İçecek, ihre digitale Transformation. Coca-Cola setzt seine Innovationen auf AWS fort und nutzte kürzlich AWS-Serverless-Technologien, um in nur 150 Tagen eine berührungslose Benutzererfahrung mit geringer Latenz für seine Coca-Cola Freestyle-Getränkeausschankplattform zu entwickeln.","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/the-coca-cola-company-logo%401x.be0b2860128c6383e1a150155225aa88a925448f.png","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/the-coca-cola-company-logo%401x.be0b2860128c6383e1a150155225aa88a925448f.png","displayLocation":"Amerika","customerNameLower":"the coca-cola company","industry":"Fertigung","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/innovators/coca-cola/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"The Coca-Cola Company","enableShare":"1","publishedDate":"2022","contentType":"Kundengeschichte","headline":"The Coca-Cola Company in AWS"}},"tags":[{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#german","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"German","description":"German","dateCreated":"2020-03-03T06:40:46+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":