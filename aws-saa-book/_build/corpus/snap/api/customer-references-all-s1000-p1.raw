17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#tech-category#app-integration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Application Integration","description":"Application Integration","dateCreated":"2020-01-16T17:43:04+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#migration","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Migration","description":"Migration","dateCreated":"2020-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#goldman-sachs-innovator","locale":"en_US","directoryId":"customer-references","name":"goldman-sachs-innovator","dateCreated":"2022-07-16T00:00:28+0000","dateUpdated":"2024-06-26T18:58:56+0000","additionalFields":{"descriptionSummary":"Goldman Sachs builds on Amazon Web Services (AWS) to help advance its business and accelerate innovation for its customers. Using the cloud, Goldman Sachs has transformed the way it operates internally—from automated digital forensics to digital supply chain and procurement—and externally by serving customers through innovations such as the Goldman Sachs Financial Cloud for Data, which is a suite of cloud-based data and analytics solutions for financial institutions that integrates with AWS Data Exchange. It helps financial institutions securely integrate data alongside Goldman Sachs’s curated financial markets data to improve decision making.","featureImageURL":"https://d1.awsstatic.com/aws-key-pages/homepage-key-pages/customer-stories-logo/Goldman%20Sachs.59e8c1eb1e696e72a83c656195b0d40f98c48978.jpg","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/goldman-sachs-logo%401x.8c2922560041ff60da2c33ece0df53bbee330503.png","displayLocation":"North America","customerNameLower":"goldman sachs","footerInfoText":"Published Date","description":"\u003cp\u003eAccelerating innovation for customers, from investment to consumer banking\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u0026nbsp;\u003c/p\u003e\n","industry":"Financial Services","sortDate":"2022-07-15","headlineUrl":"https://aws.amazon.com/solutions/case-studies/innovators/goldman-sachs/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Goldman Sachs","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Goldman Sachs on AWS"}},"tags":[{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#homepage-industry#financial-services","locale":"en_US","tagNamespaceId":"customer-references#homepage-industry","name":"Financial Services","description":"Financial Services","dateCreated":"2022-08-24T22:33:34+0000","dateUpdated":"2022-08-24T22:33:34+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#featured-on#home-page","locale":"en_US","tagNamespaceId":"GLOBAL#featured-on","name":"Home Page","description":"Home Page","dateCreated":"2021-06-04T06:35:53+0000","dateUpdated":"2022-02-03T03:31:17+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#goldman-sachs","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Goldman Sachs","description":"Goldman Sachs","dateCreated":"2022-09-15T00:48:32+0000","dateUpdated":"2022-09-15T00:48:32+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"}]},{"item":{"id":"customer-references#bayer-case-study","locale":"en_US","directoryId":"customer-references","name":"bayer-case-study","dateCreated":"2022-07-16T00:00:33+0000","dateUpdated":"2024-03-02T02:48:50+0000","additionalFields":{"descriptionSummary":"To help Brazilian farmers adopt climate–smart agricultural practices and reduce carbon emissions in their activities, Bayer created the Carbon Program, which aims to build carbon neutral agriculture practices. The initiative is part of the company\u0027s commitment to reduce greenhouse gas (GHG) emissions by 30 percent in the agricultural sector by 2030. To centralize and standardize the data received from the different partners involved in the project, Bayer uses Amazon Web Services (AWS) to have the scalability and agility the project needs.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/BayerCropScience_Customer-Reference_Logo.5c397f30902a323a26d59af8d39d8196f059023b.png","displayLocation":"Brazil","customerNameLower":"bayer s/a.","footerInfoText":"Published Date","industry":"General Public Services","sortDate":"2022-07-15","headlineUrl":"https://aws.amazon.com/solutions/case-studies/bayer-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Bayer S/A.","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Bayer Centralizes and Standardizes Data from the Carbon Program Using AWS"}},"tags":[{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#product#redshift","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Redshift","description":"Amazon Redshift","dateCreated":"2020-03-02T07:05:02+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#use-case#data-lakes","locale":"en_US","tagNamespac