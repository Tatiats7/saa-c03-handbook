026 Learning","dateCreated":"2020-08-20T04:26:30+0000","dateUpdated":"2022-02-03T03:35:55+0000"}]},{"item":{"id":"customer-references#seed-case-study","locale":"en_US","directoryId":"customer-references","name":"seed-case-study","dateCreated":"2022-03-24T02:43:58+0000","dateUpdated":"2022-03-24T02:46:37+0000","additionalFields":{"descriptionSummary":"SEED is an open web-based portal that provides data on NSW to researchers, regulators, and the community. By modernising the SEED platform with AWS, the team is saving five days a month, time it now dedicates to innovation. With the help of AWS Partner PolarSeven, the SEED team is using AWS CloudFormation to run infrastructure as code, AWS Security Hub to automate security monitoring, and AWS CodePipeline for continuous development.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Seed_logo%401x.d21af3dd85933d26831829196313428e8802c74a.png","displayLocation":"Australia","footerInfoText":"Published Date","industry":"General Public Services","sortDate":"2022-03-23","headlineUrl":"https://aws.amazon.com/solutions/case-studies/seed-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"The New South Wales SEED Platform Plants New Ideas with Cloud Modernisation","customer-name":"Sharing and Enablement of Environmental Data (SEED)"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#cloudformation","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudFormation","description":"AWS CloudFormation","dateCreated":"2020-03-02T07:01:55+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#location#australia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia","description":"Australia","da