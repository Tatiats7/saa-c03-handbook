","dateUpdated":"2022-09-15T00:48:44+0000"}]},{"item":{"id":"customer-references#pearlai","locale":"en_US","directoryId":"customer-references","name":"pearlai","dateCreated":"2022-12-13T02:08:16+0000","dateUpdated":"2022-12-13T02:15:22+0000","additionalFields":{"descriptionSummary":"An AWS customer since it was founded in 2016, Péarlaí took advantage of an offer from Amazon Web Services (AWS) to pivot from retail analytics to a queue management system that helps retailers respond to COVID-19 restrictions.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/pearlai-logo%401x.6af13728f8c2f51844e719ec809d8ec6bdee5866.jpg","displayLocation":"United Kingdom","customerNameLower":"péarlaí","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-12-02","headlineUrl":"https://aws.amazon.com/solutions/case-studies/Pearlai/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Péarlaí","publishedDate":"2022","enableShare":"1","headline":"Péarlaí Pivots to COVID-19 Protection Provider with AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35: