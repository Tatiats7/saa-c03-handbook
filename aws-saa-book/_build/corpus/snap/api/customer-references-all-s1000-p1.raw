er-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#workload#sap","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"SAP","description":"SAP","dateCreated":"2021-01-06T00:09:56+0000","dateUpdated":"2022-02-03T03:36:05+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#industry#life-sciences","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Life Sciences","description":"Life Sciences","dateCreated":"2020-01-16T17:42:31+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#product#workspaces","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon WorkSpaces","description":"Amazon WorkSpaces","dateCreated":"2020-03-02T07:06:12+0000","dateUpdated":"2022-02-03T03:33:08+0000"},{"id":"GLOBAL#location#canada","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Canada","description":"Canada","dateCreated":"2020-02-03T05:29:05+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#university-of-chicago-case-study","locale":"en_US","directoryId":"customer-references","name":"university-of-chicago-case-study","dateCreated":"2019-07-22T19:57:07+0000","dateUpdated":"2022-02-12T02:02:10+0000","additionalFields":{"descriptionSummary":"The Center for Translational Data Science at the University of Chicago uses AWS to build and operate large-scale data resources, supporting secure biomedical data access and facilitating innovation.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/univ-chicago-logo%401x.5eb6dba69df82483425b5be405bd36412bc36496.png","displayLocation":"United States","footerInfoText":"Published Date","description":"\u003cp\u003eThe University of Chicagos Computation Institute builds solutions for big data projects like genomics analysis. Needing a cost-effective way to provide always-on service to labs around the world, it hosts its Globus Transfer and Globus Genomics services on AWS.\u003c/p\u003e\r\n","industry":"Education","sortDate":"2022-02-11","headlineUrl":"https://aws.amazon.com/solutions/case-studies/university-of-chicago-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"University of Chicago","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"The University of Chicago Manages Biomedical Data Resources at Scale on AWS"}},"tags":[{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location",