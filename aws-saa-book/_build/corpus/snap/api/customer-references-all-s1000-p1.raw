pdated":"2022-04-02T00:32:18+0000"},{"id":"GLOBAL#location#hongkong","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Hong Kong","description":"Hong Kong","dateCreated":"2020-02-03T05:29:18+0000","dateUpdated":"2022-02-03T03:31:38+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"IoT","description":"IoT","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"customer-references#category#iot","locale":"en_US","tagNamespaceId":"customer-references#category","name":"IoT","description":"IoT","dateCreated":"2019-07-22T18:32:05+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#lightsail","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Lightsail","description":"Amazon Lightsail","dateCreated":"2020-03-02T07:04:25+0000","dateUpdated":"2022-02-03T03:32:47+0000"}]},{"item":{"id":"customer-references#tv-tokyo2021","locale":"en_US","directoryId":"customer-references","name":"tv-tokyo2021","dateCreated":"2022-01-29T03:27:24+0000","dateUpdated":"2022-01-29T03:29:16+0000","additionalFields":{"descriptionSummary":"In April 2021, TV TOKYO, broadcaster of one of the strongest lineups of business news in Tokyo, overhauled its “TV TOKYO Business on Demand” subscription service, relaunching it as TERETO BIZ. AWS Media Services powers the new service, delivering live broadcasts and VOD, up to 10 live channels of critical economic news, and five times more streams than the old system.","imageSrcUrl":"https://d1.awsstatic.com/case-studies/jp/tv-tokyo_logo_2021.64033bb3acecdfa1efb004fd538eac9496ba5a98.png","displayLocation":"Japan","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2022-01-28","headlineUrl":"https://aws.amazon.com/solutions/case-studies/tv-tokyo_2021/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"TV TOKYO Corporation Relaunches New Business Program on AWS","customer-name":"TV TOKYO Corporation"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#elastic-container-service","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Container Service (ECS)","description":"Amazon Elastic Container Service (ECS)","dateCreated":"2020-03-02T07:03:02+0000","dateUpdated":"2022-02-03T03:32:33+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#japan","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Japan","description":"Japan","dateCreated":"2020-02-03T05:29:23+0000","dateUpdated":"2022-02-03T03:31:39+0000"},{"id":"customer-references#category#media-services","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Media Services","description":"Media Services","dateCreated":"2019-07-22T18:32:09+0000","dateUpdated":"2022-03-05T03:54:12+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"}]},{"item":{"id":"customer-references#san-luis-obispo-county-case-study","locale":"en_US","directoryId":"customer-references","name":"san-luis-obispo-county-case-study","dateCreated":"2022-01-29T03:25:48+0000","dateUpdated":"2022-01-29T03:29:14+0000","additionalFields":{"descriptionSummary":"San Luis Obispo (SLO) County in California formed the SLO Opioid Safety Coalition (SLO OSC) in 2016 to address opioid misuse in the region. To help the community, prevent overdose deaths, and support people struggling with addiction, SLO County decided to build a web application, Naloxone Now, in collaboration with the Cal Poly Digital Transformation Hub (DxHub) powered by Amazon Web Services (AWS) to help connect those in need to the life-saving drug Naloxone. The student developers and designers at the DxHub built SLO County’s application using Amazon Simple Storage Service (Amazon S3) to host web pages with text and videos about how to obtain and administer Naloxone. To support the app’s delivery feature, the developers leveraged Amazon DynamoDB (DynamoDB), AWS Lambda, and Amazon Simple Notification Service (Amazon SNS). Cities, counties, and community members alike who are looking to help save hundreds, even thousands, of lives and prevent fatal opioid overdoses can adopt the app.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/slo-logo%402x.d9c61e6386315853917844509eac5f43f0a93449.png","displayLocation":"United States","footerInfoText":"Published Date","industry":"General Public Services","sortDate":"2022-01-28","headlineUrl":"https://aws.amazon.com/solutions/case-studies/san-luis-obispo-county-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Helping Prevent Opioid Overdoses: Student Developers Build Web App on AWS","customer-name":"SLO Opioid Safety Coalition (SLO OSC)"}},"tags":[{"id":"GLOBAL#use-case#websites-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Websites \u0026 Web Apps","description":"Websites \u0026 Web Apps","dateCr