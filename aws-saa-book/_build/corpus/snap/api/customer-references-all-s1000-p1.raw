s","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"customer-references#category#app-integration","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Application Integration","description":"Application Integration","dateCreated":"2019-07-22T18:30:54+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"}]},{"item":{"id":"customer-references#hospital-sirio-libanes-case-study-from-pt-directory","locale":"en_US","directoryId":"customer-references","name":"hospital-sirio-libanes-case-study-from-pt-directory","dateCreated":"2024-02-03T03:48:32+0000","dateUpdated":"2024-02-06T01:35:36+0000","additionalFields":{"descriptionSummary":"Com uma área construída de aproximadamente 100 mil m² no bairro da Bela Vista, em São Paulo, além de um hospital de alta complexidade em Brasília, o Hospital Sírio-Libanês atende mais de 60 especialidades e conta com mais de 500 leitos. A instituição alia um corpo clínico multidisciplinar a tecnologias de última geração. Ao longo dos anos, acumulou conquistas pioneiras, como a inauguração da primeira Unidade de Terapia Intensiva (UTI) no Brasil, em 1971, e a participação na primeira tele cirurgia guiada por robô realizada no hemisfério Sul, em 2000.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/hospital-sirio-libanes%402x.d48972885f39f72ec6a6500927dc8dec85524046.png","displayLocation":"Brasil","customerNameLower":"hospital sírio libanês","footerInfoText":"Data de publicação","industry":"Saúde","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/hospital-sirio-libanes-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Hospital Sírio Libanês","enableShare":"1","publishedDate":"2023","contentType":"História do cliente","headline":"Sírio Libanês transforma sua gestão financeira de nuvem em 5 meses"}},"tags":[{"id":"GLOBAL#product#cost-usage-report","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Cost and Usage Report","description":"AWS Cost and Usage Report","dateCreated":"2020-03-02T07:02:28+0000","dateUpdated":"2022-02-03T03:32:27+0000"},{"id":"customer-references#category#big-data-analytics","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Big Data \u0026 Analytics","description":"Big Data \u0026 Analytics","dateCreated":"2019-07-22T18:31:04+0000","dateUpdated":"2022-02-19T05:00:36+0000"},{"id":"GLOBAL#product#security-hub","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Security Hub","description":"AWS Security Hub","dateCreated":"2020-03-02T07:05:15+0000","dateUpdated":"2022-02-03T03:32:59+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#tech-category#cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Cloud Financial Management","description":"Cloud Financial Mana