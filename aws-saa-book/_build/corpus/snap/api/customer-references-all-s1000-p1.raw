ge uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#salesforce-case-study","locale":"en_US","directoryId":"customer-references","name":"salesforce-case-study","dateCreated":"2022-09-14T00:14:26+0000","dateUpdated":"2023-07-19T03:04:50+0000","additionalFields":{"descriptionSummary":"Salesforce’s Unified Intelligence Platform Team moved 60 percent of its workload to Amazon EC2 Spot Instances, saving over $1 million per month and reducing processing time from 4 hours to 15 minutes.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/salesforce_Logo%401x.e3ea487b7f4ec96d760a1240c5b36f93823d1c54.png","displayLocation":"United States","customerNameLower":"salesforce","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-09-13","headlineUrl":"https://aws.amazon.com/solutions/case-studies/salesforce-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Salesforce","publishedDate":"2022","enableShare":"1","headline":"Salesforce UIP Uses Amazon EC2 Spot Instances to Reduce Data Processing Times by More than 90% and Save Over $1 Million Monthly","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#ec2-ondemand-instances","locale"