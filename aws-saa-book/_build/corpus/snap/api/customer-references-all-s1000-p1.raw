9T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#emr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EMR","description":"Amazon EMR","dateCreated":"2020-03-02T07:03:22+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"}]},{"item":{"id":"customer-references#leadinfo-case-study","locale":"en_US","directoryId":"customer-references","name":"leadinfo-case-study","dateCreated":"2022-06-27T20:43:55+0000","dateUpdated":"2022-06-27T20:55:55+0000","additionalFields":{"descriptionSummary":"Leadinfo is a Netherlands-based scale-up that helps B2B customers—from sports organizations, to digital marketing agencies, to heavy industry businesses in steel and packaging—target sales prospects by analyzing information about website visitors. It saw its business grow quickly after the COVID-19 pandemic put a stop to many face-to-face sales calls. By migrating its customer data from multiple databases on AWS to Amazon Aurora, Leadinfo reduced its monthly IT costs by 30 percent while improving developer efficiency by 50 percent. This has helped it to quickly roll out new features for customers and build a foundation for continued business growth.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/leadinfo-logo%401x.77ef5808c84cefac08c926994e9399247dfce8fe.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"leadinfo","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-06-24","headlineUrl":"https://aws.amazon.com/solutions/case-studies/leadinfo-case-study-2022/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Leadinfo","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Leadinfo Saves 30% on IT Costs, Improves Developer Efficiency by 50% Using AWS"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer