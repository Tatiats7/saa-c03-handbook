-02-03T03:32:33+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"}]},{"item":{"id":"customer-references#payeye-case-study","locale":"en_US","directoryId":"customer-references","name":"payeye-case-study","dateCreated":"2022-10-31T22:33:40+0000","dateUpdated":"2023-07-14T23:32:35+0000","additionalFields":{"descriptionSummary":"Startup PayEye, founded in Poland in 2019, developed a biometrics payment service that uses a person’s iris and face to authenticate purchases. The company needed to act fast to secure funding, gain regulatory approvals, and win over retail partners before launching its solution. PayEye built its platform on AWS and completed a proof of concept for its biometric authentication technology in 5 months. Assisted by the tools and services available from AWS, it navigated security and data protection regulations, and launched a complete and secure payment ecosystem soon after the initial proof of concept. PayEye also uses AWS to analyze real-time data on device performance and user numbers to improve customer experience.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/payeye-logo%401x.0636fd0c808c54ec679383cc7780f53a73295d61.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"payeye","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-10-31","headlineUrl":"https://aws.amazon.com/solutions/case-studies/payeye-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"PayEye","publishedDate":"2022","enableShare":"1","headline":"PayEye Launches 