"en_US","directoryId":"customer-references","name":"amazon-connect-travel-hospitality-infographic","dateCreated":"2022-10-25T22:40:16+0000","dateUpdated":"2023-07-12T01:35:39+0000","additionalFields":{"descriptionSummary":"Learn from travel and hospitality companies including Priceline, Traventia, and Best Western that are using modern contact center solutions built on Amazon Web Services (AWS)","displayLocation":"United States","customerNameLower":"priceline, traventia, best western","footerInfoText":"Published Date","industry":"Travel","sortDate":"2022-10-24","headlineUrl":"https://aws.amazon.com/solutions/case-studies/amazon-connect-travel-hospitality-infographic/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2022","enableShare":"1","customer-name":"Priceline, Traventia, Best Western","headline":"Transforming Travel and Hospitality Customer Service Using Amazon Connect","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#tech-category#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Business Applications","description":"Business Applications","dateCreated":"2022-10-07T04:56:33+0000","dateUpdated":"2022-10-07T04:56:33+0000"},{"id":"GLOBAL#industry#travel","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Travel","description":"Travel","dateCreated":"2020-01-16T17:42:42+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#location#spain","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Spain","description":"Spain","dateCreated":"2020-02-03T05:30:16+0000","dateUpdated":"2022-02-03T03:31:49+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#united-states","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"United States","description":"United States","dateCreated":"2020-02-03T05:29:08+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"GLOBAL#product#connect","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Connect","description":"Amazon Connect","dateCreated":"2020-03-02T07:02:22+0000","dateUpdated":"2022-02-03T03:32:26+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#business-category#cust-engagement","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2020-06-05T07:06:46+0000","dateUpdated":"2022-02-03T03:31:03+0000"},{"id":"GLOBAL#location#iberia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Iberia","description":"Iberia","dateCreated":"2020-04-09T03:37:04+0000","dateUpdated":"2022-02-03T03:31:49+0000"},{"id":"GLOBAL#content-type#infographic","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Infographic","description":"Infographic","dateCreated":"2020-06-12T23:29:11+0000","dateUpdated":"2022-02-03T03:31:08+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#purple-case-study","locale":"en_US","directoryId":"customer-references","name":"purple-case-study","dateCreated":"2022-10-25T22:40:14+0000","dateUpdated":"2023-07-14T23:32:35+0000","additionalFields":{"descriptionSummary":"FinTech company Purple Technology builds applications and services for brokerage firms to onboard customers efficiently. End users self-manage their accounts and portfolios, which leaves brokerages free to focus on core functions such as client services and risk management. Users creating new trading accounts with brokers need to follow a stringent onboarding process that complies with complex rules and regulations to verify their identities. Using AWS, Purple has simplified the way these rulesets are coded into the app, making it easier for non-technical employees to manage the application and keep on top of changing regulations.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/purple-technology-logo%401x.fbb96daabb3b5b3ace0589eff8a2419ab13749ec.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"purple","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-10-24","headlineUrl":"https://aws.amazon.com/solutions/case-studies/purple-technology-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Purple","publishedDate":"2022","enableShare":"1","headline":"Purple Technology Responds Rapidly to Changing Regulations and Customer Needs Using AWS","contentType":"Customer Story"}},"tags":[{"id":"customer-references#category#mgmt-governance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2019-07-22T18:32:10+0000","dateUpdated":"2022-03-05T02:54:01+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#step-functions","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Step Functions","description":"AWS Step Functions","dateCreated":"2020-03-02T07:05:39+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#location#czech-rep","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Czech Republic","description":"Czech Republic","dateCreated":"2020-03-10T05:13:38+0000","dateUpdated":"2022-02-03T03:31:42+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#mgmt-govern","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Management \u0026 Governance","description":"Management \u0026 Governance","dateCreated":"2020-01-16T17:43:21+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateU