"tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"}]},{"item":{"id":"customer-references#rtvc","locale":"en_US","directoryId":"customer-references","name":"rtvc","dateCreated":"2023-06-01T23:05:03+0000","dateUpdated":"2023-06-08T04:07:42+0000","additionalFields":{"descriptionSummary":"Radio Televisión Nacional de Colombia (RTVC) es el sistema de medios públicos de los colombianos. Con una cobertura cercana al 93% de la población total, RTVC es la única opción en muchos lugares de Colombia para acceder a contenidos de entretenimiento, informativos y culturales. La compañía tenía los desafíos de aumentar la flexibilidad en la operación, la eficiencia en el gasto y de eliminar activos por obsolescencia. Para eso implementó la tecnología en la nube de AWS. RTVC tiene con AWS más de 25 servicios en la actualidad","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/rtvc_logo%401x.f4d976f7f455e889547473b9d6701552346f013f.png","displayLocation":"Colombia","customerNameLower":"rtvc","footerInfoText":"Fecha de publicación","industry":"Servicios públicos generales","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/RTVC/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"RTVC","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"RTVC utiliza AWS para llevar contenidos al 93% de la población en Colombia"}},"tags":[{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#chatbot","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Chatbot","description":"AWS Chatbot","dateCreated":"2020-03-02T07:01:47+0000","dateUpdated":"2022-02-03T03:32:20+0000"},{"id":"GLOBAL#product#vpc","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon VPC","description":"Amazon VPC","dateCreated":"2020-03-02T07:06:00+0000","dateUpdated":"2022-02-03T03:33:06+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-refere