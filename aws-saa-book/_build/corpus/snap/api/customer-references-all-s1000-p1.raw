com/Customer%20References%20Directory%20Logos/malaysiakini-logo%401x.b690ae61001a2cbc2dd4c7191d9d6ff2a72d55df.png","displayLocation":"Malaysia","customerNameLower":"malaysiakini","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/malaysiakini-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Malaysiakini","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Malaysiakini Delivers Fast, Timely News to 1M+ Concurrent Viewers During Peak Periods at Half the IT Cost"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#location#asean","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"ASEAN","description":"ASEAN","dateCreated":"2020-08-20T03:53:05+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-