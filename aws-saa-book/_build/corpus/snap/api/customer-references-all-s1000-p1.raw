ment#public-sector-govt","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Government","description":"Government","dateCreated":"2019-07-22T18:39:47+0000","dateUpdated":"2022-03-19T00:18:44+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#customer-segment#public-sector","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Public Sector","description":"Public Sector","dateCreated":"2022-01-10T20:16:10+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#elb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Elastic Load Balancing (ELB)","description":"Elastic Load Balancing (ELB)","dateCreated":"2020-03-02T07:03:09+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"}]},{"item":{"id":"customer-references#unam","locale":"en_US","directoryId":"customer-references","name":"unam","dateCreated":"2023-06-01T23:06:08+0000","dateUpdated":"2023-06-08T04:07:40+0000","additionalFields":{"descriptionSummary":"La Universidad Nacional Autónoma de México (UNAM), es la más grande e importante universidad pública de México e Iberoamérica. En abril de 2021 firmó un convenio de colaboración con la Secretaría de Educación Pública (SEP) en México, para llevar a cabo los diversos procesos de selección de las maestras y los maestros de Educación Básica y Educación Media Superior. Para ello, la UNAM tuvo como objetivo proveer diferentes servicios de proctoring basados en los servicios de AWS, los cuales incluyeron tanto el diseño, el desarrollo, la aplicación y análisis de resultados, así como la seguridad de los instrumentos de valoración.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/unam_logo%401x.aaf899dc406de33113d72249cf8e7e4666ff6a7f.png","displayLocation":"México","customerNameLower":"unam","footerInfoText":"Fecha de publicación","industry":"Educación","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/unam/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"UNAM","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"Con AWS, UNAM marca hito en materia de valoración a gran escala de maestras y maestros en México"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Front-End Web \u0026 Mobile","description":"Front-End Web \u0026 Mobile","dateCreated":"2020-01-16T17:43:26+0000"