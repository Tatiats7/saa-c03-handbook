hat point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#razer-case-study","locale":"en_US","directoryId":"customer-references","name":"razer-case-study","dateCreated":"2022-10-11T20:29:26+0000","dateUpdated":"2022-10-11T21:03:06+0000","additionalFields":{"descriptionSummary":"Razer, a leading lifestyle brand for gamers, achieved affordability by running over 80 percent of its Amazon EC2 instances, including all production workloads, on Amazon EC2 Spot Instances.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Razer_Customer-Reference_Logo.da2726a8784894df8c2f7128667525c4dad147e7.png","displayLocation":"Singapore","customerNameLower":"razer","footerInfoText":"Published Date","industry":"Retail","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/razer-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Razer","publishedDate":"2022","enableShare":"1","headline":"Razer Achieves Over 70 Percent Cost Savings in Compute Spend Using Amazon EC2 Spot Instances and Amazon ECS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#location#singapore","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Singapore","description":"Singapore","dateCreated":"2020-02-03T05:29:36+0000","dateUpdated":"2022-02-03T03:31:37+0000"},{"id":"GLOBAL#industry#retail","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Retail","description":"Retail","dateCreated":"2020-01-16T17:42:39+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#product#ec2-ondemand-instance