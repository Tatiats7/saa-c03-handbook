nt#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"}]},{"item":{"id":"customer-references#eudaimonia-llamando-al-doctor","locale":"en_US","directoryId":"customer-references","name":"eudaimonia-llamando-al-doctor","dateCreated":"2023-06-01T23:04:14+0000","dateUpdated":"2023-06-08T04:07:43+0000","additionalFields":{"descriptionSummary":"Llamando al Doctor es un servicio que ofrece consultas por video las 24 horas con profesionales de la salud a través de su aplicación y plataforma web. Eudaimonia, o Euda para abreviar, es una empresa de desarrollo de software que desarrolló la plataforma Llamando al Doctor para encontrar las mejores soluciones técnicas para brindar una atención accesible y fácil de usar.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/eudaimonia_logo%401x.a33b4b4895bf830c05e78095268ae8e0ef3d10dd.png","displayLocation":"Argentina","customerNameLower":"eudaimonia","footerInfoText":"Fecha de publicación","industry":"Software e Internet","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/eudaimonia-llamando-al-doctor/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Eudaimonia","enableShare":"1","publishedDate":"2022","contentType":"Historia del cliente","headline":"Llamando al Doctor y Eudaimonia confían en escalabilidad con AWS en tiempos sin precedentes"}},"tags":[{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+