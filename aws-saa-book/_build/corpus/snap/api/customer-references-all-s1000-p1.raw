25T04:07:49+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#step-functions","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Step Functions","description":"AWS Step Functions","dateCreated":"2020-03-02T07:05:39+0000","dateUpdated":"2022-02-03T03:33:02+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#reference-arch-diagram","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Reference Architecture Diagram","description":"Reference Architecture Diagram","dateCreated":"2020-04-29T05:19:31+0000","dateUpdated":"2022-02-03T03:31:09+0000"}]},{"item":{"id":"customer-references#coca-cola-innovator-de","locale":"en_US","directoryId":"customer-references","name":"coca-cola-innovator-de","dateCreated":"2024-09-18T20:04:11+0000","dateUpdated":"2024-09-18T20:08:09+0000","additionalFields":{"descriptionSummary":"Nachdem Coca-Cola 20 Jahre lang seine eigenen On-Premises-Rechenzentren betrieben hatte, migrierte das Unternehmen 2013 zu Amazon Web Services (AWS). Zu Beginn des Jahres führte der Super Bowl-Werbespot des Unternehmens zu einem sprunghaften Anstieg des Website-Verkehrs, der die Server von Coca-Cola überlastete und den Ausschlag für den Wechsel in die Cloud gab. Seit der Umstellung hat Coca-Cola seine Betriebskosten um 40 Prozent und das IT-Ticketvolumen um 80 Prozent reduziert. Darüber hinaus beschleunigen viele einzelne Abfüller im globalen Vertriebsnetz des Unternehmens, wie Coca-Cola Andina und Coca-Cola İçecek, ihre digitale Transformation. Coca-Cola setzt seine Innovationen auf AWS fort und nutzte kürzlich AWS-Serverless-Technologien, um in nur 150 Tagen eine berührungslose Benutzererfahrung mit geringer Latenz für seine Coca-Cola Freestyle-Getränkeausschankplattform zu entwickeln.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/coca-cola-logo%401x.4c9be67ec52d063bf4c44c482d50900e4bad7129.png","displayLocation":"Amerika","customerNameLower":"coca-cola","industry":"Verbrauchsgüter (CPG)","sortDate":"2022-05-18","enableShare":"1","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/innovators/coca-cola/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2022","contentType":"Kundengeschichte","customer-name":"Coca-Cola","headline":"The Coca-Cola Company in AWS"}},"tags":[{"id":"GLOBAL#industry#cpg","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Consumer Packaged Goods (CPG)","description":"Consumer Packaged Goods (CPG)","dateCreated":"2020-06-25T04:03:18+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#workload#sap","locale":"en_US","tagNamespaceId":"GLOBAL#workload","name":"SAP","description":"SAP","dateCreated":"2021-01-06T00:09:56+0000","dateUpdated":"2022-02-03T03:36:05+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#language#german","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"German","description":"German","dateCreated":"2020-03-03T06:40:46+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#category#business-applications-sap","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications: SAP","description":"Business Applications: SAP","dateCreated":"2019-07-22T18:31:24+0000","dateUpdated":"2022-02-12T02:01:30+0000"}]},{"item":{"id":"customer-references#coca-cola-innovator","locale":"en_US","directoryId":"customer-references","name":"coca-cola-innovator","dateCreated":"2022-05-23T21:55:34+0000","dateUpdated":"2024-06-26T18:56:28+0000","additionalFields":{"featured":"0","featureImageURL":"https://d1.awsstatic.com/aws-key-pages/homepage-key-pages/Coca-Cola.df943d34f24c3b17d8299855add943413d426de3.jpg","descriptionSummary":"Coca-Cola has innovated on AWS since 2013, recently using AWS serverless technologies to develop a low-latency, touchless user experience for its Coca-Cola Freestyle beverage-dispensing platform in only 150 days.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/coca-cola-logo%401x.4c9be67ec52d063bf4c44c482d50900e4bad7129.png","displayLocation":"Americas","customerNameLower":"coca-cola","footerInfoText":"Published Date","description":"\u003cp\u003eBuilding a data lake to increase analytics productivity by 80%\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\n\u0026nbsp;\u003c/p\u003e\n","industry":"Consumer Packaged Goods (CPG)","sortDate":"2022-05-18","headlineUrl":"https://aws.amazon.com/solutions/case-studies/innovators/coca-cola/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Coca-Cola","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Coca-Cola on AWS"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"