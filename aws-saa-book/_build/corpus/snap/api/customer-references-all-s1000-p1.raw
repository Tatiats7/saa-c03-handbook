er-ftps","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Transfer for FTPS","description":"AWS Transfer for FTPS","dateCreated":"2020-08-20T04:08:24+0000","dateUpdated":"2022-02-03T03:33:05+0000"},{"id":"GLOBAL#product#kinesis-video","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Kinesis Video Streams","description":"Amazon Kinesis Video Streams","dateCreated":"2020-03-02T07:04:16+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#corretto","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Corretto","description":"Amazon Corretto","dateCreated":"2020-03-02T07:02:25+0000","dateUpdated":"2022-02-03T03:32:27+0000"},{"id":"GLOBAL#product#alexa","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Alexa for Business","description":"Alexa for Business","dateCreated":"2020-03-02T07:01:20+0000","dateUpdated":"2022-02-03T03:32:15+0000"},{"id":"GLOBAL#product#budgets","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Budgets","description":"AWS Budgets","dateCreated":"2020-03-02T07:01:44+0000","dateUpdated":"2022-02-03T03:32:19+0000"},{"id":"GLOBAL#product#sumerian","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Sumerian","description":"Amazon Sumerian","dateCreated":"2020-03-02T07:05:42+0000","dateUpdated":"2022-02-03T03:33:03+0000"},{"id":"GLOBAL#product#elemental-mediatailor","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Elemental MediaTailor","description":"AWS Elemental MediaTailor","dateCreated":"2020-03-02T07:03:20+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#product#resilience-hub","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Resilience Hub","description":"AWS Resilience Hub","dateCreated":"2021-11-17T07:15:55+0000","dateUpdated":"2022-02-03T03:32:57+0000"},{"id":"GLOBAL#product#cloud9","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Cloud9","description":"AWS Cloud9","dateCreated":"2020-03-02T07:01:52+0000","dateUpdated":"2022-02-03T03:32:21+0000"},{"id":"GLOBAL#product#cloudtrail","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS CloudTrail","description":"AWS CloudTrail","dateCreated":"2020-03-02T07:02:05+0000","dateUpdated":"2022-02-03T03:32:23+0000"},{"id":"GLOBAL#product#elasticache-redis","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon ElastiCache for Redis","description":"Amazon ElastiCache for Redis","dateCreated":"2020-03-03T00:16:59+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#pitchboy","locale":"en_US","directoryId":"customer-references","name":"pitchboy","dateCreated":"2023-07-17T23:44:51+0000","dateUpdated":"2023-07-18T00:18:09+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eStart-up cr\u0026eacute;\u0026eacute;e en 2019, Pitchboy est une plateforme de simulation de conversation leader sur le march\u0026eacute; fran\u0026ccedil;ais. Avec une quarantaine de clients reconnus, cette start-up ambitieuse envisage une croissance multipli\u0026eacute;e par 100 d\u0026rsquo;ici 2026 gr\u0026acirc;ce \u0026agrave; l\u0026rsquo;essor fulgurant du secteur de l\u0026rsquo;EdTech. Afin de monter en comp\u0026eacute;tence et r\u0026eacute;pondre \u0026agrave; ses objectifs d\u0026rsquo;avenir, Pitchboy s\u0026rsquo;est tourn\u0026eacute; vers AWS pour optimiser son offre de formation immersive et b\u0026eacute;n\u0026eacute;ficier d\u0026rsquo;une infrastructure puissante. Gr\u0026acirc;ce aux diff\u0026eacute;rents services utilis\u0026eacute;s, la start-up a \u0026eacute;t\u0026eacute; capable d\u0026rsquo;am\u0026eacute;liorer les performances de son simulateur de conversation et de proposer une exp\u0026eacute;rience utilisateur hors-pair ; tout d\u0026rsquo;abord en cr\u0026eacute;ant une version SaaS qui en simplifie l\u0026rsquo;utilisation, puis en am\u0026eacute;liorant l\u0026rsquo;exp\u0026eacute;rience client avec des performances vid\u0026eacute;o dignes des meilleurs dans le domaine.\u003c/p\u003e\r\n","featured":"0","featureImageURL":"https://d1.awsstatic.com/%c3%89tude%20de%20cas%20AWS%20%20Pitchboy%20-%20Image.db1ed46211672344b187c6342430fc25bc850553.jpg","imageSrcUrl":"https://d1.awsstatic.com/%c3%89tude%20de%20cas%20AWS%20%20Pitchboy.426d62564a05e5081744fd7fc440645a0c17f22f.png","displayLocation":"France","customerNameLower":"pitchboy","footerInfoText":"Date de publication","industry":"Services professionnels","sortDate":"2022-06-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/pitchboy/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Pitchboy","enableShare":"1","publishedDate":"2022","contentType":"Témoignages clients","headline":"Pitchboy à la conquête de l’EdTech avec AWS"}},"tags":[{"id":"GLOBAL#industry#software-internet","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Software \u0026 Internet","description":"Software \u0026 Internet","dateCreated":"2020-06-25T04:08:24+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#product#route53","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Route 53","description":"Amazon Route 53","dateCreated":"2020-03-02T07:05:07+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Analytics","description":"Analytics","dateCreated":"2020-01-16T17:43:03+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#industry#prof-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Professional Services","description":"Professional Services","dateCreated":"2020-06-25T04:07:49+0000","dateUpdated":"2022-02-03T03:32:08+0000"},{"id":"GLOBAL#product#cloudfront","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon CloudFront","description":"Amazon CloudFront","dateCreated":"2020-03-02T07:01:57+0000","dateUpdated":"2022-02-03T03:32:22+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#elasticsearch","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elasticsearch Service (ES)","description":"Amazon Elasticsearch Service (ES)","dateCreated":"2020-03-02T07:03:05+0000","dateUpdated":"2022-02-03T03:32:34+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#language#french","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"French","description":"French","dateCreated":"2020-03-03T06:40:44+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#tech-category#networking-content-dev","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Networking \u0026 Content Delivery","description":"Networking \u0026 Content Delivery","dateCreated":"2020-01-16T17:43:28+0000","dateUpdated":"2022-02-03T03:35:29+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"}]},{"item":{"id":"customer-references#greencityzen","locale":"en_US","directoryId":"customer-references","name":"greencityzen","dateCreated":"2023-07-17T23:44:57+0000","dateUpdated":"2023-07-18T00:18:07+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eGreenCityZen met sa solution d\u0026rsquo;IoT environnemental \u0026agrave; disposition des collectivit\u0026eacute;s et des exploitants des r\u0026eacute;seaux d\u0026rsquo;eau et d\u0026rsquo;assainissement ; dans l\u0026rsquo;objectif de piloter la gestion durable des ressources en eau. Cette jeune start-up, labellis\u0026eacute;e par le minist\u0026egrave;re de l\u0026rsquo;environnement, propose notamment des solutions d\u0026rsquo;arrosage intelligent des espaces verts. L\u0026rsquo;arrosage est conditionn\u0026eacute; par le besoin des plantes, mesur\u0026eacute; par des capteurs au niveau de leurs racines. Les \u0026eacute;conomies d\u0026rsquo;eau sont consid\u0026eacute;rables, souvent de l\u0026rsquo;ordre de 50 \u0026agrave; 60% dans des r\u0026eacute;gions aussi vari\u0026eacute;es que la Toscane (Florence), Paris, Marseille, Lyon ou Bordeaux. Avec le UNHCR (ONU), l\u0026rsquo;acc\u0026egrave;s \u0026agrave; l\u0026rsquo;eau potable dans les camps de r\u0026eacute;fugi\u0026eacute;s est \u0026eacute;galement facilit\u0026eacute; par les solutions que GreenCityZen est en train de d\u0026eacute;ployer dans 15 pays. Enfin, GreenCityZen fournit \u0026eacute;galement des solutions permettant aux exploitants de r\u0026eacute;seau pluvial, de d\u0026eacute;tecter des d\u0026eacute;chets dans les points d\u0026rsquo;engouffrement (les avaloirs) et ainsi les collecter plus efficacement pour intervenir au bon endroit, au bon moment (productivit\u0026eacute; et r\u0026eacute;duction de la pollution).\u003c/p\u003e\r\n","featured":"0","featureImageURL":"https://d1.awsstatic.com/%c3%89tude%20de%20cas%20AWS%20%20-%20GreenCityZen%20-%20image.548b074d2962ca1398a892beaf1683c773df9f42.png","imageSrcUrl":"https://d1.awsstatic.com/%c3%89tude%20de%20cas%20AWS%20-%20GreenCityZen%20-%20logo.3603dad7f75fabbbff22d1e7e043524b8c99c43c.png","displayLocation":"France","customerNameLower":"greencityzen","footerInfoText":"Date de publication","industry":"Services professionnels","sortDate":"2022-06-01","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/greencityzen/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"GreenCityZen","enableShare":"1","publishedDate":"2022","contentType":"Témoignages clients","headline":"GreenCityZen : 100% de croissance par an sur une architecture cloud robuste chez AWS"}},"tags":[{"id":"GLOBAL#language#french","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"French","description":"French","dateCreated":"2020-03-03T06:40:44+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#industry#enviro-protection","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Environmental Protection","description":"Environmental Protection","dateCreated":"2020-06-25T04:06:38+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#produ