die Cloud zu migrieren. Da über 10 TB an Patienten- und medizinischen Daten in der Cloud in digitaler Form vorliegen, können die Ärzte an zentraler Stelle schneller auf Informationen zugreifen, was der Patientenversorgung zugute kommt.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/fachklinikum-mainschleife-logo%401x.f0bf16b3228ac018b984a93d41a4aea5c8bcb93b.png","displayLocation":"Deutschland","customerNameLower":"fachklinikum mainschleife","industry":"Gesundheitswesen","sortDate":"2023-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/fachklinikum-mainschleife-case-study?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2023","contentType":"Kundengeschichte","customer-name":"Fachklinikum Mainschleife","headline":"Wie das Fachklinikum Mainschleife seine Krankenhausinfrastruktur zu AWS migrierte"}},"tags":[{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":