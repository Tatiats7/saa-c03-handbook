n":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#industry#transport-logistics","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Transport \u0026 Logistics","description":"Transport \u0026 Logistics","dateCreated":"2020-06-25T04:08:39+0000","dateUpdated":"2022-02-03T03:32:09+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"}]},{"item":{"id":"customer-references#ftsa","locale":"en_US","directoryId":"customer-references","name":"ftsa","dateCreated":"2023-06-01T23:06:44+0000","dateUpdated":"2023-06-08T04:07:45+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eReconhecida pelo MEC, a Faculdade Teol\u0026oacute;gica Sul Americana (FTSA) tem mais de 2 mil alunos formados em seus cursos de gradua\u0026ccedil;\u0026atilde;o, p\u0026oacute;s-gradua\u0026ccedil;\u0026atilde;o e extens\u0026atilde;o. Criado em 2016, o curso de Teologia a Dist\u0026acirc;ncia conta com cerca de 1,8 mil alunos matriculados. Com o crescimento dos cursos online, a institui\u0026ccedil;\u0026atilde;o decidiu consolidar sua infraestrutura de TI na nuvem da AWS, garantindo maior estabilidade e eliminando incidentes com perdas de dados.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/faculdade-teologica-sul-americana-ftsa-logo%402x.a62b91dc3e2935d6aa75e3432a39f624df96bd0e.png","displayLocation":"Brasil","footerInfoText":"Da