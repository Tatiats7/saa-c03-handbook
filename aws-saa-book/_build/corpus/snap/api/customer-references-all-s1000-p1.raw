ription":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Block Store (EBS)","description":"Amazon Elastic Block Store (EBS)","dateCreated":"2020-03-02T07:02:50+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"}]},{"item":{"id":"customer-references#rappi-fin-ops","locale":"en_US","directoryId":"customer-references","name":"rappi-fin-ops","dateCreated":"2023-04-19T23:11:19+0000","dateUpdated":"2023-07-12T01:35:38+0000","additionalFields":{"descriptionSummary":"La pandemia puso a prueba la capacidad de entregas rápidas de Rappi, por lo que tuvieron que innovar en su infraestructura. Sin embargo, debían tener bases financieras para justificar el uso de herramientas tecnológicas, y eso solo se lograría teniendo un monitoreo en tiempo real de las necesidades y la tecnología para resolverlas, para medir la relación costo-eficiencia de esto. Así, con la implementación de FinOps y los servicios de AWS, con quien llevan trabajando muchos años, pueden presumir un 90% de la optimización de su inversión en infraestructura. La empresa, que actualmente procesa 25 millones de órdenes al mes, logró la flexibilidad para correr más de 10 mil Instancias de Spot de Amazon Elastic Compute Cloud (Amazon EC2) en momentos de pico.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/rappi-logo%401x.e3f6d852f68b6a673150b380f45ac07e0a763a10.png","displayLocation":"Colombia","customerNameLower":"rappi","footerInfoText":"Fecha de publicación","industry":"Hostelería","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/rappi-fin-ops/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Rappi","publishedDate":"2023","enableShare":"1","headline":"Rappi optimiza un 90% su costo-beneficio en la nube de AWS gracias a FinOps","contentType":"Historia del cliente"}},"tags":[{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#product#fargate","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Fargate","description":"AWS Fargate","dateCreated":"2020-03-02T07:03:25+0000","dateUpdated":"2022-02-03T03:32:36+0000"},{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#product#ec2-spot-instances","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Spot Instances","description":"Amazon EC2 Spot Instances","dateCreated":"2022-04-26T06:27:16+0000","dateUpdated":"2022-04-26T06:27:16+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBA