ry":"Paragon Technology and Innovation (PTI) scales its ecommerce website for its Wardãh line of cosmetics with AWS and speeds up deployment by 200 percent. PTI is an Indonesian beauty company serving its customers with a variety of homegrown cosmetics for over 40 years. Its Wardãh website runs on Amazon EC2 Auto Scaling instances, with Amazon RDS to scale its MySQL database.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Paragon_logo%401x.ecdb8e67e8cd43682629312416f37012373957af.png","displayLocation":"Indonesia","footerInfoText":"Published Date","industry":"Retail","sortDate":"2022-01-07","headlineUrl":"https://aws.amazon.com/solutions/case-studies/paragon-technology-and-innovation-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Paragon Technology and Innovation","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Paragon Technology and Innovation Reinvents the Digital Beauty Experience with Ecommerce on AWS"}},"tags":[{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#location#asean","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"ASEAN","description":"ASEAN","dateCreated":"2020-08-20T03:53:05+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"customer-references#category#databases","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Databases","description":"Databases","dateCreated":"2019-07-22T18:31:42+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-re