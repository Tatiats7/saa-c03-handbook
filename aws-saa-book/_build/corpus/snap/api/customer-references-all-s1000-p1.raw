e":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"customer-references#innovator#siemens","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Siemens","description":"Siemens","dateCreated":"2022-04-25T19:06:51+0000","dateUpdated":"2022-07-16T00:04:48+0000"}]},{"item":{"id":"customer-references#immersed-games-case-study","locale":"en_US","directoryId":"customer-references","name":"immersed-games-case-study","dateCreated":"2022-12-08T01:09:35+0000","dateUpdated":"2022-12-08T01:12:00+0000","additionalFields":{"descriptionSummary":"Immersed Games, an educational video game studio, used Amazon GameLift to achieve scalability and automate server management while cutting technology costs by 70 percent.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/immersed-games-logo%401x.b0969045cd25f7efe748c322fd2d037480c74e96.png","displayLocati