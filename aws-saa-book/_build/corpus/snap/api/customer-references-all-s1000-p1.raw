29:55+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#industry#automotive","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Automotive","description":"Automotive","dateCreated":"2020-01-16T17:42:11+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#featured-on#home-page","locale":"en_US","tagNamespaceId":"GLOBAL#featured-on","name":"Home Page","description":"Home Page","dateCreated":"2021-06-04T06:35:53+0000","dateUpdated":"2022-02-03T03:31:17+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#innovator#bmw","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"bmw","description":"\u003cp\u003eBMW is a customer in the Innovator Program.\u003c/p\u003e\n","dateCreated":"2022-08-12T19:46:58+0000","dateUpdated":"2022-08-12T19:46:58+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#innovator#innovator-hub","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Item in Innovator Hub","description":"\u003cp\u003eItems with this tag are being displayed in an Innovator-specific prefiltered Directory.\u003c/p\u003e\n","dateCreated":"2024-06-14T22:12:04+0000","dateUpdated":"2024-06-14T22:12:04+0000"}]},{"item":{"id":"customer-references#bmw-innovator-de","locale":"en_US","directoryId":"customer-references","name":"bmw-innovator-de","dateCreated":"2024-09-18T20:04:09+0000","dateUpdated":"2024-09-18T20:08:09+0000","additionalFields":{"descriptionSummary":"Die BMW Group ist ein weltweiter Hersteller von Premium-Automobilen und -Motorrädern und umfasst die Marken BMW, BMW Motorrad, MINI und Rolls-Royce. Die BMW Group entschied sich für eine Umstrukturierung und Migration ihres On-Premises-Data-Lake in die Cloud mit Amazon Web Services (AWS), um Innovation und Skalierung für die Nachfrage ihrer globalen Stakeholder zu ermöglichen. Der Cloud Data Hub (CDH) des Unternehmens verarbeitet und kombiniert anonymisierte Daten aus Fahrzeugsensoren und weiteren Quellen im gesamten Unternehmen, um internen Teams die Erstellung kundenseitiger und interner Anwendungen zu erleichtern. Die BMW Group setzt auf AWS, um die Agilität und Flexibilität zu erreichen, die sie benötigt, um die Datennutzung in großem Umfang zu demokratisieren und Innovationen zu beschleunigen.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/BMWGroup_logo_200x70_1X.3445718b3f949f158f9e3cac77d3ee79d4767a7f.jpg","displayLocation":"Deutschland","customerNameLower":"bmw group","industry":"Automobilbranche","sortDate":"2022-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/de/solutions/case-studies/innovators/bmw/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2022","contentType":"Kundengeschichte","customer-name":"BMW Group","headline":"BMW Group in AWS"}},"tags":[{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#germany","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Germany","description":"Germany","dateCreated":"2020-02-03T05:29:55+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#industry#automotive","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Automotive","description":"Automotive","dateCreated":"2020-01-16T17:42:11+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#location#dach","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"DACH","description":"DACH","dateCreated":"2020-02-03T05:29:52+0000","dateUpdated":"2022-02-03T03:31:47+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#language#german","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"German","description":"German","dateCreated":"2020-03-03T06:40:46+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"GLOBAL#location#europe","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe","description":"Europe","dateCreated":"2020-02-03T05:29:45+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"}]},{"item":{"id":"customer-references#moderna-reinvent-2022-amazon-connect-ai","locale":"en_US","directoryId":"customer-references","name":"moderna-reinvent-2022-amazon-connect-ai","dateCreated":"2023-08-30T20:08:00+0000","dateUpdated":"2024-03-02T02:48:50+0000","additionalFields":{"descriptionSummary":"learn how Moderna built an omnichannel AI engine using Amazon Lex, AWS Lambda, and Amazon Connect that can detect multifunctional intent and triage data into systems interconnected with categorical databases.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/moderna-innovator-logo.602bfdd3c41b0e7033e762c3557a5ff0633637d0.png","displayLocation":"United States","customerNameLower":"moderna","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2022-01-01","headlineUrl":"https://www.youtube.com/watch?v\u003dA5HMy9P6xbI\u0026did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Moderna","publishedDate":"2022","enableShare":"1","headline":"Commercial innovation at Moderna using Amazon Connect and AI","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#product#lex","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Lex","description":"Amazon Lex","dateCreated":"2020-03-02T07:04:21+0000","dateUpdated":"2022-02-03T03:32:47+0000"},{"id":"GLOBAL#methodology#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#methodology","name":"Serverless","description":"Serverless","dateCreated":"2020-06-05T07:06:34+0000","dateUpdated":"2022-02-03T03:32:11+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBA