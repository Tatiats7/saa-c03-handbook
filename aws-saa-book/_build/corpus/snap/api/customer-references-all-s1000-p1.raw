tent in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"customer-references#recon#auto-campaign","locale":"en_US","tagNamespaceId":"customer-references#recon","name":"auto-campaign","description":"\u003cp\u003eauto-campaign\u003c/p\u003e\n","dateCreated":"2023-12-04T18:22:48+0000","dateUpdated":"2023-12-04T18:22:48+0000"}]},{"item":{"id":"customer-references#whatwapp-case-study","locale":"en_US","directoryId":"customer-references","name":"whatwapp-case-study","dateCreated":"2023-04-10T18:16:05+0000","dateUpdated":"2024-02-20T22:25:51+0000","additionalFields":{"descriptionSummary":"Gaming company Whatwapp scales its business, manages its data and code, and delivers new features to players by using game server Nakama running on Amazon EKS clusters.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/whatwapp-logo%401x.335cd677dac36ef3e083c2f99c98343d07559d4a.png","displayLocation":"Italy","customerNameLower":"whatwapp entertainment","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2023-04-06","headlineUrl":"https://aws.amazon.com/solutions/case-studies/whatwapp-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Whatwapp Entertainment","publishedDate":"2023","enableShare":"1","headline":"Delivering Engaging Games at Scale Using AWS with Whatwapp","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#analytics","locale":"en_US","tagNamespaceId":"GLOBAL#tech-catego