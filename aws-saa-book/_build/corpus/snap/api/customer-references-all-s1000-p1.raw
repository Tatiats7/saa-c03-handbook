"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#business-category#cloud-cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#business-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-06-05T07:06:41+0000","dateUpdated":"2022-02-03T03:31:02+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#product#fsx-lustre","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon FSx for Lustre","description":"Amazon FSx for Lustre","dateCreated":"2020-03-02T07:03:33+0000","dateUpdated":"2022-02-03T03:32:38+0000"},{"id":"customer-references#category#cost-mgmt","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Cost Management","description":"Cost Management","dateCreated":"2019-07-22T18:31:35+0000","dateUpdated":"2023-07-15T01:16:11+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#product#fsx","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon FSx","description":"Amazon FSx","dateCreated":"2021-12-16T04:57:36+0000","dateUpdated":"2022-02-03T03:32:38+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#aerospace","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Aerospace","description":"Aerospace","dateCreated":"2020-06-25T04:02:36+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"}]},{"item":{"id":"customer-references#post","locale":"en_US","directoryId":"customer-references","name":"post","dateCreated":"2023-09-01T00:09:45+0000","dateUpdated":"2024-02-21T00:20:54+0000","additionalFields":{"descriptionSummary":"\u003cp\u003ePOST., founded by Payfazz \u0026mdash; one of Indonesia\u0026rsquo;s fastest-growing fintech startups \u0026mdash; is a business management app that provides Indonesian SMEs with point-of-sales (POS) and digital payments services, enabling potentially over 75% of SMEs to enter the digital commerce ecosystem. With Amazon Web Services\u0026#39; scalability, reliability and security, they are able to deliver a strong, reliable and flexible customer experience. They leverage Amazon Elastic Compute Cloud (EC2), Amazon Relational Database Service (RDS) and Amazon Simple Email Service (SES) to optimise costs while maintaining flexibility when scaling their services.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/POST_logo%401x.b9ad90b873bc09e6302147fe601762e22a9b9698.png","displayLocation":"Indonesia","customerNameLower":"post.","footerInfoText":"Published Date","industry":"Financial Services","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/post/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"POST.","publishedDate":"2023","enableShare":"1","headline":"POST. Drives Indonesian SMEs\u0027 Digital Transformation Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#product#rds","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon RDS","description":"Amazon RDS","dateCreated":"2020-03-02T07:05:00+0000","dateUpdated":"2022-02-03T03:32:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#industry#financial-services","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Financial Services","description":"Financial Services","dateCreated":"2020-01-16T17:42:19+0000","dateUpdated":"2022-02-03T03:32:03+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#use-case#business-apps","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Business Applications","description":"Business Applications","dateCreated":"2020-08-20T04:22:48+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"GLOBAL#tech-category#mobile","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Mobile","description":"Mobile","dateCreated":"2020-01-16T17:43:26+0000","dateUpdated":"2023-08-22T20:28:38+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#product#ses","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Email Service (SES)","description":"Amazon Simple Email Service (SES)","dateCreated":"2020-03-02T07:05:22+0000","dateUpdated":"2022-02-03T03:33:00+0000"},{"id":"customer-references#category#business-applications","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Business Applications","description":"Business Applications","dateCreated":"2019-07-22T18:31:07+0000","dateUpdated":"2022-03-17T20:28:40+0000"},{"id":"GLOBAL#location#indonesia","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Indonesia","description":"Indonesia","dateCreated":"2020-02-03T05:29:22+0000","dateUpdated":"2022-02-03T03:31:36+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#location#asean","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"ASEAN","description":"ASEAN","dateCreated":"2020-08-20T03:53:05+0000","dateUpdated":"2022-02-03T03:31:35+0000"}]},{"item":{"id":"customer-references#santander-argentina","locale":"en_US","directoryId":"customer-references","name":"santander-argentina","dateCreated":"2023-06-01T23:04:33+0000","dateUpdated":"2024-02-21T00:20:56+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eSantander es uno de los bancos m\u0026aacute;s grandes de Argentina, con alrededor de 10.000 empleados y presencia global, al ser parte del Grupo Santander. Recientemente, se ha convertido en un referente para el grupo, a nivel global, dado su camino de transformaci\u0026oacute;n digital basada en plataforma cloud. En este video, Eliana Moccia, Data \u0026amp; Analytics Technology Director, y Mauro Gonz\u0026aacute;lez, Head of Data Engineering de Santander, explican c\u0026oacute;mo la entidad eligi\u0026oacute; a AWS y sus servicios para innovar, centralizar datos en un datalake de 1 petabyte y convertirse en una organizaci\u0026oacute;n data driven.\u003c/p\u003e\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/santander_logo%402x.133d5f09a02e38a434e7434b82f4d64bd0ba6d60.png","displayLocation":"Argentina","customerNameLower":"banco santander rio s.a.","footerInfoText":"Fecha de publicaciÃ³n","industry":"Servicios financieros","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/santander-argentina/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Banco Santander Rio S.A.","enableShare":"1","publishedDate":"2023","contentType":"Historia del cliente","headline":"Santander Argentina se convierte en referente global gracias a su transformación basada en AWS"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML",