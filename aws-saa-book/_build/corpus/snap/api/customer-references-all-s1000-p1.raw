15T00:48:30+0000"},{"id":"customer-references#category#innovator","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Innovator","description":"Innovator","dateCreated":"2022-04-05T21:17:24+0000","dateUpdated":"2022-06-27T20:43:35+0000"},{"id":"customer-references#big-rocks#aws-for-data","locale":"en_US","tagNamespaceId":"customer-references#big-rocks","name":"AWS for Data","description":"\u003cp\u003eAWS for Data is a marketing \u0026ldquo;Big Rock\u0026rdquo; initiative that tells the story around how AWS can provide the most comprehensive set of data capabilities spanning databases, analytics, business intelligence, and machine learning for an end-to-end data strategy.\u003c/p\u003e\n","dateCreated":"2024-02-14T22:32:15+0000","dateUpdated":"2024-02-14T22:32:15+0000"}]},{"item":{"id":"customer-references#armut-case-study","locale":"en_US","directoryId":"customer-references","name":"armut-case-study","dateCreated":"2022-07-26T21:37:30+0000","dateUpdated":"2022-07-26T21:43:15+0000","additionalFields":{"descriptionSummary":"Turkey-based Armut connects consumers with professionals offering a wide variety of services, including home improvement, tuition, home moving, and health and wellness. To manage jobs effectively, its service uses a matching algorithm and digital notifications. As the company grew, its legacy technology no longer met its needs, so Armut developed a new system using AWS, which increased notification reliability and the volume of jobs it could handle. The business is now generating more income and supporting a greater number of customers without any additional staff.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/logo-armut%401x.7c2b43384d317bfc1821601237f5bd4adde4e64a.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"armut","footerInfoText":"Published Date","industry":"Professional Services","sortDate":"2022-07-26","headlineUrl":"https://aws.amazon.com/solutions/case-studies/armut-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Armut","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"Armut Teknoloji Improves Customer Experience with Scalable Notification System Using AWS"}},"tags":[{"id":"GLOBAL#product#lambda","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Lambda","description":"AWS Lambda","dateCreated":"2020-03-02T07:04:20+0000","dateUpdated":"2022-02-03T03:32:46+0000"},{"id":"GLOBAL#location#middle-east-africa","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Middle East \u0026 Africa","description":"Middle East \u0026 Africa","dateCreated":"2020-02-03T05:30:19+0000","dateUpdated":"2022-02-03T03:31:53+0000"},{"id":"GLOBAL#location#turkey","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Turkey","description":"Turkey","dateCreated":"2020-04-09T03:54:40+0000","dateUpdated":"2022-02-03T03:31:56+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#customer-engagement","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Customer Engagement","description":"Customer Engagement","dateCreated":"2019-07-22T18:31:37+0000","dateUpdated":"2022-03-21T23:37:45+0000"},{"id":"customer-references#category#content-delivery","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Content Delivery","description":"Content Delivery","dateCreated":"2019-07-22T18:31:34+0000","dateUpdated":"2022-02-05T01:27:38+0000"},{"id":"GLOBAL#product#mq","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon MQ","description":"Amazon MQ","dateCreated":"2020-03-02T07:04:38+0000","dateUpdated":"2022-02-03T03:32:51+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Com