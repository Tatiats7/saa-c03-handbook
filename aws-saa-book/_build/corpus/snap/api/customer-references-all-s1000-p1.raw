ge owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"customer-references#big-rocks#aws-for-data","locale":"en_US","tagNamespaceId":"customer-references#big-rocks","name":"AWS for Data","description":"\u003cp\u003eAWS for Data is a marketing \u0026ldquo;Big Rock\u0026rdquo; initiative that tells the story around how AWS can provide the most comprehensive set of data capabilities spanning databases, analytics, business intelligence, and machine learning for an end-to-end data strategy.\u003c/p\u003e\n","dateCreated":"2024-02-14T22:32:15+0000","dateUpdated":"2024-02-14T22:32:15+0000"}]},{"item":{"id":"customer-references#shikshalokam-case-study","locale":"en_US","directoryId":"customer-references","name":"shikshalokam-case-study","dateCreated":"2022-06-07T17:22:54+0000","dateUpdated":"2022-06-07T17:31:13+0000","additionalFields":{"descriptionSummary":"By hosting its microservices platform on AWS, ShikshaLokam ensures 99.5% uptime and scalability to support more than 150,000 end users. ShikshaLokam is an NGO in India providing open-source education leadership development programs to K-12 institutions.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/ShikshaLokam_Logo%401x.e23255f081abbd3b90c95c028bbe2e4506a8cfa1.png","displayLocation":"India","customerNameLower":"shikshalokam","footerInfoText":"Published Date","industry":"Education","sortDate":"2022-06-07","headlineUrl":"https://aws.amazon.com/solutions/case-studies/shikshalokam-case-study?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"ShikshaLokam","enableShare":"1","publishedDate":"2022","contentType":"Customer Story","headline":"ShikshaLokam Empowers 150,000 Public Education Leaders in India with Training Platform on AWS"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-catego