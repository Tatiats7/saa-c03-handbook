"dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#namer","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"North America","description":"North America","dateCreated":"2020-02-03T05:29:03+0000","dateUpdated":"2022-02-03T03:31:34+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#taggle-systems-case-study","locale":"en_US","directoryId":"customer-references","name":"taggle-systems-case-study","dateCreated":"2022-10-31T22:33:55+0000","dateUpdated":"2023-07-12T01:40:47+0000","additionalFields":{"descriptionSummary":"Taggle Systems relies on AWS to ingest data from 270,000 existing and 80,000 new sensors across Australia, integrate seamlessly with third-party devices, applications, and networks, accelerate time to market, and help customers reduce costs. The company is Australia’s leading supplier of smart water solutions for local and regional councils and water utilities.","imageSrcUrl":"https://d1.a