is by leveraging AWS Service Catalog and AWS CloudFormation to automate the creation of such environments with built-in compliance.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/Roche_logo.200x100_X1.0afcb03f5e56ac942b9b10c9b16c20a37bd3c7f4.png","displayLocation":"United States","customerNameLower":"roche pharma","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2022-04-20","headlineUrl":"https://youtu.be/oTtPNgcZ05I?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Roche Pharma","publishedDate":"2022","enableShare":"1","headline":"Roche: Enabling Enterprise-Wide Analytics and ML with Automated Compliance","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Global","description":"Global","dateCreated":"2020-02-03T05:28:59+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tec