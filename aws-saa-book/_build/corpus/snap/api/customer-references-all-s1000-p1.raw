03T03:32:22+0000"}]},{"item":{"id":"customer-references#papyrus-studio-case-study","locale":"en_US","directoryId":"customer-references","name":"papyrus-studio-case-study","dateCreated":"2022-09-22T02:54:50+0000","dateUpdated":"2023-07-14T23:32:33+0000","additionalFields":{"descriptionSummary":"Papyrus Studio is a Thailand-based company that provides visual effects and animation services for films, television shows, commercials, as well as video games. It chose to work with AWS as the AWS Cloud would provide the flexibility to adapt to future business needs without overcommitting on its initial budgets.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/Papyrus_Studio%401x.dede629f2f19b594912720446878fbfce00cfd0d.png","displayLocation":"Thailand","customerNameLower":"papyrus studio","footerInfoText":"Published Date","industry":"Media \u0026 Entertainment","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/papyrus-studio-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Papyrus Studio","publishedDate":"2022","enableShare":"1","headline":"Papyrus Studio Creates Brand New Service Stream on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#ec2-spot-instances","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2 Spot Instances","description":"Amazon EC2 Spot Instances","dateCreated":"2022-04-26T06:27:16+0000","dateUpdated":"2022-04-26T06:27:16+0000"},{"id":"GLOBAL#product#fsx-lustre","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon FSx for Lustre","description":"Amazon FSx for Lustre","dateCreated":"2020-03-02T07:03:33+0000","dateUpdated":"2022-02-03T03:32:38+0000"},{"id":"GLOBAL#location#asean","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"ASEAN","description":"ASEAN","dateCreated":"2020-08-20T03:53:05+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#location#thailand","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Thailand","description":"Thailand","dateCreated":"2020-02-03T05:29:40+0000","dateUpdated":"2022-02-03T03:31:37+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#fsx","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon FSx","description":"Amazon FSx","dateCreated":"2021-12-16T04:57:36+0000","dateUpdated":"2022-02-03T03:32:38+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"customer-references#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Mid-Market","description":"Mid-Market","dateCreated":"2019-07-22T18:39:44+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#cost-mgmt","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Cloud Financial Management","description":"Cloud Financial Management","dateCreated":"2020-01-16T17:43:13+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#aceros-de-guatemala","locale":"en_US","directoryId":"customer-references","name":"aceros-de-guatemala","dateCreated":"2023-06-01T23:06:02+0000","dateUpdated":"2023-06-08T04:07:40+0000","additionalFields":{"descriptionSummary":"Corporación Aceros de Guatemala es una empresa productora y comercializadora de productos derivados del acero desde 1953. Comprometida con la entrega de soluciones innovadoras y la excelencia de servicio al cliente, Miguel Marín, gerente de tecnología de Corporación AG, y su equipo se enfrentaron con el reto de proveer la elasticidad y la flexibilidad que necesitaban para poder responder a la demanda del negocio al ritmo que el mercado lo estaba exigiendo. Para transformar este escenario, Corporación AG eligió a Escala 24x7 para apoyar la implementación de distintas soluciones de Amazon Web Services, como instancias de Amazon EC2, Amazon S3 y AWS Backup. Te invitamos a ver este video para saber más acerca sobre el uso que Corporación AG hace de las soluciones AWS para enfrentar sus retos diarios.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/acerosdeguatemala_logo%401x.37ba6a99a099fb2db6ee35bedc397c576d9c4698.png","customerNameLower":"aceros de guatemala","footerInfoText":"Fecha de publicación","industry":"Fabricación","sortDate":"2022-01-01","enableShare":"1","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/aceros-de-guatemala/?did\u003dcr_card\u0026trk\u003dcr_card","publishedDate":"2022","contentType":"Historia del cliente","customer-name":"Aceros de Guatemala","headline":"Corporación AG implementa AWS para seguir innovando"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#tech-category#serverless","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Serverless","description":"Serverless","dateCreated":"2021-07-28T18:46:39+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#s3","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Simple Storage Service (S3)","description":"Amazon Simple Storage Service (S3)","dateCreated":"2020-03-02T07:05:09+0000","dateUpdated":"2022-02-03T03:32:58+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#ec2","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon EC2","description":"Amazon EC2","dateCreated":"2020-03-02T07:02:51+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#industry#manufacturing","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Manufacturing","description":"Manufacturing","dateCreated":"2020-01-16T17:42:32+0000","dateUpdated":"2022-02-03T03:32:06+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#product#backup","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Backup","description":"AWS Backup","dateCreated":"2020-03-02T07:01:40+0000","dateUpdated":"2022-02-03T03:32:19+0000"}]},{"item":{"id":"customer-references#jotabasso","locale":"en_US","directoryId":"customer-references","name":"jotabasso","dateCreated":"2023-06-01T23:04:29+0000","dateUpdated":"2023-06-08T04:07:49+0000","additionalFields":{"descriptionSummary":"A Jotabasso é uma empresa brasileira de sementes e agricultura com sede no Cerrado, que é uma ecorregião de savana tropical que se estende por grande parte do Brasil central e se tornou popular para atividades agrícolas no final dos anos 1990 e início dos anos 2000. A empresa também trabalha com diversos setores de diferentes operações agrícolas.\n\nA Jotabasso se originou no Rio Grande do Sul antes de se mudar para a região do Cerrado na década de 1970. Foi uma das primeiras empresas de sementes daquela região e hoje tem mais de 900 funcionários, com cinco unidades de produção nas áreas centrais do Brasil.\n\nHoje, a empresa é especializada no plantio de soja e outros grãos, como trigo, milho e sorgo, que são usados principalmente como ração animal. A Jotabasso também se aventurou na criação de gado de corte. A organização opera grandes laboratórios de análise de sementes e instalações de armazenamento e criou um sistema integrado de lavoura-pecuária e confinamento para ajudar os agricultores a aumentar a produtividade e a sustentabilidade.\n\nPara manter e expandir todas as suas atividades com maior eficiência, a Jotabasso decidiu procurar um provedor de nuvem que pudesse hospedar seus dados e ajudar a empresa a criar soluções tecnológicas inovadoras para suas operações e usuários.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/jotabasso-logo%402x.e706d28cc6c94d999729b54b3f38986197427921.png","displayLocation":"Brasil","customerNameLower":"jotabasso","footerInfoText":"Data de publicação","industry":"Varejo","sortDate":"2022-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/jotabasso/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Jotabasso","enableShare":"1","publishedDate":"2022","contentType":"História do cliente","headline":"Modernizando a agricultura em grande escala com a nuvem AWS"}},"tags":[{"id":"GLOBAL#product#ebs","locale":"en_US","tagNamespac