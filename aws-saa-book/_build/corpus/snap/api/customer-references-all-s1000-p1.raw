00"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"}]},{"item":{"id":"customer-references#itom","locale":"en_US","directoryId":"customer-references","name":"itom","dateCreated":"2024-08-08T15:00:53+0000","dateUpdated":"2024-08-08T15:23:48+0000","additionalFields":{"descriptionSummary":"iTom is a software development company based in Romania that creates innovative SaaS solutions to help the digitalization efforts of its customers. When it expanded into financial services, it turned to AWS to provide high levels of security and ensure compliance with European and local regulations. Using AWS, iTom can better manage its infrastructure and prevent unauthorized or accidental access to customer data by potential intruders or even its own staff. It has also improved its development processes so its entire team can proactively innovate and update features that improve the customer experience, rather than spending time maintaining infrastructure and reacting to problems.","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/itom-logo%401x.df0dbd92571e831c23225ba42d0dc44bde7b3aca.png","displayLocation":"Europe, Middle East, \u0026 Africa","customerNameLower":"i-tom solutions","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2022-10-06","headlineUrl":"https://aws.amazon.com/solutions/case-studies/itom-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"i-Tom Solutions","publishedDate":"2022","enableShare":"1","headline":"iTom Boosts Business and Scales for Growth Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#documentdb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DocumentDB","description":"Amazon DocumentDB","dateCreated":"2020-03-02T07:02:46+0000","dateUpdated":"2022-02-03T03:32:30+0000"},{"id":"GLOBAL#tech-category#security-identity-compliance","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2020-01-16T17:43:33+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#product#secrets-mgr","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"AWS Secrets Manager","description":"AWS Secrets Manager","dateCreated":"2020-03-02T07:05:14+0000","dateUpdated":"2022-02-03T03:32:59+0000"},{"id":"GLOBAL#customer-segment#mid-market","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Mid-Market Territory (MMT)","description":"Mid