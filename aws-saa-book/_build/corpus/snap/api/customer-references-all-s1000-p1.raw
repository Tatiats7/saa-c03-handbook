20-01-16T17:43:23+0000","dateUpdated":"2022-02-03T03:35:28+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"GLOBAL#industry#media-entertainment","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Media \u0026 Entertainment","description":"Media \u0026 Entertainment","dateCreated":"2020-01-16T17:42:34+0000","dateUpdated":"2022-02-03T03:32:07+0000"},{"id":"GLOBAL#location#peru","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Peru","description":"Peru","dateCreated":"2021-02-19T05:32:36+0000","dateUpdated":"2022-02-03T03:31:33+0000"},{"id":"GLOBAL#customer-segment#smb","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Small and Midsize Business (SMB)","description":"Small and Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#anima-case-study","locale":"en_US","directoryId":"customer-references","name":"anima-case-study","dateCreated":"2023-06-01T23:04:40+0000","dateUpdated":"2023-06-08T04:07:48+0000","additionalFields":{"descriptionSummary":"A holding Ânima Educação representa hoje um dos maiores ecossistemas educacionais do país, com aproximadamente 380 mil alunos de cursos de Ensino Superior e Educação Continuada. Inicialmente, a instituição implementou serviços essenciais de nuvem, como Amazon Elastic Compute Cloud (Amazon EC2) e Amazon Simple Storage Service (Amazon S3) para solucionar problemas de escala e sazonalidade peculiares ao setor, especialmente os picos de demanda em períodos de rematrículas e provas. A confiança na AWS cresceu e a holding hoje utiliza banco de dados, serviços de orquestração de containeres e outros serviços para desenvolver, construir e testar novos produtos com agilidade. É essa evolução - e a forma como a Ânima Educação tem adotado serviços AWS para construir o seu futuro - que especialistas em TI da empresa explicam neste vídeo.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/anima-educacao-logo%402x.23fec6f63c46870b661ca39cf4d22f97a9b01d9f.png","displayLocation":"Brasil","customerNameLower":"ânima","footerInfoText":"Data de publicação","industry":"Educação","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/pt/solutions/case-studies/anima-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Ânima","enableShare":"1","publishedDate":"2023","contentType":"História do cliente","headline":"Ânima Educação aposta na AWS para construir seu futuro"}},"tags":[{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#brazil","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Brazil","description":"Brazil","dateCreated":"2020-04-20T18:05:21+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#industry#education","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Education","description":"Education","dateCreated":"2020-01-16T17:42:17+0000","dateUpdated":"2022-02-03T03:32:01+0000"},{"id":"GLOBAL#location#americas","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Americas","description":"Americas","dateCreated":"2020-02-03T05:29:01+0000","dateUpdated":"2022-02-03T03:31:29+0000"},{"id":"GLOBAL#language#portuguese","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Portuguese","description":"Portuguese","dateCreated":"2020-03-03T06:40:56+0000","dateUpdated":"2022-02-03T03:31:26+0000"}]},{"item":{"id":"customer-references#copec-case-study-from-es-directory","locale":"en_US","directoryId":"customer-references","name":"copec-case-study-from-es-directory","dateCreated":"2024-02-03T03:46:41+0000","dateUpdated":"2024-02-06T01:35:38+0000","additionalFields":{"descriptionSummary":"En 2022, COPEC, una de las principales distribuidoras de combustible de Chile, adoptó Red Hat OpenShift (ROSA) en Amazon Web Services como su nuevo canal de integraciones. De la mano con Escala 24x7, la compañía logró hacer su transformación tecnológica en tres meses.\nEn este video, Eduardo Diaz, arquitecto de integraciones, y Olaya Medina, jefa de arquitectura de COPEC, explican que la empresa definió que todas sus nuevas plataformas serían construidas con servicios de AWS. La nueva arquitectura los llevó a beneficios de negocio como la reducción de los tiempos de respuesta en un 50%, tener la capacidad de escalar y mejorar su time-to-market.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/copec%20logo%402x.87cf65990d1991c831e3fb316a5ed2a00736303a.png","displayLocation":"Chile","customerNameLower":"copec","footerInfoText":"Fecha de publicación","industry":"Fabricación","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/es/solutions/case-studies/copec-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Copec","enableShare":"1","publishedDate":"2023","contentType":"Historia del cliente","headline":"COPEC reduce tiempos de respuesta en un 50% con migración a la nube AWS"}},"tags":[{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#location#latam","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Latin America","description":"Latin America","dateCreated":"2020-02-03T05:29:06+0000","dateUpdated":"2022-02-03T03:31:30+0000"},{"id":"GLOBAL#location#chile","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Chile","description":"Chile","dateCreated":"2020-07-02T22:30:55+0000","dateUpdated":"2022-02-03T03:31:32+0000"},{"id":"GLOBAL#language#spanish","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"Spanish","description":"Spanish","dateCreated":"2020-03-03T06:40:59+0000","dateUpdated":"2022-02-03T03:31:26+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000",