:19+0000","dateUpdated":"2023-07-14T23:32:44+0000","additionalFields":{"descriptionSummary":"By going serverless on AWS, Green Flag has achieved the agility and scalability it needs to handle unforeseen fluctuations in demand and quickly respond to drivers who need assistance at any time and at any location in Europe.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/green-flag-logo%401x.b42285bc061a640e181ea3570d4fb54a4e5fa3b4.png","displayLocation":"Europe, Middle East, \u0026 Africa","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2022-05-20","headlineUrl":"https://aws.amazon.com/solutions/case-studies/green-flag-aws-is-how/?did\u003dcr_card\u0026trk\u003dcr_card","enableShare":"1","publishedDate":"2022","customer-name":"Green Flag","contentType":"Customer Story","headline":"AWS is How: Green Flag Powers Mobile App and Chatbots, Serves 3.5 Million Drivers"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#category#serverless","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Serverless","description":"Serverless","dateCreated":"2019-07-22T18:32:23+0000","dateUpdated":"2022-03-24T02:42:26+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East,