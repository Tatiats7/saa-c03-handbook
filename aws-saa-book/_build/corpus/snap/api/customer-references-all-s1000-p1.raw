cale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"GLOBAL#product#eks","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Elastic Kubernetes Service (EKS)","description":"Amazon Elastic Kubernetes Service (EKS)","dateCreated":"2020-03-02T07:02:58+0000","dateUpdated":"2022-02-03T03:32:32+0000"}]},{"item":{"id":"customer-references#aqemia","locale":"en_US","directoryId":"customer-references","name":"aqemia","dateCreated":"2023-06-01T23:05:31+0000","dateUpdated":"2023-09-07T23:50:14+0000","additionalFields":{"videoSrcUrl":"https://youtu.be/nBfgqThuEdY","descriptionSummary":"\u003cp\u003eAqemia est une plateforme digitale de recherche acc\u0026eacute;l\u0026eacute;r\u0026eacute;e de m\u0026eacute;dicaments. Sa mission est de designer rapidement des candidats m\u0026eacute;dicaments innovants pour des dizaines de maladies. Le c\u0026oelig;ur de leur innovation r\u0026eacute;side dans des algorithmes uniques de physique th\u0026eacute;orique issus de 12 ann\u0026eacute;es de recherche fondamentale \u0026agrave; Oxford, Cambridge et CNRS. Jacques Boitreaud, Machine Learning Lead chez Aqemia nous explique comment la vitesse et pr\u0026eacute;cision in\u0026eacute;dites de leur plateforme technologique, permet \u0026agrave; la startup de contribuer \u0026agrave; l\u0026rsquo;acc\u0026eacute;l\u0026eacute;ration de la recherche pharmaceutique sur les maladies cl\u0026eacute;s d\u0026rsquo;aujourd\u0026rsquo;hui avec l\u0026rsquo;accompagnement d\u0026rsquo;AWS.\u003c/p\u003e\r\n","featured":"0","featureImageURL":"https://d1.awsstatic.com/Aqemia.d3f8ac3118b5c5bcdb9b0f8ccde47e071607b262.png","imageSrcUrl":"https://d1.awsstatic.com/Aqemia.d3f8ac3118b5c5bcdb9b0f8ccde47e071607b262.png","displayLocation":"France","customerNameLower":"aqemia","footerInfoText":"Date de publication","industry":"Santé","sortDate":"2023-02-22","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/aqemia/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Aqemia","enableShare":"1","publishedDate":"2022","contentType":"Témoignages clients","headline":"Aqemia accélère la découverte de médicaments"}},"tags":[{"id":"GLOBAL#industry#healthcare","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Healthcare","description":"Healthcare","dateCreated":"2020-01-16T17:42:26+0000","dateUpdated":"2022-02-03T03:32:05+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05:29:58+0000","dateUpdated":"2022-02-03T03:31:48+0000"},{"id":"GLOBAL#tech-category#ai-ml","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Machine Learning \u0026 AI","description":"Machine Learning \u0026 AI","dateCreated":"2020-01-16T17:43:01+0000","dateUpdated":"2022-02-03T03:35:22+0000"},{"id":"customer-references#category#ai-ml","locale":"en_US","tagNamespaceId":"customer-references#category","name":"AI \u0026 ML","description":"AI \u0026 ML","dateCreated":"2019-07-22T18:30:52+0000","dateUpdated":"2022-02-07T13:55:54+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"},{"id":"customer-references#customer-segment#startup","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Startup","description":"Startup","dateCreated":"2019-07-22T18:39:50+0000","dateUpdated":"2022-02-15T04:54:51+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#content-type#customer-story","local