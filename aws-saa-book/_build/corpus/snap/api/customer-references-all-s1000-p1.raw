"en_US","tagNamespaceId":"customer-references#category","name":"Backup \u0026 Restore","description":"Backup \u0026 Restore","dateCreated":"2019-07-22T18:31:01+0000","dateUpdated":"2022-04-09T03:06:56+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","description":"Security, Identity, \u0026 Compliance","dateCreated":"2019-07-22T18:32:22+0000","dateUpdated":"2022-02-15T04:54:50+0000"},{"id":"GLOBAL#use-case#archiving","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Archiving","description":"Archiving","dateCreated":"2020-06-05T06:36:56+0000","dateUpdated":"2022-02-03T03:35:34+0000"},{"id":"customer-references#category#storage","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Storage","description":"Storage","dateCreated":"2019-07-22T18:32:25+0000","dateUpdated":"2022-02-12T02:01:31+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#industry#healthcare-lifesciences","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"healthcare-lifesciences","description":"\u003cp\u003eThis tag is initially being created specifically for the Directory Cards componenet on aws.amazon.com/health/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can use the AND operator to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2023-04-26T20:23:44+0000","dateUpdated":"2023-04-26T20:23:44+0000"},{"id":"customer-references#business-outcome#cost-optimization","locale":"en_US","tagNamespaceId":"customer-references#business-outcome","name":"cost-optimization","description":"Cost Optimization","dateCreated":"2019-07-22T18:39:02+0000","dateUpdated":"2019-07-22T18:39:02+0000"},{"id":"customer-references#category#compute","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Compute","description":"Compute","dateCreated":"2019-07-22T18:31:28+0000","dateUpdated":"2022-02-12T02:01:30+0000"}]},{"item":{"id":"customer-references#thefork-aws-is-how","locale":"en_US","directoryId":"customer-references","name":"thefork-aws-is-how","dateCreated":"2023-06-01T23:05:33+0000","dateUpdated":"2023-07-18T00:18:10+0000","additionalFields":{"descriptionSummary":"\u003cp\u003eEn utilisant les solutions cloud sur AWS, TheFork peut facilement stocker les informations de r\u0026eacute;servation de plusieurs millions d\u0026rsquo;utilisateurs et cr\u0026eacute;er des pages web personnalis\u0026eacute;es pour chacun de ses restaurants partenaires.\u003c/p\u003e\r\n","featured":"0","featureImageURL":"https://d1.awsstatic.com/emea-customer-references/emea-customer-images/AWS_Is_How_TheFork_image01.7f83e77807e81062d6cf2e59da8131df67828467.png","imageSrcUrl":"https://d1.awsstatic.com/emea-customer-references/emea-customer-images/AWS_Is_How_TheFork_image01.7f83e77807e81062d6cf2e59da8131df67828467.png","displayLocation":"France","customerNameLower":"thefork","footerInfoText":"Date de publication","industry":"Logiciels et Interne