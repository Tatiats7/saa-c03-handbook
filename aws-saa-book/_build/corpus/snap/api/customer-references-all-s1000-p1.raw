ion":"Networking \u0026 Content Delivery","dateCreated":"2019-07-22T18:32:15+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"customer-references#innovator#vw-group","locale":"en_US","tagNamespaceId":"customer-references#innovator","name":"Volkswagen","description":"Volkswagen","dateCreated":"2022-04-25T19:07:02+0000","dateUpdated":"2022-09-15T00:48:45+0000"}]},{"item":{"id":"customer-references#too-good-to-go-case-study","locale":"en_US","directoryId":"customer-references","name":"too-good-to-go-case-study","dateCreated":"2024-02-17T00:42:31+0000","dateUpdated":"2024-08-13T14:59:19+0000","additionalFields":{"descriptionSummary":"Every year, around $1 trillion worth of edible food gets thrown away, while 828 million people are affected by hunger every day. And by some reports, wasted food represents up to 10 percent of all human-caused greenhouse gas emissions. Too Good To Go seeks to inspire and empower everyone to fight food waste together through a service with which users can save unsold food at their favorite restaurants and stores.","featured":"0","featureImageURL":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/too-good-to-go-logo%401x.c3c4e672e354198bc93e7898fe585619d3525831.png","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/too-good-to-go-logo%401x.c3c4e672e354198bc93e7898fe585619d3525831.png","displayLocation":"Denmark","customerNameLower":"too good to go","footerInfoText":"Published Date","industry":"Hospitality","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/too-good-to-go-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Too Good To Go","publishedDate":"2023","enableShare":"1","headline":"Saving 250 Million Meals from Waste Using AWS Managed Services with Too Good To Go","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#product#aurora","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Aurora","description":"Amazon Aurora","dateCreated":"2020-03-02T07:01:37+0000","dateUpdated":"2022-02-03T03:32:18+0000"},{"id":"GLOBAL#location#emea","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Europe, Middle East, \u0026 Africa","description":"Europe, Middle East, \u0026 Africa","dateCreated":"2020-02-03T05:29:43+0000","dateUpdated":"2022-02-03T03:31:40+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#location#nordics","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Nordics","description":"Nordics","dateCreated":"2020-02-03T05:30:04+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#location#denmark","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Denmark","description":"Denmark","dateCreated":"2020-02-03T05:30:06+0000","dateUpdated":"2022-02-03T03:31:50+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#use-case#sustainability","locale":"en_US","tagNamespaceId":"GLOBAL#use-case","name":"Sustainability","description":"Sustainability","dateCreated":"2021-07-02T05:53:58+0000","dateUpdated":"2022-02-03T03:35:58+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":