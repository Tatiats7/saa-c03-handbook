teUpdated":"2022-02-03T03:35:22+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#content-type#reference-arch-diagram","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Reference Architecture Diagram","description":"Reference Architecture Diagram","dateCreated":"2020-04-29T05:19:31+0000","dateUpdated":"2022-02-03T03:31:09+0000"}]},{"item":{"id":"customer-references#sportsbet-anz-summit-2022","locale":"en_US","directoryId":"customer-references","name":"sportsbet-anz-summit-2022","dateCreated":"2024-03-05T01:11:31+0000","dateUpdated":"2024-03-05T01:14:48+0000","additionalFields":{"descriptionSummary":"AWS Sydney Summit 2022, Sportsbet speaking opportunity discussing how they are a data-driven organization, what it is, and journey to becoming one.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/Sportsbet_Logo@2x.deb4ef0022af77162ca92265465147b7c1cd6813.png","displayLocation":"Australia \u0026 New Zealand","customerNameLower":"sportsbet","footerInfoText":"Published Date","industry":"Gaming","sortDate":"2022-05-17","headlineUrl":"https://www.youtube.com/watch?v\u003d32Qb-kYA6eI\u0026list\u003dPL2yQDdvlhXf8P1TFIajuhlSjhahriKpNy\u0026index\u003d16\u0026did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Sportsbet","publishedDate":"2022","enableShare":"1","headline":"AWS T\u0026C - Skills Guild: AWS Summit ANZ 2022 - The journey to becoming a data-driven organisation (DATA2)","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#customer-enablement#training-cert","locale":"en_US","tagNamespaceId":"GLOBAL#customer-enablement","name":"Training \u0026 Certification","description":"Training \u0026 Certification","dateCreated":"2020-09-04T04:06:29+0000","dateUpdated":"2022-02-03T03:31:13+0000"},{"id":"GLOBAL#content-type#video","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Video","description":"Video","dateCreated":"2020-04-29T05:19:43+0000","dateUpdated":"2022-02-03T03:31:11+0000"},{"id":"GLOBAL#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Enterprise (ENT)","description":"Enterprise (ENT)","dateCreated":"2021-06-04T06:35:40+0000","dateUpdated":"2022-02-03T03:31:14+0000"},{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#location#anz","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Australia \u0026 New Zealand","description":"Australia \u0026 New Zealand","dateCreated":"2020-04-09T00:26:11+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#industry#gaming","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Gaming","description":"Gaming","dateCreated":"2020-01-16T17:42:21+0000","dateUpdated":"2022-02-03T03:32:04+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"customer-references#big-rocks#aws-for-data","locale":"en_US","tagNamespaceId":"customer-references#big-rocks","name":"AWS for Data","description":"AWS for Data","dateCreated":"2024-02-14T22:32:15+0000","dateUpdated":"2024-03-05T01:11:26+0000"},{"id":"GLOBAL#content-type#customer-story","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Customer Story","description":"Customer Story","dateCreated":"2020-04-29T05:19:24+0000","dateUpdated":"2022-02-03T03:31:07+0000"}]},{"item":{"id":"customer-references#novartis05162022kjlsdnflkafd","locale":"en_US","directoryId":"customer-references","name":"novartis05162022kjlsdnflkafd","dateCreated":"2023-02-08T01:17:33+0000","dateUpdated":"2023-07-12T01:35:19+0000","additionalFields":{"descriptionSummary":"Procuring lab supplies required manual comparison of item prices in several vendor catalogs. Overspending, inventory mismanagement, and delays for R\u0026D and production. Novartis Buying Engine solves this challenge by providing a centralized purchasing platform with search and recommendations. Catalog data is automatically extracted from unstructured vendor catalogs using Machine Learning with Amazon SageMaker. Data is stored in DynamoDB, Neptune, and OpenSearch. The shopping portal itself is fully serverless, being hosted on Lambda and Api Gateway.","imageSrcUrl":"https://d1.awsstatic.com/customer-references-case-studies-logos/Novartis_Customer-Reference_Logo%402x1.d5822f831bf752cc9cc91350e9a3e893d0052c02.png","displayLocation":"United States","customerNameLower":"novartis ag","footerInfoText":"Published Date","industry":"Healthcare","sortDate":"2022-05-16","headlineUrl":"https://youtu.be/vp8oPiHN4cA?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Novartis AG","publishedDate":"2022","enableShare":"1","headline":"Novartis - Buying Engine: AI-powered Procurement Portal","contentType":"Customer Story"}},"tags":[{"id":"customer-references#customer-segment#enterprise","locale":"en_US","tagNamespaceId":"customer-references#customer-segment","name":"Enterprise","description":"Enterprise","dateCreated":"2019-07-22T18:39:40+0000","dateUpdated":"2022-02-05T01:27:39+0000"},{"id":"GLOBAL#product#dynamodb","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon DynamoDB","description":"Amazon DynamoDB","dateCreated":"2020-03-02T07:02:48+0000","dateUpdated":"2022-02-03T03:32:31+0000"},{"id":"GLOBAL#location#global","locale":"en_US","tagNamespaceId":"GLOBAL#locatio