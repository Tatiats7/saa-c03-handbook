eferences#category#containers","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Containers","description":"Containers","dateCreated":"2019-07-22T18:31:32+0000","dateUpdated":"2022-02-19T05:00:37+0000"},{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"customer-references#industry#travel-and-hospitality","locale":"en_US","tagNamespaceId":"customer-references#industry","name":"travel-and-hospitality","description":"\u003cp\u003eAs of 4/2023, this tag is initially being used specifically for the Directory Cards componenet on aws.amazon.com/travel-and-hospitality/case-studies/. When the GCRP decided to add multilingual content to the CSDIR in 2023, the owners of this page only wanted to display the English content in our Directory. Because the Directory Cards component on their page uses an OR operator to pull in content from two tags, they would be unable to add a prefilter condition to look for only English content. This can only be done if the page is using an AND operator. Thus, this tag will be autoapplied to all content that meets the current prefilter conditions. At that point, the page owners can switch to the AND operator, enabling them to display content with this tag and GLOBAL#language#english.\u003c/p\u003e\n","dateCreated":"2019-07-17T22:21:56+0000","dateUpdated":"2023-04-26T20:41:02+0000"}]},{"item":{"id":"customer-references#vicone","locale":"en_US","directoryId":"customer-references","name":"vicone","dateCreated":"2023-07-29T00:30:40+0000","dateUpdated":"2024-02-20T22:26:12+0000","additionalFields":{"descriptionSummary":"VicOne, a subsidiary of cloud and enterprise cybersecurity company Trend Micro, is driving the adoption of cybersecurity systems across the automotive industry with its xNexus platform, an extended detection and response solution.\n\nLeveraging AWS IoT FleetWise, the platform rapidly integrates vehicle data into Amazon Timestream databases, while VicOne\u0027s Kubernetes-based applications, managed by Amazon EKS, handles analysis and detection. This streamlined process speeds up data integration, cuts proof-of-concept time by up to 50 percent, and reduces costs.","imageSrcUrl":"https://d1.awsstatic.com/Customer%20References%20Directory%20Logos/vicone-logo%401x.a723af1a2cc5aa39730b834f8775bdb32372deb2.png","displayLocation":"Taiwan","customerNameLower":"vicone","footerInfoText":"Published Date","industry":"Automotive","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/VicOne/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"VicOne","publishedDate":"2023","enableShare":"1","headline":"VicOne Provides Faster Automotive Cybersecurity Using AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#customer-segment#startup","locale":"en_US","tagNamespaceId":"GLOBAL#customer-segment","name":"Startup (SUP)","description":"Startup (SUP)","dateCreated":"2021-06-04T06:35:50+0000","dateUpdated":"2022-02-03T03:31:16+0000"},{"id":"GLOBAL#industry#automotive","locale":"en_US","tagNamespaceId":"GLOBAL#industry","name":"Automotive","description":"Automotive","dateCreated":"2020-01-16T17:42:11+0000","dateUpdated":"2022-02-03T03:32:00+0000"},{"id":"GLOBAL#tech-category#iot","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Internet of Things (IoT)","description":"Internet of Things (IoT)","dateCreated":"2020-01-16T17:43:19+0000","dateUpdated":"2023-08-22T20:28:39+0000"},{"id":"customer-references#category#security-identity-compliance","locale":"en_US","tagNamespaceId":"customer-references#category","name":"Security, Identity, \u0026 Compliance","descri