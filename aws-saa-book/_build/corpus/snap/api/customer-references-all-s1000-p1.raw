tions \u0026agrave; haute valeur ajout\u0026eacute;e gr\u0026acirc;ce \u0026agrave; l\u0026rsquo;utilisation de technologies innovantes comme le machine learning.\u003c/p\u003e\r\n","featured":"0","imageSrcUrl":"https://d1.awsstatic.com/tiime%20-%20logo.9ad780852522b82ee447ebdf24dfd6ac0b4524e1.png","displayLocation":"France","customerNameLower":"tiime","footerInfoText":"Date de publication","industry":"Logiciels et Internet","sortDate":"2023-04-12","headlineUrl":"https://aws.amazon.com/fr/solutions/case-studies/tiime/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"Tiime","enableShare":"1","publishedDate":"2023","contentType":"Témoignages clients","headline":"Comment Tiime veut réinventer la comptabilité des entreprises avec AWS"}},"tags":[{"id":"GLOBAL#tech-category#compute","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Compute","description":"Compute","dateCreated":"2020-01-16T17:43:11+0000","dateUpdated":"2022-02-03T03:35:23+0000"},{"id":"GLOBAL#tech-category#storage","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Storage","description":"Storage","dateCreated":"2020-01-16T17:43:35+0000","dateUpdated":"2022-02-03T03:35:33+0000"},{"id":"GLOBAL#language#french","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"French","description":"French","dateCreated":"2020-03-03T06:40:44+0000","dateUpdated":"2022-02-03T03:31:24+0000"},{"id":"GLOBAL#content-type#case-study","locale":"en_US","tagNamespaceId":"GLOBAL#content-type","name":"Case Study","description":"Case Study","dateCreated":"2020-04-29T05:19:20+0000","dateUpdated":"2022-02-03T03:31:07+0000"},{"id":"GLOBAL#tech-category#databases","locale":"en_US","tagNamespaceId":"GLOBAL#tech-category","name":"Databases","description":"Databases","dateCreated":"2020-01-16T17:43:14+0000","dateUpdated":"2022-02-03T03:35:27+0000"},{"id":"GLOBAL#location#france","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"France","description":"France","dateCreated":"2020-02-03T05: