Midsize Business (SMB)","dateCreated":"2021-06-04T06:35:46+0000","dateUpdated":"2022-02-03T03:31:15+0000"}]},{"item":{"id":"customer-references#bipo-case-study","locale":"en_US","directoryId":"customer-references","name":"bipo-case-study","dateCreated":"2023-02-21T00:04:28+0000","dateUpdated":"2024-02-20T22:26:11+0000","additionalFields":{"descriptionSummary":"BIPO is a Singapore-based software company that provides cloud and mobile-based human resource management solutions for 3,300 customers worldwide, including those in the retail, food and beverages, and logistics industries. Its Human Resource Management System (HRMS) platform manages HR-related processes for more than 400,000 employees.","imageSrcUrl":"https://d1.awsstatic.com/apac/customer-references-logos-(%401x---%402x)/BIPO_logo%401x.c1ed88bc495d93045066b310e0a8f3b5cfdedc7c.png","displayLocation":"Singapore","customerNameLower":"bipo singapore","footerInfoText":"Published Date","industry":"Software \u0026 Internet","sortDate":"2023-01-01","headlineUrl":"https://aws.amazon.com/solutions/case-studies/bipo-case-study/?did\u003dcr_card\u0026trk\u003dcr_card","customer-name":"BIPO Singapore","publishedDate":"2023","enableShare":"1","headline":"BIPO Improves HR Management System User Experience with ML on AWS","contentType":"Customer Story"}},"tags":[{"id":"GLOBAL#language#english","locale":"en_US","tagNamespaceId":"GLOBAL#language","name":"English","description":"English","dateCreated":"2020-03-03T06:40:42+0000","dateUpdated":"2022-02-03T03:31:23+0000"},{"id":"GLOBAL#product#textract","locale":"en_US","tagNamespaceId":"GLOBAL#product","name":"Amazon Textract","description":"Amazon Textract","dateCreated":"2020-03-02T07:05:47+0000","dateUpdated":"2022-02-03T03:33:04+0000"},{"id":"GLOBAL#location#apac","locale":"en_US","tagNamespaceId":"GLOBAL#location","name":"Asia Pacific","description":"Asia Pacific","dateCreated":"2020-02-03T05:29:10+0000","dateUpdated":"2022-02-03T03:31:35+0000"},{"id":"GLOBAL#location#singa