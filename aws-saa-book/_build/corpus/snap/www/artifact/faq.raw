                   <li aria-disabled="false" data-rg-theme="teal" data-rg-mode="light" data-rigel-analytics="{&quot;name&quot;:&quot;ListItem&quot;,&quot;properties&quot;:{&quot;button&quot;:&quot;true&quot;,&quot;disabled&quot;:false,&quot;selected&quot;:false}}" class="rggc_8ed090e4 rggc_5299a281 rggc_5e6327f4 rggc_9add067f"><a data-rg-n="LinkWrapper" href="#agreements--1tr7jmn" anchorref="[object Object]" style="text-decoration:none"><span data-rg-n="BodyText" class="rggc_8711ccd9 rggc_98b54368 rggc_275611e5">Agreements</span>
