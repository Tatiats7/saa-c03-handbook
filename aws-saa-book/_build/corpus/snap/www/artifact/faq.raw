                    <div data-rg-n="Col" data-rg-theme="blue" data-rg-mode="light" class="rghr_7ca45506 rghr_2f390d15 rghr_2aef2225 rghr_07fcce24 rghr_1cdd9d8d rghr_a80e4900 rghr_f36c46cb rghr_93fb162c">
                     <div class="rghr_8ac78bf9">
                      <div class="rghr_bbe8c6e4">
                       <h1 data-rg-n="HeadingText" class="rghr_8711ccd9 rghr_b7ada98b rghr_5d220f64 rghr_dd5ce16f rghr_94339b09">AWS Artifact FAQs</h1>
