</thead>
<tbody>
<tr><td>{bulkStringOf!sagemaker/sagemaker-instances-training!Standard!Instances!-!ML!Instance!-!Training![Instance]}</td><td>{bulkStringOf!sagemaker/sagemaker-instances-training!Standard!Instances!-!ML!Instance!-!Training![VCPU]}</td><td>{bulkStringOf!sagemaker/sagemaker-instances-training!Standard!Instances!-!ML!Instance!-!Training![Memory]}</td><td>{bulkPriceOf!sagemaker/sagemaker-instances-training!Standard!Instances!-!ML!Instance!-!Training![price]}</td></tr>
</tbody>
</table>
" data-pricing-endpoint="https://b0.p.awsstatic.com/pricing/2.0/meteredUnitMaps" data-partition="aws" data-locale="en-US" data-token-component-type="native-react"></div>
