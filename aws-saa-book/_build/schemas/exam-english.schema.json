{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "exam-english.schema.json",
 "title": "Exam English: data/exam-english.json",
 "description": "Nine groups of ten non-technical words and phrases that decide answers. The signal is an exam heuristic, not an AWS fact.",
 "type": "object",
 "required": ["v", "groups"],
 "additionalProperties": false,
 "properties": {
  "v": {"const": 1},
  "note": {"type": "string"},
  "groups": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/group"}}
 },
 "$defs": {
  "group": {
   "type": "object",
   "required": ["id", "title", "items"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 3},
    "items": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/word"}}
   }
  },
  "word": {
   "type": "object",
   "required": ["id", "word", "meaning", "signals", "stem"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^ee-[a-z0-9]+(-[a-z0-9]+)*$"},
    "word": {"type": "string", "minLength": 2},
    "also": {"type": "array", "items": {"type": "string"}, "description": "other forms with the same signal"},
    "meaning": {"type": "string", "minLength": 3, "description": "plain meaning"},
    "signals": {"type": "string", "minLength": 3, "description": "what the word points to in an answer"},
    "stem": {"type": "string", "minLength": 10, "description": "a stem fragment that uses the word"}
   }
  }
 }
}
