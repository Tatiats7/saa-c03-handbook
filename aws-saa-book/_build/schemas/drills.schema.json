{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "drills.schema.json",
 "title": "Domain drills: data/drills.json",
 "description": "Written by `drills build` (TOOLS-items.md 7.8). Read by the web app; no Markdown is generated.",
 "type": "object",
 "required": ["v", "seed", "drills"],
 "additionalProperties": false,
 "properties": {
  "v": {"const": 1},
  "seed": {"type": "integer", "minimum": 0},
  "drills": {"type": "array", "minItems": 4, "maxItems": 4, "items": {
   "type": "object",
   "required": ["id", "domain", "title", "questions"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^drill-d[1-4]$"},
    "domain": {"type": "integer", "minimum": 1, "maximum": 4},
    "title": {"type": "string", "minLength": 3},
    "questions": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-q[0-9]{3}$"}, "uniqueItems": true}
   }
  }}
 }
}
