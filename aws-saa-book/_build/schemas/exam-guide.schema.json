{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "exam-guide.schema.json",
 "title": "Parsed exam guide: _build/registry/exam-guide.json",
 "description": "Written by `registry build` from the saved exam guide pages. Every 'text' and 'title' is verbatim from the page snapshot named by source_id.",
 "type": "object",
 "required": ["exam", "root", "built_at", "pages", "domains", "tasks", "bullets", "counts"],
 "additionalProperties": false,
 "properties": {
  "exam": {"const": "SAA-C03"},
  "root": {"type": "string", "pattern": "^https://docs\\.aws\\.amazon\\.com/"},
  "built_at": {"type": "string"},
  "pages": {"type": "array", "minItems": 1, "items": {
   "type": "object",
   "required": ["source_id", "url", "sha256", "role"],
   "additionalProperties": false,
   "properties": {
    "source_id": {"type": "string", "minLength": 3},
    "url": {"type": "string", "pattern": "^https://docs\\.aws\\.amazon\\.com/"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the snapshot .txt that was parsed"},
    "role": {"enum": ["overview", "domain", "in-scope", "out-of-scope", "other"]}
   }
  }},
  "domains": {"type": "array", "minItems": 4, "maxItems": 4, "items": {
   "type": "object",
   "required": ["id", "title", "weight", "source_id"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "integer", "minimum": 1, "maximum": 4},
    "title": {"type": "string", "minLength": 3},
    "weight": {"type": "integer", "minimum": 1, "maximum": 100, "description": "percent of scored content"},
    "source_id": {"type": "string"}
   }
  }},
  "tasks": {"type": "array", "minItems": 1, "items": {
   "type": "object",
   "required": ["id", "domain", "title", "source_id", "line"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^[1-4]\\.[1-5]$"},
    "domain": {"type": "integer", "minimum": 1, "maximum": 4},
    "title": {"type": "string", "minLength": 3},
    "source_id": {"type": "string"},
    "line": {"type": "integer", "minimum": 1}
   }
  }},
  "bullets": {"type": "array", "minItems": 1, "items": {
   "type": "object",
   "required": ["id", "task", "domain", "kind", "n", "text", "source_id", "line"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^[1-4]\\.[1-5]\\.[KS][0-9]{1,2}$"},
    "task": {"type": "string", "pattern": "^[1-4]\\.[1-5]$"},
    "domain": {"type": "integer", "minimum": 1, "maximum": 4},
    "kind": {"enum": ["knowledge", "skill"]},
    "n": {"type": "integer", "minimum": 1},
    "text": {"type": "string", "minLength": 3},
    "source_id": {"type": "string"},
    "line": {"type": "integer", "minimum": 1}
   }
  }},
  "counts": {
   "type": "object",
   "required": ["domains", "tasks", "bullets"],
   "additionalProperties": false,
   "properties": {"domains": {"type": "integer"}, "tasks": {"type": "integer"}, "bullets": {"type": "integer"}}
  }
 }
}
