{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "services.schema.json",
 "title": "In-scope and out-of-scope services: _build/registry/services.json",
 "description": "Written by `registry build` from the two service-list pages of the exam guide. official_name is verbatim. 'keys' are registry service keys (chapter.services); they come from book.service_map or from the automatic name match.",
 "type": "object",
 "required": ["exam", "built_at", "in_scope", "out_of_scope", "counts"],
 "additionalProperties": false,
 "properties": {
  "exam": {"const": "SAA-C03"},
  "built_at": {"type": "string"},
  "in_scope": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
  "out_of_scope": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
  "counts": {
   "type": "object",
   "required": ["in_scope", "in_scope_unique", "out_of_scope", "unmapped"],
   "additionalProperties": false,
   "properties": {
    "in_scope": {"type": "integer", "description": "list entries, before merging a name that appears in two categories"},
    "in_scope_unique": {"type": "integer"},
    "out_of_scope": {"type": "integer"},
    "unmapped": {"type": "integer", "description": "in-scope entries with no registry key"}
   }
  }
 },
 "$defs": {
  "entry": {
   "type": "object",
   "required": ["id", "official_name", "short_name", "categories", "keys", "home_chapter", "level", "source_id", "line"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "slug of official_name"},
    "official_name": {"type": "string", "minLength": 2},
    "short_name": {"type": ["string", "null"], "description": "the name in parentheses, for example 'Amazon MSK'"},
    "categories": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "keys": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}, "uniqueItems": true},
    "home_chapter": {"type": ["string", "null"], "pattern": "^[0-9]{2}$", "description": "chapter of the first key; null for out-of-scope and unmapped entries"},
    "level": {"enum": [null, "deep", "medium", "light", "front", "synthesis"], "description": "tier of the home chapter"},
    "source_id": {"type": "string"},
    "line": {"type": "integer", "minimum": 1}
   }
  }
 }
}
