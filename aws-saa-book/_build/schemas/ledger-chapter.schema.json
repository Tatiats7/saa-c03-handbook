{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "ledger-chapter.schema.json",
 "title": "Chapter ledger: _build/ledger/chapters/<id>.json",
 "description": "Written only by saalib/ledger.py (stage begin, stage end, stage reset, mark_stale). Stage names: plan, mine, register, verify-facts, brief, prose, questions, tasks, cards, speak, diagrams, edit, review, fix, verify-questions, finalize.",
 "type": "object",
 "required": ["chapter", "slug", "status", "rev", "style_version", "stages", "warnings", "updated"],
 "additionalProperties": false,
 "properties": {
  "chapter": {"type": "string", "pattern": "^[0-9]{2}$"},
  "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
  "status": {"enum": ["planned", "facts-verified", "drafted", "reviewed", "ready", "blocked"]},
  "blocked": {
   "type": ["object", "null"],
   "required": ["stage", "reason"],
   "additionalProperties": false,
   "properties": {"stage": {"type": "string"}, "reason": {"type": "string"}, "since": {"type": "string"}}
  },
  "rev": {"type": "integer", "minimum": 0, "description": "raised by 1 each time finalize passes"},
  "style_version": {"type": "string", "description": "SPEC.json version the chapter was last finalized or begun under"},
  "stages": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "plan": {"$ref": "#/$defs/stage"}, "mine": {"$ref": "#/$defs/stage"}, "register": {"$ref": "#/$defs/stage"},
    "verify-facts": {"$ref": "#/$defs/stage"}, "brief": {"$ref": "#/$defs/stage"}, "prose": {"$ref": "#/$defs/stage"},
    "questions": {"$ref": "#/$defs/stage"}, "tasks": {"$ref": "#/$defs/stage"}, "cards": {"$ref": "#/$defs/stage"},
    "speak": {"$ref": "#/$defs/stage"}, "diagrams": {"$ref": "#/$defs/stage"}, "edit": {"$ref": "#/$defs/stage"},
    "review": {"$ref": "#/$defs/stage"}, "fix": {"$ref": "#/$defs/stage"}, "verify-questions": {"$ref": "#/$defs/stage"},
    "finalize": {"$ref": "#/$defs/stage"}
   }
  },
  "warnings": {"type": "array", "items": {"type": "string"}},
  "stale": {"type": "array", "items": {"type": "string"}, "description": "reasons the chapter was marked stale since its last finalize, for example 'fact vpc-natgw-bandwidth amended'"},
  "updated": {"type": "string"}
 },
 "$defs": {
  "stage": {
   "type": "object",
   "required": ["status", "attempts", "pass_seq", "inputs_hash"],
   "additionalProperties": false,
   "properties": {
    "status": {"enum": ["running", "pass", "fail", "stale", "na"]},
    "attempts": {"type": "integer", "minimum": 0, "maximum": 3, "description": "begins since the last pass or reset"},
    "pass_seq": {"type": "integer", "minimum": 0, "description": "number of times this stage has passed"},
    "inputs_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "started": {"type": ["string", "null"]},
    "ended": {"type": ["string", "null"]},
    "run": {"type": ["string", "null"], "description": "workflow run id given with --run"},
    "gates": {"type": "array", "items": {"type": "string"}},
    "counts": {"type": "object"},
    "reason": {"type": ["string", "null"], "description": "why the stage failed, is stale or is not applicable"},
    "note": {"type": ["string", "null"]}
   }
  }
 }
}
