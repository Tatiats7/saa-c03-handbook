{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "mock.schema.json",
 "title": "Mock exam manifest: data/<NN-slug>/mock.json",
 "description": "Written by `mocks assemble`. The questions themselves stay in data/<NN-slug>/questions.json (pool 'mock'); the manifest holds the 65 chosen ids in exam order. `mocks check` verifies every rule again from the files.",
 "type": "object",
 "required": ["v", "mock", "chapter", "seed", "assembled", "minutes", "domain_split", "questions", "spares", "counts"],
 "additionalProperties": false,
 "properties": {
  "v": {"const": 1},
  "mock": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "chapter slug, for example mock-exam-1"},
  "chapter": {"type": "string", "pattern": "^[0-9]{2}$"},
  "seed": {"type": "integer", "minimum": 0},
  "assembled": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"},
  "minutes": {"type": "integer", "minimum": 1},
  "domain_split": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0}},
  "questions": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-q[0-9]{3}$"}, "uniqueItems": true, "description": "exactly sum(domain_split) ids, in exam order"},
  "spares": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-q[0-9]{3}$"}, "uniqueItems": true, "description": "verified pool questions that were not chosen"},
  "counts": {
   "type": "object",
   "required": ["domains", "tasks", "multi", "difficulty", "services"],
   "additionalProperties": false,
   "properties": {
    "domains": {"type": "object", "description": "{\"1\": 20, \"2\": 17, \"3\": 15, \"4\": 13}"},
    "tasks": {"type": "object", "description": "task statement id -> number of questions"},
    "multi": {"type": "integer", "minimum": 0},
    "difficulty": {"type": "object", "description": "{\"1\": n, \"2\": n, \"3\": n}"},
    "services": {"type": "object", "description": "focus service (services[0]) -> number of questions"}
   }
  }
 }
}
