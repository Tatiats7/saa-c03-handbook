{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saa-handbook/diagram.schema.json",
  "title": "Diagram spec (aws-saa-book/diagrams/src/<id>.json)",
  "description": "One file per diagram. The validator picks the branch whose kind matches. Array maxima here are loose on purpose: the lint enforces the real limits (5 actors, 6 rungs, ...) with a readable message.",
  "type": "object",
  "required": ["id", "kind"],
  "properties": {
    "kind": {"enum": ["arch", "sequence", "ladder", "compare", "states", "timeline", "raw"]}
  },
  "oneOf": [
    {"$ref": "#/$defs/arch"},
    {"$ref": "#/$defs/sequence"},
    {"$ref": "#/$defs/ladder"},
    {"$ref": "#/$defs/compare"},
    {"$ref": "#/$defs/states"},
    {"$ref": "#/$defs/timeline"},
    {"$ref": "#/$defs/raw"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60},
    "localId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 32},
    "cell": {"type": "string", "pattern": "^[A-L]([1-9]|1[0-2])$"},
    "cellOrRange": {"type": "string", "pattern": "^[A-L]([1-9]|1[0-2])(:[A-L]([1-9]|1[0-2]))?$"},
    "side": {"enum": ["top", "right", "bottom", "left"]},
    "size": {"enum": ["s", "m", "l"]},
    "title": {"type": "string", "minLength": 4, "maxLength": 90},
    "claim": {"type": "string", "minLength": 10, "maxLength": 200},
    "alt": {"type": "string", "minLength": 20, "maxLength": 600},
    "chapter": {"type": "string", "pattern": "^[0-9]{2}$"},
    "notes": {"type": "string", "maxLength": 600},
    "icon": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "label": {"type": "string", "minLength": 1, "maxLength": 40},
    "say": {"type": "string", "minLength": 8, "maxLength": 220},
    "archGroups": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label", "cells"],
        "properties": {
          "id": {"$ref": "#/$defs/localId"},
          "type": {"enum": ["region", "vpc", "az", "subnet-public", "subnet-private", "security-group", "auto-scaling-group", "account", "corporate-data-center", "generic"]},
          "label": {"$ref": "#/$defs/label"},
          "cells": {"$ref": "#/$defs/cellOrRange"},
          "in": {"$ref": "#/$defs/localId"}
        }
      }
    },
    "archNodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "at"],
        "properties": {
          "id": {"$ref": "#/$defs/localId"},
          "icon": {"$ref": "#/$defs/icon"},
          "label": {"$ref": "#/$defs/label"},
          "at": {"$ref": "#/$defs/cellOrRange"},
          "emph": {"type": "boolean"}
        }
      }
    },
    "archEdges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": {"$ref": "#/$defs/localId"},
          "to": {"$ref": "#/$defs/localId"},
          "label": {"type": "string", "minLength": 1, "maxLength": 28},
          "step": {"type": "integer", "minimum": 1, "maximum": 14},
          "say": {"$ref": "#/$defs/say"},
          "emph": {"type": "boolean"},
          "dashed": {"type": "boolean"},
          "arrow": {"enum": ["end", "both", "none"]},
          "fromSide": {"$ref": "#/$defs/side"},
          "toSide": {"$ref": "#/$defs/side"}
        }
      }
    },
    "arch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "claim", "alt", "cols", "rows", "nodes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "arch"},
        "size": {"$ref": "#/$defs/size"},
        "title": {"$ref": "#/$defs/title"},
        "claim": {"$ref": "#/$defs/claim"},
        "alt": {"$ref": "#/$defs/alt"},
        "cols": {"type": "integer", "minimum": 1, "maximum": 8},
        "rows": {"type": "integer", "minimum": 1, "maximum": 8},
        "flow": {"enum": ["down", "right"]},
        "chapter": {"$ref": "#/$defs/chapter"},
        "sample": {"type": "boolean"},
        "notes": {"$ref": "#/$defs/notes"},
        "groups": {"$ref": "#/$defs/archGroups"},
        "nodes": {"$ref": "#/$defs/archNodes"},
        "edges": {"$ref": "#/$defs/archEdges"}
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "claim", "alt", "actors", "messages"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "sequence"},
        "size": {"$ref": "#/$defs/size"},
        "title": {"$ref": "#/$defs/title"},
        "claim": {"$ref": "#/$defs/claim"},
        "alt": {"$ref": "#/$defs/alt"},
        "chapter": {"$ref": "#/$defs/chapter"},
        "sample": {"type": "boolean"},
        "notes": {"$ref": "#/$defs/notes"},
        "actors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": {"$ref": "#/$defs/localId"},
              "icon": {"$ref": "#/$defs/icon"},
              "label": {"$ref": "#/$defs/label"},
              "emph": {"type": "boolean"}
            }
          }
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "label", "say"],
            "properties": {
              "from": {"$ref": "#/$defs/localId"},
              "to": {"$ref": "#/$defs/localId"},
              "label": {"type": "string", "minLength": 1, "maxLength": 32},
              "say": {"$ref": "#/$defs/say"},
              "dashed": {"type": "boolean"},
              "emph": {"type": "boolean"}
            }
          }
        },
        "asides": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["after", "over", "text"],
            "properties": {
              "after": {"type": "integer", "minimum": 0, "maximum": 30},
              "over": {"$ref": "#/$defs/localId"},
              "text": {"type": "string", "minLength": 1, "maxLength": 48},
              "emph": {"type": "boolean"}
            }
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": {"$ref": "#/$defs/label"},
        "icon": {"$ref": "#/$defs/icon"},
        "emph": {"type": "boolean"}
      }
    },
    "ladder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "claim", "alt", "rungs", "else"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "ladder"},
        "size": {"$ref": "#/$defs/size"},
        "title": {"$ref": "#/$defs/title"},
        "claim": {"$ref": "#/$defs/claim"},
        "alt": {"$ref": "#/$defs/alt"},
        "chapter": {"$ref": "#/$defs/chapter"},
        "sample": {"type": "boolean"},
        "notes": {"$ref": "#/$defs/notes"},
        "rungs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["q", "then"],
            "properties": {
              "q": {"type": "string", "minLength": 4, "maxLength": 70},
              "answer": {"type": "string", "minLength": 1, "maxLength": 20},
              "then": {"$ref": "#/$defs/outcome"},
              "next": {"type": "string", "minLength": 1, "maxLength": 20}
            }
          }
        },
        "else": {"$ref": "#/$defs/outcome"}
      }
    },
    "compare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "claim", "alt", "panels"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "compare"},
        "size": {"$ref": "#/$defs/size"},
        "title": {"$ref": "#/$defs/title"},
        "claim": {"$ref": "#/$defs/claim"},
        "alt": {"$ref": "#/$defs/alt"},
        "chapter": {"$ref": "#/$defs/chapter"},
        "sample": {"type": "boolean"},
        "notes": {"$ref": "#/$defs/notes"},
        "panels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "cols", "rows", "nodes"],
            "properties": {
              "label": {"$ref": "#/$defs/label"},
              "alt": {"$ref": "#/$defs/alt"},
              "cols": {"type": "integer", "minimum": 1, "maximum": 4},
              "rows": {"type": "integer", "minimum": 1, "maximum": 6},
              "flow": {"enum": ["down", "right"]},
              "groups": {"$ref": "#/$defs/archGroups"},
              "nodes": {"$ref": "#/$defs/archNodes"},
              "edges": {"$ref": "#/$defs/archEdges"}
            }
          }
        }
      }
    },
    "states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "claim", "alt", "cols", "rows", "states", "transitions"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "states"},
        "size": {"$ref": "#/$defs/size"},
        "title": {"$ref": "#/$defs/title"},
        "claim": {"$ref": "#/$defs/claim"},
        "alt": {"$ref": "#/$defs/alt"},
        "cols": {"type": "integer", "minimum": 1, "maximum": 6},
        "rows": {"type": "integer", "minimum": 1, "maximum": 6},
        "flow": {"enum": ["down", "right"]},
        "chapter": {"$ref": "#/$defs/chapter"},
        "sample": {"type": "boolean"},
        "notes": {"$ref": "#/$defs/notes"},
        "states": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "at"],
            "properties": {
              "id": {"$ref": "#/$defs/localId"},
              "label": {"$ref": "#/$defs/label"},
              "at": {"$ref": "#/$defs/cellOrRange"},
              "final": {"type": "boolean"},
              "emph": {"type": "boolean"}
            }
          }
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "label"],
            "properties": {
              "from": {"$ref": "#/$defs/localId"},
              "to": {"$ref": "#/$defs/localId"},
              "label": {"type": "string", "minLength": 1, "maxLength": 28},
              "emph": {"type": "boolean"},
              "dashed": {"type": "boolean"},
              "fromSide": {"$ref": "#/$defs/side"},
              "toSide": {"$ref": "#/$defs/side"}
            }
          }
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "claim", "alt", "ticks", "lanes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "timeline"},
        "size": {"$ref": "#/$defs/size"},
        "title": {"$ref": "#/$defs/title"},
        "claim": {"$ref": "#/$defs/claim"},
        "alt": {"$ref": "#/$defs/alt"},
        "chapter": {"$ref": "#/$defs/chapter"},
        "sample": {"type": "boolean"},
        "notes": {"$ref": "#/$defs/notes"},
        "axis": {"$ref": "#/$defs/label"},
        "ticks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": {"$ref": "#/$defs/localId"},
              "label": {"type": "string", "minLength": 1, "maxLength": 24}
            }
          }
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "spans"],
            "properties": {
              "label": {"$ref": "#/$defs/label"},
              "spans": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["from", "label"],
                  "properties": {
                    "from": {"$ref": "#/$defs/localId"},
                    "to": {"$ref": "#/$defs/localId"},
                    "label": {"$ref": "#/$defs/label"},
                    "emph": {"type": "boolean"}
                  }
                }
              }
            }
          }
        },
        "events": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "label"],
            "properties": {
              "at": {"$ref": "#/$defs/localId"},
              "label": {"type": "string", "minLength": 1, "maxLength": 28},
              "emph": {"type": "boolean"}
            }
          }
        }
      }
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "claim", "alt"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "raw"},
        "size": {"$ref": "#/$defs/size"},
        "title": {"$ref": "#/$defs/title"},
        "claim": {"$ref": "#/$defs/claim"},
        "alt": {"$ref": "#/$defs/alt"},
        "chapter": {"$ref": "#/$defs/chapter"},
        "sample": {"type": "boolean"},
        "notes": {"$ref": "#/$defs/notes"},
        "svg": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.svg$", "maxLength": 64}
      }
    }
  }
}
