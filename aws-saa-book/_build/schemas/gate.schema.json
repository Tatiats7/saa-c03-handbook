{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "gate.schema.json",
 "title": "Gate record: _build/ledger/gates/<chapter>.<gate>.json, and the return value of every gate function",
 "description": "A gate function `gate_<name>(ch_id, quick=False, **options)` in a module (the table in TOOLS.md section 2 maps each gate name to its function) returns this object without ts, run and tool_version; saalib/ledger.py adds those and writes the file. The record is stale when the SHA-256 of any input file differs from the one stored here.",
 "type": "object",
 "required": ["gate", "chapter", "ok", "exit", "errors", "warnings", "counts", "inputs"],
 "additionalProperties": false,
 "properties": {
  "gate": {"enum": ["plan", "facts-mech", "facts-final", "brief", "lint", "sync", "questions", "questions-verified", "cards", "speak", "tasks", "diagrams", "findings", "findings-closed", "counts"]},
  "chapter": {"type": "string", "pattern": "^[0-9]{2}$"},
  "ok": {"type": "boolean", "description": "true when there is no error; warnings do not change it"},
  "exit": {"enum": [0, 1, 2, 3]},
  "errors": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
  "warnings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
  "counts": {"type": "object"},
  "inputs": {"type": "array", "items": {
   "type": "object",
   "required": ["path", "sha256"],
   "additionalProperties": false,
   "properties": {
    "path": {"type": "string", "description": "relative to the book folder"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
   }
  }},
  "ts": {"type": "string"},
  "run": {"type": ["string", "null"]},
  "tool_version": {"type": "string"}
 },
 "$defs": {
  "finding": {
   "type": "object",
   "required": ["code", "msg"],
   "additionalProperties": false,
   "properties": {
    "code": {"type": "string", "pattern": "^[A-Z][0-9]{1,3}$"},
    "file": {"type": ["string", "null"], "description": "relative to the book folder"},
    "line": {"type": ["integer", "null"]},
    "item": {"type": ["string", "null"], "description": "id of the JSON item or fact"},
    "msg": {"type": "string", "minLength": 3}
   }
  }
 }
}
