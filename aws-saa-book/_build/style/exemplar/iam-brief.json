  "traps": [
    {
      "id": "iam-trap-allow-beats-deny",
      "belief": "If one policy allows an action, the request succeeds.",
      "truth": "An explicit deny overrides an explicit allow.",
      "facts": [
        "iam-eval-explicit-deny-overrides-allow"
      ]
    },
    {
      "id": "iam-trap-scp-grants",
      "belief": "An SCP or a permissions boundary that allows a service gives access to it.",
      "truth": "Neither grants permissions; both set a ceiling.",
      "facts": [
        "iam-scp-never-grants-permissions",
        "iam-boundary-limits-but-never-grants"
      ]
    },
    {
      "id": "iam-trap-admin-ignores-scp",
      "belief": "A role with AdministratorAccess, or the root user, can do everything in a member account.",
      "truth": "Effective permissions are the intersection of the SCP and the IAM policies, and an SCP also limits the member account's root user.",
      "facts": [
        "iam-scp-faq-effective-permissions-intersection",
        "iam-scp-applies-to-member-root-user"
      ]
    },
    {
      "id": "iam-trap-keys-on-instance",
      "belief": "Code on an EC2 instance needs an access key in a file or a variable.",
      "truth": "AWS delivers the temporary credentials of a role to the compute resource.",
      "facts": [
        "iam-compute-services-receive-role-credentials-no-keys-needed"
      ]
    },
    {
      "id": "iam-trap-cross-account-one-policy",
      "belief": "Across accounts, one side is enough: a bucket policy or a trust policy that names the other account.",
      "truth": "Cross-account requests need an allow in both accounts; for a role, the caller's own policy also allows sts:AssumeRole.",
      "facts": [
        "iam-eval-cross-account-needs-both-policies",
        "iam-assume-role-two-permissions-checked"
      ]
    },
    {
      "id": "iam-trap-role-adds-permissions",
      "belief": "A user who assumes a role keeps the user's permissions and adds the role's.",
      "truth": "The permissions are not cumulative.",
      "facts": [
        "iam-assume-role-replaces-original-permissions"
      ]
    },
    {
      "id": "iam-trap-role-long-term-credentials",
      "belief": "A role has its own password or access key.",
      "truth": "A role has no standard long-term credentials.",
      "facts": [
        "iam-users-have-long-term-credentials-roles-do-not"
      ]
    },
    {
      "id": "iam-trap-group-as-principal",
      "belief": "A bucket policy can name an IAM group as its principal.",
      "truth": "You cannot identify a user group as a principal.",
      "facts": [
        "iam-principal-group-cannot-be-principal"
      ]
    },
    {
      "id": "iam-trap-revoke-temporary-credentials",
      "belief": "You can revoke one leaked set of temporary credentials directly.",
      "truth": "One set cannot be revoked; revoking the role's active sessions denies every credential issued before that time.",
      "facts": [
        "sts-temporary-credentials-cannot-be-revoked-permissions-can-change",
        "iam-revoke-role-sessions-denies-credentials-issued-before"
      ]
    },
    {
      "id": "iam-trap-boundary-limits-root",
      "belief": "A permissions boundary on every user and role also limits the root user.",
      "truth": "You cannot set a permissions boundary for the root user; an SCP reaches it in a member account.",
      "facts": [
        "iam-root-user-no-identity-policies-or-boundary",
        "iam-scp-applies-to-member-root-user"
      ]
    },
    {
      "id": "iam-trap-trust-policy-grants-actions",
      "belief": "The trust policy decides what a role session can do.",
      "truth": "The trust policy names who can assume the role; the permissions policy decides what the session can do.",
      "facts": [
        "iam-role-trust-policy-names-who-can-assume",
        "iam-role-permissions-policy-defines-session-permissions"
      ]
    },
    {
      "id": "iam-trap-wildcard-principal-means-account",
      "belief": "A wildcard principal in a bucket policy means the other account.",
      "truth": "A wildcard principal with Allow grants access to all users, including anonymous users.",
      "facts": [
        "iam-principal-wildcard-is-public"
      ]
    },
    {
      "id": "iam-trap-root-for-daily-admin",
      "belief": "The root user is the right identity for daily administration.",
      "truth": "The root user must not be used for everyday tasks.",
      "facts": [
        "iam-root-user-not-for-everyday-tasks-roles-instead"
      ]
    }
  ],
