  "diagrams": [
    {
      "id": "iam-hero",
      "kind": "sequence",
      "claim": "A role gives temporary credentials, and the policies are evaluated each time a request is made.",
      "alt": "A sequence with three participants: a principal, AWS STS and Amazon S3. The principal asks AWS STS to assume a role. AWS STS checks the trust policy and returns temporary credentials. The principal signs a request to Amazon S3 with them. AWS evaluates the policies, and Amazon S3 returns the object or an access denied error.",
      "say": [
        "The principal asks AWS Security Token Service (AWS STS) to assume a role.",
        "AWS STS checks that the trust policy of the role names the principal.",
        "AWS STS returns temporary security credentials that expire.",
        "The principal signs a request to Amazon S3 with the temporary credentials.",
        "AWS evaluates the policies that apply, and an explicit deny overrides an explicit allow.",
        "Amazon S3 returns the object, or an access denied error."
      ]
    },
    {
      "id": "iam-policy-gates",
      "kind": "ladder",
      "claim": "A request passes the deny check, every ceiling and one grant, or it is denied.",
      "alt": "A ladder of four questions: is there an explicit deny, does every SCP allow, does the boundary allow, does an identity-based or resource-based policy allow. Each no ends in deny.",
