{"fact": "rds-proxy-failover-idle-connections-kept", "rev": 3, "lens": "entail", "verdict": "partial", "voter": "verify-26-26-entail-025", "ts": "2026-10-14T03:53:44Z", "batch": "26-entail-025", "reason": "The quote limits the behavior to 'applications that maintain their own connection pool'; the claim and its qualifiers drop that condition and state it for all RDS Proxy connections. The quote does support the canceled in-flight transactions and the queuing of requests while the writer is unavailable.", "source_id": null, "quote": null, "answer": null, "content": "1f2793cb039af9bb98208d615b01225dcb66fc06ba959a9f914df0d5d488a9f3"}
