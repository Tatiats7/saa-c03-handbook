# Build outputs: rebuild with `python3 aws-saa-book/tools/saa.py build web --only-ready`
aws-saa-book/_build/site/
aws-saa-book/_build/site-single/
aws-saa-book/_build/preview/
aws-saa-book/_build/preview-single/
aws-saa-book/_build/shots/

# Scratch: keep the folder and the AWS icon package, ignore everything else in it
aws-saa-book/_build/tmp/*
!aws-saa-book/_build/tmp/.gitkeep
!aws-saa-book/_build/tmp/aws-icons/
aws-saa-book/_build/tmp/aws-icons/*
!aws-saa-book/_build/tmp/aws-icons/package.zip
!aws-saa-book/_build/tmp/aws-icons/package.json

# Locks and caches
*.lock
aws-saa-book/_build/corpus/locks/*
!aws-saa-book/_build/corpus/locks/.gitkeep
__pycache__/
*.pyc
.DS_Store

# Personal Claude Code settings stay on each laptop
.claude/settings.local.json
